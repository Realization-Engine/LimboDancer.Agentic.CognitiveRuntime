@using LimboDancer.Domains.Asl.Units.State
@using LimboDancer.Domains.Asl.MapStudio.Components.Layout
@* Pass 29 (plan section 5): the board inspector beside a map, moved out of the board viewer: Selection (the picked unit, the units in the picked
   hex, and the hex's facts), LOS, and Evidence (the pixel clicked, the hex's grid samples, and the board's provenance), with any tabs the host adds
   before them. It shows only what it is given: the units come already read for the view, and the host keeps the selection, the LOS check, and
   the open tab. *@
<InspectorTabs Tabs="@TabList" Selected="@TopSelected" SelectedChanged="@SelectTop" Label="@Label" IdPrefix="@IdPrefix" Header="@Header">
    @* A tab kept mounted (Play's actions) stays rendered, hidden while another tab is open, so what is typed in it is not lost. *@
    @foreach (var kept in Extras.Where(extra => extra.KeepMounted))
    {
        <div @key="@kept.Tab.Id" class="inspector-kept" hidden="@(kept.Tab.Id != Panel)">@kept.Content</div>
    }
    @if (Extras.FirstOrDefault(extra => extra.Tab.Id == Panel) is { } shownExtra)
    {
        @if (!shownExtra.KeepMounted)
        {
            @shownExtra.Content
        }
    }
    else if (Planner is not null && IsPlannerPanel(Panel))
    {
        @* The Play streamlining plan, S8 (ruling Q11): the Unit Planner's own strip, LOS, Range, and the Movement Plan; the panel ids stay "los"
           and "range", so what reads them (the LOS draft, the open tab kept on a map click) is unchanged. *@
        <InspectorTabs Tabs="@PlannerTabs" Selected="@Panel" SelectedChanged="@PanelChanged" Label="Unit Planner" IdPrefix="@($"{IdPrefix}-planner")">
            @if (Panel == MovementPlanPanel)
            {
                @Planner
            }
            else
            {
                @LosOrRange
            }
        </InspectorTabs>
    }
    else
    {
        @switch (Panel)
        {
            case "los":
            case "range":
                @LosOrRange
                break;
            case "evidence":
                @if (Sample is not null)
                {
                    <h3>Pixel clicked</h3>
                    <p id="viewer-sample">@Sample</p>
                }
                @if ((Selected ?? hovered) is { } sampled)
                {
                    <p class="muted">Hex @sampled.Hex:</p>
                    <HexGridSamples Rows="@HexInspector.SampleRows(sampled, Board.Render.Grid, Board.Catalog)" />
                }
                <BoardProvenancePanel Board="@Board" StyledModel="@StyledModel" />
                break;
            default:
                @if (SelectedUnit is { } unit)
                {
                    <SelectedUnitInspector Unit="@unit" Vocabulary="@Vocabulary" View="@View" Note="@UnitNote" OriginOf="@OriginOf"
                                           NameOf="@(id => Units?.Units.FirstOrDefault(placed => placed.Document.Id == id)?.Name)" />
                }
                @if (Units is { } units)
                {
                    @foreach (var diagnostic in units.Diagnostics)
                    {
                        <p class="fail">Units: @diagnostic</p>
                    }
                    @if (Selected is { } selectedHex && units.At(selectedHex.Index).ToArray() is { Length: > 0 } members)
                    {
                        <HexUnitStackList Hex="@selectedHex.Hex.ToString()" Members="@members" Selected="@SelectedUnit?.Document.Id" OnSelect="@SelectedUnitChanged" />
                    }
                }
                @if (Selected is { } notedHex && HexNotes?.Invoke(notedHex) is { Count: > 0 } notes)
                {
                    <ul id="hex-notes">
                        @foreach (var note in notes)
                        {
                            <li>@note</li>
                        }
                    </ul>
                }
                @if ((Selected ?? hovered) is { } facts)
                {
                    @if (Selected is null)
                    {
                        <p class="muted">Hovering. Click to keep this hex.</p>
                    }
                    <HexInspector Board="Board.Ref" Facts="facts" Grid="Board.Render.Grid" Catalog="Board.Catalog" LocationText="@Board.LocationOf(facts)"
                                  Model="StyledModel" Validation="Board.Validation" OnCopy="OnCopy" ShowSamples="false" />
                }
                else
                {
                    <p class="muted">Hover or click a hex to inspect its derived facts; its grid samples are under Evidence.</p>
                }

                break;
        }
    }
</InspectorTabs>

@code {
    /// <summary>
    /// A tab the host adds, with the markup it shows when chosen; placed before the built-in tabs, or after them when <paramref name="Last"/>.
    /// When <paramref name="KeepMounted"/>, its markup stays rendered and is only hidden while another tab is open, so its state survives.
    /// </summary>
    public sealed record ExtraTab(InspectorTabs.Tab Tab, RenderFragment Content, bool Last = false, bool KeepMounted = false);

    private static readonly IReadOnlyList<InspectorTabs.Tab> BuiltIn = [new("selection", "Selection", Icon: "selection"), new("los", "LOS", Icon: "los"), new("range", "Range", Icon: "range"), new("evidence", "Evidence", Icon: "evidence")];

    // The hex under the pointer while none is kept. The workspace sets it here, so a hover redraws the inspector alone (pass 29).
    private HexFacts? hovered;

    [Parameter, EditorRequired]
    public StudioBoard Board { get; set; } = null!;

    /// <summary>The open tab: "selection", "los", "evidence", or an extra tab's id.</summary>
    [Parameter]
    public string Panel { get; set; } = "selection";

    [Parameter]
    public EventCallback<string> PanelChanged { get; set; }

    [Parameter]
    public string Label { get; set; } = "Board inspector";

    [Parameter]
    public string IdPrefix { get; set; } = "viewer";

    /// <summary>Tabs the host shows before Selection, LOS, and Evidence.</summary>
    [Parameter]
    public IReadOnlyList<ExtraTab> Extras { get; set; } = [];

    /// <summary>A line under the tabs, shown in every tab and kept in sight while the panel scrolls; none by default.</summary>
    [Parameter]
    public RenderFragment? Header { get; set; }

    /// <summary>
    /// The Movement Plan's markup (the Play streamlining plan, S8): when given, the top strip holds a Unit Planner tab whose own strip holds LOS,
    /// Range, and the Movement Plan. Null keeps LOS and Range in the top strip (Replay, the Board viewer; ruling Q11).
    /// </summary>
    [Parameter]
    public RenderFragment? Planner { get; set; }

    /// <summary>The hex clicked and kept; null when none is.</summary>
    [Parameter]
    public HexFacts? Selected { get; set; }

    /// <summary>The units shown on the map, already read for the view; null when no units are shown.</summary>
    [Parameter]
    public UnitOverlay? Units { get; set; }

    [Parameter]
    public PlacedUnit? SelectedUnit { get; set; }

    [Parameter]
    public EventCallback<PlacedUnit> SelectedUnitChanged { get; set; }

    [Parameter, EditorRequired]
    public LimboDancer.Domains.Asl.Units.Vocabulary.UnitVocabulary Vocabulary { get; set; } = null!;

    /// <summary>The game's view the units were read for; null for a placement set.</summary>
    [Parameter]
    public GameView? View { get; set; }

    [Parameter]
    public string? UnitNote { get; set; }

    [Parameter]
    public Func<string, CampaignCounterOrigin?>? OriginOf { get; set; }

    /// <summary>What else the host knows of the hex kept: Residual FP, a Melee (pass 31c).</summary>
    [Parameter]
    public Func<HexFacts, IReadOnlyList<string>>? HexNotes { get; set; }

    /// <summary>The pixel last clicked, described for the Evidence tab.</summary>
    [Parameter]
    public string? Sample { get; set; }

    [Parameter]
    public FeatureModel? StyledModel { get; set; }

    [Parameter]
    public LosPanel.LosDraft LosDraft { get; set; } = new(string.Empty, string.Empty, false);

    [Parameter]
    public EventCallback<LosPanel.LosDraft> LosDraftChanged { get; set; }

    [Parameter]
    public LosCheck? LosResult { get; set; }

    [Parameter]
    public EventCallback OnCheckLos { get; set; }

    [Parameter]
    public EventCallback OnClearLos { get; set; }

    /// <summary>The last range reading (pass 31c, design section 14), for the same two Locations as the LOS check.</summary>
    [Parameter]
    public RangeCheck? RangeResult { get; set; }

    /// <summary>The units and weapons the range is read for, already read for the view; none on a board with no game.</summary>
    [Parameter]
    public IReadOnlyList<RangeRow> RangeRows { get; set; } = [];

    [Parameter]
    public string? RangeChosen { get; set; }

    [Parameter]
    public EventCallback<string> OnChooseRange { get; set; }

    [Parameter]
    public EventCallback OnCheckRange { get; set; }

    [Parameter]
    public EventCallback OnClearRange { get; set; }

    [Parameter]
    public EventCallback<string> OnCopy { get; set; }

    /// <summary>Shows the hex under the pointer; only the inspector is drawn again, and only when the hex changes.</summary>
    public void SetHovered(HexFacts? facts)
    {
        if (facts?.Index != hovered?.Index)
        {
            hovered = facts;
            StateHasChanged();
        }
    }

    private IReadOnlyList<InspectorTabs.Tab> TabList =>
        [.. Extras.Where(extra => !extra.Last).Select(extra => extra.Tab), .. Planner is null ? BuiltIn : PlannerBuiltIn, .. Extras.Where(extra => extra.Last).Select(extra => extra.Tab)];

    /// <summary>The Unit Planner's panel id in its own strip (the Play streamlining plan, S8).</summary>
    public const string MovementPlanPanel = "movement-plan";

    private const string PlannerTab = "planner";

    // With a planner, the top strip holds the Unit Planner in place of LOS and Range, which move to its own strip (ruling Q11).
    private static readonly IReadOnlyList<InspectorTabs.Tab> PlannerBuiltIn = [new(PlannerTab, "Unit Planner", Icon: "planner"), new("selection", "Selection", Icon: "selection"), new("evidence", "Evidence", Icon: "evidence")];

    private static readonly IReadOnlyList<InspectorTabs.Tab> PlannerTabs = [new("los", "LOS", Icon: "los"), new("range", "Range", Icon: "range"), new(MovementPlanPanel, "Movement Plan", Icon: "movement-plan")];

    // The planner tab last open, which the top strip's Unit Planner opens again.
    private string plannerLast = MovementPlanPanel;

    private static bool IsPlannerPanel(string panel) => panel is "los" or "range" or MovementPlanPanel;

    private string TopSelected => Planner is not null && IsPlannerPanel(Panel) ? PlannerTab : Panel;

    private Task SelectTop(string tab) => PanelChanged.InvokeAsync(tab == PlannerTab ? plannerLast : tab);

    protected override void OnParametersSet()
    {
        if (Planner is not null && IsPlannerPanel(Panel))
        {
            plannerLast = Panel;
        }
    }

    private RenderFragment LosOrRange => @<text>
        @if (Panel == "los")
        {
            <LosPanel Draft="@LosDraft" DraftChanged="@LosDraftChanged" Selected="@(Selected is null ? null : Board.LocationOf(Selected))" Result="@LosResult"
                      OnCheck="@OnCheckLos" OnClear="@OnClearLos" />
        }
        else
        {
            <RangePanel Draft="@LosDraft" DraftChanged="@LosDraftChanged" Selected="@(Selected is null ? null : Board.LocationOf(Selected))" Result="@RangeResult"
                        Rows="@RangeRows" Chosen="@RangeChosen" OnChoose="@OnChooseRange" Boards="@(Board.Composition?.Placements.Count ?? 1)"
                        OnCheck="@OnCheckRange" OnClear="@OnClearRange" />
        }
    </text>;
}
