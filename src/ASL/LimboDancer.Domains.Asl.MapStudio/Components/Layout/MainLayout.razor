@inherits LayoutComponentBase
@implements IAsyncDisposable
@inject NavigationManager Navigation
@inject IJSRuntime JS

<div class="@ShellClass" @onkeydown="KeyDown">
    <header class="studio">
        <button class="nav-toggle" @ref="toggle" aria-controls="studio-nav" aria-expanded="@(Expanded ? "true" : "false")"
                aria-label="@(Expanded ? "Hide navigation" : "Show navigation")" title="@(Expanded ? "Hide navigation" : "Show navigation")" @onclick="Toggle">
            <span aria-hidden="true">&#9776;</span>
        </button>
        <h1>ASL Map Studio</h1>
    </header>
    <div class="studio-body">
        <StudioNavigation Hidden="@(!Expanded)" />
        <main>
            @* Pass 28c: pages that change their layout under 1024px (the Play workspace's tabs) read the same width the drawer does. *@
            <CascadingValue Value="@narrow" Name="StudioNarrow">
                @Body
            </CascadingValue>
        </main>
    </div>
</div>

@code {
    private ElementReference toggle;
    private IJSObjectReference? module;
    private DotNetObjectReference<MainLayout>? self;

    // Wide: the sidebar shows unless collapsed. Narrow (under 1024px): it is a drawer, closed until opened.
    private bool narrow;
    private bool collapsed;
    private bool drawerOpen;

    private bool Expanded => narrow ? drawerOpen : !collapsed;

    private string ShellClass => "studio-shell" + (narrow ? " narrow" : string.Empty) + (Expanded ? string.Empty : " nav-hidden");

    protected override void OnInitialized() => Navigation.LocationChanged += Changed;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/studioShell.js");
            self = DotNetObjectReference.Create(this);
            SetNarrow(await module.InvokeAsync<bool>("watchNarrow", self));
            if (!narrow && await module.InvokeAsync<bool>("isMedium"))
            {
                collapsed = true;
                StateHasChanged();
            }
        }
        catch (JSDisconnectedException)
        {
        }
    }

    /// <summary>Called from the browser when the window crosses 1024px.</summary>
    [JSInvokable]
    public void SetNarrow(bool value)
    {
        if (narrow != value)
        {
            narrow = value;
            drawerOpen = false;
            StateHasChanged();
        }
    }

    private void Toggle()
    {
        if (narrow)
        {
            drawerOpen = !drawerOpen;
        }
        else
        {
            collapsed = !collapsed;
        }
    }

    // Escape closes the drawer from anywhere in the shell, the toggle included (UI review, pass 22b).
    private Task KeyDown(KeyboardEventArgs args) => args.Key == "Escape" ? Escape() : Task.CompletedTask;

    private async Task Escape()
    {
        if (narrow && drawerOpen)
        {
            drawerOpen = false;
            await toggle.FocusAsync();
        }
    }

    // A route change closes the drawer and returns focus to the toggle, since the link that had it is hidden; it never changes the wide
    // sidebar or a page's state.
    private void Changed(object? sender, LocationChangedEventArgs args)
    {
        if (drawerOpen)
        {
            drawerOpen = false;
            _ = InvokeAsync(async () =>
            {
                StateHasChanged();
                try
                {
                    await toggle.FocusAsync();
                }
                catch (JSDisconnectedException)
                {
                }
            });
        }
    }

    public async ValueTask DisposeAsync()
    {
        Navigation.LocationChanged -= Changed;
        try
        {
            if (module is not null)
            {
                await module.InvokeVoidAsync("unwatchNarrow");
                await module.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
        }

        self?.Dispose();
    }
}
