@* B15 (plan sections 14 and 16.6): tabs with their selected state and keyboard: Left and Right move between tabs, Home and End go to the
   first and last, and the selected tab alone is in the tab order. The caller renders the selected panel as the child content, or each tab's panel
   itself (SeparatePanels). *@
<div class="tabs" role="tablist" aria-label="@Label">
    @foreach (var tab in Tabs)
    {
        var selected = tab.Id == Selected;
        <button @key="tab.Id" @ref="buttons[tab.Id]" id="@TabId(tab.Id)" role="tab" class="@(TabClass(tab, selected))" aria-selected="@(selected ? "true" : "false")"
                aria-controls="@(SeparatePanels ? PanelFor(IdPrefix, tab.Id) : PanelId)" tabindex="@(selected ? 0 : -1)" title="@(DrawsIcon(tab) ? tab.Title : null)"
                @onclick="() => Select(tab.Id, false)" @onkeydown="args => Key(tab.Id, args)">
            @if (DrawsIcon(tab))
            {
                <IconLabel Icon="@(tab.Icon!)" Label="@tab.Title" Size="@TabIconSize" />@(tab.Count is { } shown ? $" ({shown})" : string.Empty)
            }
            else
            {
                @tab.Title@(tab.Count is { } count ? $" ({count})" : string.Empty)
            }
        </button>
    }
</div>
@if (!SeparatePanels)
{
    <div class="tab-panel" role="tabpanel" id="@PanelId" aria-labelledby="@TabId(Selected)">
        @ChildContent
    </div>
}

@code {
    /// <summary>
    /// One tab: its id, its title, an optional count shown after it, and an optional icon from wwwroot/icons drawn for the title
    /// (<see cref="IconLibrary.TextByDesign"/> marks a tab that keeps its words, for the Icon Lab's coverage).
    /// </summary>
    public sealed record Tab(string Id, string Title, int? Count = null, string? Icon = null);

    /// <summary>
    /// A tab's icon size in CSS pixels: larger than a toolbar button's 20, since a tab has no button box around it, so the two read the same
    /// size side by side.
    /// </summary>
    private const int TabIconSize = 24;

    private static bool DrawsIcon(Tab tab) => tab.Icon is { } icon && icon != IconLibrary.TextByDesign;

    private static string TabClass(Tab tab, bool selected) => (selected ? "tab active" : "tab") + (DrawsIcon(tab) ? " icon-tab" : string.Empty);

    private readonly Dictionary<string, ElementReference> buttons = new(StringComparer.Ordinal);
    private string? focusPending;

    [Parameter, EditorRequired]
    public IReadOnlyList<Tab> Tabs { get; set; } = [];

    [Parameter, EditorRequired]
    public string Selected { get; set; } = string.Empty;

    [Parameter]
    public EventCallback<string> SelectedChanged { get; set; }

    /// <summary>The tabs' name for assistive technology, such as "Inspector".</summary>
    [Parameter]
    public string Label { get; set; } = "Inspector";

    /// <summary>The prefix of the tab and panel ids, so two tab sets on a page stay distinct.</summary>
    [Parameter]
    public string IdPrefix { get; set; } = "inspector";

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Whether the caller renders a panel for each tab itself (pass 28c, the Play workspace), each with the id <c>{IdPrefix}-panel-{tab}</c>, role
    /// tabpanel, and hidden unless selected, so a panel that is not shown keeps its state; the child content is then not used.
    /// </summary>
    [Parameter]
    public bool SeparatePanels { get; set; }

    /// <summary>The id of a tab's own panel when the caller renders the panels.</summary>
    public static string PanelFor(string prefix, string id) => $"{prefix}-panel-{id}";

    /// <summary>The id of a tab's button, which labels its panel.</summary>
    public static string TabFor(string prefix, string id) => $"{prefix}-tab-{id}";

    private string PanelId => $"{IdPrefix}-panel";

    private string TabId(string id) => TabFor(IdPrefix, id);

    private async Task Select(string id, bool focus)
    {
        if (focus)
        {
            focusPending = id;
        }

        if (id != Selected)
        {
            await SelectedChanged.InvokeAsync(id);
        }
    }

    private Task Key(string id, KeyboardEventArgs args)
    {
        var index = Tabs.ToList().FindIndex(tab => tab.Id == id);
        var next = args.Key switch
        {
            "ArrowRight" => (index + 1) % Tabs.Count,
            "ArrowLeft" => (index - 1 + Tabs.Count) % Tabs.Count,
            "Home" => 0,
            "End" => Tabs.Count - 1,
            _ => -1,
        };
        return next >= 0 ? Select(Tabs[next].Id, true) : Task.CompletedTask;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (focusPending is { } id && buttons.TryGetValue(id, out var button))
        {
            focusPending = null;
            try
            {
                await button.FocusAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }
}
