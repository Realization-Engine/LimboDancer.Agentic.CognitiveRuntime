@using ASL.Turns
@using LimboDancer.Domains.Asl.Play
@implements IDisposable
<button type="button" class="turn-refresh" disabled="@(Busy || loading)" @onclick="Load">Refresh guide</button>
@if (loading) { <p role="status">Loading turn guidance...</p> }
@if (failed) { <p role="alert">Turn guidance could not be loaded. Refresh to try again.</p> }
<div hidden="@(loading || failed)">
    @if (host is not null)
    {
        <TurnGuidePanel Host="host" CurrentPhaseOnly="true" PhaseTitle="@PhaseTitle" ActionRequested="ActionRequested" ReviewRequested="ReviewRequested" CanReviewOpening="CanReviewOpening" CloseRequested="CloseRequested" Busy="@(Busy || loading || failed)" />
    }
</div>
@code {
    [Parameter, EditorRequired] public Func<string, Task<TurnHostGuide>> ReadGuide { get; set; } = null!;
    [Parameter] public long Revision { get; set; }
    [Parameter] public string ActualPhase { get; set; } = "rph";
    [Parameter] public string? PhaseTitle { get; set; }
    [Parameter, EditorRequired] public string ScopeKey { get; set; } = string.Empty;
    [Parameter] public EventCallback<TurnPlacedDcAction> ActionRequested { get; set; }
    [Parameter] public EventCallback<TurnOpeningReviewRequest> ReviewRequested { get; set; }
    [Parameter] public bool CanReviewOpening { get; set; }
    [Parameter] public EventCallback CloseRequested { get; set; }
    [Parameter] public bool Busy { get; set; }
    private TurnHostGuide? host;
    private string? scope;
    private long revision = -1;
    private string? actualPhase;
    private bool loading;
    private bool failed;
    private int generation;
    protected override async Task OnParametersSetAsync()
    {
        if (scope == ScopeKey && revision == Revision && actualPhase == ActualPhase) return;
        if (scope != ScopeKey) { host = null; }
        scope = ScopeKey; revision = Revision; actualPhase = ActualPhase;
        await Load();
    }
    private async Task Load()
    {
        var request = ++generation;
        loading = true; failed = false;
        try
        {
            var result = await ReadGuide(ActualPhase);
            if (request == generation) host = result;
        }
        catch (Exception)
        {
            // Do not display exception details, which may contain undisclosed host state.
            if (request == generation) { host = null; failed = true; }
        }
        finally { if (request == generation) loading = false; }
    }
    public void Dispose() => generation++;
}
