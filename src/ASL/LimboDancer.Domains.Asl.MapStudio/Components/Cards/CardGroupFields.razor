@using LimboDancer.Domains.Asl.Play
@using LimboDancer.Domains.Asl.Units.Catalog
@* Pass 28 (ruling R28.1): one OB group (A19.1; rulings R17.5, R17.8, R17.12): its name, ELR, place in a sequential setup, "?", areas, and counter
   lines, with K18 ObCounterPicker adding a line. *@
<details class="card-group-fields" id="@Id" open>
    <summary>
        <span class="card-group-name">Group @(Index + 1): @Group.Name</span>
        <span class="card-chip">ELR @(Group.Elr.Trim().Length > 0 ? Group.Elr.Trim() : "?")</span>
        @if (Group.SetupOrder.Trim().Length > 0)
        {
            <span class="card-chip">sets up @Group.SetupOrder.Trim()</span>
        }
        @if (Group.Dummies.Trim() is { Length: > 0 } dummies && dummies != "0")
        {
            <span class="card-chip">"?" @dummies</span>
        }
        <span class="card-chip">@Group.Units.Count line(s)</span>
        @if (Problems.Count > 0)
        {
            <span class="card-section-count" title="@($"{Problems.Count} problem(s)")">@Problems.Count</span>
        }
    </summary>
    <SectionProblems Key="@Id" Items="@Problems" />
    <div class="card-field-row">
        <div class="card-field card-field-grow">
            <label for="@($"{Id}-name")">Name</label>
            <input id="@($"{Id}-name")" value="@Group.Name" @onchange="@(args => Set(() => Group.Name = Text(args)))" />
        </div>
        <div class="card-field card-field-short">
            <label for="@($"{Id}-elr")" title="A19.1">ELR</label>
            <input id="@($"{Id}-elr")" value="@Group.Elr" @onchange="@(args => Set(() => Group.Elr = Text(args)))" inputmode="numeric" />
        </div>
        <div class="card-field card-field-short">
            <label for="@($"{Id}-order")" title="A12.12; ruling R17.12: once one group is numbered, every group is, entering groups too">Setup order</label>
            <input id="@($"{Id}-order")" value="@Group.SetupOrder" @onchange="@(args => Set(() => Group.SetupOrder = Text(args)))" placeholder="none" inputmode="numeric" />
        </div>
        <div class="card-field card-field-short">
            <label for="@($"{Id}-dummies")" title="A12.11; ruling R17.12">"?" counters</label>
            <input id="@($"{Id}-dummies")" value="@Group.Dummies" @onchange="@(args => Set(() => Group.Dummies = Text(args)))" placeholder="0" inputmode="numeric" />
        </div>
    </div>
    <p class="card-subhead">Setup or entry areas</p>
    <ul class="card-areas">
        @for (var index = 0; index < Group.Areas.Count; index++)
        {
            var at = index;
            var area = Group.Areas[at];
            <CardAreaFields @key="area" Id="@($"{Id}-area-{at}")" Label="@($"side {SideLabel} group {Index + 1} area {at + 1}")" Area="@area" Boards="@Boards" Picking="@ReferenceEquals(Picking, area)"
                            Pick="@(() => OnPick.InvokeAsync(area))" Remove="@(() => Set(() => Group.Areas.Remove(area)))" Changed="@Changed"
                            Renamed="@(id => RenameArea.InvokeAsync((area, id)))" />
        }
    </ul>
    <button id="@($"{Id}-area-add")" type="button" @onclick="@(() => Set(() => Group.Areas.Add(new AreaDraft { Id = NewAreaId() })))">Add an area</button>
    <table class="card-rows library compact" id="@($"{Id}-units")">
        <caption>Counter lines</caption>
        <thead><tr><th scope="col">Counter</th><th scope="col">Count</th><th scope="col">Area</th><th scope="col"><span class="visually-hidden">Remove</span></th></tr></thead>
        <tbody>
            @for (var index = 0; index < Group.Units.Count; index++)
            {
                var at = index;
                var unit = Group.Units[at];
                <tr @key="unit">
                    <td title="@unit.Definition">@(Catalog.Definition(unit.Definition) is { } definition ? ScenarioCards.Describe(definition) : unit.Definition)</td>
                    <td><input id="@($"{Id}-unit-{at}-count")" value="@unit.Count" @onchange="@(args => Set(() => unit.Count = Text(args)))" size="2" aria-label="@($"Group {Index + 1} line {at + 1} count")" /></td>
                    <td>
                        <select id="@($"{Id}-unit-{at}-area")" value="@unit.Area" @onchange="@(args => Set(() => unit.Area = Text(args)))" aria-label="@($"Group {Index + 1} line {at + 1} area")">
                            <option value="">any of the group's</option>
                            @foreach (var id in AreaIds)
                            {
                                <option value="@id">@id</option>
                            }
                            @if (unit.Area.Length > 0 && !AreaIds.Contains(unit.Area))
                            {
                                <option value="@unit.Area">@unit.Area (no such area)</option>
                            }
                        </select>
                    </td>
                    <td><button id="@($"{Id}-unit-{at}-remove")" type="button" @onclick="@(() => Set(() => Group.Units.Remove(unit)))" aria-label="@($"Remove group {Index + 1} line {at + 1}")">Remove</button></td>
                </tr>
            }
        </tbody>
    </table>
    <span class="card-area-line">Add a counter line: <ObCounterPicker Id="@($"{Id}-pick")" Label="@($"group {Index + 1}")" Side="@Side" Definitions="@Definitions" Areas="@AreaIds" AddRequested="@AddUnit" /></span>
    <p class="card-group-actions"><button id="@($"{Id}-remove")" type="button" class="danger" @onclick="@(() => RemoveGroup.InvokeAsync())">Remove the group</button></p>
</details>

@code {
    [Parameter, EditorRequired]
    public string Id { get; set; } = string.Empty;

    [Parameter]
    public int Index { get; set; }

    [Parameter, EditorRequired]
    public GroupDraft Group { get; set; } = default!;

    [Parameter, EditorRequired]
    public string Side { get; set; } = string.Empty;

    /// <summary>The side's place, for the controls' names.</summary>
    [Parameter]
    public int SideLabel { get; set; }

    [Parameter, EditorRequired]
    public UnitCatalog Catalog { get; set; } = default!;

    [Parameter]
    public IReadOnlyList<UnitDefinition> Definitions { get; set; } = [];

    [Parameter]
    public IReadOnlyList<string> Boards { get; set; } = [];

    /// <summary>The area or condition whose hexes are being picked on the map, if any.</summary>
    [Parameter]
    public object? Picking { get; set; }

    [Parameter]
    public EventCallback<object> OnPick { get; set; }

    [Parameter]
    public EventCallback RemoveGroup { get; set; }

    [Parameter]
    public EventCallback<(AreaDraft Area, string Id)> RenameArea { get; set; }

    [Parameter]
    public EventCallback Changed { get; set; }

    /// <summary>The problems that name this group or its counters.</summary>
    [Parameter]
    public IReadOnlyList<string> Problems { get; set; } = [];

    private IReadOnlyList<string> AreaIds => [.. Group.Areas.Select(area => area.Id).Where(id => id.Length > 0).Distinct(StringComparer.Ordinal)];

    private static string Text(ChangeEventArgs args) => args.Value as string ?? string.Empty;

    private Task Set(Action change)
    {
        change();
        return Changed.InvokeAsync();
    }

    private string NewAreaId()
    {
        var number = Group.Areas.Count + 1;
        while (Group.Areas.Any(area => area.Id == $"area-{number}"))
        {
            number++;
        }

        return $"area-{number}";
    }

    private Task AddUnit(LineDraft unit) => Set(() => Group.Units.Add(unit));
}
