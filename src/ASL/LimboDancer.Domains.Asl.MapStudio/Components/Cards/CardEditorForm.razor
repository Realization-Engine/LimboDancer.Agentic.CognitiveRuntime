@using LimboDancer.Domains.Asl.Units.Catalog
@* K13 (plan section 16.16; rulings R28.1 and R28.2): the editor's form root. It lays out the card's fields as forms, and owns which area or exit
   condition is being picked on the map; the page keeps the library, the checks, save, rename, and delete. The card is shown as read-only JSON. *@
@* The Card editor redesign (2026-10-31): a list of the card's sections, each with its problem count; one section shown at a time; and the map beside
   the sections that pick hexes. Every section stays rendered and the others are hidden, so a field's value and a pick in progress survive a switch. *@
<div class="card-editor-form@(CardSections.UsesMap(Section) ? " with-map" : string.Empty)">
    <nav class="card-sections" aria-label="The card's sections">
        <ul>
            @foreach (var key in CardSections.Keys(Draft))
            {
                var count = Count(key);
                <li>
                    <button id="@($"edit-nav-{key}")" type="button" aria-current="@(key == Section ? "true" : null)" @onclick="@(() => SectionChanged.InvokeAsync(key))">
                        <span class="card-section-name">@CardSections.Label(key, Draft)</span>
                        @if (key != CardSections.Json)
                        {
                            @if (count > 0)
                            {
                                <span class="card-section-count" title="@($"{count} problem(s)")">@count</span>
                            }
                            else
                            {
                                <span class="card-section-ok" aria-label="no problems">&#10003;</span>
                            }
                        }
                    </button>
                </li>
            }
        </ul>
    </nav>
    <div class="card-section-body">
        <section id="edit-section-card" class="card-section" hidden="@(Section != CardSections.Card)">
            <SectionProblems Key="@CardSections.Card" Items="@Of(CardSections.Card)" />
            <CardIdentityFields Draft="@Draft" Changed="@Changed" IdFollowsTitle="@IdFollowsTitle" />
        </section>
        <section id="edit-section-map" class="card-section" hidden="@(Section != CardSections.Map)">
            <SectionProblems Key="@CardSections.Map" Items="@Of(CardSections.Map)" />
            <CardMapFields Draft="@Draft" Changed="@Changed" BoardNames="@BoardNames" SavedMaps="@SavedMaps" />
        </section>
        <section id="edit-section-turns" class="card-section" hidden="@(Section != CardSections.Turns)">
            <SectionProblems Key="@CardSections.Turns" Items="@Of(CardSections.Turns)" />
            <CardTurnRecordFields Draft="@Draft" Changed="@Changed" />
        </section>
        @for (var index = 0; index < Draft.Sides.Length; index++)
        {
            var at = index;
            var key = CardSections.Side(at);
            <section id="@($"edit-section-{key}")" class="card-section" hidden="@(Section != key)">
                <CardSideFields Draft="@Draft" Index="@at" Sides="@Sides" Catalog="@Catalog" Definitions="@Definitions(Draft.Sides[at].Side)" Boards="@CardBoards"
                                Picking="@picking" OnPick="@Pick" Changed="@Changed" RenameArea="@RenameArea" Problems="@Of(key)" />
            </section>
        }
        <section id="edit-section-rules" class="card-section" hidden="@(Section != CardSections.Rules)">
            <SectionProblems Key="@CardSections.Rules" Items="@Of(CardSections.Rules)" />
            <CardRulesFields Draft="@Draft" Changed="@Changed" />
        </section>
        <section id="edit-section-victory" class="card-section" hidden="@(Section != CardSections.Victory)">
            <SectionProblems Key="@CardSections.Victory" Items="@Of(CardSections.Victory)" />
            <CardVictoryFields Draft="@Draft" Picking="@picking" OnPick="@Pick" Changed="@Changed" />
        </section>
        <section id="edit-section-json" class="card-section" hidden="@(Section != CardSections.Json)">
            @if (Json is { } json)
            {
                <JsonDisclosure Id="edit-json" Summary="The card as JSON (read only)" Json="@json" />
            }
            else
            {
                <p id="edit-json-missing" class="muted">The card has problems, so it cannot be written as JSON yet.</p>
            }
        </section>
    </div>
    <details class="card-map-dock" id="edit-map-dock" open hidden="@(!CardSections.UsesMap(Section))">
        <summary>Map: @(CardBoards.Count > 0 ? string.Join(", ", CardBoards) : "no boards")</summary>
        @if (pickNote is { } note)
        {
            <p id="edit-pick-note" class="diagnostic warning" role="status">@note</p>
        }
        <CardMapPicker Map="@Map" Problems="@MapProblems" Target="@Target" Marked="@Marked" OnHex="@PickHex" Done="@(() => picking = null)" />
    </details>
</div>

@code {
    private object? picking;
    private string? pickNote;
    private CardDraft? shown;
    private string? shownSection;
    private Dictionary<string, List<string>> routed = [];

    /// <summary>The section shown (CardSections' keys).</summary>
    [Parameter]
    public string Section { get; set; } = CardSections.Card;

    [Parameter]
    public EventCallback<string> SectionChanged { get; set; }

    /// <summary>The card's problems, which each section shows its own of.</summary>
    [Parameter]
    public IReadOnlyList<string> Problems { get; set; } = [];

    /// <summary>Whether the id follows the title: a new card or a copy, never a saved card, whose rename the games from it feel.</summary>
    [Parameter]
    public bool IdFollowsTitle { get; set; }

    private IReadOnlyList<string> Of(string key) => routed.TryGetValue(key, out var list) ? list : [];

    private int Count(string key) => routed.TryGetValue(key, out var list) ? list.Count : 0;

    [Parameter, EditorRequired]
    public CardDraft Draft { get; set; } = default!;

    [Parameter, EditorRequired]
    public UnitCatalog Catalog { get; set; } = default!;

    [Parameter]
    public IReadOnlyList<(string Name, string Label)> Sides { get; set; } = [];

    [Parameter]
    public IReadOnlyList<string> BoardNames { get; set; } = [];

    [Parameter]
    public IReadOnlyList<MapDefinition> SavedMaps { get; set; } = [];

    [Parameter]
    public StudioBoard? Map { get; set; }

    [Parameter]
    public IReadOnlyList<string> MapProblems { get; set; } = [];

    /// <summary>The card as the library would write it; null while it cannot be built.</summary>
    [Parameter]
    public string? Json { get; set; }

    [Parameter]
    public EventCallback Changed { get; set; }

    // Section 15.3: a new card in the form ends any picking begun on the last one.
    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(shown, Draft))
        {
            shown = Draft;
            (picking, pickNote) = (null, null);
        }

        // Table player and UI review, pass 28: picking ends when its area or condition is removed, hidden, or no longer takes hexes from the map.
        // The redesign: it ends too when another section is shown.
        if (picking is not null && (!Draft.Shows(picking) || (shownSection is not null && shownSection != Section)))
        {
            (picking, pickNote) = (null, null);
        }

        shownSection = Section;
        routed = CardSections.Route(Problems, Draft);
    }

    private IReadOnlyList<string> CardBoards => [.. Draft.Boards.Select(board => board.Board.Trim()).Where(board => board.Length > 0).Distinct(StringComparer.Ordinal)];

    /// <summary>The counters a side may add, in the order the picker lists them.</summary>
    private IReadOnlyList<UnitDefinition> Definitions(string side) =>
        [.. Catalog.Definitions.Where(item => item.Nationality == side).OrderBy(item => item.Kind, StringComparer.Ordinal).ThenBy(item => item.Id, StringComparer.Ordinal)];

    private string? Target => picking switch
    {
        AreaDraft area => area.Kind == "building" ? $"the building of area '{area.Id}' (one click picks the whole building)" : $"the entry hexes of area '{area.Id}'",
        ConditionDraft condition => $"the exit hexes of {condition.Side}'s condition",
        _ => null,
    };

    private IReadOnlyList<CardHex> Marked => picking switch
    {
        AreaDraft area => [.. CardDraft.Words(area.Hexes).Select(hex => new CardHex(area.Board.Length > 0 ? area.Board : CardBoards.FirstOrDefault() ?? string.Empty, hex))],
        ConditionDraft condition => [.. CardDraft.Words(condition.Near).Select(CardMaps.Parse).OfType<CardHex>()],
        _ => [],
    };

    private Task RenameArea((AreaDraft Area, string Id) change)
    {
        Draft.RenameArea(change.Area, change.Id);
        return Changed.InvokeAsync();
    }

    private void Pick(object target)
    {
        picking = ReferenceEquals(picking, target) ? null : target;
        pickNote = null;
    }

    // Ruling R28.2: a building is picked whole, its clicked hex its anchor; an entry's or an exit condition's hexes are added or removed one by one.
    private async Task PickHex(CardHex hex)
    {
        pickNote = null;
        var several = CardBoards.Count > 1;
        switch (picking)
        {
            case AreaDraft { Kind: "building" } area when Map is not null:
                var building = CardMaps.Building(Map, hex);
                if (building.Count == 0)
                {
                    pickNote = $"{hex} is not a building hex.";
                    return;
                }

                Draft.RenameArea(area, hex.Hex);
                (area.Hexes, area.Board) = (string.Join(' ', building), several ? hex.Board : string.Empty);
                picking = null;
                break;
            case AreaDraft area:
                var board = area.Board.Length > 0 ? area.Board : several ? string.Empty : hex.Board;
                if (CardDraft.Words(area.Hexes).Count > 0 && board.Length > 0 && board != hex.Board)
                {
                    pickNote = $"An entry's hexes are on one board; {hex} is on another.";
                    return;
                }

                area.Hexes = Toggle(area.Hexes, hex.Hex);
                area.Board = several ? hex.Board : string.Empty;
                break;
            case ConditionDraft condition:
                condition.Near = Toggle(condition.Near, hex.ToString());
                break;
            default:
                return;
        }

        await Changed.InvokeAsync();
    }

    private static string Toggle(string words, string word)
    {
        var list = CardDraft.Words(words);
        if (!list.Remove(word))
        {
            list.Add(word);
        }

        return string.Join(' ', list);
    }
}
