@using LimboDancer.Domains.Asl.Play
@using LimboDancer.Domains.Asl.Units.State
@* Pass 28 (ruling R28.1): the Victory Conditions (A26; rulings R17.11, R21.3): their kind, text, and rules; and, when the game evaluates them, the
   outcomes in order, each a winner and its conditions with the fields of their type, and the result when none holds. An exit condition's hexes may
   be picked on the map (ruling R28.2). *@
<fieldset class="card-fields" id="edit-victory">
    <legend>Victory Conditions (A26)</legend>
    <div class="card-field-row">
        <div class="card-field">
            <label for="edit-victory-kind">Kind</label>
            <select id="edit-victory-kind" value="@Victory.Kind" @onchange="@(args => Set(() => Victory.Kind = Text(args)))">
                @foreach (var kind in ScenarioCards.VictoryKinds)
                {
                    <option value="@kind">@kind</option>
                }
            </select>
        </div>
        <div class="card-field card-field-grow">
            <label for="edit-victory-rules" title="The A26 fragments or rulings they rest on, separated by spaces (ruling R17.11).">Rules cited</label>
            <input id="edit-victory-rules" value="@Victory.Rules" @onchange="@(args => Set(() => Victory.Rules = Text(args)))" placeholder="A26.1 A26.3" />
        </div>
    </div>
    <div class="card-field-row">
        <div class="card-field card-field-wide">
            <label for="edit-victory-text">As the card says</label>
            <textarea id="edit-victory-text" rows="3" @onchange="@(args => Set(() => Victory.Text = Text(args)))" value="@Victory.Text"></textarea>
        </div>
    </div>
    <label class="card-check">
        <input id="edit-victory-evaluated" aria-describedby="edit-victory-evaluated-help" type="checkbox" checked="@Victory.Evaluated" @onchange="@(args => Set(() => Victory.Evaluated = args.Value is true))" />
        The game judges the result
    </label>
    <p class="field-help" id="edit-victory-evaluated-help">A minimal card's are not: the players judge the result (ruling R22.3).</p>
    @if (Victory.Evaluated)
    {
        <ol class="card-outcomes">
            @for (var index = 0; index < Victory.Outcomes.Count; index++)
            {
                var at = index;
                var outcome = Victory.Outcomes[at];
                <li @key="outcome" id="@($"edit-outcome-{at}")" class="card-outcome">
                    <span class="card-area-line card-outcome-head">
                        <select id="@($"edit-outcome-{at}-winner")" value="@outcome.Winner" @onchange="@(args => Set(() => outcome.Winner = Text(args)))" aria-label="@($"Outcome {at + 1} winner")">
                            <option value="">choose who</option>
                            @WinnerOptions
                        </select>
                        <span>@(outcome.Winner == "draw" ? "is the result" : "wins")</span>
                        <label class="card-check"><input id="@($"edit-outcome-{at}-immediate")" type="checkbox" checked="@outcome.Immediate" @onchange="@(args => Set(() => outcome.Immediate = args.Value is true))" /> at once, after any action,</label>
                        <span>if any of these holds:</span>
                        <button id="@($"edit-outcome-{at}-remove")" type="button" class="card-outcome-remove" @onclick="@(() => Set(() => Victory.Outcomes.Remove(outcome)))">Remove the outcome</button>
                    </span>
                    <ul>
                        @for (var number = 0; number < outcome.Conditions.Count; number++)
                        {
                            var place = number;
                            var condition = outcome.Conditions[place];
                            var id = $"edit-condition-{at}-{place}";
                            <li @key="condition" id="@id" class="card-area-line">
                                <select id="@($"{id}-side")" value="@condition.Side" @onchange="@(args => Set(() => condition.Side = Text(args)))" aria-label="@($"Outcome {at + 1} condition {place + 1} side")">
                                    <option value="">choose a side</option>
                                    @SideOptions
                                </select>
                                <select id="@($"{id}-type")" value="@condition.Type" @onchange="@(args => Set(() => condition.ChangeType(Text(args))))" aria-label="@($"Outcome {at + 1} condition {place + 1}")">
                                    @foreach (var type in ScenarioCards.ConditionTypes)
                                    {
                                        <option value="@type">@Describe(type)</option>
                                    }
                                </select>
                                @switch (condition.Type)
                                {
                                    case "control-margin":
                                        <label>buildings <input id="@($"{id}-buildings")" value="@condition.Buildings" @onchange="@(args => Set(() => condition.Buildings = Text(args)))" size="18" placeholder="F5 K5" /></label>
                                        <label>against <input id="@($"{id}-versus")" value="@condition.Versus" @onchange="@(args => Set(() => condition.Versus = Text(args)))" size="18" /></label>
                                        <label>by at least <input id="@($"{id}-margin")" value="@condition.Margin" @onchange="@(args => Set(() => condition.Margin = Text(args)))" size="2" /></label>
                                        break;
                                    case "control-count":
                                        <label>hexes, at least <input id="@($"{id}-atleast")" value="@condition.AtLeast" @onchange="@(args => Set(() => condition.AtLeast = Text(args)))" size="2" /></label>
                                        <label>of building <input id="@($"{id}-building")" value="@condition.Building" @onchange="@(args => Set(() => condition.Building = Text(args)))" size="6" /></label>
                                        <label><input id="@($"{id}-melee")" type="checkbox" checked="@(condition.MeleeUncontrolled is true)" @onchange="@(args => Set(() => condition.MeleeUncontrolled = args.Value is true))" /> a hex in Melee Controlled by neither</label>
                                        break;
                                    case "squad-ratio":
                                        <label>at least <input id="@($"{id}-ratio")" value="@condition.Ratio" @onchange="@(args => Set(() => condition.Ratio = Text(args)))" size="3" /> times the other side's unbroken squad-equivalents</label>
                                        break;
                                    case "sole-unbroken":
                                        <label>in building <input id="@($"{id}-building")" value="@condition.Building" @onchange="@(args => Set(() => condition.Building = Text(args)))" size="6" /></label>
                                        break;
                                    case "exit-vp":
                                        <label>at least <input id="@($"{id}-atleast")" value="@condition.AtLeast" @onchange="@(args => Set(() => condition.AtLeast = Text(args)))" size="2" /> Exit VP</label>
                                        <label>
                                            off the
                                            <select id="@($"{id}-edge")" value="@condition.Edge" @onchange="@(args => Set(() => condition.Edge = Text(args)))">
                                                <option value="">choose</option>
                                                @foreach (var edge in SideState.Edges)
                                                {
                                                    <option value="@edge">@edge</option>
                                                }
                                            </select>
                                            edge
                                        </label>
                                        <label>on or adjacent to <input id="@($"{id}-near")" value="@condition.Near" @onchange="@(args => Set(() => condition.Near = Text(args)))" size="24" placeholder="bd02:I1 bd02:Q1" /></label>
                                        <button id="@($"{id}-pick")" type="button" aria-pressed="@ReferenceEquals(Picking, condition).ToString().ToLowerInvariant()" @onclick="@(() => OnPick.InvokeAsync(condition))">
                                            Pick on the map
                                        </button>
                                        break;
                                    default:
                                        <label>at least <input id="@($"{id}-atleast")" value="@condition.AtLeast" @onchange="@(args => Set(() => condition.AtLeast = Text(args)))" size="3" /> CVP</label>
                                        break;
                                }
                                <button id="@($"{id}-remove")" type="button" @onclick="@(() => Set(() => outcome.Conditions.Remove(condition)))">Remove</button>
                            </li>
                        }
                    </ul>
                    <button id="@($"edit-outcome-{at}-condition-add")" type="button" @onclick="@(() => Set(() => outcome.Conditions.Add(new ConditionDraft { Side = outcome.Winner == "draw" ? string.Empty : outcome.Winner })))">Add a condition</button>
                </li>
            }
        </ol>
        <button id="edit-outcome-add" type="button" @onclick="@(() => Set(() => Victory.Outcomes.Add(new OutcomeDraft())))">Add an outcome</button>
        <FieldGroup Label="When none holds at game end" For="edit-victory-otherwise">
            <ChildContent>
                <select id="edit-victory-otherwise" aria-describedby="edit-victory-otherwise-help" value="@Victory.Otherwise" @onchange="@(args => Set(() => Victory.Otherwise = Text(args)))">
                    <option value="">choose</option>
                    @WinnerOptions
                </select>
            </ChildContent>
            <Help>A side wins (Avoidance, A26.3), or it is a draw.</Help>
        </FieldGroup>
    }
</fieldset>

@code {
    [Parameter, EditorRequired]
    public CardDraft Draft { get; set; } = default!;

    [Parameter]
    public object? Picking { get; set; }

    [Parameter]
    public EventCallback<object> OnPick { get; set; }

    [Parameter]
    public EventCallback Changed { get; set; }

    private VictoryDraft Victory => Draft.Victory;

    private static string Text(ChangeEventArgs args) => args.Value as string ?? string.Empty;

    private Task Set(Action change)
    {
        change();
        return Changed.InvokeAsync();
    }

    private static string Describe(string type) => type switch
    {
        "control-margin" => "Controls more buildings than the other side",
        "control-count" => "Controls hexes of a building",
        "squad-ratio" => "has more unbroken squad-equivalents",
        "sole-unbroken" => "alone has an unbroken unit in a building",
        "exit-vp" => "exits Exit VP",
        _ => "has CVP",
    };

    private RenderFragment SideOptions => builder =>
    {
        foreach (var side in Draft.Sides.Select(item => item.Side).Distinct(StringComparer.Ordinal))
        {
            builder.OpenElement(0, "option");
            builder.AddAttribute(1, "value", side);
            builder.AddContent(2, CardText.Side(side));
            builder.CloseElement();
        }
    };

    private RenderFragment WinnerOptions => builder =>
    {
        builder.AddContent(0, SideOptions);
        builder.OpenElement(1, "option");
        builder.AddAttribute(2, "value", "draw");
        builder.AddContent(3, "a draw");
        builder.CloseElement();
    };
}
