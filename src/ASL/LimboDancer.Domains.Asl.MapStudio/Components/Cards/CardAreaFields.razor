@using LimboDancer.Domains.Asl.Play
@using LimboDancer.Domains.Asl.Units.State
@* Pass 28 (ruling R28.1): one setup or entry area of an OB group (rulings R17.8, R19.4, R25.2), its fields by kind. A building or an entry's hexes
   may be picked on the map (ruling R28.2): a click on a building picks the whole building, a click on an entry hex adds or removes it. *@
<li class="card-area@(Picking ? " picking" : string.Empty)" id="@Id">
    @* The Card editor redesign (2026-10-31): an area reads as one line, opened to edit; a new area starts open. *@
    <details open="@startOpen">
    <summary class="card-area-chip">
        <span class="card-area-id">@(Area.Id.Length > 0 ? Area.Id : "no id")</span>
        <span>@Summary</span>
        @if (Picking)
        {
            <span class="card-chip card-chip-on">picking on the map</span>
        }
    </summary>
    <span class="card-area-line">
        <label>@(Area.Kind == "building" ? "anchor hex" : "id") <input id="@($"{Id}-id")" aria-label="@($"{Label} id")" value="@Area.Id" @onchange="@(args => Renamed.InvokeAsync(Text(args).Trim()))" size="6" /></label>
        <label>
            kind
            <select id="@($"{Id}-kind")" aria-label="@($"{Label} kind")" value="@Area.Kind" @onchange="@(args => Set(() => Area.Kind = Text(args)))">
                @foreach (var kind in ScenarioCards.AreaKinds)
                {
                    <option value="@kind">@kind</option>
                }
            </select>
        </label>
        @if (Boards.Count > 1 || Area.Board.Length > 0 || Area.Kind == "hex-numbers")
        {
            <label>
                board
                <select id="@($"{Id}-board")" value="@Area.Board" @onchange="@(args => Set(() => Area.Board = Text(args)))">
                    <option value="">@(Boards.Count == 1 && Area.Kind != "hex-numbers" ? "the card's" : "choose")</option>
                    @foreach (var board in Boards)
                    {
                        <option value="@board">@board</option>
                    }
                    @if (Area.Board.Length > 0 && !Boards.Contains(Area.Board))
                    {
                        <option value="@Area.Board">@Area.Board (not on the card)</option>
                    }
                </select>
            </label>
        }
        @switch (Area.Kind)
        {
            case "building":
                <label>hexes, the anchor among them <input id="@($"{Id}-hexes")" value="@Area.Hexes" @onchange="@(args => Set(() => Area.Hexes = Text(args)))" size="24" /></label>
                break;
            case "hex-numbers":
                <label>hex numbers <input id="@($"{Id}-from")" value="@Area.From" @onchange="@(args => Set(() => Area.From = Text(args)))" size="2" /></label>
                <label>to <input id="@($"{Id}-to")" value="@Area.To" @onchange="@(args => Set(() => Area.To = Text(args)))" size="2" /></label>
                break;
            default:
                <label>Game Turn <input id="@($"{Id}-turn")" value="@Area.Turn" @onchange="@(args => Set(() => Area.Turn = Text(args)))" size="2" /></label>
                <label>
                    edge
                    <select id="@($"{Id}-edge")" value="@Area.Edge" @onchange="@(args => Set(() => Area.Edge = Text(args)))">
                        <option value="">choose</option>
                        @foreach (var edge in SideState.Edges)
                        {
                            <option value="@edge">@edge</option>
                        }
                    </select>
                </label>
                <label>entry hexes <input id="@($"{Id}-hexes")" value="@Area.Hexes" @onchange="@(args => Set(() => Area.Hexes = Text(args)))" size="20" placeholder="any of the edge" /></label>
                break;
        }
        @if (Area.Kind != "hex-numbers")
        {
            <button id="@($"{Id}-pick")" type="button" aria-pressed="@Picking.ToString().ToLowerInvariant()" aria-label="@($"Pick {Label} on the map")" @onclick="@(() => Pick.InvokeAsync())">Pick on the map</button>
        }
        <button id="@($"{Id}-remove")" type="button" aria-label="@($"Remove {Label}")" @onclick="@(() => Remove.InvokeAsync())">Remove the area</button>
    </span>
    <span class="card-area-line">
        <label>limit, as the SSR says <input id="@($"{Id}-limit")" value="@Area.Limit" @onchange="@(args => Set(() => Area.Limit = Text(args)))" size="40" /></label>
        @if (Area.Kind != "entry")
        {
            <label title="ruling R19.4">counters <input id="@($"{Id}-counters")" value="@Area.Counters" @onchange="@(args => Set(() => Area.Counters = Text(args)))" size="2" placeholder="any" /></label>
            <label title="ruling R19.4">MMC at least <input id="@($"{Id}-minmmc")" value="@Area.MinMmc" @onchange="@(args => Set(() => Area.MinMmc = Text(args)))" size="2" /></label>
            <label title="ruling R19.4">
                under "?"
                <select id="@($"{Id}-concealed")" value="@(Area.Concealed switch { true => "yes", false => "no", _ => "" })"
                        @onchange="@(args => Set(() => Area.Concealed = Text(args) switch { "yes" => true, "no" => false, _ => null }))">
                    <option value="">as the rules allow</option>
                    <option value="yes">yes</option>
                    <option value="no">no</option>
                </select>
            </label>
        }
    </span>
    </details>
</li>

@code {
    [Parameter, EditorRequired]
    public string Id { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public AreaDraft Area { get; set; } = default!;

    /// <summary>Which area this is ("side 1 group 2 area 1"), for the controls' names.</summary>
    [Parameter]
    public string Label { get; set; } = "area";

    /// <summary>The card's boards by name.</summary>
    [Parameter]
    public IReadOnlyList<string> Boards { get; set; } = [];

    /// <summary>Whether this area's hexes are being picked on the map.</summary>
    [Parameter]
    public bool Picking { get; set; }

    [Parameter]
    public EventCallback Pick { get; set; }

    [Parameter]
    public EventCallback Remove { get; set; }

    /// <summary>A new id typed for the area; the card's counter lines and conditions naming it follow.</summary>
    [Parameter]
    public EventCallback<string> Renamed { get; set; }

    [Parameter]
    public EventCallback Changed { get; set; }

    // Read once, so a re-render never opens or closes the area under the author's hand.
    private bool startOpen;

    protected override void OnInitialized() => startOpen = Area.Hexes.Trim().Length == 0 && Area.From.Trim().Length == 0 && Area.Edge.Length == 0;

    private string Summary => Area.Kind switch
    {
        "building" => Area.Hexes.Trim().Length > 0 ? $"building {Hexes(Area.Hexes)}" : "building, not picked yet",
        "hex-numbers" => $"hex numbers {Or(Area.From)} to {Or(Area.To)}{(Area.Board.Length > 0 ? $" on {Area.Board}" : string.Empty)}",
        "entry" => $"enters {(Area.Edge.Length > 0 ? $"from the {Area.Edge} edge" : "from an edge not chosen yet")}{(Area.Turn.Trim().Length > 0 ? $" on turn {Area.Turn.Trim()}" : string.Empty)}"
            + (Area.Hexes.Trim().Length > 0 ? $" at {Hexes(Area.Hexes)}" : string.Empty),
        _ => $"{Area.Kind}{(Area.Hexes.Trim().Length > 0 ? $" {Hexes(Area.Hexes)}" : string.Empty)}",
    };

    private static string Or(string text) => text.Trim().Length > 0 ? text.Trim() : "?";

    private static string Hexes(string hexes) => string.Join(" ", CardDraft.Words(hexes).Select(hex => $"[{hex}]"));

    private static string Text(ChangeEventArgs args) => args.Value as string ?? string.Empty;

    private Task Set(Action change)
    {
        change();
        return Changed.InvokeAsync();
    }
}
