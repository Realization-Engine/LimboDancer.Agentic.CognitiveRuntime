<span class="asl-roll @(Compact ? "compact" : "expanded")" data-roll="@Roll.Key" aria-label="@Roll.Purpose">
    @if (!string.IsNullOrEmpty(Roll.Purpose))
    {
        <span class="asl-roll-purpose">@Roll.Purpose</span>
    }
    @for (var index = 0; index < Roll.Dice.Count; index++)
    {
        var die = Roll.Dice[index];
        <span class="asl-die @die.Role.ToString().ToLowerInvariant()">
            @if (die.Sides == 6 && (die.Value is null || die.Value is >= 1 and <= 6))
            {
                <svg @key="(Roll.Key, index)" class="@(Animate ? "asl-die-new" : null)" viewBox="0 0 100 100" role="img"
                     aria-label="@($"{die.Label}: {ValueText(die)}")">
                    <rect x="3" y="3" width="94" height="94" rx="16" />
                    @if (die.Value is { } value)
                    {
                        @foreach (var pip in Pips[value - 1])
                        {
                            <circle cx="@pip.X" cy="@pip.Y" r="8" />
                        }
                    }
                    else
                    {
                        <path d="M36 36 Q36 20 50 20 Q68 20 68 36 Q68 46 50 53 L50 62 M50 72 L50 78" fill="none" stroke="currentColor" stroke-width="5" />
                    }
                </svg>
            }
            <span class="asl-die-label">@die.Label: @ValueText(die)</span>
        </span>
    }
    @if (Roll.State != AslRollState.Recorded)
    {
        <span class="muted">@(Roll.State == AslRollState.Queued ? "Queued" : "Not rolled")</span>
    }
</span>

@code {
    [Parameter, EditorRequired] public AslRollView Roll { get; set; } = new("", "", []);
    [Parameter] public bool Compact { get; set; } = true;
    [Parameter] public bool Animate { get; set; }

    private static string ValueText(AslDieView die) => die.Value is { } value
        ? value.ToString(System.Globalization.CultureInfo.InvariantCulture) + (die.Sides == 6 ? "" : $" (d{die.Sides})") : "Not rolled";

    private static readonly (int X, int Y)[][] Pips =
    [
        [(50, 50)], [(25, 25), (75, 75)], [(25, 25), (50, 50), (75, 75)],
        [(25, 25), (75, 25), (25, 75), (75, 75)],
        [(25, 25), (75, 25), (50, 50), (25, 75), (75, 75)],
        [(25, 25), (75, 25), (25, 50), (75, 50), (25, 75), (75, 75)],
    ];
}
