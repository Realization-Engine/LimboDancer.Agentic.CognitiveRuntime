@using LimboDancer.Domains.Asl.Units.Vocabulary
@* E03 (plan section 16.14): one face's characteristics (attributes) and capabilities (traits); the unit editor keys it by face. *@
<fieldset class="unit-face" data-face="@Face">
    <legend>@Vocabulary.FaceLabel(Face) face</legend>
    <UnitAttributeFields Definitions="@Attributes" IdOf="@(definition => $"{Prefix}-{Face}-{definition.LocalName}")"
                         ValueOf="@(definition => Draft.Value(Face, definition.Name))" OnValue="@((definition, text) => Change(() => Draft.SetValue(Face, definition.Name, text)))" />
    <div class="checks">
        @foreach (var trait in Traits)
        {
            <label title="@trait.Rule">
                <input id="@($"{Prefix}-{Face}-{VocabularyNames.Local(trait.Name)}")" type="checkbox" checked="@Draft.HasTrait(Face, trait.Name)"
                       @onchange="@(args => Change(() => Draft.SetTrait(Face, trait.Name, args.Value is true)))" />
                @trait.Label
            </label>
        }
    </div>
</fieldset>

@code {
    [Parameter, EditorRequired]
    public string Face { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public UnitDraft Draft { get; set; } = null!;

    [Parameter, EditorRequired]
    public UnitVocabulary Vocabulary { get; set; } = null!;

    [Parameter, EditorRequired]
    public string Prefix { get; set; } = "unit";

    /// <summary>The face's attributes, in the kind's order.</summary>
    [Parameter, EditorRequired]
    public IReadOnlyList<AttributeDefinition> Attributes { get; set; } = [];

    [Parameter, EditorRequired]
    public IReadOnlyList<TraitDefinition> Traits { get; set; } = [];

    [Parameter]
    public EventCallback OnChange { get; set; }

    private Task Change(Action change)
    {
        change();
        return OnChange.InvokeAsync();
    }
}
