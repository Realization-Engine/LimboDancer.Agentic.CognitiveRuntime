@using LimboDancer.Domains.Asl.Units.Vocabulary

@* Forms generated from the vocabulary (Unit Display Design, section 10): the unit's identity, then each face's characteristics and
   capabilities (E03), the whole unit's attributes, and its states (plan section 12.4). *@
<fieldset class="unit-identity">
<legend>Identity</legend>
<div class="fields">
    <label for="@($"{Prefix}-id")">ID</label>
    <input id="@($"{Prefix}-id")" value="@Draft.Id" @onchange="@(args => Change(() => Draft.Id = args.Value as string ?? string.Empty))" />
    <label for="@($"{Prefix}-kind")">Kind</label>
    <select id="@($"{Prefix}-kind")" value="@Draft.Kind" disabled="@Draft.Concealed" @onchange="@(args => Change(() => Draft.Kind = args.Value as string ?? Draft.Kind))">
        @foreach (var kind in Vocabulary.Kinds.Where(kind => kind.Name != VocabularyNames.RootKind))
        {
            <option value="@kind.Name">@kind.Name (@kind.Label)</option>
        }
    </select>
    <label for="@($"{Prefix}-side")">Side</label>
    <select id="@($"{Prefix}-side")" value="@(Draft.Side ?? string.Empty)" @onchange="@(args => Change(() => Draft.Side = args.Value as string is { Length: > 0 } side ? side : null))">
        <option value="">@(IsAttached ? "the owner's" : "none")</option>
        @foreach (var side in Vocabulary.Sides)
        {
            <option value="@side.Name">@side.Label</option>
        }
    </select>
    @if (!IsAttached && !Draft.Concealed && Vocabulary.HasKind(Draft.Kind) && Vocabulary.HasFacing(Draft.Kind))
    {
        <label for="@($"{Prefix}-facing")" title="C3.2, p. 169">Facing (hexspine)</label>
        <select id="@($"{Prefix}-facing")" value="@(Draft.Facing?.Name() ?? string.Empty)"
                @onchange="@(args => Change(() => Draft.Facing = UnitFacings.TryParse(args.Value as string, out var facing) ? facing : null))">
            <option value="">not given</option>
            @foreach (var name in UnitFacings.All)
            {
                <option value="@name">@name</option>
            }
        </select>
    }
    @if (!IsAttached && !Draft.Concealed && Vocabulary.HasKind(Draft.Kind) && Vocabulary.HasHexside(Draft.Kind))
    {
        <label for="@($"{Prefix}-hexside")" title="B29.1, p. 150">Hexside</label>
        <select id="@($"{Prefix}-hexside")" value="@(Draft.Hexside?.Name() ?? string.Empty)"
                @onchange="@(args => Change(() => Draft.Hexside = UnitHexsides.TryParse(args.Value as string, out var hexside) ? hexside : null))">
            <option value="">not given</option>
            @foreach (var name in UnitHexsides.All)
            {
                <option value="@name">@name</option>
            }
        </select>
    }
    @if (!IsAttached && !Draft.Concealed && Vocabulary.HasKind(Draft.Kind) && Vocabulary.HasTurret(Draft.Kind))
    {
        <label for="@($"{Prefix}-turret-facing")" title="D3.12, p. 199">Turret facing</label>
        <select id="@($"{Prefix}-turret-facing")" value="@(Draft.TurretFacing?.Name() ?? string.Empty)"
                @onchange="@(args => Change(() => Draft.TurretFacing = UnitFacings.TryParse(args.Value as string, out var facing) ? facing : null))">
            <option value="">with the hull</option>
            @foreach (var name in UnitFacings.All)
            {
                <option value="@name">@name</option>
            }
        </select>
    }
    @if (!IsAttached)
    {
        <label for="@($"{Prefix}-concealed")" title="The opponent's view of a concealed unit: side, Location, and size class only (section 7.3)">"?" placeholder only</label>
        <input id="@($"{Prefix}-concealed")" type="checkbox" checked="@Draft.Concealed" @onchange="@(args => Change(() => Draft.Concealed = args.Value is true))" />
        @if (Draft.Concealed)
        {
            <label for="@($"{Prefix}-size-class")">Size class</label>
            <select id="@($"{Prefix}-size-class")" value="@(Draft.SizeClass?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? string.Empty)"
                    @onchange="@(args => Change(() => Draft.SizeClass = int.TryParse(args.Value as string, out var size) ? size : null))">
                <option value="">not known to the viewer</option>
                <option value="1">1</option>
                <option value="2">2</option>
                <option value="3">3</option>
            </select>
        }
    }
</div>
</fieldset>

@if (Draft.Concealed)
{
    <p class="muted">A concealed placeholder carries only side, location, and an optional size class (section 7.3).</p>
}
else if (Vocabulary.HasKind(Draft.Kind))
{
    @foreach (var face in Vocabulary.Faces(Draft.Kind))
    {
        <UnitFaceEditor @key="face" Face="@face" Draft="@Draft" Vocabulary="@Vocabulary" Prefix="@Prefix" OnChange="@OnChange"
                        Attributes="@([.. Attributes(AttributeScope.Face).Where(item => item.Faces.Count == 0 || item.Faces.Contains(face))])"
                        Traits="@([.. Traits().Where(trait => trait.Faces.Count == 0 || trait.Faces.Contains(face))])" />
    }

    @if (Attributes(AttributeScope.Unit).Any())
    {
        <fieldset>
            <legend>Whole unit</legend>
            <UnitAttributeFields Definitions="@([.. Attributes(AttributeScope.Unit)])" IdOf="@(definition => $"{Prefix}-unit-{definition.LocalName}")"
                                 ValueOf="@(definition => Draft.UnitValue(definition.Name))" OnValue="@((definition, text) => Change(() => Draft.SetUnitValue(definition.Name, text)))" />
        </fieldset>
    }

    <fieldset>
        <legend>States</legend>
        <div class="checks">
            @foreach (var state in Vocabulary.States)
            {
                <label title="@state.Rule">
                    <input id="@($"{Prefix}-state-{VocabularyNames.Local(state.Name)}")" type="checkbox" checked="@Draft.States.Contains(state.Name)"
                           @onchange="@(args => Change(() => Draft.SetState(state.Name, args.Value is true)))" />
                    @state.Label@(state.Face is { } turned ? $" (shows the {Vocabulary.FaceLabel(turned)} face)" : string.Empty)
                </label>
            }
        </div>
    </fieldset>
}

@code {
    [Parameter, EditorRequired]
    public UnitDraft Draft { get; set; } = default!;

    [Parameter, EditorRequired]
    public UnitVocabulary Vocabulary { get; set; } = default!;

    /// <summary>The prefix of every input id, so forms for the owner and each attachment stay distinct.</summary>
    [Parameter]
    public string Prefix { get; set; } = "unit";

    [Parameter]
    public bool IsAttached { get; set; }

    [Parameter]
    public EventCallback OnChange { get; set; }

    private IEnumerable<AttributeDefinition> Attributes(AttributeScope scope) =>
        Vocabulary.AcceptedAttributes(Draft.Kind)
            .Select(name => Vocabulary.TryGetAttribute(name, out var definition) ? definition : null)
            .OfType<AttributeDefinition>()
            .Where(definition => definition.Scope == scope)
            .OrderBy(definition => Order(definition.Name));

    private IEnumerable<TraitDefinition> Traits() =>
        Vocabulary.AcceptedTraits(Draft.Kind)
            .Select(name => Vocabulary.TryGetTrait(name, out var trait) ? trait : null)
            .OfType<TraitDefinition>()
            .OrderBy(trait => trait.Name, StringComparer.Ordinal);

    /// <summary>Attributes in the order the kind and its ancestors declare them, root first.</summary>
    private int Order(string name)
    {
        var order = Vocabulary.Ancestors(Draft.Kind).Reverse().SelectMany(kind => Vocabulary.Kind(kind).Attributes).ToList();
        var index = order.IndexOf(name);
        return index < 0 ? int.MaxValue : index;
    }

    private Task Change(Action change)
    {
        change();
        return OnChange.InvokeAsync();
    }
}
