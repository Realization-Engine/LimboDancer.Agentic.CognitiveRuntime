@* Plan A09 (pass 28b): the units under DM that may keep it as the RPh ends (A10.62). These are choices, not an action: the page sends the checked
   units with the phase's advance. The page gives the units the view sees that the planner allows (ruling R23.1). *@
@if (Units.Count > 0)
{
    <fieldset class="toolbar" id="retain-dm">
        <legend>Keep DM as the RPh ends, outside woods and buildings (A10.62); sent when the phase is advanced</legend>
        @foreach (var unit in Units)
        {
            <label @key="unit"><input class="retain-dm" type="checkbox" data-unit="@unit" checked="@Selected.Contains(unit)"
                                      @onchange="@(args => OnToggle.InvokeAsync(new Toggle(unit, args.Value is true)))" /> @At(unit)</label>
        }
    </fieldset>
}

@code {
    /// <summary>The page's words for the view (pass 31c, design D11): a unit's name for its id, a Location in words.</summary>
    [CascadingParameter(Name = "Say")]
    public Func<string, string>? Words { get; set; }

    private string Say(string? text) => text is null ? string.Empty : Words?.Invoke(text) ?? text;

    /// <summary>A unit's name with its hex, "4-6-7 squad G4 in [G4]" (the user, 2026-10-04), where no Location stands beside the name.</summary>
    [CascadingParameter(Name = "SayAt")]
    public Func<string, string>? WordsAt { get; set; }

    private string At(string? text) => text is null ? string.Empty : WordsAt?.Invoke(text) ?? Say(text);

    /// <summary>A unit checked or cleared.</summary>
    public sealed record Toggle(string Id, bool On);

    [Parameter, EditorRequired]
    public IReadOnlyList<string> Units { get; set; } = [];

    [Parameter]
    public IReadOnlySet<string> Selected { get; set; } = new HashSet<string>();

    [Parameter]
    public EventCallback<Toggle> OnToggle { get; set; }
}
