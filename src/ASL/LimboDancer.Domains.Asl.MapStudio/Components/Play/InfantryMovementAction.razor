@* Plan A13 (pass 25): the moving side's movers and their step: the Location entered (a hex of the entry edge for units waiting off board, ruling
   R25.3), Minimum Move, Bypass, Assault Movement, Double Time, and a crew's push of its Gun. The page reads the movers for the view (ruling R23.1),
   keeps the draft and its reset rules (plan section 15.3), and proposes the move; the planner decides it. *@
<UnitSelectionList Rows="@Movers" Selected="@Selected" CssClass="move-unit" Legend="Units moving" Empty="none may move now." OnToggle="@OnToggle" />
@* The Play streamlining plan, S3: the route plotted on the map comes right after the stack, and the one-step form behind a closed line; it opens by
   itself when a step is being drafted. *@
@Route
<details id="move-step-form" class="move-step-form" open="@StepDrafted">
<summary>One step at a time: To, Bypass, Dash, Minimum Move, Assault Movement, Double Time</summary>
<ActionFormGroup Legend="Destination">
<LocationField Id="move-to" Label="To" Value="@Draft.To" DescribedBy="move-help-summary" Title="A Location such as bd01:D5:0; the level after the hex moves up or down a stairwell or along an upper level of a building (B23.4, B23.421); units waiting off board enter a hex of their entry edge (A2.51)" OnChange="@(value => Changed(Draft with { To = value }))" />
</ActionFormGroup>
<ActionFormGroup Legend="Movement choices">
<label title="A4.134: the unit's only hex this MPh, whatever it costs, even if CX; once the DEFENDER's fire is done it is pinned and CX."><input id="move-minimum" type="checkbox" checked="@Draft.Minimum" @onchange="@(args => Changed(Draft with { Minimum = args.Value is true }))" /> Minimum Move</label>
<label title="A4.3, A4.31: enter the woods or building hex along one or two of its hexsides the obstacle does not touch, in order, such as southeast, northeast; the stack then leaves through the far vertex or pays to occupy the obstacle (move To its own Location).">Bypass <input id="move-bypass" value="@Draft.Bypass" @onchange="@(args => Changed(Draft with { Bypass = args.Value as string ?? string.Empty }))" size="18" placeholder="southeast, northeast" /></label>
<label title="A4.132: across a road hexside into a hex that has other terrain (a woods-road hex, a building beside its road) the unit pays the road's cost and is on the road, with no TEM of that terrain and FFMO where the firer sees the road; check this to pay the other terrain's cost and be in it."><input id="move-terrain-rate" type="checkbox" checked="@Draft.TerrainRate" @onchange="@(args => Changed(Draft with { TerrainRate = args.Value is true }))" /> pay the other terrain's cost, not the road's</label>
<LocationField Id="move-dash" Label="Dash to" Value="@Draft.Dash" Title="A4.63: declared before the unit moves, with its first step into a road Location; the Location named is on the other side of the road, and the unit's only further step is into it, where its MPh ends. In the road Location the DEFENDER's non-ordnance Defensive First Fire at it is Area Fire for a firer to whom neither side of the road is Open Ground." OnChange="@(value => Changed(Draft with { Dash = value }))" />
@if (Selected.Count > 1)
{
    <label title="A4.42: one leader adds his IPC to one laden MMC that starts the phase with him and moves with him. With one laden MMC it goes there by itself; with several, name the one. The choice holds for the whole move.">Leader's IPC to
        <select id="move-ipc" value="@Draft.IpcTo" @onchange="@(args => Changed(Draft with { IpcTo = args.Value as string ?? string.Empty }))">
            <option value="">the only laden MMC</option>
            @* Pass 71's fixes (Round D; the hex UI rule): each mover "[hex]: name", as every list that offers a counter. *@
            <UnitOptions Units="@([.. Movers.Where(row => Selected.Contains(row.Id)).Select(row => new PlayChoice(row.Id, row.Id))])" Text="@(label => label)" />
        </select>
    </label>
}
@if (CarryMen.Count > 0 && Carriers.Count > 0)
{
    @* Pass 71 (A17.2; ruling R71.16): a wounded man of the stack carried by one of its MMC at five PP; each choice "[hex]: name" (the hex UI rule). *@
    <label title="A17.2: a Good Order wounded man who portages no SW may be carried by a Good Order MMC of the stack at five PP; he spends no MF of his own, and once set down moves no farther this MPh. The carry holds for the rest of the move.">Carry the wounded
        <select id="move-carry" value="@Draft.CarryMan" @onchange="@(args => Changed(Draft with { CarryMan = args.Value as string ?? string.Empty }))">
            <option value="">no one</option>
            <UnitOptions Units="@CarryMen" Text="@(label => label)" />
        </select>
    </label>
    <label>carried by
        <select id="move-carrier" value="@Draft.CarryBy" @onchange="@(args => Changed(Draft with { CarryBy = args.Value as string ?? string.Empty }))">
            <option value="">choose the MMC</option>
            <UnitOptions Units="@Carriers" Text="@(label => label)" />
        </select>
    </label>
}
<label title="A4.15: a MMC enters the Location of a lone Known enemy SMC at double the MF of entry, once the stack has passed its NTC (its leader's for all of it, or the one MMC's). Take the NTC first; then check this and propose the move."><input id="move-overrun" type="checkbox" checked="@Draft.Overrun" @onchange="@(args => Changed(Draft with { Overrun = args.Value is true }))" /> Infantry OVR</label>
<button type="button" id="propose-overrun-ntc" disabled="@(Selected.Count == 0 || Draft.To.Trim().Length == 0)" title="A4.15: the NTC for an Infantry OVR of the Location typed, by the units checked." @onclick="@(() => OnOverrunNtc.InvokeAsync())">Propose: the OVR's NTC</button>
<label><input id="move-assault" type="checkbox" checked="@Draft.Assault" @onchange="@(args => Changed(Draft with { Assault = args.Value is true }))" /> Assault Movement</label>
<label title="Double Time adds 2 MF (1 after the unit has spent MF) and makes the unit CX (A4.5); not for a unit that is CX, or whose CX counter came off at the start of this MPh (A4.51), nor with Assault Movement (A4.61)."><input id="move-double-time" type="checkbox" checked="@Draft.DoubleTime" @onchange="@(args => Changed(Draft with { DoubleTime = args.Value is true }))" /> Double Time</label>
@if (PushGun is { } gun)
{
    <label title="C10.3: the crew pushes its Gun at double the MF, with a Manhandling DR against its M#; uncheck to walk away and abandon the Gun."><input id="move-push" type="checkbox" checked="@Draft.Push" @onchange="@(args => Changed(Draft with { Push = args.Value is true }))" /> push @gun (unchecked: abandon it)</label>
}
</ActionFormGroup>
<ActionProposalArea>
<button id="propose-move" disabled="@(Selected.Count == 0 || Draft.To.Trim().Length == 0)" aria-describedby="propose-move-ready" @onclick="@(() => OnPropose.InvokeAsync())">Propose: move</button>
@if (Selected.Count == 0 || Draft.To.Trim().Length == 0)
{
    <span id="propose-move-ready" class="toolbar-note">Check the units moving and type the Location they enter.</span>
}
</ActionProposalArea>
</details>

@code {
    /// <summary>The route plotted on the map (the Play streamlining plan, S3), drawn right after the stack; none when the page gives none.</summary>
    [Parameter]
    public RenderFragment? Route { get; set; }

    /// <summary>Whether a step is being drafted in the form, which then stays open.</summary>
    private bool StepDrafted => Draft.To.Trim().Length > 0 || Draft.Bypass.Trim().Length > 0 || Draft.Dash.Trim().Length > 0 || Draft.Minimum || Draft.Assault
        || Draft.DoubleTime || Draft.TerrainRate || Draft.Overrun || Draft.CarryMan.Length > 0;

    /// <summary>
    /// The step drafted: the Location typed, Minimum Move, the Bypass hexsides typed, Assault Movement, Double Time, the Gun pushed, whether the
    /// other terrain's cost is paid across a road hexside (A4.132), and the Location a Dash is declared to (A4.63).
    /// </summary>
    public sealed record MoveDraft(string To, bool Minimum, string Bypass, bool Assault, bool DoubleTime, bool Push, bool TerrainRate = false, string Dash = "", string IpcTo = "", bool Overrun = false,
        string CarryMan = "", string CarryBy = "");

    /// <summary>The wounded men checked who may be carried (A17.2; pass 71), and the MMC checked who may carry one; the planner decides the carry.</summary>
    [Parameter]
    public IReadOnlyList<PlayChoice> CarryMen { get; set; } = [];

    [Parameter]
    public IReadOnlyList<PlayChoice> Carriers { get; set; } = [];

    [Parameter, EditorRequired]
    public IReadOnlyList<UnitSelectionList.Row> Movers { get; set; } = [];

    [Parameter, EditorRequired]
    public IReadOnlySet<string> Selected { get; set; } = new HashSet<string>();

    [Parameter, EditorRequired]
    public MoveDraft Draft { get; set; } = new(string.Empty, false, string.Empty, false, false, true);

    /// <summary>The Gun the one checked crew mans, which it may push; null when none.</summary>
    [Parameter]
    public string? PushGun { get; set; }

    [Parameter]
    public EventCallback<UnitSelectionList.Toggle> OnToggle { get; set; }

    [Parameter]
    public EventCallback<MoveDraft> OnDraftChanged { get; set; }

    [Parameter]
    public EventCallback OnPropose { get; set; }

    /// <summary>Proposes the NTC of an Infantry OVR for the units checked and the Location typed (A4.15).</summary>
    [Parameter]
    public EventCallback OnOverrunNtc { get; set; }

    private Task Changed(MoveDraft draft) => OnDraftChanged.InvokeAsync(draft);
}
