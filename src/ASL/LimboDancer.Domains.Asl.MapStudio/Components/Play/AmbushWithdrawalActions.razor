@* Plan N06 (pass 27): the ambusher's units withdraw before the round or after it closes (A11.41), each a proposal of its own. The page shows it to
   the ambusher's view and the adjudicator only and reads the destinations from the planner. *@
<div class="toolbar" id="cc-ambush-withdrawal">
    <span class="muted">Ambush Withdrawal (A11.41):</span>
    @foreach (var withdrawal in Withdrawals)
    {
        <button class="ambush-withdraw" data-unit="@withdrawal.Unit" data-to="@withdrawal.To" @onclick="@(() => OnPropose.InvokeAsync(withdrawal))">Propose: @(PlaceOfUnit?.Invoke(withdrawal.Unit) is { } place ? $"{place.Where}: " : string.Empty)@Say(withdrawal.Unit) withdraws to @Say(withdrawal.To)</button>
    }
</div>

@code {
    /// <summary>The page's words for the view (pass 31c, design D11): a unit's name for its id, a Location in words.</summary>
    /// <summary>A unit's Location, which names it in each button (the user, 2026-10-21).</summary>
    [CascadingParameter(Name = "PlaceOfUnit")]
    public Func<string, UnitPlace?>? PlaceOfUnit { get; set; }

    [CascadingParameter(Name = "Say")]
    public Func<string, string>? Words { get; set; }

    private string Say(string? text) => text is null ? string.Empty : Words?.Invoke(text) ?? text;
    /// <summary>An ambusher's unit and a Location it may withdraw to.</summary>
    public sealed record Withdrawal(string Unit, string To);

    [Parameter, EditorRequired]
    public IReadOnlyList<Withdrawal> Withdrawals { get; set; } = [];

    [Parameter]
    public EventCallback<Withdrawal> OnPropose { get; set; }
}
