@* Plan N09 (pass 27): a Guard not in Melee hands its prisoners to another armed unit in its Location, or abandons them as Unarmed units (A20.5),
   in the RPh or APh. The page reads the Guards and their recipients; abandoning is its own proposal, never the fallback of a transfer. *@
<div class="toolbar" id="play-guards">
    <span class="muted">Prisoners (A20.5): a Guard not in Melee hands them to another armed unit in its Location, or abandons them as Unarmed units.</span>
    @foreach (var guard in Guards)
    {
        @foreach (var heir in guard.Heirs)
        {
            <button class="transfer-prisoners" data-guard="@guard.Id" data-to="@heir" @onclick="@(() => OnTransfer.InvokeAsync(new Transfer(guard.Id, heir)))">Propose: @At(guard.Id) hands its prisoners to @Say(heir)</button>
        }
        <button class="abandon-prisoners" data-guard="@guard.Id" @onclick="@(() => OnAbandon.InvokeAsync(guard.Id))">Propose: @At(guard.Id) abandons its prisoners</button>
    }
</div>

@code {
    /// <summary>The page's words for the view (pass 31c, design D11): a unit's name for its id.</summary>
    [CascadingParameter(Name = "Say")]
    public Func<string, string>? Words { get; set; }

    private string Say(string? text) => text is null ? string.Empty : Words?.Invoke(text) ?? text;

    /// <summary>A unit's name with its hex, "4-6-7 squad G4 in [G4]" (the user, 2026-10-04), where no Location stands beside the name.</summary>
    [CascadingParameter(Name = "SayAt")]
    public Func<string, string>? WordsAt { get; set; }

    private string At(string? text) => text is null ? string.Empty : WordsAt?.Invoke(text) ?? Say(text);

    /// <summary>A Guard and the units that could take its prisoners.</summary>
    public sealed record Guard(string Id, IReadOnlyList<string> Heirs);

    /// <summary>A Guard hands its prisoners to another unit.</summary>
    public sealed record Transfer(string Guard, string To);

    [Parameter, EditorRequired]
    public IReadOnlyList<Guard> Guards { get; set; } = [];

    [Parameter]
    public EventCallback<Transfer> OnTransfer { get; set; }

    /// <summary>A Guard abandons its prisoners.</summary>
    [Parameter]
    public EventCallback<string> OnAbandon { get; set; }
}
