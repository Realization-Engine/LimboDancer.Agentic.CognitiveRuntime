@* Plan R06 (pass 28b): the fire attacks the view may see, latest first. The page gives each record it is entitled to, and for one withheld from it the
   public report of its arithmetic with no effects (Fire in Live Play, part 5). *@
@if (Records.Count > 0)
{
    <h3>Fire</h3>
    <div id="play-fires">
        @foreach (var group in ActionRecordList.Group(Records, record => When?.Invoke(record.EventId)))
        {
            @if (When is not null)
            {
                <h4 class="record-when">@(group.When ?? "Before play")</h4>
            }
            @foreach (var record in group.Records)
            {
                <FireResolutionCard @key="record.EventId" Record="@record" />
            }
        }
    </div>
}

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<FireView> Records { get; set; } = [];

    /// <summary>The turn and phase of a record's event; the records are grouped under it when given (backlog section 43, pass 28c).</summary>
    [Parameter]
    public Func<string, string?>? When { get; set; }
}
