@using LimboDancer.Domains.Asl.MapStudio.Components.Games
@* Pass 28c (plan section 13.1): the context that stays in sight above the workspace: the game and the view (the toolbar given as child content), the
   revision, turn, and phase, whether the page shows the live game, the night and weather, a way back to a pending proposal, and the hand-over a
   waiting answer needs. Everything here is known to both sides; the page shows it while a hand-over waits, too. *@
<div id="play-context" class="@(Banner is not null ? "play-context banner" : Reserve ? "play-context reserve" : "play-context")">
    @ChildContent
    @Help
    @if (Banner is { } parts)
    {
        @* The one-line banner (the user, 2026-10-17): the game, the turn, the phase, and the card, with a proposal to review, a hand-over, and the
           gate's status at its end when there are any; the view picker follows the card link. *@
        <div class="play-banner" id="play-banner">
            <span class="play-banner-parts">
                @foreach (var part in parts)
                {
                    <span class="play-banner-part">@part</span>
                }
                @if (HasCard)
                {
                    <span class="play-banner-part"><a id="play-card-link" href="@CardHref" @onclick="@(() => OpenCard.InvokeAsync())" @onclick:preventDefault>Card and Victory Conditions</a></span>
                }
                @if (ViewPicker is not null)
                {
                    <span class="play-banner-view">@ViewPicker</span>
                }
                @if (CardChanged)
                {
                    <span id="play-card-changed-badge"><StatusBadge Tone="StatusBadge.BadgeTone.Warning" Label="Card changed"
                        Explanation="The card has changed since this game started; the card panel shows its current text." /></span>
                }
                @if (Conditions is { Length: > 0 } conditions)
                {
                    <span class="play-banner-part" id="play-conditions">@conditions</span>
                }
            </span>
            @* The user, 2026-10-21: the hand-over starts at the right pane's left edge, over that pane; the status ("Working: ...") and then
               "Review: ..." end it, the review the last. *@
            @* The user, 2026-10-21: the explanations are tooltips: what the game waits for on the hand-over, the gate's status on the review. Both
               stay in the page for assistive technology; "Working: ..." alone is seen, while the gate works. *@
            <span class="play-banner-end">
                @if (Awaiting is { Length: > 0 } awaiting)
                {
                    <span class="visually-hidden" id="play-awaiting">@AwaitingNote</span>
                    @if (AwaitingDue)
                    {
                        <span class="play-awaiting-due" id="play-awaiting-due">Waiting</span>
                    }
                    <button type="button" id="play-hand-over" class="@(AwaitingDue ? "primary" : null)" title="@AwaitingNote" aria-describedby="play-awaiting" @onclick="@(() => HandOver.InvokeAsync())">Hand over to @awaiting</button>
                }
                <span id="play-status" class="@(Busy ? "play-status busy" : "play-status visually-hidden")" role="status" aria-live="polite" title="@Status">@(Busy ? "Working: " : string.Empty)@Status</span>
                @if (PendingTitle is { Length: > 0 } title)
                {
                    <button type="button" id="play-review-jump" class="primary" title="@(Status is { Length: > 0 } ? Status : null)" @onclick="@(() => Review.InvokeAsync())">Review: @title</button>
                }
            </span>
        </div>
        @if (Result is { Length: > 0 } ended)
        {
            <div id="play-result-line" class="play-result">
                <strong>@ended</strong> @ResultReason
                @if (ResultWhy.Count > 0)
                {
                    <details id="play-result-why">
                        <summary>Why</summary>
                        <ul>
                            @foreach (var line in ResultWhy)
                            {
                                <li>@line</li>
                            }
                        </ul>
                    </details>
                }
            </div>
        }
    }
    else
    {
    @if (Summary is { Length: > 0 })
    {
        @* Claude Design's UX analysis: the game line Play shares with the board viewer; the game and the view are in the pickers above it. *@
        <GameLine IdPrefix="play" Text="@Summary" Revision="@Revision"
                  Badge="@(Live is { } live ? Ended ? "Ended" : live ? "Live" : "Does not replay" : null)"
                  Tone="@(Ended ? StatusBadge.BadgeTone.Warning : Live == true ? StatusBadge.BadgeTone.Pass : StatusBadge.BadgeTone.Fail)"
                  Explanation="@(Ended ? "The game has ended." : Live == true ? "The game's latest revision, as play goes on." : "The game's events do not replay; nothing can be played.")">
            <Badges>
                @if (CardChanged)
                {
                    <span id="play-card-changed-badge"><StatusBadge Tone="StatusBadge.BadgeTone.Warning" Label="Card changed"
                        Explanation="The card has changed since this game started; the card panel shows its current text." /></span>
                }
            </Badges>
            <ChildContent>
                @if (HasCard)
                {
                    <a id="play-card-link" href="@CardHref" @onclick="@(() => OpenCard.InvokeAsync())" @onclick:preventDefault>Card and Victory Conditions</a>
                }
                @if (ViewPicker is not null)
                {
                    <span class="play-banner-view">@ViewPicker</span>
                }
            </ChildContent>
        </GameLine>
        @* Pass 31 (play test P-08; the user, 2026-10-04): the game's result is stated here, in every view, once the game has ended. *@
        @if (Result is { Length: > 0 } result)
        {
            <div id="play-result-line" class="play-result">
                <strong>@result</strong> @ResultReason
                @if (ResultWhy.Count > 0)
                {
                    <details id="play-result-why">
                        <summary>Why</summary>
                        <ul>
                            @foreach (var line in ResultWhy)
                            {
                                <li>@line</li>
                            }
                        </ul>
                    </details>
                }
            </div>
        }
        <NightWeatherSummary Text="@Conditions" />
        @if (Acting is { Length: > 0 } acting)
        {
            <p class="muted" id="play-acting">@acting</p>
        }
    }
    @* Pass 31c (design D15; play test P-28, P-31): the row and the status line keep their places whether or not they have anything to say, so
       the header has one height and the workspace under it does not move. *@
    @if ((Reserve && Summary is { Length: > 0 }) || PendingTitle is { Length: > 0 } || Awaiting is { Length: > 0 })
    {
        <div class="@(PendingTitle is { Length: > 0 } || Awaiting is { Length: > 0 } ? "toolbar play-context-actions" : "toolbar play-context-actions idle")">
            @if (PendingTitle is { Length: > 0 } title)
            {
                <button type="button" id="play-review-jump" class="primary" @onclick="@(() => Review.InvokeAsync())">Review: @title</button>
            }
            @if (Awaiting is { Length: > 0 } awaiting)
            {
                @if (AwaitingDue)
                {
                    <span class="play-awaiting-due" id="play-awaiting-due">Waiting</span>
                }
                <span class="toolbar-note" id="play-awaiting">@AwaitingNote</span>
                <button type="button" id="play-hand-over" class="@(AwaitingDue ? "primary" : null)" @onclick="@(() => HandOver.InvokeAsync())">Hand over to @awaiting</button>
            }
        </div>
    }
    <p id="play-status" class="@(Busy ? "play-status busy" : "play-status")" role="status" aria-live="polite" title="@Status" tabindex="@(Status is { Length: > 0 } ? "0" : null)">@(Busy ? "Working: " : string.Empty)@Status</p>
    }
</div>

@code {
    [Parameter]
    public RenderFragment? ViewPicker { get; set; }

    /// <summary>
    /// The one-line banner's parts, such as the scenario's title, "Turn 1 of 5", and "Russian Movement Phase"; when given, the header is that
    /// banner (Play from 1024px), and the summary, the acting note, and the reserved rows are not drawn.
    /// </summary>
    [Parameter]
    public IReadOnlyList<string>? Banner { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Whether the row of actions and the status line keep their places when they are empty (pass 31c, design D15), so the header has one
    /// height: Play, whose proposals come and go; Replay has neither and reserves nothing.
    /// </summary>
    [Parameter]
    public bool Reserve { get; set; }

    /// <summary>The page's "How this works", which a page with a game open shows here instead of above the context (pass 31c).</summary>
    [Parameter]
    public RenderFragment? Help { get; set; }

    /// <summary>The revision, turn, phase, and phasing side in words, and whether setup is open; empty when no game is shown.</summary>
    [Parameter]
    public string? Summary { get; set; }

    /// <summary>The revision shown, apart from the turn and phase; null when the game does not replay or none is shown.</summary>
    [Parameter]
    public long? Revision { get; set; }

    /// <summary>What the shown view does now when it waits on no other view, such as "You act: the german side acts in the Movement Phase."</summary>
    [Parameter]
    public string? Acting { get; set; }

    /// <summary>Whether the gate is working on a proposal or a confirmation.</summary>
    [Parameter]
    public bool Busy { get; set; }

    /// <summary>Whether the page shows the live game's latest revision; false when the game does not replay; null when no game is shown.</summary>
    [Parameter]
    public bool? Live { get; set; }

    [Parameter]
    public bool Ended { get; set; }

    /// <summary>The ended game's result in a few words, such as "German win" or "A draw"; null while the game is played.</summary>
    [Parameter]
    public string? Result { get; set; }

    /// <summary>The reason beside the result.</summary>
    [Parameter]
    public string? ResultReason { get; set; }

    /// <summary>Every Victory condition with whether it was met, and the facts behind the result.</summary>
    [Parameter]
    public IReadOnlyList<string> ResultWhy { get; set; } = [];

    /// <summary>The NVR, weather, precipitation, and illumination now.</summary>
    [Parameter]
    public string? Conditions { get; set; }

    /// <summary>Whether the game's card has changed since the game started (the UX analysis: the card panel starts closed).</summary>
    [Parameter]
    public bool CardChanged { get; set; }

    /// <summary>Whether the game has a card panel to go to.</summary>
    [Parameter]
    public bool HasCard { get; set; }

    /// <summary>The page's own address with the card panel's fragment, so the link stays on the page.</summary>
    [Parameter]
    public string CardHref { get; set; } = "#play-card";

    /// <summary>Opens the card panel and brings it into view; the panel starts closed (pass 29).</summary>
    [Parameter]
    public EventCallback OpenCard { get; set; }

    /// <summary>The pending proposal's title; null when none is pending.</summary>
    [Parameter]
    public string? PendingTitle { get; set; }

    [Parameter]
    public EventCallback Review { get; set; }

    /// <summary>The view whose answer the game waits for, named for its viewer ("the russian side"); null when the shown view may act.</summary>
    [Parameter]
    public string? Awaiting { get; set; }

    /// <summary>What the game waits for, such as "The DEFENDER may fire or pass."</summary>
    [Parameter]
    public string AwaitingNote { get; set; } = string.Empty;

    /// <summary>
    /// Whether the awaited side holds play up (the user, 2026-10-22: a choice, a surrender, or the DEFENDER's window), so the hand-over is the view's
    /// main action and a "Waiting" tag says so; otherwise the other side merely acts next.
    /// </summary>
    [Parameter]
    public bool AwaitingDue { get; set; }

    [Parameter]
    public EventCallback HandOver { get; set; }

    /// <summary>A short announcement for assistive technology: working, a proposal to review, a result.</summary>
    [Parameter]
    public string Status { get; set; } = string.Empty;
}
