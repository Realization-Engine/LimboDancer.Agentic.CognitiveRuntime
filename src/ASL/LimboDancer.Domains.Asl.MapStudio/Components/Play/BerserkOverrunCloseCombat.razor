@* Pass 27 (ruling R27.3): the CC of a berserk Infantry OVR onto a lone SMC, resolved at once in the MPh once the DEFENDER's window on the entry
   has closed (A4.152, A15.432). Every berserk unit there attacks the SMC; the SMC may attack them back. The page proposes it as a CC round. *@
<div class="toolbar" id="overrun-cc" data-location="@Location">
    <span class="fail">
        @string.Join(", ", Attackers) overran the lone @Smc in @Location: their CC comes now, before anything else this MPh; if both survive they are
        held in Melee for the CCPh (A4.152, A15.432).
    </span>
    <label><input id="overrun-cc-smc" type="checkbox" checked="@SmcAttacks" @onchange="@(args => OnSmcAttacks.InvokeAsync(args.Value is true))" /> @Smc attacks back</label>
    <button id="propose-overrun-cc" @onclick="@(() => OnPropose.InvokeAsync())">Propose: the OVR's CC</button>
</div>

@code {
    /// <summary>The Location of the OVR.</summary>
    [Parameter, EditorRequired]
    public string Location { get; set; } = string.Empty;

    /// <summary>The berserk units that overran the SMC, who all attack it.</summary>
    [Parameter, EditorRequired]
    public IReadOnlyList<string> Attackers { get; set; } = [];

    /// <summary>The lone SMC overrun.</summary>
    [Parameter, EditorRequired]
    public string Smc { get; set; } = string.Empty;

    /// <summary>Whether the SMC attacks the berserk units back.</summary>
    [Parameter]
    public bool SmcAttacks { get; set; } = true;

    [Parameter]
    public EventCallback<bool> OnSmcAttacks { get; set; }

    [Parameter]
    public EventCallback OnPropose { get; set; }
}
