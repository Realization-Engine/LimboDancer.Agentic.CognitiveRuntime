@* Pass 65, task 65.6 (ruling R65.20): the crew's own acts in its side's MPh. The page lists the vehicles whose crew may Abandon them (D5.41), with the
   self-destruction (D5.411) and the MG Removal (D6.631) asked once for the proposal, and each Abandoned vehicle of the side with the units on foot in its
   Location that may enter it to crew it (D5.42). The planner decides what the records bar: the Player Turn the crew left, a Recalled crew. *@
<ActionSection Title="Vehicle crews" Key="crew-acts">
@* Pass 70 (ruling R70.34; the UI review): in the CCPh only the captors' entry is offered, under D5.42's EXC, so the MPh's help would mislead. *@
@if (CloseCombat)
{
<RuleHelp Id="crew-acts-help" Summary="In the CCPh a unit that captured a vehicle this CCPh may enter it as its crew, even in the Player Turn its last crew left (D5.42 EXC: CCPh; A21.2).">
    An Infantry unit enters an Abandoned vehicle as its Inherent crew only from its Location at the start of its MPh, spending all its MF, and not in the
    Player Turn its previous crew left, except in the CCPh: a unit that captures a vehicle in CC may enter it then (D5.42 EXC; A21.2). A unit other than
    a crew is a Temporary crew (A21.22).
</RuleHelp>
}
else
{
<RuleHelp Id="crew-acts-help" Summary="In its own MPh a crew Abandons a vehicle that has not moved or fired this Player Turn, spending all its MF to be placed beneath it; it may destroy the vehicle or Remove a halftrack's or Carrier's MG as it leaves. Infantry in an Abandoned vehicle's Location at the start of its MPh enters it to crew it, spending all its MF (D5.41, D5.411, D6.631, D5.42).">
    In its own MPh the crew of an armed vehicle that has not moved or fired this Player Turn Abandons it, spending all its MF to be placed beneath it, and
    the DEFENDER may fire at it with FFNAM (D5.41, D5.43). An Inherent crew may leave the vehicle a non-burning wreck or malfunction its MA and every MG
    (D5.411); the crew of an armored halftrack or Carrier of its nationality may Remove its MG as its LMG (D6.631, D6.83). The crew takes the Armor Leader with it (D3.43).
    Infantry in Good Order in an Abandoned vehicle's Location at the start of its MPh enters it to crew it, spending all its MF, but not in the Player
    Turn its last crew left, and a Recalled crew never re-crews its own AFV (D5.42, D5.341). A unit other than a crew is a Temporary crew (A21.22).
</RuleHelp>
}
<div class="toolbar">
    @if (Abandonable.Count > 0)
    {
        <label title="D5.411: only an Inherent crew that voluntarily Abandons its vehicle may turn it into a non-burning wreck or malfunction its weapons as it leaves.">
            Self-destruction
            <select id="abandon-destroy" value="@Destroy" @onchange="@(args => OnDestroy.InvokeAsync(args.Value as string ?? string.Empty))">
                <option value="">none</option>
                <option value="wreck">a non-burning wreck</option>
                <option value="malfunction">its MA and every MG malfunctioned</option>
            </select>
        </label>
        @if (Abandonable.Any(vehicle => vehicle.MgRemovable))
        {
            <label title="D6.631, D6.83: the crew of an armored halftrack or Carrier of its nationality may Remove the MG and take it as a MG counter of the same or less FP; the vehicle is Disabled until a crew brings it back.">
                <input type="checkbox" id="abandon-remove-mg" checked="@RemoveMg" @onchange="@(args => OnRemoveMg.InvokeAsync(args.Value is true))" /> Remove a halftrack's or Carrier's MG as its LMG (D6.631, D6.83)
            </label>
        }
        @foreach (var vehicle in Abandonable)
        {
            <button @key="vehicle.Id" class="vehicle-abandon" data-vehicle="@vehicle.Id" disabled="@Busy" @onclick="@(() => OnAbandon.InvokeAsync(vehicle.Id))">Propose: Abandon @At(vehicle.Id)</button>
        }
    }
    @foreach (var vehicle in Recrewable)
    {
        var chosen = Chosen.GetValueOrDefault(vehicle.Id, string.Empty);
        var ready = vehicle.Units.Any(unit => unit.Id == chosen);
        <span @key="vehicle.Id" class="recrew-row" data-vehicle="@vehicle.Id">
            <label>
                Enter @At(vehicle.Id)
                <select class="recrew-unit" data-vehicle="@vehicle.Id" value="@chosen" @onchange="@(args => OnUnit.InvokeAsync((vehicle.Id, args.Value as string ?? string.Empty)))">
                    <option value="">choose</option>
                    <UnitOptions Units="@vehicle.Units" Text="@At" />
                </select>
            </label>
            <button class="vehicle-recrew" data-vehicle="@vehicle.Id" disabled="@(!ready || Busy)" title="@(ready ? null : "Choose the unit that enters")"
                @onclick="@(() => OnRecrew.InvokeAsync((vehicle.Id, chosen)))">Propose: re-crew (D5.42)</button>
        </span>
    }
</div>
</ActionSection>

@code {
    /// <summary>The page's words for the view: a unit's name for its id.</summary>
    [CascadingParameter(Name = "Say")]
    public Func<string, string>? Words { get; set; }

    /// <summary>A unit's name with its hex after it, "SPW 251/1 vehicle G1 in [F8]" (pass 31c).</summary>
    [CascadingParameter(Name = "SayAt")]
    public Func<string, string>? WordsAt { get; set; }

    private string At(string? text) => text is null ? string.Empty : WordsAt?.Invoke(text) ?? Words?.Invoke(text) ?? text;

    /// <summary>A vehicle whose crew may Abandon it, and whether its crew could Remove its MG.</summary>
    public sealed record Abandoning(string Id, bool MgRemovable);

    /// <summary>An Abandoned vehicle of the side and the units on foot in its Location that may enter it.</summary>
    public sealed record Recrewing(string Id, IReadOnlyList<PlayChoice> Units);

    [Parameter]
    public IReadOnlyList<Abandoning> Abandonable { get; set; } = [];

    [Parameter]
    public IReadOnlyList<Recrewing> Recrewable { get; set; } = [];

    /// <summary>The self-destruction chosen: empty, <c>wreck</c>, or <c>malfunction</c>.</summary>
    [Parameter]
    public string Destroy { get; set; } = string.Empty;

    [Parameter]
    public bool RemoveMg { get; set; }

    /// <summary>The unit chosen to enter each Abandoned vehicle.</summary>
    [Parameter]
    public IReadOnlyDictionary<string, string> Chosen { get; set; } = new Dictionary<string, string>();

    /// <summary>Whether the page is committing an action, so no proposal is made meanwhile.</summary>
    [Parameter]
    public bool Busy { get; set; }

    /// <summary>Whether the panel is the CCPh's, which offers only the captors' entry (D5.42 EXC, A21.2; pass 70, ruling R70.34).</summary>
    [Parameter]
    public bool CloseCombat { get; set; }

    [Parameter]
    public EventCallback<string> OnDestroy { get; set; }

    [Parameter]
    public EventCallback<bool> OnRemoveMg { get; set; }

    [Parameter]
    public EventCallback<string> OnAbandon { get; set; }

    [Parameter]
    public EventCallback<(string Vehicle, string Unit)> OnUnit { get; set; }

    [Parameter]
    public EventCallback<(string Vehicle, string Unit)> OnRecrew { get; set; }
}
