@* Plan R07 (pass 28b): one fire attack as the view may see it. Its effects are null when they are withheld (the target Location's units stay
   concealed), and that is said rather than shown as an empty table. *@
<div class="fire-record" data-fire="@Record.EventId">
    <p>
        <strong class="fire-group">@Record.Group @(Record.Several ? "fire" : "fires") at @Record.Target</strong>.
    </p>
    @* Pass 55 (the table player's review): a Canister attack on a Location where the view knows of no unit says so, with no arithmetic: a
       halved FP or a result on nobody would read as fire at a concealed target. *@
    @if (Record.NoKnownTarget)
    {
        <p class="muted fire-no-target">@DisplayText.Sentence(FireText.NoKnownTargetText(Record.Target)).</p>
    }
    else
    {
        @* Pass 60 (the table player): an attack that named an AFV and attacked no unit or other vehicle shows no IFT line, whose result fell on no one. *@
        var attackedNone = Record.NamedVehicle is { Count: > 0 } && Record.Effects is { Count: 0 } && Record.Vehicles is not { Count: > 0 };
        @if (!attackedNone)
        {
            <FireArithmeticBreakdown Arithmetic="@Record.Arithmetic" Say="@Record.Say" />
        }
        @if (Record.Weapons?.Select(FireText.WeaponText).OfType<string>().ToArray() is { Length: > 0 } weapons)
        {
            <ul class="fire-weapons">
                @foreach (var line in weapons)
                {
                    <li>@DisplayText.Sentence(Record.Say(line)).</li>
                }
            </ul>
        }
        @* Pass 60 (rulings R60.15, R60.16): a FT's, MOL's, or DC's attack on the AFV it named. *@
        @if (Record.NamedVehicle is { Count: > 0 } named)
        {
            <ul class="fire-named-vehicle">
                @foreach (var line in named)
                {
                    <li>@DisplayText.Sentence(Record.Say(line)).</li>
                }
            </ul>
        }
        @if (!attackedNone && Record.Effects is { } effects && (effects.Count > 0 || Record.Vehicles is not { Count: > 0 }))
        {
            <InfantryFireEffectsTable Effects="@effects" BrokenBefore="@Record.BrokenBefore" PinnedBefore="@Record.PinnedBefore" Say="@Record.Say" />
        }
        @* Pass 60 (ruling R60.17): Random SW/Gun Destruction after a KIA, and a DC's Gun. *@
        @if (Record.WeaponDestruction is { Count: > 0 } destroyed)
        {
            <ul class="fire-weapon-destruction">
                @foreach (var line in destroyed)
                {
                    <li>@DisplayText.Sentence(Record.Say(line)).</li>
                }
            </ul>
        }
        @if (Record.Vehicles is { Count: > 0 } vehicles)
        {
            <VehicleFireEffectsTable Vehicles="@vehicles" Say="@Record.Say" />
        }
        else if (Record.Effects is null)
        {
            <p class="muted fire-withheld">The target Location's units are not disclosed: the result leaves them concealed (A12.14, p. 77), so only the @(Record.TargetSide is { } side ? DisplayText.Side(side) : "target") side sees them.</p>
        }
    }
</div>

@code {
    [Parameter, EditorRequired]
    public FireView Record { get; set; } = default!;
}
