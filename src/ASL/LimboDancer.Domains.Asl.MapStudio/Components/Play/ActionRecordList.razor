@* Plan R05 (pass 28b): one list of records already written for the view: ordnance, Close Combat, night and weather, Snipers, and Rally, Rout, and
   support weapons. Each adapter on the page keeps its own disclosure filter (section 16.15); this list only shows what it is given. A record's kind
   names its class, such as "rally-record", and its event id its data-event. *@
@if (Records.Count > 0)
{
    <h3>@Heading</h3>
    @if (When is null)
    {
        <ul id="@ListId">
            @foreach (var record in Records)
            {
                <li @key="record.EventId" class="@($"{record.Kind}-record")" data-event="@record.EventId">
                    @record.Text
                    @if (Replay?.Invoke(record.EventId) is { } replay)
                    {
                        <text> </text><a class="record-replay" href="@replay" aria-label="@($"Replay from here: {Short(record.Text)}")">Replay from here</a>
                    }
                </li>
            }
        </ul>
    }
    else
    {
        @* Backlog section 43 (pass 28c): the records under their turn and phase, in the list's order. *@
        <div id="@ListId" class="record-groups">
            @foreach (var group in Groups(When))
            {
                <h4 class="record-when">@(group.When ?? "Before play")</h4>
                <ul>
                    @foreach (var record in group.Records)
                    {
                        <li @key="record.EventId" class="@($"{record.Kind}-record")" data-event="@record.EventId">
                        @record.Text
                        @if (Replay?.Invoke(record.EventId) is { } replay)
                        {
                            <text> </text><a class="record-replay" href="@replay" aria-label="@($"Replay from here: {Short(record.Text)}")">Replay from here</a>
                        }
                    </li>
                    }
                </ul>
            }
        </div>
    }
}

@code {
    /// <summary>A record: the event it comes from, its kind, and its text.</summary>
    public sealed record Entry(string EventId, string Kind, string Text);

    [Parameter, EditorRequired]
    public string Heading { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public string ListId { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public IReadOnlyList<Entry> Records { get; set; } = [];

    /// <summary>The turn and phase of a record's event, such as "Turn 2, Rally Phase"; the records are grouped under it when given.</summary>
    [Parameter]
    public Func<string, string?>? When { get; set; }

    /// <summary>The Replay page's address at a record's step (pass 31b); a record shows its link when one is given.</summary>
    [Parameter]
    public Func<string, string?>? Replay { get; set; }

    /// <summary>The start of a record's text, to tell one "Replay from here" link from the next for assistive technology.</summary>
    private static string Short(string text) => text.Length <= 60 ? text : text[..60];

    /// <summary>The records in runs of one turn and phase, in the list's order.</summary>
    public static IReadOnlyList<(string? When, IReadOnlyList<T> Records)> Group<T>(IEnumerable<T> records, Func<T, string?> when)
    {
        var groups = new List<(string? When, IReadOnlyList<T> Records)>();
        foreach (var record in records)
        {
            var label = when(record);
            if (groups.Count > 0 && groups[^1].When == label)
            {
                ((List<T>)groups[^1].Records).Add(record);
            }
            else
            {
                groups.Add((label, new List<T> { record }));
            }
        }

        return groups;
    }

    private IReadOnlyList<(string? When, IReadOnlyList<Entry> Records)> Groups(Func<string, string?> when) =>
        Group(Records, record => when(record.EventId));
}
