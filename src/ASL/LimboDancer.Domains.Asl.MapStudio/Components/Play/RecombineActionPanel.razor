@* Plan A08 (pass 28b): two HS Recombining into a squad (A1.32). The page gives the HS the view sees, the partners of the first, and the leaders with
   it (ruling R23.1); choosing another first HS clears the partner and the leader, which the page does in its OnOne handler (section 15.3). *@
<RuleHelp Id="recombine-help" Summary="Combine two matching half-squads into a squad.">
    Two matching Good Order half-squads in the same Location and terrain may Recombine at the start of the RPh,
    with the required leader. This is their sole RPh action (A1.32).
</RuleHelp>
<ActionUnitScope Units="@HalfSquads" Unit="@One" Locations="@Locations" Title="Recombining in" ReleaseText="Show all recombine units"
                 OnClear="@(() => OnOne.InvokeAsync(string.Empty))" Context="shown">
<div class="action-form">
<ActionFormGroup Legend="Units and leader">
    <label>
        First half-squad
        <select id="recombine-one" value="@One" @onchange="@(args => OnOne.InvokeAsync(args.Value as string ?? string.Empty))">
            <option value="">choose</option>
            <UnitOptions Units="@shown" Text="@At" />
        </select>
    </label>
    @if (shown.Any(unit => unit.Id == One))
    {
    <label>
        Second half-squad
        <select id="recombine-two" value="@Two" @onchange="@(args => OnTwo.InvokeAsync(args.Value as string ?? string.Empty))">
            <option value="">choose</option>
            <UnitOptions Units="@([.. Partners.Select(unit => new PlayChoice(unit, unit))])" Text="@Say" />
        </select>
    </label>
    @if (Partners.Contains(Two))
    {
    <label>
        Leader
        <select id="recombine-leader" value="@Leader" @onchange="@(args => OnLeader.InvokeAsync(args.Value as string ?? string.Empty))">
            <option value="">choose</option>
            <UnitOptions Units="@([.. Leaders.Select(leader => new PlayChoice(leader, leader))])" Text="@Say" />
        </select>
    </label>
    }
    }
</ActionFormGroup>
<ActionProposalArea>
    <button id="propose-recombine" disabled="@(!shown.Any(unit => unit.Id == One) || !Partners.Contains(Two))" aria-describedby="propose-recombine-ready" @onclick="@(() => OnPropose.InvokeAsync())">Propose: recombine</button>
    @if (!shown.Any(unit => unit.Id == One) || !Partners.Contains(Two))
    {
        <span id="propose-recombine-ready" class="toolbar-note">@(One.Length == 0 ? "Choose the first half-squad." : Partners.Count == 0 ? "No matching half-squad is available here." : "Choose the second half-squad.")</span>
    }
</ActionProposalArea>
</div>
</ActionUnitScope>

@code {
    [Parameter] public IReadOnlyDictionary<string, string?> Locations { get; set; } = new Dictionary<string, string?>();
    /// <summary>The page's words for the view (pass 31c, design D11): a unit's name for its id, a Location in words.</summary>
    [CascadingParameter(Name = "Say")]
    public Func<string, string>? Words { get; set; }

    private string Say(string? text) => text is null ? string.Empty : Words?.Invoke(text) ?? text;

    /// <summary>A unit's name with its hex, "4-6-7 squad G4 in [G4]" (the user, 2026-10-04), where no Location stands beside the name.</summary>
    [CascadingParameter(Name = "SayAt")]
    public Func<string, string>? WordsAt { get; set; }

    private string At(string? text) => text is null ? string.Empty : WordsAt?.Invoke(text) ?? Say(text);

    [Parameter, EditorRequired]
    public IReadOnlyList<PlayChoice> HalfSquads { get; set; } = [];

    /// <summary>The HS that may Recombine with the first.</summary>
    [Parameter, EditorRequired]
    public IReadOnlyList<string> Partners { get; set; } = [];

    /// <summary>The leaders who may help the first HS Recombine.</summary>
    [Parameter, EditorRequired]
    public IReadOnlyList<string> Leaders { get; set; } = [];

    [Parameter]
    public string One { get; set; } = string.Empty;

    [Parameter]
    public string Two { get; set; } = string.Empty;

    [Parameter]
    public string Leader { get; set; } = string.Empty;

    [Parameter]
    public EventCallback<string> OnOne { get; set; }

    [Parameter]
    public EventCallback<string> OnTwo { get; set; }

    [Parameter]
    public EventCallback<string> OnLeader { get; set; }

    [Parameter]
    public EventCallback OnPropose { get; set; }
}
