@* Plan R04 (pass 28b): the latest rolls the view may see. The page gives each roll already written, with the units it belongs to only when the view may
   see them (Random Selection and Declined OVR Design, section 7), and whether scripted dice are on, so the test-data warning shows. *@
@if (Rolls.Count > 0)
{
    <h3>Rolls</h3>
    @if (Scripted)
    {
        <p class="muted" id="rolls-scripted">
            Scripted dice are on: each roll is recorded as the system's, as replay requires (DICE-12), but its dice may have come from the queue,
            so games played now are test data.
        </p>
    }
    <ul id="play-rolls" class="dice-history">
        @foreach (var roll in Rolls)
        {
            <li @key="roll.Roll" data-roll="@roll.Roll">
                @if (roll.Display is { } display)
                {
                    <div class="dice-history-purpose">@(roll.Purpose ?? roll.Text)</div>
                    <AslDice Roll="@display" />
                }
                else
                {
                    <div>@roll.Text</div>
                }
                <div class="muted dice-history-source">@roll.Drawn</div>
                @if (roll.Display is not null)
                {
                    <details class="dice-history-details"><summary>Recorded details</summary><p>@roll.Text</p></details>
                }
            </li>
        }
    </ul>
}

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<RollRow> Rolls { get; set; } = [];

    [Parameter]
    public bool Scripted { get; set; }
}
