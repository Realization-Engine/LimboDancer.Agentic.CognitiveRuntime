@* Plan C08 (pass 27): a choice the game waits on before play goes on (ruling R5.8). The page passes the options only to the answering side's view
   and the adjudicator; any other view gets none and reads that it waits. *@
<div id="play-choice" class="fail" data-key="@Key">
    <p>The @DisplayText.Side(Side) side answers before play goes on: @Described</p>
    @if (MayAnswer && Options.Count > ListedAsButtons)
    {
        @* Pass 71 (A14.2; ruling R71.12): a long list, such as the hexes a Sniper counter may be repositioned to, is one list and one proposal. *@
        <select id="play-choice-select" aria-label="The answer" @bind="picked">
            <option value="">Choose the answer</option>
            @foreach (var option in Options)
            {
                <option value="@option.Value">@option.Text</option>
            }
        </select>
        <button class="choose" id="play-choice-propose" disabled="@(picked.Length == 0)" @onclick="@(() => OnChoose.InvokeAsync(picked))">Propose the answer</button>
    }
    else if (MayAnswer)
    {
        @foreach (var option in Options)
        {
            <button class="choose" data-option="@option.Value" @onclick="@(() => OnChoose.InvokeAsync(option.Value))">Propose: @option.Text</button>
        }
    }
    else
    {
        <p class="muted">Waiting for the @DisplayText.Side(Side) side to answer.</p>
    }
</div>

@code {
    /// <summary>The page's words for the view (pass 31c, design D11): a unit's name for its id, a Location in words.</summary>
    [CascadingParameter(Name = "Say")]
    public Func<string, string>? Words { get; set; }

    private string Say(string? text) => text is null ? string.Empty : Words?.Invoke(text) ?? text;

    // The choice ended by the ruling every pending choice is under; a choice that ends with a ruling of its own, "(A12.14; ruling R70.21)", names both in
    // that one citation, "(A12.14; rulings R70.21, R5.8)" (pass 70's fixes), so no sentence ends with two.
    private string Described
    {
        get
        {
            var said = Say(Description);
            var core = said.EndsWith(").", StringComparison.Ordinal) ? said[..^1] : said;
            var ruling = core.LastIndexOf("ruling R", StringComparison.Ordinal);
            return core.EndsWith(')') && ruling > core.LastIndexOf('(') && core[(ruling + "ruling R".Length)..^1].All(letter => char.IsAsciiDigit(letter) || letter is '.' or 'b')
                ?$"{core[..ruling]}rulings {core[(ruling + "ruling ".Length)..^1]}, R5.8)."
                : $"{said} (ruling R5.8).";
        }
    }

    // Up to this many options are buttons; more are one list.
    private const int ListedAsButtons = 6;

    // The answer chosen from the list, its option's value, for the choice it was chosen in.
    private string picked = string.Empty;
    private string pickedFor = string.Empty;

    protected override void OnParametersSet()
    {
        if (pickedFor != Key)
        {
            (picked, pickedFor) = (string.Empty, Key);
        }
    }

    /// <summary>An option and how it reads, such as "take it".</summary>
    public sealed record Option(string Value, string Text);

    [Parameter, EditorRequired]
    public string Key { get; set; } = string.Empty;

    /// <summary>The side that answers.</summary>
    [Parameter, EditorRequired]
    public string Side { get; set; } = string.Empty;

    /// <summary>The choice in words.</summary>
    [Parameter, EditorRequired]
    public string Description { get; set; } = string.Empty;

    /// <summary>Whether the view may answer: the answering side or the adjudicator.</summary>
    [Parameter]
    public bool MayAnswer { get; set; }

    /// <summary>The options, given only to a view that may answer.</summary>
    [Parameter]
    public IReadOnlyList<Option> Options { get; set; } = [];

    [Parameter]
    public EventCallback<string> OnChoose { get; set; }
}
