@* Plan N08 (pass 27): where a unit infiltrates to after an Original 2 by its attack or 12 against it (A11.22). The planner supplies the units the
   view may declare for (ruling R23.1) and their destinations; the page keeps the declarations and submits them with the round. *@
<div class="toolbar" id="cc-infiltrations">
    <span class="muted">Infiltration on an Original 2 or 12 (A11.22):</span>
    @foreach (var unit in Units)
    {
        <label>
            @Say(unit.Id)
            <select class="cc-infiltrate" data-unit="@unit.Id" value="@(Infiltrations.GetValueOrDefault(unit.Id) ?? string.Empty)" @onchange="@(args => OnInfiltration.InvokeAsync(new Choice(unit.Id, args.Value as string)))">
                <option value="">stays</option>
                @foreach (var to in unit.Destinations)
                {
                    <option value="@to">to @Say(to)</option>
                }
            </select>
        </label>
    }
</div>

@code {
    /// <summary>The page's words for the view (pass 31c, design D11): a unit's name for its id, a Location in words.</summary>
    [CascadingParameter(Name = "Say")]
    public Func<string, string>? Words { get; set; }

    private string Say(string? text) => text is null ? string.Empty : Words?.Invoke(text) ?? text;

    /// <summary>A unit that may infiltrate, with the Locations it may go to (never empty).</summary>
    public sealed record Infiltrator(string Id, IReadOnlyList<string> Destinations);

    /// <summary>A unit's declaration: where it infiltrates to, or none when it stays.</summary>
    public sealed record Choice(string Unit, string? To);

    [Parameter, EditorRequired]
    public IReadOnlyList<Infiltrator> Units { get; set; } = [];

    [Parameter]
    public IReadOnlyDictionary<string, string> Infiltrations { get; set; } = new Dictionary<string, string>();

    [Parameter]
    public EventCallback<Choice> OnInfiltration { get; set; }
}
