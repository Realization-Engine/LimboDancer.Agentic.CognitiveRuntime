@* Plan N08 (pass 27): where a unit infiltrates to after an Original 2 by its attack or 12 against it (A11.22). The planner supplies the units the
   view may declare for (ruling R23.1) and their destinations, as the side sees them (pass 70, ruling R70.26); a unit above its IPC offers its SW to drop
   (A11.21). The page keeps the declarations and submits them with the round. *@
<div class="cc-infiltrations" id="cc-infiltrations">
    <p class="toolbar-note">Destinations used only if infiltration is triggered (A11.22).</p>
    @foreach (var unit in Units)
    {
        <ActionFormGroup @key="unit.Id" Legend="@Say(unit.Id)">
        @if (unit.Drops.Count > 0)
        {
            <p class="toolbar-note">@unit.Load</p>
            <details open>
                <summary>Equipment to leave if infiltration occurs</summary>
                @foreach (var weapon in unit.Drops)
                {
                    <label><input class="cc-infiltration-drop" type="checkbox" data-unit="@unit.Id" data-weapon="@weapon.Id" checked="@Dropped.Contains(weapon.Id)" @onchange="@(args => OnDrop.InvokeAsync(new UnitSelectionList.Toggle(weapon.Id, args.Value is true)))" /> @Say(weapon.Label)</label>
                }
            </details>
        }
        <label>Destination
            <select class="cc-infiltrate" data-unit="@unit.Id" value="@(Infiltrations.GetValueOrDefault(unit.Id) ?? string.Empty)" @onchange="@(args => OnInfiltration.InvokeAsync(new Choice(unit.Id, args.Value as string)))">
                <option value="">stays</option>
                @foreach (var to in unit.Destinations)
                {
                    <option value="@to">to @Say(to)</option>
                }
            </select>
        </label>
        </ActionFormGroup>
    }
</div>

@code {
    /// <summary>The page's words for the view (pass 31c, design D11): a unit's name for its id, a Location in words.</summary>
    [CascadingParameter(Name = "Say")]
    public Func<string, string>? Words { get; set; }

    private string Say(string? text) => text is null ? string.Empty : Words?.Invoke(text) ?? text;

    /// <summary>
    /// A unit that may infiltrate, with the Locations it may go to, and, above its IPC, the SW it may drop (pass 70, ruling R70.26); the Locations are empty
    /// only for a unit above its IPC until enough SW are ticked (fix round C).
    /// </summary>
    public sealed record Infiltrator(string Id, IReadOnlyList<string> Destinations)
    {
        public IReadOnlyList<PlayChoice> Drops { get; init; } = [];
        public string Load { get; init; } = string.Empty;
    }

    /// <summary>A unit's declaration: where it infiltrates to, or none when it stays.</summary>
    public sealed record Choice(string Unit, string? To);

    [Parameter, EditorRequired]
    public IReadOnlyList<Infiltrator> Units { get; set; } = [];

    [Parameter]
    public IReadOnlyDictionary<string, string> Infiltrations { get; set; } = new Dictionary<string, string>();

    [Parameter]
    public EventCallback<Choice> OnInfiltration { get; set; }

    /// <summary>The SW ticked to drop (A11.21; ruling R70.26).</summary>
    [Parameter]
    public IReadOnlySet<string> Dropped { get; set; } = new HashSet<string>();

    [Parameter]
    public EventCallback<UnitSelectionList.Toggle> OnDrop { get; set; }
}
