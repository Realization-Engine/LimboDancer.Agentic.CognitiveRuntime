@* Plan C05 (pass 27): units held in Melee withdraw to an ADJACENT Location with no Known enemy unit (A11.2, A11.21), and a broken one must try (A11.16). The
   planner supplies each unit's destinations, as the side sees them (pass 70, ruling R70.26), and whether it must try; a unit above its IPC offers its SW to
   drop, which stay unpossessed in the Location (A11.21). The page keeps the declarations and submits them with the round. *@
<div class="action-form" id="cc-withdrawals">
    @foreach (var unit in Units)
    {
        <ActionFormGroup Legend="@Say(unit.Label)">
        @if (unit.MustTry) { <p class="toolbar-note">Broken: must try to withdraw.</p> }
        @if (unit.Drops.Count > 0)
        {
            <p class="toolbar-note">@unit.Load</p>
            <details open="@(unit.Destinations.Count == 0 || unit.Drops.Any(weapon => Dropped.Contains(weapon.Id)))">
                <summary>Equipment to leave behind</summary>
                @foreach (var weapon in unit.Drops)
                {
                    <label><input class="cc-drop" type="checkbox" data-unit="@unit.Id" data-weapon="@weapon.Id" checked="@Dropped.Contains(weapon.Id)" @onchange="@(args => OnDrop.InvokeAsync(new UnitSelectionList.Toggle(weapon.Id, args.Value is true)))" /> @Say(weapon.Label)</label>
                }
            </details>
        }
        <label>Destination
            <select class="cc-withdraw" data-unit="@unit.Id" value="@(Withdrawals.GetValueOrDefault(unit.Id) ?? string.Empty)" @onchange="@(args => OnWithdrawal.InvokeAsync(new Choice(unit.Id, args.Value as string)))">
                <option value="">stays</option>
                @foreach (var to in unit.Destinations)
                {
                    <option value="@to">withdraws to @Say(to)</option>
                }
            </select>
        </label>
        </ActionFormGroup>
    }
</div>

@code {
    /// <summary>The page's words for the view (pass 31c, design D11): a unit's name for its id, a Location in words.</summary>
    [CascadingParameter(Name = "Say")]
    public Func<string, string>? Words { get; set; }

    private string Say(string? text) => text is null ? string.Empty : Words?.Invoke(text) ?? text;

    /// <summary>
    /// A unit that may withdraw: its id, how it reads, whether it must try, where it may go, and, above its IPC, the SW it may drop to withdraw (pass 70,
    /// ruling R70.26; empty otherwise).
    /// </summary>
    public sealed record Withdrawer(string Id, string Label, bool MustTry, IReadOnlyList<string> Destinations)
    {
        public IReadOnlyList<PlayChoice> Drops { get; init; } = [];
        public string Load { get; init; } = string.Empty;
    }

    /// <summary>A unit's declaration: where it withdraws to, or none when it stays.</summary>
    public sealed record Choice(string Unit, string? To);

    [Parameter, EditorRequired]
    public IReadOnlyList<Withdrawer> Units { get; set; } = [];

    [Parameter]
    public IReadOnlyDictionary<string, string> Withdrawals { get; set; } = new Dictionary<string, string>();

    [Parameter]
    public EventCallback<Choice> OnWithdrawal { get; set; }

    /// <summary>The SW ticked to drop (A11.21; ruling R70.26).</summary>
    [Parameter]
    public IReadOnlySet<string> Dropped { get; set; } = new HashSet<string>();

    [Parameter]
    public EventCallback<UnitSelectionList.Toggle> OnDrop { get; set; }
}
