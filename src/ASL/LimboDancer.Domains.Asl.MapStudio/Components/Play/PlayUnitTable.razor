@* R12 (plan section 16.13): the units the view may see, with their movement and conditions already in words, and the "?" it knows of, by Location.
   It receives rows, never the game state, so nothing withheld can reach it. *@
<p class="muted" id="play-units-view">@ViewNote</p>
<div class="table-scroll" role="region" aria-label="Units" tabindex="0">
<table class="library" id="play-units">
    <thead><tr><th>Unit</th><th>Side</th><th>Kind</th><th>Location</th><th>MF spent</th><th>Conditions</th></tr></thead>
    <tbody>
        @foreach (var row in Rows)
        {
            <tr data-unit="@row.Id">
                <td title="@row.Id">@Say(row.Id)</td><td>@DisplayText.Side(row.Side)</td><td>@row.Kind</td>
                <td>
                    @if (row.At is { } at)
                    {
                        <button class="play-locate" title="@at" aria-label="Show @Say(at.ToString()) on the map" @onclick="() => Locate.InvokeAsync(at)">@Say(at.ToString())</button>
                    }
                    else
                    {
                        @row.Status
                    }
                </td>
                <td>@row.Movement</td>
                <td>@Say(row.Conditions)</td>
            </tr>
        }
        @foreach (var presence in Sealed)
        {
            <tr data-sealed="@presence.PlacementId">
                <td>?</td><td>@DisplayText.Side(presence.Side)</td><td>@(presence.Uninspected ? "not inspectable before play (A2.9)" : "concealed")</td><td title="@presence.Location">@Say(presence.Location.ToString())</td><td></td><td></td>
            </tr>
        }
    </tbody>
</table>
</div>

@code {
    /// <summary>The page's words for the view (pass 31c, design D11): a unit's name for its id, a Location in words.</summary>
    [CascadingParameter(Name = "Say")]
    public Func<string, string>? Words { get; set; }

    private string Say(string? text) => text is null ? string.Empty : Words?.Invoke(text) ?? text;

    /// <summary>A unit as the view shows it: where it is (null when it is off the map), or its status, its movement, and its conditions in words.</summary>
    public sealed record Row(string Id, string Side, string Kind, BoardLocation? At, string Status, string Movement, string Conditions);

    [Parameter]
    public string ViewNote { get; set; } = string.Empty;

    [Parameter]
    public IReadOnlyList<Row> Rows { get; set; } = [];

    /// <summary>The "?" the view knows of (A12.11), and before play the counters beneath an enemy stack's top (A2.9).</summary>
    [Parameter]
    public IReadOnlyList<LimboDancer.Domains.Asl.Units.State.SealedPresence> Sealed { get; set; } = [];

    [Parameter]
    public EventCallback<BoardLocation> Locate { get; set; }
}
