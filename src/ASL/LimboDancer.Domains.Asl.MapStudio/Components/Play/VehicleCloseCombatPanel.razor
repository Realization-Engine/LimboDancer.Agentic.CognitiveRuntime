@* Plan C01 (pass 27): sequential CC in each Location holding a vehicle (A11.31). The page reads each open Location's next side and its units
   (the planner's turn, read once per Location), keeps the one attack draft the Locations share, and proposes the attack or the pass. *@
<ActionSection Title="Close Combat with vehicles" Key="close-combat-with-vehicles">
<RuleHelp Id="vehicle-cc-help" Summary="With a vehicle in the Location, CC is sequential: the non-vehicular side attacks first, then the sides alternate until every unit has attacked or its side passes (A11.31).">
    In a Location holding a vehicle CC is sequential: the non-vehicular side attacks first, one attack at a time, then the sides alternate
    until every unit has attacked or its side passes (A11.31); after an Ambush the ambusher makes all its attacks first (A11.34). Infantry attack
    a vehicle with their CCV as the Kill Number, one unit or one with a SMC (A11.5); a vehicle attacks Infantry with its CMG and CE AAMG on the
    CCT, a CE halftrack's Passengers adding their FP (A11.62). Infantry attack enemy Infantry there one attack at a time with no reply; a unit
    attacked by a vehicle may still be attacked by Infantry (A11.12). A Rider is attacked apart, with -1, and attacks with +1 (A11.611). The Passengers
    of an unarmored stationary vehicle are attacked only to capture them, at -2 with the capture's +1, their captors defending with +2; once all are
    captured with no enemy Personnel left, the vehicle is too (A11.52). Infantry that advanced from an ADJACENT building into a road hex fight a vehicle there
    with -1, its attack on them +1 (Street Fighting, A11.8).
    An Abandoned AFV may instead be the target of a capture attempt, at -1 and as if CE and Immobile; with no Personnel of its side there it is
    captured anyway as the CCPh ends (A21.2).
</RuleHelp>
@foreach (var location in Locations)
{
    // Pass 35: the Locations share one draft, so each shows and proposes only what was chosen among its own units.
    var chosen = location.Vehicles.Any(vehicle => vehicle.Id == Vehicle) ? Vehicle : string.Empty;
    var targetsVehicle = location.Vehicles.Any(vehicle => vehicle.Id == chosen && vehicle.Side != location.NextSide);
    bool Admitted(string id) => !targetsVehicle || location.VehicleAttackers is null || location.VehicleAttackers.GetValueOrDefault(id)?.Contains(chosen, StringComparer.Ordinal) == true;
    var attackers = location.Attackers.Where(Admitted).ToArray();
    var leaders = location.Leaders.Where(Admitted).ToArray();
    var attacker = attackers.Contains(Attacker, StringComparer.Ordinal) ? Attacker : string.Empty;
    var leader = leaders.Contains(Leader, StringComparer.Ordinal) ? Leader : string.Empty;
    var anyDefender = location.Defenders.Any(unit => Defenders.Contains(unit) && !location.Riders.ContainsKey(unit) && !location.Passengers.ContainsKey(unit));
    // Pass 70 (rulings R70.30, R70.34): an Infantry attack needs a checked defender no Infantry has attacked this CCPh; a Passenger is attacked only to capture it.
    var infantryReady = attacker.Length > 0 && location.Defenders.Any(unit => Defenders.Contains(unit) && !location.InfantryAttacked.Contains(unit) && !location.Passengers.ContainsKey(unit));
    var passengerReady = attacker.Length > 0 && location.Defenders.Any(unit => Defenders.Contains(unit) && !location.InfantryAttacked.Contains(unit) && location.Passengers.ContainsKey(unit));
    <div @key="location.Location" class="toolbar vehicle-cc" data-location="@location.Location">
        <span>@Say(location.Location): the @DisplayText.Side(location.NextSide) side attacks next.</span>
        <label>
            Attacker
            <select class="vehicle-cc-attacker" value="@attacker" @onchange="@(args => OnAttacker.InvokeAsync(args.Value as string ?? string.Empty))">
                <option value="">choose</option>
                <UnitOptions Units="@([.. attackers.Select(unit => new PlayChoice(unit, Label(location, unit)))])" Text="@Say" />
            </select>
        </label>
        <label>
            With SMC
            <select class="vehicle-cc-leader" value="@leader" @onchange="@(args => OnLeader.InvokeAsync(args.Value as string ?? string.Empty))">
                <option value="">none</option>
                <UnitOptions Units="@([.. leaders.Select(unit => new PlayChoice(unit, unit))])" Text="@Say" />
            </select>
        </label>
        <label>
            Vehicle
            <select class="vehicle-cc-vehicle" value="@chosen" @onchange="@(args => OnVehicle.InvokeAsync(args.Value as string ?? string.Empty))">
                <option value="">choose</option>
                @* The hex UI rule (pass 65, the UI review): each vehicle named after its hex, "[F8]: PzKpfw IIIH G1, Abandoned". *@
                <UnitOptions Units="@([.. location.Vehicles.Select(vehicle => new PlayChoice(vehicle.Id, Name(location, vehicle.Id) + (vehicle.Abandoned ? ", Abandoned" : string.Empty)))])" Text="@Say" />
            </select>
        </label>
        @* The hex UI rule: each enemy unit named after its hex, leaders first, a Rider with the vehicle it rides. *@
        @foreach (var unit in location.Defenders)
        {
            <label @key="unit"><input type="checkbox" class="vehicle-cc-defender" checked="@Defenders.Contains(unit)" @onchange="@(args => OnDefender.InvokeAsync(new UnitSelectionList.Toggle(unit, args.Value is true)))" /> @Say(location.Location): @Label(location, unit)</label>
        }
        <button class="propose-vehicle-cc-infantry" disabled="@(!infantryReady)" title="@(infantryReady ? null : "Choose an attacker and check enemy Infantry no Infantry has attacked")"
            @onclick="@(() => OnProposeInfantry.InvokeAsync(location.Location))">Propose: the Infantry attack the checked enemy Infantry (A11.31)</button>
        @* Pass 70 (ruling R70.34): the Passengers of an unarmored stationary vehicle are attacked only to capture them, and with them the vehicle (A11.52). *@
        @if (location.Passengers.Count > 0)
        {
            <button class="propose-vehicle-cc-capture-passengers" disabled="@(!passengerReady)" title="@(passengerReady ? null : "Choose an attacker and check the Passengers to capture")"
                @onclick="@(() => OnProposeCapturePassengers.InvokeAsync(location.Location))">Propose: the Infantry attempt to capture the checked Passengers (A11.52)</button>
        }
        <button class="propose-vehicle-cc-attack" disabled="@(attacker.Length == 0 || chosen.Length == 0)" title="@(attacker.Length > 0 && chosen.Length > 0 ? null : "Choose an attacker and the vehicle")" @onclick="@(() => OnProposeAttack.InvokeAsync(location.Location))">Propose: Infantry attack the vehicle</button>
        @* Pass 65 (ruling R65.22): an Abandoned AFV may be the target of a capture attempt, which captures it where an attack would eliminate it (A21.2). *@
        @if (location.Vehicles.Any(vehicle => vehicle.Abandoned))
        {
            var captureReady = attacker.Length > 0 && location.Vehicles.Any(vehicle => vehicle.Id == chosen && vehicle.Abandoned);
            <button class="propose-vehicle-cc-capture" disabled="@(!captureReady)" title="@(captureReady ? null : "Choose an attacker and the Abandoned AFV")"
                @onclick="@(() => OnProposeCapture.InvokeAsync(location.Location))">Propose: Infantry attempt to capture the Abandoned AFV (A21.2)</button>
        }
        <button class="propose-vehicle-cc-vehicle" disabled="@(chosen.Length == 0 || !anyDefender)" title="@(chosen.Length > 0 && anyDefender ? null : "Choose the vehicle and check the enemy Infantry it attacks")"
            @onclick="@(() => OnProposeVehicle.InvokeAsync(location.Location))">Propose: the vehicle attacks the checked Infantry</button>
        <button class="propose-vehicle-cc-pass" @onclick="@(() => OnPass.InvokeAsync(location.Location))">Propose: the @DisplayText.Side(location.NextSide) side passes</button>
    </div>
}
</ActionSection>

@code {
    /// <summary>The page's words for the view (pass 31c, design D11): a unit's name for its id, a Location in words.</summary>
    [CascadingParameter(Name = "Say")]
    public Func<string, string>? Words { get; set; }

    private string Say(string? text) => text is null ? string.Empty : Words?.Invoke(text) ?? text;

    /// <summary>A vehicle in the Location and its side, and whether it is an Abandoned AFV, which a capture attempt may take (A21.2; pass 65).</summary>
    public sealed record VehicleChoice(string Id, string Side, bool Abandoned = false);

    /// <summary>
    /// A Location whose sequential CC is open: the side that attacks next, its units that may still attack, its SMC, the vehicles there, and the
    /// non-vehicular units of the other side a vehicle may attack.
    /// </summary>
    public sealed record CcLocation(string Location, string NextSide, IReadOnlyList<string> Attackers, IReadOnlyList<string> Leaders,
        IReadOnlyList<VehicleChoice> Vehicles, IReadOnlyList<string> Defenders)
    {
        /// <summary>The vehicles each unit may attack, gathered through the command's Rules refusal.</summary>
        public IReadOnlyDictionary<string, IReadOnlyList<string>>? VehicleAttackers { get; init; }

        /// <summary>The Riders among the units offered, each with the vehicle it rides (A11.611; pass 70, ruling R70.31).</summary>
        public IReadOnlyDictionary<string, string> Riders { get; init; } = new Dictionary<string, string>(StringComparer.Ordinal);

        /// <summary>The units Infantry attacked there this CCPh, which no Infantry attacks again (A11.12; ruling R70.30).</summary>
        public IReadOnlyList<string> InfantryAttacked { get; init; } = [];

        /// <summary>The Passengers of an unarmored stationary vehicle among the units offered, each with its vehicle, attacked only to capture them (A11.52; ruling R70.34).</summary>
        public IReadOnlyDictionary<string, string> Passengers { get; init; } = new Dictionary<string, string>(StringComparer.Ordinal);
    }

    /// <summary>
    /// A unit's label in the page's words: its name, and for a Rider or a Passenger the vehicle it is aboard, "4-4-7 squad, Rider on PzKpfw IIIH". Each
    /// name leaves out the Location the list says before it (the hex UI rule), so the other side's units do not read "in [N5]" again.
    /// </summary>
    private string Label(CcLocation location, string unit) => location.Riders.TryGetValue(unit, out var vehicle) ? $"{Name(location, unit)}, Rider on {Name(location, vehicle)}"
        : location.Passengers.TryGetValue(unit, out var carrier) ? $"{Name(location, unit)}, Passenger in {Name(location, carrier)}" : Name(location, unit);

    private string Name(CcLocation location, string id) => UnitGrouping.WithoutPlace(Say(id), Say(location.Location));

    [Parameter, EditorRequired]
    public IReadOnlyList<CcLocation> Locations { get; set; } = [];

    [Parameter]
    public string Attacker { get; set; } = string.Empty;

    [Parameter]
    public string Leader { get; set; } = string.Empty;

    [Parameter]
    public string Vehicle { get; set; } = string.Empty;

    /// <summary>The checked Infantry the vehicle attacks.</summary>
    [Parameter]
    public IReadOnlySet<string> Defenders { get; set; } = new HashSet<string>();

    [Parameter]
    public EventCallback<string> OnAttacker { get; set; }

    [Parameter]
    public EventCallback<string> OnLeader { get; set; }

    [Parameter]
    public EventCallback<string> OnVehicle { get; set; }

    [Parameter]
    public EventCallback<UnitSelectionList.Toggle> OnDefender { get; set; }

    /// <summary>Infantry attack the vehicle in this Location.</summary>
    [Parameter]
    public EventCallback<string> OnProposeAttack { get; set; }

    /// <summary>Infantry attempt to capture the chosen Abandoned AFV in this Location (A21.2; pass 65, ruling R65.22).</summary>
    [Parameter]
    public EventCallback<string> OnProposeCapture { get; set; }

    /// <summary>The vehicle attacks the checked Infantry in this Location.</summary>
    [Parameter]
    public EventCallback<string> OnProposeVehicle { get; set; }

    /// <summary>The chosen Infantry attack the checked enemy Infantry in this Location (A11.31; pass 70, ruling R70.30).</summary>
    [Parameter]
    public EventCallback<string> OnProposeInfantry { get; set; }

    /// <summary>The chosen Infantry attempt to capture the checked Passengers in this Location (A11.52; pass 70, ruling R70.34).</summary>
    [Parameter]
    public EventCallback<string> OnProposeCapturePassengers { get; set; }

    /// <summary>The next side passes in this Location.</summary>
    [Parameter]
    public EventCallback<string> OnPass { get; set; }
}
