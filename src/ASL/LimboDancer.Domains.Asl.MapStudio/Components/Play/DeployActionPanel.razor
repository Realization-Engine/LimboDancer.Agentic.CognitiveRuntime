@* Plan A07 (pass 28b): a squad Deploying into two HS (A1.31). The page gives the squads and leaders the view sees (ruling R23.1) and the SW the chosen
   squad possesses; choosing another squad clears the leader and the SW, which the page does in its OnSquad handler (section 15.3). Each SW checked
   goes to the second HS, the rest stay with the first (backlog section 23, built in pass 28b). *@
<RuleHelp Id="deploy-help" Summary="A Good Order squad Deploys into two HS on a NTC with a Good Order leader in its Location (Russian squads may not Deploy, A25.2); two Good Order HS of one kind Recombine the same way. Either is the sole RPh action (A1.31, A1.32).">
    A Good Order squad with a Good Order leader of its nationality in its Location Deploys into two HS on a NTC modified by his leadership; Russian
    squads may not Deploy (A25.2); two Good Order HS of one kind Recombine with such a leader. Either is the units' and the leader's sole RPh action (A1.31, A1.32).
    A squad waiting off board may attempt to Deploy from its entry turn's RPh with a leader waiting to enter along the same edge (A2.52; ruling R25.4).
</RuleHelp>
<div class="toolbar">
    <label>
        Squad
        <select id="deploy-squad" value="@Squad" @onchange="@(args => OnSquad.InvokeAsync(args.Value as string ?? string.Empty))">
            <option value="">choose</option>
            @foreach (var squad in Squads)
            {
                <option value="@squad.Id">@At(squad.Label)</option>
            }
        </select>
    </label>
    <label>
        Leader
        <select id="deploy-leader" value="@Leader" @onchange="@(args => OnLeader.InvokeAsync(args.Value as string ?? string.Empty))">
            <option value="">choose</option>
            @foreach (var leader in Leaders)
            {
                <option value="@leader">@Say(leader)</option>
            }
        </select>
    </label>
    @if (Weapons.Count > 0)
    {
        <fieldset id="deploy-weapons">
            <legend>SW for the second HS (the rest stay with the first)</legend>
            @foreach (var weapon in Weapons)
            {
                <label @key="weapon"><input type="checkbox" class="deploy-weapon" data-weapon="@weapon" checked="@Second.Contains(weapon)"
                                            @onchange="@(args => OnWeapon.InvokeAsync(new Toggle(weapon, args.Value is true)))" /> @Say(weapon)</label>
            }
        </fieldset>
    }
    <button id="propose-deploy" disabled="@(!Squads.Any(squad => squad.Id == Squad))" aria-describedby="propose-deploy-ready" @onclick="@(() => OnPropose.InvokeAsync())">Propose: deploy</button>
    @if (!Squads.Any(squad => squad.Id == Squad))
    {
        <span id="propose-deploy-ready" class="toolbar-note">Choose the squad that Deploys.</span>
    }
</div>

@code {
    /// <summary>The page's words for the view (pass 31c, design D11): a unit's name for its id, a Location in words.</summary>
    [CascadingParameter(Name = "Say")]
    public Func<string, string>? Words { get; set; }

    private string Say(string? text) => text is null ? string.Empty : Words?.Invoke(text) ?? text;

    /// <summary>A unit's name with its hex, "4-6-7 squad G4 in [G4]" (the user, 2026-10-04), where no Location stands beside the name.</summary>
    [CascadingParameter(Name = "SayAt")]
    public Func<string, string>? WordsAt { get; set; }

    private string At(string? text) => text is null ? string.Empty : WordsAt?.Invoke(text) ?? Say(text);

    /// <summary>A SW checked or cleared for the second HS.</summary>
    public sealed record Toggle(string Id, bool On);

    [Parameter, EditorRequired]
    public IReadOnlyList<PlayChoice> Squads { get; set; } = [];

    /// <summary>The leaders who may help the chosen squad Deploy.</summary>
    [Parameter, EditorRequired]
    public IReadOnlyList<string> Leaders { get; set; } = [];

    /// <summary>The SW the chosen squad possesses.</summary>
    [Parameter, EditorRequired]
    public IReadOnlyList<string> Weapons { get; set; } = [];

    [Parameter]
    public string Squad { get; set; } = string.Empty;

    [Parameter]
    public string Leader { get; set; } = string.Empty;

    /// <summary>The SW the second HS takes.</summary>
    [Parameter]
    public IReadOnlySet<string> Second { get; set; } = new HashSet<string>();

    [Parameter]
    public EventCallback<string> OnSquad { get; set; }

    [Parameter]
    public EventCallback<string> OnLeader { get; set; }

    [Parameter]
    public EventCallback<Toggle> OnWeapon { get; set; }

    [Parameter]
    public EventCallback OnPropose { get; set; }
}
