@* Plan R08 (pass 28b): a fire attack's arithmetic as recorded: each firer's FP and multipliers, the column and its shifts, and the IFT DR with its
   DRM. It writes the record's numbers and never recalculates them. *@
@using System.Globalization
@using LimboDancer.Domains.Asl.Rules
<ul>
    @foreach (var firer in Arithmetic.Firers)
    {
        <li class="fire-fp" data-unit="@firer.UnitId" title="@(UnitNames.IsUnnamed(Say(firer.UnitId)) ? null : firer.UnitId)">@Say(firer.UnitId): @firer.Printed FP@(string.Concat(firer.Multipliers.Select(FireText.MultiplierText))) = @FireText.Number(firer.Firepower)</li>
    }
    <li class="fire-column">
        Total @FireText.Number(Arithmetic.TotalFirepower) FP: the @(Arithmetic.UnshiftedColumnFp?.ToString(CultureInfo.InvariantCulture) ?? "no") column@(Arithmetic.ColumnShift != 0 || Arithmetic.Cowered ? $", shifted {Arithmetic.ColumnShift}{(Arithmetic.Cowered ? " by Cowering (A7.9)" : "")} to the {Arithmetic.ColumnFp?.ToString(CultureInfo.InvariantCulture) ?? "no"} column" : "")
    </li>
    <li class="fire-dr">
        @if (ShowDice)
        {
            <AslDice Roll="@AslRollView.Values("ift", "IFT DR", Arithmetic.Dice, coloredFirst: true)" /><text> = </text>
        }
        else
        {
            <text>Original DR </text>
        }
        @Arithmetic.OriginalDr@Say(FireText.ModifierText(Arithmetic.Drm)):
        Final DR <span class="fire-final-dr">@Arithmetic.FinalDr</span>, result <strong class="fire-result">@FireText.ResultText(Arithmetic.Result)</strong>
    </li>
</ul>

@code {
    [Parameter]
    public bool ShowDice { get; set; } = true;

    [Parameter, EditorRequired]
    public FireArithmetic Arithmetic { get; set; } = default!;

    /// <summary>A text in the view's words (pass 31c, design D11); the record gives it.</summary>
    [Parameter]
    public Func<string, string> Say { get; set; } = text => text;
}
