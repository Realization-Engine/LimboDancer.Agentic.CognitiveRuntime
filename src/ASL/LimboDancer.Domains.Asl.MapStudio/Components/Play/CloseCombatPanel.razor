@using LimboDancer.Domains.Asl.Units.State
<ActionSection Title="Close Combat" Key="close-combat">
<RuleHelp Id="cc-help" Summary="Units of both sides in a Location attack each other, one Location at a time, none attacking or attacked more than once; roll for Ambush first where it applies, and declare SMC stacking before the attacks (A11.11, A11.12, A11.4, A11.14).">
    Units of both sides in one Location attack each other (A11.11): one Location at a time, each unit attacking and attacked at most once
    (A11.12). Where Infantry advanced into woods or a building, or with or against a concealed unit, roll for Ambush first (A11.4); the ambusher's round comes before the other
    side's, and the ambusher resolves each attack before declaring the next (A11.3). Declare which MMC each SMC is stacked with before the
    attacks (A11.14). A unit held in Melee may withdraw to an ADJACENT Location with no enemy unit (A11.2), and a broken one must try
    (A11.16). Units of both sides left in a Location are held in Melee at the end of the phase (A11.15); a unit that keeps its "?" is not
    (A11.19). An attack may be a capture attempt (+1 DRM, -1 against Inexperienced units; A20.22): below the Kill Number every defender is
    captured, at it one of the defender's choice, in the order the defender gives. A unit may declare where it infiltrates to after an
    Original 2 by its attack or 12 against it (A11.22). Prisoners of a broken Guard, or of one held in Melee, may attack it in their own
    round first (A20.55). Hand-to-Hand CC, with the red Kill Numbers, needs its SSR (J2.31).
</RuleHelp>
@if (Due.Count > 0)
{
    <ul id="cc-due">@foreach (var item in Due) { <li>@DisplayText.Sentence(Say(item))</li> }</ul>
}
@if (Locations.Count == 0)
{
    <p id="cc-empty" class="toolbar-note">No Close Combat locations are available.</p>
}
else
{
<div class="action-form cc-workflow">
    <div class="toolbar cc-location">
        <label>Location
            <select id="cc-location" value="@Location" @onchange="@(args => RequestLocation(args.Value as string ?? string.Empty))">
                <option value="">choose</option>
                @foreach (var at in Locations) { <option value="@at">@Say(at)</option> }
            </select>
        </label>
        @if (Location.Length > 0)
        {
            <button type="button" class="link" id="cc-release" @onclick="@(() => RequestLocation(string.Empty))">Release location</button>
        }
        else
        {
            <span class="toolbar-note">Choose a location or select its hex on the map.</span>
        }
    </div>
    @if (mapNote is not null) { <p class="toolbar-note" role="status">@mapNote</p> }
    @if (pendingLocation is not null)
    {
        <div class="cc-change-location" role="status">
            <p>Changing location clears this round's declarations.</p>
            <button type="button" @onclick="ConfirmLocation">Clear declarations and change location</button>
            <button type="button" class="link" @onclick="@(() => pendingLocation = null)">Keep this location</button>
        </div>
    }
    @if (Location.Length > 0)
    {
        @if (Entry is { } entry)
        {
            <p id="cc-status" class="toolbar-note">
                @(entry.AmbushRolled ? entry.Ambusher is { } ambusher ? $"The {DisplayText.Side(ambusher)} side ambushes." : "No Ambush." : "")
                @(entry.Closed ? "Resolved this CCPh." : "")
            </p>
        }
        @if (Entry?.Closed != true)
        {
            @if (Step == DeclareStep || Step == WaitStep || OtherDeclared)
            {
                <ol class="cc-progress" aria-label="Close Combat progress">
                    <li aria-current="@(Step == DeclareStep || Step == WaitStep ? "step" : null)">@DisplayText.Side(FirstSide) declares@(OtherDeclared ? " (done)" : "")</li>
                    <li aria-current="@(OtherDeclared && !reviewing ? "step" : null)">@DisplayText.Side(SecondSide) declares@(OtherDeclared && reviewing ? " (done)" : "")</li>
                    <li aria-current="@(reviewing ? "step" : null)">Review and resolve</li>
                </ol>
            }
            @if (AmbushDue)
            {
                <p id="cc-ambush-first" class="toolbar-note">Resolve Ambush before declaring attacks.</p>
                <button id="propose-ambush" @onclick="@(() => OnProposeAmbush.InvokeAsync())">Propose: roll for Ambush</button>
            }
            @if (AmbushWithdrawals is { } withdrawals)
            {
                @AmbushEquipment
                <AmbushWithdrawalActions Withdrawals="@withdrawals" OnPropose="@OnAmbushWithdraw" />
            }
            @if (Step == WaitStep)
            {
                <p id="cc-declares-first" class="toolbar-note">Waiting for the @DisplayText.Side(FirstSide) side to declare.</p>
            }
            else if (!reviewing)
            {
                @if (Smcs.Count > 0) { <CloseCombatStacking Smcs="@Smcs" Stacking="@Stacking" OnStacking="@OnStacking" /> }
                @if (Withdrawers.Count > 0)
                {
                    <CloseCombatWithdrawals Units="@Withdrawers" Withdrawals="@Withdrawals" OnWithdrawal="@OnWithdrawal" Dropped="@Dropped" OnDrop="@OnDrop" />
                }
                @if (!AmbushDue && (HasDraft || Sides.Any(side => side.Attackers.Count > 0 && side.Defenders.Count > 0)))
                {
                    <CloseCombatAttackBuilder Sides="@Sides" Declaring="true" Attackers="@Attackers" Defenders="@Defenders" Directors="@Directors" Director="@Director"
                        Capture="@Capture" Guard="@Guard" Yield="@Yield" OnAttacker="@OnAttacker" OnDefender="@OnDefender" OnDirector="@OnDirector" OnCapture="@OnCapture"
                        OnGuard="@OnGuard" OnYield="@OnYield" OnAdd="@OnAddAttack" OnClear="@OnClearAttack" />
                }
                @if (!OtherDeclared)
                {
                    <details class="action-options" open="@(Round.Length > 0 || HandToHand)">
                        <summary>Round options</summary>
                        <div class="action-fields">
                        @if (Entry is { Closed: false, Ambusher: not null } prior && prior.Rounds.Count > 0)
                        {
                            <label>Round
                                <select id="cc-round" value="@Round" @onchange="@(args => OnRound.InvokeAsync(args.Value as string))">
                                    <option value="">the ambushed side's round</option>
                                    <option value="@CloseCombatResolved.AmbusherRound">another attack by the ambusher</option>
                                </select>
                            </label>
                        }
                        else if (Entry is null || Entry.Rounds.Count == 0)
                        {
                            <label><input id="cc-prisoners-round" type="checkbox" checked="@(Round == CloseCombatResolved.PrisonersRound)"
                                @onchange="@(args => OnRound.InvokeAsync(args.Value is true ? CloseCombatResolved.PrisonersRound : null))" /> Prisoners' escape round (A20.55)</label>
                            @if (HandToHandAllowed)
                            {
                                <label><input id="cc-hand-to-hand" type="checkbox" checked="@HandToHand" @onchange="@(args => OnHandToHand.InvokeAsync(args.Value is true))" /> Hand-to-Hand (J2.31)</label>
                            }
                        }
                        </div>
                    </details>
                }
                @if (!AmbushDue && Infiltrators is { Count: > 0 } infiltrators)
                {
                    <details class="action-options" open="@(Infiltrations.Count > 0)">
                        <summary>Infiltration choices</summary>
                        <CloseCombatInfiltrationChoices Units="@infiltrators" Infiltrations="@Infiltrations" OnInfiltration="@OnInfiltration" Dropped="@Dropped" OnDrop="@OnDrop" />
                    </details>
                }
            }
            @if (!AmbushDue)
            {
                @if (OtherDeclared)
                {
                    <section class="cc-declarations" aria-label="First side declarations">
                        <h5 id="cc-declared-by">@DisplayText.Side(FirstSide): declared</h5>
                        @if (OtherAttacks.Count == 0) { <p>No attacks.</p> }
                        <ul id="cc-declared">@foreach (var attack in OtherAttacks) { <li>@AttackText(attack)</li> }</ul>
                        @foreach (var note in OtherChoices) { <p class="toolbar-note">@Say(note)</p> }
                    </section>
                }
                @if (Step != WaitStep)
                {
                    <section class="cc-declarations" aria-label="Your declarations">
                        <h5>@(Sides.Count == 1 ? DisplayText.Side(Sides[0].Side) : "This round"): @(reviewing ? "declared" : "attacks added")</h5>
                        @if (Attacks.Count == 0) { <p>@(reviewing ? "No attacks." : "No attacks added.")</p> }
                        <ul id="cc-attacks">
                            @foreach (var attack in Attacks)
                            {
                                <li>@AttackText(attack)
                                    @if (!reviewing && MayRemove(attack))
                                    {
                                        <button type="button" class="link" aria-label="@Say($"Edit: {string.Join(", ", attack.Attackers)} against {string.Join(", ", attack.Defenders)}")" disabled="@HasDraft" @onclick="@(() => OnEditAttack.InvokeAsync(attack))">Edit</button>
                                        <button type="button" class="link" aria-label="@Say($"Remove: {string.Join(", ", attack.Attackers)} against {string.Join(", ", attack.Defenders)}")" @onclick="@(() => OnRemoveAttack.InvokeAsync(attack))">Remove</button>
                                    }
                                </li>
                            }
                        </ul>
                        @if (reviewing)
                        {
                            @foreach (var note in ChoiceNotes(Stacking, Withdrawals, Infiltrations, Dropped, HandToHand, Round)) { <p class="toolbar-note">@Say(note)</p> }
                        }
                    </section>
                    <ActionProposalArea>
                        @if (HasDraft) { <span id="cc-draft-note" class="toolbar-note">Add or clear the current attack first.</span> }
                        @if (Step == DeclareStep)
                        {
                            <button id="declare-cc" disabled="@HasDraft" aria-describedby="@(HasDraft ? "cc-draft-note" : null)" @onclick="FinishFirst">Declare @(Attacks.Count == 0 ? "no attacks" : "attacks") and hand over</button>
                        }
                        else if (!reviewing)
                        {
                            <button id="cc-review" disabled="@HasDraft" aria-describedby="@(HasDraft ? "cc-draft-note" : null)" @onclick="Review">Declare @(Attacks.Count == 0 ? "no attacks" : "attacks") and review</button>
                        }
                        else
                        {
                            <button id="propose-cc" @onclick="ProposeReviewed">Propose: resolve CC@(Attacks.Count + OtherAttacks.Count == 0 ? " with no attacks" : "")</button>
                            <button type="button" class="link" id="cc-edit-declarations" @onclick="@(() => reviewing = false)">Edit declarations</button>
                        }
                    </ActionProposalArea>
                }
                @if (CanClear)
                {
                    <button type="button" class="link" id="cc-clear-all" @onclick="ClearAll">Clear all declarations</button>
                }
            }
        }
    }
</div>
}
</ActionSection>

@code {
    [CascadingParameter(Name = "PickedLocation")] public string? Picked { get; set; }
    [CascadingParameter(Name = "Picking")] public LocationPicking? Picking { get; set; }
    [Parameter] public EventCallback OnClearAttack { get; set; }
    [Parameter] public EventCallback<DeclaredAttack> OnEditAttack { get; set; }
    [Parameter] public IReadOnlyList<string> OtherChoices { get; set; } = [];
    [Parameter] public string? SecondSide { get; set; }
    private bool reviewing;
    private string? pendingLocation;
    private string? mapNote;
    private string? lastPicked;
    private long seenPick = -1;
    private (string Location, string Round, string Step, bool OtherDeclared) reviewContext;
    private bool HasDraft => Attackers.Count > 0 || Defenders.Count > 0 || Capture || Director.Length > 0 || Guard.Length > 0 || Yield.Length > 0;
    private bool HasDeclarations => HasDraft || Attacks.Count > 0 || OtherDeclared || Withdrawals.Count > 0 || Infiltrations.Count > 0 || Dropped.Count > 0 || HandToHand || Round.Length > 0;

    protected override async Task OnParametersSetAsync()
    {
        var current = (Location, Round, Step, OtherDeclared);
        if (reviewContext != current || HasDraft) reviewing = false;
        reviewContext = current;
        var serial = Picking?.Serial ?? 0;
        var fresh = serial != seenPick || Picked != lastPicked;
        (seenPick, lastPicked) = (serial, Picked);
        if (!fresh || Picked is null || Picking?.Armed is not null || Picking?.PickedBy is not null) return;
        var matches = Locations.Where(at => BoardLocation.TryParse(Picked, out var picked) && BoardLocation.TryParse(at, out var location)
            && picked.Board == location.Board && picked.Hex == location.Hex).ToArray();
        mapNote = matches.Length > 1 ? "Several locations share this hex. Choose the level from Location." : null;
        if (matches.Length <= 1) await RequestLocation(matches.FirstOrDefault() ?? string.Empty);
    }

    private async Task RequestLocation(string at)
    {
        if (at == Location) return;
        if (HasDeclarations) { pendingLocation = at; return; }
        reviewing = false;
        await OnLocation.InvokeAsync(at);
    }

    private async Task ConfirmLocation()
    {
        var at = pendingLocation;
        pendingLocation = null;
        if (at is null) return;
        await ClearAll();
        await OnLocation.InvokeAsync(at);
    }

    private async Task ClearAll() { reviewing = false; await OnClearAll.InvokeAsync(); }
    private Task FinishFirst() => !HasDraft && Step == DeclareStep ? OnDeclare.InvokeAsync() : Task.CompletedTask;
    private void Review() { if (!HasDraft && Step == ResolveStep) reviewing = true; }
    private Task ProposeReviewed() => reviewing && !HasDraft && Step == ResolveStep ? OnPropose.InvokeAsync() : Task.CompletedTask;

    public static IEnumerable<string> ChoiceNotes(IReadOnlyDictionary<string, string> stacking, IReadOnlyDictionary<string, string> withdrawals,
        IReadOnlyDictionary<string, string> infiltrations, IEnumerable<string> dropped, bool handToHand, string round)
    {
        foreach (var (unit, with) in stacking) yield return $"{unit} stacked with {with}.";
        foreach (var (unit, to) in withdrawals) yield return $"{unit} withdraws to {to}.";
        foreach (var (unit, to) in infiltrations) yield return $"{unit} infiltrates to {to} if triggered.";
        foreach (var weapon in dropped) yield return $"Drop {weapon} on withdrawal or infiltration.";
        if (handToHand) yield return "Hand-to-Hand.";
        if (round.Length > 0) yield return $"Round: {round}.";
    }

    /// <summary>The page's words for the view (pass 31c, design D11): a unit's name for its id, a Location in words.</summary>
    [CascadingParameter(Name = "Say")]
    public Func<string, string>? Words { get; set; }

    private string Say(string? text) => text is null ? string.Empty : Words?.Invoke(text) ?? text;

    /// <summary>A CC attack declared on the page, not yet proposed, with its capture attempt, the defender's order of choice, and the Guard (A20.22).</summary>
    public sealed record DeclaredAttack(string[] Attackers, string[] Defenders, string? Director, bool Capture = false, string[]? YieldOrder = null, string? Guard = null)
    {
        public string[] Yield => YieldOrder ?? [];
    }

    /// <summary>What the planner says is due in CC this phase.</summary>
    [Parameter]
    public IReadOnlyList<string> Due { get; set; } = [];

    /// <summary>The Locations where CC can occur, as the view finds them.</summary>
    [Parameter, EditorRequired]
    public IReadOnlyList<string> Locations { get; set; } = [];

    [Parameter]
    public string Location { get; set; } = string.Empty;

    /// <summary>The chosen Location's CC record this phase: its Ambush and rounds, or none yet.</summary>
    [Parameter]
    public CloseCombatLocation? Entry { get; set; }

    /// <summary>The round chosen: the ambushed side's (empty), another attack by the ambusher, or the prisoners' escape round.</summary>
    [Parameter]
    public string Round { get; set; } = string.Empty;

    [Parameter]
    public bool AmbushDue { get; set; }

    /// <summary>Whether the Hand-to-Hand SSR is in force.</summary>
    [Parameter]
    public bool HandToHandAllowed { get; set; }

    [Parameter]
    public bool HandToHand { get; set; }

    /// <summary>The ambusher's withdrawals the view may propose now, or none to hide them.</summary>
    [Parameter]
    public IReadOnlyList<AmbushWithdrawalActions.Withdrawal>? AmbushWithdrawals { get; set; }

    [Parameter] public RenderFragment? AmbushEquipment { get; set; }

    [Parameter]
    public IReadOnlyList<CloseCombatStacking.Smc> Smcs { get; set; } = [];

    [Parameter]
    public IReadOnlyDictionary<string, string> Stacking { get; set; } = new Dictionary<string, string>();

    [Parameter]
    public IReadOnlyList<CloseCombatWithdrawals.Withdrawer> Withdrawers { get; set; } = [];

    [Parameter]
    public IReadOnlyDictionary<string, string> Withdrawals { get; set; } = new Dictionary<string, string>();

    [Parameter]
    public IReadOnlyList<CloseCombatAttackBuilder.DeclaringSide> Sides { get; set; } = [];

    [Parameter]
    public IReadOnlySet<string> Attackers { get; set; } = new HashSet<string>();

    [Parameter]
    public IReadOnlySet<string> Defenders { get; set; } = new HashSet<string>();

    [Parameter]
    public IReadOnlyList<string> Directors { get; set; } = [];

    [Parameter]
    public string Director { get; set; } = string.Empty;

    [Parameter]
    public bool Capture { get; set; }

    [Parameter]
    public string Guard { get; set; } = string.Empty;

    [Parameter]
    public string Yield { get; set; } = string.Empty;

    /// <summary>The units that may declare an infiltration, or none when the Location cannot be read.</summary>
    [Parameter]
    public IReadOnlyList<CloseCombatInfiltrationChoices.Infiltrator>? Infiltrators { get; set; }

    [Parameter]
    public IReadOnlyDictionary<string, string> Infiltrations { get; set; } = new Dictionary<string, string>();

    [Parameter]
    public IReadOnlyList<DeclaredAttack> Attacks { get; set; } = [];

    [Parameter]
    public EventCallback<string> OnLocation { get; set; }

    [Parameter]
    public EventCallback<string?> OnRound { get; set; }

    [Parameter]
    public EventCallback<bool> OnHandToHand { get; set; }

    [Parameter]
    public EventCallback OnProposeAmbush { get; set; }

    [Parameter]
    public EventCallback<(IReadOnlyList<string> Units, string To)> OnAmbushWithdraw { get; set; }

    [Parameter]
    public EventCallback<CloseCombatStacking.Choice> OnStacking { get; set; }

    [Parameter]
    public EventCallback<CloseCombatWithdrawals.Choice> OnWithdrawal { get; set; }

    /// <summary>The SW the view's units above their IPC drop to withdraw or infiltrate (A11.21; pass 70, ruling R70.26).</summary>
    [Parameter]
    public IReadOnlySet<string> Dropped { get; set; } = new HashSet<string>();

    [Parameter]
    public EventCallback<UnitSelectionList.Toggle> OnDrop { get; set; }

    [Parameter]
    public EventCallback<UnitSelectionList.Toggle> OnAttacker { get; set; }

    [Parameter]
    public EventCallback<UnitSelectionList.Toggle> OnDefender { get; set; }

    [Parameter]
    public EventCallback<string> OnDirector { get; set; }

    [Parameter]
    public EventCallback<bool> OnCapture { get; set; }

    [Parameter]
    public EventCallback<string> OnGuard { get; set; }

    [Parameter]
    public EventCallback<string> OnYield { get; set; }

    [Parameter]
    public EventCallback OnAddAttack { get; set; }

    [Parameter]
    public EventCallback<CloseCombatInfiltrationChoices.Choice> OnInfiltration { get; set; }

    [Parameter]
    public EventCallback<DeclaredAttack> OnRemoveAttack { get; set; }

    /// <summary>Pass 31 (ruling R31.6): whether the view may take a declared attack back: its own side's, or any for the adjudicator.</summary>
    [Parameter]
    public Func<DeclaredAttack, bool> MayRemove { get; set; } = _ => true;

    [Parameter]
    public EventCallback OnPropose { get; set; }

    /// <summary>The view resolves the round (one view declares every side's attacks, or the other side has declared).</summary>
    public const string ResolveStep = "resolve";

    /// <summary>The view declares first in a simultaneous round, and hands the screen over (A11.11).</summary>
    public const string DeclareStep = "declare";

    /// <summary>The view declares second, and waits for the first side's declarations (A11.11).</summary>
    public const string WaitStep = "wait";

    /// <summary>What the view does with its declarations (the user, 2026-10-22).</summary>
    [Parameter]
    public string Step { get; set; } = ResolveStep;

    /// <summary>The side that declares first, named while the view waits for it or reads its declarations.</summary>
    [Parameter]
    public string? FirstSide { get; set; }

    /// <summary>The first side's declared attacks, which the second side's view reads before it declares its own; empty when none.</summary>
    [Parameter]
    public IReadOnlyList<DeclaredAttack> OtherAttacks { get; set; } = [];

    /// <summary>Whether the first side has declared, so its attacks (perhaps none) are read here.</summary>
    [Parameter]
    public bool OtherDeclared { get; set; }

    [Parameter]
    public EventCallback OnDeclare { get; set; }

    /// <summary>Whether there is anything to clear: a declaration kept for this round, or this view's own declared attacks.</summary>
    [Parameter]
    public bool CanClear { get; set; }

    /// <summary>The escape hatch (the user, 2026-10-22): drops every declaration of the round, kept or drafted, so it starts over.</summary>
    [Parameter]
    public EventCallback OnClearAll { get; set; }

    private string AttackText(DeclaredAttack attack) => $"{Say(string.Join(", ", attack.Attackers))} {(attack.Capture ? "attempt to capture" : "attack")} {Say(string.Join(", ", attack.Defenders))}"
        + (attack.Director is { } director ? Say($", directed by {director}") : "") + (attack.Yield.Length > 0 ? Say($" (the defender gives up {string.Join(", then ", attack.Yield)})") : "");
}
