@* Plan A02 (pass 28b): a broken unit's rout in the RtPh. The page gives the obligations already written for the view and the units that may still
   rout (ruling R23.1); the planner decides the route, the Interdictions, and the Failure to Rout. A03 RoutObligations stays inline here: it is one list. *@
<ActionSection Title="Rout" Key="rout">
<RuleHelp Id="rout-help" Summary="Broken units that must rout, or are under DM, rout one at a time, the ATTACKER's first, toward the nearest woods or building; Low Crawl moves one Location and is never Interdicted. One that ends the RtPh ADJACENT to a Known unbroken armed enemy unit, or stays in the Open Ground hex it had to leave, is eliminated or surrenders (A10.5, A10.52, A20.21).">
    In the RtPh the ATTACKER's broken units rout first, one at a time, then the DEFENDER's (A10.5). A broken unit must rout when a Known unbroken
    armed enemy unit is ADJACENT or in its Location, or it is in Open Ground in the LOS and Normal Range of a Known enemy unit; it may rout under DM.
    It has six MF (a wounded SMC three) and must reach the nearest woods or building Location it can this RtPh, never moving closer to a Known armed
    enemy unit that has seen it, nor ADJACENT to one. Entering Open Ground in the LOS of an unbroken enemy unit is Interdicted by a NMC; Low Crawl
    is one Location using all its MF and is never Interdicted (A10.52, A10.53). As the RtPh ends a broken unit ADJACENT to its enemy, or one that did
    not rout from the open, is eliminated, or surrenders to an ADJACENT Good Order enemy (A20.21).
</RuleHelp>
<ul id="rout-obligations">
    @foreach (var item in Obligations)
    {
        <li @key="item.Unit" class="rout-obligation" data-unit="@item.Unit">
            @DisplayText.Sentence(Say(item.Text))
            @* Pass 31d (design D3): a way to each place the rout may end; the button fills the route, which stays the player's to change. *@
            @foreach (var way in item.Routes ?? [])
            {
                <button type="button" class="link use-route" data-unit="@item.Unit" data-route="@way.Route" title="Chooses this unit and fills its route; you may still change it."
                        @onclick="@(() => OnUseRoute.InvokeAsync((item.Unit, way.Route)))">Use the route to @Say(way.Target)</button>
            }
        </li>
    }
</ul>
<div class="toolbar">
    <label>
        Broken unit
        <select id="rout-unit" value="@Unit" @onchange="@(args => OnUnit.InvokeAsync(args.Value as string ?? string.Empty))">
            <option value="">choose</option>
            @foreach (var unit in Units)
            {
                <option value="@unit.Id">@At(unit.Label)</option>
            }
        </select>
    </label>
    @* Pass 31d (design D2; A10.4): what a laden unit leaves and keeps, said only for a unit that carries more than its IPC. *@
    @if (Load is { Length: > 0 })
    {
        <span id="rout-load" class="toolbar-note">@DisplayText.Sentence(Say(Load))</span>
        @if (Loads.Count > 1)
        {
            <label>
                It keeps
                <select id="rout-keep" value="@Keep" @onchange="@(args => OnKeep.InvokeAsync(args.Value as string ?? string.Empty))">
                    @foreach (var load in Loads)
                    {
                        <option value="@load.Id">@Say(load.Label)</option>
                    }
                </select>
            </label>
        }
    }
    <LocationField Id="rout-route" Label="Route (hexes in order)" Name="the rout route" Many="true" Placeholder="E6, E7" Size="24" Value="@Route" OnChange="@OnRoute" />
    <label><input id="rout-low-crawl" type="checkbox" checked="@LowCrawl" @onchange="@(args => OnLowCrawl.InvokeAsync(args.Value is true))" /> Low Crawl</label>
    <button id="propose-rout" disabled="@(!Units.Any(unit => unit.Id == Unit) || Route.Trim().Length == 0)" aria-describedby="propose-rout-ready" @onclick="@(() => OnPropose.InvokeAsync())">Propose: rout</button>
    @if (!Units.Any(unit => unit.Id == Unit) || Route.Trim().Length == 0)
    {
        <span id="propose-rout-ready" class="toolbar-note">Choose the unit that routs and give its route.</span>
    }
</div>
</ActionSection>

@code {
    /// <summary>The page's words for the view (pass 31c, design D11): a unit's name for its id, a Location in words.</summary>
    [CascadingParameter(Name = "Say")]
    public Func<string, string>? Words { get; set; }

    private string Say(string? text) => text is null ? string.Empty : Words?.Invoke(text) ?? text;

    /// <summary>A unit's name with its hex, "4-6-7 squad G4 in [G4]" (the user, 2026-10-04), where no Location stands beside the name.</summary>
    [CascadingParameter(Name = "SayAt")]
    public Func<string, string>? WordsAt { get; set; }

    private string At(string? text) => text is null ? string.Empty : WordsAt?.Invoke(text) ?? Say(text);

    /// <summary>A broken unit that may rout and what it owes, such as "r1 (russian): must rout: ...; has routed", with a way to each place it may end.</summary>
    public sealed record Obligation(string Unit, string Text, IReadOnlyList<Way>? Routes = null);

    /// <summary>One least-cost route to a place a rout may end (pass 31d, design D3): the place, and the route as its Locations in order.</summary>
    public sealed record Way(string Target, string Route);

    /// <summary>What the chosen unit leaves and keeps before it routs (A10.4); null or empty for a unit that carries no more than its IPC.</summary>
    [Parameter]
    public string? Load { get; set; }

    /// <summary>The loads the unit may keep, when it has a choice among loads of equal PP.</summary>
    [Parameter]
    public IReadOnlyList<PlayChoice> Loads { get; set; } = [];

    [Parameter]
    public string Keep { get; set; } = string.Empty;

    [Parameter]
    public EventCallback<string> OnKeep { get; set; }

    [Parameter]
    public EventCallback<(string Unit, string Route)> OnUseRoute { get; set; }

    [Parameter, EditorRequired]
    public IReadOnlyList<Obligation> Obligations { get; set; } = [];

    /// <summary>The broken units that may still rout this RtPh.</summary>
    [Parameter, EditorRequired]
    public IReadOnlyList<PlayChoice> Units { get; set; } = [];

    [Parameter]
    public string Unit { get; set; } = string.Empty;

    [Parameter]
    public string Route { get; set; } = string.Empty;

    [Parameter]
    public bool LowCrawl { get; set; }

    [Parameter]
    public EventCallback<string> OnUnit { get; set; }

    [Parameter]
    public EventCallback<string> OnRoute { get; set; }

    [Parameter]
    public EventCallback<bool> OnLowCrawl { get; set; }

    [Parameter]
    public EventCallback OnPropose { get; set; }
}
