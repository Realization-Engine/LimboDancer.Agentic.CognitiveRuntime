@* R01 (plan sections 13.4, 16.13): the review of a proposal. It shows only what the parent has already disclosed for the view: the outcome, the reasons,
   and the evidence; the parent keeps the attempt, the revision, the withholding, and the execution. *@
<div id="play-proposal">
    <h3 title="@Title">@DisplayText.Action(Title)</h3>
    @* Pass 31c (design D15; play test P-28): Confirm and Cancel sit at the head of the review, where no outcome or list of consequences moves
       them. Their label still says what a proposal with consequences does. *@
    @{
        RenderFragment actions = @<div class="toolbar" id="play-proposal-actions">
            <button id="play-confirm" disabled="@Busy" @onclick="Confirm">@(Busy ? "Confirming" : ConfirmLabel)</button>
            <button id="play-cancel" class="link" disabled="@Busy" @onclick="Cancel">Cancel</button>
        </div>;
    }
    @if (CanConfirm && Consequences.Count == 0)
    {
        @actions
    }
    <p class="@(Accepted && Consequences.Count == 0 ? "pass" : "fail")">
        <strong id="play-outcome">@Outcome</strong>
    </p>
    @* Pass 31 (play test P-06, P-12, P-13): what the proposal does beyond its checks comes before Confirm, apart from the routine reasons. *@
    @if (Consequences.Count > 0)
    {
        <div id="play-consequences" class="diagnostic warning" role="alert">
            <strong>Read this before you confirm.</strong>
            <ul>
                @foreach (var line in Consequences)
                {
                    <li>@DisplayText.Sentence(Say(line))</li>
                }
            </ul>
        </div>
        @if (CanConfirm)
        {
            @actions
        }
    }
    @Lead
    <ul id="play-reasons">
        @foreach (var reason in Reasons)
        {
            @* Pass 31c (play test P-18): a reason reads without its code, which stays in data-code and the title. *@
            var spoken = DisplayText.Reason(reason);
            <li data-code="@spoken.Code" title="@spoken.Code">@DisplayText.Sentence(Say(spoken.Text))</li>
        }
    </ul>
    @Evidence
</div>

@code {
    /// <summary>The page's words for the view (pass 31c, design D11): a unit's name for its id, a Location in words.</summary>
    [CascadingParameter(Name = "Say")]
    public Func<string, string>? Words { get; set; }

    private string Say(string? text) => text is null ? string.Empty : Words?.Invoke(text) ?? text;

    [Parameter]
    public string Title { get; set; } = string.Empty;

    /// <summary>Whether the result is one the gate accepted: awaiting confirmation, committed, or replayed.</summary>
    [Parameter]
    public bool Accepted { get; set; }

    [Parameter]
    public string Outcome { get; set; } = string.Empty;

    /// <summary>The reasons the view may read.</summary>
    [Parameter]
    public IReadOnlyList<string> Reasons { get; set; } = [];

    /// <summary>What the proposal does beyond its checks: units lost, the game ended, own units hit, a shot wasted (pass 31).</summary>
    [Parameter]
    public IReadOnlyList<string> Consequences { get; set; } = [];

    /// <summary>The Confirm button's words; they say what a proposal with consequences does.</summary>
    [Parameter]
    public string ConfirmLabel { get; set; } = "Confirm";

    /// <summary>What the proposal does, in the page's words, said before the gate's reasons (pass 30: a setup's review).</summary>
    [Parameter]
    public RenderFragment? Lead { get; set; }

    /// <summary>The disclosed evidence: the entry's or the attack's facts.</summary>
    [Parameter]
    public RenderFragment? Evidence { get; set; }

    [Parameter]
    public bool CanConfirm { get; set; }

    /// <summary>Whether the gate is working on this proposal; Confirm and Cancel wait for it (plan section 13.4; pass 28c).</summary>
    [Parameter]
    public bool Busy { get; set; }

    [Parameter]
    public EventCallback Confirm { get; set; }

    [Parameter]
    public EventCallback Cancel { get; set; }
}
