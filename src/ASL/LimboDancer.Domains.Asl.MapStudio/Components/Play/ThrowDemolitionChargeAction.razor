@* Plan N11 (pass 27): a DC Thrown into an ADJACENT Location (A23.6 to A23.63). The page offers the DCs the firing side's units possess as
   holder and charge pairs, keeps the draft in the "holder|charge" form the select uses, and proposes the throw. *@
<ActionSection Title="Demolition Charges" Key="demolition-charges">
<RuleHelp Id="dc-help" Summary="A DC is Thrown into an ADJACENT Location: 30 FP there with +2, then on the thrower's own Location with +3; a unit marked First Fire throws none (A23.6).">
    A DC is Thrown into an ADJACENT Location at its thrower's level: 30 FP with +2 there, then the thrower's own Location with +3, each on its own DR,
    +1 more in the AFPh unless an Opportunity Firer; a unit marked First Fire throws none, and the DC is removed (A23.6 to A23.63).
</RuleHelp>
<div class="toolbar">
    <label>Throw
        <select id="throw-dc" value="@Charge" @onchange="@(args => OnCharge.InvokeAsync(args.Value as string ?? string.Empty))">
            <option value="">choose</option>
            @foreach (var held in Charges)
            {
                <option value="@held.Value">@held.Charge (@held.Holder)</option>
            }
        </select>
    </label>
    <LocationField Id="throw-dc-at" Label="into" Name="the Location the DC is thrown into" Value="@At" OnChange="@OnAt" />
    @* Pass 60 (ruling R60.16): the DC may name an enemy AFV the side sees there (A23.5). *@
    @if (Vehicles.Count > 0)
    {
        <label title="A23.5, C7.346: a DC named against the AFV makes a Position DR, then a To Kill DR on the C7.34 DC column.">At the AFV
            <select id="throw-dc-vehicle" value="@Vehicle" @onchange="@(args => OnVehicle.InvokeAsync(args.Value as string ?? string.Empty))">
                <option value="">none: the Location</option>
                @foreach (var vehicle in Vehicles)
                {
                    <option value="@vehicle.Id">@vehicle.Label</option>
                }
            </select>
        </label>
    }
    <button id="propose-throw-dc" disabled="@(Charge.Length == 0 || At.Trim().Length == 0)" @onclick="@(() => OnPropose.InvokeAsync())">Propose: Throw the DC</button>
</div>
</ActionSection>

@code {
    /// <summary>A DC and the unit that possesses it.</summary>
    public sealed record HeldCharge(string Holder, string Charge)
    {
        /// <summary>The pair as the select carries it: "holder|charge".</summary>
        public string Value => $"{Holder}|{Charge}";
    }

    [Parameter, EditorRequired]
    public IReadOnlyList<HeldCharge> Charges { get; set; } = [];

    /// <summary>The chosen pair as "holder|charge", or empty.</summary>
    [Parameter]
    public string Charge { get; set; } = string.Empty;

    /// <summary>The Location typed as the target.</summary>
    [Parameter]
    public string At { get; set; } = string.Empty;

    [Parameter]
    public EventCallback<string> OnCharge { get; set; }

    [Parameter]
    public EventCallback<string> OnAt { get; set; }

    /// <summary>The enemy AFVs the side sees in the Location typed (pass 60, ruling R60.16).</summary>
    [Parameter]
    public IReadOnlyList<PlayChoice> Vehicles { get; set; } = [];

    /// <summary>The AFV the DC names, or empty.</summary>
    [Parameter]
    public string Vehicle { get; set; } = string.Empty;

    [Parameter]
    public EventCallback<string> OnVehicle { get; set; }

    [Parameter]
    public EventCallback OnPropose { get; set; }
}
