@page "/fidelity"
@using LimboDancer.Domains.Asl.Maps
@using LimboDancer.Domains.Asl.Maps.Vasl
@using LimboDancer.Domains.Asl.MapStudio.Components.Fidelity
@implements IDisposable
@inject FidelityJobRunner Runner
@inject FidelityReportStore Store
@inject StudioLos Los
@inject IBoardProvider Boards

<PageTitle>Fidelity - ASL Map Studio</PageTitle>

<PageHeader Title="Fidelity batch" />
@if (!Runner.IsAvailable)
{
    <SourceRequiredNotice Missing="No board source is configured.">No batch can run; saved reports are still listed below.</SourceRequiredNotice>
}
else
{
    <FidelityRunControls State="@Runner.State" Progress="@Runner.Progress" Error="@Runner.Error" @bind-IncludeF3="includeF3"
                         OnStart="@(() => Runner.Start(includeF3))" OnCancel="@Runner.Cancel" />
    <p class="muted">
        A run reads every VASL board and checks it: its terrain data is read exactly (F1), its hex facts match VASL's own answers (F2), its terrain
        outlines are lossless, and its Exact and Hex facts drawings are drawn as vectors. The Styled drawing check (F3) traces the board into the
        shapes the Styled view draws and compares them back; it is informational and never changes a board's outcome. Reports are saved under
        <code>@Store.Directory</code>.
    </p>
}

<LosFidelityPanel Fixtures="@losFixtures.Count" Available="@Runner.IsAvailable" Running="@losRunning" Progress="@losProgress" Results="@losResults" OnRun="@CheckLos" />

<h3>Batch reports</h3>
<FidelityReportPicker Reports="@reports" Selected="@selectedId" SelectedChanged="@Select" />

@if (report is not null)
{
    var summary = report.Summary;
    @if (FidelityJobRunner.StaleReason(report, Boards.CatalogBlob) is { } stale)
    {
        @* The UX analysis (2026-10-02): a report made with older tools says so, since the library no longer uses its results. *@
        <p id="fidelity-stale" class="diagnostic warning">This report is out of date: @stale. The board library does not use its results; run the batch again.</p>
    }
    <BoardScopeSummary Id="fidelity-totals" InScope="@(summary.Boards - summary.OutOfScope)" Verified="@summary.Verified" Ingested="@summary.Ingested"
                       Failed="@summary.Failed" OutOfScope="@summary.OutOfScope" />
    <FidelityReportMetadata Report="@report" />
    <FidelityResultsTable Boards="@report.Boards" @bind-Filter="filter" />
}

@code {
    private IReadOnlyList<StoredReport> reports = [];
    private string? selectedId;
    private FidelityReport? report;
    private string filter = "in-scope";
    private bool includeF3;
    private IReadOnlyList<string> losFixtures = [];

    protected override void OnInitialized()
    {
        Runner.Changed += OnRunnerChanged;
        losFixtures = [.. Los.Fixtures()];
        Reload();
    }

    private void Reload()
    {
        reports = Store.List();
        if (Runner.Latest is { } latest)
        {
            (selectedId, report) = (latest.Id, latest.Report);
        }
        else
        {
            selectedId = reports.FirstOrDefault()?.Id;
            report = selectedId is null ? null : Store.TryLoad(selectedId);
        }

        filter = DefaultFilter(report);
    }

    private readonly List<LosFidelityResult> losResults = [];
    private bool losRunning;
    private string losProgress = string.Empty;

    /// <summary>Compares the LOS read with every LOS oracle fixture (LOS Design, section 8), one fixture at a time.</summary>
    private async Task CheckLos()
    {
        losRunning = true;
        losResults.Clear();
        foreach (var fixture in losFixtures)
        {
            losProgress = Path.GetFileName(fixture);
            StateHasChanged();
            if (await Task.Run(() => Los.Compare(fixture)) is { } result)
            {
                losResults.Add(result);
            }
        }

        losRunning = false;
    }

    // The UX analysis: a report with boards not verified opens on them, so a failure is found at once.
    private static string DefaultFilter(FidelityReport? shown) =>
        shown?.Boards.Any(board => board.Outcome is BatchOutcome.Ingested or BatchOutcome.Failed) == true ? "problems" : "in-scope";

    private void Select(string? id)
    {
        selectedId = id;
        report = selectedId is null ? null : Store.TryLoad(selectedId);
        filter = DefaultFilter(report);
    }

    private void OnRunnerChanged() => _ = InvokeAsync(() =>
    {
        if (Runner.State != FidelityJobState.Running)
        {
            Reload();
        }

        StateHasChanged();
    });

    public void Dispose() => Runner.Changed -= OnRunnerChanged;
}
