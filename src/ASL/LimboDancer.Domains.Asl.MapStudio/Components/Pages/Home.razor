@page "/"
@implements IAsyncDisposable
@inject IBoardProvider Boards
@inject FidelityJobRunner Runner
@inject AuthoredBoardService Authored
@inject MapService MapStore
@inject LibraryViewState View
@inject IJSRuntime JS

<PageTitle>Board library - ASL Map Studio</PageTitle>

<PageHeader Title="Board library" />

@if (Boards.SourceDescription is null)
{
    <SourceRequiredNotice Missing="No board source is configured.">
        <ChildContent>Set <code>AslMaps:VaslRoot</code> to a local VASL repository checkout, for example:</ChildContent>
        <Instructions>
    <ul>
        <li>user secrets (Development): <code>dotnet user-secrets set AslMaps:VaslRoot E:/path/to/vasl</code> in the MapStudio project directory;</li>
        <li>an environment variable: <code>AslMaps__VaslRoot</code>;</li>
        <li>a command-line argument: <code>--AslMaps:VaslRoot=E:/path/to/vasl</code>.</li>
    </ul>
        </Instructions>
    </SourceRequiredNotice>
}
else if (loading)
{
    <p id="library-loading" class="muted" role="status">Loading the board library...</p>
}
else if (failure is not null)
{
    <p id="library-failure" class="diagnostic error" role="alert">The board library could not be read: @failure</p>
}
else
{
    var filter = View.Filter;
    var shownAuthored = filter.Shows("authored") ? authored.Where(entry => filter.Matches(entry.Name, entry.Ref.Value)).ToArray() : [];
    var shownMaps = filter.Shows("maps") ? maps.Where(map => filter.Matches(map.Name, map.Ref.Value)).ToArray() : [];
    var shownRows = filter.Shows("vasl") ? rows.Where(row => Visible(row, filter)).ToArray() : [];
    var shown = shownAuthored.Length + shownMaps.Length + shownRows.Length;

    <LibraryFilterBar Value="@filter" ValueChanged="@(value => View.Filter = value)" Shown="@shown"
                      Total="@(authored.Count + maps.Count + rows.Count(row => filter.OutOfScope || row.Status != VaslBoardTable.LibraryStatus.OutOfScope))" OutOfScopeCount="@rows.Count(row => row.Status == VaslBoardTable.LibraryStatus.OutOfScope)" />

    @if (shown == 0 && !filter.IsDefault)
    {
        <p id="library-no-match" class="muted">Nothing matches the search and filters. <button class="link" @onclick="@(() => View.Filter = LibraryFilterBar.Filter.Default)">Clear filters</button></p>
    }
    else
    {
        @if (filter.Shows("authored"))
        {
            <h3>Authored boards</h3>
            <AuthoredBoardList Boards="@shownAuthored" Filtered="@(!filter.IsDefault)" />
        }

        @if (filter.Shows("maps"))
        {
            <h3>Maps</h3>
            <MapSummaryList Id="library-maps" Maps="@shownMaps">
                <EmptyContent>
                    <p id="library-maps-empty" class="muted">@(filter.IsDefault ? "None yet." : "No map matches.") <a href="maps">Compose a map</a> of placed, reversed, or rule-modified VASL boards.</p>
                </EmptyContent>
            </MapSummaryList>
            @if (shownMaps.Length > 0)
            {
                <p><a href="maps">Compose a map</a></p>
            }
        }

        @if (filter.Shows("vasl"))
        {
            var inScope = rows.Where(row => row.Status != VaslBoardTable.LibraryStatus.OutOfScope).ToArray();
            <h3>VASL boards</h3>
            <p class="muted">@Boards.SourceDescription.</p>
            <BoardScopeSummary Id="library-totals" InScope="@inScope.Length"
                               Verified="@inScope.Count(row => row.Status == VaslBoardTable.LibraryStatus.Verified)"
                               Ingested="@inScope.Count(row => row.Status == VaslBoardTable.LibraryStatus.Ingested)"
                               Failed="@inScope.Count(row => row.Status == VaslBoardTable.LibraryStatus.Failed)"
                               NotChecked="@inScope.Count(row => row.Status == VaslBoardTable.LibraryStatus.NotChecked)"
                               OutOfScope="@(rows.Count - inScope.Length)" />
            <p class="toolbar">
                @if (Runner.Latest is { } latest)
                {
                    var made = latest.Report.StartedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm", System.Globalization.CultureInfo.InvariantCulture);
                    @if (FidelityJobRunner.StaleReason(latest.Report, Boards.CatalogBlob) is { } stale)
                    {
                        <span class="muted" id="library-report-stale">The fidelity report of @made is not used: @stale, so unopened boards show "Not checked".</span>
                    }
                    else
                    {
                        <span class="muted">Unopened boards show results from the fidelity report of @made when their sources and tools are unchanged.</span>
                    }
                }
                <a href="fidelity">Run the fidelity batch</a>
            </p>
            @if (rows.Count == 0)
            {
                <p id="library-vasl-empty" class="muted">The VASL checkout lists no boards.</p>
            }
            else if (shownRows.Length == 0)
            {
                <p id="library-vasl-no-match" class="muted">No VASL board matches.</p>
            }
            else
            {
                <VaslBoardTable Rows="@shownRows" />
            }
        }
    }
}

@code {
    private IReadOnlyList<AuthoredListing> authored = [];
    private IReadOnlyList<MapDefinition> maps = [];
    private IReadOnlyList<VaslBoardTable.Row> rows = [];
    private bool loading = true;
    private string? failure;
    private IJSObjectReference? scroll;
    private bool disposed;

    protected override async Task OnInitializedAsync()
    {
        if (Boards.SourceDescription is null)
        {
            loading = false;
            return;
        }

        try
        {
            // Read once here, not on each render: the listing, and each board's result from the cache or the latest fresh batch report.
            var listing = await Task.Run(Boards.List);
            authored = await Task.Run(Authored.List);
            maps = await Task.Run(MapStore.List);
            rows = await Task.Run(() => listing.Select(entry => VaslBoardTable.Row.Of(entry, Boards, Runner)).ToArray());
        }
        catch (Exception exception) when (exception is IOException or UnauthorizedAccessException or InvalidOperationException or System.Text.Json.JsonException)
        {
            failure = exception.Message;
        }
        finally
        {
            loading = false;
        }
    }

    private static bool Visible(VaslBoardTable.Row row, LibraryFilterBar.Filter filter) =>
        (filter.OutOfScope || row.Status != VaslBoardTable.LibraryStatus.OutOfScope)
        && (filter.Status == LibraryFilterBar.Filter.AnyStatus || string.Equals(row.Status.ToString(), filter.Status, StringComparison.OrdinalIgnoreCase))
        && filter.Matches(row.Title, row.Ref);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (loading || scroll is not null || Boards.SourceDescription is null)
        {
            return;
        }

        try
        {
            scroll = await JS.InvokeAsync<IJSObjectReference>("import", "./js/scrollMemory.js");
            await scroll.InvokeVoidAsync(disposed ? "forget" : "restore", "library");
        }
        catch (JSDisconnectedException)
        {
        }
    }

    public async ValueTask DisposeAsync()
    {
        disposed = true;
        try
        {
            if (scroll is not null)
            {
                await scroll.InvokeVoidAsync("forget", "library");
                await scroll.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
        }
    }
}
