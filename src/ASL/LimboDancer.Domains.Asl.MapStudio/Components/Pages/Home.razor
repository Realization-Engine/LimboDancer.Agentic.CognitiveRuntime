@page "/"
@implements IDisposable
@inject IBoardProvider Boards

<PageTitle>Board library - ASL Map Studio</PageTitle>

@if (Boards.SourceDescription is null)
{
    <p>No board source is configured. Set <code>AslMaps:VaslRoot</code> to a local VASL repository checkout, for example:</p>
    <ul>
        <li>user secrets (Development): <code>dotnet user-secrets set AslMaps:VaslRoot E:/path/to/vasl</code> in the MapStudio project directory;</li>
        <li>an environment variable: <code>AslMaps__VaslRoot</code>;</li>
        <li>a command-line argument: <code>--AslMaps:VaslRoot=E:/path/to/vasl</code>.</li>
    </ul>
}
else
{
    <p class="muted">@Boards.SourceDescription. @listing.Count boards.</p>
    <p>
        <button @onclick="CheckAll" disabled="@checking">Check all boards</button>
        @if (checking)
        {
            <span class="muted"> Checked @checkedCount of @listing.Count.</span>
        }
    </p>
    <table class="library">
        <thead>
            <tr>
                <th>Board</th>
                <th>Status</th>
                <th>F1 (grid)</th>
                <th>F2 (hex facts)</th>
                <th>Diagnostics</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var entry in listing)
            {
                var result = Boards.Cached(entry.Ref);
                <tr>
                    <td><a href="@($"boards/{entry.Ref.Value}")">@entry.Title</a></td>
                    @if (result is null)
                    {
                        <td class="muted" colspan="4">Not loaded</td>
                    }
                    else if (result.OutOfScope)
                    {
                        <td class="muted">Out of scope</td>
                        <td></td>
                        <td></td>
                        <td>@Describe(result.Diagnostics)</td>
                    }
                    else if (result.Board is not { } board)
                    {
                        <td class="fail">Failed</td>
                        <td></td>
                        <td></td>
                        <td>@Describe(result.Diagnostics)</td>
                    }
                    else
                    {
                        <td class="@(board.Status == BoardStatus.Verified ? "pass" : "")">@board.Status</td>
                        <td class="@(board.F1.Passed ? "pass" : "fail")">@board.F1.Status</td>
                        <td class="@F2Class(board)">@F2Text(board)</td>
                        <td>@Describe(board.Diagnostics)</td>
                    }
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private readonly CancellationTokenSource stopping = new();
    private IReadOnlyList<BoardListing> listing = [];
    private bool checking;
    private int checkedCount;

    protected override void OnInitialized() => listing = Boards.List();

    private async Task CheckAll()
    {
        checking = true;
        checkedCount = 0;
        foreach (var entry in listing)
        {
            if (stopping.IsCancellationRequested)
            {
                return;
            }

            await Task.Run(() => Boards.Load(entry.Ref));
            checkedCount++;
            StateHasChanged();
        }

        checking = false;
    }

    private static string F2Text(StudioBoard board) => board.F2 switch
    {
        null => "No oracle fixture",
        { Passed: true } => "Pass",
        var f2 => $"Fail ({f2.Differences.Count} differences, {f2.Diagnostics.Count} diagnostics)",
    };

    private static string F2Class(StudioBoard board) => board.F2 switch
    {
        null => "muted",
        { Passed: true } => "pass",
        _ => "fail",
    };

    private static string Describe(IReadOnlyList<LimboDancer.Domains.Asl.Maps.MapDiagnostic> diagnostics) =>
        string.Join("; ", diagnostics.Select(diagnostic => diagnostic.Code));

    public void Dispose()
    {
        stopping.Cancel();
        stopping.Dispose();
    }
}
