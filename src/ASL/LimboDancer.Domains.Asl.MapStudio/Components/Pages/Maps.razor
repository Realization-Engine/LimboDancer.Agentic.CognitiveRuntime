@page "/maps"
@using LimboDancer.Domains.Asl.Maps.Vasl
@inject IBoardProvider Boards
@inject IVaslMapSource Source
@inject MapService MapStore
@inject NavigationManager Navigation

<PageTitle>Maps - ASL Map Studio</PageTitle>

<h2 class="page">Maps</h2>
<p class="muted">
    A map places VASL boards in slots, up to three across, optionally reversed, with LOS scenario-specific rules, and is
    built as VASL's runtime builds it: half-hex seams merge with non-open terrain winning, and each board's rules run in
    VASL's two phases. Overlays are not available, because VASL derives their terrain from overlay artwork.
</p>

@if (Source.Terrain() is not { } terrain)
{
    <p>Maps need the terrain catalog and boards from a configured VASL checkout. See <a href="settings">Settings</a>.</p>
}
else
{
    @if (saved.Count > 0)
    {
        <table class="library">
            <thead>
                <tr><th>Map</th><th>Boards</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var map in saved)
                {
                    <tr>
                        <td><a href="@($"boards/{map.Ref.Value}")">@map.Name</a></td>
                        <td><code>@map.PlacementText</code></td>
                        <td>
                            <button class="link" @onclick="() => Edit(map)">Edit</button>
                            <button class="link danger" @onclick="() => Delete(map)">Delete</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <h3>@(editing is null ? "New map" : $"Edit {editing.Value}")</h3>
    <div class="form-grid wide">
        <label for="map-name">Name</label>
        <input id="map-name" value="@name" @oninput="@(args => name = args.Value as string ?? string.Empty)" />
    </div>

    <table class="library placements">
        <thead>
            <tr><th>Board</th><th>Column</th><th>Row</th><th>Reversed</th><th></th></tr>
        </thead>
        <tbody>
            @foreach (var row in rows)
            {
                <tr>
                    <td>
                        <select aria-label="Board" value="@row.Board" @onchange="@(args => { row.Board = args.Value as string ?? row.Board; Changed(); })">
                            @foreach (var entry in boards)
                            {
                                <option value="@entry.Ref.VaslBoardName">@entry.Ref.Value</option>
                            }
                        </select>
                    </td>
                    <td><input aria-label="Column" type="number" min="0" max="@(VaslMapBuilder.MaxBoardsPerRow - 1)" value="@row.Column" @onchange="@(args => { row.Column = Number(args, row.Column); Changed(); })" /></td>
                    <td><input aria-label="Row" type="number" min="0" max="5" value="@row.Row" @onchange="@(args => { row.Row = Number(args, row.Row); Changed(); })" /></td>
                    <td><input aria-label="Reversed" type="checkbox" checked="@row.Reversed" @onchange="@(args => { row.Reversed = args.Value is true; Changed(); })" /></td>
                    <td><button class="link" @onclick="() => Remove(row)">Remove</button></td>
                </tr>
            }
        </tbody>
    </table>
    <p><button @onclick="Add">Add a board</button></p>

    <h3>Scenario-specific rules</h3>
    <p class="muted">Applied to every board in this order, as VASL's board picker does. LOS-neutral rules (such as NoRoads) are listed but change no terrain.</p>
    @if (rules.Count > 0)
    {
        <ol class="rules">
            @foreach (var rule in rules)
            {
                <li>
                    <code>@rule</code> <span class="muted">@KindOf(terrain.Rules, rule)</span>
                    <button class="link" @onclick="() => RemoveRule(rule)">Remove</button>
                </li>
            }
        </ol>
    }
    <p>
        <select aria-label="Rule" value="@nextRule" @onchange="@(args => nextRule = args.Value as string)">
            @foreach (var rule in terrain.Rules.Rules.Where(rule => !rules.Contains(rule.Name)))
            {
                <option value="@rule.Name">@rule.Name (@Describe(rule))</option>
            }
        </select>
        <button @onclick="AddRule">Add rule</button>
    </p>

    <h3>Compact form</h3>
    <p class="muted">One placement per board: <code>board@column,row</code>, <code>/r</code> for reversed, and <code>[Rule,...]</code>.</p>
    <textarea class="placements-text" aria-label="Placements" rows="2" value="@text" @onchange="@(args => text = args.Value as string ?? string.Empty)"></textarea>
    <p><button @onclick="UseText">Use this text</button></p>

    <p>
        <button @onclick="Check" disabled="@working">Check</button>
        <button @onclick="Save" disabled="@working">Save and view</button>
        @if (working)
        {
            <span class="muted">Building the map...</span>
        }
        else if (message is not null)
        {
            <span class="@(failed ? "fail" : "pass")">@message</span>
        }
    </p>
    @foreach (var diagnostic in diagnostics)
    {
        <p class="@(diagnostic.Severity == MapDiagnosticSeverity.Error ? "fail" : "muted")">@diagnostic.Code @diagnostic.Message</p>
    }
}

@code {
    private sealed class PlacementRow
    {
        public string Board { get; set; } = "01";

        public int Column { get; set; }

        public int Row { get; set; }

        public bool Reversed { get; set; }

        public List<string> Rules { get; set; } = [];
    }

    private IReadOnlyList<MapDefinition> saved = [];
    private IReadOnlyList<BoardListing> boards = [];
    private List<PlacementRow> rows = [];
    private List<string> rules = [];
    private string name = "Untitled map";
    private string text = string.Empty;
    private string? nextRule;
    private BoardRef? editing;
    private bool working;
    private bool failed;
    private string? message;
    private IReadOnlyList<MapDiagnostic> diagnostics = [];

    [SupplyParameterFromQuery(Name = "placements")]
    public string? Placements { get; set; }

    [SupplyParameterFromQuery(Name = "edit")]
    public string? EditRef { get; set; }

    protected override void OnInitialized()
    {
        boards = Boards.List().Where(entry => entry.Ref.Kind == BoardRefKind.Vasl && entry.Scope == BoardScope.InScope).ToArray();
        saved = MapStore.List();
        if (EditRef is not null && BoardRef.TryParse(EditRef, out var map) && MapStore.Find(map) is { } definition)
        {
            Edit(definition);
        }
        else if (Placements is not null && VaslScenario.ParsePlacements(Placements) is { Count: > 0 } placements)
        {
            Load(placements);
        }
        else
        {
            Load([new BoardPlacement(boards.FirstOrDefault()?.Ref ?? BoardRef.Parse("bd01"))]);
        }

        nextRule = Source.Terrain()?.Rules.Rules.FirstOrDefault()?.Name;
    }

    private void Edit(MapDefinition map)
    {
        editing = map.Ref;
        name = map.Name;
        Load(map.Placements);
    }

    private void Delete(MapDefinition map)
    {
        MapStore.Delete(map.Ref);
        saved = MapStore.List();
        if (editing == map.Ref)
        {
            editing = null;
        }
    }

    private void Load(IReadOnlyList<BoardPlacement> placements)
    {
        rows = placements.Select(placement => new PlacementRow
        {
            Board = placement.Board.VaslBoardName,
            Column = placement.Column,
            Row = placement.Row,
            Reversed = placement.Reversed,
            Rules = [.. placement.Rules],
        }).ToList();
        rules = rows.Count > 0 ? [.. rows[0].Rules] : [];
        Changed(keepRules: true);
    }

    private void Add()
    {
        var used = rows.Select(row => (row.Column, row.Row)).ToHashSet();
        var slot = Enumerable.Range(0, 6).SelectMany(row => Enumerable.Range(0, VaslMapBuilder.MaxBoardsPerRow).Select(column => (column, row)))
            .FirstOrDefault(candidate => !used.Contains(candidate));
        rows.Add(new PlacementRow { Board = rows.LastOrDefault()?.Board ?? "01", Column = slot.column, Row = slot.row, Rules = [.. rules] });
        Changed();
    }

    private void Remove(PlacementRow row)
    {
        rows.Remove(row);
        Changed();
    }

    private void AddRule()
    {
        if (nextRule is not null && !rules.Contains(nextRule))
        {
            rules.Add(nextRule);
            nextRule = Source.Terrain()?.Rules.Rules.FirstOrDefault(rule => !rules.Contains(rule.Name))?.Name;
            Changed();
        }
    }

    private void RemoveRule(string rule)
    {
        rules.Remove(rule);
        Changed();
    }

    // Keeps the compact form in step with the rows; the rule list applies to every board.
    private void Changed(bool keepRules = false)
    {
        if (!keepRules)
        {
            foreach (var row in rows)
            {
                row.Rules = [.. rules];
            }
        }

        text = string.Join(' ', PlacementsFromRows());
        message = null;
        diagnostics = [];
    }

    private void UseText()
    {
        if (VaslScenario.ParsePlacements(text) is { Count: > 0 } placements)
        {
            Load(placements);
        }
        else
        {
            failed = true;
            message = "The text is not a list of placements.";
        }
    }

    private List<BoardPlacement> PlacementsFromRows() =>
        rows.Where(row => BoardRef.TryParse("bd" + row.Board, out _))
            .Select(row => new BoardPlacement(BoardRef.Parse("bd" + row.Board), row.Column, row.Row, row.Reversed, [.. row.Rules]))
            .ToList();

    private async Task Check()
    {
        working = true;
        var placements = PlacementsFromRows();
        var outcome = await Task.Run(() => MapStore.Check(placements));
        working = false;
        diagnostics = outcome.Diagnostics;
        failed = outcome.Diagnostics.Any(diagnostic => diagnostic.Severity == MapDiagnosticSeverity.Error);
        message = failed ? "VASL cannot build this map." : "VASL builds this map.";
    }

    private async Task Save()
    {
        working = true;
        var placements = PlacementsFromRows();
        var outcome = await Task.Run(() => MapStore.Save(name, placements));
        working = false;
        diagnostics = outcome.Diagnostics;
        if (outcome.Ref is { } map)
        {
            if (editing is { } previous && previous != map)
            {
                MapStore.Delete(previous);
            }

            Navigation.NavigateTo($"boards/{map.Value}");
            return;
        }

        failed = true;
        message = "The map was not saved.";
    }

    private static int Number(ChangeEventArgs args, int fallback) => int.TryParse(args.Value as string, out var value) && value >= 0 ? value : fallback;

    private static string KindOf(LosSsRuleSet set, string rule) => set.TryGet(rule, out var found) ? Describe(found) : "not a VASL rule; ignored";

    private static string Describe(LosSsRule rule) => rule.Kind switch
    {
        LosSsRuleKind.Ignore => "no LOS effect",
        LosSsRuleKind.CustomCode => "VASL code",
        LosSsRuleKind.TerrainMap => $"{rule.FromValue} to {rule.ToValue}",
        LosSsRuleKind.ElevationMap => $"level {rule.FromValue} to {rule.ToValue}",
        LosSsRuleKind.TerrainToElevationMap => $"{rule.FromValue} to open ground at level {rule.ToValue}",
        LosSsRuleKind.ElevationToTerrainMap => $"level {rule.FromValue} to {rule.ToValue} at level 0",
        LosSsRuleKind.TerrainToSelectElevationMap => $"{rule.FromValue} at level {rule.ToValue} to open ground",
        _ => rule.Kind.ToString(),
    };
}
