@page "/maps"
@using LimboDancer.Domains.Asl.Maps.Vasl
@using LimboDancer.Domains.Asl.MapStudio.Components.Maps
@inject IBoardProvider Boards
@inject IVaslMapSource Source
@inject MapService MapStore
@inject NavigationManager Navigation

<PageTitle>Maps - ASL Map Studio</PageTitle>

<PageHeader Title="Maps">
    <p>
        A map places VASL boards in slots, up to three across, optionally reversed, with LOS scenario-specific rules, and is
        built as VASL's runtime builds it: half-hex seams merge with non-open terrain winning, and each board's rules run in
        VASL's two phases. Overlays are not available, because VASL derives their terrain from overlay artwork.
    </p>
</PageHeader>

@if (Source.Terrain() is not { } terrain)
{
    <SourceRequiredNotice Missing="No VASL checkout is configured.">Maps need its terrain catalog and boards.</SourceRequiredNotice>
}
else
{
    <MapSummaryList Id="map-saved" Maps="@saved" OnEdit="@Edit" OnDelete="@Delete" />

    <h3>@(editing is null ? "New map" : $"Edit {editing.Value}")</h3>
    <div class="form-grid wide">
        <label for="map-name">Name</label>
        <input id="map-name" value="@name" @oninput="@(args => name = args.Value as string ?? string.Empty)" />
    </div>

    <MapPlacementEditor Rows="@rows" Boards="@boards" RowChanged="@RowChanged" RowRemoved="@Remove" OnAdd="@Add" />
    <ScenarioRuleEditor Rules="@rules" Catalog="@terrain.Rules" OnAdd="@AddRule" OnRemove="@RemoveRule" OnMove="@MoveRule" />
    <PlacementTextEditor @bind-Text="text" OnApply="@UseText" Problem="@textProblem" />
    <MapBuildActions Busy="@working" Message="@message" Failed="@failed" Stale="@stale" Diagnostics="@diagnostics" OnCheck="@Check" OnSave="@Save" />
}

@code {
    private IReadOnlyList<MapDefinition> saved = [];
    private IReadOnlyList<BoardListing> boards = [];
    private List<MapPlacementEditor.PlacementDraft> rows = [];
    private List<string> rules = [];
    private int nextId;
    // Counts the maps loaded, so a check or save still running when another map is opened does not report on it.
    private int loaded;
    private string name = "Untitled map";
    private string text = string.Empty;
    private string? textProblem;
    private BoardRef? editing;
    private bool working;
    private bool failed;
    private bool stale;
    private string? message;
    private IReadOnlyList<MapDiagnostic> diagnostics = [];

    [SupplyParameterFromQuery(Name = "placements")]
    public string? Placements { get; set; }

    [SupplyParameterFromQuery(Name = "edit")]
    public string? EditRef { get; set; }

    protected override void OnInitialized()
    {
        boards = Boards.List().Where(entry => entry.Ref.Kind == BoardRefKind.Vasl && entry.Scope == BoardScope.InScope).ToArray();
        saved = MapStore.List();
        if (EditRef is not null && BoardRef.TryParse(EditRef, out var map) && MapStore.Find(map) is { } definition)
        {
            Edit(definition);
        }
        else if (Placements is not null && VaslScenario.ParsePlacements(Placements) is { Count: > 0 } placements)
        {
            Load(placements);
        }
        else
        {
            Load([new BoardPlacement(boards.FirstOrDefault()?.Ref ?? BoardRef.Parse("bd01"))]);
        }
    }

    private void Edit(MapDefinition map)
    {
        editing = map.Ref;
        name = map.Name;
        Load(map.Placements);
    }

    private void Delete(MapDefinition map)
    {
        MapStore.Delete(map.Ref);
        saved = MapStore.List();
        if (editing == map.Ref)
        {
            editing = null;
        }
    }

    // A map's rules apply to every board (VASL's board picker), so the first placement's rules, in their order, are the map's.
    private void Load(IReadOnlyList<BoardPlacement> placements)
    {
        rows = [.. placements.Select(placement => new MapPlacementEditor.PlacementDraft(++nextId, placement.Board.VaslBoardName, placement.Column, placement.Row, placement.Reversed))];
        rules = placements.Count > 0 ? [.. placements[0].Rules.Distinct(StringComparer.Ordinal)] : [];
        (message, diagnostics, failed) = (null, [], false);
        loaded++;
        Changed();
    }

    private void RowChanged(MapPlacementEditor.PlacementDraft row)
    {
        var index = rows.FindIndex(existing => existing.Id == row.Id);
        if (index >= 0)
        {
            rows[index] = row;
            Changed();
        }
    }

    private void Add()
    {
        var used = rows.Select(row => (row.Column, row.Row)).ToHashSet();
        var slot = Enumerable.Range(0, 6).SelectMany(row => Enumerable.Range(0, VaslMapBuilder.MaxBoardsPerRow).Select(column => (column, row)))
            .FirstOrDefault(candidate => !used.Contains(candidate));
        rows.Add(new MapPlacementEditor.PlacementDraft(++nextId, rows.LastOrDefault()?.Board ?? "01", slot.column, slot.row, false));
        Changed();
    }

    private void Remove(MapPlacementEditor.PlacementDraft row)
    {
        rows.RemoveAll(existing => existing.Id == row.Id);
        Changed();
    }

    private void AddRule(string rule)
    {
        if (!rules.Contains(rule))
        {
            rules.Add(rule);
            Changed();
        }
    }

    private void RemoveRule(string rule)
    {
        rules.Remove(rule);
        Changed();
    }

    // A rule moved up or down the order it applies in (table player, pass 22c).
    private void MoveRule((string Rule, int By) move)
    {
        var index = rules.IndexOf(move.Rule);
        var target = index + move.By;
        if (index >= 0 && target >= 0 && target < rules.Count)
        {
            (rules[index], rules[target]) = (rules[target], rules[index]);
            Changed();
        }
    }

    // Keeps the compact form in step with the rows and marks the last check's result out of date (plan section 12.2).
    private void Changed()
    {
        text = string.Join(' ', PlacementsFromRows());
        textProblem = null;
        stale = message is not null;
    }

    private void UseText()
    {
        if (VaslScenario.ParsePlacements(text) is { Count: > 0 } placements)
        {
            Load(placements);
        }
        else
        {
            textProblem = "The text is not a list of placements.";
        }
    }

    private List<BoardPlacement> PlacementsFromRows() =>
        rows.Where(row => BoardRef.TryParse("bd" + row.Board, out _))
            .Select(row => new BoardPlacement(BoardRef.Parse("bd" + row.Board), row.Column, row.Row, row.Reversed, [.. rules]))
            .ToList();

    private async Task Check()
    {
        working = true;
        var placements = PlacementsFromRows();
        var map = loaded;
        var outcome = await Task.Run(() => MapStore.Check(placements));
        working = false;
        if (map != loaded)
        {
            return;
        }

        stale = false;
        diagnostics = outcome.Diagnostics;
        failed = outcome.Diagnostics.Any(diagnostic => diagnostic.Severity == MapDiagnosticSeverity.Error);
        message = failed ? "VASL cannot build this map." : "VASL builds this map.";
    }

    private async Task Save()
    {
        working = true;
        var placements = PlacementsFromRows();
        var outcome = await Task.Run(() => MapStore.Save(name, placements));
        working = false;
        stale = false;
        diagnostics = outcome.Diagnostics;
        if (outcome.Ref is { } map)
        {
            if (editing is { } previous && previous != map)
            {
                MapStore.Delete(previous);
            }

            Navigation.NavigateTo($"boards/{map.Value}");
            return;
        }

        failed = true;
        message = "The map was not saved.";
    }
}
