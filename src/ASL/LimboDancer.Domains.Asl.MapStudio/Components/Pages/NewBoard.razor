@page "/author/new"
@using LimboDancer.Domains.Asl.MapStudio.Components.Maps
@inject AuthoredBoardService Authored
@inject VaslBoardProvider Vasl
@inject NavigationManager Navigation

<PageTitle>New board - ASL Map Studio</PageTitle>

<PageHeader Title="New board" />
@if (Authored.Catalog is null)
{
    <SourceRequiredNotice Missing="No VASL checkout is configured.">Authoring needs its terrain catalog, so every authored board stays exportable to VASL (Model Design section 4.2).</SourceRequiredNotice>
}
else
{
    <NewBoardForm @bind-Draft="draft" Sources="@sources" Busy="@working" Problem="@problem" OnCreate="@Create" />
}

@code {
    private NewBoardForm.NewBoardDraft draft = new("Untitled board", "untitled-board", "blank", 33, 10, null);
    private IReadOnlyList<BoardListing> sources = [];
    private bool working;
    private string? problem;

    protected override void OnInitialized()
    {
        sources = Vasl.List().Where(entry => entry.Scope == LimboDancer.Domains.Asl.Maps.Vasl.BoardScope.InScope).ToArray();
        draft = draft with { Source = sources.FirstOrDefault()?.Ref.Value };
    }

    /// <summary>A lowercase slug of letters, digits, and single hyphens (the form's; kept here for the map service).</summary>
    public static string Slug(string text) => NewBoardForm.Slug(text);

    private async Task Create()
    {
        problem = null;
        if (!BoardRef.TryParse("ab-" + draft.Slug, out var board))
        {
            problem = "Use lowercase letters, digits, and hyphens for the reference.";
            return;
        }

        if (Authored.Exists(board))
        {
            problem = $"{board} already exists.";
            return;
        }

        var (catalog, hash) = Authored.Catalog!.Value;
        working = true;
        StateHasChanged();
        try
        {
            FeatureModel? model;
            if (draft.Start == "blank")
            {
                model = FeatureModel.New(BoardGeometry.Standard(Math.Clamp(draft.Width, 2, 60), Math.Clamp(draft.Height, 1, 40)), hash);
            }
            else
            {
                model = await Task.Run(() => FromVasl(catalog));
                if (model is null)
                {
                    problem = $"{draft.Source} could not be ingested.";
                    return;
                }
            }

            var isDraft = draft.Start == "vasl";
            var package = new BoardPackage(board, string.IsNullOrWhiteSpace(draft.Name) ? board.Value : draft.Name.Trim(), model);
            await Task.Run(() => Authored.Save(package, isDraft));
            Navigation.NavigateTo($"author/{board.Value}");
        }
        finally
        {
            working = false;
        }
    }

    private FeatureModel? FromVasl(TerrainCatalog catalog)
    {
        if (draft.Source is not { } source || !BoardRef.TryParse(source, out var sourceRef) || Vasl.Ingest(sourceRef) is not { } ingested)
        {
            return null;
        }

        var facts = LimboDancer.Domains.Asl.Maps.Vasl.HexFactFidelity.Derive(ingested, catalog);
        return VaslBoardProvider.Vectorize(ingested, facts, catalog).Model;
    }
}
