@page "/boards/{BoardName}"
@using System.Globalization
@implements IAsyncDisposable
@inject IBoardProvider Boards
@inject IJSRuntime JS

<PageTitle>@(board?.Title ?? BoardName) - ASL Map Studio</PageTitle>

@if (loadError is not null)
{
    <p class="fail">@loadError</p>
}
else if (board is null)
{
    <p class="muted">Loading @BoardName...</p>
}

<div class="viewer" hidden="@(board is null)">
    <div class="stage">
        @if (board is not null)
        {
            <div class="toolbar">
                <strong>@board.Title</strong>
                <span class="@(board.Status is BoardStatus.Verified or BoardStatus.AuthoredValid ? "pass" : board.Status == BoardStatus.Authored ? "fail" : "")">@board.Status</span>
                @if (board.IsAuthored)
                {
                    <a href="@($"author/{board.Ref.Value}")">Edit</a>
                }
                <label>
                    View
                    <select value="@BoardRenderer.ViewName(view)" @onchange="ChangeView">
                        <option value="exact">Exact</option>
                        @if (board.HasStyled)
                        {
                            <option value="styled">Styled</option>
                        }
                        <option value="hexfacts">Hex facts</option>
                        @if (board.HasStyled)
                        {
                            <option value="comparison">Comparison</option>
                        }
                    </select>
                </label>
                @if (board.Ref.Kind == BoardRefKind.Vasl)
                {
                    <a href="@($"maps?placements={Uri.EscapeDataString(board.Ref.VaslBoardName + "@0,0")}")">Compose a map</a>
                }
                else if (board.Composition is not null)
                {
                    <a href="@($"maps?edit={board.Ref.Value}")">Edit map</a>
                }
                @if (view == BoardView.Comparison)
                {
                    <label>
                        Show
                        <select value="@comparisonMode" @onchange="ChangeComparison">
                            <option value="overlay">overlay</option>
                            <option value="swipe">swipe</option>
                            <option value="side">side by side</option>
                        </select>
                    </label>
                    @if (comparisonMode != "side")
                    {
                        <input type="range" min="0" max="100" value="@comparisonValue" aria-label="@(comparisonMode == "swipe" ? "Divider position" : "Styled opacity")"
                               @oninput="ChangeComparisonValue" />
                    }
                }
                @foreach (var layer in ToggleLayers)
                {
                    <label>
                        <input type="checkbox" checked="@visible.Contains(layer)" @onchange="@(args => ToggleLayer(layer, (bool)args.Value!))" />
                        @layer
                    </label>
                }
                @if (view == BoardView.HexFacts)
                {
                    <label>
                        <input type="checkbox" checked="@trace" @onchange="ToggleTrace" />
                        derivation trace
                    </label>
                }
                @if (demoOverlay is not null)
                {
                    <label><input type="checkbox" checked="@showDemoUnits" @onchange="ToggleDemoUnits" /> Demo units</label>
                }
                <button @onclick="ResetView">Fit</button>
                @if (preparing is not null)
                {
                    <span class="muted">@preparing</span>
                }
            </div>
        }
        <div class="board-host" @ref="host"></div>
        <p class="muted hint">Drag to pan, wheel or + and - to zoom, 0 to fit. Hover a hex to inspect it; click to keep it.</p>
    </div>
    <aside class="inspector">
        @if (selectedUnit is { } unit)
        {
            <h2>Demo unit @unit.Placement.Label</h2>
            <dl>
                <dt>ID</dt><dd>@unit.Placement.PlacementId</dd>
                <dt>Side</dt><dd>@unit.Placement.SideId</dd>
                <dt>Face</dt><dd>@unit.Placement.FaceKey</dd>
                <dt>Location</dt><dd>@unit.Location</dd>
            </dl>
            @if (demoOverlay is { } overlay)
            {
                <p class="muted">Illustrative placement from @overlay.FixtureId.</p>
            }
        }
        @if (demoOverlay is { } demo)
        {
            @foreach (var diagnostic in demo.Diagnostics)
            {
                <p class="fail">Demo units: @diagnostic</p>
            }
            @if (selected is { } selectedHex)
            {
                @if (demo.Units.Any(u => u.Location.Hex == selectedHex.Hex))
                {
                    <h3>Demo units in @selectedHex.Hex (@demo.Units.Count(u => u.Location.Hex == selectedHex.Hex))</h3>
                    @foreach (var member in demo.Units.Where(u => u.Location.Hex == selectedHex.Hex))
                    {
                        <button @onclick="() => SelectUnit(member)">@member.Placement.Label (@member.Location.Level)</button>
                    }
                }
            }
        }
        @if (board is not null && (selected ?? hovered) is { } facts)
        {
            @if (selected is null)
            {
                <p class="muted">Hovering. Click to keep this hex.</p>
            }
            <HexInspector Board="board.Ref" Facts="facts" Grid="board.Render.Grid" Catalog="board.Catalog" LocationText="@board.LocationOf(facts)"
                          Model="StyledModel" Validation="board.Validation" OnCopy="CopyLocation" />
        }
        else
        {
            <p class="muted">Hover or click a hex to inspect its derived facts and the grid samples behind them.</p>
        }

        @if (sample is not null)
        {
            <h3>Pixel under the pointer</h3>
            <p>@sample</p>
        }

        @if (board is not null)
        {
            <h3>Provenance</h3>
            <dl>
                <dt>Version</dt>
                <dd><code>@board.Version[..12]</code></dd>
                @if (board.Composition is { } composition)
                {
                    <dt>Boards</dt>
                    <dd><code>@string.Join(" ", composition.Placements)</code></dd>
                    <dt>Size</dt>
                    <dd>@composition.Map.Geometry.WidthInHexes by @composition.Map.Geometry.HeightInHexes hexes</dd>
                    <dt>F2</dt>
                    <dd class="@(board.F2 is { Passed: true } ? "pass" : board.F2 is null ? "muted" : "fail")">
                        @(board.F2 is null ? "no oracle scenario" : board.F2.Passed ? "Pass" : $"{board.F2.Differences.Count} differences")
                    </dd>
                }
                @if (board.Provenance is { } provenance)
                {
                    <dt>VASL commit</dt>
                    <dd><code>@(provenance.VaslCommit?[..12] ?? "unknown")</code></dd>
                    <dt>LOSData</dt>
                    <dd>@provenance.LosData.RepositoryPath</dd>
                }
                @if (board.F1 is { } f1)
                {
                    <dt>F1</dt>
                    <dd class="@(f1.Passed ? "pass" : "fail")">@f1.Status</dd>
                    <dt>F2</dt>
                    <dd class="@(board.F2 is { Passed: true } ? "pass" : board.F2 is null ? "muted" : "fail")">
                        @(board.F2 is null ? "no oracle fixture" : board.F2.Passed ? "Pass" : $"{board.F2.Differences.Count} differences")
                    </dd>
                }
                @if (board.Validation is { } validation)
                {
                    <dt>Validation</dt>
                    <dd>@validation.Summary.Errors errors, @validation.Summary.Warnings warnings</dd>
                }
                @if (StyledModel is { } model)
                {
                    <dt>Styled model</dt>
                    <dd>@model.Features.Count features (@model.Provenance.Kind)</dd>
                }
                <dt>Derivation</dt>
                <dd>@board.Facts.DerivationVersion</dd>
                <dt>Renderer</dt>
                <dd>@BoardRenderer.RendererVersion, theme @RenderTheme.Board.Name @RenderTheme.Board.Version</dd>
            </dl>
        }
    </aside>
</div>

@code {
    private ElementReference host;
    private IJSObjectReference? module;
    private IJSObjectReference? viewport;
    private DotNetObjectReference<BoardViewer>? self;
    private StudioBoard? board;
    private string? loadError;
    private string? preparing;
    private BoardView view = BoardView.Exact;
    private bool trace;
    private HashSet<string> visible = [];
    private HexFacts? selected;
    private HexFacts? hovered;
    private DisplayedUnit? selectedUnit;
    private DemoUnitOverlay? demoOverlay;
    private bool showDemoUnits;
    private string? sample;
    private bool viewportPending;
    private string comparisonMode = "overlay";
    private int comparisonValue = 50;

    [Parameter]
    public string BoardName { get; set; } = string.Empty;

    private IEnumerable<string> ToggleLayers => BoardRenderer.Layers(view).Where(layer => layer != "defs" && !layer.StartsWith("styled-", StringComparison.Ordinal));

    /// <summary>The Feature Model behind the Styled views, once it exists.</summary>
    private FeatureModel? StyledModel =>
        board?.Render.Styled?.Model ?? (board?.StyledRender is { IsValueCreated: true } styled ? styled.Value.Styled?.Model : null);

    protected override async Task OnParametersSetAsync()
    {
        board = null;
        loadError = null;
        selected = null;
        hovered = null;
        selectedUnit = null;
        demoOverlay = null;
        showDemoUnits = false;
        sample = null;
        if (!BoardRef.TryParse(BoardName, out var boardRef))
        {
            loadError = $"{BoardName} is not a board reference.";
            return;
        }

        var result = await Task.Run(() => Boards.Load(boardRef));
        if (result.Board is null)
        {
            loadError = $"{BoardName} could not be loaded: " + string.Join("; ", result.Diagnostics.Select(d => d.Code + " " + d.Message));
            return;
        }

        board = result.Board;
        if (board.IsAuthored)
        {
            view = BoardView.Styled;
        }
        else if (!board.HasStyled && view is BoardView.Styled or BoardView.Comparison)
        {
            view = BoardView.Exact;
        }

        demoOverlay = DemoUnitOverlayBuilder.Load(board);
        showDemoUnits = demoOverlay is not null;
        visible = [.. BoardRenderer.Layers(view).Where(layer => layer != "defs")];
        viewportPending = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (viewportPending && board is not null)
        {
            viewportPending = false;
            if (viewport is null)
            {
                module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/boardViewport.js");
                self = DotNetObjectReference.Create(this);
                viewport = await module.InvokeAsync<IJSObjectReference>("create", host, self);
            }

            await LoadView();
        }
    }

    private async Task LoadView()
    {
        if (viewport is null || board is null)
        {
            return;
        }

        // A VASL board's Styled input is its vectorization, computed once on first use.
        if (view is BoardView.Styled or BoardView.Comparison && board.Render.Styled is null && board.StyledRender is { IsValueCreated: false } styled)
        {
            preparing = "Vectorizing the board for the Styled view...";
            StateHasChanged();
            await Task.Run(() => styled.Value);
            preparing = null;
        }

        var input = board.InputFor(view) ?? board.Render;
        var baseUrl = $"render/{board.Ref.Value}/{board.Version}/{BoardRenderer.ViewName(view)}";
        await viewport.InvokeVoidAsync("load", baseUrl, trace ? "?trace=true" : "", BoardRenderer.ViewBox(input, view),
            BoardRenderer.Layers(view), visible.ToArray());
        await viewport.InvokeVoidAsync("setComparison", view == BoardView.Comparison ? comparisonMode : "none", comparisonValue / 100.0);
        await viewport.InvokeVoidAsync("setUnits", showDemoUnits ? demoOverlay?.Svg : null);
        await Highlight();
        StateHasChanged();
    }

    private async Task ToggleDemoUnits(ChangeEventArgs args)
    {
        showDemoUnits = args.Value is true;
        if (!showDemoUnits)
        {
            selectedUnit = null;
        }
        if (viewport is not null)
        {
            await viewport.InvokeVoidAsync("setUnits", showDemoUnits ? demoOverlay?.Svg : null);
        }
    }

    private async Task ChangeView(ChangeEventArgs args)
    {
        if (BoardRenderer.TryParseView(args.Value as string, out var next) && next != view)
        {
            view = next;
            visible = [.. BoardRenderer.Layers(view).Where(layer => layer != "defs")];
            await LoadView();
        }
    }

    private async Task ChangeComparison(ChangeEventArgs args)
    {
        comparisonMode = args.Value as string ?? "overlay";
        if (viewport is not null)
        {
            await viewport.InvokeVoidAsync("setComparison", comparisonMode, comparisonValue / 100.0);
        }
    }

    private async Task ChangeComparisonValue(ChangeEventArgs args)
    {
        if (int.TryParse(args.Value as string, out var value) && viewport is not null)
        {
            comparisonValue = value;
            await viewport.InvokeVoidAsync("setComparison", comparisonMode, comparisonValue / 100.0);
        }
    }

    private async Task ToggleLayer(string layer, bool on)
    {
        if (on)
        {
            visible.Add(layer);
        }
        else
        {
            visible.Remove(layer);
        }

        if (viewport is not null)
        {
            await viewport.InvokeVoidAsync("setVisible", visible.ToArray());
        }
    }

    private async Task ToggleTrace(ChangeEventArgs args)
    {
        trace = (bool)args.Value!;
        await LoadView();
    }

    private async Task ResetView()
    {
        if (viewport is not null)
        {
            await viewport.InvokeVoidAsync("reset");
        }
    }

    private async Task CopyLocation(string location)
    {
        if (viewport is not null)
        {
            await viewport.InvokeVoidAsync("copyText", location);
        }
    }

    [JSInvokable]
    public async Task OnBoardClick(double x, double y)
    {
        if (board is null)
        {
            return;
        }

        var grid = board.Render.Grid;
        var cellX = (int)Math.Floor(x);
        var cellY = (int)Math.Floor(y);
        sample = grid.TryGetCode(cellX, cellY, out var code)
            ? $"Pixel ({cellX}, {cellY}): code {code} {(board.Catalog.TryGet(code, out var type) ? type.Name : "-")}, elevation {grid.ElevationAt(cellX, cellY)}"
            : $"Pixel ({cellX}, {cellY}) is off the grid.";
        selected = grid.Geometry.HexAt(x, y) is { } hex ? board.Facts[hex] : null;
        selectedUnit = null;
        await Highlight();
        StateHasChanged();
    }

    /// <summary>Hover updates the inspector only when the pointer crosses into another hex.</summary>
    [JSInvokable]
    public Task OnBoardHover(double x, double y)
    {
        if (board is null || selected is not null)
        {
            return Task.CompletedTask;
        }

        var next = board.Render.Grid.Geometry.HexAt(x, y) is { } hex ? board.Facts[hex] : null;
        if (next?.Index != hovered?.Index)
        {
            hovered = next;
            StateHasChanged();
        }

        return Task.CompletedTask;
    }

    [JSInvokable]
    public Task OnBoardKey(string key)
    {
        if (key == "Escape" && selected is not null)
        {
            selected = null;
            StateHasChanged();
            return Highlight();
        }

        return Task.CompletedTask;
    }

    [JSInvokable]
    public Task OnBoardGesture(double[][] points) => Task.CompletedTask;

    [JSInvokable]
    public Task OnBoardDrag(double x0, double y0, double x1, double y1) => Task.CompletedTask;

    [JSInvokable]
    public async Task OnUnitClick(string placementId)
    {
        if (!showDemoUnits || board is null || demoOverlay is null)
        {
            return;
        }

        var unit = demoOverlay.Units.FirstOrDefault(item => item.Placement.PlacementId == placementId);
        if (unit is not null)
        {
            selectedUnit = unit;
            selected = board.Facts[board.Render.Grid.Geometry.IndexOf(unit.Location.Hex)];
            await Highlight();
            StateHasChanged();
        }
    }

    private void SelectUnit(DisplayedUnit unit) => selectedUnit = unit;

    private async Task Highlight()
    {
        if (viewport is null || board is null)
        {
            return;
        }

        var points = selected is null
            ? null
            : string.Join(" ", board.Render.Grid.Geometry.Vertices(selected.Index)
                .Select(vertex => string.Create(CultureInfo.InvariantCulture, $"{vertex.X},{vertex.Y}")));
        await viewport.InvokeVoidAsync("highlight", points);
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (viewport is not null)
            {
                await viewport.InvokeVoidAsync("dispose");
                await viewport.DisposeAsync();
            }

            if (module is not null)
            {
                await module.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
            // The circuit is gone; the browser already discarded the viewport.
        }

        self?.Dispose();
    }
}
