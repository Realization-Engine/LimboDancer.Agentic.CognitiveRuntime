@page "/boards/{BoardName}"
@using System.Globalization
@using LimboDancer.Domains.Asl.Units.State
@implements IAsyncDisposable
@inject IBoardProvider Boards
@inject UnitLibrary UnitLibrary
@inject GameLibrary Games
@inject StudioLos Los
@inject IJSRuntime JS

<PageTitle>@(board?.Title ?? BoardName) - ASL Map Studio</PageTitle>

@if (loadError is not null)
{
    <p class="fail">@loadError</p>
}
else if (board is null)
{
    <p class="muted">Loading @BoardName...</p>
}

<div class="viewer" hidden="@(board is null)">
    <div class="stage">
        @if (board is not null)
        {
            <div class="toolbar">
                <strong>@board.Title</strong>
                <span class="@(board.Status is BoardStatus.Verified or BoardStatus.AuthoredValid ? "pass" : board.Status == BoardStatus.Authored ? "fail" : "")">@board.Status</span>
                @if (board.IsAuthored)
                {
                    <a href="@($"author/{board.Ref.Value}")">Edit</a>
                }
                <label>
                    View
                    <select value="@BoardRenderer.ViewName(view)" @onchange="ChangeView">
                        <option value="exact">Exact</option>
                        @if (board.HasStyled)
                        {
                            <option value="styled">Styled</option>
                        }
                        <option value="hexfacts">Hex facts</option>
                        @if (board.HasStyled)
                        {
                            <option value="comparison">Comparison</option>
                        }
                    </select>
                </label>
                @if (board.Ref.Kind == BoardRefKind.Vasl)
                {
                    <a href="@($"maps?placements={Uri.EscapeDataString(board.Ref.VaslBoardName + "@0,0")}")">Compose a map</a>
                }
                else if (board.Composition is not null)
                {
                    <a href="@($"maps?edit={board.Ref.Value}")">Edit map</a>
                }
                @if (view == BoardView.Comparison)
                {
                    <label>
                        Show
                        <select value="@comparisonMode" @onchange="ChangeComparison">
                            <option value="overlay">overlay</option>
                            <option value="swipe">swipe</option>
                            <option value="side">side by side</option>
                        </select>
                    </label>
                    @if (comparisonMode != "side")
                    {
                        <input type="range" min="0" max="100" value="@comparisonValue" aria-label="@(comparisonMode == "swipe" ? "Divider position" : "Styled opacity")"
                               @oninput="ChangeComparisonValue" />
                    }
                }
                @foreach (var layer in ToggleLayers)
                {
                    <label>
                        <input type="checkbox" checked="@visible.Contains(layer)" @onchange="@(args => ToggleLayer(layer, (bool)args.Value!))" />
                        @layer
                    </label>
                }
                @if (view == BoardView.HexFacts)
                {
                    <label>
                        <input type="checkbox" checked="@trace" @onchange="ToggleTrace" />
                        derivation trace
                    </label>
                }
                @if (unitSets.Count > 0 || unitGames.Count > 0)
                {
                    <label><input type="checkbox" checked="@showUnits" @onchange="ToggleUnits" /> Units</label>
                    @if (showUnits)
                    {
                        <select id="units-source" value="@unitSourceKey" @onchange="ChangeUnitSource" aria-label="Units source">
                            @if (unitGames.Count > 0)
                            {
                                <optgroup label="Games, projected by perspective">
                                    @foreach (var game in unitGames)
                                    {
                                        <option value="@(GamePrefix + game.Name)">@game.Label@(game.Record?.Synthetic == true ? " (synthetic)" : "")</option>
                                    }
                                </optgroup>
                            }
                            @if (unitSets.Count > 0)
                            {
                                <optgroup label="Placement sets">
                                    @foreach (var entry in unitSets)
                                    {
                                        <option value="@(SetPrefix + entry.Set.SetId)">@entry.Set.Label@(entry.Set.Synthetic ? " (synthetic)" : "")</option>
                                    }
                                </optgroup>
                            }
                        </select>
                        @if (gameProjection is { } projection)
                        {
                            <select id="units-perspective" value="@projection.View.Perspective.Name" @onchange="ChangePerspective" aria-label="Perspective">
                                @foreach (var option in projection.Game.History!.States[^1].Perspectives)
                                {
                                    <option value="@option.Name">@option.Name</option>
                                }
                            </select>
                            <button id="units-previous" disabled="@(gameRevision <= 1)" @onclick="() => StepRevision(-1)" aria-label="Previous revision">&lsaquo;</button>
                            <span id="units-revision" class="muted">revision @gameRevision of @projection.Game.History!.States.Count</span>
                            <button id="units-next" disabled="@(gameRevision >= projection.Game.History!.States.Count)" @onclick="() => StepRevision(1)" aria-label="Next revision">&rsaquo;</button>
                        }
                        <select value="@unitSheet" @onchange="ChangeUnitSheet" aria-label="Unit style sheet">
                            @foreach (var name in UnitLibrary.SheetNames())
                            {
                                <option value="@name">@name</option>
                            }
                        </select>
                    }
                }
                <a href="@($"units/lab?board={board.Ref.Value}")">Unit Lab</a>
                <button @onclick="ResetView">Fit</button>
                @if (preparing is not null)
                {
                    <span class="muted">@preparing</span>
                }
            </div>
        }
        <div class="board-host" @ref="host"></div>
        <p class="muted hint">Drag to pan, wheel or + and - to zoom, 0 to fit. Hover a hex to inspect it; click to keep it.</p>
    </div>
    <aside class="inspector">
        @if (selectedUnit is { } unit)
        {
            <h2 class="unit-name">@unit.Name</h2>
            <dl class="unit-details">
                <dt>ID</dt><dd>@unit.Document.Id</dd>
                @foreach (var detail in UnitLabels.Details(unit.Document, UnitLibrary.Vocabulary))
                {
                    <dt>@detail.Label</dt><dd>@detail.Value</dd>
                }
                <dt>Location</dt><dd>@unit.Location</dd>
            </dl>
            @if (gameProjection is { } shownGame)
            {
                var gameView = shownGame.View;
                @if (gameView.Units.FirstOrDefault(item => item.Id == unit.Document.Id) is { } instance)
                {
                    <h3>In the game</h3>
                    <dl class="unit-details" id="unit-game-facts">
                        <dt>Side</dt><dd>@instance.Side</dd>
                        <dt>Conditions</dt><dd>@ConditionsText(instance)</dd>
                        <dt>Good Order</dt><dd>@Conditions.Name(GameState.GoodOrder(instance, UnitLibrary.Vocabulary))</dd>
                        <dt>MF spent this phase</dt><dd>@instance.MfSpent</dd>
                        @if (instance.From.Count > 0)
                        {
                            <dt>Produced from</dt><dd>@string.Join(", ", instance.From)</dd>
                        }
                        @if (instance.Custodian is { } custodian)
                        {
                            <dt>Prisoner of</dt><dd>@custodian</dd>
                        }
                        @if (instance.Position is ContainedPosition contained)
                        {
                            <dt>Inside</dt><dd>@contained.Container (@contained.Role)</dd>
                        }
                    </dl>
                }
                else if (gameView.Sealed.Any(presence => presence.PlacementId == unit.Document.Id))
                {
                    <p id="unit-game-facts">A concealed presence: its identity and conditions are withheld from @gameView.Perspective.Name.</p>
                }
                else if (gameView.Equipment.Cast<IGameObject>().Concat(gameView.Entities).FirstOrDefault(item => item.Id == unit.Document.Id) is { } other)
                {
                    <h3>In the game</h3>
                    <dl class="unit-details" id="unit-game-facts">
                        <dt>Side</dt><dd>@(other.Side ?? "none")</dd>
                        <dt>Conditions</dt><dd>@ConditionsText(other)</dd>
                    </dl>
                }

                <p class="muted">Projection of @shownGame.Game.Label for @gameView.Perspective.Name at revision @gameView.Stamp.Revision; @(shownGame.Game.Record?.Synthetic == false ? "a live game, changed only through the governed path." : "a synthetic game, not a live one.")</p>
            }
            else if (unitOverlay is { } overlay && UnitSet is { } shown)
            {
                <p class="muted">@(shown.Set.Synthetic ? "Synthetic placement" : "Placement") from @shown.Set.Label (@overlay.SetId); display only, not game state.</p>
            }
        }
        @if (showUnits && unitOverlay is { } units)
        {
            @foreach (var diagnostic in units.Diagnostics)
            {
                <p class="fail">Units: @diagnostic</p>
            }
            @if (selected is { } selectedHex && units.At(selectedHex.Index).ToArray() is { Length: > 0 } members)
            {
                <h3>Units in @selectedHex.Hex (@members.Length)</h3>
                <ul class="unit-list">
                    @foreach (var member in members)
                    {
                        <li><button class="link" @onclick="() => SelectUnit(member)">@member.Name</button>@(member.Shown ? "" : " (not drawn; stack beyond six)")</li>
                    }
                </ul>
            }
        }
        @if (board is not null)
        {
            <details id="los-panel" open="@(losCheck is not null)">
                <summary>LOS</summary>
                <p class="muted">VASL's LOS for the blocked-or-clear slice (LOS Design): from one location to another, such as bd01:E4:0.</p>
                <div class="fields">
                    <label for="los-source">From</label>
                    <span><input id="los-source" value="@losSource" @onchange="@(args => losSource = args.Value as string ?? string.Empty)" />
                        <button class="link" id="los-source-selected" disabled="@(selected is null)" @onclick="() => losSource = SelectedLocation()">selected hex</button></span>
                    <label for="los-target">To</label>
                    <span><input id="los-target" value="@losTarget" @onchange="@(args => losTarget = args.Value as string ?? string.Empty)" />
                        <button class="link" id="los-target-selected" disabled="@(selected is null)" @onclick="() => losTarget = SelectedLocation()">selected hex</button></span>
                </div>
                <button id="los-check" @onclick="CheckLos">Check LOS</button>
                <button id="los-clear" disabled="@(losCheck is null)" @onclick="ClearLos">Clear</button>
                @if (losCheck is { } check)
                {
                    <p id="los-result" class="@(check.Result?.IsBlocked == true ? "fail" : check.Result?.IsAnswered == true ? "pass" : "muted")" data-status="@(check.Result?.Status.ToString() ?? "Refused")">@check.Summary</p>
                }
            </details>
        }
        @if (board is not null && (selected ?? hovered) is { } facts)
        {
            @if (selected is null)
            {
                <p class="muted">Hovering. Click to keep this hex.</p>
            }
            <HexInspector Board="board.Ref" Facts="facts" Grid="board.Render.Grid" Catalog="board.Catalog" LocationText="@board.LocationOf(facts)"
                          Model="StyledModel" Validation="board.Validation" OnCopy="CopyLocation" />
        }
        else
        {
            <p class="muted">Hover or click a hex to inspect its derived facts and the grid samples behind them.</p>
        }

        @if (sample is not null)
        {
            <h3>Pixel under the pointer</h3>
            <p>@sample</p>
        }

        @if (board is not null)
        {
            <h3>Provenance</h3>
            <dl>
                <dt>Version</dt>
                <dd><code>@board.Version[..12]</code></dd>
                @if (board.Composition is { } composition)
                {
                    <dt>Boards</dt>
                    <dd><code>@string.Join(" ", composition.Placements)</code></dd>
                    <dt>Size</dt>
                    <dd>@composition.Map.Geometry.WidthInHexes by @composition.Map.Geometry.HeightInHexes hexes</dd>
                    <dt>F2</dt>
                    <dd class="@(board.F2 is { Passed: true } ? "pass" : board.F2 is null ? "muted" : "fail")">
                        @(board.F2 is null ? "no oracle scenario" : board.F2.Passed ? "Pass" : $"{board.F2.Differences.Count} differences")
                    </dd>
                }
                @if (board.Provenance is { } provenance)
                {
                    <dt>VASL commit</dt>
                    <dd><code>@(provenance.VaslCommit?[..12] ?? "unknown")</code></dd>
                    <dt>LOSData</dt>
                    <dd>@provenance.LosData.RepositoryPath</dd>
                }
                @if (board.F1 is { } f1)
                {
                    <dt>F1</dt>
                    <dd class="@(f1.Passed ? "pass" : "fail")">@f1.Status</dd>
                    <dt>F2</dt>
                    <dd class="@(board.F2 is { Passed: true } ? "pass" : board.F2 is null ? "muted" : "fail")">
                        @(board.F2 is null ? "no oracle fixture" : board.F2.Passed ? "Pass" : $"{board.F2.Differences.Count} differences")
                    </dd>
                }
                @if (board.Validation is { } validation)
                {
                    <dt>Validation</dt>
                    <dd>@validation.Summary.Errors errors, @validation.Summary.Warnings warnings</dd>
                }
                @if (StyledModel is { } model)
                {
                    <dt>Styled model</dt>
                    <dd>@model.Features.Count features (@model.Provenance.Kind)</dd>
                }
                <dt>Derivation</dt>
                <dd>@board.Facts.DerivationVersion</dd>
                <dt>Renderer</dt>
                <dd>@BoardRenderer.RendererVersion, theme @RenderTheme.Board.Name @RenderTheme.Board.Version</dd>
            </dl>
        }
    </aside>
</div>

@code {
    private ElementReference host;
    private IJSObjectReference? module;
    private IJSObjectReference? viewport;
    private DotNetObjectReference<BoardViewer>? self;
    private StudioBoard? board;
    private string? loadError;
    private string? preparing;
    private BoardView view = BoardView.Exact;
    private bool trace;
    private HashSet<string> visible = [];
    private HexFacts? selected;
    private HexFacts? hovered;
    private PlacedUnit? selectedUnit;
    private UnitOverlay? unitOverlay;
    private const string GamePrefix = "game:";
    private const string SetPrefix = "set:";
    private IReadOnlyList<UnitSetEntry> unitSets = [];
    private IReadOnlyList<GameEntry> unitGames = [];
    private string? unitSourceKey;
    private GameProjection? gameProjection;
    private string gamePerspective = Perspective.AdjudicatorName;
    private long gameRevision;
    private string unitSheet = UnitLibrary.DefaultSheet;
    private bool showUnits;
    private string? sample;
    private bool viewportPending;
    private string comparisonMode = "overlay";
    private int comparisonValue = 50;

    [Parameter]
    public string BoardName { get; set; } = string.Empty;

    /// <summary>A placement set to show, such as one just saved in the Unit Lab.</summary>
    [SupplyParameterFromQuery(Name = "units")]
    public string? UnitsQuery { get; set; }

    /// <summary>A game to show projected for a perspective at a revision (Unit Display Design, section 20).</summary>
    [SupplyParameterFromQuery(Name = "game")]
    public string? GameQuery { get; set; }

    [SupplyParameterFromQuery(Name = "perspective")]
    public string? PerspectiveQuery { get; set; }

    [SupplyParameterFromQuery(Name = "revision")]
    public long? RevisionQuery { get; set; }

    private UnitSetEntry? UnitSet => unitSourceKey is { } key && key.StartsWith(SetPrefix, StringComparison.Ordinal)
        ? unitSets.FirstOrDefault(entry => entry.Set.SetId == key[SetPrefix.Length..])
        : null;

    private IEnumerable<string> ToggleLayers => BoardRenderer.Layers(view).Where(layer => layer != "defs" && !layer.StartsWith("styled-", StringComparison.Ordinal));

    /// <summary>The Feature Model behind the Styled views, once it exists.</summary>
    private FeatureModel? StyledModel =>
        board?.Render.Styled?.Model ?? (board?.StyledRender is { IsValueCreated: true } styled ? styled.Value.Styled?.Model : null);

    protected override async Task OnParametersSetAsync()
    {
        board = null;
        loadError = null;
        selected = null;
        hovered = null;
        selectedUnit = null;
        unitOverlay = null;
        unitSets = [];
        unitGames = [];
        gameProjection = null;
        showUnits = false;
        sample = null;
        if (!BoardRef.TryParse(BoardName, out var boardRef))
        {
            loadError = $"{BoardName} is not a board reference.";
            return;
        }

        var result = await Task.Run(() => Boards.Load(boardRef));
        if (result.Board is null)
        {
            loadError = $"{BoardName} could not be loaded: " + string.Join("; ", result.Diagnostics.Select(d => d.Code + " " + d.Message));
            return;
        }

        board = result.Board;
        if (board.IsAuthored)
        {
            view = BoardView.Styled;
        }
        else if (!board.HasStyled && view is BoardView.Styled or BoardView.Comparison)
        {
            view = BoardView.Exact;
        }

        unitSets = UnitLibrary.SetsFor(board);
        unitGames = Games.GamesFor(board);

        // Games are projected by perspective and come first; a placement set shows when one is asked for.
        gamePerspective = PerspectiveQuery ?? Perspective.AdjudicatorName;
        gameRevision = RevisionQuery ?? long.MaxValue;
        unitSourceKey = unitGames.Any(game => game.Name == GameQuery) ? GamePrefix + GameQuery
            : unitSets.Any(entry => entry.Set.SetId == UnitsQuery) ? SetPrefix + UnitsQuery
            : unitGames.FirstOrDefault() is { } firstGame ? GamePrefix + firstGame.Name
            : unitSets.FirstOrDefault() is { } firstSet ? SetPrefix + firstSet.Set.SetId
            : null;
        showUnits = unitSourceKey is not null;
        BuildUnits();
        visible = [.. BoardRenderer.Layers(view).Where(layer => layer != "defs")];
        viewportPending = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (viewportPending && board is not null)
        {
            viewportPending = false;
            if (viewport is null)
            {
                module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/boardViewport.js");
                self = DotNetObjectReference.Create(this);
                viewport = await module.InvokeAsync<IJSObjectReference>("create", host, self);
            }

            await LoadView();
        }
    }

    private async Task LoadView()
    {
        if (viewport is null || board is null)
        {
            return;
        }

        // A VASL board's Styled input is its vectorization, computed once on first use.
        if (view is BoardView.Styled or BoardView.Comparison && board.Render.Styled is null && board.StyledRender is { IsValueCreated: false } styled)
        {
            preparing = "Vectorizing the board for the Styled view...";
            StateHasChanged();
            await Task.Run(() => styled.Value);
            preparing = null;
        }

        var input = board.InputFor(view) ?? board.Render;
        var baseUrl = $"render/{board.Ref.Value}/{board.Version}/{BoardRenderer.ViewName(view)}";
        await viewport.InvokeVoidAsync("load", baseUrl, trace ? "?trace=true" : "", BoardRenderer.ViewBox(input, view),
            BoardRenderer.Layers(view), visible.ToArray());
        await viewport.InvokeVoidAsync("setComparison", view == BoardView.Comparison ? comparisonMode : "none", comparisonValue / 100.0);
        await viewport.InvokeVoidAsync("setUnits", showUnits ? unitOverlay?.Svg : null);
        await viewport.InvokeVoidAsync("setLos", losCheck is not null ? Los.Layer(board, losCheck) : null);
        await Highlight();
        StateHasChanged();
    }

    private string losSource = string.Empty;
    private string losTarget = string.Empty;
    private LosCheck? losCheck;

    private string SelectedLocation() => board is not null && selected is { } facts ? board.LocationOf(facts) : string.Empty;

    /// <summary>Checks LOS between the two locations and draws the line (LOS Design, section 6).</summary>
    private async Task CheckLos()
    {
        if (board is null)
        {
            return;
        }

        losCheck = Los.Check(board, losSource, losTarget);
        if (viewport is not null)
        {
            await viewport.InvokeVoidAsync("setLos", Los.Layer(board, losCheck));
        }
    }

    private async Task ClearLos()
    {
        losCheck = null;
        if (viewport is not null)
        {
            await viewport.InvokeVoidAsync("setLos", (string?)null);
        }
    }

    /// <summary>Builds the Units layer for the chosen set and sheet. It replaces only <c>layer-units</c>; board layers are untouched.</summary>
    private void BuildUnits()
    {
        gameProjection = null;
        UnitPlacementSet? set = UnitSet?.Set;
        if (unitSourceKey is { } key && key.StartsWith(GamePrefix, StringComparison.Ordinal)
            && unitGames.FirstOrDefault(game => game.Name == key[GamePrefix.Length..]) is { History: { } history } game)
        {
            gameRevision = Math.Clamp(gameRevision, 1, history.States.Count);
            var perspectives = history.At(gameRevision)!.Perspectives;
            var perspective = perspectives.FirstOrDefault(item => item.Name == gamePerspective) ?? Perspective.Adjudicator;
            gamePerspective = perspective.Name;
            gameProjection = Games.Projection(game, perspective, gameRevision);
            set = gameProjection.Set;
        }

        unitOverlay = board is not null && set is not null && UnitLibrary.Renderer(unitSheet) is { } renderer
            ? UnitLibrary.Overlay(board, set, renderer)
            : null;
        if (selectedUnit is { } current)
        {
            selectedUnit = unitOverlay?.Units.FirstOrDefault(unit => unit.Document.Id == current.Document.Id);
        }
    }

    private async Task PushUnits()
    {
        if (viewport is not null)
        {
            await viewport.InvokeVoidAsync("setUnits", showUnits ? unitOverlay?.Svg : null);
        }
    }

    private async Task ToggleUnits(ChangeEventArgs args)
    {
        showUnits = args.Value is true;
        if (!showUnits)
        {
            selectedUnit = null;
        }

        await PushUnits();
    }

    private async Task ChangeUnitSource(ChangeEventArgs args)
    {
        unitSourceKey = args.Value as string;
        gameRevision = long.MaxValue;
        gamePerspective = Perspective.AdjudicatorName;
        selectedUnit = null;
        BuildUnits();
        await PushUnits();
    }

    private async Task ChangePerspective(ChangeEventArgs args)
    {
        gamePerspective = args.Value as string ?? Perspective.AdjudicatorName;
        BuildUnits();
        await PushUnits();
    }

    private async Task StepRevision(int delta)
    {
        gameRevision += delta;
        BuildUnits();
        await PushUnits();
    }

    private static string ConditionsText(IGameObject item)
    {
        var shown = item.Conditions.Where(pair => pair.Value is not ConditionState.False)
            .Select(pair => pair.Value == ConditionState.True ? pair.Key.Replace("asl:", string.Empty, StringComparison.Ordinal)
                : $"{pair.Key.Replace("asl:", string.Empty, StringComparison.Ordinal)} {Conditions.Name(pair.Value)}")
            .ToArray();
        return shown.Length == 0 ? "none" : string.Join(", ", shown);
    }

    private async Task ChangeUnitSheet(ChangeEventArgs args)
    {
        unitSheet = args.Value as string ?? UnitLibrary.DefaultSheet;
        BuildUnits();
        await PushUnits();
    }

    private async Task ChangeView(ChangeEventArgs args)
    {
        if (BoardRenderer.TryParseView(args.Value as string, out var next) && next != view)
        {
            view = next;
            visible = [.. BoardRenderer.Layers(view).Where(layer => layer != "defs")];
            await LoadView();
        }
    }

    private async Task ChangeComparison(ChangeEventArgs args)
    {
        comparisonMode = args.Value as string ?? "overlay";
        if (viewport is not null)
        {
            await viewport.InvokeVoidAsync("setComparison", comparisonMode, comparisonValue / 100.0);
        }
    }

    private async Task ChangeComparisonValue(ChangeEventArgs args)
    {
        if (int.TryParse(args.Value as string, out var value) && viewport is not null)
        {
            comparisonValue = value;
            await viewport.InvokeVoidAsync("setComparison", comparisonMode, comparisonValue / 100.0);
        }
    }

    private async Task ToggleLayer(string layer, bool on)
    {
        if (on)
        {
            visible.Add(layer);
        }
        else
        {
            visible.Remove(layer);
        }

        if (viewport is not null)
        {
            await viewport.InvokeVoidAsync("setVisible", visible.ToArray());
        }
    }

    private async Task ToggleTrace(ChangeEventArgs args)
    {
        trace = (bool)args.Value!;
        await LoadView();
    }

    private async Task ResetView()
    {
        if (viewport is not null)
        {
            await viewport.InvokeVoidAsync("reset");
        }
    }

    private async Task CopyLocation(string location)
    {
        if (viewport is not null)
        {
            await viewport.InvokeVoidAsync("copyText", location);
        }
    }

    [JSInvokable]
    public async Task OnBoardClick(double x, double y)
    {
        if (board is null)
        {
            return;
        }

        var grid = board.Render.Grid;
        var cellX = (int)Math.Floor(x);
        var cellY = (int)Math.Floor(y);
        sample = grid.TryGetCode(cellX, cellY, out var code)
            ? $"Pixel ({cellX}, {cellY}): code {code} {(board.Catalog.TryGet(code, out var type) ? type.Name : "-")}, elevation {grid.ElevationAt(cellX, cellY)}"
            : $"Pixel ({cellX}, {cellY}) is off the grid.";
        selected = grid.Geometry.HexAt(x, y) is { } hex ? board.Facts[hex] : null;
        selectedUnit = null;
        await Highlight();
        StateHasChanged();
    }

    /// <summary>Hover updates the inspector only when the pointer crosses into another hex.</summary>
    [JSInvokable]
    public Task OnBoardHover(double x, double y)
    {
        if (board is null || selected is not null)
        {
            return Task.CompletedTask;
        }

        var next = board.Render.Grid.Geometry.HexAt(x, y) is { } hex ? board.Facts[hex] : null;
        if (next?.Index != hovered?.Index)
        {
            hovered = next;
            StateHasChanged();
        }

        return Task.CompletedTask;
    }

    [JSInvokable]
    public Task OnBoardKey(string key)
    {
        if (key == "Escape" && selected is not null)
        {
            selected = null;
            StateHasChanged();
            return Highlight();
        }

        return Task.CompletedTask;
    }

    [JSInvokable]
    public Task OnBoardGesture(double[][] points) => Task.CompletedTask;

    [JSInvokable]
    public Task OnBoardDrag(double x0, double y0, double x1, double y1) => Task.CompletedTask;

    [JSInvokable]
    public async Task OnUnitClick(string unitId)
    {
        if (!showUnits || board is null || unitOverlay is null)
        {
            return;
        }

        var unit = unitOverlay.Units.FirstOrDefault(item => item.Document.Id == unitId);
        if (unit is not null)
        {
            selectedUnit = unit;
            selected = board.Facts[unit.Hex];
            await Highlight();
            StateHasChanged();
        }
    }

    private void SelectUnit(PlacedUnit unit) => selectedUnit = unit;

    private async Task Highlight()
    {
        if (viewport is null || board is null)
        {
            return;
        }

        var points = selected is null
            ? null
            : string.Join(" ", board.Render.Grid.Geometry.Vertices(selected.Index)
                .Select(vertex => string.Create(CultureInfo.InvariantCulture, $"{vertex.X},{vertex.Y}")));
        await viewport.InvokeVoidAsync("highlight", points);
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (viewport is not null)
            {
                await viewport.InvokeVoidAsync("dispose");
                await viewport.DisposeAsync();
            }

            if (module is not null)
            {
                await module.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
            // The circuit is gone; the browser already discarded the viewport.
        }

        self?.Dispose();
    }
}
