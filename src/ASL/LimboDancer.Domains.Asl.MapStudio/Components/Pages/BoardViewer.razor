@page "/boards/{BoardName}"
@using System.Globalization
@using LimboDancer.Domains.Asl.Units.State
@using LimboDancer.Domains.Asl.Maps.Coordinates
@using LimboDancer.Domains.Asl.MapStudio.Components.Layout
@inject IBoardProvider Boards
@inject UnitLibrary UnitLibrary
@inject GameLibrary Games

<PageTitle>@(board?.Title ?? BoardName) - ASL Map Studio</PageTitle>

@if (loadError is not null)
{
    <p class="fail">@loadError</p>
}
else if (board is null)
{
    <p class="muted">Loading @BoardName...</p>
}

<div class="viewer" hidden="@(board is null)">
    @if (board is not null)
    {
        @* Pass 29: the map and its inspector are BoardWorkspace; the page keeps its route, the board's load, and its study controls. *@
        <BoardWorkspace @ref="workspace" Board="@board" View="@view" Trace="@trace" Visible="@visible" ComparisonMode="@comparisonMode" ComparisonValue="@comparisonValue"
                        Units="@(showUnits ? unitOverlay : null)" UnitView="@gameProjection?.View" UnitNote="@UnitNote" Vocabulary="@UnitLibrary.Vocabulary"
                        StyledModel="@StyledModel" @bind-Selected="selected" @bind-Panel="panel" Extras="@LayerTabs">
            <Toolbar>
                @if (GameBanner is { } banner)
                {
                    @* The UX analysis (pass 29): a game shown here says which game, whose view, and which revision, and a live one links back to Play. *@
                    <div class="toolbar viewer-game-banner" id="viewer-game-banner">
                        <span>@banner.Text</span>
                        @if (banner.Historical)
                        {
                            <StatusBadge Tone="StatusBadge.BadgeTone.Warning" Label="Historical" Explanation="An earlier revision: not the game's current state." />
                        }
                        @if (banner.PlayLink is { } back)
                        {
                            <a id="viewer-back-to-play" href="@back">Back to Play</a>
                        }
                    </div>
                }
                <BoardViewerToolbar Board="@board" OnFit="@(() => workspace!.Fit())" Preparing="@preparing">
                    <BoardViewPicker Views="@Views" Value="@view" ValueChanged="@ChangeView" />
                    <button type="button" id="map-rotate" aria-pressed="@(workspace?.Rotated == true ? "true" : "false")" @onclick="@(() => workspace!.ToggleRotation())">Rotate map</button>
                    @if (view == BoardView.Comparison)
                    {
                        <BoardComparisonControls Mode="@comparisonMode" ModeChanged="@(mode => comparisonMode = mode)" Value="@comparisonValue" ValueChanged="@(value => comparisonValue = value)" />
                    }
                </BoardViewerToolbar>
                @if (unitSets.Count > 0 || unitGames.Count > 0)
                {
                    <UnitOverlayControls Show="@showUnits" ShowChanged="@(show => showUnits = show)"
                                         Games="@(unitGames.Select(game => new UnitOverlayControls.SourceChoice(GamePrefix + game.Name, game.Label + (game.Record?.Synthetic == true ? " (synthetic)" : ""))).ToArray())"
                                         Sets="@(unitSets.Select(entry => new UnitOverlayControls.SourceChoice(SetPrefix + entry.Set.SetId, entry.Set.Label + (entry.Set.Synthetic ? " (synthetic)" : ""))).ToArray())"
                                         Source="@unitSourceKey" SourceChanged="@ChangeUnitSource" Replay="@Replay"
                                         PerspectiveChanged="@ChangePerspective" RevisionChanged="@ChangeRevision"
                                         Sheets="@UnitLibrary.SheetNames()" Sheet="@unitSheet" SheetChanged="@ChangeUnitSheet" />
                }
            </Toolbar>
            <Footer>
                <p class="muted hint">Drag to pan, wheel or + and - to zoom, 0 to fit. Hover a hex to inspect it; click to keep it, and Escape to release it.</p>
            </Footer>
        </BoardWorkspace>
    }
</div>

@code {
    private BoardWorkspace? workspace;
    private StudioBoard? board;
    private string? loadError;
    private string? preparing;
    private BoardView view = BoardView.Exact;
    private bool trace;
    private HashSet<string> visible = [];
    private HexFacts? selected;
    private UnitOverlay? unitOverlay;
    private const string GamePrefix = "game:";
    private const string SetPrefix = "set:";
    private IReadOnlyList<UnitSetEntry> unitSets = [];
    private IReadOnlyList<GameEntry> unitGames = [];
    private string? unitSourceKey;
    private GameProjection? gameProjection;
    private string gamePerspective = Perspective.AdjudicatorName;
    private long gameRevision;
    private string unitSheet = UnitLibrary.DefaultSheet;
    private bool showUnits;
    private string comparisonMode = "overlay";
    private int comparisonValue = 50;
    private string panel = "selection";

    [Parameter]
    public string BoardName { get; set; } = string.Empty;

    /// <summary>A placement set to show, such as one just saved in the Unit Lab.</summary>
    [SupplyParameterFromQuery(Name = "units")]
    public string? UnitsQuery { get; set; }

    /// <summary>A game to show projected for a perspective at a revision (Unit Display Design, section 20).</summary>
    [SupplyParameterFromQuery(Name = "game")]
    public string? GameQuery { get; set; }

    [SupplyParameterFromQuery(Name = "perspective")]
    public string? PerspectiveQuery { get; set; }

    [SupplyParameterFromQuery(Name = "revision")]
    public long? RevisionQuery { get; set; }

    /// <summary>The hex to select when the page opens, such as the one picked on Play (pass 29, task 29.5).</summary>
    [SupplyParameterFromQuery(Name = "hex")]
    public string? HexQuery { get; set; }

    private sealed record Banner(string Text, bool Historical, string? PlayLink);

    /// <summary>Claude Design's review: the rendered layers and the trace sit in a Layers tab after the inspector's own, not in a row above the map.</summary>
    private IReadOnlyList<BoardInspector.ExtraTab> LayerTabs =>
    [
        new(new("layers", "Layers"), @<BoardLayerToggles Layers="@ToggleLayers" Visible="@visible" LayerChanged="@ToggleLayer" TraceAvailable="@(view == BoardView.HexFacts)" Trace="@trace" TraceChanged="@(on => trace = on)" />, Last: true),
    ];

    /// <summary>The game shown, whose view, and which revision; a live game links back to Play; null when no game is shown.</summary>
    private Banner? GameBanner => gameProjection is { } shown && shown.Game.History is { } history
        ? new Banner(
            (shown.Game.Name.StartsWith(GameLibrary.LivePrefix, StringComparison.Ordinal) ? $"Viewing live game {shown.Game.Name[GameLibrary.LivePrefix.Length..]} as " : $"Viewing {shown.Game.Label} as ")
                + $"{DisplayText.ViewName(shown.View.Perspective.Name)}, revision {gameRevision} of {history.States.Count}.",
            gameRevision < history.States.Count,
            shown.Game.Name.StartsWith(GameLibrary.LivePrefix, StringComparison.Ordinal)
                ? $"games/play?game={Uri.EscapeDataString(shown.Game.Name[GameLibrary.LivePrefix.Length..])}"
                    + (selected is { } picked && board is not null && board.LocationOf(picked) is { Length: > 0 } at ? $"&hex={Uri.EscapeDataString(at)}" : string.Empty)
                : null)
        : null;

    private IReadOnlyList<BoardView> Views => board is { HasStyled: true }
        ? [BoardView.Exact, BoardView.Styled, BoardView.HexFacts, BoardView.Comparison]
        : [BoardView.Exact, BoardView.HexFacts];

    private UnitSetEntry? UnitSet => unitSourceKey is { } key && key.StartsWith(SetPrefix, StringComparison.Ordinal)
        ? unitSets.FirstOrDefault(entry => entry.Set.SetId == key[SetPrefix.Length..])
        : null;

    private UnitOverlayControls.ReplayState? Replay => gameProjection is { } projection
        ? new([.. projection.Game.History!.States[^1].Perspectives.Select(option => new PerspectivePicker.Choice(option.Name, option.IsAdjudicator ? "the adjudicator" : DisplayText.Side(option.Name)))],
            projection.View.Perspective.Name, (int)gameRevision, projection.Game.History!.States.Count)
        : null;

    private string? UnitNote => gameProjection is { } shownGame
        ? shownGame.Game.Record?.Synthetic == false ? "A live game, changed only through the governed path." : "A synthetic game, not a live one."
        : unitOverlay is { } overlay && UnitSet is { } shown
            ? $"{(shown.Set.Synthetic ? "Synthetic placement" : "Placement")} from {shown.Set.Label} ({overlay.SetId}); display only, not game state."
            : null;

    private IReadOnlyList<string> ToggleLayers => [.. BoardRenderer.Layers(view).Where(layer => layer != "defs" && !layer.StartsWith("styled-", StringComparison.Ordinal))];

    /// <summary>The Feature Model behind the Styled views, once it exists.</summary>
    private FeatureModel? StyledModel =>
        board?.Render.Styled?.Model ?? (board?.StyledRender is { IsValueCreated: true } styled ? styled.Value.Styled?.Model : null);

    protected override async Task OnParametersSetAsync()
    {
        board = null;
        loadError = null;
        selected = null;
        unitOverlay = null;
        unitSets = [];
        unitGames = [];
        gameProjection = null;
        showUnits = false;
        if (!BoardRef.TryParse(BoardName, out var boardRef))
        {
            loadError = $"{BoardName} is not a board reference.";
            return;
        }

        var result = await Task.Run(() => Boards.Load(boardRef));
        if (result.Board is null)
        {
            loadError = $"{BoardName} could not be loaded: " + string.Join("; ", result.Diagnostics.Select(d => d.Code + " " + d.Message));
            return;
        }

        // The Styled view kept from another board is vectorized before this board is shown in it.
        await PrepareStyled(result.Board, view);
        board = result.Board;
        if (board.IsAuthored)
        {
            view = BoardView.Styled;
        }
        else if (!board.HasStyled && view is BoardView.Styled or BoardView.Comparison)
        {
            view = BoardView.Exact;
        }

        unitSets = UnitLibrary.SetsFor(board);
        unitGames = Games.GamesFor(board);

        // Games are projected by perspective and come first; a placement set shows when one is asked for.
        gamePerspective = PerspectiveQuery ?? Perspective.AdjudicatorName;
        gameRevision = RevisionQuery ?? long.MaxValue;
        unitSourceKey = unitGames.Any(game => game.Name == GameQuery) ? GamePrefix + GameQuery
            : unitSets.Any(entry => entry.Set.SetId == UnitsQuery) ? SetPrefix + UnitsQuery
            : unitGames.FirstOrDefault() is { } firstGame ? GamePrefix + firstGame.Name
            : unitSets.FirstOrDefault() is { } firstSet ? SetPrefix + firstSet.Set.SetId
            : null;
        showUnits = unitSourceKey is not null;
        BuildUnits();
        if (HexQuery is { Length: > 0 } hex && BoardLocation.TryParse(hex, out var picked))
        {
            selected = GameMaps.FactsAt(board, picked);
        }

        visible = [.. BoardRenderer.Layers(view).Where(layer => layer != "defs")];
    }

    /// <summary>
    /// A VASL board's Styled input is its vectorization, computed once on first use. It is ready before the view that needs it is set, so the
    /// workspace never draws that view without it (pass 29).
    /// </summary>
    private async Task PrepareStyled(StudioBoard? target, BoardView next)
    {
        if (target is not null && next is BoardView.Styled or BoardView.Comparison && target.Render.Styled is null && target.StyledRender is { IsValueCreated: false } styled)
        {
            preparing = "Vectorizing the board for the Styled view...";
            StateHasChanged();
            await Task.Run(() => styled.Value);
            preparing = null;
        }
    }

    /// <summary>Builds the Units layer for the chosen set and sheet. It replaces only <c>layer-units</c>; board layers are untouched.</summary>
    private void BuildUnits()
    {
        gameProjection = null;
        UnitPlacementSet? set = UnitSet?.Set;
        if (unitSourceKey is { } key && key.StartsWith(GamePrefix, StringComparison.Ordinal)
            && unitGames.FirstOrDefault(game => game.Name == key[GamePrefix.Length..]) is { History: { } history } game)
        {
            gameRevision = Math.Clamp(gameRevision, 1, history.States.Count);
            var perspectives = history.At(gameRevision)!.Perspectives;
            var perspective = perspectives.FirstOrDefault(item => item.Name == gamePerspective) ?? Perspective.Adjudicator;
            gamePerspective = perspective.Name;
            gameProjection = Games.Projection(game, perspective, gameRevision);
            set = gameProjection.Set;
        }

        unitOverlay = board is not null && set is not null && UnitLibrary.Renderer(unitSheet) is { } renderer
            ? UnitLibrary.Overlay(board, set, renderer)
            : null;
    }

    private void ChangeUnitSource(string? key)
    {
        unitSourceKey = key;
        gameRevision = long.MaxValue;
        gamePerspective = Perspective.AdjudicatorName;
        BuildUnits();
    }

    // A new perspective or revision projects the game again; a selected unit the new view does not show is dropped by the workspace.
    private void ChangePerspective(string perspective)
    {
        gamePerspective = perspective.Length > 0 ? perspective : Perspective.AdjudicatorName;
        BuildUnits();
    }

    private void ChangeRevision(int revision)
    {
        gameRevision = revision;
        BuildUnits();
    }

    private void ChangeUnitSheet(string sheet)
    {
        unitSheet = sheet;
        BuildUnits();
    }

    private async Task ChangeView(BoardView next)
    {
        await PrepareStyled(board, next);
        view = next;
        visible = [.. BoardRenderer.Layers(view).Where(layer => layer != "defs")];
    }

    private void ToggleLayer((string Layer, bool Shown) change)
    {
        if (change.Shown)
        {
            visible.Add(change.Layer);
        }
        else
        {
            visible.Remove(change.Layer);
        }
    }
}
