@page "/units/cards/edit"
@using LimboDancer.Domains.Asl.Play
@using LimboDancer.Domains.Asl.Units.Catalog
@inject LivePlay Live
@inject UnitLibrary Library
@inject GameMaps Maps

<PageTitle>Card editor - ASL Map Studio</PageTitle>

<PageHeader Title="Card editor">
    <p>
        Every game starts from a scenario card (rulings R22.1 to R22.4, R28.1 to R28.4). Fill in the card section by section; each section lists its own
        problems, and only a valid card is saved, beside your saved maps.
    </p>
</PageHeader>

@if (catalog is null)
{
    <p id="edit-no-catalog" class="diagnostic error">The published catalog cannot be read, so no card can be edited.</p>
}
else
{
    @* The Card editor redesign (2026-10-31): the card's name, its state, its problems, and its actions stay on screen while the sections scroll. *@
    <div class="card-editor-bar" id="edit-bar">
        <div class="card-editor-name">
            <strong id="edit-heading">@(draft.Title.Trim().Length > 0 ? draft.Title.Trim() : "Untitled card")</strong>
            <span class="card-editor-state"><code id="edit-id-shown">@(draft.Id.Trim().Length > 0 ? draft.Id.Trim() : "no id")</code> <span id="edit-state">@State</span></span>
        </div>
        <button id="edit-problems-toggle" type="button" class="card-problem-count @(diagnostics.Count == 0 ? "valid" : "invalid")" aria-controls="edit-problems"
                aria-expanded="@(problemsOpen ? "true" : "false")" @onclick="@(() => problemsOpen = !problemsOpen)">
            @(diagnostics.Count == 0 ? "Valid" : diagnostics.Count == 1 ? "1 problem" : $"{diagnostics.Count} problems")
        </button>
        <label class="card-open">
            Open
            <CardPicker Id="edit-source" Cards="@choices" Value="@source" ValueChanged="@ChooseSource" EmptyLabel="a new minimal card" />
        </label>
        <CardSaveActions Source="@editing" RenameTo="@draft.Id.Trim()" Games="@games" Note="@note" Outcome="@noteOutcome"
                         OnSave="@Save" OnRename="@Rename" OnDelete="@Delete" OnJson="@(() => Go(CardSections.Json))" />
    </div>
    <div id="edit-problems" class="card-problems" hidden="@(!problemsOpen)">
        @if (diagnostics.Count > 0)
        {
            <p class="card-problem-sections">
                In
                @foreach (var (key, list) in CardSections.Route(diagnostics, draft).Where(entry => entry.Key.Length > 0))
                {
                    <button type="button" id="@($"edit-problems-go-{key}")" @onclick="@(() => Go(key))">@CardSections.Label(key, draft) (@list.Count)</button>
                }
            </p>
        }
        <FindingList Id="edit-diagnostics" Items="@FindingList.Of(diagnostics)" EmptyId="edit-valid">
            <Empty>The card is valid against catalog @catalog.Identity.Catalog@@@catalog.Identity.Version@(map is null ? "." : " and its boards.")</Empty>
        </FindingList>
    </div>
    @if (minigameRefusal is { } refusal && source.Length == 0)
    {
        <p class="diagnostic warning" id="edit-minigame-refused">@refusal</p>
    }

    <CardEditorForm Draft="@draft" Catalog="@catalog" Sides="@sides" BoardNames="@boardNames" SavedMaps="@savedMaps" Map="@map" MapProblems="@mapProblems"
                    Json="@json" Changed="@Edited" Problems="@diagnostics" Section="@section" SectionChanged="@Go" IdFollowsTitle="@(editing is null)" />
}

@code {
    [SupplyParameterFromQuery]
    public string? Card { get; set; }

    /// <summary>The section shown, so a reload keeps it.</summary>
    [SupplyParameterFromQuery]
    public string? Section { get; set; }

    [Inject]
    private NavigationManager Navigation { get; set; } = default!;

    private string section = CardSections.Card;
    private string? sectionAsked;
    private bool problemsOpen;

    // Whether a field changed since the card was opened or saved.
    private bool dirty;

    private UnitCatalog? catalog;
    private string source = string.Empty;
    private CardDraft draft = CardDraft.Minimal();
    private IReadOnlyList<(string Name, string Label)> sides = [];
    private IReadOnlyList<string> boardNames = [];
    private IReadOnlyList<MapDefinition> savedMaps = [];
    private StudioBoard? map;
    private IReadOnlyList<string> mapProblems = [];
    private string? json;
    private IReadOnlyList<string> games = [];
    private IReadOnlyList<string> diagnostics = [];
    private string? note;

    // Why the card the address named was not loaded: it is a minigame's (the minigame cards design).
    private string? minigameRefusal;
    private IReadOnlyList<CardPicker.Choice> choices = [];

    // The user card being edited; null for a new card or a copy of a built-in card. Read from the library when the card changes, not on every render.
    private string? editing;

    // Set with each note (UI review, pass 22b): a refusal reads as one; a completed save, rename, or delete reads as done.
    private OperationFeedback.OperationOutcome noteOutcome = OperationFeedback.OperationOutcome.Done;

    protected override void OnInitialized()
    {
        catalog = UnitCatalogs.Read(UnitCatalogs.ScenarioA1, Library.Vocabulary)?.Catalog;
        sides = [.. Library.Vocabulary.Sides.Select(side => (side.Name, side.Label))];
        boardNames = Maps.BoardNames();
        savedMaps = Maps.Saved();
        // The minigame cards design: a minigame's card is never the source of a scenario card, so no copy of it joins the user's cards.
        if (Minigames.BundleOfCard(Card) is { } bundle)
        {
            minigameRefusal = $"'{Card}' is the card of the minigame {Minigames.Find(bundle)?.Title ?? bundle}; a minigame's card is not copied into a scenario card, so the editor starts from a minimal card.";
        }
        else if (Card is { Length: > 0 } named && catalog is not null && Live.Cards.Read(named, catalog)?.Card is { } card)
        {
            source = named;
            draft = CardDraft.From(card, Live.Cards.IsUser(named));
        }

        Refresh();
    }

    // The section follows the address only when the address changes, so a re-render does not undo a section chosen in the list.
    protected override void OnParametersSet()
    {
        if (Section != sectionAsked)
        {
            sectionAsked = Section;
            section = CardSections.Known(Section, draft);
        }
    }

    private void Go(string key)
    {
        section = CardSections.Known(key, draft);
        problemsOpen = false;
        sectionAsked = section;
        Navigation.NavigateTo(Navigation.GetUriWithQueryParameter("section", section), replace: true);
    }

    private string State => (editing, source.Length > 0, dirty) switch
    {
        ({ }, _, false) => "your card, saved",
        ({ }, _, true) => "your card, changed and not saved",
        (null, true, _) => "a copy of a built-in card, not saved",
        _ => "a new card, not saved",
    };

    private void Edited()
    {
        dirty = true;
        Check();
    }

    // UI review, pass 28: the library is listed and its cards read when it changes, not on every keystroke.
    private void ListCards()
    {
        var users = Live.Cards.UserNames;
        choices = [.. Live.Cards.Names.Select(name => new CardPicker.Choice(name, Title(name), users.Contains(name, StringComparer.Ordinal)))];
        editing = source.Length > 0 && users.Contains(source, StringComparer.Ordinal) ? source : null;
    }

    private string Title(string name) => catalog is not null && Live.Cards.Read(name, catalog)?.Card is { } card ? card.Title : name;

    private void Refuse(string text) => (note, noteOutcome) = (text, OperationFeedback.OperationOutcome.Refused);

    private void Done(string? text) => (note, noteOutcome) = (text, OperationFeedback.OperationOutcome.Done);

    private void ChooseSource(string? chosen)
    {
        source = chosen ?? string.Empty;
        note = null;
        if (source.Length > 0 && catalog is not null && Live.Cards.Read(source, catalog)?.Card is { } card)
        {
            draft = CardDraft.From(card, Live.Cards.IsUser(source));
        }
        else
        {
            source = string.Empty;
            draft = CardDraft.Minimal();
        }

        Refresh();
    }

    /// <summary>The checks again, and the games that started from the card being edited (the game-to-card index; ruling R28.4).</summary>
    private void Refresh()
    {
        dirty = false;
        ListCards();
        games = editing is { } user ? Live.GamesFrom(user) : [];
        Check();
    }

    private void Check()
    {
        note = null;
        Validate();
    }

    /// <summary>
    /// The card the fields describe, checked against the catalog (rulings R17.1 to R27.1), its id against the library (ruling R22.2), and its areas and
    /// hexes against its boards when they can be drawn (ruling R28.3).
    /// </summary>
    private ScenarioCard? Validate()
    {
        if (catalog is null)
        {
            return null;
        }

        var (card, problems) = draft.Build($"{catalog.Identity.Catalog}@{catalog.Identity.Version}");
        if (card is null)
        {
            // UI review, pass 28: the map follows the board fields even while another field is unfinished, and goes when a board's slot is not a number.
            (map, mapProblems) = draft.BoardsOrNull() is { } boards ? Maps.Cards.Load(boards) : (null, ["a board's column or row is not a whole number"]);
            (diagnostics, json) = (problems, null);
            return null;
        }

        (map, mapProblems) = Maps.Cards.Load(card.Boards);
        json = ScenarioCardLibrary.Serialize(card);
        diagnostics = [.. ScenarioCards.Validate(card, catalog),
            .. ScenarioCards.IsBuiltIn(card.Id) ? [$"card.id: '{card.Id}' is a built-in card's name; save a copy under another id (ruling R22.2)"]
                : !ScenarioCardLibrary.ValidName(card.Id) ? [$"card.id: '{card.Id}' is not a card name: lower-case letters, digits, and hyphens, 64 at most (ruling R22.2)"]
                : card.Id != source && Live.Cards.IsUser(card.Id) ? [$"card.id: you already have a card '{card.Id}'; choose another id, or edit that card (ruling R22.2)"] : Array.Empty<string>(),
            .. map is null ? Array.Empty<string>() : CardMaps.Check(card, map)];
        return card;
    }

    private void Save()
    {
        // Referee, demo 2026-09-30: the button stays enabled, so a click that arrives with a field's last change is not lost; the card is checked here.
        if (catalog is null || Validate() is not { } card || diagnostics.Count > 0)
        {
            Refuse("Not saved: fix the problems listed above first.");
            return;
        }

        var refused = Live.Cards.Save(card, catalog, replace: card.Id == source && Live.Cards.IsUser(source));
        diagnostics = refused;
        if (refused.Count > 0)
        {
            Refuse("Not saved: fix the problems listed above first.");
            return;
        }

        Done($"Saved '{card.Id}'; start a game from it on the Play page.");
        (source, dirty) = (card.Id, false);
        ListCards();
        games = Live.GamesFrom(source);
    }

    // Ruling R28.4: a rename saves the card under its new id, then deletes the old file; nothing is deleted when the save is refused.
    private void Rename()
    {
        var old = source;
        if (catalog is null || Validate() is not { } card || diagnostics.Count > 0 || card.Id == old || Live.Cards.IsUser(card.Id))
        {
            Refuse("Not renamed: fix the problems listed above first.");
            return;
        }

        var refused = Live.Cards.Save(card, catalog);
        if (refused.Count > 0)
        {
            diagnostics = refused;
            Refuse("Not renamed: fix the problems listed above first.");
            return;
        }

        Live.Cards.Delete(old);
        (source, dirty) = (card.Id, false);
        ListCards();
        Done($"Renamed '{old}' to '{card.Id}'.");
        games = Live.GamesFrom(source);
    }

    private void Delete()
    {
        var old = source;
        if (Live.Cards.Delete(old))
        {
            source = string.Empty;
            draft = CardDraft.Minimal();
            Refresh();
            Done($"Deleted '{old}'.");
        }
    }
}
