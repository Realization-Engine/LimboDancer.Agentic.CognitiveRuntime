@page "/units/games"
@using System.Globalization
@using LimboDancer.Domains.Asl.Units.State
@using LimboDancer.Domains.Asl.Maps.Read
@using LimboDancer.Domains.Asl.MapStudio.Components.Games
@inject GameLibrary GamesLibrary
@inject UnitLibrary Library
@inject NavigationManager Navigation

<PageTitle>Game states - ASL Map Studio</PageTitle>

<PageHeader Title="Game states">
    <p>
        Replay a synthetic game fixture event by event and read it from each side or as the adjudicator. A side's view leaves out what that side
        cannot know: hidden units are absent and concealed enemies are only a presence. Fixtures are display input, never game state.
    </p>
</PageHeader>

@if (GamesLibrary.Names.Count == 0)
{
    <p class="fail">No game fixtures are embedded.</p>
}
else
{
    <GameReplayToolbar Games="@GamesLibrary.Names" Game="@name" GameChanged="@Open"
                       Perspectives="@PerspectiveChoices" Perspective="@perspective.Name" PerspectiveChanged="@ChangePerspective"
                       Revision="@((int)revision)" Max="@(state is null ? 0 : entry!.History!.States.Count)" RevisionChanged="@ChangeRevision"
                       BoardName="@BoardName" OnShow="@ShowOnBoard" />

    @if (entry is not null)
    {
        <ul id="game-findings">
            @foreach (var diagnostic in entry.Diagnostics)
            {
                <li class="@(diagnostic.Severity == UnitDiagnosticSeverity.Error ? "fail" : "muted")">@diagnostic</li>
            }
            @if (entry.PositionsChecked)
            {
                <li class="pass">Every position was checked against the location chains of @BoardName, version @state?.Map.Boards[0].Version[..12].</li>
            }
        </ul>
    }

    @if (view is not null && state is not null)
    {
        <GameContextSummary Id="game-summary" Revision="@revision" Max="@entry!.History!.States.Count" Turn="@view.Turn" Phase="@view.Phase"
                            PhasingSide="@view.PhasingSide" Perspective="@view.Perspective.Name"
                            Note="@($"{(state.Synthetic ? "Synthetic fixture. " : string.Empty)}Stamp: {view.Stamp.Scope.Game} at revision {view.Stamp.Revision}.")" />

        <h3>Units</h3>
        <ProjectedGameUnitTable Rows="@unitRows" />

        @if (view.Equipment.Count > 0 || view.Entities.Count > 0)
        {
            <h3>Equipment and entities that are not units</h3>
            <table class="library" id="game-others">
                <thead><tr><th>Id</th><th>Kind</th><th>Side</th><th>Where</th></tr></thead>
                <tbody>
                    @foreach (var equipment in view.Equipment)
                    {
                        <tr><td>@equipment.Id</td><td>@equipment.Kind</td><td>@equipment.Side</td><td>@(equipment.Holding is { } holding ? $"{holding.Role.ToString().ToLowerInvariant()} by {holding.Holder}" : LocationText(equipment.Id, equipment.Position))</td></tr>
                    }
                    @foreach (var entity in view.Entities)
                    {
                        <tr><td>@entity.Id</td><td>@entity.Kind</td><td>@entity.Side</td><td>@LocationText(entity.Id, entity.Position)</td></tr>
                    }
                </tbody>
            </table>
        }

        <h3>Read a case</h3>
        <p class="muted">
            ReadCase (ASL-UNIT-060) asks what a unit attempting something at a location reads: one snapshot of the game as it stood at revision @revision,
            as @view.Perspective.Name may know it, or an explicit nondefinitive result.
        </p>
        <ReadCaseForm @bind-Draft="caseDraft" Attackers="@Attackers" OnRead="@ReadCase" />
        @if (caseResult is { } result)
        {
            <ReadCaseResult Result="@result" />
        }

        <h3>Events @view.Perspective.Name is entitled to</h3>
        <ol id="game-events" class="muted">
            @foreach (var item in view.Events)
            {
                <li value="@item.Revision" class="@(item.Revision == revision ? "pass" : "")">@item.Type @GameText.EventText(item)</li>
            }
        </ol>
    }
}

@code {
    private string name = string.Empty;
    private GameEntry? entry;
    private GameState? state;
    private GameView? view;
    private Perspective perspective = Perspective.Adjudicator;
    private long revision = 1;
    private Dictionary<string, UnitDocument> documents = new(StringComparer.Ordinal);
    private ReadCaseForm.CaseDraft caseDraft = new(string.Empty, "bd01:E4:0", 0);
    private CaseReadResult? caseResult;
    private UnitRenderer? renderer;
    private IReadOnlyList<ProjectedGameUnitTable.Row> unitRows = [];

    private string BoardName => state?.Map.Boards.FirstOrDefault()?.Board.Value ?? "the board";

    private IReadOnlyList<PerspectivePicker.Choice> PerspectiveChoices => state is null ? [] : [.. state.Perspectives.Select(option => new PerspectivePicker.Choice(option.Name, option.Name))];

    // Only the perspective's own units may attempt a case, or every unit for the adjudicator.
    private IReadOnlyList<ReadCaseForm.Attacker> Attackers => view is null ? []
        : [.. view.Units.Where(unit => view.Perspective.IsAdjudicator || unit.Side == view.Perspective.Name).Select(unit => new ReadCaseForm.Attacker(unit.Id, Label(unit.Id, unit.Kind)))];

    protected override void OnInitialized()
    {
        renderer = Library.Renderer(UnitLibrary.DefaultSheet);
        if (GamesLibrary.Names.FirstOrDefault() is { } first)
        {
            Open(first);
        }
    }

    private void Open(string gameName)
    {
        name = gameName;
        entry = GamesLibrary.Load(gameName);
        revision = entry.History?.States.Count ?? 0;
        perspective = Perspective.Adjudicator;
        Refresh();
    }

    private void ChangePerspective(string chosen)
    {
        perspective = new Perspective(chosen.Length > 0 ? chosen : Perspective.AdjudicatorName);
        Refresh();
    }

    private void ChangeRevision(int chosen)
    {
        revision = chosen;
        Refresh();
    }

    // A new game, revision, or perspective projects the view again; the case read's result and an attacker the view no longer allows are cleared.
    private void Refresh()
    {
        state = entry?.History?.At(revision);
        view = state is null ? null : GameView.Of(entry!.History!, revision, perspective);
        documents = view is null ? new(StringComparer.Ordinal)
            : GameDocuments.For(view, Library.Vocabulary, GamesLibrary.Catalogs).ToDictionary(document => document.Id, StringComparer.Ordinal);
        unitRows = view is null ? [] : [.. view.Units.Select(unit => new ProjectedGameUnitTable.Row(unit.Id, Preview(unit.Id), Label(unit.Id, unit.Kind),
                LocationText(unit.Id, unit.Position), ConditionsText(unit), Conditions.Name(GameState.GoodOrder(unit, Library.Vocabulary)), LineageText(unit))),
            .. view.Sealed.Select(presence => new ProjectedGameUnitTable.Row(presence.PlacementId, Preview(presence.PlacementId),
                $"concealed {presence.Side} presence", presence.Location.ToString(), "withheld", "withheld", string.Empty))];
        caseResult = null;
        var attackers = Attackers.Select(attacker => attacker.Id).ToArray();
        caseDraft = caseDraft with
        {
            Expected = revision,
            Attacker = attackers.Contains(caseDraft.Attacker) ? caseDraft.Attacker : attackers.FirstOrDefault() ?? string.Empty,
        };
    }

    private void ReadCase()
    {
        if (entry is null)
        {
            return;
        }

        caseResult = BoardLocation.TryParse(caseDraft.Location.Trim(), out var location)
            ? GamesLibrary.ReadCase(entry, revision, caseDraft.Attacker, location, caseDraft.Expected, perspective)
            : new CaseReadResult(CaseReadStatus.Inconsistent, "CASE-009", $"'{caseDraft.Location}' is not a location such as bd01:E4:0.", null);
    }

    private void ShowOnBoard()
    {
        if (entry is not null && state is not null)
        {
            Navigation.NavigateTo(BoardLink(BoardName, entry.Name, perspective, revision));
        }
    }

    /// <summary>The board viewer showing a game's projection for a perspective at a revision.</summary>
    public static string BoardLink(string board, string game, Perspective perspective, long revision) =>
        $"boards/{board}?game={Uri.EscapeDataString(game)}&perspective={Uri.EscapeDataString(perspective.Name)}&revision={revision.ToString(CultureInfo.InvariantCulture)}";

    private MarkupString Preview(string id) =>
        renderer is not null && documents.TryGetValue(id, out var document)
            ? (MarkupString)UnitPreview.Document(renderer, document, [DetailTier.Mid], null, 0.8, [])
            : default;

    private string Label(string id, string kind) =>
        documents.TryGetValue(id, out var document) ? UnitLabels.AccessibleName(document, Library.Vocabulary) : kind;

    private string LocationText(string id, Position position) =>
        view!.Locations.TryGetValue(id, out var location)
            ? location.Location + (position is ContainedPosition contained ? $" (in {contained.Container})" : string.Empty)
            : position switch
            {
                OffMapPosition => "off map",
                NotEnteredPosition => "not entered",
                _ => string.Empty,
            };

    private static string ConditionsText(UnitInstance unit)
    {
        var shown = unit.Conditions.Where(pair => pair.Value is not ConditionState.False)
            .Select(pair => pair.Value == ConditionState.True ? pair.Key.Replace("asl:", string.Empty, StringComparison.Ordinal)
                : $"{pair.Key.Replace("asl:", string.Empty, StringComparison.Ordinal)} {Conditions.Name(pair.Value)}")
            .ToArray();
        return shown.Length == 0 ? "none" : string.Join(", ", shown);
    }

    private static string LineageText(UnitInstance unit) =>
        string.Join("; ", new[]
        {
            unit.From.Count > 0 ? $"from {string.Join(", ", unit.From)}" : null,
            unit.Custodian is { } custodian ? $"prisoner of {custodian}" : null,
        }.OfType<string>());

    internal static string PhaseLabel(string phase) => GameText.PhaseLabel(phase);
}
