    /// <summary>Makes a game that follows a record, from the record's first step, and opens it.</summary>
    private void StartFollowing(string source)
    {
        var taken = Live.Games().Select(scope => scope.Game).ToHashSet(StringComparer.Ordinal);
        var name = Enumerable.Range(1, 999).Select(number => $"{source}-follow-{number}").First(candidate => !taken.Contains(candidate));
        var made = Live.StartFollowing(source, name);
        if (made.Status != AppendStatus.Committed)
        {
            followProblem = string.Join(" ", made.Diagnostics.Select(item => item.Message));
            return;
        }

        (followGame, followSource, followOf, followProblem) = (name, source, Live.Store.Read(new GameScope(LivePlay.Tenant, source))?.Events.Count ?? 0, null);
        ChangeGame(new ChangeEventArgs { Value = name });
    }

    /// <summary>Adds the record's next step to the open game, which the page then reads as it does after a confirm.</summary>
    private bool FollowNext()
    {
        if (followSource is null || followGame != gameId)
        {
            return false;
        }

        var result = Live.FollowStep(followSource, gameId);
        followProblem = result.Status == AppendStatus.Committed ? null : string.Join(" ", result.Diagnostics.Select(item => item.Message));
        Refresh();
        return followProblem is null && (state?.Revision ?? followOf) < followOf;
    }

    /// <summary>Adds a step a second until the record ends, a step is refused, or Stop is pressed; paced on the server, as Replay's run is.</summary>
    private async Task FollowRun()
    {
        if (followRun is { } running)
        {
            await running.CancelAsync();
            return;
        }

        var mine = followRun = new CancellationTokenSource();
        try
        {
            while (!mine.IsCancellationRequested && FollowNext())
            {
                StateHasChanged();
                await Task.Delay(TimeSpan.FromSeconds(1), mine.Token);
            }
        }
        catch (OperationCanceledException)
        {
            // Stopped.
        }
        finally
        {
            if (ReferenceEquals(followRun, mine))
            {
                followRun = null;
            }

            mine.Dispose();
            StateHasChanged();
        }
    }

