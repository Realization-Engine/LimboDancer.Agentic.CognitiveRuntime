                        {
                            <button class="massacre" data-unit="@unit.Id" data-prisoner="@prisoner.Id" @onclick="@(() => ProposeMassacre(unit.Id, prisoner.Id))">Propose: @unit.Id massacres @prisoner.Id</button>
                        }
                    </div>
                }
                @if (state.FireLanes.Count > 0 || state.Encirclements.Count > 0)
                {
                    <ul class="muted" id="fire-markers">
                        @foreach (var lane in state.FireLanes)
                        {
                            <li class="fire-lane">Fire Lane of @lane.Weapon (@lane.Operator): @string.Join(", ", lane.Entries.Select(entry => $"{DisplayText.Location(entry.Location)} {entry.Fp} FP")) (A9.22)</li>
                        }
                        @foreach (var encircled in state.Encirclements)
                        {
                            <li class="encirclement">@DisplayText.Location(encircled.Location): the @DisplayText.Side(encircled.Side) units there are Encircled (A7.7)</li>
                        }
                    </ul>
                }
                @if (state.Phase == "pfph" && OpportunityCandidates.Any() && (Viewer.IsAdjudicator || viewAs == state.PhasingSide))
                {
                    <OpportunityFireAction Units="@([.. OpportunityCandidates.Select(unit => unit.Id)])" Selected="@opportunityUnits"
                        OnToggle="@(pick => Toggle(opportunityUnits, pick.Id, pick.On))" OnPropose="@ProposeOpportunity" />
                }
                @if (FiringSide is { } waiting && !Viewer.IsAdjudicator && viewAs != waiting)
                {
                    <h4>Fire</h4>
                    <p class="muted" id="fire-elsewhere">The @DisplayText.Side(waiting) side may fire now; its fire groups are its own (choose its view to fire; ruling R23.1).</p>
                }
                else if (FiringSide is { } firing)
                {
                    @* Pass 28c (A8.1, A8.11): after each step the DEFENDER, from its own view, sees where the stack is and fires at it or passes. *@
                    @if (state.Phase == "mph" && !Viewer.IsAdjudicator && viewAs != state.PhasingSide && MovingAt is { } movingAt)
                    {
                        <h4>Defensive First Fire</h4>
                        <div class="toolbar" id="dff-window">
                            <span class="toolbar-note" id="dff-note">The moving stack is at @DisplayText.Location(movingAt): fire at it below, or pass (A8.1).</span>
