    /// <summary>The six facings for a Canister shot, the Gun's own first (C8.4, D3.52): another turns it first, with Case A on the IFT DR.</summary>
    private IReadOnlyList<PlayChoice> OrdnanceCanisterFacings => OrdnanceGunFacing is not { } own ? []
        : [new PlayChoice(own, $"{own} (its Covered Arc now)"),
            .. Enum.GetValues<UnitFacing>().Select(UnitFacings.Name).Where(name => name != own).Select(name => new PlayChoice(name, $"{name} (turn first: Case A on the IFT DR)"))];

    /// <summary>
    /// The five aims of the chosen Covered Arc (C8.4, C8.41; ruling R55.8), each with the hexes it attacks and what the view sees of the enemy
    /// in them: the units in view that Canister can harm (an AFV is not one: "ineffective vs armored targets"), and the "?" stacks the map
    /// shows there. The hexes are the map's; nothing the view does not see is counted.
    /// </summary>
    private IReadOnlyList<PlayChoice> OrdnanceCanisterAims(string firing)
    {
        if (state is not { } game || !UnitFacings.TryParse(OrdnanceCanisterFacing, out var facing))
        {
            return [];
        }

        return [.. Live.Planner.CanisterAims(game, ordnanceGun, facing).Select(aim =>
        {
            var hexes = aim.Cluster.Concat(aim.Adjacent).ToHashSet();
            var seen = VisibleUnits.Count(unit => unit.Status == InstanceStatus.Active && unit.Side != firing && !LiveFire.IsVehicle(unit)
                && game.Location(unit.Id)?.Location is { } at && hexes.Contains(at));
            var stacks = SealedPresences.Count(presence => presence.Side != firing && hexes.Contains(presence.Location));
            var adjacent = aim.Adjacent.Count == 0 ? string.Empty
                : $", and {string.Join(" ", aim.Adjacent.Select(at => at.ToString()))} at {(aim.Quartered ? "a quarter of the" : "half")} FP";
            return new PlayChoice(aim.Aim.ToString(CultureInfo.InvariantCulture),
                $"aim {aim.Aim.ToString(CultureInfo.InvariantCulture)}: {string.Join(" ", aim.Cluster.Select(at => at.ToString()))}{adjacent}: {CanisterAimSeen(seen, stacks)}");
        })];
    }

    /// <summary>What the view sees in an aim's hexes, in words: "2 units in view, 1 concealed stack"; a part that is zero is left out, and "no unit in view" stands for neither.</summary>
    internal static string CanisterAimSeen(int units, int stacks)
    {
        string[] parts =
        [
            .. units > 0 ? new[] { $"{units.ToString(CultureInfo.InvariantCulture)} unit{(units == 1 ? string.Empty : "s")} in view" } : [],
            .. stacks > 0 ? new[] { $"{stacks.ToString(CultureInfo.InvariantCulture)} concealed stack{(stacks == 1 ? string.Empty : "s")}" } : [],
        ];
        return parts.Length == 0 ? "no unit in view" : string.Join(", ", parts);
    }

