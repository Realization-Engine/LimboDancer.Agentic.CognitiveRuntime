    /// <summary>The night and weather in force (rulings R16.1, R16.9): the NVR, the weather SSRs, the precipitation, and the Starshells.</summary>
    private static string NightAndWeather(GameState state)
    {
        var parts = new List<string>();
        if (state.Nvr is { } nvr)
        {
            parts.Add($"Night: Base NVR {nvr} (E1.1)");
        }

        var weather = state.SpecialRules.Where(rule => rule.StartsWith("weather:", StringComparison.Ordinal)).Select(rule => rule["weather:".Length..]).ToArray();
        if (weather.Length > 0)
        {
            parts.Add("weather: " + string.Join(", ", weather) + " (E3)");
        }

        if (state.Precipitation is { } falling)
        {
            parts.Add(falling.Replace('-', ' ') + " is falling, causing Mist (E3.51, E3.71)");
        }

        var starshells = state.Entities.Where(entity => entity.Status == InstanceStatus.Active && entity.Kind == "asl:starshell" && entity.Position is MapPosition)
            .Select(entity => ((MapPosition)entity.Position).Location.ToString()).ToArray();
        if (starshells.Length > 0)
        {
            parts.Add("Starshells Illuminate three hexes around " + string.Join(", ", starshells) + " (E1.923)");
        }

        return string.Join("; ", parts) + (parts.Count > 0 ? "." : string.Empty);
    }

