@page "/games/play"
@using System.Globalization
@using System.Text.Json
@using LimboDancer.Abstractions.Actions
@using LimboDancer.Abstractions.Domain
@using LimboDancer.Domains.Asl.Play
@using LimboDancer.Domains.Asl.ScenarioA1
@using LimboDancer.Domains.Asl.Units.Catalog
@using LimboDancer.Domains.Asl.Units.State
@inject LivePlay Live
@inject UnitLibrary Library
@inject NavigationManager Navigation
@inject GameMaps GameMaps
@inject StudioLos Los
@inject IServiceProvider Services

<PageTitle>Play - ASL Map Studio</PageTitle>

<h2>Play</h2>
<p class="muted">
    Live games are the Studio's chosen game source (D2). Every change is a registered action through the Execution Gate: the Studio proposes it,
    the gate checks it against the current game, boards, and catalog, and it commits only after you confirm. Nothing here edits a game directly.
</p>

@if (Scripted is { } scripted)
{
    <div class="toolbar" id="scripted-dice">
        <strong>Scripted dice are on (development only).</strong>
        <span class="muted">Each die comes from this queue until it is empty, then from the system; games played now are test data.</span>
        <label>Queue <input id="scripted-dice-values" size="24" placeholder="1 1 2 4" @bind="scriptedInput" /></label>
        <button id="scripted-dice-add" @onclick="QueueDice">Add</button>
        <button id="scripted-dice-clear" class="link" @onclick="() => scripted.Clear()">clear</button>
        <span id="scripted-dice-queued">Queued: @(scripted.Queued.Count == 0 ? "none" : string.Join(" ", scripted.Queued))</span>
        @if (scriptedProblem is { } problem)
        {
            <span class="warning">@problem</span>
        }
    </div>
}

<div class="toolbar">
    <label>
        Game
        <select id="play-game" value="@gameId" @onchange="ChangeGame">
            <option value="">a new game</option>
            @foreach (var scope in Live.Games())
            {
                <option value="@scope.Game">@scope.Game</option>
            }
        </select>
    </label>
    @if (state is not null)
    {
        <label>
            View as
            <select id="play-perspective" value="@viewAs" @onchange="@(args => viewAs = args.Value as string ?? viewAs)">
                @foreach (var perspective in state.Perspectives)
                {
                    <option value="@perspective.Name">@(perspective.IsAdjudicator ? "the adjudicator" : perspective.Name)</option>
                }
            </select>
        </label>
        <a id="play-view" href="@Games.BoardLink(ViewTarget, GameLibrary.LivePrefix + gameId, Perspective.Adjudicator, state.Revision)">View on @ViewTarget</a>
    }
</div>

@if (history is null)
{
    <h3>New game</h3>
    <div class="fields">
        <label for="new-id">Game id</label><input id="new-id" value="@newId" @onchange="@(args => newId = args.Value as string ?? string.Empty)" placeholder="village" />
        <label for="new-label">Label</label><input id="new-label" value="@newLabel" @onchange="@(args => newLabel = args.Value as string ?? string.Empty)" />
        <label for="new-board">Boards</label>
        <span>
            <input id="new-board" value="@newBoard" @onchange="@(args => { newBoard = args.Value as string ?? string.Empty; newMap = null; })" />
            <span class="muted">one board, such as bd01, or placed boards, such as bd02@@0,0/r bd01@@0,1 (column, row, /r when reversed)</span>
        </span>
        <label for="new-map">Or a saved map</label>
        <select id="new-map" value="@(newMap ?? string.Empty)" @onchange="ChooseMap">
            <option value="">none</option>
            @foreach (var map in GameMaps.Saved())
            {
                <option value="@map.Ref.Value">@map.Name</option>
            }
        </select>
        <label for="new-first">First side</label>
        <select id="new-first" value="@firstSide" @onchange="@(args => firstSide = args.Value as string ?? firstSide)">
            @foreach (var side in Library.Vocabulary.Sides)
            {
                <option value="@side.Name">@side.Label</option>
            }
        </select>
        <label for="new-second">Second side</label>
        <select id="new-second" value="@secondSide" @onchange="@(args => secondSide = args.Value as string ?? secondSide)">
            @foreach (var side in Library.Vocabulary.Sides)
            {
                <option value="@side.Name">@side.Label</option>
            }
        </select>
        <label for="new-first-elr">ELR</label>
        <span>
            <input id="new-first-elr" value="@firstElr" @onchange="@(args => firstElr = args.Value as string ?? string.Empty)" size="2" /> first side,
            <input id="new-second-elr" value="@secondElr" @onchange="@(args => secondElr = args.Value as string ?? string.Empty)" size="2" /> second side
            <span class="muted">the scenario's Experience Level Rating (A19.1), 0 to 5; fire needs the target side's</span>
        </span>
        <label for="new-month">Month</label>
        <span>
            <select id="new-month" value="@newMonth" @onchange="@(args => newMonth = args.Value as string ?? string.Empty)">
                <option value="">not recorded</option>
                @for (var month = 1; month <= 12; month++)
                {
                    <option value="@month">@CultureInfo.InvariantCulture.DateTimeFormat.GetMonthName(month)</option>
                }
            </select>
            <span class="muted">grain is a Hindrance only from June to September (B15.2)</span>
        </span>
    </div>
}
else if (history.Current is null && state is null)
{
    <div id="play-replay-failed" class="fail">
        <p><strong>This game does not replay</strong>, so it cannot be shown or played. The first reasons:</p>
        <ul>
            @foreach (var diagnostic in history.Diagnostics.Take(5))
            {
                <li>@diagnostic.Code: @diagnostic.Message</li>
            }
        </ul>
        @if (history.Events.FirstOrDefault()?.Payload is GameStarted started && Live.Catalogs.All(catalog => $"{catalog.Identity.Catalog}@{catalog.Identity.Version}" != started.Catalog))
        {
            <p id="play-replay-catalog">It was set up with catalog @started.Catalog, which this Studio no longer carries. Start a new game to play with the current catalog.</p>
        }
    </div>
}
else if (state is not null)
{
    <p id="play-summary">
        <strong>@(history.Current is not null ? $"Revision {state.Revision}" : "The game does not replay")</strong>:
        turn @state.Turn, @Games.PhaseLabel(state.Phase), @state.PhasingSide phasing.
        @(SetupOpen ? "Setup is open." : "Play has started; setup is closed.")
    </p>
}

@if (history is null || SetupOpen)
{
    <h3>Setup</h3>
    <div class="toolbar">
        <label>
            Unit
            <select id="place-definition" value="@placeDefinition" @onchange="@(args => placeDefinition = args.Value as string ?? string.Empty)">
                @foreach (var definition in Definitions)
                {
                    <option value="@definition.Id">@definition.Id (@definition.Nationality @definition.Kind.Replace("asl:", string.Empty, StringComparison.Ordinal))</option>
                }
                @foreach (var side in new[] { firstSide, secondSide }.Distinct(StringComparer.Ordinal))
                {
                    <option value="@(DummyPrefix + side)">a Dummy (@side)</option>
                }
            </select>
        </label>
        <label>Id <input id="place-id" value="@placeId" @onchange="@(args => placeId = args.Value as string ?? string.Empty)" size="8" /></label>
        <label>Location <input id="place-location" value="@placeLocation" @onchange="@(args => placeLocation = args.Value as string ?? string.Empty)" size="12" /></label>
        <label>Or held by <input id="place-holder" value="@placeHolder" @onchange="@(args => placeHolder = args.Value as string ?? string.Empty)" size="8" /></label>
        @if (Definitions.FirstOrDefault(definition => definition.Id == placeDefinition)?.Kind == "asl:gun")
        {
            <label title="A Gun's barrel points at a hexspine (C2.23): hexes are flat-topped, so north and south are hexsides.">
                Gun facing (hexspine)
                <select id="place-facing" value="@placeFacing" @onchange="@(args => placeFacing = args.Value as string ?? "east")">
                    @foreach (var spine in Enum.GetValues<UnitFacing>())
                    {
                        <option value="@UnitFacings.Name(spine)">@UnitFacings.Name(spine)</option>
                    }
                </select>
            </label>
            <span class="muted">A Gun stands at its Location, manned by the crew named in "Or held by".</span>
        }
        <label><input id="place-concealed" type="checkbox" checked="@placeConcealed" @onchange="@(args => placeConcealed = args.Value is true)" /> concealed</label>
        <label><input id="place-hidden" type="checkbox" checked="@placeHidden" @onchange="@(args => placeHidden = args.Value is true)" /> hidden</label>
        <label><input id="place-broken" type="checkbox" checked="@placeBroken" @onchange="@(args => placeBroken = args.Value is true)" /> broken</label>
        <button id="place-add" @onclick="AddPlacement">Add</button>
    </div>
    @if (placements.Count > 0)
    {
        <ul id="place-list">
            @foreach (var placement in placements)
            {
                <li>@placement.Id: @(placement.Definition ?? "a Dummy") @(placement.Holder is { } holder ? $"held by {holder}" : $"at {placement.Location}")@(placement.Concealed ? ", concealed" : "")@(placement.Hidden ? ", hidden" : "")@(placement.Broken ? ", broken" : "") <button class="link" @onclick="() => placements.Remove(placement)">remove</button></li>
            }
        </ul>
    }
    <button id="propose-setup" disabled="@(placements.Count == 0)" @onclick="ProposeSetup">Propose setup</button>
}

@if (state is not null && history?.Current is not null)
{
    <h3>Play</h3>
    <div class="toolbar">
        <button id="propose-advance" @onclick="ProposeAdvance">Propose: advance the phase</button>
    </div>
    <div class="toolbar">
        <label>
            Unit
            <select id="enter-unit" value="@enterUnit" @onchange="@(args => enterUnit = args.Value as string ?? string.Empty)">
                @foreach (var unit in state.Units.Where(unit => unit.Status == InstanceStatus.Active))
                {
                    <option value="@unit.Id">@unit.Id (@unit.Side)</option>
                }
            </select>
        </label>
        <label>Building <input id="enter-location" value="@enterLocation" @onchange="@(args => enterLocation = args.Value as string ?? string.Empty)" size="12" /></label>
        <button id="propose-enter" @onclick="ProposeEntry">Propose: enter a building</button>
    </div>
    <p class="muted">
        The adjudicator decides an entry from the whole game. An entry into a building the moving side cannot see into is only declared when proposed;
        what it finds there is disclosed when it is confirmed.
    </p>
    @if (state.Phase == "rph")
    {
        <h4>Rally and Repair</h4>
        <p class="muted" id="rally-help">
            In the RPh a broken unit may attempt to rally once per Player Turn, rallied by a Good Order leader in its Location or by Self-Rally
            (A10.6), and a Good Order unit that did not attempt to rally may repair a malfunctioned SW it possesses (A9.72).
            The reviewed Rally package resolves the attempt only when every outcome the dice can reach is decided.
        </p>
        <div class="toolbar">
            <label>
                Broken unit
                <select id="rally-unit" value="@rallyUnit" @onchange="@(args => { rallyUnit = args.Value as string ?? string.Empty; rallyLeader = string.Empty; })">
                    <option value="">choose</option>
                    @foreach (var unit in state.Units.Where(unit => unit.Status == InstanceStatus.Active && GameState.Condition(unit, Conditions.Broken) == ConditionState.True))
                    {
                        <option value="@unit.Id">@unit.Id (@unit.Side)</option>
                    }
                </select>
            </label>
            <label>
                Rallied by
                <select id="rally-leader" value="@rallyLeader" @onchange="@(args => rallyLeader = args.Value as string ?? string.Empty)">
                    <option value="">Self-Rally</option>
                    @foreach (var leader in RallyLeaders)
                    {
                        <option value="@leader.Id">@leader.Id</option>
                    }
                </select>
            </label>
            <button id="propose-rally" disabled="@(rallyUnit.Length == 0)" @onclick="ProposeRally">Propose: rally</button>
        </div>
        <div class="toolbar">
            <label>
                Malfunctioned SW
                <select id="repair-weapon" value="@repairWeapon" @onchange="@(args => repairWeapon = args.Value as string ?? string.Empty)">
                    <option value="">choose</option>
                    @foreach (var weapon in state.Equipment.Where(item => item.Status == InstanceStatus.Active && item.Holding is { Role: HoldingRole.Possessed }
                        && GameState.Condition(item, Conditions.Malfunctioned) == ConditionState.True))
                    {
                        <option value="@weapon.Id">@weapon.Id (held by @weapon.Holding!.Holder)</option>
                    }
                </select>
            </label>
            <button id="propose-repair" disabled="@(repairWeapon.Length == 0)" @onclick="ProposeRepair">Propose: repair</button>
        </div>
    }
    @if (state.Phase == "mph")
    {
        <h4>Movement</h4>
        <p class="muted" id="move-help">
            The @state.PhasingSide side moves one stack at a time, one Location per step (A4.1). After each step the DEFENDER may fire at the stack
            or pass (A8.1, A8.11); the stack then moves on, whole or split, or ends its move. No other unit moves until every member of the stack has
            ended (A4.2); a member that breaks or is pinned ends its move. A Location holding Residual FP attacks a stack as it enters (A8.22).
        </p>
        @if (state.Movement is { } movement)
        {
            <p id="move-state" data-step="@movement.Step" data-window="@(movement.WindowOpen ? "open" : "closed")">
                <strong>@string.Join(", ", movement.Movers)</strong> in @movement.Location, step @movement.Step@(movement.Assault ? ", by Assault Movement" : ""):
                @(movement.WindowOpen ? "the DEFENDER may fire, or pass." : "the DEFENDER has passed; move on or end the move.")
                <span id="move-members">@(movement.Members.Count > 0 ? $"May still move: {string.Join(", ", movement.Members)}." : "No member may move farther; end the move.")</span>
            </p>
        }
        <div class="toolbar">
            @foreach (var unit in MoveCandidates)
            {
                <label><input class="move-unit" type="checkbox" data-unit="@unit.Id" checked="@moveUnits.Contains(unit.Id)" @onchange="@(args => Toggle(moveUnits, unit.Id, args.Value is true))" /> @unit.Id (@state.Location(unit.Id)?.Location)</label>
            }
            <label>To <input id="move-to" value="@moveTo" @onchange="@(args => moveTo = args.Value as string ?? string.Empty)" size="12" /></label>
            <label><input id="move-assault" type="checkbox" checked="@moveAssault" @onchange="@(args => moveAssault = args.Value is true)" /> Assault Movement</label>
            <button id="propose-move" disabled="@(moveUnits.Count == 0 || moveTo.Trim().Length == 0)" @onclick="ProposeMove">Propose: move</button>
            <button id="propose-pass" disabled="@(state.Movement is not { WindowOpen: true })" @onclick='@(() => ProposeSimple(GameActions.PassFire, "pass"))'>Propose: the DEFENDER passes</button>
            <button id="propose-end-move" disabled="@(state.Movement is not { WindowOpen: false })" @onclick="ProposeEndMove">Propose: end the move@(EndingSome ? " of the checked units" : "")</button>
        </div>
    }
    @if (state.Phase == "aph")
    {
        <h4>Advance</h4>
        <p class="muted" id="advance-help">
            The @state.PhasingSide side's Infantry that are not broken, pinned, berserk, or held in Melee may advance one Location (A3.7, A4.7),
            even into a Location of Known enemy units, where Close Combat follows. A unit that fired in the PFPh may advance.
        </p>
        <div class="toolbar">
            @foreach (var unit in AdvanceCandidates)
            {
                <label><input class="advance-unit" type="checkbox" data-unit="@unit.Id" checked="@advanceUnits.Contains(unit.Id)" @onchange="@(args => Toggle(advanceUnits, unit.Id, args.Value is true))" /> @unit.Id (@state.Location(unit.Id)?.Location)</label>
            }
            <label>
                To
                <select id="advance-to" value="@advanceTo" @onchange="@(args => advanceTo = args.Value as string ?? string.Empty)">
                    <option value="">choose</option>
                    @foreach (var to in AdvanceDestinations)
                    {
                        <option value="@to">@to</option>
                    }
                </select>
            </label>
            <button id="propose-advance-units" disabled="@(advanceUnits.Count == 0 || advanceTo.Trim().Length == 0)" @onclick="ProposeAdvanceUnits">Propose: advance</button>
        </div>
    }
    @if (state.Phase == "ccph")
    {
        <h4>Close Combat</h4>
        <p class="muted" id="cc-help">
            Units of both sides in one Location attack each other (A11.11): one Location at a time, each unit attacking and attacked at most once
            (A11.12). Where Infantry advanced into woods or a building, roll for Ambush first (A11.4); the ambusher's round comes before the other
            side's, and the ambusher resolves each attack before declaring the next (A11.3). Declare which MMC each SMC is stacked with before the
            attacks (A11.14). A unit held in Melee may withdraw to an ADJACENT Location with no enemy unit (A11.2), and a broken one must try
            (A11.16). Units of both sides left in a Location are held in Melee at the end of the phase (A11.15). Capture attempts (A20.22) are not
            offered yet.
        </p>
        @if (Live.Planner.CloseCombatDue(state) is { Count: > 0 } due)
        {
            <ul id="cc-due">
                @foreach (var item in due)
                {
                    <li>@item</li>
                }
            </ul>
        }
        <div class="toolbar">
            <label>
                Location
                <select id="cc-location" value="@ccLocation" @onchange="@(args => { ccLocation = args.Value as string ?? string.Empty; ClearCloseCombat(); DefaultStacking(); })">
                    <option value="">choose</option>
                    @foreach (var at in CloseCombatLocations)
                    {
                        <option value="@at">@at</option>
                    }
                </select>
            </label>
            @if (CloseCombatEntry is { } entry)
            {
                <span id="cc-status">
                    @(entry.AmbushRolled ? entry.Ambusher is { } ambusher ? $"The {ambusher} side ambushes." : "No Ambush." : "")
                    @(entry.Closed ? "Resolved this CCPh." : entry.Rounds.Count > 0 ? "The ambusher may attack again, or the ambushed side's round follows." : "")
                </span>
                @if (!entry.Closed && entry.Ambusher is not null && entry.Rounds.Count > 0)
                {
                    <label>
                        Round
                        <select id="cc-round" value="@ccRound" @onchange="@(args => ccRound = args.Value as string ?? string.Empty)">
                            <option value="">the ambushed side's round</option>
                            <option value="@CloseCombatResolved.AmbusherRound">another attack by the ambusher</option>
                        </select>
                    </label>
                }
            }
            <button id="propose-ambush" disabled="@(!AmbushDue)" @onclick="ProposeAmbush">Propose: roll for Ambush</button>
        </div>
        @if (ccLocation.Length > 0)
        {
            <div class="toolbar" id="cc-stacking">
                @foreach (var smc in CloseCombatUnits.Where(unit => Library.Vocabulary.IsA(unit.Kind, "asl:smc")))
                {
                    <label>
                        @smc.Id stacked with
                        <select class="cc-stack" data-unit="@smc.Id" value="@(ccStacking.GetValueOrDefault(smc.Id) ?? string.Empty)" @onchange="@(args => SetStacking(smc.Id, args.Value as string))">
                            <option value="">alone</option>
                            @foreach (var mmc in CloseCombatUnits.Where(unit => unit.Side == smc.Side && Library.Vocabulary.IsA(unit.Kind, "asl:mmc")))
                            {
                                <option value="@mmc.Id">@mmc.Id</option>
                            }
                        </select>
                    </label>
                }
            </div>
            @if (WithdrawalUnits.Any())
            {
                <div class="toolbar" id="cc-withdrawals">
                    @foreach (var (unit, destinations) in WithdrawalUnits)
                    {
                        <label>
                            @UnitLabel(unit) @(Live.Planner.MustWithdraw(state, unit) ? "(broken: must try to withdraw)" : "")
                            <select class="cc-withdraw" data-unit="@unit.Id" value="@(ccWithdrawals.GetValueOrDefault(unit.Id) ?? string.Empty)" @onchange="@(args => SetWithdrawal(unit.Id, args.Value as string))">
                                <option value="">stays</option>
                                @foreach (var to in destinations)
                                {
                                    <option value="@to">withdraws to @to</option>
                                }
                            </select>
                        </label>
                    }
                </div>
            }
            @foreach (var side in CloseCombatUnits.Select(unit => unit.Side).Distinct(StringComparer.Ordinal).OrderBy(side => side == state.PhasingSide ? 0 : 1))
            {
                <div class="toolbar cc-side" data-side="@side">
                    <span>@side@(side == state.PhasingSide ? " (ATTACKER)" : "")</span>
                    <span>attack with</span>
                    @foreach (var unit in CloseCombatUnits.Where(unit => unit.Side == side))
                    {
                        <label><input class="cc-attacker" type="checkbox" data-unit="@unit.Id" disabled="@IsBroken(unit)" checked="@ccAttackers.Contains(unit.Id)" @onchange="@(args => ToggleAttacker(unit.Id, args.Value is true))" /> @UnitLabel(unit)</label>
                    }
                    <span>attack</span>
                    @foreach (var unit in CloseCombatUnits.Where(unit => unit.Side != side))
                    {
                        <label><input class="cc-defender" type="checkbox" data-unit="@unit.Id" data-by="@side" checked="@ccDefenders.Contains(unit.Id)" @onchange="@(args => Toggle(ccDefenders, unit.Id, args.Value is true))" /> @UnitLabel(unit)</label>
                    }
                </div>
            }
            <div class="toolbar" id="cc-attack">
                <label>
                    Director
                    <select id="cc-director" value="@ccDirector" @onchange="@(args => ccDirector = args.Value as string ?? string.Empty)">
                        <option value="">none</option>
                        @foreach (var leader in CloseCombatDirectors)
                        {
                            <option value="@leader.Id">@leader.Id</option>
                        }
                    </select>
                </label>
                <button id="cc-add-attack" disabled="@(ccAttackers.Count == 0 || ccDefenders.Count == 0)" @onclick="AddAttack">Add the attack</button>
            </div>
            <ul id="cc-attacks">
                @foreach (var attack in ccAttacks)
                {
                    <li>@string.Join(", ", attack.Attackers) attack @string.Join(", ", attack.Defenders)@(attack.Director is { } director ? $", directed by {director}" : "") <button class="link" @onclick="() => ccAttacks.Remove(attack)">remove</button></li>
                }
            </ul>
            <button id="propose-cc" @onclick="ProposeCloseCombat">Propose: resolve CC@(ccAttacks.Count == 0 ? " with no attacks" : "")</button>
        }
    }
    @foreach (var surrender in state.PendingSurrenders)
    {
        <p class="fail" data-surrender="@surrender.Unit">
            @surrender.Unit has surrendered (A15.5); the captor's side chooses the Guard before anything else happens.
            @foreach (var captor in surrender.Captors)
            {
                <button class="take-prisoner" data-captor="@captor" @onclick="@(() => ProposeTakePrisoner(surrender.Unit, captor))">Propose: @captor takes @surrender.Unit</button>
            }
        </p>
    }
    @if (FiringSide is { } firing)
    {
        <h4>Fire</h4>
        <p class="muted" id="fire-side">
            The @firing side may fire in the @Games.PhaseLabel(state.Phase) (A3.2, A3.3, A3.4, A3.5): Good Order squads and half-squads, in one Location
            or in Locations each ADJACENT to another (A7.5), as one fire group, with the MGs they possess, optionally directed by a leader, at a Location
            the @firing side can see into or at any Location. The reviewed Fire package resolves the attack, and only when every outcome the dice can reach
            is decided.
        </p>
        <div class="toolbar">
            <label>
                From
                <select id="fire-from" value="@fireFrom" @onchange="@(args => { fireFrom = args.Value as string ?? string.Empty; PruneFire(); })">
                    <option value="">choose</option>
                    @foreach (var at in FireLocations(firing))
                    {
                        <option value="@at">@at</option>
                    }
                </select>
            </label>
            @foreach (var unit in FireGroupAt(firing).Where(unit => unit.Kind != "asl:leader"))
            {
                <label><input class="fire-firer" type="checkbox" data-unit="@unit.Id" checked="@fireFirers.Contains(unit.Id)" @onchange="@(args => Toggle(fireFirers, unit.Id, args.Value is true))" /> @unit.Id</label>
            }
            @foreach (var weapon in FireWeapons)
            {
                <label><input class="fire-weapon" type="checkbox" data-weapon="@weapon.Id" checked="@fireWeapons.Contains(weapon.Id)" @onchange="@(args => Toggle(fireWeapons, weapon.Id, args.Value is true))" /> @weapon.Id (@weapon.Holding!.Holder)</label>
            }
            @foreach (var id in fireFirers.Where(id => FireWeapons.Any(weapon => weapon.Holding!.Holder == id && fireWeapons.Contains(weapon.Id))).Order(StringComparer.Ordinal))
            {
                <label><input class="fire-alone" type="checkbox" data-unit="@id" checked="@fireAlone.Contains(id)" @onchange="@(args => Toggle(fireAlone, id, args.Value is true))" /> @id's MGs alone</label>
            }
            <label>
                Director
                <select id="fire-director" value="@fireDirector" @onchange="@(args => fireDirector = args.Value as string ?? string.Empty)">
                    <option value="">none</option>
                    @foreach (var leader in FireLeaders(firing))
                    {
                        <option value="@leader.Id">@leader.Id</option>
                    }
                </select>
            </label>
            <label>
                Target
                <select id="fire-target" value="@fireTarget" @onchange="@(args => fireTarget = args.Value as string ?? string.Empty)">
                    <option value="">choose</option>
                    @foreach (var at in FireTargets(firing))
                    {
                        <option value="@at">@at</option>
                    }
                </select>
            </label>
            <label>Or any Location <input id="fire-free-target" value="@fireFreeTarget" @onchange="@(args => fireFreeTarget = args.Value as string ?? string.Empty)" size="12" /></label>
            <button id="propose-fire" disabled="@(fireFirers.Count == 0 || FireTarget.Length == 0)" @onclick="ProposeFire">Propose: fire</button>
            <button id="fire-clear" class="link" @onclick="ClearFire">clear</button>
        </div>
        @if (state.Phase is "pfph" or "afph" or "dfph" && OrdnanceGuns(firing).Any())
        {
            <h4>Ordnance</h4>
            <p class="muted" id="ordnance-help">
                A Gun manned by its crew fires HE at the enemy units of a Location on the Infantry Target Type (C3.3, C3.32). It turns to bring the
                target into its Covered Arc if it must, with the Case A DRM (C5.1). An Original colored dr at most its ROF lets it fire again this
                phase (C2.24), and each shot acquires the Location for the next (C6.5). A hit attacks every enemy unit there on the IFT column of the
                Gun's HE FP (C.6).
            </p>
            <div class="toolbar">
                <label>
                    Gun
                    <select id="ordnance-gun" value="@ordnanceGun" @onchange="@(args => ordnanceGun = args.Value as string ?? string.Empty)">
                        <option value="">choose</option>
                        @foreach (var gun in OrdnanceGuns(firing))
                        {
                            <option value="@gun.Id">@GunLabel(gun)</option>
                        }
                    </select>
                </label>
                <label>
                    Target
                    <select id="ordnance-target" value="@ordnanceTarget" @onchange="@(args => ordnanceTarget = args.Value as string ?? string.Empty)">
                        <option value="">choose</option>
                        @foreach (var at in FireTargets(firing))
                        {
                            <option value="@at">@at</option>
                        }
                    </select>
                </label>
                <button id="propose-ordnance" disabled="@(ordnanceGun.Length == 0 || ordnanceTarget.Length == 0)" @onclick="ProposeOrdnance">Propose: fire the Gun</button>
            </div>
        }
    }
}

@if (pending is { } proposal)
{
    <div id="play-proposal">
        <h3>@proposal.Action.Name</h3>
        <p class="@(proposal.Result.Outcome is PlayOutcome.NeedsConfirmation or PlayOutcome.Committed or PlayOutcome.Replay ? "pass" : "fail")">
            <strong id="play-outcome">@OutcomeText(proposal.Result.Outcome, Withheld(proposal))</strong>
        </p>
        <ul id="play-reasons">
            @foreach (var reason in Reasons(proposal))
            {
                <li>@reason</li>
            }
        </ul>
        @if (proposal.Result.Plan?.Entry is { } review && !Withheld(proposal))
        {
            <table class="library" id="play-facts">
                <thead><tr><th>Reviewed fact (Scenario A1 first case)</th><th>From the game</th></tr></thead>
                <tbody>
                    @foreach (var (name, value) in review.Facts)
                    {
                        <tr data-fact="@name"><td>@name</td><td class="@(value == true ? "pass" : value == false ? "fail" : "muted")">@(value?.ToString().ToLowerInvariant() ?? "unknown")</td></tr>
                    }
                </tbody>
            </table>
            <p id="play-conclusion">
                Conclusion: <strong>@review.Conclusion.Disposition</strong>. @review.Conclusion.Explanation
                <span class="muted">(@review.Conclusion.ExplanationProvenance)</span>
            </p>
        }
        @if (proposal.Result.Plan?.Fire is { Attack: var attack })
        {
            <table class="library" id="fire-facts">
                <thead><tr><th>Fact of the attack</th><th>From the game and the map</th></tr></thead>
                <tbody>
                    <tr data-fact="phase"><td>Phase and side</td><td>@attack.Phase@(attack.FireKind is { } kind ? $" ({kind})" : ""), the @(attack.FiringSide) side</td></tr>
                    <tr data-fact="firers"><td>Fire group</td><td>@FireGroupText(attack)</td></tr>
                    <tr data-fact="target"><td>Target Location</td><td>@attack.TargetLocationId</td></tr>
                    <tr data-fact="range"><td>Range</td><td>@RangeText(attack)</td></tr>
                    <tr data-fact="level"><td>Same level</td><td>@(attack.SameLevel is { } same ? same ? "yes" : "no" : "not read")</td></tr>
                    <tr data-fact="los"><td>LOS</td><td>@(attack.Los is { } los ? $"{(los.Blocked == true ? "blocked" : "clear")}, Hindrance DRM {los.HindranceDrm}{(los.HindranceAttributed == true ? "" : " (not attributed)")}" : "not read")</td></tr>
                    <tr data-fact="terrain"><td>Target terrain</td><td>@(attack.TargetTerrain ?? "not read")</td></tr>
                    <tr data-fact="month"><td>Month</td><td>@(attack.ScenarioMonth?.ToString(CultureInfo.InvariantCulture) ?? "not recorded")</td></tr>
                </tbody>
            </table>
        }
        @if (proposal.Result.Outcome == PlayOutcome.NeedsConfirmation)
        {
            <button id="play-confirm" @onclick="Confirm">Confirm</button>
            <button id="play-cancel" class="link" @onclick="() => pending = null">Cancel</button>
        }
    </div>
}

@if (state is not null)
{
    @foreach (var open in state.OpenAttempts)
    {
        <p class="fail" data-open-attempt="@open.EventId">
            The entry attempt of @open.Unit into @open.Target awaits the attacker's Infantry OVR declaration (A12.15, p. 78). The phase cannot advance until it is made.
            <button class="declare-decline" @onclick='@(() => ProposeDeclaration(open.Unit, "decline"))'>Propose: decline the OVR</button>
            <button class="declare-elect" @onclick='@(() => ProposeDeclaration(open.Unit, "elect"))'>Propose: elect the OVR</button>
        </p>
    }

    @if (Rolls.Count > 0)
    {
        <h3>Rolls</h3>
        <ul id="play-rolls">
            @foreach (var (roll, subjects) in Rolls)
            {
                <li data-roll="@roll.Roll">
                    @RollText(roll)@(subjects is null ? "" : $" for {string.Join(", ", subjects)}")
                    <span class="muted">(@roll.Count d@(roll.Sides), drawn by the @roll.Source for @roll.Actor)</span>
                </li>
            }
        </ul>
    }

    @if (OrdnanceRecords.Count > 0)
    {
        <h3>Ordnance</h3>
        <ul id="play-ordnance">
            @foreach (var (eventId, text) in OrdnanceRecords)
            {
                <li class="ordnance-record" data-event="@eventId">@text</li>
            }
        </ul>
    }

    @if (FireRecords.Count > 0)
    {
        <h3>Fire</h3>
        <div id="play-fires">
            @foreach (var record in FireRecords)
            {
                <div class="fire-record" data-fire="@record.EventId">
                    <p>
                        <strong class="fire-group">@record.Group fire at @record.Target</strong>.
                    </p>
                    <ul>
                        @foreach (var firer in record.Arithmetic.Firers)
                        {
                            <li class="fire-fp" data-unit="@firer.UnitId">@firer.UnitId: @firer.Printed FP@(string.Concat(firer.Multipliers.Select(item => $" × {Number(item.Value)} ({item.Name}, {item.Rule})"))) = @Number(firer.Firepower)</li>
                        }
                        <li class="fire-column">
                            Total @Number(record.Arithmetic.TotalFirepower) FP: the @(record.Arithmetic.UnshiftedColumnFp?.ToString(CultureInfo.InvariantCulture) ?? "no") column@(record.Arithmetic.ColumnShift != 0 || record.Arithmetic.Cowered ? $", shifted {record.Arithmetic.ColumnShift}{(record.Arithmetic.Cowered ? " by Cowering (A7.9)" : "")} to the {record.Arithmetic.ColumnFp?.ToString(CultureInfo.InvariantCulture) ?? "no"} column" : "")
                        </li>
                        <li class="fire-dr">
                            IFT DR @string.Join(", ", record.Arithmetic.Dice) = @record.Arithmetic.OriginalDr@(string.Concat(record.Arithmetic.Drm.Select(item => $" {(item.Value < 0 ? "-" : "+")} {Number(Math.Abs(item.Value))} ({item.Name}, {item.Rule})"))):
                            Final DR <span class="fire-final-dr">@record.Arithmetic.FinalDr</span>, result <strong class="fire-result">@record.Arithmetic.Result</strong>
                        </li>
                    </ul>
                    @if (record.Effects is { } effects)
                    {
                        <table class="library fire-effects">
                            <thead><tr><th>Target</th><th>Effect</th><th>Checks</th></tr></thead>
                            <tbody>
                                @foreach (var effect in effects)
                                {
                                    <tr data-unit="@effect.UnitId">
                                        <td>@effect.UnitId (@effect.DefinitionId@(effect.FinalDefinitionId != effect.DefinitionId ? $", now {effect.FinalDefinitionId}" : ""))</td>
                                        <td class="fire-effect">@EffectText(effect)</td>
                                        <td>@string.Join("; ", effect.Checks.Select(CheckText))</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <p class="muted fire-withheld">The target Location's units are not disclosed: the result leaves them concealed (A12.14, p. 77), so only the @(record.TargetSide ?? "target") side sees them.</p>
                    }
                </div>
            }
        </div>
    }

    @if (CloseCombatRecords.Count > 0)
    {
        <h3>Close Combat</h3>
        <ul id="play-close-combats">
            @foreach (var (eventId, text) in CloseCombatRecords)
            {
                <li class="cc-record" data-event="@eventId">@text</li>
            }
        </ul>
    }

    @if (RallyAndRepairRecords.Count > 0)
    {
        <h3>Rally and Repair</h3>
        <ul id="play-rallies">
            @foreach (var (eventId, kind, text) in RallyAndRepairRecords)
            {
                <li class="@kind-record" data-event="@eventId">@text</li>
            }
        </ul>
    }

    <h3>Map</h3>
    @if (state.ResidualFire.Count > 0)
    {
        <p id="play-residual">
            Residual FP this MPh (A8.2):
            @string.Join("; ", state.ResidualFire.Select(item => $"{item.Fp} in {item.Location}"))
        </p>
    }
    @if (Drawing is { } drawing)
    {
        @if (drawing.Svg is { } svg)
        {
            <div id="play-map" class="play-map" data-source="@drawing.Source">@((MarkupString)svg)</div>
        }
        else
        {
            <ul id="play-map-problems">
                @foreach (var problem in drawing.Problems)
                {
                    <li>@problem</li>
                }
            </ul>
        }
    }

    <details id="play-los" open="@(playLos is not null)">
        <summary>LOS</summary>
        <p class="muted">VASL's LOS over the game's map (LOS Designs): terrain only, so every viewer may check it, from a location or from a unit the viewer can see.</p>
        <div class="fields">
            <label for="play-los-unit">From unit</label>
            <select id="play-los-unit" @onchange="ChooseLosUnit">
                <option value="">none</option>
                @foreach (var unit in VisibleUnits.Where(unit => state?.Location(unit.Id) is not null))
                {
                    <option value="@unit.Id">@unit.Id (@state!.Location(unit.Id)!.Location)</option>
                }
            </select>
            <label for="play-los-source">From</label><input id="play-los-source" value="@losSource" @onchange="@(args => losSource = args.Value as string ?? string.Empty)" />
            <label for="play-los-target">To</label><input id="play-los-target" value="@losTarget" @onchange="@(args => losTarget = args.Value as string ?? string.Empty)" />
        </div>
        <button id="play-los-check" @onclick="CheckLos">Check LOS</button>
        <button id="play-los-clear" disabled="@(playLos is null)" @onclick="() => playLos = null">Clear</button>
        @if (playLos is { } check)
        {
            <p id="play-los-result" data-status="@(check.Result?.Status.ToString() ?? "Refused")">@check.Summary</p>
        }
    </details>

    <h3>Units</h3>
    <p class="muted" id="play-units-view">As @(Viewer.IsAdjudicator ? "the adjudicator sees them: every unit" : $"{Viewer.Name} sees them"), at revision @state.Revision.</p>
    <table class="library" id="play-units">
        <thead><tr><th>Id</th><th>Side</th><th>Kind</th><th>Location</th><th>MF spent</th><th>Conditions</th></tr></thead>
        <tbody>
            @foreach (var unit in VisibleUnits)
            {
                <tr data-unit="@unit.Id">
                    <td>@unit.Id</td><td>@unit.Side</td><td>@unit.Kind.Replace("asl:", string.Empty, StringComparison.Ordinal)</td>
                    <td>
                        @if (unit.Status == InstanceStatus.Active && state.Location(unit.Id)?.Location is { } at)
                        {
                            <button class="play-locate" @onclick="() => highlight = at">@at</button>
                        }
                        else
                        {
                            @unit.Status.ToString().ToLowerInvariant()
                        }
                    </td>
                    <td>@unit.MfSpent@(unit.MovementEnded ? ", movement ended" : "")</td>
                    <td>@string.Join(", ", unit.Conditions.Where(pair => pair.Value == ConditionState.True).Select(pair => pair.Key.Replace("asl:", string.Empty, StringComparison.Ordinal)))</td>
                </tr>
            }
            @foreach (var presence in SealedPresences)
            {
                <tr data-sealed="@presence.PlacementId">
                    <td>?</td><td>@presence.Side</td><td>concealed</td><td>@presence.Location</td><td></td><td></td>
                </tr>
            }
        </tbody>
    </table>
    @if (Viewer.IsAdjudicator)
    {
        <details>
            <summary>Audit (latest)</summary>
            <pre class="json">@string.Join("\n", Live.Audit.Tail(12))</pre>
        </details>
    }
}

@code {
    private string? scriptedInput;
    private string? scriptedProblem;

    /// <summary>The scripted dice of a UI test run, when this run of the Studio has them.</summary>
    private ScriptedDice? Scripted => Services.GetService<ScriptedDice>();

    private void QueueDice()
    {
        var parts = (scriptedInput ?? "").Split([' ', ',', ';'], StringSplitOptions.RemoveEmptyEntries);
        var values = parts.Select(part => int.TryParse(part, NumberStyles.None, CultureInfo.InvariantCulture, out var value) ? value : 0).ToList();
        scriptedProblem = values.Count > 0 && Scripted!.Enqueue(values) ? null : "Each die is a number from 1 to 6.";
        if (scriptedProblem is null)
        {
            scriptedInput = null;
        }
    }

    private sealed record Placement(string Id, string? Definition, string Kind, string Side, string Location, bool Concealed, bool Hidden, string? Holder,
        bool Broken = false, string? Facing = null);

    private string placeFacing = "east";

    private const string DummyPrefix = "dummy:";

    private sealed record Proposal(ActionDescriptor Action, JsonElement Arguments, PlayResult Result);

    private string gameId = string.Empty;
    private GameHistory? history;
    private GameState? state;
    private string newId = "village";
    private string newLabel = "Village";
    private string newBoard = "bd01";
    private string? newMap;
    private LimboDancer.Domains.Asl.Maps.Coordinates.BoardLocation? highlight;
    private string firstSide = "german";
    private string secondSide = "russian";
    private readonly List<Placement> placements = [];
    private string placeDefinition = string.Empty;
    private string placeId = string.Empty;
    private string placeLocation = "bd01:D4:0";
    private bool placeConcealed;
    private bool placeHidden;
    private string placeHolder = string.Empty;
    private bool placeBroken;
    private string enterUnit = string.Empty;
    private string enterLocation = "bd01:E4:0";
    private Proposal? pending;
    private string viewAs = string.Empty;
    private string firstElr = string.Empty;
    private string secondElr = string.Empty;
    private string newMonth = string.Empty;
    private string fireFrom = string.Empty;
    private readonly HashSet<string> fireFirers = new(StringComparer.Ordinal);
    private string fireDirector = string.Empty;
    private string fireTarget = string.Empty;
    private string fireFreeTarget = string.Empty;
    private readonly HashSet<string> fireWeapons = new(StringComparer.Ordinal);
    private readonly HashSet<string> fireAlone = new(StringComparer.Ordinal);
    private string rallyUnit = string.Empty;
    private string rallyLeader = string.Empty;
    private string repairWeapon = string.Empty;
    private readonly HashSet<string> moveUnits = new(StringComparer.Ordinal);
    private string moveTo = string.Empty;
    private bool moveAssault;
    private readonly HashSet<string> advanceUnits = new(StringComparer.Ordinal);
    private string advanceTo = string.Empty;
    private string ccLocation = string.Empty;
    private readonly HashSet<string> ccAttackers = new(StringComparer.Ordinal);
    private readonly HashSet<string> ccDefenders = new(StringComparer.Ordinal);
    private string ccDirector = string.Empty;
    private string ccRound = string.Empty;
    private readonly Dictionary<string, string> ccStacking = new(StringComparer.Ordinal);
    private readonly Dictionary<string, string> ccWithdrawals = new(StringComparer.Ordinal);
    private readonly List<DeclaredAttack> ccAttacks = [];

    /// <summary>The ADJACENT Locations of the chosen units' Location, where they may advance (A4.7).</summary>
    private IReadOnlyList<string> AdvanceDestinations => state is not null
        && advanceUnits.Select(id => state.Location(id)?.Location).Distinct().ToArray() is [{ } from]
            ? [.. Live.Planner.AdjacentLocations(state, from).Select(item => item.ToString()).Order(StringComparer.Ordinal)]
            : [];

    private bool AmbushDue => state is not null && ccLocation.Length > 0 && BoardLocation.TryParse(ccLocation, out var at) && Live.Planner.AmbushDue(state, at);

    private static bool IsBroken(UnitInstance unit) => GameState.Condition(unit, Conditions.Broken) == ConditionState.True;

    /// <summary>A unit as a player reads it: its id, its definition, and its state in CC.</summary>
    private static string UnitLabel(UnitInstance unit) => $"{unit.Id} ({unit.Definition?.Definition}"
        + string.Concat(new[] { Conditions.Broken, Conditions.Pinned, Conditions.Berserk, Conditions.Melee }
            .Where(name => GameState.Condition(unit, name) == ConditionState.True).Select(name => ", " + name.Replace("asl:", "", StringComparison.Ordinal))) + ")";

    /// <summary>The units held in Melee in the CC Location that may withdraw (A11.2: not pinned, berserk, Disrupted, or a prisoner), with their destinations.</summary>
    private IEnumerable<(UnitInstance Unit, IReadOnlyList<BoardLocation> Destinations)> WithdrawalUnits => state is null || ccLocation.Length == 0
        || !BoardLocation.TryParse(ccLocation, out var at) || CloseCombatEntry is not null
        ? []
        : CloseCombatUnits.Where(unit => GameState.Condition(unit, Conditions.Melee) == ConditionState.True
                && !new[] { Conditions.Pinned, Conditions.Berserk, Conditions.Disrupted, Conditions.Captured }.Any(name => GameState.Condition(unit, name) == ConditionState.True))
            .Select(unit => (unit, Live.Planner.WithdrawalDestinations(state, unit, at))).Where(item => item.Item2.Count > 0);

    /// <summary>The leaders who may direct the attack being declared: attackers, Good Order, not pinned or berserk (A11.141, A7.831).</summary>
    private IEnumerable<UnitInstance> CloseCombatDirectors => CloseCombatUnits.Where(unit => unit.Kind == "asl:leader" && ccAttackers.Contains(unit.Id)
        && GameState.Condition(unit, Conditions.Broken) != ConditionState.True && GameState.Condition(unit, Conditions.Pinned) != ConditionState.True
        && GameState.Condition(unit, Conditions.Berserk) != ConditionState.True);

    /// <summary>Choosing an attacker preselects the best leader to direct the attack, when none is chosen (A11.141).</summary>
    private void ToggleAttacker(string id, bool on)
    {
        Toggle(ccAttackers, id, on);
        if (!CloseCombatDirectors.Any(unit => unit.Id == ccDirector))
        {
            ccDirector = string.Empty;
        }

        if (ccDirector.Length == 0 && ccAttackers.Count > 1 && CloseCombatDirectors
            .OrderBy(unit => unit.Definition is { } definition && CloseCombatDefinitions.TryGetValue(definition.Definition, out var fire) ? fire.Leadership ?? 0 : 0)
            .FirstOrDefault() is { } best)
        {
            ccDirector = best.Id;
        }
    }

    private static readonly Lazy<IReadOnlyDictionary<string, FireDefinition>> CcDefinitions = new(() => new ScenarioA1CloseCombatPackage().Reference.Definitions);

    private static IReadOnlyDictionary<string, FireDefinition> CloseCombatDefinitions => CcDefinitions.Value;

    /// <summary>Each SMC defaults to the first MMC of its side in the Location, which the player may change (A11.14).</summary>
    private void DefaultStacking()
    {
        foreach (var smc in CloseCombatUnits.Where(unit => Library.Vocabulary.IsA(unit.Kind, "asl:smc")))
        {
            if (CloseCombatUnits.FirstOrDefault(unit => unit.Side == smc.Side && Library.Vocabulary.IsA(unit.Kind, "asl:mmc")) is { } mmc)
            {
                ccStacking[smc.Id] = mmc.Id;
            }
        }
    }

    private void SetWithdrawal(string unit, string? to)
    {
        if (string.IsNullOrEmpty(to))
        {
            ccWithdrawals.Remove(unit);
        }
        else
        {
            ccWithdrawals[unit] = to;
        }
    }

    /// <summary>A CC attack declared on the page, not yet proposed.</summary>
    private sealed record DeclaredAttack(string[] Attackers, string[] Defenders, string? Director);

    /// <summary>The phasing side's units that may advance: not broken, pinned, berserk, in Melee, captured, or already advanced (A4.7).</summary>
    private IEnumerable<UnitInstance> AdvanceCandidates => state is null ? []
        : state.Units.Where(unit => unit.Status == InstanceStatus.Active && unit.Side == state.PhasingSide && !unit.MovementEnded && state.Location(unit.Id) is not null
            && !new[] { Conditions.Broken, Conditions.Pinned, Conditions.Berserk, Conditions.Melee, Conditions.Captured, Conditions.Concealed, Conditions.Hidden, "asl:ti" }.Any(name => GameState.Condition(unit, name) == ConditionState.True))
            .OrderBy(unit => unit.Id, StringComparer.Ordinal);

    private Task ProposeAdvanceUnits() => Propose(GameActions.Advance, JsonSerializer.SerializeToElement(new
    {
        gameId, attemptId = Attempt("adv"), expectedRevision = (long)history!.Events.Count, unitIds = advanceUnits.Order(StringComparer.Ordinal).ToArray(), to = advanceTo.Trim(),
    }));

    /// <summary>The Locations holding units of both sides, none of them a prisoner: where CC can occur (A11.1).</summary>
    private IEnumerable<string> CloseCombatLocations => state is null ? []
        : state.Units.Where(unit => unit.Status == InstanceStatus.Active && GameState.Condition(unit, Conditions.Captured) != ConditionState.True && state.Location(unit.Id) is not null)
            .GroupBy(unit => state.Location(unit.Id)!.Location.ToString()).Where(group => group.Select(unit => unit.Side).Distinct(StringComparer.Ordinal).Count() > 1)
            .Select(group => group.Key).Order(StringComparer.Ordinal);

    private CloseCombatLocation? CloseCombatEntry => state?.CloseCombats.FirstOrDefault(item => item.Location.ToString() == ccLocation);

    private IEnumerable<UnitInstance> CloseCombatUnits => state is null || ccLocation.Length == 0 ? []
        : state.Units.Where(unit => unit.Status == InstanceStatus.Active && state.Location(unit.Id)?.Location.ToString() == ccLocation)
            .OrderBy(unit => unit.Side, StringComparer.Ordinal).ThenBy(unit => unit.Id, StringComparer.Ordinal);

    private void SetStacking(string smc, string? mmc)
    {
        if (string.IsNullOrEmpty(mmc))
        {
            ccStacking.Remove(smc);
        }
        else
        {
            ccStacking[smc] = mmc;
        }
    }

    private void AddAttack()
    {
        ccAttacks.Add(new DeclaredAttack([.. ccAttackers.Order(StringComparer.Ordinal)], [.. ccDefenders.Order(StringComparer.Ordinal)],
            ccDirector.Length > 0 && ccAttackers.Contains(ccDirector) ? ccDirector : null));
        ccAttackers.Clear();
        ccDefenders.Clear();
        ccDirector = string.Empty;
    }

    private void ClearCloseCombat()
    {
        ccAttackers.Clear();
        ccDefenders.Clear();
        ccDirector = string.Empty;
        ccRound = string.Empty;
        ccStacking.Clear();
        ccWithdrawals.Clear();
        ccAttacks.Clear();
    }

    private Task ProposeAmbush() => Propose(GameActions.Ambush, JsonSerializer.SerializeToElement(new
    {
        gameId, attemptId = Attempt("amb"), expectedRevision = (long)history!.Events.Count, location = ccLocation,
    }));

    private Task ProposeCloseCombat() => Propose(GameActions.CloseCombat, JsonSerializer.SerializeToElement(new Dictionary<string, object>
    {
        ["gameId"] = gameId,
        ["attemptId"] = Attempt("cc"),
        ["expectedRevision"] = (long)history!.Events.Count,
        ["location"] = ccLocation,
        ["attacks"] = ccAttacks.Select(attack => attack.Director is { } director
            ? (object)new { attackers = attack.Attackers, defenders = attack.Defenders, director }
            : new { attackers = attack.Attackers, defenders = attack.Defenders }).ToArray(),
        ["stacking"] = ccStacking,
        ["withdrawals"] = ccWithdrawals,
        ["round"] = ccRound,
    }));

