    private void Refresh()
    {
        var previousRevision = state?.Revision;
        (planCache, offeredCache, maySetUpCache, motionCache) = (default, default, default, null);
        history = gameId.Length > 0 ? Live.History(gameId) : null;
        state = history?.Current ?? (history is { States.Count: > 0 } ? history.States[^1] : null);
        if (state?.Revision != previousRevision)
        {
            ordnanceSecondFirer = string.Empty;
            spotterDeclarationGun = spotterDeclarationUnit = string.Empty;
            spotterDeclarationCache = default;
        }
        var phase = state is null ? null : $"{state.Turn}/{state.Phase}/{state.PhasingSide}";
        if (shownPhase is not null && phase != shownPhase)
        {
            ResetForPhase();
        }

        shownPhase = phase;
        if (state?.Movement is { } movement)
        {
            // The checked units stay checked while they may still move; otherwise those of the latest step that may.
            moveUnits.IntersectWith(movement.Members);
            if (moveUnits.Count == 0)
            {
                moveUnits.UnionWith(movement.Movers.Where(movement.Members.Contains));
            }

            // A15.431: a charging stack's next step, when its route allows only one.
            if (Charges.FirstOrDefault(item => movement.Members.Contains(item.Unit.Id)) is { Undecided: null, Next: [var only] })
            {
                moveTo = only.ToString();
            }
        }
        else if (state is not null)
        {
            moveUnits.RemoveWhere(id => state.Unit(id) is not { MovementEnded: false });

            // A15.43: a berserk unit charges before any other unit moves, so it is the one checked, with its only next step.
            if (moveUnits.Count == 0 && Charges.Where(item => item.Undecided is null).ToArray() is [var (charging, _, next, _), ..] decided)
            {
                moveUnits.UnionWith(decided.Where(item => state.Location(item.Unit.Id)?.Location == state.Location(charging.Id)?.Location).Select(item => item.Unit.Id));
                moveTo = next is [var only] ? only.ToString() : moveTo;
            }
        }

        PruneFire();
        PruneMoveDrafts();
        if (state is not null && !state.Perspectives.Any(perspective => perspective.Name == viewAs))
        {
            viewAs = state.PhasingSide;
        }

        // The Play streamlining plan, S3: the route is plotted again only when the state or the stack has changed.
        RefreshPlot();
    }

    private void AddPlacement()
    {
        if (placeDefinition.StartsWith(DummyPrefix, StringComparison.Ordinal))
        {
            AddDummy(placeDefinition[DummyPrefix.Length..]);
            return;
        }

        if (placeDefinition.StartsWith(SniperPrefix, StringComparison.Ordinal))
        {
            var sniperSide = placeDefinition[SniperPrefix.Length..];
            placements.Add(new Placement(placeId.Trim().Length > 0 ? placeId.Trim() : $"sniper-{sniperSide}", null, "asl:sniper", sniperSide, placeLocation.Trim(), false, false, null));
            placeId = string.Empty;
            return;
        }

        if (Definitions.FirstOrDefault(definition => definition.Id == placeDefinition) is not { } definition)
        {
            return;
        }

        var id = placeId.Trim().Length > 0 ? placeId.Trim() : $"{definition.Id}-{placements.Count + 1}";
        var side = new[] { firstSide, secondSide }.Contains(definition.Nationality) ? definition.Nationality
            : state?.Sides.FirstOrDefault(item => item.Nationality == definition.Nationality)?.Id ?? definition.Nationality;

        // A SW is placed in the possession of a unit (A9.1), a Gun manned by its crew or towed by a vehicle (C10.1), and Personnel may ride a vehicle as
        // Passengers (D6.1, A2.52; ruling R26.2); anything else at a Location.
        var named = placeHolder.Trim();

        // Table player, pass 26: a holder not yet placed is said, not dropped; a vehicle or crew is placed before what it carries or mans.
        if (named.Length > 0 && !placements.Any(item => item.Id == named) && state?.Find(named) is null)
        {
            placeNote = $"{named} is not placed yet: place the vehicle or crew first, then what it carries, tows, or mans.";
            return;
        }

        if (definition.Kind == "asl:gun" && placeOffBoard && named.Length == 0)
        {
            placeNote = "A Gun waits off board only in tow: name its towing vehicle in \"Manned or towed by\" (C10.1; ruling R26.1).";
            return;
        }

        var vehicleNamed = named.Length > 0 && (placements.Any(item => item.Id == named && item.Kind == "asl:vehicle") || state?.Unit(named) is { } held && LiveFire.IsVehicle(held));
        var equipment = Library.Vocabulary.IsA(definition.Kind, "asl:equipment");
        var holder = named.Length > 0 && (equipment || (vehicleNamed && definition.Kind != "asl:vehicle")) ? named : null;
        string? role = holder is null ? null
            : definition.Kind == "asl:gun" ? vehicleNamed ? "towed" : "manned"
            : equipment ? "possessed" : placeRider ? "rider" : "passenger";
        // C2.23, A21.13: a Gun faces a hexspine at its Location and is manned by the crew named as its holder.
        var gun = definition.Kind is "asl:gun" or "asl:vehicle";
        // Referee, pass 18: a group of another side is not taken, and the page says so.
        var groupTaken = placeGroup.Length == 0 || GroupChoices.Any(choice => choice.Side == side && choice.Group.Id == placeGroup);
        placeNote = groupTaken ? null : $"{placeGroup} is not an OB group of {side}, so {id} is placed without a group.";
        placements.Add(new Placement(id, definition.Id, definition.Kind, side, placeLocation.Trim(), placeConcealed, placeHidden, holder,
            placeBroken && holder is null, gun ? placeFacing : null, definition.Kind is "asl:gun" or "asl:mg" && placeBore.Trim().Length > 0 ? placeBore.Trim() : null,
            placeGroup.Length > 0 && GroupChoices.Any(choice => choice.Side == side && choice.Group.Id == placeGroup) ? placeGroup : null,
            placeOffBoard && holder is null && definition.Kind != "asl:gun", role,
            placeOffBoard && holder is null && EntryChoices.Any(choice => choice.Value == placeEntry) ? placeEntry : null)
        {
            Key = Guid.NewGuid().ToString("N"),

            // D3.41, D3.45 (pass 55): an armed AFV's Armor Leader and Inexperienced Crew; the gate refuses the two together.
            ArmorLeader = GamePlanner.IsArmedAfv(definition.Id) && placeArmorLeader.Length > 0 ? placeArmorLeader : null,
            InexperiencedCrew = GamePlanner.IsArmedAfv(definition.Id) && placeInexperiencedCrew,
        });
        placeId = string.Empty;
        placeHolder = string.Empty;
        placeBore = string.Empty;
        placeRider = false;
        (placeArmorLeader, placeInexperiencedCrew) = (string.Empty, false);
        ListChanged();
    }

    /// <summary>A Dummy (A12.1): a "?" with no unit beneath it, so it has no definition and is always concealed.</summary>
    private void AddDummy(string side)
    {
        var id = placeId.Trim().Length > 0 ? placeId.Trim() : $"dummy-{side}-{placements.Count + 1}";
        placements.Add(new Placement(id, null, UnitKinds.Dummy, side, placeLocation.Trim(), true, placeHidden, null,
            Group: placeGroup.Length > 0 && GroupChoices.Any(choice => choice.Side == side && choice.Group.Id == placeGroup) ? placeGroup : null));
        placeId = string.Empty;
        ListChanged();
    }

    private async Task ProposeSetup()
    {
        // A counter with no hex yet is said here, in the player's words, before the gate would refuse it by its place in the list.
        if (SetupMode && CounterModel.Unplaced.Count(row => !row.Held) is > 0 and var waitingForHex)
        {
            placeNote = unplacedNote = $"{Count(waitingForHex, "counter has", "counters have")} no hex yet: place {(waitingForHex == 1 ? "it" : "them")} on the map, tick \"off board\", or remove {(waitingForHex == 1 ? "it" : "them")}, then propose.";
            (setupTab, shownPlan) = ("counters", null);
            return;
        }

        var game = history is null ? newId.Trim() : gameId;
        object[] units = [.. placements.Select(PlacementArguments)];
        var hexes = placements.Where(row => OnMap(row) && BoardLocation.TryParse(row.Location, out _)).Select(row => BoardLocation.Parse(row.Location) with { Level = 0 }).Distinct().Count();
        var sides = string.Join(" and ", placements.Select(row => DisplayText.Side(row.Side)).Distinct(StringComparer.Ordinal));
        bool Waits(Placement row) => row.OffBoard || (row.Holder is { } holder && row.Role != "manned" && placements.FirstOrDefault(other => other.Id == holder) is { } carrier && Waits(carrier));
        var waiting = placements.Count(Waits);
        setupReview = placements.Count == 0
            ? ($"Start the game from its card with no counter placed. The side that sets up first then sets up on the map, in its own view.", [], 0)
            : ($"Set up the {sides} side" + (ChosenPlan is { } from ? $" from {PlanTitle(from)}" + (PlanChanges.Count > 0 ? $", with {Count(PlanChanges.Count, "change", "changes")}" : ", unchanged") : " from your list")
                + $": {Count(placements.Count, "counter", "counters")}" + (hexes > 0 ? $" in {Count(hexes, "hex", "hexes")}" : string.Empty)
                + (waiting == placements.Count ? ", all off board to enter" : waiting > 0 ? $", {waiting} of them off board to enter" : string.Empty) + "."
                + (ChosenPlan is { } open && PlanChanges.Count == 0 && PlanPublicNote(open, review: true) is { } publicNote ? " " + publicNote : string.Empty),
                PlanChanges, placements.Count);
        (setupAsk, shownPlan) = (null, null);
        var catalog = PublishedCatalog is { } published ? $"{published.Identity.Catalog}@{published.Identity.Version}" : string.Empty;
        var arguments = history is null
            ? JsonSerializer.SerializeToElement(new
            {
                gameId = game, attemptId = Attempt("setup"), expectedRevision = 0L,
                start = Start(catalog),
                placements = units,
            })
            : JsonSerializer.SerializeToElement(new { gameId = game, attemptId = Attempt("setup"), expectedRevision = (long)history.Events.Count, placements = units });
        gameId = game;
        await Propose(GameActions.Setup, arguments);
    }

    /// <summary>
    /// A placement as the setup action reads it: a SW in its holder's possession with its malfunction state (A9.1), a Dummy
    /// with only its concealment (A12.1), and any other unit at its Location with its full set of conditions.
    /// </summary>
    private static Dictionary<string, object?> PlacementArguments(Placement item)
    {
        var placement = new Dictionary<string, object?> { ["id"] = item.Id, ["kind"] = item.Kind, ["side"] = item.Side };
        if (item.Definition is not null)
        {
            placement["definition"] = item.Definition;
        }

        // Ruling R18.3: the unit's OB group.
        if (item.Group is { } group)
        {
            placement["group"] = group;
        }

        // D2.11: a vehicle stands at its Location with its VCA; its crew's state starts CE for an OT AFV (D5.3).
        if (item.Kind == "asl:vehicle")
        {
            // A2.52 (ruling R26.1): a vehicle waiting off board is in Motion and takes its VCA as it enters.
            placement["position"] = item.OffBoard ? OffBoardPosition(item) : new { at = item.Location, facing = item.Facing ?? "east" };
            var conditions = new Dictionary<string, bool> { ["asl:concealed"] = item.Concealed, ["asl:hidden"] = item.Hidden };

            // D3.45, D3.4 (pass 55, rulings R55.15, R55.18): an Inexperienced Crew is a condition; an Armor Leader his morale and his modifier.
            if (item.InexperiencedCrew)
            {
                conditions[Conditions.InexperiencedCrew] = true;
            }

            placement["conditions"] = conditions;
            if (item.ArmorLeader is { } grade && grade.LastIndexOf('-') is > 0 and var dash
                && int.TryParse(grade[..dash], CultureInfo.InvariantCulture, out var morale) && int.TryParse(grade[dash..], CultureInfo.InvariantCulture, out var leadership))
            {
                placement["armorLeader"] = new { morale, leadership };
            }

            return placement;
        }

        // C10.1 (ruling R26.1): a Gun in tow has no position of its own; it goes where its vehicle goes.
        if (item.Role == "towed" && item.Holder is { } tower)
        {
            placement["holding"] = new { holder = tower, role = "towed" };
            placement["conditions"] = new Dictionary<string, bool> { ["asl:malfunctioned"] = false };
            return placement;
        }

        if (item.Facing is { } facing)
        {
            placement["position"] = new { at = item.Location, facing };
            if (item.Holder is { } crew)
            {
                placement["holding"] = new { holder = crew, role = "manned" };
            }

            // A12.14 (ruling R8.5): a Gun is concealed or hidden with its crew.
            placement["conditions"] = new Dictionary<string, bool> { ["asl:malfunctioned"] = false, ["asl:concealed"] = item.Concealed, ["asl:hidden"] = item.Hidden };
            if (item.BoreSighted is { } sighted)
            {
                placement["boreSighted"] = sighted;
            }

            return placement;
        }

        if (item.Holder is { } holder && item.Role is not ("passenger" or "rider"))
        {
            placement["holding"] = new { holder, role = "possessed" };
            placement["conditions"] = new Dictionary<string, bool> { ["asl:malfunctioned"] = false };

            // C6.41, C6.42 (pass 45): a MMG's or HMG's Bore Sighted Location goes with it, as a Gun's does.
            if (item.BoreSighted is { } mgSighted)
            {
                placement["boreSighted"] = mgSighted;
            }

            return placement;
        }

        // A2.51 (ruling R20.5): a counter that enters waits off board.
        placement["position"] = item.Role is "passenger" or "rider" && item.Holder is { } vehicle ? new Dictionary<string, object> { ["in"] = vehicle, ["role"] = item.Role }
            : item.OffBoard ? OffBoardPosition(item) : new Dictionary<string, object> { ["at"] = item.Location };
        if (item.Kind == "asl:sniper")
        {
            placement["conditions"] = new Dictionary<string, bool>();
            return placement;
        }

        placement["conditions"] = item.Kind == UnitKinds.Dummy
            ? new Dictionary<string, bool> { ["asl:concealed"] = true, ["asl:hidden"] = item.Hidden }
            : new Dictionary<string, bool>
            {
                ["asl:broken"] = item.Broken, ["asl:berserk"] = false, ["asl:captured"] = false, ["asl:melee"] = false, ["asl:ti"] = false,
                ["asl:disrupted"] = false, ["asl:concealed"] = item.Concealed, ["asl:hidden"] = item.Hidden,
            };
        return placement;
    }

    /// <summary>A new game's start (rulings R18.1, R22.4): the card the game starts from, its label, and the Balance; the planner takes the rest from the card.</summary>
    private Dictionary<string, object?> Start(string catalog)
    {
        var start = new Dictionary<string, object?> { ["label"] = newLabel, ["catalog"] = catalog };
        if (scenarioCard is { } card && scenarioSha is { } sha256)
        {
            start["scenario"] = new Dictionary<string, string> { ["id"] = card, ["sha256"] = sha256, ["title"] = ChosenCard?.Title ?? card };

            // A26.4 (ruling R20.3): the Balance by agreement, or the side both players wish to play.
            if (newBalance.StartsWith("agree:", StringComparison.Ordinal))
            {
                start["balance"] = new Dictionary<string, object> { ["side"] = newBalance["agree:".Length..] };
            }
            else if (newBalance.StartsWith("wish:", StringComparison.Ordinal))
            {
                var wished = newBalance["wish:".Length..];
                start["balance"] = new Dictionary<string, object>
                {
                    ["players"] = new[]
                    {
                        new Dictionary<string, string> { ["name"] = playerOne.Trim(), ["wants"] = wished },
                        new Dictionary<string, string> { ["name"] = playerTwo.Trim(), ["wants"] = wished },
                    },
                };
            }
        }

        return start;
    }

