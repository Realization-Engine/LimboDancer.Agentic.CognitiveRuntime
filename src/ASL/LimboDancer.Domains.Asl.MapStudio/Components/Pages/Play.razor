    // The view the page shows, read once per history and viewer: every panel reads it, and a side's view asks the card setup who is setting up now.
    private (GameHistory? History, long Revision, string Viewer, GameView? View) viewCache;

    private GameView? View
    {
        get
        {
            if (state is null || history?.Current is null)
            {
                return null;
            }

            if (viewCache.View is null || !ReferenceEquals(viewCache.History, history) || viewCache.Revision != state.Revision || viewCache.Viewer != Viewer.Name)
            {
                // Pass 70 (ruling R70.18): the planner's one entry, with the groups out of sight and the stacks the viewer may not inspect (A12.16).
                viewCache = (history, state.Revision, Viewer.Name, Live.Planner.ViewOf(history, state.Revision, Viewer));
            }

            return viewCache.View;
        }
    }

