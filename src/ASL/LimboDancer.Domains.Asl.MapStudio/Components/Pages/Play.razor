    /// <summary>The levels of a hex that a counter may set up on: the ground, and each level of its building.</summary>
    private static IReadOnlyList<int> LevelsAt(StudioBoard board, BoardLocation at) => GameMaps.FactsAt(board, at) is { } facts
        ? [.. facts.Locations.Where(level => level.Level == 0 || (level.Level > 0 && level.Terrain is { IsBuilding: true })).Select(level => level.Level).Distinct().Order()]
        : [0];

