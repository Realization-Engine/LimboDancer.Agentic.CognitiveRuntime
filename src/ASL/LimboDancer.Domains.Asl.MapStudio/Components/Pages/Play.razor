        return [.. SeenOnly(state.At(at).OfType<UnitInstance>().Where(unit => unit.Status == InstanceStatus.Active && unit.Side == vehicle.Side && !LiveFire.IsVehicle(unit)
            && unit.Kind != UnitKinds.Dummy && Library.Vocabulary.IsA(unit.Kind, "asl:personnel") && !unit.MovementEnded
            && GameState.Condition(unit, Conditions.Broken) != ConditionState.True && GameState.Condition(unit, Conditions.Pinned) != ConditionState.True))
            .Select(unit => unit.Id).Order(StringComparer.Ordinal)];
