    // Pass 71's fixes (R5's finding 16; the Memory and Performance Guidelines, page projections by state and viewer): both lists built once for a state, a
    // view, and the units checked, not at each render; the planner's index reads each unit.
    private (GameState? State, string View, string Checked, IReadOnlyList<PlayChoice> Men, IReadOnlyList<PlayChoice> Carriers) carryCache = (null, string.Empty, string.Empty, [], []);

    private (IReadOnlyList<PlayChoice> Men, IReadOnlyList<PlayChoice> Carriers) CarryChoices
    {
        get
        {
            if (state is null || moveUnits.Count < 2)
            {
                return ([], []);
            }

            var ticked = string.Join(',', moveUnits.Order(StringComparer.Ordinal));
            if (!ReferenceEquals(carryCache.State, state) || carryCache.View != Viewer.Name || carryCache.Checked != ticked)
            {
                UnitInstance[] units = [.. SeenOnly(moveUnits.Select(id => Live.Planner.UnitOf(state, id)).OfType<UnitInstance>()).OrderBy(unit => unit.Id, StringComparer.Ordinal)];
                carryCache = (state, Viewer.Name, ticked,
                    [.. units.Where(unit => GameState.Condition(unit, Conditions.Wounded) == ConditionState.True && state.Movement?.Carried?.Any(carry => carry.Man == unit.Id) != true)
                        .Select(unit => new PlayChoice(unit.Id, unit.Id))],
                    [.. units.Where(unit => Library.Vocabulary.IsA(unit.Kind, "asl:mmc") && state.Movement?.Carried?.Any(carry => carry.Carrier == unit.Id) != true)
                        .Select(unit => new PlayChoice(unit.Id, unit.Id))]);
            }

            return (carryCache.Men, carryCache.Carriers);
        }
    }

