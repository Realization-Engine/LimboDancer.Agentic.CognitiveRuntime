                {
                    <span class="play-outcome-summary" title="@barOutcome.Summary">@(barOutcome.Summary.Length > 75 ? barOutcome.Summary[..72] + "..." : barOutcome.Summary)</span>
                }
            </div>
            <div id="play-outcome-panel-content" hidden="@outcomePanelCollapsed">
