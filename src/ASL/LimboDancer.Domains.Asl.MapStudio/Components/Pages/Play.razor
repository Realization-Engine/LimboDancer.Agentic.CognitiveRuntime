    private string GunLabel(EquipmentInstance gun)
    {
        bool Marked(IGameObject item, string condition) => GameState.Condition(item, condition) == ConditionState.True;
        var facing = gun.Position is MapPosition { Facing: { } spine } ? UnitFacings.Name(spine) : "no facing";
        var shots = state?.OrdnanceShots.FirstOrDefault(item => item.Gun == gun.Id);
        var acquired = state?.Acquisitions.FirstOrDefault(item => item.Gun == gun.Id);
