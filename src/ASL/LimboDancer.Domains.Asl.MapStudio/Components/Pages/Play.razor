    private IEnumerable<UnitInstance> LeadersWith(string unitId) => state?.Unit(unitId) is not { } unit ? []
        : state.Location(unit.Id)?.Location is { } at
            ? SeenOnly(state.At(at).OfType<UnitInstance>().Where(other => other.Status == InstanceStatus.Active && other.Kind == "asl:leader" && other.Side == unit.Side
                && GameState.Condition(other, Conditions.Broken) != ConditionState.True))
            // Ruling R25.4: off board, the leaders waiting to enter along the same edge.
            : WaitsToEnter(unit) && Live.Planner.EntryFor(state, unit) is { } entry
                ? SeenOnly(state.Units.Where(other => other.Status == InstanceStatus.Active && other.Kind == "asl:leader" && other.Side == unit.Side
                    && GameState.Condition(other, Conditions.Broken) != ConditionState.True && WaitsToEnter(other) && Live.Planner.EntryFor(state, other)?.Edge == entry.Edge))
                : [];

    /// <summary>Whether a unit waits off board and its entry turn has come (A2.5, A2.51; rulings R20.5, R25.4).</summary>
    private bool WaitsToEnter(UnitInstance unit) => state is not null && unit.Position is OffMapPosition && state.Location(unit.Id) is null
        && Live.Planner.EntryFor(state, unit) is { } entry && entry.Turn <= state.Turn;

