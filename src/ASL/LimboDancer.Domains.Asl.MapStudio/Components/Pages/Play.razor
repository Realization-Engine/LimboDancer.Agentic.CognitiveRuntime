    private void SetStackLevel(SetupCounters.LevelChange change)
    {
        if (!BoardLocation.TryParse(change.Location, out var at))
        {
            return;
        }

        var moved = (at with { Level = change.Level }).ToString();
        for (var index = 0; index < placements.Count; index++)
        {
            if (OnMap(placements[index]) && placements[index].Location == change.Location)
            {
                placements[index] = placements[index] with { Location = moved };
            }
        }

        selectedStack = moved;
        pickingKey = pickingKey == SetupCounters.StackKey(change.Location) ? SetupCounters.StackKey(moved) : pickingKey;
        ListChanged();
    }

    /// <summary>A reason of a refused setup leads to its counter: the Counters tab, its stack, and its hex.</summary>
    private void ShowRow(string key)
    {
        if (placements.FirstOrDefault(row => row.Key == key) is not { } row)
        {
            return;
        }

        var standing = row.Holder is { } holder && row.Role != "manned" ? placements.FirstOrDefault(other => other.Id == holder) ?? row : row;
        (setupTab, shownPlan, revealId) = ("counters", null, $"setup-row-{row.Id}");
        if (OnMap(standing) && BoardLocation.TryParse(standing.Location, out var at))
