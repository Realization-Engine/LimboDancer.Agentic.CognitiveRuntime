    /// <summary>The firing side's Guns that its crews man (A21.13), a malfunctioned one shown as such (C2.28; Gun repair is not built).</summary>
    private IEnumerable<EquipmentInstance> OrdnanceGuns(string side) => state is null ? []
        : state.Equipment.Where(item => item.Status == InstanceStatus.Active && item.Kind == "asl:gun" && item.Holding is { Role: HoldingRole.Manned } holding
                && state.Unit(holding.Holder)?.Side == side)
            .OrderBy(item => item.Id, StringComparer.Ordinal);

    /// <summary>A Gun as a player reads it: its facing, its fire this phase and Player Turn, its Acquisition, and its crew's state.</summary>
    private string GunLabel(EquipmentInstance gun)
    {
        bool Marked(IGameObject item, string condition) => GameState.Condition(item, condition) == ConditionState.True;
        var facing = gun.Position is MapPosition { Facing: { } spine } ? UnitFacings.Name(spine) : "no facing";
        var shots = state?.OrdnanceShots.FirstOrDefault(item => item.Gun == gun.Id);
        var acquired = state?.Acquisitions.FirstOrDefault(item => item.Gun == gun.Id);
        var crew = gun.Holding is { } holding ? state?.Unit(holding.Holder) : null;
        var crewState = crew is null ? "" : string.Concat(new[] { Conditions.Pinned, Conditions.Concealed, Conditions.Melee, Conditions.Broken }
            .Where(name => Marked(crew, name)).Select(name => ", crew " + name.Replace("asl:", "", StringComparison.Ordinal)));
        return $"{gun.Id} ({gun.Definition?.Definition}, facing {facing}"
            + (Marked(gun, Conditions.Malfunctioned) ? ", malfunctioned: Gun repair is not built" : "")
            + (shots is null ? Marked(gun, Conditions.PrepFire) || Marked(gun, Conditions.FinalFire) ? ", fired this Player Turn" : ""
                : shots.RateOfFireKept ? $", {shots.Shots} shot(s), may fire again" : ", fired")
            + (acquired is null ? "" : $", Acquisition {acquired.Level} on {acquired.Location}") + crewState + ")";
    }

