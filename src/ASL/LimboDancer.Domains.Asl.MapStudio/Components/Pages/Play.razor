    /// <summary>What the page knows of a hex beyond its counters, for the Selection tab: Residual FP (A8.2), which is public, and a Melee the view holds a unit of.</summary>
    private IReadOnlyList<string> HexNotes(HexFacts facts)
    {
        if (state is null || MapLayers?.Board is not { } board || !BoardLocation.TryParse(board.LocationOf(facts), out var hex))
        {
            return [];
        }

        bool Here(BoardLocation at) => at.Board == hex.Board && at.Hex == hex.Hex;
        return [.. ParentNotes(board, hex.Hex.ToString()), .. state.ResidualFire.Where(item => Here(item.Location)).Select(item => $"{item.Fp} Residual FP in {PlaceOf(item.Location)} (A8.2)"),
            .. VisibleUnits.Where(unit => GameState.Condition(unit, Conditions.Melee) == ConditionState.True && state.Location(unit.Id)?.Location is { } at && Here(at))
                .Select(unit => state.Location(unit.Id)!.Location).Distinct().Select(at => $"Melee in {PlaceOf(at)} (A11.15)")];
    }

    private IReadOnlyList<string> ReadHappened(long since)
    {
        {
            var state = this.state!;
            var lines = new List<(string Text, int Count, BoardLocation[] At)>();
            var named = Array.Empty<BoardLocation>();
            void At(params string?[] locations) => named = [.. locations.Select(text => BoardLocation.TryParse(text, out var at) ? at with { Level = 0 } : null).OfType<BoardLocation>()];
            // One line for a stack, whatever its count of counters, as the records have it (the referee, pass 31d).
            var dummyStacks = new HashSet<string>(StringComparer.Ordinal);
            foreach (var item in history!.Events.Where(item => item.Visibility is null && (since < 0 || item.Revision > since)))
            {
                var line = item.Payload switch
                {
                    PhaseChanged phase => $"{DisplayText.Side(phase.PhasingSide)} {Games.PhaseLabel(phase.Phase)}, Turn {phase.Turn}.",
                    MovementStepped step => $"A stack moved into {PlaceOf(step.To)}.",
                    AdvanceMoved advance => $"Units advanced into {PlaceOf(advance.To)}.",
                    // The UI review (A10.711, A12.14): the hand-over names no unit, and a Voluntary Rout leader may be under "?" out of every enemy LOS.
                    RoutStepped rout => $"A broken unit routed to {PlaceOf(rout.To)}.",
                    VoluntaryBreak voluntary => voluntary.Units.Count == 1 ? "A unit broke voluntarily." : "Units broke voluntarily.",
                    UnitsSearched search => $"A stack Searched from {PlaceOf(search.Location)}.",
                    FireResolved fire when fire.Resolution.Deserialize<FireResolution>(LiveFire.Json) is { Arithmetic: { } arithmetic }
                        => $"Fire from {PublicLocation(fire.FirerLocation)} at {PublicLocation(fire.TargetLocation)}: {arithmetic.Result}.",
                    FireReported report when report.Arithmetic.Deserialize<FireArithmetic>(LiveFire.Json) is { } reported
                        => $"Fire from {PublicLocation(report.FirerLocation)} at {PublicLocation(report.TargetLocation)}: {reported.Result}.",
                    CloseCombatResolved combat => $"A round of Close Combat in {PlaceOf(combat.Location)}.",
                    InstanceEliminated gone when state.Unit(gone.Id) is { } unit && unit.Kind != UnitKinds.Dummy => $"A {DisplayText.Side(unit.Side)} unit was eliminated.",

                    // Pass 31d (ruling R31d.3, which amends R31.7's "a Dummy gives no line"): both sides saw the counters leave the map.
                    InstanceEliminated gone when state.Unit(gone.Id) is { Kind: UnitKinds.Dummy } dummy
                        => dummyStacks.Add($"{ReplaySteps.AttemptOf(item.EventId)}|{history.At(item.Revision - 1)?.Location(dummy.Id)?.Location}|{dummy.Side}") ? $"{DisplayText.ASide(dummy.Side)} Dummy stack was removed." : null,
                    InstanceCaptured taken when state.Unit(taken.Id) is { } prisoner => $"A {DisplayText.Side(prisoner.Side)} unit was captured.",
                    // Pass 71 (A14.4; rulings R71.9, R71.10): a Sniper Check made in public, and a Sniper eliminated, named by side only.
                    SniperChecked check => $"A Sniper Check was made in {PlaceOf(check.Location)}.",
                    SanReduced reduced => $"The {DisplayText.Side(reduced.Side)} Sniper was eliminated, and its SAN "
                        + (PlayRecords.SanUnchanged(history.At(item.Revision - 1), reduced.Side) ? "stays at the printed SAN at night (E1.76)." : "is lower."),
                    // Pass 71 (A14.2; ruling R71.12): the Sniper player forfeited an attack, and his counter was repositioned in public.
                    SniperAttacked { Result: ScenarioA1Sniper.Forfeited, Target: { } to } forfeited
                        => $"The {DisplayText.Side(state.Find(forfeited.Sniper)?.Side)} Sniper forfeited its attack and was repositioned to {PlaceOf(to)}.",
                    GameEnded => "The game ended.",
                    _ => null,
                };
                if (line is null)
                {
                    continue;
                }

                named = [];
                switch (item.Payload)
                {
                    case MovementStepped moved: At(moved.To.ToString()); break;
                    case AdvanceMoved advanced: At(advanced.To.ToString()); break;
                    case RoutStepped routed: At(routed.To.ToString()); break;
                    case FireResolved fired: At(fired.FirerLocation, fired.TargetLocation); break;
                    case FireReported reportedFire: At(reportedFire.FirerLocation, reportedFire.TargetLocation); break;
                    case CloseCombatResolved fought: At(fought.Location.ToString()); break;
                }

                // Table player, pass 31: the same thing several times in a row is counted, not dropped.
                if (lines.Count > 0 && lines[^1].Text == line)
                {
                    lines[^1] = (line, lines[^1].Count + 1, lines[^1].At);
                }
                else
                {
                    lines.Add((line, 1, named));
                }

                // A11.19 (ruling R31d.3): the Dummies the game removes as the CCPh begins, for which it records no event, read from the two states.
                if (item.Payload is PhaseChanged { Phase: "ccph" } && history.At(item.Revision - 1) is { } before && history.At(item.Revision) is { } begun)
                {
                    foreach (var gone in before.Units.Where(unit => unit.Kind == UnitKinds.Dummy && unit.Status == InstanceStatus.Active && begun.Unit(unit.Id) is { Status: InstanceStatus.Eliminated }
                        && before.Location(unit.Id) is not null).GroupBy(unit => (At: before.Location(unit.Id)!.Location, unit.Side)).OrderBy(group => group.Key.At.ToString(), StringComparer.Ordinal))
                    {
                        lines.Add(($"{DisplayText.Side(gone.Key.Side)} Dummies were removed in {PlaceOf(gone.Key.At)} before Close Combat.", 1, [gone.Key.At with { Level = 0 }]));
                    }
                }
            }

            // The map outlines the Locations of the lines shown, and no others.
            happenedAt = [.. lines.TakeLast(since < 0 ? 6 : 30).SelectMany(item => item.At).Distinct()];

            // With nothing to count from, the latest few; otherwise everything since, capped so the screen stays a screen.
            return [.. lines.TakeLast(since < 0 ? 6 : 30).Select(item => item.Count == 1 ? item.Text : $"{item.Text} ({item.Count} times)")];
        }
    }

