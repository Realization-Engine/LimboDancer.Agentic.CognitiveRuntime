    private IReadOnlyList<AmbushWithdrawalActions.Withdrawal>? AmbushWithdrawals => state is not null && CloseCombatEntry is { Ambusher: { } ambushing } withdrawing
        && (withdrawing.Rounds.Count == 0 || withdrawing.Closed) && (Viewer.IsAdjudicator || viewAs == ambushing) && BoardLocation.TryParse(ccLocation, out var ambushAt)
        ? [.. CloseCombatUnits.Where(unit => unit.Side == ambushing && GameState.Condition(unit, Conditions.Captured) != ConditionState.True)
            // Pass 70 (ruling R70.26): with no SW dropped, as this list offers none to drop; a unit above its IPC withdraws in a CC round instead.
            .SelectMany(unit => Live.Planner.WithdrawalDestinations(state, unit, ambushAt, []).Select(to => new AmbushWithdrawalActions.Withdrawal(unit.Id, to.ToString())))]
        : null;

    /// <summary>The SMC the view may declare stacking for (plan C04; ruling R23.1), each with the MMC of its side in the Location.</summary>
    private IReadOnlyList<CloseCombatStacking.Smc> StackingChoices => [.. CloseCombatUnits
        .Where(unit => Library.Vocabulary.IsA(unit.Kind, "asl:smc") && !Prisoner(unit) && (Viewer.IsAdjudicator || viewAs == unit.Side))
        .Select(smc => new CloseCombatStacking.Smc(smc.Id, [.. CloseCombatUnits.Where(unit => unit.Side == smc.Side && Library.Vocabulary.IsA(unit.Kind, "asl:mmc") && !Prisoner(unit)).Select(unit => unit.Id)]))];

    /// <summary>Pass 31 (play test P-25; A20.54, A20.55): a prisoner takes no part in CC but in its escape round.</summary>
    private static bool Prisoner(UnitInstance unit) => GameState.Condition(unit, Conditions.Captured) == ConditionState.True;

    /// <summary>Pass 31 (play test P-25): whether a unit is already in an attack declared for this round, so it is not offered again (A11.12).</summary>
    private bool Declared(UnitInstance unit, bool attacking) => ccAttacks.Any(attack => (attacking ? attack.Attackers : attack.Defenders).Contains(unit.Id, StringComparer.Ordinal));

    /// <summary>Pass 31 (ruling R31.6): the side that declared an attack, read from its first attacker.</summary>
    private bool MayRemoveAttack(CloseCombatPanel.DeclaredAttack attack) => Viewer.IsAdjudicator || attack.Attackers.Select(id => state?.Unit(id)?.Side).FirstOrDefault(side => side is not null) == viewAs;

    /// <summary>
    /// Pass 31 (play test P-04; A11.14): an MMC is attacked together with every SMC stacked with it, so ticking or unticking the MMC as a target does
    /// the same for those SMC.
    /// </summary>
    private void ToggleDefender(string id, bool on)
    {
        Toggle(ccDefenders, id, on);
        foreach (var smc in ccStacking.Where(pair => pair.Value == id).Select(pair => pair.Key).ToArray())
        {
            // UI review, pass 31: only a SMC still in the Location, and not yet a target of a declared attack.
            // Referee, pass 31 (ruling R23.1): never a SMC of the other side that is under "?"; the stacking of concealed units is not this view's to read.
            if (CloseCombatUnits.FirstOrDefault(unit => unit.Id == smc) is { } stacked && !Prisoner(stacked) && !Declared(stacked, attacking: false)
                && (Mine(stacked) || GameState.Condition(stacked, Conditions.Concealed) != ConditionState.True))
            {
                Toggle(ccDefenders, smc, on);
            }
        }
    }

    // The Memory and Performance Guidelines (page projections by state and viewer; the UI review of pass 70, finding 3): the CC panels' withdrawers and
    // infiltrators, each read once a state, view, CC Location, and set of SW ticked to drop, since each scans the SW of every unit there and its destinations.
    private (GameState? State, string Viewer, string? As, string Location, string Drops, IReadOnlyList<CloseCombatWithdrawals.Withdrawer> Rows) withdrawersCache;
    private (GameState? State, string Viewer, string? As, string Location, string Drops, IReadOnlyList<CloseCombatInfiltrationChoices.Infiltrator>? Rows) infiltratorsCache;

    // The SW ticked to drop, as the CC caches above key them.
    private string DropsKey => ccDrops.Count == 0 ? string.Empty : string.Join('|', ccDrops.Order(StringComparer.Ordinal));

    /// <summary>The units that may withdraw from Melee (plan C05), as a player reads them, with whether each must try; read once a state, view, Location, and drops.</summary>
    private IReadOnlyList<CloseCombatWithdrawals.Withdrawer> Withdrawers
    {
        get
        {
            var drops = DropsKey;
            if (ReferenceEquals(withdrawersCache.State, state) && withdrawersCache.Rows is not null && withdrawersCache.Viewer == Viewer.Name && withdrawersCache.As == viewAs
                && withdrawersCache.Location == ccLocation && withdrawersCache.Drops == drops)
            {
                return withdrawersCache.Rows;
            }

            IReadOnlyList<CloseCombatWithdrawals.Withdrawer> rows = [.. WithdrawalUnits.Select(item => new CloseCombatWithdrawals.Withdrawer(item.Unit.Id, UnitLabel(item.Unit),
                Live.Planner.MustWithdraw(state!, item.Unit), [.. item.Destinations.Select(to => to.ToString())])
            {
                Drops = DropChoices(item.Unit),
            })];
            withdrawersCache = (state, Viewer.Name, viewAs, ccLocation, drops, rows);
            return rows;
        }
    }

    /// <summary>The sides the view may declare attacks for (plan C06; ruling R23.1), each with its units and the other sides' units.</summary>
    // Pass 70 (the hex UI rule; ruling R70.27): each unit hex first, "[D10]: 2-2-8 crew R1", a Gun's crew among them.
    private IReadOnlyList<CloseCombatAttackBuilder.DeclaringSide> DeclaringSides => [.. CloseCombatSides.Where(side => Viewer.IsAdjudicator || viewAs == side)
        .Select(side => new CloseCombatAttackBuilder.DeclaringSide(side, side == state!.PhasingSide,
            [.. CloseCombatUnits.Where(unit => unit.Side == side && Prisoner(unit) == (ccRound == CloseCombatResolved.PrisonersRound) && !Declared(unit, attacking: true))
                .Select(unit => new CloseCombatAttackBuilder.Participant(unit.Id, CcLabel(unit), IsBroken(unit)))],
            [.. CloseCombatUnits.Where(unit => unit.Side != side && !Prisoner(unit) && !Declared(unit, attacking: false))
                .Select(unit => new CloseCombatAttackBuilder.Participant(unit.Id, CcLabel(unit), IsBroken(unit)))]))];

    // Pass 70's fixes (the hex UI rule): the other side's unit reads "4-4-7 squad in [N5]", so under "[N5]: " it does not say the hex again.
    private string CcLabel(UnitInstance unit)
    {
        var place = PlaceOf(ccLocation);
        return $"{place}: {UnitGrouping.WithoutPlace(Words(unit.Id), place)}{UnitLabel(unit)[unit.Id.Length..]}";
    }

    /// <summary>
    /// The units the view may declare an infiltration for (plan N08; A11.22): not berserk or Disrupted, with somewhere to go. Read only while attacks
    /// may be declared; null when the Location cannot be read. Read once a state, view, Location, and drops.
    /// </summary>
    private IReadOnlyList<CloseCombatInfiltrationChoices.Infiltrator>? Infiltrators
    {
        get
        {
            var drops = DropsKey;
            if (ReferenceEquals(infiltratorsCache.State, state) && state is not null && infiltratorsCache.Viewer == Viewer.Name && infiltratorsCache.As == viewAs
                && infiltratorsCache.Location == ccLocation && infiltratorsCache.Drops == drops)
            {
                return infiltratorsCache.Rows;
            }

            IReadOnlyList<CloseCombatInfiltrationChoices.Infiltrator>? rows = state is not null && !AmbushDue && BoardLocation.TryParse(ccLocation, out var at)
                ? [.. CloseCombatUnits.Where(unit => (Viewer.IsAdjudicator || viewAs == unit.Side) && !Prisoner(unit)
                        && GameState.Condition(unit, Conditions.Berserk) != ConditionState.True && GameState.Condition(unit, Conditions.Disrupted) != ConditionState.True)
                    .Select(unit => (unit, Choice: new CloseCombatInfiltrationChoices.Infiltrator(unit.Id, [.. Live.Planner.WithdrawalDestinations(state, unit, at, DropsTicked(unit)).Select(to => to.ToString())])
                    {
                        Drops = DropChoices(unit),
                    }))
                    .Where(item => item.Choice.Destinations.Count > 0 || MayWithdrawByDropping(item.unit, at)).Select(item => item.Choice)]
                : null;
            infiltratorsCache = (state, Viewer.Name, viewAs, ccLocation, drops, rows);
            return rows;
        }
    }

    private void SetStacking(string smc, string? mmc)
    {
        if (string.IsNullOrEmpty(mmc))
        {
            ccStacking.Remove(smc);
        }
        else
        {
            ccStacking[smc] = mmc;
        }
    }

    private void AddAttack()
    {
        string[] yielded = [.. ccYield.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)];

        // Pass 31 (play test P-10; A20.22): a capture attempt on several units needs the defender's order of choice; left empty, it is the targets' order.
        if (ccCapture && yielded.Length == 0 && ccDefenders.Count > 1)
        {
            // Table player, pass 31: an MMC before a SMC, so the default does not give up a leader first.
            yielded = [.. ccDefenders.OrderBy(id => state?.Unit(id) is { } unit && Library.Vocabulary.IsA(unit.Kind, "asl:smc")).ThenBy(id => id, StringComparer.Ordinal)];
        }

        ccAttacks.Add(new CloseCombatPanel.DeclaredAttack([.. ccAttackers.Order(StringComparer.Ordinal)], [.. ccDefenders.Order(StringComparer.Ordinal)],
            ccDirector.Length > 0 && ccAttackers.Contains(ccDirector) ? ccDirector : null, ccCapture, ccCapture && yielded.Length > 0 ? yielded : null,
            ccCapture && ccGuard.Length > 0 && ccAttackers.Contains(ccGuard) ? ccGuard : null));
        ccAttackers.Clear();
        ccDefenders.Clear();
        ccDirector = string.Empty;
        ccCapture = false;
        ccGuard = string.Empty;
        ccYield = string.Empty;
    }

    /// <summary>Pass 31 (play test P-04): the stacking is the Location's own, so a round resolved or cancelled leaves it as it was read.</summary>
    private void ClearCloseCombat()
    {
        ClearCloseCombatDraft();
        DefaultStacking();
    }

    private void ClearCloseCombatDraft()
    {
        ccAttackers.Clear();
        ccDefenders.Clear();
        ccDirector = string.Empty;
        ccRound = string.Empty;
        ccStacking.Clear();
        ccWithdrawals.Clear();
        ccDrops.Clear();
        ccAttacks.Clear();
        ccInfiltrations.Clear();
        ccHandToHand = false;
        ccCapture = false;
        ccGuard = string.Empty;
        ccYield = string.Empty;
    }

    private Task ProposeAmbush() => Propose(GameActions.Ambush, JsonSerializer.SerializeToElement(new
    {
        gameId, attemptId = Attempt("amb"), expectedRevision = (long)history!.Events.Count, location = ccLocation,
    }));

    // ---- A11.11 (the user, 2026-10-22): a simultaneous round is declared by both sides, the ATTACKER first, before it is resolved. A side's view
    // declares only its own side's attacks, so the first side's declaration is kept (LivePlay.Declarations) while the screen is handed over, and
    // the second side's view resolves every attack together. The adjudicator declares for both at once, as before.

    /// <summary>The first side's declaration kept for this game at its revision, in whatever Location.</summary>
    private CloseCombatSideDeclaration? CcKeptForGame => history is null || gameId.Length == 0 ? null : Live.Declarations.Of(gameId, history.Events.Count);

    /// <summary>The declaration kept for the chosen Location.</summary>
    private CloseCombatSideDeclaration? CcKept => CcKeptForGame is { } kept && kept.Location == ccLocation ? kept : null;

    /// <summary>Whether this round is declared in two steps: two sides declare (a simultaneous round), in a side's view.</summary>
    private bool CcTwoStep => !Viewer.IsAdjudicator && ccRound != CloseCombatResolved.PrisonersRound && CloseCombatSides.Count == 2;

    /// <summary>What the view does with its declarations: resolve the round, declare and hand over, or wait for the first side.</summary>
    private string CcStep => !CcTwoStep || CcKept is { } kept && kept.Side != viewAs ? CloseCombatPanel.ResolveStep
        : viewAs == CloseCombatSides[0] ? CloseCombatPanel.DeclareStep
        : CloseCombatPanel.WaitStep;

    /// <summary>The first side's declared attacks, which the second side's view reads before it declares its own; null when there are none to read.</summary>
    private CloseCombatSideDeclaration? CcOtherDeclared => CcKept is { } kept && kept.Side != viewAs ? kept : null;

    /// <summary>The first side declares: its declarations are kept for the revision, and the screen goes to the other side.</summary>
    private void DeclareCloseCombat()
    {
        if (history is null || CloseCombatSides is not [var first, var second] || viewAs != first)
        {
            return;
        }

        Live.Declarations.Declare(gameId, new CloseCombatSideDeclaration(viewAs, ccLocation, history.Events.Count, ccRound, [.. ccAttacks],
            new Dictionary<string, string>(ccStacking, StringComparer.Ordinal), new Dictionary<string, string>(ccWithdrawals, StringComparer.Ordinal),
            new Dictionary<string, string>(ccInfiltrations, StringComparer.Ordinal), ccHandToHand)
        {
            Drops = [.. ccDrops.Order(StringComparer.Ordinal)],
        });
        status = $"The {DisplayText.Side(first)} side has declared its CC attacks in {PlaceOf(ccLocation)}; the {DisplayText.Side(second)} side declares its own next (A11.11).";
        ChangeView(second);
    }

    /// <summary>The escape hatch (the user, 2026-10-22): every declaration of the round, kept or drafted, is dropped, and the round starts over.</summary>
    private void ClearAllCloseCombat()
    {
        if (CcKeptForGame is not null)
        {
            Live.Declarations.Drop(gameId);
        }

        var at = ccLocation;
        ClearCloseCombat();
        ccLocation = at;
        status = $"Every CC declaration in {PlaceOf(at)} is cleared; the round starts over, the ATTACKER declaring first (A11.11).";
    }

    private Task ProposeCloseCombat()
    {
        // The second side resolves the round with the first side's declarations kept for it; each Location's draft holds the view's own.
        var kept = CcOtherDeclared;
        var attacks = kept is null ? ccAttacks : [.. kept.Attacks, .. ccAttacks];
        var stacking = new Dictionary<string, string>(ccStacking, StringComparer.Ordinal);
        var withdrawals = new Dictionary<string, string>(ccWithdrawals, StringComparer.Ordinal);
        var infiltrations = new Dictionary<string, string>(ccInfiltrations, StringComparer.Ordinal);
        foreach (var (from, into) in new[] { (kept?.Stacking, stacking), (kept?.Withdrawals, withdrawals), (kept?.Infiltrations, infiltrations) })
        {
            foreach (var (unit, value) in from ?? new Dictionary<string, string>())
            {
                into[unit] = value;
            }
        }

        string[] declared = kept is null ? [.. CloseCombatSides] : [kept.Side, viewAs];

        // A11.21 (ruling R70.26): the SW dropped by the units that withdraw or infiltrate, of both declarations.
        string[] dropped = [.. ccDrops.Concat(kept?.Drops ?? []).Distinct(StringComparer.Ordinal).Where(weapon => state?.Find(weapon) is EquipmentInstance { Holding: { } holder }
            && (withdrawals.ContainsKey(holder.Holder) || infiltrations.ContainsKey(holder.Holder))).Order(StringComparer.Ordinal)];
        return ProposeCloseCombat(attacks, stacking, withdrawals, infiltrations, kept?.HandToHand ?? ccHandToHand, kept?.Round ?? ccRound, declared, dropped);
    }

    private Task ProposeCloseCombat(IReadOnlyList<CloseCombatPanel.DeclaredAttack> declaredAttacks, Dictionary<string, string> stacking, Dictionary<string, string> withdrawals,
        Dictionary<string, string> infiltrations, bool handToHand, string round, string[] declaredSides, string[]? dropped = null) => Propose(GameActions.CloseCombat, JsonSerializer.SerializeToElement(new Dictionary<string, object>
    {
        ["gameId"] = gameId,
        ["attemptId"] = Attempt("cc"),
        ["expectedRevision"] = (long)history!.Events.Count,
        ["location"] = ccLocation,
        ["declaredSides"] = declaredSides,
        ["attacks"] = declaredAttacks.Select(attack =>
        {
            var declared = new Dictionary<string, object> { ["attackers"] = attack.Attackers, ["defenders"] = attack.Defenders };
            if (attack.Director is { } director)
            {
                declared["director"] = director;
            }

            if (attack.Capture)
            {
                declared["capture"] = true;
            }

            if (attack.Yield.Length > 0)
            {
                declared["yield"] = attack.Yield;
            }

            if (attack.Guard is { } guard)
            {
                declared["guard"] = guard;
            }

            return declared;
        }).ToArray(),
        ["stacking"] = stacking,
        ["withdrawals"] = withdrawals,
        ["infiltrations"] = infiltrations,

        // A11.21 (pass 70, ruling R70.26): the SW the units that withdraw drop; an empty list drops none.
        ["drops"] = dropped ?? [],
        ["handToHand"] = handToHand,
        ["round"] = round,
    }));

    private Task ProposeTakePrisoner(string unit, string captor) => Propose(GameActions.TakePrisoner, JsonSerializer.SerializeToElement(new
    {
        gameId, attemptId = Attempt("cap"), expectedRevision = (long)history!.Events.Count, unitId = unit, captorId = captor,
    }));

    // D3.5 (pass 50): a tank names the BMG and CMG that fire; a vehicle whose MA is its MG names none.
    private Task ProposeBoundingFire() => Propose(GameActions.Fire, JsonSerializer.SerializeToElement(
        state?.Unit(vehicleUnit) is { } tank && VehicleMgChoices(tank) is { Count: > 0 } mgs
            ? new Dictionary<string, object>
            {
                ["gameId"] = gameId, ["attemptId"] = Attempt("bff"), ["expectedRevision"] = (long)history!.Events.Count, ["firers"] = new[] { vehicleUnit },
                ["target"] = boundingTarget,
                ["weapons"] = new Dictionary<string, string[]>
                {
                    [vehicleUnit] = [.. mgs.Where(weapon => weapon.Bar is null && boundingWeapons.Contains(weapon.Id)).Select(weapon => VehicleMgName(weapon.Id))],
                },
            }
            : new Dictionary<string, object>
            {
                ["gameId"] = gameId, ["attemptId"] = Attempt("bff"), ["expectedRevision"] = (long)history!.Events.Count, ["firers"] = new[] { vehicleUnit },
                ["target"] = boundingTarget,
            }));

    private readonly HashSet<string> boundingWeapons = new(StringComparer.Ordinal);

    /// <summary>The enemy vehicles the view sees in the Bounding First Fire target (C3.31; pass 50), for the MA's Vehicle Target Type.</summary>
    private IReadOnlyList<PlayChoice> BoundingVehicleChoices(string side) => state is null || !BoardLocation.TryParse(boundingTarget, out var at) ? []
        : [.. SeenOnly(state.At(at).OfType<UnitInstance>().Where(unit => unit.Status == InstanceStatus.Active && unit.Side != side && LiveFire.IsVehicle(unit))
            .OrderBy(unit => unit.Id, StringComparer.Ordinal)).Select(vehicle => new PlayChoice(vehicle.Id, $"{vehicle.Id} ({vehicle.Definition?.Definition})"))];

    // D3.3, C5.3 (pass 50): the moving vehicle's MA in Bounding First Fire, at a vehicle named or at the Location's Infantry.
    private Task ProposeBoundingMa()
    {
        var arguments = new Dictionary<string, object>
        {
            ["gameId"] = gameId, ["attemptId"] = Attempt("bffma"), ["expectedRevision"] = (long)history!.Events.Count, ["gunId"] = vehicleUnit, ["target"] = boundingTarget,
        };
        if (boundingVehicle.Length > 0 && state?.Unit(vehicleUnit) is { } firer && BoundingVehicleChoices(firer.Side).Any(choice => choice.Id == boundingVehicle))
        {
            arguments["targetVehicle"] = boundingVehicle;
        }

        return Propose(GameActions.FireOrdnance, JsonSerializer.SerializeToElement(arguments));
    }

    /// <summary>A tank's BMG and CMG as the fire panels list them (D1.8, D3.5; pass 50): each under the vehicle's id and its own name, with its FP.</summary>
    private IReadOnlyList<SmallArmsFirePanel.Weapon> VehicleMgChoices(UnitInstance vehicle) => state is null ? []
        : [.. LiveFire.VehicleMgs(state, vehicle).Select(item => new SmallArmsFirePanel.Weapon(vehicle.Id + ":" + item.Weapon, vehicle.Id, item.Bar, false,
            $"{item.Weapon.ToUpperInvariant()} ({item.Fp} FP)"))];

    private static string VehicleMgName(string id) => id[(id.LastIndexOf(':') + 1)..];

    /// <summary>The BMG and CMG of the vehicles ticked as firers.</summary>
