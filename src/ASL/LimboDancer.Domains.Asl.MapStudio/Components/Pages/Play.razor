@page "/games/play"
@using System.Globalization
@using System.Text.Json
@using LimboDancer.Abstractions.Actions
@using LimboDancer.Abstractions.Domain
@using LimboDancer.Domains.Asl.Play
@using LimboDancer.Domains.Asl.Rules
@using LimboDancer.Domains.Asl.Units.Catalog
@using LimboDancer.Domains.Asl.Units.State
@using static LimboDancer.Domains.Asl.MapStudio.Components.Play.FireText
@inject LivePlay Live
@inject UnitLibrary Library
@inject GameMaps GameMaps
@inject IServiceProvider Services
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>Play - ASL Map Studio</PageTitle>

<PageHeader Title="Play">
    <p>
        Live games are the Studio's chosen game source (D2). Every change is a registered action through the Execution Gate: the Studio proposes it,
        the gate checks it against the current game, boards, and catalog, and it commits only after you confirm. Nothing here edits a game directly.
    </p>
</PageHeader>

@if (Scripted is { } scripted)
{
    <ScriptedDicePanel Queued="@([.. scripted.Queued])" @bind-Input="scriptedInput" Add="QueueDice" Clear="@(() => scripted.Clear())" Problem="@scriptedProblem" />
}

<PlayContextHeader Summary="@ContextSummary" Revision="@(state is not null && history?.Current is not null ? state.Revision : null)" Acting="@ActingNote" Busy="@busy" Live="@(state is null || history is null ? null : history.Current is not null)" Ended="@(state?.Ended is not null)"
                   Conditions="@(state is null ? null : NightAndWeather(state))" HasCard="@(state?.Scenario is not null && handOver is null)"
                   PendingTitle="@(handOver is null ? pending?.Action.Name : null)" Review="@FocusReview" Awaiting="@(AwaitingView is { } awaited ? ViewLabel(awaited) : null)"
                   AwaitingNote="@AwaitingNote" HandOver="@HandOverToAwaiting" Status="@status">
    <LiveGameToolbar Games="@([.. Live.Games().Select(scope => scope.Game)])" GameId="@gameId" GameChanged="ChangeGame" Disabled="@busy" Views="@ViewChoices"
                     ViewAs="@(handOver ?? viewAs)" ViewChanged="ChangeView" BoardLabel="@ViewTarget"
                     BoardLink="@(state is not null && handOver is null ? Games.BoardLink(ViewTarget, GameLibrary.LivePrefix + gameId, Viewer, state.Revision) : null)" />
</PlayContextHeader>

<HandOverScreen Next="@handOver" Label="@ViewLabel(handOver)" Confirmed="ConfirmView">

@if (state?.Scenario is { } scenario)
{
    var playCard = CardRead(scenario.Id)?.Card;
    <PlayCardPanel Scenario="@scenario" Card="@playCard" Changed="@(!Live.Cards.Matches(scenario.Id, scenario.Sha256))" FirstSide="@state.FirstSide" Ended="@state.Ended"
                   Groups="@([.. state.Sides.SelectMany(side => side.Groups.Select(group => $"{side.Id}: {group.Name} ({group.Id}), ELR {group.Elr?.ToString(CultureInfo.InvariantCulture) ?? "not given"}"))])"
                   Victory="@(playCard is not null ? VictoryNow : null)"
                   KnownTo="@VictoryKnownTo" Catalog="@($"{state.Catalog.Catalog}@{state.Catalog.Version}")"
                   Provenance="@(playCard is not null && PublishedCatalog is { } provenanceCatalog ? GameProvenance(playCard, scenario.Id, scenario.Sha256, provenanceCatalog) : null)" />
}

@{
    // Pass 28c: the setup and the proposal review are drawn in the workspace once a game exists, and in the page's flow before it does.
    RenderFragment setupBlock = @<div id="play-setup">
        <h3>Setup</h3>
        @if (ChosenCard is { Minimal: true } || (state?.Scenario is { } playing && CardRead(playing.Id)?.Card is { Minimal: true }))
        {
            <p id="setup-minimal" class="muted">A minimal card has no OB: set up each side's units by hand (ruling R22.3).</p>
        }
        @if (SetupView is { } setup)
        {
            <SetupPoolsTable Report="@setup" DefinitionLabel="@DefinitionLabel" OutOfSight="@Unseen" />
        }
        @if (state is not null && SetupView is { } seen && seen.Groups.Where(group => Unseen.Contains(group.Id)).Select(group => group.Side).Distinct().ToArray() is { Length: > 0 } unseen)
        {
            <p id="setup-out-of-sight" class="diagnostic">
                @string.Join(" and ", unseen) @(unseen.Length == 1 ? "sets" : "set") up now, out of your sight: its placements are not shown to @Viewer.Name until it has
                finished, and only it places units now. Hand the screen over by choosing its view (A12.12; ruling R23.3).
            </p>
        }
        @if (state is not null && history is { Events.Count: > 0 } && SetupView is not { CurrentOrder: not null })
        {
            @foreach (var side in state.Sides.Where(side => Viewer.IsAdjudicator || side.Id == viewAs))
            {
                var choices = Live.Planner.NonObConcealment(state, side.Id);
                <fieldset class="setup-non-ob" data-side="@side.Id">
                    <legend>Non-OB "?" for @side.Id (A12.12; ruling R23.6)</legend>
                    <RuleHelp Id="@($"non-ob-help-{side.Id}")" Summary='Once both sides have set up, a stack with no "?" out of the LOS of every unbroken enemy ground unit within 16 hexes may take one (A12.12).'>
                        Once both sides have set up, a stack with no "?" may take one if it is out of the LOS of every unbroken enemy ground unit within 16 hexes, or
                        17 hexes or more from all of them. Hidden units are not on the board and do not count. The game checks this against every enemy unit, those
                        under "?" too, as the opponent would at the table; a refusal names no enemy Location.
                    </RuleHelp>
                    @if (choices.Count == 0)
                    {
                        <p class="muted non-ob-none">No stack of @side.Id may take a non-OB "?" now.</p>
                    }
                    else
                    {
                        @foreach (var at in choices)
                        {
                            var key = $"{side.Id}|{at}";
                            <label><input type="checkbox" class="non-ob-location" value="@at" checked="@nonObChosen.Contains(key)"
                                          @onchange="@(args => Toggle(nonObChosen, key, args.Value is true))" /> @at</label>
                        }
                        <button class="propose-non-ob" disabled="@(!choices.Any(at => nonObChosen.Contains($"{side.Id}|{at}")))"
                                @onclick="@(() => ProposeNonOb(side.Id, choices))">Propose: place @side.Id's non-OB "?"</button>
                    }
                </fieldset>
            }
        }
        <SetupPlacementEditor Draft="@PlaceDraft" Definitions="@DefinitionChoices" Groups="@GroupChoiceList" Entries="@EntryChoices"
            Kind="@(Definitions.FirstOrDefault(definition => definition.Id == placeDefinition)?.Kind)" Note="@placeNote" OnDraft="@ApplyPlaceDraft" OnAdd="@AddPlacement" />
        <SetupPlacementList Items="@PlacementItems" Ready="@(history is not null || CardChosen)" OnRemove="@(key => placements.RemoveAll(item => item.Key == key))"
            OnPropose="@ProposeSetup" />
    </div>;
    RenderFragment reviewBlock = @<div class="play-review-body">
        @if (pending is { } proposal)
        {
            <ProposalReviewPanel Title="@proposal.Action.Name" Accepted="@(proposal.Result.Outcome is PlayOutcome.NeedsConfirmation or PlayOutcome.Committed or PlayOutcome.Replay)"
                                 Outcome="@OutcomeText(proposal.Result.Outcome, Withheld(proposal))" Reasons="@([.. Reasons(proposal)])"
                                 CanConfirm="@(proposal.Result.Outcome == PlayOutcome.NeedsConfirmation)" Busy="@busy" Confirm="Confirm" Cancel="@(() => { if (!busy) { pending = null; } })">
                <Evidence>
                    @if (proposal.Result.Plan?.Entry is { } review && !Withheld(proposal))
                    {
                        <EntryReviewFacts Review="@review" />
                    }
                    @if (proposal.Result.Plan?.Fire is { Attack: var attack })
                    {
                        <FireReviewFacts Attack="@attack" FireGroup="@FireGroupText(attack)" Range="@RangeText(attack)" />
                    }
                </Evidence>
            </ProposalReviewPanel>
        }
    </div>;
}

@if (history is null)
{
    <h3>New game</h3>
    <NewGameFromCard Cards="@CardChoices" Card="@scenarioCard" CardChanged="@ChooseCard"
                     @bind-GameId="newId" @bind-Label="newLabel" Start="@NewStart" BalanceSides="@BalanceSides" BalanceTexts="@BalanceTexts"
                     @bind-Balance="newBalance" @bind-PlayerOne="playerOne" @bind-PlayerTwo="playerTwo" />
    @setupBlock
    @reviewBlock
}
else if (history.Current is null && state is null)
{
    <GameReplayFailure Diagnostics="@history.Diagnostics"
                       MissingCatalog="@(history.Events.FirstOrDefault()?.Payload is GameStarted started && Live.Catalogs.All(catalog => $"{catalog.Identity.Catalog}@{catalog.Identity.Version}" != started.Catalog) ? started.Catalog : null)" />
}
else if (state is not null)
{
    @* Pass 28c (plan sections 11.1 and 13.1): the workspace. Wide, the actions, the map, and the review sit side by side over the activity strip;
       narrower, the map and one side pane; under 1024px, labelled Map, Actions, and Activity tabs, with the review above them. Pass 29: the map and
       the review pane are BoardWorkspace, the review pane its inspector, with the proposal as its first tab. *@
    <div id="play-workspace" class="@(narrow ? "play-workspace narrow" : "play-workspace")">
        @{
            RenderFragment proposalBlock = @<div id="play-proposal-tab">
                @if (pending is null)
                {
                    <p class="muted" id="play-review-none">Nothing to review: a proposal shows here, with Confirm and Cancel.</p>
                }
                @reviewBlock
            </div>;
            RenderFragment between = @<text>
        @if (narrow)
        {
            <InspectorTabs Tabs="@PaneTabs" Selected="@paneTab" SelectedChanged="@(tab => paneTab = tab)" Label="Workspace" IdPrefix="play" SeparatePanels="true" />
        }
        <section id="play-panel-actions" class="play-pane play-actions" tabindex="-1" @ref="actionsPane" @attributes="@Pane("actions", "Actions")">
            @if (SetupOpen)
            {
                @setupBlock
            }
            @if (state is { Ended: not null } && history?.Current is not null)
            {
                @* Ruling R20.1: nothing happens in a game that has ended, so the page offers no action; its records, units, and map stay. *@
                <h3>Play</h3>
                <p id="play-over" class="muted">The game is over: its result is above, and no more actions are proposed (A3.9; ruling R20.1).</p>
            }
            else if (state is not null && history?.Current is not null)
            {
                <h3>Play</h3>
                @* Table player, pass 28c: what play waits on comes first. *@
                @if (state.Choice is { } choice)
                {
                    <PendingChoicePanel Key="@choice.Key" Side="@choice.Side" Description="@GamePlanner.DescribeChoice(choice)" MayAnswer="@MayAnswer(choice.Side)"
                        Options="@ChoiceOptions(choice)" OnChoose="@(option => ProposeChoose(choice.Key, option))" />
                }
                @foreach (var surrender in state.PendingSurrenders)
                {
                    var captorSide = surrender.Captors.Select(state.Unit).OfType<UnitInstance>().Select(unit => unit.Side).FirstOrDefault();
                    <PendingSurrenderPanel @key="surrender.Event" Unit="@surrender.Unit" MayAnswer="@MayAnswer(captorSide)" Captors="@(MayAnswer(captorSide) ? surrender.Captors : [])"
                        OnTake="@(captor => ProposeTakePrisoner(surrender.Unit, captor))" OnReject="@(() => ProposeRejectSurrender(surrender.Unit))"
                        OnFree="@(() => ProposeFreeSurrender(surrender.Unit))" />
                }
                @foreach (var open in state.OpenAttempts)
                {
                    <OpenEntryDeclaration EventId="@open.EventId" Unit="@open.Unit" Target="@open.Target.ToString()" OnDecline='@(() => ProposeDeclaration(open.Unit, "decline"))'
                        OnElect='@(() => ProposeDeclaration(open.Unit, "elect"))' />
                }
                <div class="toolbar">
                    <button id="propose-advance" @onclick="ProposeAdvance">Propose: end the @Games.PhaseLabel(state.Phase)</button>
                </div>
                @if (!SetupOpen && VisibleUnits.Where(unit => unit.Status == InstanceStatus.Active && GameState.Condition(unit, Conditions.Hidden) == ConditionState.True
                    && state.Location(unit.Id) is not null && (Viewer.IsAdjudicator || unit.Side == viewAs)).ToArray() is { Length: > 0 } hiddenUnits)
                {
                    <div class="toolbar" id="play-hidden">
                        <span class="toolbar-note">Hidden units (HIP): each is placed beneath a "?" before it moves or advances, or whenever its side chooses (A12.32; ruling R23.5).</span>
                        @foreach (var unit in hiddenUnits)
                        {
                            <button class="place-hidden" data-unit="@unit.Id" @onclick="@(() => ProposePlaceHidden(unit.Id))">Propose: place @unit.Id at @state.Location(unit.Id)!.Location beneath "?"</button>
                        }
                    </div>
                }
                <BuildingEntryAction Units="@EnterRows" Unit="@enterUnit" Location="@enterLocation" OnUnit="@(id => enterUnit = id)"
                    OnLocation="@(at => enterLocation = at)" OnPropose="@ProposeEntry" />
                @if (state.Phase == "rtph")
                {
                    <RoutActionPanel Obligations="@RoutObligations" Units="@RoutChoices" Unit="@routUnit" Route="@routRoute" LowCrawl="@routLowCrawl"
                        OnUnit="@(id => routUnit = id)" OnRoute="@(route => routRoute = route)" OnLowCrawl="@(on => routLowCrawl = on)" OnPropose="@ProposeRout" />
                }
                @if (state.Phase is "rph" or "pfph" or "mph" or "dfph" or "aph" or "ccph" or "rtph" && SupportWeapons.Any())
                {
                    <SupportWeaponActionPanel Weapons="@([.. SupportWeapons.Select(weapon => new PlayChoice(weapon.Id, SupportWeaponText(weapon)))])"
                        Units="@([.. SupportWeaponUnits.Select(Labelled)])" Weapon="@swWeapon" Unit="@swUnit" Held="@(SupportWeaponHolder is not null)"
                        OnWeapon="@(id => { swWeapon = id; swUnit = string.Empty; })" OnUnit="@(id => swUnit = id)" OnPropose="@ProposeSupportWeaponKind" />
                }
                @if (state.Phase == "rph")
                {
                    <h4>Rally</h4>
                    <RallyActionPanel Units="@RallyChoices" Leaders="@([.. RallyLeaders.Select(leader => leader.Id)])" Unit="@rallyUnit" Leader="@rallyLeader"
                        OnUnit="@(id => { rallyUnit = id; rallyLeader = string.Empty; })" OnLeader="@(id => rallyLeader = id)" OnPropose="@ProposeRally" />
                    <h4>Repair</h4>
                <RepairActionPanel Weapons="@RepairChoices" Weapon="@repairWeapon" OnWeapon="@(id => repairWeapon = id)" OnPropose="@ProposeRepair" />
                    <h4>Deploy and Recombine</h4>
                <DeployActionPanel Squads="@DeployChoices" Leaders="@([.. LeadersWith(deploySquad).Select(leader => leader.Id)])" Weapons="@DeployWeapons"
                        Squad="@deploySquad" Leader="@deployLeader" Second="@deployWeapons"
                        OnSquad="@(id => { deploySquad = id; deployLeader = string.Empty; deployWeapons.Clear(); })" OnLeader="@(id => deployLeader = id)"
                        OnWeapon="@(pick => Toggle(deployWeapons, pick.Id, pick.On))" OnPropose="@ProposeDeploy" />
                    <RecombineActionPanel HalfSquads="@RecombineChoices" Partners="@([.. RecombinePartners.Select(unit => unit.Id)])"
                        Leaders="@([.. LeadersWith(recombineOne).Select(leader => leader.Id)])" One="@recombineOne" Two="@recombineTwo" Leader="@recombineLeader"
                        OnOne="@(id => { recombineOne = id; recombineTwo = string.Empty; recombineLeader = string.Empty; })" OnTwo="@(id => recombineTwo = id)"
                        OnLeader="@(id => recombineLeader = id)" OnPropose="@ProposeRecombine" />
                    <DmRetentionChoices Units="@DmRetainers" Selected="@retainDm" OnToggle="@(pick => Toggle(retainDm, pick.Id, pick.On))" />
                    <ShockRecoveryAction Vehicles="@ShockChoices" Vehicle="@shockVehicle" OnVehicle="@(id => shockVehicle = id)" OnPropose="@ProposeShockRecovery" />
                }
                @if (state.Phase == "mph")
                {
                    <h4>Movement</h4>
                    <RuleHelp Id="move-help" Summary="@($"The {state.PhasingSide} side moves one stack at a time, one Location per step; after each step the DEFENDER may fire or pass (A4.1, A8.1).")">
                        The @state.PhasingSide side moves one stack at a time, one Location per step (A4.1). After each step the DEFENDER may fire at the stack
                        or pass (A8.1, A8.11); the stack then moves on, whole or split, or ends its move. No other unit moves until every member of the stack has
                        ended (A4.2); a member that breaks or is pinned ends its move. A Location holding Residual FP attacks a stack as it enters (A8.22).
                    </RuleHelp>
                    @* Table player and UI review, pass 27: every view learns of the OVR's CC; the side that may act for the phasing side proposes it. *@
                    @if (OverrunCloseCombat is { } overrun)
                    {
                        <BerserkOverrunCloseCombat Location="@overrun.Location.ToString()" Attackers="@overrun.Attackers" Smc="@overrun.Smc" SmcAttacks="@overrun.SmcAttacks"
                            Ready="@MayAnswer(state.PhasingSide)" OnPropose="@ProposeOverrunCloseCombat" />
                    }
                    @if (Viewer.IsAdjudicator || viewAs == state.PhasingSide)
                    {
                        @if (EntryWaiting.Count > 0)
                        {
                            <p class="muted" id="move-entry">
                                @string.Join(", ", EntryWaiting) @(EntryWaiting.Count == 1 ? "waits" : "wait") off board to enter along the entry edge: in this MPh, or by
                                advance in the APh, which does not end while one may still enter (A2.5; ruling R25.1).@NamedEntryText
                            </p>
                        }
                        @if (ForcedBack.Count > 0)
                        {
                            <p class="muted" id="move-forced-back">
                                @string.Join(", ", ForcedBack) @(ForcedBack.Count == 1 ? "was" : "were") forced back off board by a concealed unit and @(ForcedBack.Count == 1 ? "enters" : "enter") by advance in the APh (A12.15; ruling R25.3).
                            </p>
                        }
                        @if (state.Movement is { } movement)
                        {
                            <MovementStatus Movement="@movement" />
                        }
                        @foreach (var (charging, target, next, undecided) in Charges)
                        {
                            @if (undecided is null)
                            {
                                var lanes = Live.Planner.ChargeLanes(state, charging);
                                <p class="fail" data-charge="@charging.Id">
                                    @charging.Id is berserk and charges @(target?.ToString() ?? "the nearest Known enemy unit") before any other unit moves (A15.43),
                                    by a shortest route: next @(next.Count == 1 ? "step" : "steps") @string.Join(" or ", next.Select(step => lanes.TryGetValue(step, out var bypass)
                                        ? $"{step} in Bypass along {string.Join(" or ", bypass)}" : step.ToString())) (A15.431). It may not stop short while it has the MF.
                                </p>
                            }
                            else
                            {
                                <p class="muted" data-charge="@charging.Id" data-undecided="true">
                                    @charging.Id is berserk, but its charge@(target is { } at ? $" at {at}" : "") is not decided here: @undecided
                                </p>
                            }
                        }
                        <div class="toolbar">
                            <InfantryMovementAction Movers="@MoveRows" Selected="@moveUnits" Draft="@MoveDraft" PushGun="@MovingGun?.Id"
                                OnToggle="@ToggleMover" OnDraftChanged="@SetMoveDraft" OnPropose="@ProposeMove" />
                            <MapExitAction SelectId="move-exit" ButtonId="propose-exit" Edges="@ExitEdges" Edge="@moveExit" Ready="@(moveUnits.Count > 0)"
                                OnEdge="@(edge => moveExit = edge)" OnPropose="@ProposeExit" />
                            @if (SmokePlacers.Any())
                            {
                                <SmokeGrenadeAction Placers="@SmokeChoices" Places="@SmokePlaces" By="@smokeBy" At="@smokeAt" Ready="@(moveUnits.Count > 0)"
                                    OnBy="@(id => smokeBy = id)" OnAt="@(at => smokeAt = at)" OnPropose="@ProposeSmoke" />
                            }
                            @if (MoverCharges.Any())
                            {
                                <PlaceDemolitionChargeAction Charges="@ChargeChoices" Charge="@placeDc" At="@placeDcAt" Ready="@(moveUnits.Count > 0)"
                                    OnCharge="@(id => placeDc = id)" OnAt="@(at => placeDcAt = at)" OnPropose="@ProposePlaceDc" />
                            }
                            @if (moveUnits.Any(id => state.Unit(id) is { } mover && GameState.Condition(mover, Conditions.Berserk) == ConditionState.True))
                            {
                                <BerserkRetainedWeaponsField Value="@moveKeep" OnChange="@(keep => moveKeep = keep)" />
                            }
                            <MovementWindowActions WindowOpen="@state.Movement?.WindowOpen" EndingSome="@EndingSome" MayPass="@Viewer.IsAdjudicator"
                                OnPass='@(() => ProposeSimple(GameActions.PassFire, "pass"))' OnEnd="@ProposeEndMove" />
                        </div>
                    }
                    else
                    {
                        <p class="muted" id="move-elsewhere">The @state.PhasingSide side moves now; its movers and their route are its own (choose its view to move; ruling R23.1).</p>
                    }
                    @if (state.Movement is { Vehicle: true, WindowOpen: true, Members: [{ } reacting] } && state.Location(reacting)?.Location is { } reactionAt
                        && (Viewer.IsAdjudicator || viewAs != state.PhasingSide) && SeenOnly(ReactionUnits(reactionAt, reacting)).ToArray() is { Length: > 0 } reactors)
                    {
                        <ReactionFireAction Vehicle="@reacting" Attackers="@(reactors.Select(unit => unit.Id).ToArray())"
                            Leaders='@(reactors.Where(unit => unit.Kind is "asl:leader" or "asl:hero").Select(unit => unit.Id).ToArray())'
                            Attacker="@reactionAttacker" Leader="@reactionLeader" OnAttacker="@(id => reactionAttacker = id)" OnLeader="@(id => reactionLeader = id)"
                            OnPropose="@(() => ProposeVehicleCc(reactionAt.ToString(), [reactionAttacker, .. (reactionLeader.Length > 0 ? new[] { reactionLeader } : [])], null, [], false))" />
                    }
                    @if (VehicleCandidates.Any() && (Viewer.IsAdjudicator || viewAs == state.PhasingSide))
                    {
                        <VehicleMovementPanel Vehicles="@VehicleChoices" Selected="@vehicleUnit" OnSelect="@ChooseVehicle">
                            @if (VehicleCandidates.FirstOrDefault(item => item.Id == vehicleUnit) is { } chosen)
                            {
                                <VehicleMovementStatus Vca="@(chosen.Position is MapPosition { Facing: { } vca } ? UnitFacings.Name(vca) : string.Empty)" Text="@VehicleStatusText(chosen)"
                                    Recall="@(GameState.Condition(chosen, Conditions.Recalled) == ConditionState.True ? $"Recalled: it leaves by the {state.Side(chosen.Side)?.FriendlyEdge ?? "(not named)"} edge by a shortest route, in Motion (D5.341)." : null)" />
                                <VehicleStepChoices Steps="@VehicleSteps(chosen)" Exits="@VehicleExitChoices(chosen)" Moving="@VehicleFreeToMove(chosen)" Tracked="@GamePlanner.IsTracked(chosen)"
                                    Overrun="@vehicleOverrun" AllMp="@vehicleAllMp" Minimum="@vehicleMinimum" Esb="@vehicleEsb" Intended="@vehicleIntended"
                                    IntendedChoices="@IntendedChoices(chosen)" Loadable="@LoadableUnits(chosen)" Unloadable="@UnloadableUnits(chosen)"
                                    EntryHexes="@EntryHexChoices(chosen)" EntryHex="@vehicleEntryHex" EntryFacings="@EntryFacingChoices(chosen)" EntryFacing="@vehicleEntryFacing"
                                    OnEntryHex="@(hex => ChooseEntryHex(chosen, hex))" OnEntryFacing="@(facing => vehicleEntryFacing = facing)"
                                    LoadChosen="@vehicleLoad" UnloadChosen="@vehicleUnload" OnStep="@ProposeVehicleRequest" OnOption="@SetVehicleOption"
                                    OnEsb="@(esb => vehicleEsb = esb)" OnIntended="@(at => vehicleIntended = at)"
                                    OnLoadToggle="@(pick => Toggle(vehicleLoad, pick.Unit, pick.Chosen))" OnUnloadToggle="@(pick => Toggle(vehicleUnload, pick.Unit, pick.Chosen))" />
                                @if (TowChoices(chosen) is { Count: > 0 } guns)
                                {
                                    <VehicleTowingActions Guns="@guns" Facing="@unhookFacing" Boards="@hookBoards" OnFacing="@(facing => unhookFacing = facing)"
                                        OnBoards="@(boards => hookBoards = boards)" OnHook="@(hook => ProposeHook(chosen.Id, hook.Gun, hook.Hooked))" />
                                }
                                @if (chosen.Position is MapPosition && LiveFire.MayBoundingFire(state, chosen.Id) && GamePlanner.HasVehicleMg(chosen) && LiveFire.CrewExposed(chosen)
                                    && GameState.Condition(chosen, Conditions.BoundingFire) != ConditionState.True)
                                {
                                    <BoundingFireAction Targets="@([.. FireTargets(state.PhasingSide)])" Target="@boundingTarget" OnTarget="@(target => boundingTarget = target)"
                                        OnPropose="@ProposeBoundingFire" />
                                }
                            }
                        </VehicleMovementPanel>
                    }
                }
                @if (state.Phase is "mph" or "aph" && ButtonUpCandidates.Any())
                {
                    <CrewExposureActions Vehicles="@([.. ButtonUpCandidates.Select(afv => new CrewExposureActions.Exposure(afv.Id, GameState.Condition(afv, Conditions.ButtonedUp) == ConditionState.True))])"
                        OnToggle="@(afv => ProposeButtonUp(afv.Id, !afv.ButtonedUp))" />
                }
                @if (state.Phase == "aph" && !Viewer.IsAdjudicator && viewAs != state.PhasingSide)
                {
                    <h4>Advance</h4>
                    <p class="muted" id="advance-elsewhere">The @state.PhasingSide side advances now; its units and their Locations are its own (choose its view to advance; ruling R23.1).</p>
                }
                else if (state.Phase == "aph")
                {
                    <AdvanceActionPanel Side="@(state.PhasingSide ?? string.Empty)" Units="@AdvanceRows" Selected="@advanceUnits" Destinations="@AdvanceDestinations" Waiting="@AdvanceWaiting"
                        Edges="@ExitEdges" To="@advanceTo" Edge="@advanceExit" OnToggle="@ToggleAdvancer"
                        OnTo="@(to => advanceTo = to)" OnEdge="@(edge => advanceExit = edge)" OnPropose="@ProposeAdvanceUnits" OnExit="@ProposeAdvanceExit" />
                }
                @if (state.Phase == "ccph" && VehicleCcRows is { Count: > 0 } vehicleCc)
                {
                    <VehicleCloseCombatPanel Locations="@vehicleCc" Attacker="@vehicleCcAttacker" Leader="@vehicleCcLeader" Vehicle="@vehicleCcVehicle" Defenders="@vehicleCcDefenders"
                        OnAttacker="@(id => vehicleCcAttacker = id)" OnLeader="@(id => vehicleCcLeader = id)" OnVehicle="@(id => vehicleCcVehicle = id)"
                        OnDefender="@(pick => Toggle(vehicleCcDefenders, pick.Id, pick.On))"
                        OnProposeAttack="@(at => ProposeVehicleCc(at, [vehicleCcAttacker, .. (vehicleCcLeader.Length > 0 ? new[] { vehicleCcLeader } : [])], vehicleCcVehicle, [], false))"
                        OnProposeVehicle="@(at => ProposeVehicleCc(at, [], vehicleCcVehicle, [.. vehicleCcDefenders], false))" OnPass="@(at => ProposeVehicleCc(at, [], null, [], true))" />
