    /// <summary>Whether the vehicle is moving now: started and not stopped in its own movement, or in Motion before it starts its MPh (D2.4).</summary>
    private bool VehicleMoving(UnitInstance vehicle) => vehicle.Position is MapPosition && (state!.Movement is { Vehicle: true } driving
        ? driving.Movers.Contains(vehicle.Id, StringComparer.Ordinal) && driving.Started && !driving.Stopped
        : GameState.Condition(vehicle, Conditions.Motion) == ConditionState.True);

    /// <summary>Whether the moving vehicle's options apply: moving, with no OVR to resolve and not bogged (the panel's first branches).</summary>
    private bool VehicleFreeToMove(UnitInstance vehicle) => VehicleMoving(vehicle) && state!.Movement is not { Overrun: not null }
        && GameState.Condition(vehicle, Conditions.Bogged) != ConditionState.True;

    /// <summary>Whether the vehicle may hook up or unhook a Gun now (C10.11, C10.12): Stopped in its own movement, or not yet moved, not in Motion or bogged.</summary>
    private bool VehicleStopped(UnitInstance vehicle) => vehicle.Position is MapPosition && GameState.Condition(vehicle, Conditions.Motion) != ConditionState.True
        && GameState.Condition(vehicle, Conditions.Bogged) != ConditionState.True
        && (state!.Movement is null || (state.Movement is { Vehicle: true, Stopped: true, Overrun: null } own && own.Movers.Contains(vehicle.Id, StringComparer.Ordinal)));

    /// <summary>The chosen vehicle's status (plan A18): its VCA, MP, Motion, Reverse, Bypass, ESB, bog, Passengers, and towed Gun.</summary>
    private string VehicleStatusText(UnitInstance vehicle)
    {
        var cargo = string.Join(string.Empty, CargoNotes(vehicle).Select(note => ", " + note));
        if (vehicle.Position is not MapPosition { Facing: { } vca })
        {
            return $"waits off board to enter, in Motion: its first MP expenditure is its entry, with no Start MP (A2.52, D2.4){cargo}";
        }

        var (spent, allotment) = GamePlanner.VehicleHalfMp(vehicle);
        var moving = state!.Movement is { Vehicle: true } under ? under.Started && !under.Stopped ? ", moving" : ", stopped: Start costs 1 MP"
            : GameState.Condition(vehicle, Conditions.Motion) == ConditionState.True ? ", in Motion: no Start MP" : ", stopped: Start costs 1 MP";
        return $"VCA {UnitFacings.Name(vca)}, {HalfMpText(spent)} of {HalfMpText(allotment)} MP spent, {HalfMpText(Math.Max(0, allotment - spent))} left{moving}"
            + (state.Movement is { Vehicle: true, Reverse: true } ? ", in Reverse" : string.Empty)
            + (vehicle.Straddling is { } lane ? $", in Bypass along the hexside with {lane}" : string.Empty)
            + (vehicle.EsbMp > 0 ? $", ESB +{vehicle.EsbMp} MP" : string.Empty)
            + (GameState.Condition(vehicle, Conditions.Bogged) == ConditionState.True ? ", bogged" : string.Empty)
            + (GameState.Condition(vehicle, Conditions.Mired) == ConditionState.True ? ", Mired" : string.Empty) + cargo;
    }

    /// <summary>What a Passenger rides, and what a vehicle carries and tows (D6.1, C10.1; ruling R26.2).</summary>
    private IEnumerable<string> CargoNotes(UnitInstance unit)
    {
        // Rulings R23.1, R23.4: what a vehicle carries is its own side's to see; the opponent sees the vehicle.
        if (state is null || (!Viewer.IsAdjudicator && unit.Side != viewAs))
        {
            yield break;
        }

        if (state.Aboard(unit.Id) is { } vehicle)
        {
            yield return $"aboard {vehicle}";
        }

        if (LiveFire.IsVehicle(unit))
        {
            if (state.Passengers(unit.Id) is { Count: > 0 } riding)
            {
                yield return $"Passengers {string.Join(", ", riding.Select(item => item.Id))}";
            }

            foreach (var gun in state.Equipment.Where(item => item.Status == InstanceStatus.Active && item.Holding is { Role: HoldingRole.Towed } tow && tow.Holder == unit.Id))
            {
                yield return $"towing {gun.Id}";
            }
        }
    }

    /// <summary>The chosen vehicle's MP expenditures as the planner offers them (plan A19).</summary>
    private IReadOnlyList<VehicleStepChoices.StepButton> VehicleSteps(UnitInstance vehicle)
    {
        var steps = new List<VehicleStepChoices.StepButton>();
        static Dictionary<string, object> Data(params (string Name, object Value)[] pairs) => pairs.ToDictionary(pair => pair.Name, pair => pair.Value);

        // A2.52, D2.4 (ruling R26.1): off board, its only expenditure is its entry, chosen by hex and VCA.
        if (vehicle.Position is not MapPosition { Facing: { } vca })
        {
            return steps;
        }

        if (state!.Movement is { Vehicle: true, Overrun: { } overrunAt } overrunning)
        {
            steps.Add(new(new("resolve-ovr"), $"Propose: resolve the OVR of {overrunAt} (D7.1)", Id: "vehicle-resolve-ovr",
                Bar: overrunning.WindowOpen ? "The DEFENDER fires or passes first (D7.1)" : null));
            return steps;
        }

        if (GameState.Condition(vehicle, Conditions.Bogged) == ConditionState.True)
        {
            steps.Add(new(new("start"), "Propose: Bog Removal (colored dr x white dr MP; D8.3)", Id: "vehicle-unbog"));
            return steps;
        }

        if (!VehicleMoving(vehicle))
        {
            steps.Add(new(new("start"), "Propose: start (1 MP)", Id: "vehicle-start"));
            steps.Add(new(new("start", Reverse: true), "Propose: start in Reverse (1 MP; D2.23)", Id: "vehicle-start-reverse"));
            return steps;
        }

        var left = (UnitFacing)(((int)vca + 1) % 6);
        var right = (UnitFacing)(((int)vca + 5) % 6);
        steps.Add(new(new("turn", Facing: UnitFacings.Name(left)), $"Propose: VCA to {UnitFacings.Name(left)} (1 MP)", Id: "vehicle-turn-left"));
        steps.Add(new(new("turn", Facing: UnitFacings.Name(right)), $"Propose: VCA to {UnitFacings.Name(right)} (1 MP)", Id: "vehicle-turn-right"));
        var reversing = state.Movement is { Vehicle: true, Reverse: true };
        foreach (var (to, straddling, cost, bar, all, bog) in Live.Planner.VehicleEntries(state, vehicle, vehicleAllMp))
        {
            var inBypass = straddling is not null;
            steps.Add(new(new("enter", to.ToString(), Bypass: inBypass),
                $"Propose: enter {to}{(inBypass ? $" in VBM beside {straddling}" : string.Empty)}{(reversing ? " in Reverse" : string.Empty)}"
                    + (cost is { } half ? all ? " (ALL its MP)" : $" ({HalfMpText(half)} MP)" : string.Empty) + (bog is { } drm ? $", Bog DR {drm:+0;-0;+0}" : string.Empty),
                Class: "vehicle-enter", Data: Data(("data-to", to.ToString()), ("data-bypass", inBypass.ToString())), Bar: cost is null ? bar ?? string.Empty : null));
        }

        steps.Add(new(new("overrun"), "Propose: OVR here (A12.41)", Id: "vehicle-declare-ovr", Title: "After the concealed units of the Location it entered were revealed or tested (A12.41)"));
        steps.Add(new(new("stop"), "Propose: stop (1 MP)", Id: "vehicle-stop"));
        return steps;
    }

    private (long Revision, string Vehicle, IReadOnlyList<(LimboDancer.Domains.Asl.Maps.Coordinates.BoardLocation To, UnitFacing Facing, int? HalfMp, string? Bar)> Options)? entryRead;

