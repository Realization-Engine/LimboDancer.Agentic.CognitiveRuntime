                && GameState.Condition(other, Conditions.Broken) != ConditionState.True))
            // Ruling R25.4: off board, the leaders waiting to enter along the same edge.
            : WaitsToEnter(unit) && Live.Planner.EntryFor(state, unit) is { } entry
                ? SeenOnly(state.Units.Where(other => other.Status == InstanceStatus.Active && other.Kind == "asl:leader" && other.Side == unit.Side
