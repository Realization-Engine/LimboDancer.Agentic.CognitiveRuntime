    /// <summary>
    /// A new view waits behind the hand-over screen (ruling R23.2); what the last one prepared is dropped, since it may rest on what the next may not
    /// see (plan section 13.4). Choosing the shown view again drops the hand-over.
    /// </summary>
    private void ChangeView(string next)
    {
        // Pass 29: the view does not change while the gate works, so a result lands with the view that asked for it.
        if (busy || next == (handOver ?? viewAs))
        {
            return;
        }

        // Pass 31 (ruling R31.7): the revision a view was last shown at, so its next hand-over says what has happened since.
        if (handOver is null && !unconfirmed && state is not null && viewAs.Length > 0)
        {
            lastShown[viewAs] = state.Revision;
        }

        // Referee, pass 29: the view shown again drops the hand-over only once it has been confirmed; on load and on a game change it has not.
        handOver = next == viewAs && !unconfirmed ? null : next;
        openingHex = null;
        ResetForView();
    }

    /// <summary>Everything the last view prepared: the proposal, the drafts of setup and of every action, and the LOS line.</summary>
    private void ResetForView()
    {
        // The last view's records are not kept in memory for the next (the UI review, pass 31b).
        (recordsCache, activityTab) = (null, null);
        (Picking.Armed, Picking.ArmedLabel) = (null, null);
        pending = null;
        status = string.Empty;
        highlight = null;
        inspectorTab = PlayTab;
        ClearPlacements();
        (shownPlan, setupTab, setupDone, setupReview, revealId) = (null, null, null, null, null);
        (theirOutline, swapNote) = (true, null);
        groupsOpened.Clear();
        placeNote = null;
        placeLocation = placeId = placeBore = placeGroup = string.Empty;
        placeHidden = false;
        placeConcealed = false;
        placeBroken = placeOffBoard = false;

        // D3.41, D3.45 (the UI review of pass 55): an Armor Leader or an Inexperienced Crew chosen for a placement is the last view's own.
        (placeArmorLeader, placeInexperiencedCrew) = (string.Empty, false);
        placeHolder = string.Empty;
        placeEntry = string.Empty;
        nonObChosen.Clear();
        sniperHex = string.Empty;
        retainDm.Clear();
        moveUnits.Clear();
        ResetDrafts(keepCloseCombat: true);
    }

    /// <summary>
    /// The Play streamlining plan, S1: the hand-over screen's pass, for the DEFENDER the screen goes to while his window on a step is open and no
    /// plan is being made (a plan has its own); null otherwise. It is offered whatever the DEFENDER's units are, so the screen tells the moving side
    /// nothing.
    /// </summary>
    private string? HandOverPassLabel => handOver is { } arriving && state is { Phase: "mph", Movement.WindowOpen: true } && arriving == DefenderSide && PlanNow is null
        ? "Let the stack move on: pass, without opening my view" : null;

    /// <summary>
    /// The DEFENDER passes from the hand-over screen; the screen then goes back to the moving side, since the DEFENDER is the one at it. A pass the
    /// gate refuses (Mandatory Fire owed) opens the DEFENDER's own view instead, where he reads why: the reason is not shown on a screen both read.
    /// </summary>
    private async Task PassFromHandOver()
    {
        if (busy || handOver is not { } defender || state?.PhasingSide is not { } mover || history is null)
        {
            return;
        }

        var node = new System.Text.Json.Nodes.JsonObject
        {
            ["gameId"] = gameId,
            ["attemptId"] = Attempt("pass"),
            ["expectedRevision"] = history.Events.Count,
            [GamePlanner.ProposedByArgument] = defender,
        };
        var arguments = JsonSerializer.SerializeToElement(node);
        busy = true;
        PlayResult result;
        try
        {
            var proposed = await Run(() => Live.Play.ProposeAsync(GameActions.PassFire, arguments, Live.Principal));
            result = proposed.Outcome == PlayOutcome.NeedsConfirmation
                ? await Run(() => Live.Play.ConfirmAsync(GameActions.PassFire, arguments, Live.Principal, proposed.Correlation)) : proposed;
        }
        finally
        {
            busy = false;
        }

        if (result.Outcome is PlayOutcome.Committed or PlayOutcome.Replay)
        {
            Refresh();
            (handOver, unconfirmed) = (mover, true);
            return;
        }

        await ConfirmView();
    }

    /// <summary>The DEFENDER's pass for the rest of the phase, offered on the hand-over screen whenever his window is open (ruling Q15).</summary>
    private string? HandOverPhasePassLabel => handOver is { } arriving && state is { Phase: "mph", Movement.WindowOpen: true } && arriving == DefenderSide
        ? "Pass for the rest of this phase" : null;

    /// <summary>
    /// The DEFENDER passes here and for the rest of the phase from the hand-over screen (rulings Q15, Q15a; the exception kept, as its default): a
    /// plotted route then runs on, and the screen goes back to the moving side unless he is asked after all, when his own view opens.
    /// </summary>
    private async Task PhasePassFromHandOver()
    {
        if (busy || state is null || handOver is null || state.PhasingSide is not { } mover)
        {
            return;
        }

        Live.Plans.DeclarePhasePass(gameId, state, askWhenAdjacent: true);
        if (PlanNow is null)
        {
            await PassFromHandOver();
            return;
        }

        busy = true;
        MovementPlanRun run;
        try
        {
            run = await Live.Plans.MoveOn(gameId, toEnd: false);
            if (run.Turn == MovementPlanTurn.Done && Live.Plans.HasQueue(gameId))
            {
                run = await Live.Plans.RunQueue(gameId, mover, DefenderSide);
            }
        }
        finally
        {
            busy = false;
        }

        Refresh();
        if (run.Turn == MovementPlanTurn.Defender)
        {
            await ConfirmView();
            return;
        }

        (planHandedBack, handOver, unconfirmed) = ((mover, run.Note), mover, true);
    }

    /// <summary>Whether the DEFENDER's pass for the rest of this phase stands (ruling Q15).</summary>
    private PhasePass? PhasePassNow => state is null || gameId.Length == 0 ? null : Live.Plans.PhasePassOf(gameId, state);

    // Ruling Q15a: the exception is ticked by default.
    private bool phasePassAdjacent = true;

    /// <summary>The DEFENDER passes at this window and declares the pass for the rest of the phase.</summary>
    private async Task PassForPhase()
    {
        if (state is null)
        {
            return;
        }

        Live.Plans.DeclarePhasePass(gameId, state, phasePassAdjacent);
        await (PlanNow is not null ? PlanMoveOn(false) : ProposeSimple(GameActions.PassFire, "pass"));
    }

    private async Task ConfirmView()
    {
        ConfirmViewNow();

        // The Play streamlining plan, S6: the DEFENDER's view opened on a plan passes the steps none of his units could fire at.
        await ReviewPlan();
    }

    private void ConfirmViewNow()
    {
        if (handOver is { } next)
        {
            // Pass 31c (design D17): what the arriving view missed is counted from the revision it last saw.
            sinceLooked = lastShown.TryGetValue(next, out var looked) ? looked : null;

            // Pass 31d (design D12): and through the revision it arrives at, so what the view then does itself is not listed as missed.
            sinceThrough = state?.Revision ?? long.MaxValue;
            viewAs = next;
            handOver = null;
            unconfirmed = false;
            ResetForView();

            // The Play streamlining plan, P5's finding: after a plan hands the stack back, the moving side reads how it ended in the header, and the
            // map is left clear for its next route; "Since you last looked" stays a click away.
            if (planHandedBack is { } ended && next == ended.Side)
            {
                (activityTab, planNote, planHandedBack) = (null, ended.Note, null);
            }
            else
            {
                (activityTab, planNote) = (SinceLooked.Count > 0 ? "since" : null, null);
            }

            (highlight, openingHex) = (openingHex, null);

            // A11.11 (the user, 2026-10-22): the side that declares second opens on the Location the first side declared in.
            if (CcKeptForGame is { } declared && declared.Side != viewAs)
            {
                ccLocation = declared.Location;
                ClearCloseCombat();
                ccRound = declared.Round;
            }

            ShowActions();
        }
    }


    /// <summary>What "View on" opens: the saved map the game copied, or its first board.</summary>
    private string ViewTarget => state is null ? string.Empty
        : state.Map.IsPlaced && state.Map.Reference.StartsWith("map-", StringComparison.Ordinal) ? state.Map.Reference : state.Map.Boards[0].Board.Value;

    /// <summary>A prisoner's Guard, and a Guard's prisoners (A20.5), as the units table shows them.</summary>
    private IEnumerable<string> Custody(UnitInstance unit)
    {
        if (unit.Custodian is { } guard)
        {
            // Referee, pass 29: a side never reads the id of a unit its view does not hold (rulings R23.1, R23.3).
            yield return $"guarded by {(Viewer.IsAdjudicator || VisibleUnits.Any(seen => seen.Id == guard) ? guard : "a unit not in view")}";
        }

        if (state?.Units.Where(item => item.Status == InstanceStatus.Active && item.Custodian == unit.Id
            && (Viewer.IsAdjudicator || VisibleUnits.Any(seen => seen.Id == item.Id))).Select(item => item.Id).Order(StringComparer.Ordinal).ToArray() is { Length: > 0 } prisoners)
        {
            yield return $"guards {string.Join(", ", prisoners)}";
        }
    }

    // A side's view with no replayed state shows nothing rather than the whole game (UI review, pass 23).
    /// <summary>The units of a list the view may see: every action's picker passes through it (ruling R23.1; Studio demo, pass 23).</summary>
    private IEnumerable<UnitInstance> SeenOnly(IEnumerable<UnitInstance> units, bool aboardToo = false)
    {
        // Ruling R26.2: a Passenger acts only with its vehicle, so no action list offers it, but the Rout panel (pass 65, ruling R65.11: a
        // broken Passenger routs beneath its vehicle). Who rides what is read from the planner's index once per state (ruling R65.25).
        if (!aboardToo && state is { } current)
        {
            units = units.Where(unit => Live.Planner.VehicleRidden(current, unit.Id) is null);
        }

        if (Viewer.IsAdjudicator)
        {
            return units;
        }

        var seen = VisibleUnits.Select(unit => unit.Id).ToHashSet(StringComparer.Ordinal);
        return units.Where(unit => seen.Contains(unit.Id));
    }

