    /// <summary>
    /// The chosen Gun's CA drawn as two rays from its hex (C3.2; ruling R8.9): the hexspines 30 degrees either side of its barrel.
    /// </summary>
    private string CoveredArcLayer(StudioBoard board)
    {
        if (state?.Find(ordnanceGun) is not EquipmentInstance { Position: MapPosition { Facing: { } facing } at } || UnitLibrary.TargetFor(board).Locate(at.Location) is not { } hex)
        {
            return string.Empty;
        }

        var center = board.Render.Grid.Geometry.CenterDot(hex);
        var rays = new[] { -30, 30 }.Select(offset =>
        {
            var angle = ((int)facing * 60 + offset) * Math.PI / 180;
            return string.Create(CultureInfo.InvariantCulture,
                $"<line class=\"ca-ray\" x1=\"{center.X:0.##}\" y1=\"{center.Y:0.##}\" x2=\"{center.X + (900 * Math.Cos(angle)):0.##}\" y2=\"{center.Y - (900 * Math.Sin(angle)):0.##}\" stroke=\"#06c\" stroke-width=\"3\" stroke-dasharray=\"10 6\"/>");
        });
        return $"<g id=\"layer-covered-arc\">{string.Concat(rays)}</g>";
    }

    private Task ProposeOrdnance()
    {
        // C8.4 (pass 55, ruling R55.9): a Canister shot names its aim, and a facing only when the Gun turns first; it names no target.
        if (FiringSide is { } firing && OrdnanceCanister())
        {
            // The UI review: the aim sent is one of the aims shown now. A Gun that turned since the aim was chosen has other hexes under that number.
            if (!OrdnanceCanisterAims(firing).Any(shown => shown.Id == ordnanceCanisterAim) || !int.TryParse(ordnanceCanisterAim, NumberStyles.None, CultureInfo.InvariantCulture, out var aim))
            {
                ordnanceCanisterAim = string.Empty;
                return Task.CompletedTask;
            }

            var canister = new Dictionary<string, object>
            {
                ["gameId"] = gameId, ["attemptId"] = Attempt("gun"), ["expectedRevision"] = (long)history!.Events.Count, ["gunId"] = ordnanceGun,
                ["ammunition"] = ScenarioA1CanisterCalculator.Ammunition, ["aim"] = aim,
            };
            if (OrdnanceCanisterFacing != OrdnanceGunFacing)
            {
                canister["aimFacing"] = OrdnanceCanisterFacing;
            }

            if (ordnanceIntensive && OrdnanceIntensiveAllowed)
            {
                canister["intensive"] = true;
            }
            if (ordnanceSecondFirer.Length > 0)
            {
                canister["secondFirer"] = ordnanceSecondFirer;
            }

            return Propose(GameActions.FireOrdnance, JsonSerializer.SerializeToElement(canister));
        }

        var arguments = new Dictionary<string, object>
        {
            ["gameId"] = gameId, ["attemptId"] = Attempt("gun"), ["expectedRevision"] = (long)history!.Events.Count, ["gunId"] = ordnanceGun, ["target"] = ordnanceTarget,
        };
        // UI review, pass 28b: a value the panel hides for this weapon is never sent.
        if (ordnanceIntensive && OrdnanceIntensiveAllowed)
        {
            arguments["intensive"] = true;
        }
        if (ordnanceSpotter.Length > 0 && !ordnanceGun.EndsWith(":pf", StringComparison.Ordinal))
        {
            arguments["spotter"] = ordnanceSpotter;
        }
        if (ordnanceDirector.Length > 0)
        {
            arguments["director"] = ordnanceDirector;
        }
        if (ordnanceSecondFirer.Length > 0)
        {
            arguments["secondFirer"] = ordnanceSecondFirer;
        }
        if (ordnanceVehicle.Length > 0 && OrdnanceAmmunitionKind != OrdnanceTargetFields.AmmunitionKind.None)
        {
            arguments["targetVehicle"] = ordnanceVehicle;
            arguments["ammunition"] = ordnanceGun.EndsWith(":pf", StringComparison.Ordinal) ? "heat"
                : OrdnanceMachineGun ? ScenarioA1MachineGunKill.Ammunition
                : OrdnanceAmmunitionKind == OrdnanceTargetFields.AmmunitionKind.Selectable ? OrdnanceAmmunitionFor(true) ?? ordnanceAmmunition : ordnanceAmmunition;
        }
        else if (OrdnanceAmmunitionKind == OrdnanceTargetFields.AmmunitionKind.Selectable
            && (OrdnanceAmmunitionFor(false) ?? OrdnanceAmmunitionChoices(false).FirstOrDefault()?.Ammunition) is { } named
            && !(named == "he" && OrdnanceGunDefinition is { } definition && ScenarioA1Definitions.HeAssumed(definition)
                && !OrdnanceAmmunitionChoices(false).Any(item => item.Ammunition == ScenarioA1CanisterCalculator.Ammunition)))
        {
            // C2.21, C8.8 (pass 55): a Gun whose HE has a Depletion Number fires it at Infantry only when the shot names it. It is named also when
            // the Gun has none now, so that the refusal says that and not that the HE was left unnamed. C8.31 (pass 60): AP, APCR, APDS, or HEAT
            // named at Infantry attacks by its HE Equivalency; an HE that is assumed stays unnamed, as before the pass (a Canister Gun's named, as
            // in pass 55).
            arguments["ammunition"] = named;
        }

        return Propose(GameActions.FireOrdnance, JsonSerializer.SerializeToElement(arguments));
    }

