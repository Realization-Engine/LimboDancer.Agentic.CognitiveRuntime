        ? state.At(at).OfType<UnitInstance>().Where(other => other.Status == InstanceStatus.Active && other.Id != one.Id && other.Kind == "asl:half-squad"
            && other.Definition?.Definition == one.Definition?.Definition)
        : []);

    private Task ProposeDeploy()
    {
        var arguments = new Dictionary<string, object> { ["gameId"] = gameId, ["attemptId"] = Attempt("deploy"), ["expectedRevision"] = (long)history!.Events.Count, ["squadId"] = deploySquad };
        if (deployLeader.Length > 0)
        {
            arguments["leader"] = deployLeader;
        }

        // Backlog section 23 (pass 28b): each SW checked goes to the second HS, the rest stay with the first (A1.31).
        if (DeployWeapons.Where(deployWeapons.Contains).ToArray() is { Length: > 0 } second)
        {
            arguments["secondWeapons"] = second;
        }

        return Propose(GameActions.Deploy, JsonSerializer.SerializeToElement(arguments));
    }

    private Task ProposeRecombine()
    {
        var arguments = new Dictionary<string, object>
        {
            ["gameId"] = gameId, ["attemptId"] = Attempt("recombine"), ["expectedRevision"] = (long)history!.Events.Count, ["halfSquads"] = new[] { recombineOne, recombineTwo },
        };
        if (recombineLeader.Length > 0)
        {
            arguments["leader"] = recombineLeader;
        }

        return Propose(GameActions.Recombine, JsonSerializer.SerializeToElement(arguments));
    }

    private Task ProposeEntry() => Propose(GameActions.EnterBuilding, JsonSerializer.SerializeToElement(new
    {
        gameId, attemptId = Attempt("enter"), expectedRevision = (long)history!.Events.Count, unitId = enterUnit, location = enterLocation.Trim(),
    }));

    /// <summary>The attacker's OVR choice for a pending attempt; an election is refused until step 10.</summary>
    private Task ProposeDeclaration(string unit, string choice) => Propose(GameActions.DeclareOverrun, JsonSerializer.SerializeToElement(new
    {
        gameId, attemptId = Attempt("declare"), expectedRevision = (long)history!.Events.Count, unitId = unit, choice,
    }));

    private async Task Propose(ActionDescriptor action, JsonElement arguments)
    {
        // Plan section 13.4: one request at a time; a second click while the gate works is dropped, not sent twice.
        if (busy)
        {
            return;
        }

        (busy, status) = (true, "Checking the proposal.");
        var asked = AskedBy;
        Proposal proposed;
        try
        {
            var revision = (long)(history?.Events.Count ?? 0);
            proposed = new Proposal(action, arguments, await Run(() => Live.Play.ProposeAsync(action, arguments, Live.Principal)), revision);
        }
        finally
        {
            busy = false;
        }

        // Pass 29: a result that returns for another game or view is dropped, never shown to the view that did not ask.
        if (AskedBy != asked)
        {
            status = string.Empty;
            return;
        }

        pending = proposed;
        status = $"{action.Name}: {OutcomeText(proposed.Result.Outcome, Withheld(proposed))}";
        ShowProposal();
        Refresh();
    }

    /// <summary>Runs a gate call; a failure inside it, such as a reviewed package that no longer verifies, is reported, not thrown.</summary>
    private static async Task<PlayResult> Run(Func<Task<PlayResult>> call)
    {
        try
        {
            return await call();
        }
        catch (InvalidOperationException exception)
        {
            return new PlayResult(PlayOutcome.Failed, new LimboDancer.Abstractions.Runtime.CorrelationId("failed"), ["play.error: " + exception.Message], null);
        }
    }

    private async Task Confirm()
    {
        if (pending is not { } proposal || busy)
        {
            return;
        }

        // Plan section 13.4: after a reconnect, another tab, or another viewer's commit, the game is read again first; a proposal made at another
        // revision is stale and is never confirmed (the gate also refuses it by its expected revision).
        var now = gameId.Length > 0 ? Live.History(gameId) : null;
        if (proposal.Revision is { } proposedAt && (now?.Events.Count ?? 0) != proposedAt)
        {
            pending = proposal with
            {
                Result = proposal.Result with
                {
                    Outcome = PlayOutcome.Stale,
                    Reasons = [$"The game is at revision {now?.Events.Count ?? 0}; this proposal was made at revision {proposedAt}."],
                },
            };
            status = OutcomeText(PlayOutcome.Stale, false);
            Refresh();
            return;
        }

        (busy, status) = (true, "Confirming.");
        var asked = AskedBy;
        PlayResult result;
        try
        {
            result = await Run(() => Live.Play.ConfirmAsync(proposal.Action, proposal.Arguments, Live.Principal, proposal.Result.Correlation));
        }
        finally
        {
            busy = false;
        }

        if (AskedBy != asked)
        {
            status = string.Empty;
            Refresh();
            return;
        }

        status = $"{proposal.Action.Name}: {OutcomeText(result.Outcome, false)}";
        pending = proposal with { Result = result };
        if (result.Outcome is PlayOutcome.Committed or PlayOutcome.Replay)
        {
            // A committed action's choices are spent: the next one starts from nothing.
            if (proposal.Action == GameActions.Setup)
            {
                placements.Clear();
            }
            else if (proposal.Action == GameActions.Fire)
            {
                ClearFire();
            }
            else if (proposal.Action == GameActions.EndMove)
            {
                moveTo = string.Empty;
                moveAssault = false;
                moveDoubleTime = false;
                moveMinimum = false;
                moveBypass = string.Empty;
            }
            else if (proposal.Action == GameActions.Move)
            {
                // A4.5: Double Time is declared for one step, not kept for the next; so are a Minimum Move and a Bypass.
                moveDoubleTime = false;
                moveMinimum = false;
                moveBypass = string.Empty;
            }
            else if (proposal.Action == GameActions.MoveVehicle)
            {
                // D7.1, B13.41, D2.15, D2.5 (table-player finding, pass 11): an OVR, an ALL entry, a Minimum Move, and ESB are declared for one expenditure.
                vehicleOverrun = false;
                vehicleAllMp = false;
                vehicleMinimum = false;
                vehicleEsb = string.Empty;

                // Rulings R26.1, R26.2: the Passengers chosen and the entry are for one expenditure too.
                vehicleLoad.Clear();
                vehicleUnload.Clear();
                vehicleEntryHex = string.Empty;
                vehicleEntryFacing = string.Empty;
            }
            else if (proposal.Action == GameActions.HookGun)
            {
                hookBoards = false;
            }
            else if (proposal.Action == GameActions.Rally)
            {
                rallyUnit = string.Empty;
                rallyLeader = string.Empty;
            }
            else if (proposal.Action == GameActions.Repair)
            {
                repairWeapon = string.Empty;
            }
            else if (proposal.Action == GameActions.Rout)
            {
                routUnit = string.Empty;
                routRoute = string.Empty;
                routLowCrawl = false;
            }
            else if (proposal.Action == GameActions.Deploy || proposal.Action == GameActions.Recombine)
            {
                deploySquad = deployLeader = string.Empty;
                deployWeapons.Clear();
                recombineOne = recombineTwo = recombineLeader = string.Empty;
            }
            else if (proposal.Action == GameActions.Transfer || proposal.Action == GameActions.Drop || proposal.Action == GameActions.Recover || proposal.Action == GameActions.Dismantle)
            {
                swWeapon = swUnit = string.Empty;
            }
            else if (proposal.Action == GameActions.AdvancePhase)
            {
                retainDm.Clear();
            }
            else if (proposal.Action == GameActions.Advance)
            {
                advanceUnits.Clear();
                advanceTo = string.Empty;
                advanceExit = string.Empty;
            }
            else if (proposal.Action == GameActions.CloseCombat)
            {
                ClearCloseCombat();
            }
        }

        Refresh();
    }

    private static string Attempt(string kind) => $"{kind}-{Guid.NewGuid():N}"[..(kind.Length + 13)];

    private static string OutcomeText(PlayOutcome outcome, bool withheld) => outcome switch
    {
        PlayOutcome.NeedsConfirmation when withheld => "The entry is declared. Confirm to commit it and resolve what it finds.",
        PlayOutcome.NeedsConfirmation => "Every check passed. Confirm to commit.",
        PlayOutcome.Committed => "Committed through the Execution Gate.",
        PlayOutcome.Replay => "Already committed by this attempt; nothing changed.",
        PlayOutcome.Stale => "Stale: the game moved on since the proposal. Propose again.",
        PlayOutcome.Denied => "Refused by the gate.",
        _ => "Failed.",
    };
