@using ASL.Turns
@using LimboDancer.Domains.Asl.MapStudio.Components.Turns
@page "/games/play"
@using System.Globalization
@using System.Text.Json
@using LimboDancer.Abstractions.Actions
@using LimboDancer.Abstractions.Domain
@using LimboDancer.Domains.Asl.Play
@using LimboDancer.Domains.Asl.Rules
@using LimboDancer.Domains.Asl.Units.Catalog
@using LimboDancer.Domains.Asl.Units.State
@using static LimboDancer.Domains.Asl.MapStudio.Services.FireText
@inject LivePlay Live
@inject NavigationManager Navigation
@inject UnitLibrary Library
@inject GameMaps GameMaps
@inject IServiceProvider Services
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>Play - ASL Map Studio</PageTitle>

@* Pass 31c (design D15; play test P-28, P-29): with a game open nothing sits outside the workspace, so the window does not scroll: the page's
   title is kept for assistive technology, its introduction is the context's "How this works", and the scripted dice are a tab of the activity
   strip. *@
@{
    RenderFragment intro = @<RuleHelp Id="play-intro" DetailLabel="How this works" Summary="Play a game from a scenario card: choose an action, review what it will do, then confirm it.">
        Live games are the Studio's chosen game source (D2). Every change is a registered action through the Execution Gate: the Studio proposes it,
        the gate checks it against the current game, boards, and catalog, and it commits only after you confirm. Nothing here edits a game directly.
    </RuleHelp>;
    RenderFragment? headerView = state is not null && handOver is null
        ? @<PerspectivePicker Id="play-perspective" Choices="@ViewChoices" Value="@viewAs" ValueChanged="ChangeView" Disabled="@busy" /> : null;
    // Game selection remains in the lobby and hand-over screen; the active game's view picker lives beside its card link.
    RenderFragment pickers = @<text>
        @if (state is null || handOver is not null)
        {
        <LiveGameToolbar Games="@ListedGames" GameId="@gameId" GameChanged="ChangeGame" Disabled="@busy" Views="@ViewChoices"
                         ViewAs="@(handOver ?? viewAs)" ViewChanged="ChangeView" />
        @* The Rules-first proving slice (ruling RPS.10): minigames are left out of the game and card lists unless shown. *@
        <label class="play-show-minigames" title="List the minigames' games and cards too">
            <input type="checkbox" id="play-show-minigames" checked="@showMinigames" @onchange="@(args => showMinigames = args.Value is true)" />
            Show minigames
        </label>
        }
        @if (gameId.StartsWith("campaign-", StringComparison.Ordinal))
        {
            <CampaignContextPanel GameId="@gameId" />
        }
    </text>;
}
@if (history is null)
{
    <PageHeader Title="Play">
        @intro
    </PageHeader>
    @if (Scripted is { } scripted)
    {
        <ScriptedDicePanel Queued="@([.. scripted.Queued])" @bind-Input="scriptedInput" Add="QueueDice" Clear="@(() => scripted.Clear())" Problem="@scriptedProblem" />
        <FollowRecordPanel Games="@ListedGames" Start="StartFollowing" Problem="@followProblem" />
    }
}
else
{
    <h2 class="page visually-hidden">Play</h2>
}

@* The user, 2026-10-17: with a game open, the context is a one-line banner from 1024px; "How this works" is the lobby's alone, and the page
   no longer says what the shown view does now. *@
@{
    // Read once a render: the turn's count reads the card, whose file a user card checks for changes; the right pane's turn line reuses it.
    bannerNow = Compact ? BannerParts : null;
}
<PlayContextHeader Summary="@ContextSummary" Banner="@bannerNow" Revision="@(state is not null && history?.Current is not null && (Viewer.IsAdjudicator || state.Ended is not null) ? state.Revision : null)" Busy="@busy" Live="@(state is null || history is null ? null : history.Current is not null)" Ended="@(state?.Ended is not null)"
                   Result="@ResultTitle" ResultReason="@ResultReason" ResultWhy="@ResultWhy" ViewPicker="@headerView"
                   Conditions="@(state is null ? null : NightAndWeather(state))" HasCard="@(state?.Scenario is not null && handOver is null)" CardChanged="@(state?.Scenario is { } changedCard && !Live.Cards.Matches(changedCard.Id, changedCard.Sha256))"
                   PendingTitle="@(handOver is null && pending is { Result.Outcome: PlayOutcome.NeedsConfirmation } waitingProposal ? DisplayText.Action(waitingProposal.Action.Name) : null)" Review="@FocusReview" Awaiting="@(AwaitingView is { } awaited ? ViewLabel(awaited) : null)"
                   AwaitingNote="@AwaitingNote" AwaitingDue="@AwaitingBlocks" HandOver="@HandOverToAwaiting" Status="@Said(status)" OpenCard="@OpenCard" Reserve="@(!Compact)">
    @if (!Compact)
    {
        @pickers
    }
</PlayContextHeader>

<HandOverScreen Next="@handOver" Label="@ViewLabel(handOver)" Confirmed="ConfirmView" PassLabel="@HandOverPassLabel" OnPass="@PassFromHandOver" PhasePassLabel="@HandOverPhasePassLabel" OnPhasePass="@PhasePassFromHandOver" When="@HandOverWhen" Why="@HandOverWhy" Tasks="@HandOverTasks"
                HappenedTitle="@HandOverHappenedTitle" Happened="@HandOverHappened" Score="@HandOverScore" Setup="@SetupOpen">
<Map>
    @* Pass 31c (design D16; the user, 2026-10-04; ruling R31c.3): the map as both sides know it, with the Locations the screen's lines name
       outlined. None during setup, when a side sets up out of the other's sight. *@
    @if (handOver is not null && state is not null && history?.Current is not null && !SetupOpen && HandOverPublic is { Board: { } handOverBoard } known)
    {
        _ = HandOverHappened;
        <HandOverMap Board="@handOverBoard" Units="@known.Units" Outlined="@happenedAt" />
    }
</Map>
<ChildContent>
@* Pass 31c (design D11): every panel reads a unit's name and a Location's words from the view's names, through one cascaded function. *@
<CascadingValue Name="Say" Value="@Words">
<CascadingValue Name="SayAt" Value="@WordsAt">
<CascadingValue Name="PlaceOfUnit" Value="@PlaceOfUnitNow" IsFixed="true">

@if (state?.Scenario is { } scenario)
{
    var playCard = CardRead(scenario.Id)?.Card;
    <PlayCardPanel Scenario="@scenario" Card="@playCard" Boards="@state.Map.Boards.Count" Changed="@(!Live.Cards.Matches(scenario.Id, scenario.Sha256))" FirstSide="@state.FirstSide" Ended="@state.Ended"
                   Groups="@([.. state.Sides.SelectMany(side => side.Groups.Select(group => $"{DisplayText.Side(side.Id)}: {group.Name} ({group.Id}), ELR {group.Elr?.ToString(CultureInfo.InvariantCulture) ?? "not given"}"))])"
                   Victory="@(playCard is not null ? VictoryNow : null)"
                   KnownTo="@VictoryKnownTo" Catalog="@($"{state.Catalog.Catalog}@{state.Catalog.Version}")"
                   Provenance="@(playCard is not null && PublishedCatalog is { } provenanceCatalog ? GameProvenance(playCard, scenario.Id, scenario.Sha256, provenanceCatalog) : null)"
                   OnClose="@CloseCard" />
}

@{
    // Pass 28c: the setup and the proposal review are drawn in the workspace once a game exists, and in the page's flow before it does.
    RenderFragment nonObBlock = @<text>
        @if (state is not null && history is { Events.Count: > 0 } && SetupView is not { CurrentOrder: not null })
        {
            @foreach (var side in state.Sides.Where(side => Viewer.IsAdjudicator || side.Id == viewAs))
            {
                var choices = NonObChoices(side.Id);
                <fieldset class="setup-non-ob" data-side="@side.Id">
                    <legend>Non-OB "?" for @DisplayText.Side(side.Id) (A12.12; ruling R23.6)</legend>
                    <RuleHelp Id="@($"non-ob-help-{side.Id}")" Summary='Once both sides have set up, a stack with no "?" out of the LOS of every unbroken enemy ground unit within 16 hexes may take one (A12.12). Its hexes are outlined on the map; a click on one ticks or unticks it.'>
                        Once both sides have set up, a stack with no "?" may take one if it is out of the LOS of every unbroken enemy ground unit within 16 hexes, or
                        17 hexes or more from all of them. Hidden units are not on the board and do not count. The game checks this against every enemy unit, those
                        under "?" too, as the opponent would at the table; a refusal names no enemy Location.
                    </RuleHelp>
                    @if (choices.Count == 0)
                    {
                        <p class="muted non-ob-none">No stack of @DisplayText.Side(side.Id) may take a non-OB "?" now.</p>
                    }
                    else
                    {
                        @* Pass 30b: every stack that may take a "?" in one step; a "?" costs a unit nothing until it acts, so all of them is the start. *@
                        <button type="button" class="non-ob-all" id="@($"non-ob-all-{side.Id}")"
                                @onclick="@(() => nonObChosen.UnionWith(choices.Select(at => $"{side.Id}|{at}")))">Tick every stack that may take a "?" (@choices.Count)</button>
                        @foreach (var at in choices)
                        {
                            var key = $"{side.Id}|{at}";
                            <label><input type="checkbox" class="non-ob-location" value="@at" checked="@nonObChosen.Contains(key)"
                                          @onchange="@(args => Toggle(nonObChosen, key, args.Value is true))" /> @PlaceOf(at)</label>
                        }
                        <button class="propose-non-ob" disabled="@(!choices.Any(at => nonObChosen.Contains($"{side.Id}|{at}")))" aria-describedby="@($"non-ob-ready-{side.Id}")"
                                @onclick="@(() => ProposeNonOb(side.Id, choices))">Propose: place @DisplayText.Side(side.Id)'s non-OB "?"</button>
                        @if (!choices.Any(at => nonObChosen.Contains($"{side.Id}|{at}")))
                        {
                            <span id="@($"non-ob-ready-{side.Id}")" class="toolbar-note">Tick at least one Location.</span>
                        }
                    }
                </fieldset>
            }
        }
    </text>;
    // Pass 71 (A14.2; ruling R71.11): once both sides of a card have set up, each side with a SAN of 2 or more places its Sniper counter, the DEFENDER first;
    // the other side is told only that it does.
    RenderFragment sniperBlock = @<text>
        @if (state is not null && SetupOpen && history is { Events.Count: > 0 } && SetupView is { CurrentOrder: null } && SniperDue is [var sniperSide, ..])
        {
            <fieldset class="setup-sniper" id="setup-sniper" data-side="@sniperSide">
                <legend>Sniper counter for @DisplayText.Side(sniperSide) (A14.2; ruling R71.11)</legend>
                @if (Viewer.IsAdjudicator || sniperSide == viewAs)
                {
                    var sniperHexes = Live.Planner.SniperPlacements(state, sniperSide);
                    <RuleHelp Id="sniper-help" Summary="Before play, each side with a SAN of 2 or more places its Sniper counter, the DEFENDER first (A14.2).">
                        The counter goes in an unoccupied hex within six hexes of six or more enemy-occupied hexes, or of five if no hex has six, and so on; anywhere
                        when no enemy unit is on the board. Enemy "?" count, hidden units and the enemy Sniper counter do not. The counter is seen by both sides.
                    </RuleHelp>
                    <label>
                        Hex
                        <select id="@($"sniper-hex-{sniperSide}")" class="sniper-hex" value="@sniperHex" @onchange="@(args => sniperHex = args.Value?.ToString() ?? string.Empty)">
                            <option value="">Choose a hex (@sniperHexes.Count)</option>
                            @foreach (var at in sniperHexes)
                            {
                                <option value="@at">@PlaceOf(at)</option>
                            }
                        </select>
                    </label>
                    var sniperChosen = sniperHexes.Any(at => at.ToString() == sniperHex);
                    <button type="button" class="propose-sniper" id="@($"propose-sniper-{sniperSide}")" disabled="@(!sniperChosen)"
                            title="@(sniperChosen ? null : "Choose a hex the setup offers (A14.2).")"
                            @onclick="@(() => ProposeSniper(sniperSide))">Propose: place @DisplayText.Side(sniperSide)'s Sniper counter</button>
                }
                else
                {
                    <p class="muted" id="sniper-waiting">The @DisplayText.Side(sniperSide) side places its Sniper counter now (A14.2). Hand the screen over by choosing its view.</p>
                }
                @if (SniperDue.Count > 1)
                {
                    <p class="muted" id="sniper-next">The @DisplayText.Side(SniperDue[1]) side places its own next (A14.2: the DEFENDER first).</p>
                }
            </fieldset>
        }
    </text>;
    RenderFragment setupBlock = @<div id="play-setup" class="@(SetupMode ? "setup-mode" : null)">
        <h3>Setup</h3>
        @if (SetupMode && SetupView is { } modeReport)
        {
            @* Pass 30, the workflow rebuilt: setup is a mode of the actions pane: one bar, and the Plans, Counters, and Card OB tabs. *@
            <div id="setup-done-live" aria-live="polite">
                @if (setupDone is { } done)
                {
                    <div id="setup-done" class="setup-done">
                        <p>@done.Text</p>
                        @if (done.Next is { } nextSide && nextSide != viewAs && !Viewer.IsAdjudicator)
                        {
                            <button type="button" id="setup-handover" @onclick="@(() => ChangeView(nextSide))">Hand the screen to the @DisplayText.Side(nextSide) side</button>
                        }
                    </div>
                }
            </div>
            <SetupBar Title="@SetupBarTitle" Progress="@SetupBarProgress" Detail="@SetupBarDetail" Source="@SetupBarSource" Count="@placements.Count"
                      Problems="@(SetupProblems?.Count ?? 0)" CanAct="@(MaySetUp.Count > 0 || placements.Count > 0)" Busy="@busy"
                      Empty="@(MaySetUp.Count == 0 ? "The list is empty." : PlansOffered is { Plans.Count: > 0 } ? "The list is empty: use a setup plan, or \"Set up\" a group under Counters."
                          : "The list is empty: \"Set up\" a group under Counters, or add counters by hand.")"
                      Question="@setupAsk?.Text" Yes="@(setupAsk?.Yes ?? string.Empty)" OnPropose="@ProposeSetup" OnClear="@AskClear" OnAnswer="@AnswerAsk" />
            @if (modeReport.Groups.Where(group => Unseen.Contains(group.Id)).Select(group => group.Side).Distinct().ToArray() is { Length: > 0 } unseenNow)
            {
                <p id="setup-out-of-sight" class="diagnostic">
                    The @string.Join(" and the ", unseenNow.Select(DisplayText.Side)) side @(unseenNow.Length == 1 ? "sets" : "set") up now, out of your sight: its placements are not
                    shown to @DisplayText.ViewName(Viewer.Name) until it has finished, and only it places units now. Hand the screen over by choosing its view (A12.12).
                </p>
            }
            @if (placeNote is not null)
            {
                <p id="place-note" class="diagnostic warning">@placeNote</p>
            }
            @if (swapNote is not null)
            {
                <p id="setup-swap-note-list" class="diagnostic">@swapNote</p>
            }
            @if (SeenNote is { } seenNote)
            {
                <p id="setup-seen" class="muted">@seenNote</p>
            }
            @if (PlansOffered is null && MaySetUp.Count > 0 && modeReport.CurrentOrder is not null && !Viewer.IsAdjudicator)
            {
                <p id="setup-no-plans" class="muted">This card has no setup plans for this side: set up by hand under Counters.</p>
            }
            <InspectorTabs Tabs="@SetupTabs" Selected="@SetupTab" SelectedChanged="@(tab => setupTab = tab)" Label="Setup" IdPrefix="setup">
                @if (SetupTab == "plans" && PlansOffered is { } offered)
                {
                    <SetupPlanPicker Side="@DisplayText.Side(viewAs)" Plans="@offered.Plans" Groups="@PlanGroups" MatchNote="@MatchNote" Problems="@offered.Problems" Chosen="@chosenPlan" Changes="@PlanChanges.Count" Shown="@shownPlan"
                        Earlier="@(offered.Plans.Where(plan => plan.CardSha256 != state!.Scenario!.Sha256).Select(plan => plan.Id).ToHashSet(StringComparer.Ordinal))"
                        EarlierAnswers="@(Reading?.Earlier ?? new Dictionary<string, string>())" PublicNotes="@(Reading?.Notes ?? new Dictionary<string, string>())"
                        OnUse="@AskUsePlan" OnShow="@ShowPlan" />
                }
                else if (SetupTab == "ob")
                {
                    <SetupPoolsTable Report="@modeReport" DefinitionLabel="@DefinitionLabel" OutOfSight="@Unseen" />
                }
                else
                {
                    @if (MaySetUp.Any(id => GroupLacks(id) > 0))
                    {
                        <div class="toolbar" id="setup-groups">
                            @foreach (var group in modeReport.Groups.Where(group => MaySetUp.Contains(group.Id) && GroupLacks(group.Id) > 0))
                            {
                                var topUp = placements.Any(row => row.Group == group.Id);
                                <button type="button" class="setup-group" id="@($"setup-group-{group.Id}")" @onclick="@(() => SetUpGroupNow(group.Id))">@(topUp ? $"Add what {group.Name} still owes" : $"Set up {group.Name}")</button>
                            }
                            <span class="toolbar-note">Adds one line for each counter the group still has to set up and the list does not hold yet.</span>
                        </div>
                    }
                    <SetupCounters Model="@CounterModel" OnChange="@ChangePlacement" OnMove="@(key => (pickingKey, swapFrom) = (pickingKey == key ? null : key, null))" OnLevel="@SetStackLevel"
                                   OnSelect="@SelectStack" OnRemove="@RemovePlacement" OnSwap="@(location => (swapFrom, pickingKey, swapNote) = (swapFrom == SwapHex(location) ? null : SwapHex(location), null, null))" />
                    @nonObBlock
                    @sniperBlock
                    <details id="setup-by-hand">
                        <summary>Add a counter by hand</summary>
                        <SetupPlacementEditor Draft="@PlaceDraft" Definitions="@DefinitionChoices" Groups="@GroupChoiceList" Entries="@EntryChoices"
                            Kind="@(Definitions.FirstOrDefault(definition => definition.Id == placeDefinition)?.Kind)" ArmedAfv="@GamePlanner.IsArmedAfv(placeDefinition)" RiderAllowed="@PlaceRiderAllowed" OnDraft="@ApplyPlaceDraft" OnAdd="@AddPlacement" />
                    </details>
                }
            </InspectorTabs>
        }
        else
        {
            @if (ChosenCard is { Minimal: true } || (state?.Scenario is { } playing && CardRead(playing.Id)?.Card is { Minimal: true }))
            {
                <p id="setup-minimal" class="muted">A minimal card has no OB: set up each side's units by hand (ruling R22.3).</p>
            }
            @if (SetupView is { } setup)
            {
                <SetupPoolsTable Report="@setup" DefinitionLabel="@DefinitionLabel" OutOfSight="@Unseen" />
            }
            @nonObBlock
            @sniperBlock
            @if (history is null && ChosenCard is { Minimal: false } startCard)
            {
                @* Pass 30: the game may start with no counter placed, so each side sets up on the game's map, in its own view. *@
                @if (ChosenPlanCount + chosenPlans.Others > 0)
                {
                    var otherSide = startCard.Sides.FirstOrDefault(side => side.Side != startCard.Turns.SetsUpFirst)?.Side;
                    <p id="start-plans-note">This card has @(string.Join(" and ", new[] { (Count: ChosenPlanCount, Side: startCard.Turns.SetsUpFirst), (Count: chosenPlans.Others, Side: otherSide ?? string.Empty) }
                        .Where(item => item.Count > 0).Select(item => $"{Count(item.Count, "setup plan", "setup plans")} for the {DisplayText.Side(item.Side)} side"))), each offered in that side's own view once the game has started.</p>
                }
                <div class="toolbar" id="start-game-bar">
                    <button type="button" id="start-game" disabled="@(placements.Count > 0)" aria-describedby="start-game-note" @onclick="@StartGame">Start the game, then set up on the map</button>
                    <span id="start-game-note" class="toolbar-note">@(placements.Count > 0
                        ? "The list below holds counters: propose them, or clear the list to start with none."
                        : $"Starts the game with no counter placed. {DisplayText.Side(startCard.Turns.SetsUpFirst)} then sets up first, on the map, in its own view.")</span>
                </div>
                <details id="setup-before-start">
                    <summary>Or type the first counters here</summary>
                    <SetupPlacementEditor Draft="@PlaceDraft" Definitions="@DefinitionChoices" Groups="@GroupChoiceList" Entries="@EntryChoices"
                        Kind="@(Definitions.FirstOrDefault(definition => definition.Id == placeDefinition)?.Kind)" ArmedAfv="@GamePlanner.IsArmedAfv(placeDefinition)" RiderAllowed="@PlaceRiderAllowed" Note="@placeNote" OnDraft="@ApplyPlaceDraft" OnAdd="@AddPlacement" />
                    <SetupPlacementList Items="@PlacementItems" Ready="@CardChosen" OnRemove="@RemovePlacement" OnChange="@ChangePlacement" OnClear="@ClearPlacements" OnPropose="@ProposeSetup" />
                </details>
            }
            else
            {
                <SetupPlacementEditor Draft="@PlaceDraft" Definitions="@DefinitionChoices" Groups="@GroupChoiceList" Entries="@EntryChoices"
                    Kind="@(Definitions.FirstOrDefault(definition => definition.Id == placeDefinition)?.Kind)" ArmedAfv="@GamePlanner.IsArmedAfv(placeDefinition)" RiderAllowed="@PlaceRiderAllowed" Note="@placeNote" OnDraft="@ApplyPlaceDraft" OnAdd="@AddPlacement" />
                <SetupPlacementList Items="@PlacementItems" Ready="@(history is not null || CardChosen)" OnRemove="@RemovePlacement"
                    OnChange="@ChangePlacement" OnClear="@ClearPlacements" OnPropose="@ProposeSetup" CanPick="@(history?.Current is not null && MapLayers?.Board is not null)"
                    OnPick="@(key => pickingKey = pickingKey == key ? null : key)" />
            }
        }
    </div>;
    RenderFragment reviewBlock = @<div class="play-review-body">
        @if (pending is { } proposal)
        {
            <ProposalReviewPanel Presentation="@ProposalOutcomeView.From(proposal.Result.Outcome)" Title="@proposal.Action.Name" Accepted="@(proposal.Result.Outcome is PlayOutcome.NeedsConfirmation or PlayOutcome.Committed or PlayOutcome.Replay)"
                                 Outcome="@(ConsequencesOf(proposal).Count > 0 ? ConsequencesOutcome : OutcomeText(proposal.Result.Outcome, Withheld(proposal)))"
                                 Reasons="@([.. ReviewReasons(proposal).Where(reason => GamePlanner.ConsequenceOf(reason) is null || proposal.Result.Outcome != PlayOutcome.NeedsConfirmation)])"
                                 Consequences="@([.. ConsequencesOf(proposal).Select(item => item.Text.EndsWith('.') ? item.Text : item.Text + ".")])" ConfirmLabel="@ConfirmLabel(ConsequencesOf(proposal))"
                                 CanConfirm="@(proposal.Result.Outcome == PlayOutcome.NeedsConfirmation)" Busy="@busy" Confirm="Confirm" Cancel="@CancelProposal">
                <Lead>
                    @if (Viewer.IsAdjudicator && proposal.Action == GameActions.ReviewPlacedDcWindow
                        && proposal.Arguments.GetProperty("review").Deserialize<LimboDancer.Domains.Asl.Rules.TurnPlacedDcReview>() is { } openingReview)
                    {
                        <TurnOpeningReviewSummary Review="@openingReview" />
                    }
                    @* Pass 31c (design D14; play test P-14): a fire's arithmetic before the dice, for the firing side and the adjudicator. *@
                    @if (proposal.Result is { Outcome: PlayOutcome.NeedsConfirmation, Plan.Fire: { } previewed } && (Viewer.IsAdjudicator || Viewer.Name == previewed.FiringSide)
                        && FirePreview(previewed.Attack) is { Arithmetic: { } preview } shownPreview)
                    {
                        <FireArithmeticPreview Arithmetic="@preview" Incomplete="@shownPreview.Incomplete" />
                    }
                    @if (PlacesCounters(proposal) && setupReview is { } summary)
                    {
                        <div id="setup-review">
                            <p id="setup-review-text">@summary.Text</p>
                            @if (SetupProblems is { Count: > 0 } refusals)
                            {
                                <p id="setup-problems-lead">@(refusals.Count == 1 ? "One thing to fix; its link shows the counter in the list and on the map:" : "What to fix; each link shows the counter in the list and on the map:")</p>
                                <ul id="setup-problems">
                                    @foreach (var refusal in refusals)
                                    {
                                        <li>
                                            @if (refusal.Key is { } rowKey)
                                            {
                                                <button type="button" class="link setup-problem" title="Shows this counter in the list and its hex on the map." @onclick="@(() => ShowRow(rowKey))">@refusal.Text</button>
                                            }
                                            else
                                            {
                                                @refusal.Text
                                            }
                                        </li>
                                    }
                                </ul>
                            }
                            @if (summary.Changes.Count > 0)
                            {
                                <ul id="setup-review-changes">
                                    @foreach (var change in summary.Changes)
                                    {
                                        <li>@change</li>
                                    }
                                </ul>
                            }
                            @if (proposal.Result.Outcome == PlayOutcome.NeedsConfirmation && summary.Counters > 0)
                            {
                                <p id="setup-final"><strong>Confirm is final:</strong> the setup cannot be changed afterwards.</p>
                            }
                        </div>
                    }
                </Lead>
                <Evidence>
                    @if (proposal.Result.Plan?.Entry is { } review && !Withheld(proposal))
                    {
                        <EntryReviewFacts Review="@review" />
                    }
                    @if (proposal.Result.Plan?.Fire is { Attack: var attack })
                    {
                        <FireReviewFacts Attack="@attack" FireGroup="@FireGroupText(attack)" Range="@RangeText(attack)" />
                    }
                </Evidence>
            </ProposalReviewPanel>
        }
    </div>;
}

@if (history is null)
{
    <h3>New game</h3>
    <NewGameFromCard Cards="@CardChoices" Card="@scenarioCard" CardChanged="@ChooseCard"
                     @bind-GameId="newId" @bind-Label="newLabel" Start="@NewStart" BalanceSides="@BalanceSides" BalanceTexts="@BalanceTexts"
                     @bind-Balance="newBalance" @bind-PlayerOne="playerOne" @bind-PlayerTwo="playerTwo" />
    @setupBlock
    @reviewBlock
}
else if (history.Current is null && state is null)
{
    <GameReplayFailure Diagnostics="@history.Diagnostics"
                       MissingCatalog="@(history.Events.FirstOrDefault()?.Payload is GameStarted started && UnitCatalogs.For(Live.Catalogs, started.Catalog) is null ? started.Catalog : null)" />
}
else if (state is not null)
{
    @* Pass 28c (plan sections 11.1 and 13.1): the workspace. Wide, the actions, the map, and the review sit side by side over the activity strip;
       narrower, the map and one side pane; under 1024px, labelled Map, Actions, and Activity tabs, with the review above them. Pass 29: the map and
       the review pane are BoardWorkspace, the review pane its inspector, with the proposal as its first tab. *@
    <div id="play-workspace" class="@((narrow ? "play-workspace narrow" : "play-workspace") + (SetupMode ? " setup" : string.Empty))">
        @{
            RenderFragment recordsBlock = @<text>
                @if (NoRecords)
                {
                    <p class="muted" id="play-records-none">No dice rolled and no actions recorded yet.</p>
                }
                @if (Records is { } actionRecords)
                {
                    <ActionOutcomeHistory @key="(gameId, viewAs)" Outcomes="@actionRecords.Outcomes" Replay="@ReplayFrom" ViewKey="@(gameId + ":" + viewAs)" />
                }
                <details><summary>Recent raw rolls</summary><DiceRollHistory Rolls="@RollRows" Scripted="@(Scripted is not null)" /></details>
                @if (SniperMissing is { } sniperMissing)
                {
                    <p class="muted" id="play-sniper-missing">@sniperMissing</p>
                }
            </text>;
            RenderFragment unitsBlock = @<text>
                <h3 class="@PlayHeadingClass">Units</h3>
                @* A side is shown no revision in a game still played (backlog section 49; ruling R31b.1). *@
                <PlayUnitTable ViewNote="@(Viewer.IsAdjudicator ? $"As the adjudicator sees them: every unit, at revision {state.Revision}." : $"As {DisplayText.ViewName(Viewer.Name)} sees them{(state.Ended is not null ? $", at revision {state.Revision}" : string.Empty)}.")"
                               Rows="@UnitRows" Sealed="@([.. SealedPresences])" Locate="@LocateHex" />
            </text>;
            RenderFragment diceBlock = @<text>
                @if (Scripted is { } scriptedDice)
                {
                    <ScriptedDicePanel Queued="@([.. scriptedDice.Queued])" @bind-Input="scriptedInput" Add="QueueDice" Clear="@(() => scriptedDice.Clear())" Problem="@scriptedProblem" />
                    <FollowRecordPanel Games="@ListedGames" Source="@(followGame == gameId ? followSource : null)"
                                       Revision="@state.Revision" Of="@followOf" Running="@(followRun is not null)" Start="StartFollowing" Next="@(() => FollowNext())"
                                       Run="FollowRun" Problem="@followProblem" />
                }
            </text>;
            RenderFragment proposalBlock = @<div id="play-proposal-tab">
                @if (pending is null)
                {
                    <p class="muted" id="play-review-none">Nothing to review: a proposal shows here, with Confirm and Cancel.</p>
                }
                @reviewBlock
                @if (PickedNote is { } pickedNote && pending?.Action != GameActions.Setup)
                {
                    <p class="muted" id="play-picked-note">@pickedNote</p>
                }
            </div>;
            @* The actions: from 1024px the inspector's first tab, Play, kept rendered while another tab is open, so the map has the width the
               actions column had; under 1024px their own pane, as the Actions tab of the workspace. *@
            RenderFragment actionsBlock = @<section id="play-panel-actions" class="play-pane play-actions" tabindex="-1" @ref="actionsPane" @attributes="@Pane("actions", "Actions")">
            @if (state is { Ended: null } && history?.Current is not null && !(SetupOpen && SetupView is not null && SetupIncomplete))
            {
                <div class="toolbar" id="play-phase-end">
                    @* Keep the phase-end action next to the turn and phase header, with the existing refusal and waiting gates. *@
                    @if (MayEndPhase && PhaseEndBarNow is { } phaseEndBar)
                    {
                        <span id="advance-owed" class="toolbar-note">@phaseEndBar</span>
                    }
                    else if (MayEndPhase)
                    {
                        <button id="propose-advance" disabled="@WaitsOnAnswer" @onclick="ProposeAdvance">Propose: end the @Games.PhaseLabel(state.Phase)</button>
                    }
                    else
                    {
                        <span id="advance-other" class="toolbar-note">The @DisplayText.Side(GamePlanner.PhaseEndedBy(state, viewAs)) side ends the @Games.PhaseLabel(state.Phase).</span>
                    }
                </div>
            }
            @if (Compact)
            {
                <div class="play-tab-context" id="play-tab-context">@pickers</div>
            }
            @if (state is not null && handOver is null)
            {
                @if (state.Ended is null && history?.Current is not null && !(SetupOpen && SetupView is not null && SetupIncomplete))
                {
                    @* The user, 2026-10-22: while the other side's decision holds play up, the view says so first and offers the hand-over as its main
                       action; the banner's hand-over alone, there in every phase, was no signal. *@
                    @if (AwaitingBlocks && AwaitingView is { } awaitedSide)
                    {
                        <div class="play-waiting" id="play-waiting" role="status">
                            <p class="play-waiting-title">Waiting for the @DisplayText.Side(awaitedSide) side</p>
                            <p id="play-waiting-why">@WaitingWhy</p>
                            <button type="button" class="primary" id="play-waiting-hand-over" @onclick="HandOverToAwaiting">Hand the screen to the @DisplayText.Side(awaitedSide) side</button>
                        </div>
                    }
                    @* Table player, pass 28c: what play waits on comes first. *@
                    @if (state.Choice is { } choice && ChoiceShown(choice))
                    {
                        <PendingChoicePanel Key="@choice.Key" Side="@choice.Side" Description="@GamePlanner.DescribeChoice(choice)" MayAnswer="@MayAnswer(choice.Side)"
                            Options="@ChoiceOptions(choice)" OnChoose="@(option => ProposeChoose(choice.Key, option))" />
                    }
                    @foreach (var surrender in state.PendingSurrenders)
                    {
                        var captorSide = surrender.Captors.Select(state.Unit).OfType<UnitInstance>().Select(unit => unit.Side).FirstOrDefault();
                        <PendingSurrenderPanel @key="surrender.Event" Unit="@surrender.Unit" MayAnswer="@MayAnswer(captorSide)" Captors="@(MayAnswer(captorSide) ? surrender.Captors : [])"
                            OnTake="@(captor => ProposeTakePrisoner(surrender.Unit, captor))" OnReject="@(() => ProposeRejectSurrender(surrender.Unit))"
                            OnFree="@(() => ProposeFreeSurrender(surrender.Unit))" />
                    }
                    @foreach (var open in state.OpenAttempts)
                    {
                        <OpenEntryDeclaration EventId="@open.EventId" Unit="@open.Unit" Target="@open.Target.ToString()" OnDecline='@(() => ProposeDeclaration(open.Unit, "decline"))'
                            OnElect='@(() => ProposeDeclaration(open.Unit, "elect"))' />
                    }
                    @* Pass 31 (ruling R5.8; play test P-09): while a choice or a surrender waits, nothing else is proposed. *@
                    @if (WaitsOnAnswer)
                    {
                        <p id="play-answer-first" class="muted">Every other action waits until the answer above is given (ruling R5.8).</p>
                    }
                }
            }
            @* Table player, pass 29: the hex picked on the map is offered to every typed Location of the actions. *@
            <CascadingValue Name="PickedLocation" Value="@highlight?.ToString()">
            @* Pass 31c (design D13): a typed Location can be armed, and the next hex clicked on the map fills it. Setup has its own picking. *@
            <CascadingValue Name="Picking" Value="@(SetupOpen ? null : Picking)">
            <CascadingValue Name="PrimarySections" Value="@PrimarySections">
            @if (!SetupOpen && Picking.Armed is not null)
            {
                <p id="play-picking" class="toolbar-note" role="status">
                    The next hex clicked on the map @(Picking.ArmedLabel is { Length: > 0 } armedLabel ? armedLabel : "fills the Location"), at ground level.
                    <button type="button" class="link" id="play-picking-stop" @onclick="@(() => Picking.Arm(null, null))">Stop picking</button>
                </p>
            }
            @if (SetupOpen)
            {
                @setupBlock
            }
            @if (state is { Ended: not null } && history?.Current is not null)
            {
                @* Ruling R20.1: nothing happens in a game that has ended, so the page offers no action; its records, units, and map stay. *@
                <h3 class="@PlayHeadingClass">Play</h3>
                <p id="play-over" class="muted">The game is over, and no more actions are proposed (A3.9; ruling R20.1).</p>
                @* Pass 31 (play test P-08): the result stands here too, with the account of every condition. *@
                <p id="play-over-result"><strong>@ResultTitle</strong> @ResultReason</p>
                @* Pass 31b: the ended game is played back on the Replay page. *@
                <p><a id="play-replay" href="@ReplayFrom(null)">Replay this game</a></p>
                @if (ResultWhy.Count > 0)
                {
                    <ul id="play-over-why">
                        @foreach (var line in ResultWhy)
                        {
                            <li>@line</li>
                        }
                    </ul>
                }
            }
            else if (state is not null && history?.Current is not null && !(SetupOpen && SetupView is not null && SetupIncomplete))
            {
                <h3 class="@PlayHeadingClass">Play</h3>
                <fieldset class="plain" id="play-actions" disabled="@WaitsOnAnswer">
                @if (!SetupOpen && SpotterDeclarationChoices.Guns.Count > 0)
                {
                    <SpotterDesignationPanel Guns="@SpotterDeclarationChoices.Guns" Candidates="@SpotterDeclarationChoices.Candidates"
                        Gun="@spotterDeclarationGun" Spotter="@spotterDeclarationUnit" Replacement="@SpotterDeclarationChoices.Replacement"
                        Ready="@SpotterDeclarationReady" Note="@SpotterDeclarationNote"
                        OnGun="@(id => { spotterDeclarationGun = id; spotterDeclarationUnit = string.Empty; })"
                        OnSpotter="@(id => spotterDeclarationUnit = id)" OnPropose="ProposeSpotterDeclaration" />
                }
                @* The Play streamlining plan, S7 (ruling R-PS.2): a hidden unit is placed beneath "?" before it moves or advances (A12.32), so the
                   offer is its side's, in that side's own MPh and APh. *@
                @if (!SetupOpen && state.Phase is "mph" or "aph" && VisibleUnits.Where(unit => unit.Status == InstanceStatus.Active && GameState.Condition(unit, Conditions.Hidden) == ConditionState.True
                    && state.Location(unit.Id) is not null && unit.Side == state.PhasingSide && (Viewer.IsAdjudicator || unit.Side == viewAs)).ToArray() is { Length: > 0 } hiddenUnits)
                {
                    <div class="toolbar" id="play-hidden">
                        <span class="toolbar-note">Hidden units (HIP): each is placed beneath a "?" before it moves or advances, or whenever its side chooses (A12.32; ruling R23.5).</span>
                        @foreach (var unit in hiddenUnits)
                        {
                            <button class="place-hidden" data-unit="@unit.Id" @onclick="@(() => ProposePlaceHidden(unit.Id))">Propose: place @Words(unit.Id) in @PlaceOf(state.Location(unit.Id)!.Location) beneath "?"</button>
                        }
                    </div>
                }
                @* Pass 70 (A12.14; ruling R70.20): the owner gives up a "?" at any time of either side's Player Turn; his own units under "?", hidden, or
                   Dummies, by hex. *@
                @* Pass 70's fixes: in a section of its own, which starts closed, and refused while an answer waits (ruling R5.8). *@
                @if (!SetupOpen && RemoveConcealmentRows.Count > 0)
                {
                    <ActionSection Title="Give up &quot;?&quot;" Key="remove-concealment">
                    <div class="toolbar" id="play-remove-concealment">
                        <UnitSelectionList Rows="@RemoveConcealmentRows" Selected="@removeConcealment" CssClass="remove-concealment-unit" Legend="Give up &quot;?&quot;"
                            OnToggle="@(toggle => { if (toggle.On) { removeConcealment.Add(toggle.Id); } else { removeConcealment.Remove(toggle.Id); } })" />
                        <button id="propose-remove-concealment" disabled="@(removeConcealment.Count == 0 || busy || WaitsOnAnswer)"
                                title="@(WaitsOnAnswer ? "Every other action waits until the answer above is given (ruling R5.8)." : busy ? "A proposal is being made; wait for it."
                                    : removeConcealment.Count == 0 ? "Tick the units that give up their \"?\" first."
                                    : "The owner may remove any concealment at any time of his or his opponent's Player Turn: a concealed unit is revealed, a hidden one placed and revealed in full, a Dummy removed (A12.14, A12.31, A12.11).")"
                                @onclick="ProposeRemoveConcealment">Propose: give up "?"</button>
                    </div>
                    </ActionSection>
                }
                @* The Play streamlining plan, S7 (ruling R-PS.1): no separate building-entry form; a one-unit step into a building goes to the same
                   entry plan through the Movement form. *@
                @* A10.5 (the user, 2026-10-22): the DEFENDER's routs wait for the ATTACKER's, so his Rout panel is not offered meanwhile; the waiting
                   callout above says why. *@
                @* Pass 70 (ruling R70.11): the Voluntary Break is offered to either side at the RtPh's start, before any unit routs, the DEFENDER's too. *@
                @if (state.Phase == "rtph" && ((!DefenderRoutsWait && (RoutObligations.Count > 0 || RoutChoices.Count > 0)) || VoluntaryBreakRows.Count > 0))
                {
                    <RoutActionPanel Obligations="@RoutObligations" Units="@RoutChoices" Unit="@routUnit" Route="@routRoute" LowCrawl="@routLowCrawl"
                        Load="@RoutLoadText" Loads="@RoutLoads" Keep="@string.Join(",", RoutKept)" OnKeep="@(keep => routKeep = keep)"
                        OnUseRoute="@(way => (routUnit, routRoute, routKeep, routLowCrawl, routLeader) = (way.Unit, way.Route, way.Unit == routUnit ? routKeep : string.Empty, routLowCrawl && !way.Route.Contains(','), way.Unit == routUnit ? routLeader : string.Empty))"
                        OnUnit="@(id => (routUnit, routKeep, routRoute, routLeader) = (id, string.Empty, id == routUnit ? routRoute : string.Empty, id == routUnit ? routLeader : string.Empty))" OnRoute="@(route => routRoute = route)" OnLowCrawl="@(on => routLowCrawl = on)" OnPropose="@ProposeRout"
                        OnRoutGroup="@ProposeRoutGroup" OnBeneath="@ProposeRoutBeneath" Busy="@busy"
                        RoutsOffered="@(!DefenderRoutsWait)" BreakRows="@VoluntaryBreakRows" BreakSelected="@voluntaryBreak" OnBreakToggle="@(toggle => { if (toggle.On) { voluntaryBreak.Add(toggle.Id); } else { voluntaryBreak.Remove(toggle.Id); } })"
                        OnProposeBreak="@ProposeVoluntaryBreak" Leaders="@RoutLeaders" Leader="@routLeader" OnLeader="@(id => routLeader = id)" />
                }
                @* The Play streamlining plan, S7 (ruling R-PS.3): the panel and each of its actions only when the phase allows it to the view; in the RtPh
                   the Rout form chooses what a broken unit keeps. *@
                @if (state.Phase != "rtph" && !MoverWaits && SupportWeaponsNow is ({ Count: > 0 } swShown, { Any: true } swOffers))
                {
                    <SupportWeaponActionPanel Weapons="@([.. swShown.Select(weapon => new PlayChoice(weapon.Id, SupportWeaponText(weapon)))])" Offers="@swOffers"
                        Units="@([.. SupportWeaponUnits.Select(Labelled)])" Weapon="@swWeapon" Unit="@swUnit" Held="@(SupportWeaponHolder is not null)" Dismantles="@(swWeapon.Length > 0 && Live.Planner.MayDismantle(state, swWeapon))"
                        RecoverBar="@(state.Unit(swUnit) is { } recovering && Live.Planner.RecoverPhaseBar(state, recovering) is { } recoverBar ? PlainReason(recoverBar) : null)"
                        OnWeapon="@(id => { swWeapon = id; swUnit = string.Empty; })" OnUnit="@(id => swUnit = id)" OnPropose="@ProposeSupportWeaponKind" />
                }
                @* Pass 40 (A20.5, p. 88): an unbroken Guard squad Deploys at will, in any phase; in the RPh the Deploy panel takes it. *@
                @if (state.Phase != "rph" && GuardSquads is { Count: > 0 } guardSquads)
                {
                    <ActionSection Title="A Guard's Deployment" Key="guard-deploy">
                    <div class="toolbar" id="guard-deploy">
                        <span class="toolbar-note">An unbroken Guard squad Deploys into two HS at any time, with no leader and no NTC; its SW stay with the first HS (A20.5).</span>
                        @foreach (var guard in guardSquads)
                        {
                            @if (GamePlanner.RequiresSpotterSuccessor(state, guard))
                            {
                                <button class="propose-guard-deploy" data-unit="@guard" @onclick="@(() => ProposeGuardDeploy(guard, "first"))">Propose: @WordsAt(guard) Deploys, first HS keeps spotting</button>
                                <button class="propose-guard-deploy" data-unit="@guard" @onclick="@(() => ProposeGuardDeploy(guard, "second"))">Propose: @WordsAt(guard) Deploys, second HS keeps spotting</button>
                            }
                            else
                            {
                                <button class="propose-guard-deploy" data-unit="@guard" @onclick="@(() => ProposeGuardDeploy(guard))">Propose: @WordsAt(guard) Deploys</button>
                            }
                        }
                    </div>
                    </ActionSection>
                }
                @* The Play streamlining plan, S7: each RPh form only when it has a unit or weapon to offer the view. *@
                @if (state.Phase == "rph" && RallyChoices is { Count: > 0 } rallyShown)
                {
                    <ActionSection Title="Rally" Key="rally">
                    <RallyActionPanel Units="@rallyShown" Leaders="@([.. RallyLeaders.Select(leader => leader.Id)])" Unit="@rallyUnit" Leader="@rallyLeader" Barred="@RallyBarNow"
                        OnUnit="@(id => { rallyUnit = id; rallyLeader = string.Empty; })" OnLeader="@(id => rallyLeader = id)" OnPropose="@ProposeRally" />
                    </ActionSection>
                }
                @if (state.Phase == "rph" && RepairChoices is { Count: > 0 } repairShown)
                {
                    <ActionSection Title="Repair" Key="repair">
                <RepairActionPanel Weapons="@repairShown" Weapon="@repairWeapon" OnWeapon="@(id => { repairWeapon = id; repairHero = string.Empty; })"
                    Heroes="@RepairHeroes" Hero="@repairHero" OnHero="@(id => repairHero = id)" Ready="@RepairReady" OnPropose="@ProposeRepair" />
                    </ActionSection>
                }
                @if (state.Phase == "rph" && DeployChoices is var deployShown && RecombineChoices is var recombineShown && (deployShown.Count > 0 || recombineShown.Count > 0))
                {
                    <ActionSection Title="Deploy and Recombine" Key="deploy-and-recombine">
                <DeployActionPanel Squads="@deployShown" Leaders="@([.. LeadersWith(deploySquad).Select(leader => leader.Id)])" Weapons="@DeployWeapons"
                        Squad="@deploySquad" Leader="@deployLeader" Second="@deployWeapons"
                        SpotterChoiceRequired="@GamePlanner.RequiresSpotterSuccessor(state, deploySquad)" SpotterHalf="@deploySpotterHalf" OnSpotterHalf="@(value => deploySpotterHalf = value)"
                        OnSquad="@(id => { deploySquad = id; deployLeader = deploySpotterHalf = string.Empty; deployWeapons.Clear(); })" OnLeader="@(id => deployLeader = id)"
                        OnWeapon="@(pick => Toggle(deployWeapons, pick.Id, pick.On))" OnPropose="@ProposeDeploy" />
                    <RecombineActionPanel HalfSquads="@recombineShown" Partners="@([.. RecombinePartners.Select(unit => unit.Id)])"
                        Leaders="@([.. LeadersWith(recombineOne).Select(leader => leader.Id)])" One="@recombineOne" Two="@recombineTwo" Leader="@recombineLeader"
                        OnOne="@(id => { recombineOne = id; recombineTwo = string.Empty; recombineLeader = string.Empty; })" OnTwo="@(id => recombineTwo = id)"
                        OnLeader="@(id => recombineLeader = id)" OnPropose="@ProposeRecombine" />
                    </ActionSection>
                }
                @* Pass 65, task 65.9 (ruling R65.23): the phasing side's MMC scrounge a non-burning wreck or an Abandoned vehicle in their Location (D10.5). *@
                @if (state.Phase == "rph" && (Viewer.IsAdjudicator || viewAs == state.PhasingSide) && ScroungeRows is { Count: > 0 } scroungeShown)
                {
                    <VehicleScroungeActions Vehicles="@scroungeShown" Chosen="@scroungePicks" OnUnit="@(pick => scroungePicks[pick.Vehicle] = pick.Unit)"
                        OnScrounge="@(pick => ProposeScrounge(pick.Vehicle, pick.Unit))" Busy="@busy" />
                }
                @if (state.Phase == "rph")
                {
                    <DmRetentionChoices Units="@DmRetainers" Selected="@retainDm" OnToggle="@(pick => Toggle(retainDm, pick.Id, pick.On))" />
                    <ShockRecoveryAction Vehicles="@ShockChoices" Vehicle="@shockVehicle" OnVehicle="@(id => shockVehicle = id)" OnPropose="@ProposeShockRecovery" />
                }
                @* The Play streamlining plan, S7: the Movement form is the moving side's; the other view sees it only for an OVR's CC (pass 27). *@
                @* The Play streamlining plan, S8 (ruling Q15): the DEFENDER's pass for the rest of the phase, which he withdraws whenever he has the
                   screen; the moving side is told it stands. *@
                @if (state.Phase == "mph" && PhasePassNow is { } phasePass && !Viewer.IsAdjudicator)
                {
                    @if (viewAs == state.PhasingSide)
                    {
                        <p class="toolbar-note" id="phase-pass-mover">The DEFENDER passes for the rest of this phase@(phasePass.AskWhenAdjacent ? ", except where a stack comes ADJACENT to one of his Known units" : string.Empty).</p>
                    }
                    else
                    {
                        <div class="toolbar" id="phase-pass-standing">
                            <span class="toolbar-note">You pass for the rest of this phase@(phasePass.AskWhenAdjacent ? ", except where a stack comes ADJACENT to one of your units the moving side knows of" : string.Empty); Mandatory Fire still stops a stack.</span>
                            <button type="button" id="phase-pass-withdraw" @onclick="@(() => Live.Plans.WithdrawPhasePass(gameId))">Ask me again</button>
                        </div>
                    }
                }
                @if (state.Phase == "mph")
                {
                    @* The DEFENDER's own forms of the MPh (CC Reaction Fire) stay in his view; the Movement section is the moving side's (S7). *@
                    @if (Viewer.IsAdjudicator || viewAs == state.PhasingSide || OverrunCloseCombat is not null)
                    {
                    <ActionSection Title="Movement" Key="movement">
                    <RuleHelp Id="move-help" Summary="@($"The {DisplayText.Side(state.PhasingSide)} side moves one stack at a time, one Location per step; after each step the DEFENDER may fire or pass (A4.1, A8.1).")">
                        The @DisplayText.Side(state.PhasingSide) side moves one stack at a time, one Location per step (A4.1). After each step the DEFENDER may fire at the stack
                        or pass (A8.1, A8.11); the stack then moves on, whole or split, or ends its move. No other unit moves until every member of the stack has
                        ended (A4.2); a member that breaks or is pinned ends its move. A Location holding Residual FP attacks a stack as it enters (A8.22).
                    </RuleHelp>
                    @* Table player and UI review, pass 27: every view learns of the OVR's CC; the side that may act for the phasing side proposes it. *@
                    @if (OverrunCloseCombat is { } overrun)
                    {
                        <BerserkOverrunCloseCombat Location="@overrun.Location.ToString()" Attackers="@overrun.Attackers" Smc="@overrun.Smc" SmcAttacks="@overrun.SmcAttacks"
                            Ready="@MayAnswer(state.PhasingSide)" OnPropose="@ProposeOverrunCloseCombat" />
                    }
                    @if (Viewer.IsAdjudicator || viewAs == state.PhasingSide)
                    {
                        @if (EntryWaiting.Count > 0)
                        {
                            <p class="muted" id="move-entry">
                                @string.Join(", ", EntryWaiting) @(EntryWaiting.Count == 1 ? "waits" : "wait") off board to enter along the entry edge: in this MPh, or by
                                advance in the APh, which does not end while one may still enter (A2.5; ruling R25.1).@NamedEntryText
                            </p>
                        }
                        @if (ForcedBack.Count > 0)
                        {
                            <p class="muted" id="move-forced-back">
                                @string.Join(", ", ForcedBack) @(ForcedBack.Count == 1 ? "was" : "were") forced back off board by a concealed unit and @(ForcedBack.Count == 1 ? "enters" : "enter") by advance in the APh (A12.15; ruling R25.3).
                            </p>
                        }
                        @if (state.Movement is { } movement)
                        {
                            <MovementStatus Movement="@movement" />
                        }
                        @if (MoveStopped)
                        {
                            <p class="fail" id="move-stopped">
                                The move stopped: Defensive First Fire broke, pinned, or eliminated every unit of the moving stack. The DEFENDER may fire at it again or
                                pass; the pass ends this move, and then another stack may move (A4.2, A8.1).
                            </p>
                        }
                        @foreach (var (charging, target, next, undecided) in Charges)
                        {
                            @if (undecided is null)
                            {
                                var lanes = Live.Planner.ChargeLanes(state, charging);
                                <p class="fail" data-charge="@charging.Id">
                                    @WordsAt(charging.Id) is berserk and charges @(target is null ? "the nearest Known enemy unit" : PlaceOf(target.ToString())) before any other unit moves (A15.43),
                                    by a shortest route: next @(next.Count == 1 ? "step" : "steps") @string.Join(" or ", next.Select(step => lanes.TryGetValue(step, out var bypass)
                                        ? $"{PlaceOf(step.ToString())} in Bypass along {string.Join(" or ", bypass)}" : PlaceOf(step.ToString()))) (A15.431). It may not stop short while it has the MF.
                                </p>
                            }
                            else
                            {
                                <p class="muted" data-charge="@charging.Id" data-undecided="true">
                                    @ChargeUndecidedLine(charging, target, undecided)
                                </p>
                            }
                        }
                        @* The Play streamlining plan, S7 (ruling R-PS.4): while the DEFENDER's window is open the moving side has nothing to do but wait;
                           a route under way says how far it has come. *@
                        @if (MoverWaits && PlanNow is { } waitingPlan)
                        {
                            <p class="toolbar-note" id="move-route-running">The stack is moving along its route: @(waitingPlan.Next) of @waitingPlan.Route.Count steps made. The DEFENDER decides at the steps where he could fire.</p>
                        }
                        else if (MoverWaits)
                        {
                            <p class="toolbar-note" id="move-waiting">The DEFENDER fires at the stack or passes; then it moves on or ends its move.</p>
                        }
                        else
                        {
                        <div class="toolbar">
                            <InfantryMovementAction Movers="@MoveRows" Selected="@moveUnits" Draft="@MoveDraft" PushGun="@MovingGun?.Id" CarryMen="@CarryMen" Carriers="@Carriers"
                                OnToggle="@ToggleMover" OnDraftChanged="@SetMoveDraft" OnPropose="@ProposeMove" OnOverrunNtc="@ProposeOverrunNtc">
                                <Route>
                                    @* The Play streamlining plan, S3 and S6: the route plotted on the map and made step by step; a plan that waits for the
                                       DEFENDER leaves nothing to do here but hand the screen over. *@
                                    @if (PlanNow is { Paused: null } running)
                                    {
                                        <p class="toolbar-note" id="move-route-running">The stack is moving along its route: @(running.Next) of @running.Route.Count steps made. The DEFENDER decides at the steps where he could fire.</p>
                                    }
                                    else if (!Viewer.IsAdjudicator)
                                    {
                                        @if (planNote is { } lastPlan && PlanNow is null)
                                        {
                                            <p class="toolbar-note" id="move-route-last">@lastPlan</p>
                                        }
                                        <MovementRoutePanel Ready="@(moveUnits.Count > 0)" Plotting="@plotOn" Steps="@PlotSteps" Stop="@PlotStop" Note="@plotNote" CanMove="@PlotCanMove" Busy="@busy"
                                            Paused="@PlanNow?.Paused" Remaining="@(PlanNow is { } paused ? paused.Route.Count - paused.Next : 0)"
                                            OnToggle="@TogglePlot" OnUndo="@UndoPlot" OnClear="@ClearPlot" OnMove="@MoveAlongRoute" OnContinue="@PlanContinue" OnChange="@PlanChange" OnEnd="@PlanEnd" />
                                    }
                                </Route>
                            </InfantryMovementAction>
                            @* The Play streamlining plan, S7 (rulings R-PS.5, R-PS.6): the exit only from a Location on a map edge, by that edge; SMOKE and a
                               DC behind a closed line, a choice made now and then. *@
                            @if (ExitEdgesHere is { Count: > 0 } exitEdges)
                            {
                                <MapExitAction SelectId="move-exit" ButtonId="propose-exit" Edges="@exitEdges" Edge="@moveExit" Ready="@(moveUnits.Count > 0)"
