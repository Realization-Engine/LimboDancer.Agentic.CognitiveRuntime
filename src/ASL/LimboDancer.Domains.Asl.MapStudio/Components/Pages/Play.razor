    // Pass 31c (design section 14): Range. The fire panel reads its targets by range before any proposal, and the inspector's Range tab reads a
    // range for the units a view holds by name. No LOS is read here (A6.11: no LOS check before an attack is declared).
    private static string Hexes(int range) => range == 1 ? "1 hex" : string.Create(CultureInfo.InvariantCulture, $"{range} hexes");

    private int LevelAbove(BoardLocation from, BoardLocation to) => from.Board == to.Board && from.Hex == to.Hex ? to.Level - from.Level
        : MapLayers?.Board is { } board && GameMaps.FactsAt(board, from) is { } one && GameMaps.FactsAt(board, to) is { } two
            ? two.BaseLevel + to.Level - (one.BaseLevel + from.Level) : 0;

    /// <summary>
    /// A row for each unit's own FP and each weapon it fires, read from its own Location to a target (A7.21, A7.22). <paramref name="fireKinds"/>
    /// adds what the unit's fire counter allows: Subsequent First Fire within Normal Range (A8.3), FPF and a First Fire unit's Final Fire only at
    /// an ADJACENT or same-hex target (A8.31, A8.4).
    /// </summary>
    private IReadOnlyList<RangeRow> RangeRowsOf(IEnumerable<(UnitInstance Unit, BoardLocation At)> units, IReadOnlyCollection<EquipmentInstance> weapons, BoardLocation to,
        Func<UnitInstance, bool> ownFp, bool fireKinds)
    {
        var rows = new List<RangeRow>();
        if (state is null)
        {
            return rows;
        }

        var definitions = FirePreviewReference.Value.Definitions;
        foreach (var (unit, at) in units)
        {
            var same = at == to;
            if ((same ? 0 : Live.Planner.Range(state, at, to)) is not { } range)
            {
                continue;
            }

            var level = LevelAbove(at, to);
            var definition = unit.Definition is { } named ? definitions.GetValueOrDefault(named.Definition) : null;
            if (definition is not null && ownFp(unit) && !definition.IsLeader && definition.Firepower is not null
                && FireRange.Band(definition, range, same, level, GameState.Condition(unit, Conditions.Wounded) == ConditionState.True) is { } own)
            {
                var kind = !fireKinds ? null
                    : state.Phase == "dfph" && GameState.Condition(unit, Conditions.FirstFire) == ConditionState.True && range > 1
                        ? "a First Fire unit fires again only at an ADJACENT or same-hex target (A8.4)"
                    : state.Phase == "mph" && GameState.Condition(unit, Conditions.FinalFire) == ConditionState.True && range > 1
                        ? "Final Protective Fire is only at an ADJACENT or same-hex target (A8.31)"
                    : state.Phase == "mph" && GameState.Condition(unit, Conditions.FirstFire) == ConditionState.True && range > own.NormalRange
                        ? "Subsequent First Fire is within Normal Range (A8.3)"
                    : null;
                rows.Add(new RangeRow(unit.Id, Words(unit.Id), at.ToString(), own.NormalRange, own.Limit, kind ?? FireRange.Words(own), own.Band, kind is not null || own.Band is FireRangeBand.Out or FireRangeBand.SameHexFartherLevel));
            }
            else if (definition is { IsVehicle: true, AntiAircraftMg: not null } || definition is { IsVehicle: true, MainArmament: "mg" })
            {
                // D1.83: a MA AAMG's Normal Range is eight hexes; pass 60: a MA that is a plain MG reads it too.
                // C2.6 (pass 55): at another level a vehicle's MG fires only at a range of at least the elevation difference.
                var mg = FireRange.Band(range, same, 8, level);
                var elevation = same ? null : FireRange.VehicleElevationWords(range, level);
                rows.Add(new RangeRow(unit.Id, $"the {(definition.MainArmament == "mg" ? "MA MG" : "AAMG")} of {Words(unit.Id)}", at.ToString(), mg.NormalRange, mg.Limit,
                    elevation ?? (mg.Band == FireRangeBand.SameHexOtherLevel ? "no attack at another level of its hex" : FireRange.Words(mg)), mg.Band,
                    elevation is not null || mg.Band is FireRangeBand.Out or FireRangeBand.SameHexOtherLevel or FireRangeBand.SameHexFartherLevel));
            }

            foreach (var weapon in weapons.Where(item => item.Holding?.Holder == unit.Id))
            {
                if (weapon.Definition is { } weaponNamed && definitions.GetValueOrDefault(weaponNamed.Definition) is { } weaponDefinition
                    && (weaponDefinition.IsMg || weaponDefinition.IsFt || weaponDefinition.IsAtr) && FireRange.Band(weaponDefinition, range, same, level) is { } reading)
                {
                    rows.Add(new RangeRow(weapon.Id, $"{Words(weapon.Id)} of {Words(unit.Id)}", at.ToString(), reading.NormalRange, reading.Limit, FireRange.Words(reading), reading.Band,
                        reading.Band is FireRangeBand.Out or FireRangeBand.SameHexFartherLevel));
                }
            }
        }

        return rows;
    }

    /// <summary>The chosen fire group read against a target: each ticked firer's own FP unless only its MG fires, and each ticked weapon.</summary>
    private IReadOnlyList<RangeRow> FireRangeRows(BoardLocation to) => state is null ? []
        : RangeRowsOf(fireFirers.Order(StringComparer.Ordinal).Select(id => (Unit: state.Unit(id), At: state.Location(id)?.Location)).Where(item => item.Unit is not null && item.At is not null)
                .Select(item => (item.Unit!, item.At!)),
            [.. FireWeapons.Where(weapon => fireWeapons.Contains(weapon.Id))], to, unit => !fireAlone.Contains(unit.Id), fireKinds: true);

    /// <summary>What a range is for a group, in a few words: its worst band, and for whom.</summary>
    private static string RangeNote(int hexes, IReadOnlyList<RangeRow> rows)
    {
        var outs = rows.Where(row => row.Out).ToArray();
        var longs = rows.Where(row => row.Band == FireRangeBand.LongRange).ToArray();
        var pointBlank = rows.Where(row => row.Band is FireRangeBand.PointBlank or FireRangeBand.SameHexOtherLevel && !row.Out).ToArray();

        // A unit kept from a target by its own kind of fire (A8.3, A8.31, A8.4) is not out of range; the words say so.
        var barred = outs.Any(row => row.Band is not (FireRangeBand.Out or FireRangeBand.SameHexOtherLevel or FireRangeBand.SameHexFartherLevel)) ? "no fire there" : "out of range";
        var band = rows.Count == 0 ? null
            : outs.Length == rows.Count ? barred
            : outs.Length == 1 ? $"{barred} for {outs[0].Name}"
            : outs.Length > 1 ? $"{barred} for {outs.Length} of {rows.Count}"
            : longs.Length == rows.Count ? "Long Range"
            : longs.Length > 0 ? $"Long Range for {longs.Length} of {rows.Count}"
            : rows.All(row => row.Band == FireRangeBand.TriplePointBlank) ? "TPBF"
            : pointBlank.Length == rows.Count ? "PBF"
            : pointBlank.Length > 0 ? $"PBF for {pointBlank.Length} of {rows.Count}"
            : "Normal Range";
        return hexes == 0 ? band ?? "the same hex" : band is null ? Hexes(hexes) : $"{Hexes(hexes)}, {band}";
    }

    /// <summary>
    /// The fire panel's targets read by range once a firer is ticked (design section 14, R5): nearest first, each with its range and the group's
    /// worst band, and those no ticked firer or weapon reaches.
    /// </summary>
    private (IReadOnlyList<string> Targets, IReadOnlyDictionary<string, string> Notes, IReadOnlySet<string> Out) FireTargetsByRange(string side)
    {
        // The Play streamlining plan, S7: in the MPh the DEFENDER fires only at the moving stack, in its Location (A8.1), which the gate's
        // window check (ScenarioA1FireEligibility.MphWindow) refuses otherwise; so that Location is the only target offered.
        var targets = state is { Phase: "mph", Movement: { WindowOpen: true } window } ? [window.Location.ToString()] : FireTargets(side).ToArray();
        var notes = new Dictionary<string, string>(StringComparer.Ordinal);
        var beyond = new HashSet<string>(StringComparer.Ordinal);
        if (state is null || fireFirers.Count == 0 || !BoardLocation.TryParse(fireFrom, out var from))
        {
            return (targets, notes, beyond);
        }

        var ranges = new Dictionary<string, int>(StringComparer.Ordinal);
        foreach (var target in targets)
        {
            if (BoardLocation.TryParse(target, out var to) && (from == to ? 0 : Live.Planner.Range(state, from, to)) is { } hexes)
            {
                var rows = FireRangeRows(to);
                ranges[target] = hexes;
                // Pass 31d (design D6; A20.54): a Location that holds the view's own captured units says so before it is chosen.
                notes[target] = RangeNote(hexes, rows) + (VisibleUnits.Any(unit => unit.Status == InstanceStatus.Active && unit.Side == side
                    && GameState.Condition(unit, Conditions.Captured) == ConditionState.True && state.Location(unit.Id)?.Location == to) ? "; holds your captured units" : string.Empty);
                if (rows.Count > 0 && rows.All(row => row.Out))
                {
                    beyond.Add(target);
                }
            }
        }

        return ([.. targets.OrderBy(target => ranges.GetValueOrDefault(target, int.MaxValue)).ThenBy(target => target, StringComparer.Ordinal)], notes, beyond);
    }

