    /// (A12.11). A hidden unit is not offered, since the firing side does not know of it.
    /// </summary>
    private IEnumerable<string> FireTargets(string side) => SideView(side) is { } view ? FireTargets(side, view) : [];

    private static IEnumerable<string> FireTargets(string side, GameView view) =>
        // The third play test: a prisoner is no target, so its Guard's own Location is not offered for holding it (A20.54).
        view.Units.Where(unit => unit.Side != side && GameState.Condition(unit, Conditions.Captured) != ConditionState.True).Select(unit => view.Locations.TryGetValue(unit.Id, out var at) ? at.Location.ToString() : null)
            .Concat(view.Sealed.Where(item => item.Side != side).Select(item => item.Location.ToString()))
            .OfType<string>().Distinct(StringComparer.Ordinal).Order(StringComparer.Ordinal);

