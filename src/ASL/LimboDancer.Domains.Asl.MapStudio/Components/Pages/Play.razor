    /// <summary>A tank as a player reads it: its VCA and TCA, BU or CE, its fire this phase, its Acquisition, and what stops it firing.</summary>
    private string TankLabel(UnitInstance tank)
    {
        bool Marked(string condition) => GameState.Condition(tank, condition) == ConditionState.True;
        var hull = tank.Position is MapPosition { Facing: { } spine } ? UnitFacings.Name(spine) : "no facing";
        var turret = state is not null && LiveOrdnance.TurretFacing(state, tank) is { } tca ? UnitFacings.Name(tca) : "no facing";
        var shots = state?.OrdnanceShots.FirstOrDefault(item => item.Gun == tank.Id);
        var acquired = state?.Acquisitions.FirstOrDefault(item => item.Gun == tank.Id);
        var depleted = state?.DepletedAmmunition.Where(item => item.Gun == tank.Id).Select(item => item.Ammunition.ToUpperInvariant()).ToArray() ?? [];
        var flags = string.Concat(new[] { (Conditions.Shocked, "Shocked"), (Conditions.UnconfirmedKill, "Unconfirmed Kill"), (Conditions.Stunned, "Stunned"),
            (Conditions.Recalled, "Recalled"), (Conditions.Motion, "in Motion"), (Conditions.Immobilized, "immobilized"), (Conditions.Malfunctioned, "MA malfunctioned") }
            .Where(item => Marked(item.Item1)).Select(item => ", " + item.Item2));
        return $"{tank.Id} ({tank.Definition?.Definition} MA, VCA {hull}, TCA {turret}, {(LiveFire.CrewExposed(tank) ? "CE" : "BU")}"
            + (shots is null ? Marked(Conditions.PrepFire) || Marked(Conditions.FinalFire) ? ", fired this Player Turn" : ""
                : shots.RateOfFireKept ? $", {shots.Shots} shot(s), may fire again" : ", fired")
            + (acquired is null ? "" : $", Acquisition {acquired.Level} on {acquired.Location}")
            + (depleted.Length == 0 ? "" : $", out of {string.Join(", ", depleted)}") + flags + ")";
    }

