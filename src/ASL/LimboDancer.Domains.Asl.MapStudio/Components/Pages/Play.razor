    /// <summary>
    /// The destination a broken unit must reach, or that it has no legal step and so fails to rout or surrenders as the RtPh ends (A10.5, A10.51,
    /// A20.21; table player, pass 13).
    /// </summary>
    private (string Text, IReadOnlyList<RoutActionPanel.Way> Routes) RoutAdviceText(UnitInstance unit, bool must)
    {
        // Pass 31c (backlog section 48; play test P-19): one sentence that says what the unit may or must do. Pass 31d (design D3): each place the
        // rout may end is said with the hexes on a least-cost way to it, "[AA4] (by [Z5])", and the way is offered as a route to use.
        var (targets, canRout, routes) = Live.Planner.RoutAdvice(state!, unit);
        string Place(BoardLocation target) => routes.TryGetValue(target, out var route) && route.Count > 1 ? $"{target} (by {string.Join(" then ", route.Take(route.Count - 1))})" : target.ToString();

        // The table player, pass 31d: a place the unit may not end in (it lies ADJACENT to the enemy unit it began ADJACENT to, A10.51) is given no
        // route, and is not said as a place to end in while another is.
        if (targets.Any(routes.ContainsKey))
        {
            targets = [.. targets.Where(routes.ContainsKey)];
        }

        // Pass 35 (A.8, A10.51): every place within reach may lie where the rout may not end. Rules words which case it is; pass 70 (the fixes): with no
        // place that binds the rout, the ignorable ones within reach are named (A10.51 EXC; the example on p. 69, S3).
        return (ScenarioA1RoutCalculator.RoutEndAdvice(canRout, must, [.. targets.Select(Place)], targets.Any(routes.ContainsKey),
                targets.Count == 0 ? Live.Planner.RoutIgnoredCovers(state!, unit).Select(target => target.ToString()).ToArray() : null),
            [.. targets.Where(routes.ContainsKey).Select(target => new RoutActionPanel.Way(target.ToString(), string.Join(", ", routes[target])))]);
    }

