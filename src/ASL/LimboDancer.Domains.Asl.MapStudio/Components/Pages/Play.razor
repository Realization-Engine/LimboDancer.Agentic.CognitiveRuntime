    /// <summary>The rows the gate's last refusal of a setup named, by the ids the page owns; empty otherwise.</summary>
    private IReadOnlySet<string> ProblemKeys => SetupProblems is { } problems
        ? problems.SelectMany(problem => problem.Keys).ToHashSet(StringComparer.Ordinal) : new HashSet<string>();

    /// <summary>
    /// A refused setup's reasons, each with the row it names (pass 30): the page matches the ids of its own rows in the gate's text, so the gate's
    /// reasons stay plain. A SW refused only with what holds it is folded under its holder's reason. Null when no refused setup is shown.
    /// </summary>
    private IReadOnlyList<(string Text, string? Key, IReadOnlyList<string> Keys)>? SetupProblems
    {
        get
        {
            if (pending is not { } proposal || !PlacesCounters(proposal) || proposal.Result.Outcome is not (PlayOutcome.Denied or PlayOutcome.Failed))
            {
                return null;
            }

            var named = proposal.Result.Reasons.Select(reason => (Reason: reason, Rows: placements.Where(row => Mentions(reason, row.Id)).ToArray())).ToArray();
            var refused = named.SelectMany(item => item.Rows).Select(row => row.Id).ToHashSet(StringComparer.Ordinal);
            var problems = new List<(string, string?, IReadOnlyList<string>)>();
            foreach (var (reason, rows) in named)
            {
                // A held counter whose holder is refused too is said with its holder.
                if (rows is [{ Holder: { } holder } held] && held.Role != "manned" && refused.Contains(holder))
                {
                    continue;
                }

                // The rule code goes, and a Location reads as a player says it.
                var text = reason.IndexOf(": ", StringComparison.Ordinal) is var cut and > 0 && reason.StartsWith("play.", StringComparison.Ordinal) ? reason[(cut + 2)..] : reason;
                text = System.Text.RegularExpressions.Regex.Replace(text, @"\bbd\w+:[A-Z]{1,2}\d{1,2}:-?\d\b", found => PlaceOf(found.Value));
                var carried = rows.SelectMany(row => placements.Where(other => other.Holder == row.Id && other.Role != "manned" && refused.Contains(other.Id))).ToArray();
                problems.Add((rows.Length > 0
                    ? $"{PrintedLabel(rows[0])}: {text}" + (carried.Length > 0 ? $" The same holds for what it carries: {string.Join(", ", carried.Select(row => $"{PrintedLabel(row)} {row.Id}"))}." : string.Empty)
                    : text, rows.FirstOrDefault()?.Key, [.. rows.Concat(carried).Select(row => row.Key)]));
            }

            return problems;
        }
    }

    private static bool Mentions(string text, string id)
    {
        for (var at = text.IndexOf(id, StringComparison.Ordinal); at >= 0; at = text.IndexOf(id, at + 1, StringComparison.Ordinal))
        {
            bool Part(int index) => index >= 0 && index < text.Length && (char.IsLetterOrDigit(text[index]) || text[index] == '-');
            if (!Part(at - 1) && !Part(at + id.Length))
            {
                return true;
            }
        }

        return false;
    }

    /// <summary>The reasons the review lists: for a setup, the gate's count of events is left out and a refusal's reasons are shown as links instead.</summary>
    private IReadOnlyList<string> ReviewReasons(Proposal proposal) => !PlacesCounters(proposal) || setupReview is null ? Reasons(proposal)
        : SetupProblems is not null ? [] : [.. Reasons(proposal).Where(reason => !reason.StartsWith("play.setup:", StringComparison.Ordinal))];

    // The plans of the card chosen for a new game, counted once per card text.
    private (string? Card, string? Sha256, int Count, int Others) chosenPlans;

    private int ChosenPlanCount
    {
        get
        {
            if (scenarioCard is null || PublishedCatalog is not { } catalog)
            {
                return 0;
            }

            if (chosenPlans.Card != scenarioCard || chosenPlans.Sha256 != scenarioSha)
            {
