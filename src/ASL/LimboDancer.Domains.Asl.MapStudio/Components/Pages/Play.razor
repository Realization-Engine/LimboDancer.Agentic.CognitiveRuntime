    /// <summary>Choosing an attacker preselects the best leader to direct the attack, when none is chosen (A11.141).</summary>
    private void ToggleAttacker(string id, bool on)
    {
        Toggle(ccAttackers, id, on);
        if (!CloseCombatDirectors.Any(unit => unit.Id == ccDirector))
        {
            ccDirector = string.Empty;
        }

        if (ccDirector.Length == 0 && ccAttackers.Count > 1 && CloseCombatDirectors
            .OrderBy(unit => unit.Definition is { } definition && CloseCombatDefinitions.TryGetValue(definition.Definition, out var fire) ? fire.Leadership ?? 0 : 0)
            .FirstOrDefault() is { } best)
        {
            ccDirector = best.Id;
        }
    }

