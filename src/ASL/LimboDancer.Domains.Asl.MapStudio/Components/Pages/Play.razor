    /// <summary>A route typed as hexes, each on the routing unit's board (A10.5).</summary>
    private string[] RouteLocations(string text) => state?.Location(routUnit)?.Location is { } at
        ? [.. text.Replace(',', ' ').Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Select(hex => hex.Contains(':', StringComparison.Ordinal) ? hex : $"{at.Board}:{hex}:0")]
        : [];

    /// <summary>
    /// Every unit of a hex routs in turn along one route (the user, 2026-10-21): each rout is its own, one at a time (A10.5), proposed and confirmed
    /// as the player would, each with its own Interdiction. The first one refused opens its review; a unit that carries more than it may rout with
    /// and has a choice of what it keeps is chosen in the form, its route filled, for the player to choose; either stops the rest.
    /// </summary>
    private async Task ProposeRoutGroup((IReadOnlyList<string> Units, string Route) group)
    {
        if (busy || state is null || history is null)
        {
            return;
        }

        var routed = 0;
        foreach (var unitId in group.Units)
        {
            if (state?.Unit(unitId) is not { } unit || history is null)
            {
                break;
            }

            if (Live.Planner.RoutLoadOf(state, unit) is { Laden: true } load && load.Choices.Count > 1)
            {
                (routUnit, routRoute, routKeep, routLowCrawl) = (unitId, group.Route, string.Empty, false);
                status = $"{(routed > 0 ? $"{routed} routed. " : string.Empty)}{UnitAt(unitId)} carries more than it may rout with: choose what it keeps, then propose its rout.";
                Refresh();
                return;
            }

            // The route's hexes are read on the routing unit's board.
            routUnit = unitId;
            var arguments = FromView(JsonSerializer.SerializeToElement(new
            {
                gameId, attemptId = Attempt("rout"), expectedRevision = (long)history.Events.Count, unitId, route = RouteLocations(group.Route), lowCrawl = false,
                keep = Live.Planner.RoutLoadOf(state, unit) is { Laden: true } only ? only.Choices[0] : null,
            }));
            busy = true;
            PlayResult result;
            try
            {
                var proposed = await Run(() => Live.Play.ProposeAsync(GameActions.Rout, arguments, Live.Principal));
                result = proposed.Outcome == PlayOutcome.NeedsConfirmation
                    ? await Run(() => Live.Play.ConfirmAsync(GameActions.Rout, arguments, Live.Principal, proposed.Correlation)) : proposed;
            }
            finally
            {
                busy = false;
            }

            Refresh();
            if (result.Outcome is not (PlayOutcome.Committed or PlayOutcome.Replay))
            {
                (routUnit, routRoute) = (unitId, group.Route);
                await Propose(GameActions.Rout, JsonSerializer.SerializeToElement(new
                {
                    gameId, attemptId = Attempt("rout"), expectedRevision = (long)history!.Events.Count, unitId, route = RouteLocations(group.Route), lowCrawl = false,
                }));
                return;
            }

            routed++;
        }

        var end = RouteLocations(group.Route).LastOrDefault();
        (routUnit, routRoute) = (string.Empty, string.Empty);
        status = $"{routed} {(routed == 1 ? "unit routs" : "units rout")}{(end is null ? string.Empty : $" along the route to {PlaceOf(end)}")}.";
        Refresh();
    }

