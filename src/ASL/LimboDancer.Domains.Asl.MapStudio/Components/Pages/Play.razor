    {
        var arguments = new Dictionary<string, object>
        {
            ["gameId"] = gameId,
            ["attemptId"] = Attempt("fire"),
            ["expectedRevision"] = (long)history!.Events.Count,
            ["firers"] = fireFirers.Order(StringComparer.Ordinal).ToArray(),
            ["target"] = FireTarget.Trim(),
        };
        if (fireSnapShot)
        {
            arguments["snapShot"] = true;
        }

        // A9.5, A9.22, A9.12 (backlog pass 12): Spraying Fire's second Location, a Fire Lane, and a leader's partner.
        if (fireSpray.Trim() is { Length: > 0 } sprayed)
        {
            arguments["sprayTarget"] = sprayed;
        }

        if (fireLaneWeapon.Length > 0 && fireWeapons.Contains(fireLaneWeapon) && fireLaneTo.Trim() is { Length: > 0 } laneTo)
        {
            arguments["fireLane"] = new Dictionary<string, string> { ["weapon"] = fireLaneWeapon, ["to"] = laneTo };
        }

        if (firePartner.Trim() is { Length: > 0 } partner && fireFirers.FirstOrDefault(id => state?.Unit(id)?.Kind == "asl:leader") is { } leaderFirer)
        {
            arguments["partners"] = new Dictionary<string, string> { [leaderFirer] = partner };
        }

        if (fireDirector.Length > 0)
        {
            arguments["director"] = fireDirector;
        }

        // A9.2: the MGs each firer uses, and the firers whose MGs fire without their inherent FP.
        var weapons = FireWeapons.Where(item => fireWeapons.Contains(item.Id) && LiveFire.WeaponBar(item) is null).GroupBy(item => item.Holding!.Holder)
            .ToDictionary(group => group.Key, group => group.Select(item => item.Id).ToArray(), StringComparer.Ordinal);
        // D3.5 (pass 50): the BMG and CMG each ticked tank fires.
        foreach (var group in FireVehicleMgs.Where(weapon => weapon.Bar is null && fireWeapons.Contains(weapon.Id)).GroupBy(weapon => weapon.Holder))
        {
            weapons[group.Key] = [.. group.Select(weapon => VehicleMgName(weapon.Id))];
        }

        if (weapons.Count > 0)
        {
            arguments["weapons"] = weapons;

            // A22.31 (ruling R15.1): a FT fires without its squad's inherent FP.
            var flamethrowers = FireWeapons.Where(item => fireWeapons.Contains(item.Id) && item.Kind == "asl:ft").Select(item => item.Holding!.Holder);
            if (fireAlone.Where(weapons.ContainsKey).Concat(flamethrowers).Distinct(StringComparer.Ordinal).Order(StringComparer.Ordinal).ToArray() is { Length: > 0 } alone)
            {
                arguments["withoutInherent"] = alone;
            }
        }

        // A22.611 (ruling R15.4): the firer making the MOL Check.
        if (fireMol.Length > 0 && fireFirers.Contains(fireMol))
        {
            arguments["mol"] = fireMol;
        }

        // A22.34, A22.612 (pass 60, ruling R60.15): the AFV a FT or MOL names, while the panel still offers it.
        if (fireVehicle.Length > 0 && state is not null && FiringSide is { } side
            && (fireMol.Length > 0 || FireWeapons.Any(weapon => weapon.Kind == "asl:ft" && fireWeapons.Contains(weapon.Id)))
            && NamedVehicleChoices(side, FireTarget).Any(choice => choice.Id == fireVehicle))
        {
            arguments["vehicle"] = fireVehicle;
        }

        return Propose(GameActions.Fire, JsonSerializer.SerializeToElement(arguments));
    }



