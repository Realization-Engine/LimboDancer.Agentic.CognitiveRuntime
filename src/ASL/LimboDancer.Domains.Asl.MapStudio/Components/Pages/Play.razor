    /// <summary>The side whose own fire phase it is, which may massacre (A20.4): the phasing side in the PFPh and AFPh, the other in the DFPh.</summary>
    private string? MassacringSide => state is null ? null
        : state.Phase is "pfph" or "afph" ? state.PhasingSide
        : state.Phase == "dfph" ? state.Sides.FirstOrDefault(side => side.Id != state.PhasingSide)?.Id : null;

    /// <summary>An option of a pending choice in words: take or decline, or the Location that keeps an Acquisition.</summary>
    private static string ChoiceOptionText(PendingChoice choice, string option) => (choice.Kind, option) switch
    {
        (_, ChoicePending.Take) => "take it",
        (_, ChoicePending.Decline) => "decline it",
        (ChoicePending.Acquisition, _) => $"keep it on {option}",
        (ChoicePending.Paatc, ChoicePending.Reveal) => "reveal them",
        (ChoicePending.Paatc, _) => "take one combined PAATC",
        _ => option,
    };

    /// <summary>Whether the view may answer for a side: that side's view or the adjudicator (ruling R23.1).</summary>
    private bool MayAnswer(string? side) => Viewer.IsAdjudicator || viewAs == side;

    /// <summary>A pending choice's options in words (plan C08), given only to a view that may answer.</summary>
    private IReadOnlyList<PendingChoicePanel.Option> ChoiceOptions(PendingChoice choice) => MayAnswer(choice.Side)
        ? [.. choice.Options.Select(option => new PendingChoicePanel.Option(option, ChoiceOptionText(choice, option)))]
        : [];

    /// <summary>
    /// The firing side's units that may offer a Massacre (A20.4): Russian or berserk personnel not in Melee sharing a Location with an enemy
    /// prisoner. The planner decides the rest.
    /// </summary>
    private IEnumerable<(UnitInstance Unit, UnitInstance Prisoner)> Massacres(string side) => state is null ? []
        : from unit in state.Units
          where unit.Status == InstanceStatus.Active && unit.Side == side && Library.Vocabulary.IsA(unit.Kind, "asl:personnel")
              && GameState.Condition(unit, Conditions.Captured) != ConditionState.True && GameState.Condition(unit, Conditions.Melee) != ConditionState.True
              && (GameState.Condition(unit, Conditions.Berserk) == ConditionState.True || (unit.Definition is { } reference && Definitions.FirstOrDefault(definition => definition.Id == reference.Definition)?.Nationality == "russian"))
          let at = state.Location(unit.Id)?.Location
          where at is not null
          from prisoner in state.At(at).OfType<UnitInstance>()
          where prisoner.Status == InstanceStatus.Active && prisoner.Side != side && GameState.Condition(prisoner, Conditions.Captured) == ConditionState.True
          orderby unit.Id, prisoner.Id
          select (unit, prisoner);

    /// <summary>
    /// The CC and Ambush records the viewer may see, latest first, in words: each attack's FP, odds, Kill Number, DR with its DRM,
    /// and each defender's result (A11.11), the leaders an Original 2 created (A18.12), and the SW lost (A11.13).
    /// </summary>
    private IReadOnlyList<(string EventId, string Text)> CloseCombatRecords
    {
        get
        {
            if (history is null)
            {
                return [];
            }

            var records = new List<(string, string)>();

            // A15.41 (ruling R27.3): the TCs a berserk leader's companions took when it went berserk, by leader, from the fire and Rally records the viewer
            // may see; a CC round names them for each berserk leader in it, since the CC itself has no Heat of Battle.
            var dice = new Dictionary<string, IReadOnlyList<int>>(StringComparer.Ordinal);
            var companionChecks = new Dictionary<string, string>(StringComparer.Ordinal);
            foreach (var item in history.Events.Where(item => item.IsVisibleTo(Viewer)))
            {
                if (item.Payload is DiceRolled rolledDice)
                {
                    dice[rolledDice.Roll] = rolledDice.Values;
                }

                // Fire (UI and table player review, pass 27): each Berserk TC names its leader in its DRM, on an attacked unit and a companion alike.
                if (item.Payload is FireResolved fire && fire.Rolls.Keys.Any(key => key.StartsWith(BerserkCheckKey, StringComparison.Ordinal))
                    && fire.Resolution.Deserialize<FireResolution>(LiveFire.Json) is { } fired)
                {
                    var byLeader = fired.Effects.Concat(fired.CompanionEffects ?? [])
                        .SelectMany(effect => effect.Checks.Where(check => check.Kind == "Berserk TC").Select(check => (effect.UnitId, Check: check)))
                        .GroupBy(entry => entry.Check.Drm.Select(drm => drm.Name).FirstOrDefault(name => name.StartsWith(BerserkLeaderDrm, StringComparison.Ordinal))?[BerserkLeaderDrm.Length..]);
                    foreach (var group in byLeader.Where(group => group.Key is not null))
                    {
                        companionChecks[group.Key!] = CompanionText(group.Key!, group.Select(entry => (entry.UnitId, entry.Check.Dice, entry.Check.Passed)));
                    }
                }
                else if (item.Payload is RallyAttempted rally && rally.Rolls.Keys.Any(key => key.StartsWith(BerserkCheckKey, StringComparison.Ordinal))
                    && rally.Resolution.Deserialize<RallyResolution>(LiveFire.Json)?.Effect is { Berserk: true } effect)
                {
                    companionChecks[rally.Unit] = CompanionText(rally.Unit, rally.Rolls.Where(roll => roll.Key.StartsWith(BerserkCheckKey, StringComparison.Ordinal))
                        .OrderBy(roll => roll.Key, StringComparer.Ordinal).Select(roll => (roll.Key[BerserkCheckKey.Length..], dice.GetValueOrDefault(roll.Value) ?? [],
                            (effect.BerserkCompanions ?? []).Contains(roll.Key[BerserkCheckKey.Length..]))));
                }

                if (item.Payload is AmbushRolled ambush && ambush.Resolution.Deserialize<AmbushResolution>(LiveFire.Json) is { } rolled)
                {
                    var sides = string.Join("; ", rolled.Sides.Select(side => $"{side.Side} dr {side.Dr}{ModifierText(side.Drm)} = {side.FinalDr}"));
                    records.Add((item.EventId, $"Ambush in {ambush.Location}: {sides}: {(rolled.Ambusher is { } side ? $"the {side} side ambushes" : "no Ambush")} (A11.4)"));
                }
                else if (item.Payload is CloseCombatResolved combat && combat.Resolution.Deserialize<CloseCombatResolution>(LiveFire.Json) is { } resolution)
                {
                    var attacks = resolution.Attacks.Select(attack =>
                    {
                        // Each defender's own DRM follow the attack's modified DR, then its Final DR (A11.11).
                        var defenders = string.Join(", ", attack.Defending.Select(defender =>
                            $"{defender.UnitId}: {Number(defender.FinalDr - defender.Drm.Sum(item => item.Value))}{ModifierText(defender.Drm)} = Final DR {defender.FinalDr}: {DefenderText(defender)}"));
                        var firepower = attack.FirepowerModifiers.Count == 0 ? "" : $" [{string.Join(", ", attack.FirepowerModifiers.Select(item => $"{item.Name} x{Number(item.Value)}, {item.Rule}"))}]";
                        var creation = attack.LeaderCreation is { } created
                            ? $"; Leader Creation dr {created.Dr}{ModifierText(created.Drm)} = {created.FinalDr}: {(created.LeaderDefinitionId is { } leader ? $"creates {leader}" : "no leader")} (A18.12)"
                            : "";
                        var dice = string.Join(", ", attack.Dice.Select((die, index) => index == 0 ? $"{die} (colored)" : $"{die}"));
                        return $"{string.Join(", ", attack.Attackers)} ({Number(attack.AttackFirepower)} FP{firepower}) attack {string.Join(", ", attack.Defenders)} ({Number(attack.DefenseFirepower)} FP) "
                            + $"at {attack.Odds}, Kill Number {attack.KillNumber}: DR {dice} = {attack.OriginalDr}{ModifierText(attack.Drm)}; {defenders}{creation}";
                    });
                    var lost = resolution.WeaponEffects.Where(weapon => weapon.Eliminated).Select(weapon => $"{weapon.EquipmentId} lost (dr {weapon.Dr}, A11.13)");
                    var ended = resolution.Effects.Where(effect => effect.BerserkEnded == true).Select(effect => $"{effect.UnitId} is no longer berserk (A15.46)");
                    var withdrew = resolution.Effects.Where(effect => effect.WithdrewTo is not null).Select(effect => $"{effect.UnitId} withdraws to {effect.WithdrewTo} (A11.2)")
                        .Concat(resolution.Effects.Where(effect => effect.InfiltratedTo is not null).Select(effect => $"{effect.UnitId} infiltrates to {effect.InfiltratedTo} (A11.22)"))
                        .Concat(resolution.Effects.Where(effect => effect.Captured == true).Select(effect => effect.GuardId is { } guard
                            ? $"{effect.UnitId}{(effect.CapturedHalf == true ? " gives up one HS, which" : "")} is captured and guarded by {guard} (A20.22)"
                            : $"{effect.UnitId} is captured but no one can guard it, so it is freed as Unarmed (A20.5)"))
                        .Concat((resolution.EscapeChecks ?? []).Select(check => $"{check.UnitId}'s escape NTC {string.Join("+", check.Dice)} against {check.Morale}: {(check.Passed ? "passed" : "failed")} (A20.55)"))
                        .Concat(resolution.Effects.Where(effect => effect.Escaped == true).Select(effect => $"{effect.UnitId} is no longer guarded (A20.55)"))
                        .Concat(resolution.Effects.Where(effect => effect.RearmedAs is not null).Select(effect => $"{effect.UnitId} is rearmed as {effect.RearmedAs} (A20.551)"))
                        .Concat(resolution.Effects.Where(effect => effect.ConcealmentLost == true).Select(effect => $"{effect.UnitId} loses its concealment (A11.19)"));
                    var left = UnpossessedAfter(item, resolution).Select(weapon => $"{weapon} is left unpossessed in {combat.Location} (A11.13)");
                    var text = resolution.Attacks.Count == 0 ? "no attacks" : string.Join(" | ", attacks);
                    var hand = combat.Facts.TryGetProperty("handToHand", out var handToHand) && handToHand.ValueKind == JsonValueKind.True ? ", Hand-to-Hand (red Kill Numbers)" : "";
                    // Shown with the first CC record after the leader went berserk (UI review, pass 27).
                    var companions = combat.Attackers.Concat(combat.Defenders).Distinct(StringComparer.Ordinal)
                        .Select(unit => companionChecks.Remove(unit, out var checks) ? checks : null).OfType<string>().ToArray();
                    records.Add((item.EventId, $"CC in {combat.Location}, {combat.Round} round{hand}: {string.Join("; ", new[] { text }.Concat(lost).Concat(ended).Concat(withdrew).Concat(left).Concat(companions))}"));
                }
            }

            records.Reverse();
            return records;
        }
    }

    /// <summary>The roll key of a berserk leader's companion's TC in fire and Rally records (A15.41).</summary>
    private const string BerserkCheckKey = "berserkCheck:";

    /// <summary>The DRM a Berserk TC in a fire record takes from its leader, which names him (A15.41).</summary>
    private const string BerserkLeaderDrm = "berserk-leader:";

    /// <summary>A berserk leader's companions' TCs in words (A15.41; ruling R27.3).</summary>
    private static string CompanionText(string leader, IEnumerable<(string Unit, IReadOnlyList<int> Dice, bool Berserk)> checks) =>
        $"{leader} went berserk before this CC; its companions' TCs then: {string.Join(", ", checks.Select(check => $"{check.Unit} {string.Join("+", check.Dice)}: {(check.Berserk ? "goes berserk with it" : "stays")}"))} (A15.41)";

    /// <summary>The SW the units a CC round eliminated possessed before it, less those it eliminated: they stay in the Location unpossessed.</summary>
    private IEnumerable<string> UnpossessedAfter(GameEvent combat, CloseCombatResolution resolution)
    {
        var eliminated = resolution.Effects.Where(effect => effect.Eliminated).Select(effect => effect.UnitId).ToHashSet(StringComparer.Ordinal);
        if (eliminated.Count == 0 || history is null)
        {
            return [];
        }

        var before = Live.Planner.Replay([.. history.Events.TakeWhile(item => item.EventId != combat.EventId)]).Current;
        var lost = resolution.WeaponEffects.Where(weapon => weapon.Eliminated).Select(weapon => weapon.EquipmentId).ToHashSet(StringComparer.Ordinal);
        return before is null ? []
            : before.Equipment.Where(weapon => weapon.Status == InstanceStatus.Active && weapon.Holding is { Role: HoldingRole.Possessed } holding
                && eliminated.Contains(holding.Holder) && !lost.Contains(weapon.Id)).Select(weapon => weapon.Id).Order(StringComparer.Ordinal);
    }

    private static string DefenderText(CloseCombatDefenderResult defender) => defender.Result switch
    {
        CloseCombatDefenderResult.Eliminated => "eliminated",
        CloseCombatDefenderResult.Captured => "captured",
        CloseCombatDefenderResult.PartialKill => defender.CasualtyReduced == true
            ? "Casualty Reduction" + (defender.RandomSelectionDr is { } dr ? $" (Random Selection dr {dr})" : "")
            : $"spared (Random Selection dr {defender.RandomSelectionDr})",
        _ => "no effect",
    };

    /// <summary>The perspective the page shows: a side, or the adjudicator, who sees everything (D3).</summary>
    private Perspective Viewer => state?.Perspectives.FirstOrDefault(perspective => perspective.Name == viewAs) ?? Perspective.Adjudicator;

    // The view the page shows, read once per history and viewer: every panel reads it, and a side's view asks the card setup who is setting up now.
    private (GameHistory? History, long Revision, string Viewer, GameView? View) viewCache;

    private GameView? View
    {
        get
        {
            if (state is null || history?.Current is null)
            {
                return null;
            }

            if (viewCache.View is null || !ReferenceEquals(viewCache.History, history) || viewCache.Revision != state.Revision || viewCache.Viewer != Viewer.Name)
            {
                viewCache = (history, state.Revision, Viewer.Name, GameView.Of(history, state.Revision, Viewer, Unseen));
            }

            return viewCache.View;
        }
    }

    /// <summary>The side the Victory standing is read for (ruling R23.4): the viewer's side until the game ends; none for the adjudicator.</summary>
    private string? VictoryKnownTo => Viewer.IsAdjudicator || state?.Ended is not null ? null : Viewer.Name;

    /// <summary>The equipment the viewer may see: all of it for the adjudicator; for a side, none held by a unit it may not see (ruling R23.1).</summary>
    private IEnumerable<EquipmentInstance> VisibleEquipment => Viewer.IsAdjudicator ? state?.Equipment ?? [] : View?.Equipment ?? [];

    // The setup, the sides out of sight, and the Victory standing, read once per history, revision, and viewer (UI review, pass 23).
    private sealed record Reads(GameHistory? History, long Revision, string Viewer, SetupReport? Setup, IReadOnlySet<string> Unseen, VictoryReport? Victory);

    private Reads? reads;

    private Reads ReadsNow
    {
        get
        {
            if (reads is null || !ReferenceEquals(reads.History, history) || reads.Revision != (state?.Revision ?? -1) || reads.Viewer != Viewer.Name)
            {
                reads = state is null ? new Reads(history, -1, Viewer.Name, null, new HashSet<string>(), null)
                    : new Reads(history, state.Revision, Viewer.Name, Live.Planner.CardSetup(state, new HashSet<string>()), Live.Planner.OutOfSight(state, Viewer),
                        history is null ? null : Live.Planner.Victory(history, knownTo: VictoryKnownTo));
            }

            return reads;
        }
    }

    /// <summary>The OB groups setting up out of the viewer's sight now (ruling R23.3).</summary>
    private IReadOnlySet<string> Unseen => ReadsNow.Unseen;

    private VictoryReport? VictoryNow => ReadsNow.Victory;

    // Ruling R23.2: the view a hand-over waits to show; null when none waits.
    private string? handOver;

    private IReadOnlyList<PerspectivePicker.Choice> ViewChoices => state is null ? []
        : [.. state.Perspectives.Select(perspective => new PerspectivePicker.Choice(perspective.Name, perspective.IsAdjudicator ? "the adjudicator" : perspective.Name))];

    private static string ViewLabel(string? name) => name is null ? string.Empty : name == Perspective.AdjudicatorName ? "the adjudicator" : $"the {name} side";

    /// <summary>
    /// A new view waits behind the hand-over screen (ruling R23.2); what the last one prepared is dropped, since it may rest on what the next may not
    /// see (plan section 13.4). Choosing the shown view again drops the hand-over.
    /// </summary>
    private void ChangeView(string next)
    {
        // Pass 29: the view does not change while the gate works, so a result lands with the view that asked for it.
        if (busy || next == (handOver ?? viewAs))
        {
            return;
        }

        handOver = next == viewAs ? null : next;
        ResetForView();
    }

    /// <summary>Everything the last view prepared: the proposal, the drafts of setup and of every action, and the LOS line.</summary>
    private void ResetForView()
    {
        pending = null;
        status = string.Empty;
        highlight = null;
        inspectorTab = "selection";
        placements.Clear();
        placeHidden = false;
        placeConcealed = false;
        placeHolder = string.Empty;
        placeEntry = string.Empty;
        nonObChosen.Clear();
        retainDm.Clear();
        moveUnits.Clear();
        ResetDrafts(keepCloseCombat: true);
    }

    private void ConfirmView()
    {
        if (handOver is { } next)
        {
            viewAs = next;
            handOver = null;
            ResetForView();
            enterUnit = VisibleUnits.FirstOrDefault()?.Id ?? string.Empty;
            focusActions = true;
            paneTab = "actions";
        }
    }


    /// <summary>What "View on" opens: the saved map the game copied, or its first board.</summary>
    private string ViewTarget => state is null ? string.Empty
        : state.Map.IsPlaced && state.Map.Reference.StartsWith("map-", StringComparison.Ordinal) ? state.Map.Reference : state.Map.Boards[0].Board.Value;

    /// <summary>A prisoner's Guard, and a Guard's prisoners (A20.5), as the units table shows them.</summary>
    private IEnumerable<string> Custody(UnitInstance unit)
    {
        if (unit.Custodian is { } guard)
        {
            yield return $"guarded by {guard}";
        }

        if (state?.Units.Where(item => item.Status == InstanceStatus.Active && item.Custodian == unit.Id).Select(item => item.Id).Order(StringComparer.Ordinal).ToArray() is { Length: > 0 } prisoners)
        {
            yield return $"guards {string.Join(", ", prisoners)}";
        }
    }

    // A side's view with no replayed state shows nothing rather than the whole game (UI review, pass 23).
    /// <summary>The units of a list the view may see: every action's picker passes through it (ruling R23.1; Studio demo, pass 23).</summary>
    private IEnumerable<UnitInstance> SeenOnly(IEnumerable<UnitInstance> units)
    {
        // Ruling R26.2: a Passenger acts only with its vehicle, so no action list offers it.
        units = units.Where(unit => state?.Aboard(unit.Id) is null);
        if (Viewer.IsAdjudicator)
        {
            return units;
        }

        var seen = VisibleUnits.Select(unit => unit.Id).ToHashSet(StringComparer.Ordinal);
        return units.Where(unit => seen.Contains(unit.Id));
    }

    private IEnumerable<UnitInstance> VisibleUnits => Viewer.IsAdjudicator ? state?.Units ?? [] : View?.Units ?? [];

    /// <summary>
    /// The rolls the viewer may see, latest first, with the unit each die belongs to when the viewer may see that too:
    /// the adjudicator, or the side whose units were selected (Random Selection and Declined OVR Design, section 7).
    /// </summary>
    private IReadOnlyList<(DiceRolled Roll, IReadOnlyList<string>? Subjects)> Rolls => history is null
        ? []
        : [.. history.Events.Where(item => item.IsVisibleTo(Viewer)).Select(item => item.Payload).OfType<DiceRolled>().Reverse().Take(6)
            .Select(roll => (roll, history.Events.Where(item => item.IsVisibleTo(Viewer)).Select(item => item.Payload).OfType<RandomSelection>()
                .FirstOrDefault(selection => selection.Roll == roll.Roll)?.Subjects))];

    /// <summary>
    /// A roll with its purpose; an NTC also shows its arithmetic from the task check that used it (Infantry OVR Design,
    /// section 7), for example "OVR NTC: 3, 5 + 3 (TEM) = 11 against morale 7: failed".
    /// </summary>
    private string RollText(DiceRolled roll)
    {
        var check = history?.Events.Select(item => item.Payload).OfType<TaskCheck>().FirstOrDefault(item => item.Roll == roll.Roll);
        if (check is null)
        {
            return $"{roll.Purpose}: {string.Join(", ", roll.Values)}";
        }

        var modifiers = string.Concat(check.Modifiers.Select(item => $" {(item.Value < 0 ? "-" : "+")} {Math.Abs(item.Value)} ({(item.Source == "B23.3" ? "TEM" : item.Source)})"));
        return $"{(check.Purpose == TaskCheck.OvrNtc ? "OVR NTC" : check.Purpose)}: {string.Join(", ", roll.Values)}{modifiers} = {check.FinalDr} "
            + $"against morale {check.MoraleLevel}: {(check.Passed ? "passed" : "failed")}";
    }

    private IEnumerable<SealedPresence> SealedPresences => Viewer.IsAdjudicator || View is null ? [] : View.Sealed;

    /// <summary>
    /// Whether the proposal's outcome is withheld from the current viewer: an entry the moving side cannot see into, viewed
    /// by anyone but the adjudicator (Occupied and Concealed Entry Design, section 7).
    /// </summary>
    private bool Withheld(Proposal proposal) => !Viewer.IsAdjudicator && proposal.Result.Plan?.Disclosure is { Withheld: true };

    private IReadOnlyList<string> Reasons(Proposal proposal) =>
        proposal.Action == GameActions.PassFire && !Viewer.IsAdjudicator && viewAs != state?.PhasingSide && proposal.Result.Outcome is not (PlayOutcome.Denied or PlayOutcome.Failed)
            ? ["play.pass: the DEFENDER passes on the moving stack; it moves on, or ends its move (A8.1, A8.11)."]
        : !Viewer.IsAdjudicator && proposal.Result.Plan is { Disclosure: { } disclosure } plan
            ? disclosure.ReasonsForMover(plan, confirmed: proposal.Result.Outcome != PlayOutcome.NeedsConfirmation)
            : proposal.Result.Plan?.Fire is { } fire ? fire.ReasonsFor(proposal.Result.Reasons, Viewer) : proposal.Result.Reasons;

    /// <summary>
    /// The side that may fire now: the phasing side in its PFPh and AFPh, the other side in the MPh and DFPh (A3.2, A3.3,
    /// A3.4, A3.5); none otherwise.
    /// </summary>
    private string ordnanceGun = string.Empty;
    private string ordnanceTarget = string.Empty;
    private string ordnanceVehicle = string.Empty;
    private string ordnanceAmmunition = "ap";
    private string shockVehicle = string.Empty;

    /// <summary>The firing side's tanks, whose MA fires as a Gun (D1.3; ruling R7.10).</summary>
    private IEnumerable<UnitInstance> OrdnanceTanks(string side) => state is null ? []
        : state.Units.Where(unit => unit.Status == InstanceStatus.Active && unit.Side == side && LiveOrdnance.IsTank(unit)).OrderBy(unit => unit.Id, StringComparer.Ordinal);

    /// <summary>The enemy vehicles in the chosen target Location, each a Vehicle Target Type target (C3.31).</summary>
    private IEnumerable<UnitInstance> OrdnanceVehicleTargets(string side) => state is null || !BoardLocation.TryParse(ordnanceTarget, out var at) ? []
        : state.At(at).OfType<UnitInstance>().Where(unit => unit.Status == InstanceStatus.Active && unit.Side != side && LiveFire.IsVehicle(unit))
            .OrderBy(unit => unit.Id, StringComparer.Ordinal);

    /// <summary>The ammunition the chosen Gun or tank may carry (C8.1); the scenario year and depletion decide the shot.</summary>
    private IReadOnlyList<string> OrdnanceAmmunitions => state?.Find(ordnanceGun) switch
    {
        UnitInstance { Definition: { } tank } => LiveOrdnance.Ammunitions(tank.Definition),
        EquipmentInstance { Definition: { } gun } => LiveOrdnance.Ammunitions(gun.Definition),
