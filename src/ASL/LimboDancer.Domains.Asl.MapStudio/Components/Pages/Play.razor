    /// <summary>The context line: the revision, turn, phase, and phasing side, and whether setup is open; null with no game shown.</summary>
    private string? ContextSummary => state is null || history is null ? null
        : (history.Current is not null ? string.Empty : "The game does not replay: ") + $"Turn {state.Turn}, {state.PhasingSide} {Games.PhaseLabel(state.Phase)}."
            + (SetupOpen ? " Setup is open." : state.Ended is not null ? " The game has ended; nothing more is played." : string.Empty);

    /// <summary>
    /// The side whose answer or turn the game waits for, when it is not the shown view (backlog section 37): a choice's side, a surrender's captors,
    /// the DEFENDER after a step or in the DFPh, otherwise the phasing side. Null for the adjudicator, in setup, after the end, or during a hand-over.
    /// </summary>
    private string? AwaitingView
    {
        get
        {
            if (state is null || history?.Current is null || state.Ended is not null || SetupOpen || Viewer.IsAdjudicator || handOver is not null)
            {
                return null;
            }

            var waiting = Awaiting(state).Side;
            return waiting is { Length: > 0 } && waiting != viewAs && state.Perspectives.Any(perspective => perspective.Name == waiting) ? waiting : null;
        }
    }

    private string AwaitingNote => state is null ? string.Empty : Awaiting(state).Note;

    /// <summary>What the shown view does now, when the game waits on no other view (table player, pass 28c); null otherwise.</summary>
    private string? ActingNote => state is null || history?.Current is null || state.Ended is not null || SetupOpen || Viewer.IsAdjudicator || handOver is not null
        || AwaitingView is not null ? null : $"You act: {Awaiting(state).Note}";

    /// <summary>Where the moving stack is, which the DEFENDER sees as units or a "?" (A8.1); null when no stack moves.</summary>
    private BoardLocation? MovingAt => state?.Movement is { Members: [var first, ..] } ? state.Location(first)?.Location : null;

    private (string? Side, string Note) Awaiting(GameState shown)
    {
        var defender = shown.Sides.FirstOrDefault(side => side.Id != shown.PhasingSide)?.Id;
        if (shown.Choice is { } choice)
        {
            return (choice.Side, $"The {choice.Side} side has a choice to make before play goes on.");
        }

        if (shown.PendingSurrenders.FirstOrDefault() is { } surrender
            && surrender.Captors.Select(shown.Unit).OfType<UnitInstance>().Select(unit => unit.Side).FirstOrDefault() is { } captors)
        {
            return (captors, $"The {captors} side answers a surrender (A20.21).");
        }

        if (shown.Phase == "mph" && shown.Movement is { WindowOpen: true })
        {
            return (defender, "The DEFENDER may fire at the moving stack or pass (A8.1).");
        }

        if (shown.Phase == "dfph")
        {
            return (defender, $"The {defender} side may fire, then ends the {Games.PhaseLabel(shown.Phase)}.");
        }

        if (shown.Phase is "rph" or "rtph" or "ccph")
        {
            var other = viewAs == shown.PhasingSide ? defender : shown.PhasingSide;
            return (other, $"Both sides act in the {Games.PhaseLabel(shown.Phase)}, the {shown.PhasingSide} side first.");
        }

        return (shown.PhasingSide, $"The {shown.PhasingSide} side acts in the {Games.PhaseLabel(shown.Phase)}.");
    }

    private void HandOverToAwaiting()
