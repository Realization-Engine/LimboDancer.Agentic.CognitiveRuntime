                    {
                        <PlacedChargeDetonationActions Charges="@([.. state.PlacedCharges.Where(item => item.Operable).Select(item => new PlacedChargeDetonationActions.Placed(item.Charge, item.Target.ToString(), item.TargetsConcealed, item.Cx)
                            {
                                Vehicles = NamedVehicleChoices(firing, item.Target.ToString()),
                            })])"
                            OnDetonate="@ProposeDetonateDc" OnDetonateAt="@(pick => ProposeDetonateDc(pick.Charge, pick.Vehicle))" />
                    }
                    @if ((state.Phase is "pfph" or "afph" or "dfph" || (state.Phase == "mph" && state.Movement is { WindowOpen: true })) && (OrdnanceGuns(firing).Any() || OrdnanceTanks(firing).Any() || PanzerfaustFirers(firing).Any()))
                    {
                        // The UI review of pass 55: the panel's reads are made once for a render. The ammunition list is the one the shot will
                        // name: a vehicle's when a vehicle is chosen, and otherwise Infantry's, though the Location holds a vehicle in view.
                        var shotAtVehicle = ordnanceVehicle.Length > 0;
                        var canisterShot = OrdnanceCanister();
                        var canisterAims = canisterShot ? OrdnanceCanisterAims(firing) : null;

                        // A9.61 (pass 60, the UI review): a MG fires as ordnance only at the AFV it names.
                        var mgAwaitsAfv = !shotAtVehicle && state.Find(ordnanceGun) switch
                        {
                            EquipmentInstance { Definition: { } mgWeapon } => LiveOrdnance.IsMachineGun(mgWeapon.Definition),
                            UnitInstance { Definition: { } mgVehicle } => LiveOrdnance.IsMachineGun(mgVehicle.Definition),
                            _ => false,
                        };
                        <OrdnanceFirePanel Guns="@OrdnanceChoices(firing)" Gun="@ordnanceGun" Spotters="@OrdnanceSpotters(firing)" Spotter="@ordnanceSpotter"
                            SecondFirers="@OrdnanceSecondFirers(firing)" SecondFirer="@ordnanceSecondFirer" OnSecondFirer="@ChooseOrdnanceSecondFirer"
                            Directors="@OrdnanceDirectors(firing)" Director="@ordnanceDirector" IntensiveAllowed="@OrdnanceIntensiveAllowed" Intensive="@ordnanceIntensive"
                            PanzerfaustUsage="@(PanzerfaustFirers(firing).Any() ? $"PF shots taken {state.PanzerfaustShots.GetValueOrDefault(firing)} of {LiveOrdnance.PanzerfaustAllowance(state, firing)} (C13.31)" : null)"
                            Ready="@(ordnanceGun.Length > 0 && !mgAwaitsAfv && (canisterAims is not null ? canisterAims.Any(aim => aim.Id == ordnanceCanisterAim) : ordnanceTarget.Length > 0))"
                            ReadyNote="@(ordnanceGun.Length > 0 && ordnanceTarget.Length > 0 && mgAwaitsAfv ? "Name the AFV (A9.61)." : null)" OnGun="@ChooseOrdnanceGun" OnSpotter="@(id => ordnanceSpotter = id)"
                            OnDirector="@(id => ordnanceDirector = id)" OnIntensive="@(on => ordnanceIntensive = on)" OnPropose="@ProposeOrdnance">
                            <Target>
                                <OrdnanceTargetFields Targets="@([.. OrdnanceTargets(firing)])" Vehicles="@OrdnanceVehicleChoices(firing)" Ammunition="@OrdnanceAmmunitionKind"
                                    Fixed="@OrdnanceFixedAmmunition" Ammunitions="@OrdnanceAmmunitionChoices(shotAtVehicle)" Target="@ordnanceTarget" Vehicle="@ordnanceVehicle"
                                    Chosen="@(OrdnanceAmmunitionFor(shotAtVehicle) ?? (shotAtVehicle ? ordnanceAmmunition : ordnanceInfantryAmmunition))"
                                    OnTarget="@(at => { ordnanceTarget = at; ordnanceVehicle = string.Empty; })" OnVehicle="@(id => ordnanceVehicle = id)"
                                    OnAmmunition="@(ammunition => { if (shotAtVehicle) { ordnanceAmmunition = ammunition; } else { ordnanceInfantryAmmunition = ammunition; } })"
                                    CanisterAims="@canisterAims" CanisterAim="@ordnanceCanisterAim"
                                    CanisterFacings="@OrdnanceCanisterFacings" CanisterFacing="@OrdnanceCanisterFacing"
                                    OnCanisterAim="@(aim => ordnanceCanisterAim = aim)" OnCanisterFacing="@(facing => { ordnanceCanisterFacing = facing; ordnanceCanisterAim = string.Empty; })" />
                            </Target>
                        </OrdnanceFirePanel>
                        @if (state.Phase != "mph" && state.Find(ordnanceGun) is EquipmentInstance { Kind: "asl:gun" } chosenGun && (!OrdnanceMortar || !OrdnanceLightMode))
                        {
                            <GunArcAction Facing="@ordnanceTurn" OnFacing="@(facing => ordnanceTurn = facing)" OnPropose="@ProposeTurnGun"
                                Arc="@([.. FireTargets(firing).Select(at => new GunArcAction.ArcReading(at, LimboDancer.Domains.Asl.Maps.Coordinates.BoardLocation.TryParse(at, out var reading) ? Live.Planner.GunTargetStatus(state, chosenGun.Id, reading, ordnanceSecondFirer.Length == 0 ? null : ordnanceSecondFirer) ?? "not read" : "not read"))])" />
                        }
                    }
                }
                </fieldset>
            }
            </CascadingValue>
            </CascadingValue>
            </CascadingValue>
        </section>;
            RenderFragment between = @<text>
        @if (narrow)
        {
            <InspectorTabs Tabs="@PaneTabs" Selected="@paneTab" SelectedChanged="@(tab => paneTab = tab)" Label="Workspace" IdPrefix="play" SeparatePanels="true" />
            @actionsBlock
        }
            </text>;
        }
        @if (MapLayers is { Board: { } mapBoard } layers)
        {
            <BoardWorkspace @key="@($"{gameId}/{Viewer.Name}")" ViewKey="@($"{gameId}/{Viewer.Name}")" HexNotes="@HexNotes" OriginOf="@CounterOrigin" RangeSubjects="@RangeSubjects" @ref="workspace" Board="@mapBoard" Units="@MapUnits(layers)" UnitView="@layers.View" Marks="@MapMarks(mapBoard, layers.Marks)" Vocabulary="@Library.Vocabulary" OnLoaded="@InitialMapView"
                            Selected="@(highlight is { } picked ? GameMaps.FactsAt(mapBoard, picked) : null)"
