                            @if (SmokePlacers.Any() || MoverCharges.Any())
                            {
                                <details class="rule-help-detail" id="move-more">
                                    <summary>@(SmokePlacers.Any() && MoverCharges.Any() ? "SMOKE grenades, a Demolition Charge" : SmokePlacers.Any() ? "SMOKE grenades" : "A Demolition Charge")</summary>
                                    @if (SmokePlacers.Any())
                                    {
                                        <SmokeGrenadeAction Placers="@SmokeChoices" Places="@SmokePlaces" By="@smokeBy" At="@smokeAt" Ready="@(moveUnits.Count > 0)"
                                            OnBy="@(id => smokeBy = id)" OnAt="@(at => smokeAt = at)" OnPropose="@ProposeSmoke" />
                                    }
                                    @if (MoverCharges.Any())
                                    {
                                        <PlaceDemolitionChargeAction Charges="@ChargeChoices" Charge="@placeDc" At="@placeDcAt" Ready="@(moveUnits.Count > 0)"
                                            OnCharge="@(id => placeDc = id)" OnAt="@(at => placeDcAt = at)" OnPropose="@ProposePlaceDc" />
                                    }
                                </details>
                            }
                            @if (moveUnits.Any(id => state.Unit(id) is { } mover && GameState.Condition(mover, Conditions.Berserk) == ConditionState.True))
                            {
                                <BerserkRetainedWeaponsField Value="@moveKeep" OnChange="@(keep => moveKeep = keep)" />
                            }
                            @* Pass 70 (A12.152; ruling R70.24): as the stack ends its move, once the DEFENDER's window is closed, it may Search. *@
                            @if (state.Movement is { Vehicle: false, WindowOpen: false, Members.Count: > 0 } searching)
                            {
                                <SearchAction @key="@($"{gameId}|{Viewer.Name}|{searching.Location}")" Hexes="@SearchChoices(searching.Location)" Own="@PlaceOf(new BoardLocation(searching.Location.Board, searching.Location.Hex, 0))"
                                    Busy="@busy" OnPropose="@ProposeSearch" />
                            }
                            <MovementWindowActions WindowOpen="@state.Movement?.WindowOpen" EndingSome="@EndingSome" MayPass="@(Viewer.IsAdjudicator && MandatoryNow is null)"
                                OnPass='@(() => ProposeSimple(GameActions.PassFire, "pass"))' OnEnd="@ProposeEndMove" />
                        </div>
                        }
                    }
                    </ActionSection>
                    }
                    @if (state.Movement is { Vehicle: true, WindowOpen: true, Members: [{ } reacting] } && state.Location(reacting)?.Location is { } reactionAt
                        && (Viewer.IsAdjudicator || viewAs != state.PhasingSide) && SeenOnly(ReactionUnits(reactionAt, reacting)).ToArray() is { Length: > 0 } reactors)
                    {
                        // The UI review, pass 35: a choice made in the hex the vehicle left names no unit here, so it is not shown and not sent.
                        var reactAs = reactors.Any(unit => unit.Id == reactionAttacker) ? reactionAttacker : string.Empty;
                        var reactWith = reactionLeader != reactAs && reactors.Any(unit => unit.Id == reactionLeader && unit.Kind is "asl:leader" or "asl:hero") ? reactionLeader : string.Empty;
                        <ReactionFireAction Vehicle="@reacting" Attackers="@(reactors.Select(unit => unit.Id).ToArray())"
                            Leaders='@(reactors.Where(unit => unit.Kind is "asl:leader" or "asl:hero").Select(unit => unit.Id).ToArray())'
                            Attacker="@reactAs" Leader="@reactWith" OnAttacker="@(id => reactionAttacker = id)" OnLeader="@(id => reactionLeader = id)"
                            OnPropose="@(() => ProposeVehicleCc(reactionAt.ToString(), [reactAs, .. (reactWith.Length > 0 ? new[] { reactWith } : [])], null, [], false))" />
                    }
                    @if (VehicleCandidates.Any() && (Viewer.IsAdjudicator || viewAs == state.PhasingSide))
                    {
                        <VehicleMovementPanel Vehicles="@VehicleChoices" Selected="@vehicleUnit" OnSelect="@ChooseVehicle">
                            @if (VehicleCandidates.FirstOrDefault(item => item.Id == vehicleUnit) is { } chosen)
                            {
                                <VehicleMovementStatus Vca="@(chosen.Position is MapPosition { Facing: { } vca } ? UnitFacings.Name(vca) : string.Empty)" Text="@VehicleStatusText(chosen)"
                                    Recall="@(GameState.Condition(chosen, Conditions.Recalled) == ConditionState.True ? $"Recalled: it leaves by the {state.Side(chosen.Side)?.FriendlyEdge ?? "(not named)"} edge by a shortest route, in Motion (D5.341)." : null)" />
                                <VehicleStepChoices Steps="@VehicleSteps(chosen)" Exits="@VehicleExitChoices(chosen)" Moving="@VehicleFreeToMove(chosen)" Tracked="@GamePlanner.IsTracked(chosen)"
                                    Overrun="@vehicleOverrun" AllMp="@vehicleAllMp" Minimum="@vehicleMinimum" Esb="@vehicleEsb" Intended="@vehicleIntended"
                                    IntendedChoices="@IntendedChoices(chosen)" Loadable="@LoadableUnits(chosen)" Unloadable="@UnloadableUnits(chosen)"
                                    EntryHexes="@EntryHexChoices(chosen)" EntryHex="@vehicleEntryHex" EntryFacings="@EntryFacingChoices(chosen)" EntryFacing="@vehicleEntryFacing"
                                    OnEntryHex="@(hex => ChooseEntryHex(chosen, hex))" OnEntryFacing="@(facing => vehicleEntryFacing = facing)"
                                    LoadChosen="@vehicleLoad" UnloadChosen="@vehicleUnload" OnStep="@ProposeVehicleRequest" OnOption="@SetVehicleOption"
                                    CrewUnloads="@CrewUnloads(chosen)" UnloadCrew="@vehicleCrewUnload"
                                    RiderNote="@RiderNote(chosen)" AsRiders="@BoardsAsRiders(chosen)" RidersOnly="@GamePlanner.BoardsAsRiders(state, chosen, false)"
                                    OnEsb="@(esb => vehicleEsb = esb)" OnIntended="@(at => vehicleIntended = at)"
                                    OnLoadToggle="@(pick => Toggle(vehicleLoad, pick.Unit, pick.Chosen))" OnUnloadToggle="@(pick => Toggle(vehicleUnload, pick.Unit, pick.Chosen))"
                                    Leavable="@LeavableWeapons(chosen)" LeaveChosen="@vehicleLeave" OnLeaveToggle="@(pick => Toggle(vehicleLeave, pick.Unit, pick.Chosen))" />
                                @if (TowChoices(chosen) is { Count: > 0 } guns)
                                {
                                    <VehicleTowingActions Guns="@guns" Facing="@unhookFacing" Boards="@hookBoards" OnFacing="@(facing => unhookFacing = facing)"
                                        OnBoards="@(boards => hookBoards = boards)" OnHook="@(hook => ProposeHook(chosen.Id, hook.Gun, hook.Hooked))" />
                                }
                                @if (TurretChoiceShown(chosen))
                                {
                                    <label title="D3.12: the TCA may change with each MP expended. The turret turns with the next Delay MP, stop, VCA change, or entry proposed; not in woods, a building, or rubble.">
                                        Turret with the next MP
                                        <select id="vehicle-turret" value="@vehicleTurret" @onchange="@(args => vehicleTurret = args.Value as string ?? string.Empty)">
                                            <option value="">as it is (@(LiveOrdnance.TurretFacing(state, chosen) is { } tcaNow ? UnitFacings.Name(tcaNow) : "no facing"))</option>
                                            @foreach (var spine in Enum.GetValues<UnitFacing>())
                                            {
                                                <option value="@UnitFacings.Name(spine)">@UnitFacings.Name(spine)</option>
                                            }
                                        </select>
                                    </label>
                                }
                                @if (chosen.Position is MapPosition && LiveFire.MayBoundingFire(state, chosen.Id)
                                    && (GamePlanner.HasVehicleMg(chosen) ? LiveFire.CrewExposed(chosen) && GameState.Condition(chosen, Conditions.BoundingFire) != ConditionState.True
                                        : LiveOrdnance.IsTank(chosen) || VehicleMgChoices(chosen).Any(weapon => weapon.Bar is null)))
                                {
                                    <BoundingFireAction Targets="@([.. FireTargets(state.PhasingSide)])" Target="@boundingTarget" OnTarget="@(target => { boundingTarget = target; boundingVehicle = string.Empty; })"
                                        Weapons="@VehicleMgChoices(chosen)" SelectedWeapons="@boundingWeapons" OnWeapon="@(pick => Toggle(boundingWeapons, pick.Id, pick.On))"
                                        MainArmament="@(LiveOrdnance.IsTank(chosen) && new[] { Conditions.BoundingFire, Conditions.Malfunctioned, Conditions.Disabled, Conditions.Recalled, Conditions.Stunned, Conditions.Shocked, Conditions.UnconfirmedKill }.All(name => GameState.Condition(chosen, name) != ConditionState.True))" Vehicles="@BoundingVehicleChoices(chosen.Side)" Vehicle="@boundingVehicle"
                                        OnVehicle="@(id => boundingVehicle = id)" OnProposeMa="@ProposeBoundingMa" OnPropose="@ProposeBoundingFire" />
                                }
                            }
                        </VehicleMovementPanel>
                    }
                }
                @if (state.Phase is "mph" or "aph" && ButtonUpCandidates.Any())
                {
                    <CrewExposureActions Vehicles="@([.. ButtonUpCandidates.Select(afv => new CrewExposureActions.Exposure(afv.Id, GameState.Condition(afv, Conditions.ButtonedUp) == ConditionState.True))])"
                        OnToggle="@(afv => ProposeButtonUp(afv.Id, !afv.ButtonedUp))" />
                }
                @* Pass 65, task 65.6 (ruling R65.20): a crew Abandons its vehicle, or a unit enters an Abandoned one, in its side's MPh. *@
                @if (state.Phase == "mph" && (Viewer.IsAdjudicator || viewAs == state.PhasingSide) && CrewActRows is { } crewActs
                    && (crewActs.Abandonable.Count > 0 || crewActs.Recrewable.Count > 0))
                {
                    <VehicleCrewActions Abandonable="@crewActs.Abandonable" Recrewable="@crewActs.Recrewable" Destroy="@abandonDestroy" RemoveMg="@abandonRemoveMg"
                        Chosen="@recrewPicks" OnDestroy="@(choice => abandonDestroy = choice)" OnRemoveMg="@(remove => abandonRemoveMg = remove)"
                        OnAbandon="@ProposeAbandon" OnUnit="@(pick => recrewPicks[pick.Vehicle] = pick.Unit)" OnRecrew="@(pick => ProposeRecrew(pick.Vehicle, pick.Unit))" Busy="@busy" />
                }
                @* The Play streamlining plan, S7 (ruling R-PS.8): the Advance form is the ATTACKER's; the other view is shown no section for it. *@
                @if (state.Phase == "aph" && (Viewer.IsAdjudicator || viewAs == state.PhasingSide))
                {
                    <AdvanceActionPanel Side="@(state.PhasingSide ?? string.Empty)" Units="@AdvanceRows" Selected="@advanceUnits" Destinations="@AdvanceDestinations" Waiting="@AdvanceWaiting"
                        Edges="@ExitEdges" To="@advanceTo" Edge="@advanceExit" OnToggle="@ToggleAdvancer"
                        OnTo="@(to => advanceTo = to)" OnEdge="@(edge => advanceExit = edge)" OnPropose="@ProposeAdvanceUnits" OnExit="@ProposeAdvanceExit" />
                }
                @if (state.Phase == "ccph" && VehicleCcRows is { Count: > 0 } vehicleCc)
                {
                    <VehicleCloseCombatPanel Locations="@vehicleCc" Attacker="@vehicleCcAttacker" Leader="@vehicleCcLeader" Vehicle="@vehicleCcVehicle" Defenders="@vehicleCcDefenders"
                        OnAttacker="@(id => vehicleCcAttacker = id)" OnLeader="@(id => vehicleCcLeader = id)" OnVehicle="@(id => vehicleCcVehicle = id)"
                        OnDefender="@(pick => Toggle(vehicleCcDefenders, pick.Id, pick.On))"
                        OnProposeAttack="@(at => ProposeVehicleCcAt(vehicleCc, at, byVehicle: false))" OnProposeCapture="@(at => ProposeVehicleCcAt(vehicleCc, at, byVehicle: false, capture: true))"
                        OnProposeVehicle="@(at => ProposeVehicleCcAt(vehicleCc, at, byVehicle: true))" OnProposeInfantry="@(at => ProposeInfantryCcAt(vehicleCc, at))"
                        OnProposeCapturePassengers="@(at => ProposeInfantryCcAt(vehicleCc, at, capturePassengers: true))"
                        OnPass="@(at => ProposeVehicleCc(at, [], null, [], true))" />
                }
                @* Pass 70 (ruling R70.33): once a road Location's CC with a vehicle is over, a unit that fought it by Street Fighting returns to its building or stays (A11.8). *@
                @if (state.Phase == "ccph" && StreetFightingReturnRows is { Count: > 0 } returning)
                {
                    <ActionSection Title="Street Fighting" Key="street-fighting">
                        <div class="toolbar">
                            @* The hex UI rule: the unit named after its hex, "[F4]: 4-4-7 squad R1 returns to [F3]". *@
                            @foreach (var (unit, from, at) in returning)
                            {
                                <button @key="unit.Id" class="street-fighting-return" data-unit="@unit.Id" disabled="@busy"
                                        title="@(busy ? "A proposal is being made; wait for it." : "Following its CC attack it returns to the Location it came from, or at its option remains in the road Location (A11.8).")" @onclick="@(() => ProposeStreetFightingReturn(unit.Id))">Propose: @Words(at.ToString()): @Words(unit.Id) returns to @Words(from.ToString()) (A11.8)</button>
                            }
                        </div>
                    </ActionSection>
                }
                @* Pass 70 (ruling R70.34): a captor enters the vehicle its side captured this CCPh as its crew (D5.42's EXC, A21.2). *@
                @if (state.Phase == "ccph" && CcphRecrewRows is { Count: > 0 } ccphRecrew)
                {
                    <VehicleCrewActions CloseCombat="true" Abandonable="@([])" Recrewable="@ccphRecrew" Destroy="@abandonDestroy" RemoveMg="@abandonRemoveMg"
                        Chosen="@recrewPicks" OnDestroy="@(choice => abandonDestroy = choice)" OnRemoveMg="@(remove => abandonRemoveMg = remove)"
                        OnAbandon="@ProposeAbandon" OnUnit="@(pick => recrewPicks[pick.Vehicle] = pick.Unit)" OnRecrew="@(pick => ProposeRecrew(pick.Vehicle, pick.Unit))" Busy="@busy" />
                }
                @if (state.Phase == "ccph")
                {
                    <CloseCombatPanel Due="@Live.Planner.CloseCombatDue(state)" Locations="@([.. CloseCombatLocations])" Location="@ccLocation" Entry="@CloseCombatEntry" Round="@ccRound"
                        AmbushDue="@AmbushDue" HandToHandAllowed="@state.SpecialRules.Contains(GamePlanner.HandToHandRule)" HandToHand="@ccHandToHand" AmbushWithdrawals="@AmbushWithdrawals"
                        Step="@CcStep" FirstSide="@(CloseCombatSides.FirstOrDefault())" OtherAttacks="@(CcOtherDeclared?.Attacks ?? [])" OtherDeclared="@(CcOtherDeclared is not null)" OnDeclare="@DeclareCloseCombat"
                        CanClear="@(CcKept is not null || ccAttacks.Count > 0)" OnClearAll="@ClearAllCloseCombat"
                        Smcs="@StackingChoices" Stacking="@ccStacking" Withdrawers="@Withdrawers" Withdrawals="@ccWithdrawals" Sides="@DeclaringSides" Attackers="@ccAttackers"
                        Defenders="@ccDefenders" Directors="@([.. CloseCombatDirectors.Select(unit => unit.Id)])" Director="@ccDirector" Capture="@ccCapture" Guard="@ccGuard" Yield="@ccYield"
                        Infiltrators="@Infiltrators" Infiltrations="@ccInfiltrations" Attacks="@ccAttacks" OnLocation="@ChooseCloseCombatLocation" OnRound="@ChooseRound"
                        OnHandToHand="@(on => ccHandToHand = on)" OnProposeAmbush="@ProposeAmbush" OnAmbushWithdraw="@(item => ProposeAmbushWithdrawal(item.Units, item.To))"
                        OnStacking="@(pick => SetStacking(pick.Unit, pick.Value))" OnWithdrawal="@(pick => SetWithdrawal(pick.Unit, pick.To))"
                        Dropped="@ccDrops" OnDrop="@(pick => Toggle(ccDrops, pick.Id, pick.On))"
                        OnAttacker="@(pick => ToggleAttacker(pick.Id, pick.On))" OnDefender="@(pick => ToggleDefender(pick.Id, pick.On))" MayRemove="@MayRemoveAttack" OnDirector="@(id => ccDirector = id)"
                        OnCapture="@(on => ccCapture = on)" OnGuard="@(id => ccGuard = id)" OnYield="@(text => ccYield = text)" OnAddAttack="@AddAttack"
                        OnInfiltration="@(pick => SetInfiltration(pick.Unit, pick.To))" OnRemoveAttack="@(attack => ccAttacks.Remove(attack))" OnPropose="@ProposeCloseCombat" />
                }
                @if (state.Phase is "rph" or "aph" && MayAnswer(state.PhasingSide) && Guards is { Count: > 0 } guards)
                {
                    <PrisonerCustodyActions Guards="@guards" OnTransfer="@(transfer => ProposeGuardPrisoners(transfer.Guard, transfer.To))"
                        OnAbandon="@(guard => ProposeGuardPrisoners(guard, null))" />
                }
                @if (MassacringSide is { } massacring && (Viewer.IsAdjudicator || viewAs == massacring) && Massacres(massacring).ToList() is { Count: > 0 } massacres)
                {
                    <div class="toolbar" id="play-massacres">
                        <span class="muted">Massacre (A20.4): a Russian or berserk unit eliminates a prisoner in its Location, as if using a SW; the prisoner's side is faced with No Quarter.</span>
                        @foreach (var (unit, prisoner) in massacres)
                        {
                            <button class="massacre" data-unit="@unit.Id" data-prisoner="@prisoner.Id" @onclick="@(() => ProposeMassacre(unit.Id, prisoner.Id))">Propose: @WordsAt(unit.Id) massacres @Words(prisoner.Id)</button>
                        }
                    </div>
                }
                @if (state.FireLanes.Count > 0 || state.Encirclements.Count > 0)
                {
                    <ul class="muted" id="fire-markers">
                        @foreach (var lane in state.FireLanes)
                        {
                            <li class="fire-lane">Fire Lane of @Words(lane.Weapon) (@Words(lane.Operator)): @string.Join(", ", lane.Entries.Select(entry => $"{PlaceOf(entry.Location)} {entry.Fp} FP")) (A9.22)</li>
                        }
                        @foreach (var encircled in state.Encirclements)
                        {
                            <li class="encirclement">@PlaceOf(encircled.Location): the @DisplayText.Side(encircled.Side) units there are Encircled (A7.7)</li>
                        }
                    </ul>
                }
                @if (state.Phase == "pfph" && OpportunityCandidates.Any() && (Viewer.IsAdjudicator || viewAs == state.PhasingSide))
                {
                    <OpportunityFireAction Units="@([.. OpportunityCandidates.Select(unit => unit.Id)])" Selected="@opportunityUnits"
                        OnToggle="@(pick => Toggle(opportunityUnits, pick.Id, pick.On))" OnPropose="@ProposeOpportunity" />
                }
                @* The Play streamlining plan, S7 (ruling R-PS.7): the Fire forms are the firing side's; the other view is shown no section for them. *@
                @if (FiringSide is { } firing && (Viewer.IsAdjudicator || viewAs == firing))
                {
                    @* Pass 40 (A4.151): the SMC an Infantry OVR has just entered upon may move away before any fire; the DEFENDER's to declare. *@
                    @if (state.Phase == "mph" && (Viewer.IsAdjudicator || viewAs != state.PhasingSide) && Live.Planner.OverrunEvader(state, history!.Events) is { } evader)
                    {
                        <div class="toolbar" id="overrun-evade">
                            <span class="toolbar-note">An Infantry OVR has entered the SMC's Location: it may attack if it has FP (a leader with no SW has none), move away before any fire into an adjacent Location the ATTACKER names, or stay for the CC (A4.151, A4.152).</span>
                            <button id="propose-overrun-evade" @onclick="@(() => ProposeOverrunEvade(evader))">Propose: the SMC moves away from the OVR</button>
                        </div>
                    }
                    @* Pass 45 (A8.23): at once after a Defensive First Fire attack in which a weapon kept its Multiple ROF, the DEFENDER may give it up. *@
                    @if (state.Phase == "mph" && (Viewer.IsAdjudicator || viewAs != state.PhasingSide) && GamePlanner.RateOfFireForfeit(state, history!.Events) is { } forfeit)
                    {
                        <div class="toolbar" id="forfeit-rof">
                            <span class="toolbar-note" id="forfeit-rof-note" role="status">@string.Join(", ", forfeit.Weapons.Select(id => Words(id))) @(forfeit.Weapons.Count == 1 ? "kept its Multiple ROF, so its FP" : "each kept their Multiple ROF, so their FP") left no Residual FP. Give the ROF up now, before anything else, and @forfeit.Fp Residual FP stands in @PlaceOf(forfeit.At); or go on, and @(forfeit.Weapons.Count == 1 ? "it" : "they") may fire again (A8.23).</span>
                            <button id="propose-forfeit-rof" aria-describedby="forfeit-rof-note" @onclick='@(() => ProposeSimple(GameActions.ForfeitRof, "forfeit-rof"))'>Propose: give up the ROF for @forfeit.Fp Residual FP</button>
                        </div>
                    }
                    @* Pass 55 (D2.401): while the window on an enemy unit's expenditure is open, a DEFENDER's vehicle may attempt Motion status; each
                       vehicle is listed with what the mover has spent in its own LOS, or with why it may not attempt. *@
                    @if (state.Phase == "mph" && (Viewer.IsAdjudicator || viewAs != state.PhasingSide) && MotionOptions is { Count: > 0 } motionOptions)
                    {
                        var motionChosen = motionOptions.FirstOrDefault(option => option.Vehicle == motionVehicle && option.Bar is null) ?? motionOptions.FirstOrDefault(option => option.Bar is null);
                        <ActionSection Title="Motion attempt (D2.401)" Key="motion-attempt">
                        <div class="toolbar" id="motion-attempt">
                            <span class="toolbar-note" id="motion-note">A vehicle gains Motion on a dr at or below the MF or MP the moving unit has spent in its LOS in this MPh, if that unit began its move out of that LOS; once in an enemy MPh, and it may still fire or pass afterwards (D2.401).</span>
                            @* The table player's review: an option names its vehicle once and says a bar in a few words; the whole sentence is its title.
                               The UI review: another vehicle is another attempt, so the VCA and TCA named for the last one are not kept for it. *@
                            <label>
                                Attempt by
                                <select id="motion-vehicle" value="@(motionChosen?.Vehicle ?? string.Empty)" @onchange="@(args => (motionVehicle, motionFacing, motionTurret) = (args.Value as string ?? string.Empty, string.Empty, string.Empty))">
                                    @foreach (var option in motionOptions)
                                    {
                                        <option value="@option.Vehicle" disabled="@(option.Bar is not null)" title="@(option.Bar is null ? null : Said(option.Bar))">@UnitAt(option.Vehicle): @(option.Bar is null ? ScenarioA1MotionAttempts.Chance(option.HalfPoints, option.VehicleMover) : option.BarShort is { } brief ? Words(brief) : Said(option.Bar))</option>
                                    }
                                </select>
                            </label>
                            @if (motionChosen is not null)
                            {
                                @if (!motionChosen.Bypass)
                                {
                                    <label title="D2.401: a vehicle that gains Motion may freely change its VCA; in woods, a building, or rubble each hexspine takes a Bog Check.">
                                        VCA on success
                                        <select id="motion-facing" value="@motionFacing" @onchange="@(args => motionFacing = args.Value as string ?? string.Empty)">
                                            <option value="">as it is</option>
                                            @foreach (var spine in Enum.GetValues<UnitFacing>())
                                            {
                                                <option value="@UnitFacings.Name(spine)">@UnitFacings.Name(spine)</option>
                                            }
                                        </select>
                                    </label>
                                    @if (motionChosen.Turreted)
                                    {
                                        <label title="D2.401: a vehicle that gains Motion may freely change its TCA.">
                                            TCA on success
                                            <select id="motion-turret" value="@motionTurret" @onchange="@(args => motionTurret = args.Value as string ?? string.Empty)">
                                                <option value="">as it is</option>
                                                @foreach (var spine in Enum.GetValues<UnitFacing>())
                                                {
                                                    <option value="@UnitFacings.Name(spine)">@UnitFacings.Name(spine)</option>
                                                }
                                            </select>
                                        </label>
                                    }
                                }
                                <button id="propose-motion-attempt" aria-describedby="motion-note" @onclick="@(() => ProposeMotionAttempt(motionChosen))">Propose: @UnitAt(motionChosen.Vehicle) attempts Motion</button>
                            }
                            else
                            {
                                <span class="toolbar-note" id="motion-none">No vehicle may attempt Motion now.</span>
                            }
                        </div>
                        </ActionSection>
                    }
                    @* Pass 28c (A8.1, A8.11): after each step the DEFENDER, from its own view, sees where the stack is and fires at it or passes.
                       Pass 40 (A8.312): the attack owed in the DEFENDER's own Location comes before a pass; the adjudicator has the same block. *@
                    @* The Play streamlining plan, S7: only while the DEFENDER may fire or pass, or owes Mandatory Fire; once his window closes the
                       section has nothing to offer him. *@
                    @if (state.Phase == "mph" && MovingAt is { } movingAt && (Viewer.IsAdjudicator ? MandatoryNow is not null
                        : viewAs != state.PhasingSide && (state.Movement is { WindowOpen: true } || MandatoryNow is not null)))
                    {
                        var mandatory = MandatoryNow;
                        <ActionSection Title="Defensive First Fire" Key="defensive-first-fire">
                        <div class="toolbar" id="dff-window">
                            @if (mandatory is not null)
                            {
                                <span class="toolbar-note" id="mandatory-fire-note">@ScenarioA1MandatoryFire.Note([.. mandatory.Firers.Select(id => Words(id))], mandatory.Group, PlaceOf(mandatory.At))</span>
                            }
                            else if (MoveStopped)
                            {
                                <span class="toolbar-note" id="dff-note">No member of the moving stack at @PlaceOf(movingAt) can move on: each is broken, pinned, or eliminated. Fire at it again below, or pass, which ends its move (A8.1, A4.2).</span>
                            }
                            else if (PlanNow is { } defending && !Viewer.IsAdjudicator)
                            {
                                <span class="toolbar-note" id="dff-note">The moving stack is at @PlaceOf(movingAt), step @defending.Next of its route: fire at it below, or let it move on (A8.1).</span>
                            }
                            else
                            {
                                <span class="toolbar-note" id="dff-note">The moving stack is at @PlaceOf(movingAt): fire at it below, or pass (A8.1).</span>
                            }
                            <button type="button" id="dff-show" @onclick="@(() => LocateHex(movingAt))">Show it on the map</button>
                            @if (mandatory is not null && mandatory.Group)
                            {
                                <button id="propose-mandatory-fire" title="Each unit fires its inherent FP; one already marked fires its MG with it, and a unit with no FP of its own its MG. To add a MG or a leader's direction, name the same units in the fire panel below." @onclick="@(() => ProposeMandatoryFire(mandatory))">Propose: the Mandatory FG attacks</button>
                            }
                            else if (mandatory is not null)
                            {
                                @foreach (var owing in mandatory.Firers)
                                {
                                    <button class="propose-mandatory-fire-one" data-unit="@owing" @onclick="@(() => ProposeMandatoryFire(mandatory, owing))">Propose: @UnitAt(owing) attacks</button>
                                }
                            }
                            else if (!Viewer.IsAdjudicator && PlanNow is not null)
                            {
                                @* The Play streamlining plan, S6 (rulings Q8, Q9): the DEFENDER lets the stack move on, at this step or to the end of its route. *@
                                <button type="button" id="plan-move-on" class="primary" disabled="@busy" @onclick="@(() => PlanMoveOn(false))">Let it move on</button>
                                <button type="button" id="plan-move-on-end" disabled="@busy" title="Pass at every later step of this route without being asked; Mandatory Fire still stops it." @onclick="@(() => PlanMoveOn(true))">Let it move on to the end</button>
                            }
                            else if (!Viewer.IsAdjudicator)
                            {
                                <button id="propose-pass" @onclick='@(() => ProposeSimple(GameActions.PassFire, "pass"))'>Propose: the DEFENDER passes</button>
                            }
                            @* The Play streamlining plan, S8 (rulings Q15, Q15a): a pass here and at every later window of this phase. *@
                            @if (mandatory is null && !Viewer.IsAdjudicator && PhasePassNow is null)
                            {
                                <button type="button" id="phase-pass" disabled="@busy" title="Passes here and at every later window of this Movement Phase; Mandatory Fire still stops a stack." @onclick="PassForPhase">Pass for the rest of this phase</button>
                                <label title="Counts only your units the moving side knows of: a stop at a concealed or hidden unit would tell it something is there.">
                                    <input type="checkbox" id="phase-pass-adjacent" checked="@phasePassAdjacent" @onchange="@(args => phasePassAdjacent = args.Value is true)" />
                                    still ask me when a stack comes ADJACENT to one of my units
                                </label>
                            }
                        </div>
                        </ActionSection>
                    }
                    @* The Play streamlining plan, S7 (ruling R-PS.7): in the MPh the DEFENDER fires only while his window on the moving stack is open
                       (A8.1); in any phase, only with a Location to fire from. *@
                    @if ((state.Phase != "mph" || state.Movement is { WindowOpen: true }) && FireLocations(firing).ToList() is { Count: > 0 } fireLocations)
                    {
                    var byRange = FireTargetsByRange(firing);
                    var ofTarget = FireRangeOfTarget();
                    <SmallArmsFirePanel Side="@firing" Phase="@state.Phase" PhaseLabel="@Games.PhaseLabel(state.Phase)" Locations="@fireLocations" From="@fireFrom"
                        TargetNotes="@byRange.Notes" TargetsOut="@byRange.Out" RangeSummary="@ofTarget.Summary" RangeRows="@ofTarget.Rows" OnShowRange="@ShowFireRange"
                        Also="@fireAlso" AlsoChoices="@FireAlsoChoices(firing)" OnAlso="@(pick => ToggleFireAlso(pick.Id, pick.On))" Places="@FirerPlaces(firing)" Aboard="@FireAboard(firing)" AloneCandidates="@FireAloneCandidates(firing)"
                        Firers="@FirerChoices(firing)" SelectedFirers="@fireFirers" Weapons="@([.. FireWeapons.Select(weapon => new SmallArmsFirePanel.Weapon(weapon.Id, weapon.Holding!.Holder, LiveFire.WeaponBar(weapon), weapon.Kind == "asl:ft")), .. FireVehicleMgs])"
                        SelectedWeapons="@fireWeapons" Alone="@fireAlone" Leaders="@([.. FireLeaders(firing).Select(leader => leader.Id)])" Director="@fireDirector"
                        MolAllowed='@state.SpecialRules.Contains("mol:" + firing, StringComparer.Ordinal)' Mol="@fireMol" Targets="@byRange.Targets" Target="@fireTarget"
                        VehicleChoices="@(fireMol.Length > 0 || FireWeapons.Any(weapon => weapon.Kind == "asl:ft" && fireWeapons.Contains(weapon.Id)) ? NamedVehicleChoices(firing, FireTarget) : [])"
                        Vehicle="@fireVehicle" OnVehicle="@(id => fireVehicle = id)"
                        FreeTarget="@fireFreeTarget" SnapShot="@fireSnapShot" Spray="@fireSpray" LaneWeapon="@fireLaneWeapon" LaneTo="@fireLaneTo" LanesOffered="@FireLanesOffered(firing)" Partners="@FirePartners(firing)"
                        Partner="@firePartner" OnFrom="@(at => { fireFrom = at; fireAlso.Clear(); PruneFire(); })" OnFirer="@(pick => Toggle(fireFirers, pick.Id, pick.On))"
                        OnWeapon="@(pick => Toggle(fireWeapons, pick.Id, pick.On))" OnAlone="@(pick => Toggle(fireAlone, pick.Id, pick.On))" OnDirector="@(id => fireDirector = id)"
                        OnMol="@(id => fireMol = id)" OnTarget="@(at => fireTarget = at)" OnFreeTarget="@(at => fireFreeTarget = at)" OnSnapShot="@(on => fireSnapShot = on)"
                        OnSpray="@(at => fireSpray = at)" OnLaneWeapon="@(id => fireLaneWeapon = id)" OnLaneTo="@(at => fireLaneTo = at)" OnPartner="@(id => firePartner = id)"
                        OnPropose="@ProposeFire" OnClear="@ClearFire" />
                    }
                    @if (state.Phase == "pfph" && MopUpChoices(firing) is { Count: > 0 } mopUp)
