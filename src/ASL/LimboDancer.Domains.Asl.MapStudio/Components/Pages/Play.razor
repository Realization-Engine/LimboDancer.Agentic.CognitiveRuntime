    /// taken from the reasons already disclosed to the view, so nothing more is shown than the reasons themselves would show.
    /// </summary>
    private IReadOnlyList<PlanConsequence> ConsequencesOf(Proposal proposal)
    {
        // UI review, pass 31: read once for a proposal's result, not at each use in a render.
        if (!ReferenceEquals(consequencesFor, proposal.Result))
        {
            (consequencesFor, consequences) = (proposal.Result, proposal.Result.Outcome != PlayOutcome.NeedsConfirmation ? []
                : [.. ReviewReasons(proposal).Select(GamePlanner.ConsequenceOf).OfType<PlanConsequence>()]);
        }

        return consequences;
    }

