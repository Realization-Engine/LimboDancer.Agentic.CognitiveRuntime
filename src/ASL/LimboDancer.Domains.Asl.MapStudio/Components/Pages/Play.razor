    private Task ProposeVehicleStep(string kind, string? to = null, string? facing = null, string? edge = null, bool reverse = false, bool bypass = false)
    {
        var arguments = new Dictionary<string, object>
        {
            ["gameId"] = gameId,
            ["attemptId"] = Attempt("vehicle"),
            ["expectedRevision"] = (long)history!.Events.Count,
            ["vehicleId"] = vehicleUnit,
            ["kind"] = kind,
        };
        if (reverse)
        {
            arguments["reverse"] = true;
        }

        if (kind == "enter")
        {
            if (bypass)
            {
                arguments["bypass"] = true;
            }

            if (vehicleOverrun)
            {
                arguments["overrun"] = true;
            }

            if (vehicleAllMp)
            {
                arguments["allMp"] = true;
            }

            if (vehicleMinimum)
            {
                arguments["minimumMove"] = true;
            }
        }

        if (kind == "esb" && int.TryParse(vehicleEsb, out var esb))
        {
            arguments["mp"] = esb;
        }
        if (to is not null)
        {
            arguments["to"] = to;
        }

        if (facing is not null)
        {
            arguments["facing"] = facing;
        }

        if (edge is not null)
        {
            arguments["edge"] = edge;
        }

        return Propose(GameActions.MoveVehicle, JsonSerializer.SerializeToElement(arguments));
    }

