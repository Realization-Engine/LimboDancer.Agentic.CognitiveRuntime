    // The game's counters and the draft's, drawn as one overlay, built again only when the game, the view, or the draft changes.
    private (string? Key, UnitOverlay? Overlay) draftCache;

    /// <summary>
    /// The counters the map draws (pass 30): the game's, and during setup the draft's, the plan shown or the list, with the counters' own art, so a
    /// setup is seen as it will look before anything is proposed. A draft counter's id starts with "draft:", which the style sheet draws paler; its
    /// hex is outlined by the marks. The draft is the viewer's own and is never drawn for another view.
    /// </summary>
    private UnitOverlay? MapUnits(GameMapLayers layers)
    {
        if (!SetupMode || state is null || layers.Board is not { } board || layers.Overlay is not { } committed || PublishedCatalog is not { } catalog
            || Library.Renderer(UnitLibrary.DefaultSheet) is not { } renderer)
        {
            return layers.Overlay;
        }

        var rows = DraftRows;
        if (rows.Count == 0)
        {
            return committed;
        }

        var key = $"{gameId}/{state.Revision}/{Viewer.Name}/" + string.Join('|', rows.Select(row => $"{row.Id}@{row.Definition}@{row.Kind}@{row.Location}@{row.Holder}@{row.Role}@{row.Concealed}@{row.Facing}@{row.OffBoard}"));
        if (draftCache.Key != key)
        {
            var packs = catalog.Vocabulary;
            var drafts = new List<UnitDocument>();
            foreach (var row in rows.Where(row => OnMap(row) && BoardLocation.TryParse(row.Location, out _)))
            {
                var id = DraftPrefix + row.Id;
                if (row.Kind == UnitKinds.Dummy)
                {
                    drafts.Add(new UnitDocument(packs, id, LimboDancer.Domains.Asl.Units.Vocabulary.VocabularyNames.RootKind, row.Side, row.Location, [], [], [], [], Concealed: true) { Dummy = true });
                }
                else if (Library.Vocabulary.IsA(row.Kind, "asl:equipment"))
                {
                    // A manned Gun stands at its own Location, drawn from its kind as the game's own Guns are.
                    drafts.Add(new UnitDocument(packs, id, row.Kind, row.Side, row.Location, [], [], [], [])
                    {
                        Facing = UnitFacings.TryParse(row.Facing, out var barrel) ? barrel : null,
                    });
                }
                else if (row.Definition is { } named && catalog.Definition(named) is { } definition
                    && CatalogDocuments.ToDocument(catalog, definition, Library.Vocabulary, id, row.Location).Result is { } made)
                {
                    drafts.Add(made.Document with
                    {
                        States = row.Concealed ? [Conditions.Concealed] : [],
                        Attached = [.. rows.Where(held => held.Holder == row.Id && held.Role == "possessed")
                            .Select(held => new UnitDocument(packs, DraftPrefix + held.Id, held.Kind, null, null, [], [], [], []))],
                        Facing = row.Kind == "asl:vehicle" && UnitFacings.TryParse(row.Facing, out var hull) ? hull : null,
                    });
                }
            }

            // Pass 31d (design D12; ruling R31c.6): the overlay built again from the documents has lost the leads the game's own overlay had, so
            // each counter is led again by its hex, and by the unit's name where the view has one: a committed unit's as the records name it, and
            // a draft counter's as its counter reads ("[P7]: 4-4-7 squad"), since a draft has no tag until it is in the game.
            // The counter layer design (decision L6): the layer writes each lead as it draws the counter.
            var names = history is null ? null : Live.NamesOf(history, Viewer);
            var draftNames = rows.Where(row => row.Definition is not null && catalog.Definition(row.Definition!) is not null)
                .ToDictionary(row => DraftPrefix + row.Id, row => UnitNames.Counter(catalog.Definition(row.Definition!)!), StringComparer.Ordinal);
            draftCache = (key, UnitOverlayBuilder.Build(UnitLibrary.TargetFor(board), committed.SetId, [.. committed.Units.Select(unit => unit.Document), .. drafts], renderer,
                Library.Fragments, unit => DisplayText.Place(MapBoards, unit.Location)
                    + (draftNames.TryGetValue(unit.Document.Id, out var counter) ? $": {counter}. "
                        : names?.Held(unit.Document.Id, state.Revision) is { } held && held != unit.Document.Id && !UnitNames.IsUnnamed(held) ? $": {held}. " : ": ")));
        }

        return draftCache.Overlay;
    }

    private const string DraftPrefix = "draft:";

    // The hexes of the setup areas the viewer may set up in, read once per game, revision, and view.
    private (string? Key, IReadOnlyList<BoardLocation> Hexes) areaCache;

    private IReadOnlyList<BoardLocation> SetupAreaHexes(StudioBoard board)
    {
        if (SetupCard is not { } card || SetupView is not { } report || state is null)
        {
            return [];
        }

        var key = $"{gameId}/{state.Revision}/{Viewer.Name}/{board.Ref.Value}";
        if (areaCache.Key != key)
        {
            var areas = report.Groups.Where(group => MaySetUp.Contains(group.Id)).SelectMany(group => group.Areas).Where(area => area.Kind != "entry").ToArray();
            areaCache = (key, [.. board.Facts.Hexes.Select(facts => GameMaps.LocationOf(board, facts.Index)).OfType<BoardLocation>()
                .Where(at => areas.Any(area => ScenarioSetup.Within(card, area, at)))]);
        }

        return areaCache.Hexes;
    }

    /// <summary>The setup areas of the groups the viewer may set up, as a box of the map with a hex of margin; null when there is none to show.</summary>
    private (double X, double Y, double Width, double Height)? SetupAreaBox(StudioBoard board)
    {
        if (SetupCard is not { } card || SetupView is not { } report)
        {
            return null;
        }

        var geometry = board.Render.Grid.Geometry;
        var target = UnitLibrary.TargetFor(board);
        var corners = SetupAreaHexes(board).Select(at => target.Locate(at)).OfType<HexIndex>().SelectMany(hex => geometry.Vertices(hex)).ToArray();
        if (corners.Length == 0)
        {
            return null;
        }

        // Pass 30b: a side that sets up after the other sets up against the stacks it sees, so the box takes those in too.
        if (!Viewer.IsAdjudicator && View is { } view)
        {
            corners = [.. corners, .. view.Units.Where(unit => unit.Side != viewAs && view.Locations.ContainsKey(unit.Id)).Select(unit => view.Locations[unit.Id].Location)
                .Concat(view.Sealed.Where(presence => presence.Side != viewAs).Select(presence => presence.Location))
                .Select(at => target.Locate(at with { Level = 0 })).OfType<HexIndex>().Distinct().SelectMany(hex => geometry.Vertices(hex))];
        }

        var margin = geometry.HexHeight * 1.5;
        var (left, top) = (corners.Min(point => point.X) - margin, corners.Min(point => point.Y) - margin);
        return (left, top, corners.Max(point => point.X) + margin - left, corners.Max(point => point.Y) + margin - top);
    }

    /// <summary>Use the setup area on first open, preserving a previously saved view.</summary>
    private async Task InitialMapView()
    {
        if (workspace is not null && !await workspace.HasRestoredView())
        {
            await ZoomToSetup();
        }
    }

    private async Task ZoomToSetup()
    {
        if (SetupMode && MaySetUp.Count > 0 && workspace is { Rotated: true })
        {
            placeNote = "The map is turned, and a turned map keeps its own fit: turn it back with \"Rotate map\" to zoom to the setup area.";
            return;
        }

        if (SetupMode && MaySetUp.Count > 0 && workspace is not null && MapLayers?.Board is { } board && SetupAreaBox(board) is { } box)
        {
            try
            {
                await workspace.FitArea(box.X, box.Y, box.Width, box.Height);
            }
            catch (Exception exception) when (exception is JSDisconnectedException or JSException or TaskCanceledException)
            {
                // The map is gone or not drawn: it keeps the view it has.
            }
        }
    }

    /// <summary>The list has changed: a refusal shown for the list as it was no longer describes it, so it is dropped with its marks.</summary>
    private void ListChanged()
    {
        if (pending is { } proposal && PlacesCounters(proposal)
            && proposal.Result.Outcome is PlayOutcome.NeedsConfirmation or PlayOutcome.Denied or PlayOutcome.Failed or PlayOutcome.Stale)
        {
            (pending, status) = (null, proposal.Result.Outcome == PlayOutcome.NeedsConfirmation ? "The list changed, so the setup proposed before is dropped: propose it again." : string.Empty);
        }

        (setupAsk, setupDone, swapNote) = (null, null, null);

        // A swap waits on a hex of the list: when its counters have left it, there is nothing to swap.
        if (swapFrom is not null && (!BoardLocation.TryParse(swapFrom, out var waiting) || RowsIn(waiting).Length == 0))
        {
            swapFrom = null;
        }

        if (unplacedNote is not null && ReferenceEquals(placeNote, unplacedNote))
        {
            placeNote = null;
        }

        unplacedNote = null;
        listVersion++;
        FollowCrews();
    }

    // What "Propose setup" said of counters with no hex yet; it is taken away when the list next changes.
    private string? unplacedNote;

    /// <summary>A counter as its counter prints it, such as "4-6-7 1st-line squad"; a Dummy and the Sniper counter in words.</summary>
    private string PrintedLabel(Placement row) => row.Kind == UnitKinds.Dummy ? "Dummy" : row.Kind == "asl:sniper" ? "Sniper counter"
        : row.Definition is not { } definition ? row.Id
        // A Gun or a vehicle has no short printed name in the catalog: its kind in words, then its definition.
        : DefinitionLabel(definition) is var label && label != definition ? label : $"{DisplayText.Kind(row.Kind)} {definition}";

    private string WhereText(Placement row) => row.Holder is { } holder ? row.Role switch
        {
            "passenger" => $"aboard {holder}",
            "rider" => $"a Rider on {holder}",
            "towed" => $"towed by {holder}",
            "manned" => $"manned by {holder} at {PlaceOf(row.Location)}",
            _ => $"held by {holder}",
        }
        : row.OffBoard ? "off board" : row.Location.Length == 0 ? "not placed" : PlaceOf(row.Location);

    /// <summary>
    /// The boards of the map: the game's, or before a game exists those the new game names (pass 31d, design D12), so a Location on a map of one
    /// board is written "[P7]" during setup too.
    /// </summary>
    private int MapBoards => state?.Map.Boards.Count ?? Math.Max(1, newBoard.Split(' ', StringSplitOptions.RemoveEmptyEntries).Length);

    private static bool Differs(Placement was, Placement now) => was.Location != now.Location || was.OffBoard != now.OffBoard || was.Holder != now.Holder
        || was.Concealed != now.Concealed || was.Facing != now.Facing;

    /// <summary>How the list differs from the setup plan it was filled from, one line a counter; empty for a list from no plan.</summary>
    private IReadOnlyList<string> PlanChanges
    {
        get
        {
            if (changesCache.Changes is null || changesCache.Version != listVersion || changesCache.Plan != chosenPlan)
            {
                changesCache = (listVersion, chosenPlan, ComputePlanChanges());
            }

            return changesCache.Changes!;
        }
    }

    private (int Version, string? Plan, IReadOnlyList<string>? Changes) changesCache;

    private IReadOnlyList<string> ComputePlanChanges()
    {
        {
            if (ChosenPlan is not { } plan)
            {
                return [];
            }

            var original = PlanRows(plan).ToDictionary(row => row.Id, StringComparer.Ordinal);
            var changes = new List<string>();
            foreach (var row in placements)
            {
                if (!original.TryGetValue(row.Id, out var was))
                {
                    changes.Add($"{PrintedLabel(row)} {row.Id} added, {WhereText(row)}");
                }
                else if (was.Location != row.Location || was.OffBoard != row.OffBoard || was.Holder != row.Holder)
                {
                    changes.Add($"{PrintedLabel(row)} {row.Id}: {WhereText(was)} to {WhereText(row)}");
                }
                else if (was.Concealed != row.Concealed)
                {
                    changes.Add($"{PrintedLabel(row)} {row.Id}: {(row.Concealed ? "now under \"?\"" : "no longer under \"?\"")}");
                }
                else if (was.Facing != row.Facing)
                {
                    changes.Add($"{PrintedLabel(row)} {row.Id}: facing {was.Facing} to {row.Facing}");
                }
            }

            changes.AddRange(original.Values.Where(was => placements.All(row => row.Id != was.Id)).Select(was => $"{PrintedLabel(was)} {was.Id} removed"));
            return changes;
        }
    }

    private static string Count(int count, string one, string many) => count == 1 ? $"1 {one}" : $"{count} {many}";

    /// <summary>"Use this plan": asked first when the list has changes that would be lost.</summary>
    private void AskUsePlan(string id)
    {
        if (PlansOffered?.Plans.FirstOrDefault(plan => plan.Id == id) is not { } plan)
        {
            return;
        }

        var lost = ChosenPlan is { } from ? PlanChanges.Count > 0 ? $"Your {Count(PlanChanges.Count, "change", "changes")} to {from.Name} will be lost." : null
            : placements.Count > 0 ? $"Its {Count(placements.Count, "counter", "counters")} will be replaced by {plan.Name}." : null;
        if (lost is null)
        {
            UsePlan(id);
            return;
        }

        setupAsk = ("use:" + id, $"Replace your list? {lost}", chosenPlan == id ? $"Reset to {plan.Name}" : "Replace my list");
        setupTab = SetupTab;
    }

    /// <summary>"Clear": asked first when the list is not just an untouched plan.</summary>
    private void AskClear()
    {
        if (ChosenPlan is not null && PlanChanges.Count == 0)
        {
            ClearPlacements();
            ListChanged();
        }
        else
        {
            setupAsk = ("clear", ChosenPlan is { } from ? $"Clear your list? Your {Count(PlanChanges.Count, "change", "changes")} to {from.Name} will be lost."
                : $"Clear your list? Its {Count(placements.Count, "counter", "counters")} will be removed.", "Clear my list");
        }
    }

    private void AnswerAsk(bool yes)
    {
        var asked = setupAsk;
        setupAsk = null;
        if (!yes || asked is not { } question)
        {
            ShowActions(scroll: false);
            return;
        }

        if (question.Kind == "clear")
        {
            ClearPlacements();
            ShowActions(scroll: false);
        }
        else
        {
            UsePlan(question.Kind["use:".Length..]);
        }

        ListChanged();
    }

