    private string RoutAdviceText(UnitInstance unit)
    {
        var (targets, canRout) = Live.Planner.RoutAdvice(state!, unit);
        return !canRout ? "; no legal rout step: it is eliminated for Failure to Rout, or surrenders, as the RtPh ends if it must rout"
            : targets.Count > 0 ? $"; must reach {string.Join(" or ", targets)}"
            : "; no woods or building within reach: any legal route";
    }

