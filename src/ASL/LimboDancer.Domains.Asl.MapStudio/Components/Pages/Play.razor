    private IEnumerable<UnitInstance> ReactionUnits(BoardLocation at, string vehicle) => state is null || state.Unit(vehicle) is not { } moving ? []
        : state.At(at).OfType<UnitInstance>().Where(unit => unit.Status == InstanceStatus.Active && unit.Side != moving.Side && !LiveFire.IsVehicle(unit)
            && unit.Kind != UnitKinds.Dummy && GameState.Condition(unit, Conditions.Broken) != ConditionState.True && GameState.Condition(unit, Conditions.Pinned) != ConditionState.True
            && GameState.Condition(unit, Conditions.Melee) != ConditionState.True && GameState.Condition(unit, Conditions.Captured) != ConditionState.True)
            .OrderBy(unit => unit.Id, StringComparer.Ordinal);

    /// <summary>The Locations whose sequential CC with a vehicle is open this CCPh (A11.31).</summary>
    // UI review, pass 27 (ruling R23.1): only a view that may act for the side attacking next is offered its Location.
    private IEnumerable<BoardLocation> VehicleCcLocations => state is null || state.Phase != "ccph" ? []
        : state.Units.Where(unit => unit.Status == InstanceStatus.Active && LiveFire.IsVehicle(unit)).Select(unit => state.Location(unit.Id)?.Location).OfType<BoardLocation>()
            .Distinct().Where(location => Live.Planner.VehicleCloseCombatTurn(state, location) is { Open: true } turn && MayAnswer(turn.Next))
            .OrderBy(location => location.ToString(), StringComparer.Ordinal);

    /// <summary>Each open vehicle CC Location as the panel reads it (plan C01): the side that attacks next and the units it offers.</summary>
    private IReadOnlyList<VehicleCloseCombatPanel.CcLocation> VehicleCcRows => state is null ? [] : [.. VehicleCcLocations.Select(location =>
    {
        var (nextSide, _) = Live.Planner.VehicleCloseCombatTurn(state, location);
        var here = SeenOnly(state.At(location).OfType<UnitInstance>().Where(unit => unit.Status == InstanceStatus.Active)).ToArray();
        var attacked = state.CloseCombats.FirstOrDefault(item => item.Location == location && !item.Closed)?.Attacking ?? [];
        return new VehicleCloseCombatPanel.CcLocation(location.ToString(), nextSide ?? string.Empty,
            [.. here.Where(unit => unit.Side == nextSide && !LiveFire.IsVehicle(unit) && unit.Kind != UnitKinds.Dummy && !attacked.Contains(unit.Id)
                && GameState.Condition(unit, Conditions.Broken) != ConditionState.True && GameState.Condition(unit, Conditions.Captured) != ConditionState.True).Select(unit => unit.Id)],
            [.. here.Where(unit => unit.Side == nextSide && unit.Kind is "asl:leader" or "asl:hero").Select(unit => unit.Id)],
            [.. here.Where(LiveFire.IsVehicle).Select(unit => new VehicleCloseCombatPanel.VehicleChoice(unit.Id, unit.Side))],
            [.. here.Where(unit => !LiveFire.IsVehicle(unit) && unit.Side != nextSide).Select(unit => unit.Id)]);
    })];

