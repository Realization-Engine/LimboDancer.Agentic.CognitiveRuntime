    /// <summary>A prisoner's Guard, and a Guard's prisoners (A20.5), as the units table shows them.</summary>
    private IEnumerable<string> Custody(UnitInstance unit)
    {
        if (unit.Custodian is { } guard)
        {
            // Referee, pass 29: a side never reads the id of a unit its view does not hold (rulings R23.1, R23.3).
            yield return $"guarded by {(Viewer.IsAdjudicator || VisibleUnits.Any(seen => seen.Id == guard) ? guard : "a unit not in view")}";
        }

        if (state?.Units.Where(item => item.Status == InstanceStatus.Active && item.Custodian == unit.Id
            && (Viewer.IsAdjudicator || VisibleUnits.Any(seen => seen.Id == item.Id))).Select(item => item.Id).Order(StringComparer.Ordinal).ToArray() is { Length: > 0 } prisoners)
        {
            yield return $"guards {string.Join(", ", prisoners)}";
        }
    }

    // A side's view with no replayed state shows nothing rather than the whole game (UI review, pass 23).
    /// <summary>The units of a list the view may see: every action's picker passes through it (ruling R23.1; Studio demo, pass 23).</summary>
    private IEnumerable<UnitInstance> SeenOnly(IEnumerable<UnitInstance> units)
    {
        // Ruling R26.2: a Passenger acts only with its vehicle, so no action list offers it.
        units = units.Where(unit => state?.Aboard(unit.Id) is null);
        if (Viewer.IsAdjudicator)
        {
            return units;
        }

        var seen = VisibleUnits.Select(unit => unit.Id).ToHashSet(StringComparer.Ordinal);
        return units.Where(unit => seen.Contains(unit.Id));
    }

    private IEnumerable<UnitInstance> VisibleUnits => Viewer.IsAdjudicator ? state?.Units ?? [] : View?.Units ?? [];

    /// <summary>
    /// The rolls the viewer may see, latest first, with the unit each die belongs to when the viewer may see that too:
    /// the adjudicator, or the side whose units were selected (Random Selection and Declined OVR Design, section 7).
    /// </summary>
    private IReadOnlyList<(DiceRolled Roll, IReadOnlyList<string>? Subjects)> Rolls => history is null
        ? []
        : [.. history.Events.Where(item => item.IsVisibleTo(Viewer)).Select(item => item.Payload).OfType<DiceRolled>().Reverse().Take(6)
            .Select(roll => (roll, history.Events.Where(item => item.IsVisibleTo(Viewer)).Select(item => item.Payload).OfType<RandomSelection>()
                .FirstOrDefault(selection => selection.Roll == roll.Roll)?.Subjects))];

    /// <summary>
    /// A roll with its purpose; an NTC also shows its arithmetic from the task check that used it (Infantry OVR Design,
    /// section 7), for example "OVR NTC: 3, 5 + 3 (TEM) = 11 against morale 7: failed".
    /// </summary>
    private string RollText(DiceRolled roll)
    {
        var check = history?.Events.Select(item => item.Payload).OfType<TaskCheck>().FirstOrDefault(item => item.Roll == roll.Roll);
        if (check is null)
        {
            return $"{roll.Purpose}: {string.Join(", ", roll.Values)}";
        }

        var modifiers = string.Concat(check.Modifiers.Select(item => $" {(item.Value < 0 ? "-" : "+")} {Math.Abs(item.Value)} ({(item.Source == "B23.3" ? "TEM" : item.Source)})"));
        return $"{(check.Purpose == TaskCheck.OvrNtc ? "OVR NTC" : check.Purpose)}: {string.Join(", ", roll.Values)}{modifiers} = {check.FinalDr} "
            + $"against morale {check.MoraleLevel}: {(check.Passed ? "passed" : "failed")}";
    }

