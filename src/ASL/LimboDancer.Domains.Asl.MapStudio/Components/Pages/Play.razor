    private static readonly Lazy<ScenarioA1FireReference> FirePreviewReference = new(() => new ScenarioA1FirePackage().Reference);

    /// <summary>
    /// A fire's arithmetic before the dice, as the firing view may know it (the referee, pass 31c; A12.3, A12.11, A12.14). A hidden unit in the
    /// target Location is left out of the preview's facts, so nothing in it differs from what the firer would work out at the table; the
    /// adjudicator's preview has every target. Where the view sees a "?" in the target Location, the preview is said as incomplete, and what rests
    /// on the units beneath it is not shown.
    /// </summary>
    private (FireArithmetic? Arithmetic, bool Incomplete) FirePreview(FireAttack attack)
    {
        if (Viewer.IsAdjudicator)
        {
            return (ScenarioA1FireCalculator.Preview(attack, FirePreviewReference.Value), false);
        }

        var held = VisibleUnits.Select(unit => unit.Id).ToHashSet(StringComparer.Ordinal);
        var sealedThere = SealedPresences.Any(presence => presence.Location.ToString() == attack.TargetLocationId);
        var known = attack with
        {
            Targets = attack.Targets is null ? null : [.. attack.Targets.Where(target => target.Hidden != true && (target.UnitId is null || held.Contains(target.UnitId) || target.Concealed == true))],
        };
        return (ScenarioA1FireCalculator.Preview(known, FirePreviewReference.Value), sealedThere);
    }

    /// <summary>
    /// The Locations that may join the fire group (A7.5: "each participating unit occupies a Location ADJACENT to another participating unit of
    /// the same FG"): those holding a unit that may fire, ADJACENT to a Location already in the group. None at night (E1.75; ruling R16.3).
    /// </summary>
    private IReadOnlyList<string> FireAlsoChoices(string side)
    {
        if (state is null || fireFrom.Length == 0 || state.Night)
        {
            return [];
        }

        var group = string.Join('|', fireAlso.Prepend(fireFrom));
        if (fireAlsoCache.Choices is null || fireAlsoCache.Revision != state.Revision || fireAlsoCache.Group != group)
        {
            var inGroup = fireAlso.Prepend(fireFrom).Select(BoardLocation.Parse).ToArray();
            fireAlsoCache = (state.Revision, group, [.. FireLocations(side).Where(at => at != fireFrom && !fireAlso.Contains(at)
                && BoardLocation.TryParse(at, out var other) && inGroup.Any(one => Live.Planner.Adjacent(state, one, other)))]);
        }

        return fireAlsoCache.Choices;
    }

    private void ToggleFireAlso(string at, bool on)
    {
        if (on && at.Length > 0 && !fireAlso.Contains(at))
        {
            fireAlso.Add(at);
        }
        else if (!on)
        {
            fireAlso.Remove(at);

            // A7.5: every Location of the group is ADJACENT to another of it, in one chain from the first; what the removal cut off goes too.
            if (state is not null && BoardLocation.TryParse(fireFrom, out var first))
            {
                var joined = new List<BoardLocation> { first };
                var left = fireAlso.Select(BoardLocation.Parse).ToList();
                while (left.FirstOrDefault(other => joined.Any(one => Live.Planner.Adjacent(state, one, other))) is { } next)
                {
                    joined.Add(next);
                    left.Remove(next);
                }

                fireAlso.RemoveAll(other => left.Any(cut => cut.ToString() == other));
            }
        }

        PruneFire();
    }
