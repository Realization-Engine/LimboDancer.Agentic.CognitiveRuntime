    // Pass 31b (task 31b.2): the records are read by PlayRecords, for the history, the view, and the game's last revision, once for the three; the
    // Replay page reads the same records for a step.
    private PlayRecords? recordsCache;

    // Pass 31c (design D11): the view's words for a text of the game as it stands: a unit's name for its id (a unit the view does not hold
    // reads "a concealed unit"), a counter for its definition, a Location in words. Made once for a history and a view.
    private (GameHistory? History, string Viewer, Func<string, string> Say) wordsCache = (null, string.Empty, static text => text);

    private Func<string, string> Words
    {
        get
        {
            if (history is null)
            {
                return static text => text;
            }

            if (!ReferenceEquals(wordsCache.History, history) || wordsCache.Viewer != Viewer.Name)
            {
                var names = Live.NamesOf(history, Viewer);
                var before = (long)history.Events.Count;
                var said = new Dictionary<string, string>(StringComparer.Ordinal);
                // Pass 31d (design D11): a planner's terrain keys and phase short forms, and a building's hex in brackets, are said with the names.
                var boards = state?.Map.Boards.Count ?? 1;
                wordsCache = (history, Viewer.Name, text => said.TryGetValue(text, out var kept) ? kept : said[text] = DisplayText.Hexes(DisplayText.Planner(names.InText(text, before)), boards));
            }

            return wordsCache.Say;
        }
    }

    // Pass 31c (the user, 2026-10-04): a unit named with no Location beside it carries its hex, "4-6-7 squad G4 in [G4]". The text is a
    // unit's id, alone or with words after it; a unit the view does not place is said as Words says it.
    private (Func<string, string>? Say, Func<string, string> At) atCache = (null, static text => text);

    private Func<string, string> WordsAt
    {
        get
        {
            var say = Words;
            if (!ReferenceEquals(atCache.Say, say))
            {
                atCache = (say, text =>
                {
                    var said = say(text);
                    var end = text.IndexOf(' ', StringComparison.Ordinal);
                    var id = end < 0 ? text : text[..end];
                    // Pass 65 (the UI review): the unit and its Location come from the planner's index, once per state, not a scan of the state per label.
                    if (state is null || Live.Planner.UnitOf(state, id) is not { } unit
                        || (Viewer.IsAdjudicator ? Live.Planner.LocationOf(state, id)?.Location : View?.Locations.TryGetValue(id, out var seen) == true ? seen.Location : null) is not { } at)
                    {
                        return said;
                    }

                    var name = say(unit.Id);
                    return said.StartsWith(name, StringComparison.Ordinal) ? $"{name} in {PlaceOf(at)}{said[name.Length..]}" : said;
                });
            }

            return atCache.At;
        }
    }

