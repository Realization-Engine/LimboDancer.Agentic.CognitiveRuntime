    /// <summary>
    /// The units that may board the vehicle (D6.4): of its side, on foot in its Location, not done moving, Good Order and unpinned, while it is stopped, not in
    /// Motion, and has spent no MP this MPh.
    /// </summary>
    private IReadOnlyList<string> LoadableUnits(UnitInstance vehicle)
    {
        if (state is null || state.Movement is not null || vehicle.Position is not MapPosition || vehicle.MfSpent != 0 || vehicle.HalfMfSpent
            || GameState.Condition(vehicle, Conditions.Motion) == ConditionState.True || GamePlanner.PassengerCapacity(state, vehicle) is null
            || state.Location(vehicle.Id)?.Location is not { } at)
        {
