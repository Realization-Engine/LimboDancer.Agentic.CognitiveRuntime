    // The Memory and Performance Guidelines (page projections by state and viewer): the buildings the side may Mop Up, read once a state, view, and side.
    private (GameState? State, string Viewer, string Side, IReadOnlyList<MoppingUpAction.Choice>? Choices) mopUpCache;

    private List<MoppingUpAction.Choice> ReadMopUpChoices(GameState current, string side)
    {
        string[] barred = [Conditions.Broken, Conditions.Berserk, Conditions.Pinned, Conditions.Captured, Conditions.Unarmed, Conditions.Melee, "asl:ti", Conditions.PrepFire];
        var choices = new List<MoppingUpAction.Choice>();
        var own = SeenOnly(current.Units.Where(unit => unit.Status == InstanceStatus.Active && unit.Side == side))
            .Select(unit => (Unit: unit, At: Live.Planner.LocationOf(current, unit.Id)?.Location)).Where(item => item.At is { Level: >= 0 }).ToArray();
        foreach (var (id, hexes) in Live.Planner.MopUpBuildings(current, own.Select(item => item.At!)).Where(item => !current.MoppedUpThisPlayerTurn.Contains(item.Id, StringComparer.Ordinal)))
        {
            var placed = own.Where(item => hexes.Any(hex => hex.Board == item.At!.Board && hex.Hex == item.At.Hex)).OrderBy(item => item.Unit.Id, StringComparer.Ordinal).ToArray();
            var inside = placed.Select(item => item.Unit).ToArray();
            string[] moppers = [.. inside.Where(unit => (unit.Kind is "asl:squad" or "asl:half-squad" || ScenarioA1Definitions.IsCrew(unit.Kind))
                && !barred.Any(name => GameState.Condition(unit, name) == ConditionState.True)).Select(unit => unit.Id)];
            if (moppers.Length > 0)
            {
                choices.Add(new MoppingUpAction.Choice(id, moppers, [.. inside.Where(unit => unit.Kind != UnitKinds.Dummy
                    && GameState.Condition(unit, Conditions.Broken) != ConditionState.True && GameState.Condition(unit, Conditions.Captured) != ConditionState.True).Select(unit => unit.Id)],
                    placed.ToDictionary(item => item.Unit.Id, item => item.At!.Level == 0 ? $"{item.At.Board.Value}:{item.At.Hex}" : $"{item.At.Board.Value}:{item.At.Hex} level {item.At.Level}",
                        StringComparer.Ordinal)));
            }
        }

        return choices;
    }

