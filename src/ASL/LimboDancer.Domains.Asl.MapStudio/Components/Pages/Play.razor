    /// <summary>Pass 28b: the broken units the view sees that may rout, and what each owes (A10.5; ruling R23.1).</summary>
    // Pass 31c (design D18; play test P-24): what each broken unit owes is read once for a state and a view, not on every render of the Rout
    // panel; each reading runs the rout search for every broken unit.
    private (GameState? State, string Viewer, IReadOnlyList<RoutActionPanel.Obligation>? Obligations, IReadOnlyList<PlayChoice>? Choices) routCache;

    private IReadOnlyList<RoutActionPanel.Obligation> RoutObligations => ReadRout().Obligations;

    private IReadOnlyList<PlayChoice> RoutChoices => ReadRout().Choices;

    /// <summary>
    /// Both of the Rout panel's lists, read once for a state and a view in one pass over the broken units (the Play Step Plan, task 3): each unit is
    /// asked once whether it may rout, why it must, whether it surrenders instead, and where it may go. The obligations are in the units' id order,
    /// the choices in the view's order, as before.
    /// </summary>
    private (IReadOnlyList<RoutActionPanel.Obligation> Obligations, IReadOnlyList<PlayChoice> Choices) ReadRout()
    {
        if (ReferenceEquals(routCache.State, state) && routCache.Viewer == Viewer.Name && routCache is { Obligations: { } kept, Choices: { } choices })
        {
            return (kept, choices);
        }

        var obligations = new List<RoutActionPanel.Obligation>();
        var choosable = new List<PlayChoice>();
        if (state is not null)
        {
            foreach (var unit in SeenOnly(VisibleUnits, aboardToo: true).Where(unit => unit.Status == InstanceStatus.Active && Mine(unit) && GameState.Condition(unit, Conditions.Broken) == ConditionState.True))
            {
                if (!Live.Planner.MayRout(state, unit))
                {
                    continue;
                }

                var routed = state.RoutedThisPhase.Contains(unit.Id);
                // Pass 35 (task 35.17; A20.21): a unit that surrenders instead of routing is said to, and is offered no route nor a choice.
                if (!routed && Live.Planner.RoutSurrenderAdvice(state, unit) is { } surrenders)
                {
                    obligations.Add(new RoutActionPanel.Obligation(unit.Id, surrenders));
                    continue;
                }

                var why = Live.Planner.MustRout(state, unit);
                // Pass 65 (ruling R65.11; D6.1): a broken Passenger stays aboard or routs beneath its vehicle, with no route to choose.
                var vehicle = Live.Planner.VehicleRidden(state, unit.Id);
                var owes = unit.Id + (why is not null ? $" must rout: {why}"
                    : vehicle is not null ? $" may rout beneath {vehicle}, spending all its MF, or stay aboard (D6.1)" : " may rout, since it is under DM");
                if (routed)
                {
                    obligations.Add(new RoutActionPanel.Obligation(unit.Id, owes + ". It has routed."));
                    continue;
                }

                if (vehicle is not null)
                {
                    obligations.Add(new RoutActionPanel.Obligation(unit.Id, owes, Beneath: vehicle));
                    continue;
                }

                var (advice, routes) = RoutAdviceText(unit, why is not null);
                obligations.Add(new RoutActionPanel.Obligation(unit.Id, owes + advice, routes));
                choosable.Add(Labelled(unit));
            }
        }

        IReadOnlyList<RoutActionPanel.Obligation> ordered = [.. obligations.OrderBy(item => item.Unit, StringComparer.Ordinal)];
        routCache = (state, Viewer.Name, ordered, choosable);
        return (ordered, choosable);
    }

