    private Task ProposeSmoke()
    {
        var units = moveUnits.Order(StringComparer.Ordinal).ToArray();
        var at = state?.Location(units[0])?.Location.ToString() ?? string.Empty;
        return Propose(GameActions.Move, JsonSerializer.SerializeToElement(new Dictionary<string, object>
        {
            ["gameId"] = gameId, ["attemptId"] = Attempt("smoke"), ["expectedRevision"] = (long)history!.Events.Count, ["unitIds"] = units,
            ["to"] = at, ["assault"] = moveAssault, ["doubleTime"] = moveDoubleTime, ["smoke"] = smokeAt.Trim(), ["smokeBy"] = smokeBy,
        }));
    }

    private Task ProposeMove()
    {
        var arguments = new Dictionary<string, object>
        {
            ["gameId"] = gameId, ["attemptId"] = Attempt("move"), ["expectedRevision"] = (long)history!.Events.Count, ["unitIds"] = moveUnits.Order(StringComparer.Ordinal).ToArray(),
            ["to"] = moveTo.Trim(), ["assault"] = moveAssault, ["doubleTime"] = moveDoubleTime,
        };

        // A15.431 (ruling R15.14): the 1PP SW a berserk unit keeps.
        if (moveKeep.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries) is { Length: > 0 } keep)
        {
            arguments["keep"] = keep;
        }

        // A4.134, A4.3 (rulings R10.7, R10.9): a Minimum Move, or the hexsides of a Bypass.
        if (moveMinimum)
        {
            arguments["minimumMove"] = true;
        }

        if (moveBypass.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries) is { Length: > 0 } sides)
        {
            arguments["bypass"] = sides.Select(side => side.ToLowerInvariant()).ToArray();
        }

        if (movePush && MovingGun is { } gun)
        {
            arguments["pushGun"] = gun.Id;
        }

        return Propose(GameActions.Move, JsonSerializer.SerializeToElement(arguments));
    }

    /// <summary>An action that names only the game: the DEFENDER's pass, or the end of the moving stack's move.</summary>
    private Task ProposeSimple(ActionDescriptor action, string kind) => Propose(action,
        JsonSerializer.SerializeToElement(new { gameId, attemptId = Attempt(kind), expectedRevision = (long)history!.Events.Count }));

    private static void Toggle(HashSet<string> set, string id, bool chosen)
    {
        if (chosen)
        {
            set.Add(id);
        }
        else
        {
            set.Remove(id);
        }
    }

    /// <summary>The Locations that hold active units of the firing side that may fire now.</summary>
    private IEnumerable<string> FireLocations(string side) => state is null ? []
        : state.Units.Where(unit => unit.Status == InstanceStatus.Active && unit.Side == side
            && (Library.Vocabulary.IsA(unit.Kind, "asl:mmc") || unit.Kind == "asl:hero" || GamePlanner.HasVehicleMg(unit)) && MayFire(unit))
            .Select(unit => state.Location(unit.Id)?.Location.ToString())
            .OfType<string>().Distinct(StringComparer.Ordinal).Order(StringComparer.Ordinal);

    /// <summary>
    /// Whether a unit may fire now: not a crew, whose inherent fire the Fire package does not review (ruling R24.8); not berserk, held
    /// in Melee, a prisoner, or a Guard (A15.432, A11.15, A20.5, A20.52); and not spent for this phase (A7.1, A8.4), as the planner and
    /// the Fire package read it.
    /// </summary>
    private bool MayFire(UnitInstance unit) => state is not null && unit.Kind != "asl:crew" && GamePlanner.FireBar(state, unit) is null && !LiveFire.FireSpent(state, unit)
        && (!LiveFire.IsVehicle(unit) || (GamePlanner.HasVehicleMg(unit) && LiveFire.CrewExposed(unit)));

    private IEnumerable<UnitInstance> FireGroupAt(string side) => state is null || fireFrom.Length == 0 ? []
        : state.Units.Where(unit => unit.Status == InstanceStatus.Active && unit.Side == side && state.Location(unit.Id)?.Location.ToString() is { } at
            && (at == fireFrom || fireAlso.Contains(at)) && state.Aboard(unit.Id) is null)
            .OrderBy(unit => state.Location(unit.Id)!.Location.ToString() == fireFrom ? 0 : 1 + fireAlso.IndexOf(state.Location(unit.Id)!.Location.ToString())).ThenBy(unit => unit.Id, StringComparer.Ordinal);

    /// <summary>
    /// The Locations the firing side may target: those holding an enemy unit it can see or a concealed one it knows is there
    /// (A12.11). A hidden unit is not offered, since the firing side does not know of it.
    /// </summary>
    private IEnumerable<string> FireTargets(string side)
    {
        if (state is null || history?.Current is null || state.Perspectives.FirstOrDefault(item => item.Name == side) is not { } perspective)
        {
            return [];
        }

        var view = GameView.Of(history, state.Revision, perspective, Live.Planner.OutOfSight(state, perspective));
        return view.Units.Where(unit => unit.Side != side).Select(unit => view.Locations.TryGetValue(unit.Id, out var at) ? at.Location.ToString() : null)
            .Concat(view.Sealed.Where(item => item.Side != side).Select(item => item.Location.ToString()))
            .OfType<string>().Distinct(StringComparer.Ordinal).Order(StringComparer.Ordinal);
    }

    private Task ProposeFire()
    {
        var arguments = new Dictionary<string, object>
        {
            ["gameId"] = gameId,
            ["attemptId"] = Attempt("fire"),
            ["expectedRevision"] = (long)history!.Events.Count,
            ["firers"] = fireFirers.Order(StringComparer.Ordinal).ToArray(),
            ["target"] = FireTarget.Trim(),
        };
        if (fireSnapShot)
        {
            arguments["snapShot"] = true;
        }

        // A9.5, A9.22, A9.12 (backlog pass 12): Spraying Fire's second Location, a Fire Lane, and a leader's partner.
        if (fireSpray.Trim() is { Length: > 0 } sprayed)
        {
            arguments["sprayTarget"] = sprayed;
        }

        if (fireLaneWeapon.Length > 0 && fireWeapons.Contains(fireLaneWeapon) && fireLaneTo.Trim() is { Length: > 0 } laneTo)
        {
            arguments["fireLane"] = new Dictionary<string, string> { ["weapon"] = fireLaneWeapon, ["to"] = laneTo };
        }

        if (firePartner.Trim() is { Length: > 0 } partner && fireFirers.FirstOrDefault(id => state?.Unit(id)?.Kind == "asl:leader") is { } leaderFirer)
        {
            arguments["partners"] = new Dictionary<string, string> { [leaderFirer] = partner };
        }

        if (fireDirector.Length > 0)
        {
            arguments["director"] = fireDirector;
        }

        // A9.2: the MGs each firer uses, and the firers whose MGs fire without their inherent FP.
        var weapons = FireWeapons.Where(item => fireWeapons.Contains(item.Id)).GroupBy(item => item.Holding!.Holder)
            .ToDictionary(group => group.Key, group => group.Select(item => item.Id).ToArray(), StringComparer.Ordinal);
        if (weapons.Count > 0)
        {
            arguments["weapons"] = weapons;

            // A22.31 (ruling R15.1): a FT fires without its squad's inherent FP.
            var flamethrowers = FireWeapons.Where(item => fireWeapons.Contains(item.Id) && item.Kind == "asl:ft").Select(item => item.Holding!.Holder);
            if (fireAlone.Where(weapons.ContainsKey).Concat(flamethrowers).Distinct(StringComparer.Ordinal).Order(StringComparer.Ordinal).ToArray() is { Length: > 0 } alone)
            {
                arguments["withoutInherent"] = alone;
            }
        }

        // A22.611 (ruling R15.4): the firer making the MOL Check.
        if (fireMol.Length > 0 && fireFirers.Contains(fireMol))
        {
            arguments["mol"] = fireMol;
        }

        return Propose(GameActions.Fire, JsonSerializer.SerializeToElement(arguments));
    }



