            && (state.Movement is not { WindowOpen: true } open || !open.Movers.Contains(unit.Id, StringComparer.Ordinal))
            && !ExposureChanged.Contains(unit.Id))
            .OrderBy(unit => unit.Id, StringComparer.Ordinal));

    /// <summary>The AFVs whose BU counter was placed or removed since the phase began, once per phase (D5.33).</summary>
    private HashSet<string> ExposureChanged
    {
        get
        {
            var events = history?.Events ?? [];
            var since = events.Select((item, index) => (item, index)).LastOrDefault(pair => pair.item.Payload is PhaseChanged or GameStarted).index;
            return [.. events.Skip(since).Where(item => item.Type == "crew-exposure-changed").Select(item => item.Payload).OfType<ConditionsChanged>().Select(item => item.Id)];
        }
    }

