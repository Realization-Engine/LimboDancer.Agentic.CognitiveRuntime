        if (vehicleTurret.Length > 0 && ScenarioA1VehicleMovementCalculator.TurretTurnsWith(kind) && state?.Unit(vehicleUnit) is { } turning && TurretChoiceShown(turning))
        {
            arguments["turret"] = vehicleTurret;
        }

        if (reverse)
        {
            arguments["reverse"] = true;
        }

        if (kind == "enter")
        {
            if (bypass)
            {
                arguments["bypass"] = true;
            }

            if (vehicleOverrun)
            {
                arguments["overrun"] = true;
            }

            if (vehicleAllMp)
            {
                arguments["allMp"] = true;
            }

            if (vehicleMinimum)
            {
                arguments["minimumMove"] = true;
            }
        }

        if (kind == "esb" && int.TryParse(vehicleEsb, out var esb))
        {
            arguments["mp"] = esb;
        }
        if (to is not null)
        {
            arguments["to"] = to;
        }

        if (facing is not null)
        {
            arguments["facing"] = facing;
        }

        if (edge is not null)
        {
            arguments["edge"] = edge;
        }

        return Propose(GameActions.MoveVehicle, JsonSerializer.SerializeToElement(arguments));
    }

