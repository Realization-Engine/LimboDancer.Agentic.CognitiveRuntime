    private bool SetupOpen => history is { } shown && shown.Events.All(item => GameState.IsSetupEvent(item.Payload));

    protected override void OnInitialized()
    {
        placeDefinition = Definitions.FirstOrDefault()?.Id ?? string.Empty;
        gameId = GameQuery ?? string.Empty;
        Refresh();
        if (HexQuery is { Length: > 0 } hex && LimboDancer.Domains.Asl.Maps.Coordinates.BoardLocation.TryParse(hex, out var picked))
        {
            // Picked once the hand-over on load is confirmed, which clears what the last view picked.
            (highlight, openingHex) = (picked, picked);
            dropHexQuery = true;
        }

        // Backlog section 37, built in pass 28c: a page opened or reloaded on a game waits behind the hand-over screen, since whoever is at the screen
        // has not said which side they are. Pass 30: during setup that is the side setting up now, not the side that moves first.
        viewAs = SettingUpSide ?? viewAs;
        if (state is not null && history?.Current is not null && viewAs.Length > 0)
        {
            (handOver, unconfirmed) = (viewAs, true);
        }
    }

    /// <summary>
    /// Another game: nothing chosen for the last one carries over, since its units, weapons, and Locations are not this game's.
    /// </summary>
    private void ChangeGame(ChangeEventArgs args)
    {
        if (busy)
        {
            return;
        }

        gameId = args.Value as string ?? string.Empty;
        handOver = null;
        lastShown.Clear();
        (highlight, openingHex) = (null, null);
        inspectorTab = "selection";

        // Pass 29: the address names the game, so a reload opens it again (behind the hand-over).
        Navigation.NavigateTo(Navigation.GetUriWithQueryParameters(new Dictionary<string, object?> { ["game"] = gameId.Length > 0 ? gameId : null, ["hex"] = null }), replace: true);
        placeEntry = string.Empty;
        nonObChosen.Clear();
        pending = null;
        shownPhase = null;
        ClearPlacements();
        (shownPlan, setupTab, setupDone, setupReview, revealId) = (null, null, null, null, null);
        (theirOutline, swapNote) = (true, null);
        groupsOpened.Clear();
        placeNote = null;
        placeLocation = placeId = placeBore = placeGroup = string.Empty;
        placeHidden = placeConcealed = placeBroken = placeOffBoard = false;
        ClearFire();
        moveUnits.Clear();
        moveTo = string.Empty;
        moveAssault = false;
        moveDoubleTime = false;
        moveMinimum = false;
        moveBypass = string.Empty;
        advanceUnits.Clear();
        advanceTo = string.Empty;
        advanceExit = string.Empty;
        smokeBy = smokeAt = placeDc = placeDcAt = string.Empty;
        ccLocation = string.Empty;
        ClearCloseCombat();
        ResetPanelChoices();
        status = string.Empty;
        Refresh();

        // Referee, pass 28c: another game is opened as the page is, behind the hand-over (backlog section 37).
        viewAs = SettingUpSide ?? viewAs;
        unconfirmed = false;
        if (state is not null && history?.Current is not null && viewAs.Length > 0)
        {
            (handOver, unconfirmed) = (viewAs, true);
        }
    }

    /// <summary>
    /// Keeps the fire choices to what the game still offers: firers that are active units of the firing side in the chosen From
    /// Location, the MGs they possess, and a director among the leaders who may direct them.
    /// </summary>
    private void PruneFire()
    {
        if (state is null || FiringSide is not { } side)
        {
            ClearFire();
            return;
        }

        // A selection the game no longer offers is dropped, so the page never shows one choice and proposes another.
        if (fireFrom.Length > 0 && !FireLocations(side).Contains(fireFrom, StringComparer.Ordinal))
        {
            fireFrom = string.Empty;
        }

        if (fireFrom.Length == 0)
        {
            fireAlso.Clear();
        }
        else
        {
            fireAlso.RemoveAll(at => !FireLocations(side).Contains(at, StringComparer.Ordinal));
        }

        if (fireTarget.Length > 0 && !FireTargets(side).Contains(fireTarget, StringComparer.Ordinal))
        {
            fireTarget = string.Empty;
        }

        var group = FireGroupAt(side).Where(MayFire).Select(unit => unit.Id).ToHashSet(StringComparer.Ordinal);
        fireFirers.IntersectWith(group);
        fireWeapons.IntersectWith(FireWeapons.Select(item => item.Id));
        fireAlone.IntersectWith(fireFirers);
        if (fireDirector.Length > 0 && !FireLeaders(side).Any(unit => unit.Id == fireDirector))
        {
            fireDirector = string.Empty;
        }
    }

