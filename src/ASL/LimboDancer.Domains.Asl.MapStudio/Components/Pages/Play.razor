        var crewState = crew is null ? "" : string.Concat(new[] { Conditions.Pinned, Conditions.Concealed, Conditions.Melee, Conditions.Broken }
            .Where(name => Marked(crew, name)).Select(name => ", crew " + DisplayText.Kind(name)));
        var spotter = state?.MortarSpotters.FirstOrDefault(item => item.Gun == gun.Id)?.Spotter;
        return $"{gun.Id} ({gun.Definition?.Definition}" + (gun.Kind is "asl:light-mortar" or "asl:latw" or "asl:mg" ? $", with {crew?.Id}" + (spotter is null ? "" : $", Spotter {spotter}") : $", facing {facing}")
            + (gun.Kind == "asl:mg" ? ", at an AFV only (A9.61)" + (MgToKillBar(gun) is { } mgBar ? ", none now: " + mgBar : "") : "")
            + (Marked(gun, Conditions.Malfunctioned) ? gun.Kind is "asl:latw" or "asl:mg" ? ", malfunctioned: repair it in the RPh (A9.72)" : ", malfunctioned: Gun repair is not built" : "")
            + (shots is null ? Marked(gun, Conditions.PrepFire) || Marked(gun, Conditions.FinalFire) ? ", fired this Player Turn" : ""
