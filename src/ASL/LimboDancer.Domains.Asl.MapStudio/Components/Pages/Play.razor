            [.. CloseCombatUnits.Where(unit => unit.Side == side).Select(unit => new CloseCombatAttackBuilder.Participant(unit.Id, UnitLabel(unit), IsBroken(unit)))],
            [.. CloseCombatUnits.Where(unit => unit.Side != side).Select(unit => new CloseCombatAttackBuilder.Participant(unit.Id, UnitLabel(unit), IsBroken(unit)))]))];

