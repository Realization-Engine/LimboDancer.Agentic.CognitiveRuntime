            return chosenPlans.Count;
        }
    }

    /// <summary>Whether the card's area a counter stands in lets it set up under "?"; an SSR may forbid it (ruling R19.4).</summary>
    private bool MayConceal(Placement row) => !(SetupCard is { } card && CardGroup(row.Group) is { } found && BoardLocation.TryParse(row.Location, out var at)
        && found.Group.Areas.Any(area => area.Kind != "entry" && area.Concealed == false && ScenarioSetup.Within(card, area, at)));

    /// <summary>The list as the Counters tab shows it (pass 30): stacks on the map, what is not placed yet, and what waits off board.</summary>
    private SetupCounters.Counters CounterModel
    {
        get
        {
            var board = MapLayers?.Board;
            var problems = ProblemKeys;
            var original = ChosenPlan is { } plan ? PlanRows(plan).ToDictionary(row => row.Id, StringComparer.Ordinal) : null;
            SetupPlacementEditor.Choice Named(string id) => placements.FirstOrDefault(other => other.Id == id) is { } other
                ? new(id, $"{PrintedLabel(other)}, {WhereText(other)} ({id})") : new(id, $"{id}, already set up");
            SetupCounters.Row Line(Placement row, bool held)
            {
                var equipment = Library.Vocabulary.IsA(row.Kind, "asl:equipment");
                var onMap = OnMap(row);
                var holders = HolderChoices(row);
                var at = onMap && BoardLocation.TryParse(row.Location, out var located) ? located : null;
                var follows = row is { Role: "manned", Holder: { } mannedBy } && placements.Any(other => other.Id == mannedBy);
                var areas = CardGroup(row.Group) is { } own ? own.Group.Areas : [];
                var levels = at is not null && board is not null && !follows ? LevelsAt(board, at) : [];
                string?[] notes =
                [
                    row.OffBoard && row.Entry is { } entry && areas.Count(area => area.Kind == "entry") > 1 && areas.FirstOrDefault(area => area.Id == entry) is { Turn: { } enterTurn, Edge: { } enterEdge }
                        ? $"enters on Turn {enterTurn} along the {(SetupCard is { } enterCard ? ScenarioCards.Compass(enterCard, enterEdge) : enterEdge)} edge" : null,
                    at is not null && SetupCard is { } ownCard && row.Group is not null && !areas.Any(area => area.Kind != "entry" && ScenarioSetup.Within(ownCard, area, at))
                        ? "outside its group's setup areas" : null,
                    follows ? "stands with its crew" : null,
                    row.Hidden ? "hidden" : null,
                    row.Broken ? "broken" : null,
                    row.BoreSighted is { } sighted ? $"Bore Sighted on {PlaceOf(sighted)}" : null,
                    row.Role == "towed" ? "in tow" : row.Role == "passenger" ? "a Passenger" : null,
                ];
                return new SetupCounters.Row(row.Key, PrintedLabel(row), row.Id)
                {
                    Held = held,
                    Holders = equipment || holders.Count > 0 || row.Holder is not null ? [.. holders.Select(Named)] : null,
                    Holder = row.Holder,
                    HolderLabel = row.Kind == "asl:gun" ? "manned or towed by" : equipment ? "held by" : "aboard",
                    NoHolder = equipment ? "choose" : "on foot",
                    Levels = levels.Count > 1 && at is not null ? (levels.Contains(at.Level) ? levels : [.. levels.Append(at.Level).Order()]) : null,
                    Level = at?.Level ?? 0,
                    Facing = onMap && row.Kind is "asl:gun" or "asl:vehicle" ? row.Facing ?? "east" : null,
                    Concealed = onMap && !equipment && row.Kind is not (UnitKinds.Dummy or "asl:sniper") && MayConceal(row) ? row.Concealed : null,
                    OffBoard = row.Holder is null && !equipment && row.Kind != "asl:sniper" && row.Kind != UnitKinds.Dummy && GroupEnters(row.Group) ? row.OffBoard : null,
                    CanMove = onMap && !follows,
                    Moving = row.Key == pickingKey,
                    Problem = problems.Contains(row.Key),
                    Changed = original is not null && (!original.TryGetValue(row.Id, out var was) || Differs(was, row)),
                    Note = string.Join(", ", notes.Where(note => note is not null)) is { Length: > 0 } said ? said : null,
                };
            }

            // What stands on its own, and under each what it holds, tows, or carries.
            bool Carried(Placement row) => row.Holder is not null && row.Role != "manned";
            var carriedBy = placements.Where(Carried).ToLookup(row => row.Holder!, StringComparer.Ordinal);
            IEnumerable<SetupCounters.Row> Under(Placement row) => carriedBy[row.Id].SelectMany(carried => Under(carried).Prepend(Line(carried, true)));
            IEnumerable<SetupCounters.Row> WithCarried(Placement row) => [Line(row, false), .. Under(row)];
            var standing = placements.Where(row => !Carried(row)).ToArray();
            var placed = standing.Where(row => !row.OffBoard && BoardLocation.TryParse(row.Location, out _)).ToArray();
            var stacks = placed.GroupBy(row => row.Location, StringComparer.Ordinal)
                .OrderBy(stack => BoardLocation.Parse(stack.Key).Board.Value, StringComparer.Ordinal).ThenBy(stack => BoardLocation.Parse(stack.Key).Hex.ToString(), StringComparer.Ordinal)
                .ThenByDescending(stack => BoardLocation.Parse(stack.Key).Level)
                .Select(stack =>
                {
                    var at = BoardLocation.Parse(stack.Key);
                    var levels = board is null ? [at.Level] : LevelsAt(board, at);
                    return new SetupCounters.Stack(stack.Key, PlaceOf(at), levels.Contains(at.Level) ? levels : [.. levels.Append(at.Level).Order()], at.Level,
                        [.. stack.SelectMany(WithCarried)])
                    {
                        Selected = selectedStack == stack.Key,
                        Moving = pickingKey == SetupCounters.StackKey(stack.Key),
                        Swapping = swapFrom is not null && swapFrom == SwapHex(stack.Key),
                    };
                }).ToArray();
            var offBoard = standing.Where(row => row.OffBoard).ToArray();
            var onMapCount = stacks.Sum(stack => stack.Rows.Count);
            var entries = offBoard.Select(row => CardGroup(row.Group) is { } found ? found.Group.Areas.FirstOrDefault(area => area.Kind == "entry" && (row.Entry is null || area.Id == row.Entry)) : null)
                .OfType<ScenarioCardSetup>().Distinct().ToArray();
            var offBoardRows = offBoard.SelectMany(WithCarried).ToArray();

            // What the card says of a limited area, as the gate counts it (ruling R19.4): its counters, its MMC, and "?" where an SSR forbids it.
            var notes = new List<string>();
            var short_ = false;
            if (SetupCard is { } card && SetupView is { } report)
            {
                foreach (var group in report.Groups.Where(group => MaySetUp.Contains(group.Id)))
                {
                    foreach (var area in group.Areas.Where(area => area.Kind != "entry" && (area.Counters is not null || area.Concealed == false)))
                    {
                        var inArea = stacks.Where(stack => ScenarioSetup.Within(card, area, BoardLocation.Parse(stack.Location))).SelectMany(stack => stack.Rows).ToArray();
                        var mmc = placements.Count(row => row.Kind is "asl:squad" or "asl:half-squad" or "asl:crew" && inArea.Any(line => line.Key == row.Key));
                        short_ |= area.Counters is { } owed && inArea.Length < owed && offBoardRows.Length > 0;
                        notes.Add(SetupPoolsTable.AreaText(area) + ": "
                            + (area.Counters is { } limit ? $"{inArea.Length} of {limit} counters on the map (each SW counts as one)"
                                + (area.MinMmc is { } least ? $"; {mmc} MMC, at least {least} needed" : string.Empty) + "."
                                + (inArea.Length < limit && offBoardRows.Length > 0 ? " To set a counter up on the map, untick \"off board\" on it below, then place it." : string.Empty) : string.Empty)
                            + (area.Concealed == false ? " The card allows no \"?\" here, so none is offered." : string.Empty));
                    }
                }

                // The group's "?" (A12.11, A12.12; ruling R19.5): one for each stack under "?", one for each Dummy.
                var allotment = report.Groups.Where(group => MaySetUp.Contains(group.Id)).Sum(group => CardGroup(group.Id)?.Group.Dummies ?? 0);
                var left = report.Groups.Where(group => MaySetUp.Contains(group.Id)).Sum(group => group.DummiesLeft);
                var underConcealment = placements.Where(row => row.Concealed && row.Kind != UnitKinds.Dummy && OnMap(row) && !Library.Vocabulary.IsA(row.Kind, "asl:equipment"))
                    .Select(row => row.Location).Distinct(StringComparer.Ordinal).Count();
                var dummies = placements.Count(row => row.Kind == UnitKinds.Dummy);
                if (allotment > 0 || underConcealment + dummies > 0)
                {
                    notes.Add($"\"?\" used: {allotment - left + underConcealment + dummies} of {allotment} ({Count(underConcealment, "stack", "stacks")} under \"?\", {Count(dummies, "Dummy", "Dummies")}"
                        + (allotment - left > 0 ? $", {allotment - left} already set up" : string.Empty) + ").");
                }
            }

            return new SetupCounters.Counters([.. standing.Where(row => !row.OffBoard && !BoardLocation.TryParse(row.Location, out _)).SelectMany(WithCarried)], stacks,
                [.. placements.Where(row => Carried(row) && placements.All(other => other.Id != row.Holder)).Select(row => Line(row, false))], offBoardRows)
            {
                OnMapSummary = $"{Count(onMapCount, "counter", "counters")} in {Count(stacks.Select(stack => BoardLocation.Parse(stack.Location) with { Level = 0 }).Distinct().Count(), "hex", "hexes")}",
                OffBoardSummary = Count(offBoardRows.Length, "counter", "counters")
                    + (entries is [{ Turn: { } turn, Edge: { } edge }] && SetupCard is { } entered ? $", on Turn {turn} along the {ScenarioCards.Compass(entered, edge)} edge" : string.Empty),
                OffBoardOpen = short_ || offBoardRows.Any(row => row.Problem) || (offBoardRows.Length > 0 && stacks.Length == 0),
                Notes = notes,
                CanPick = board is not null,
            };
        }
    }

    /// <summary>
    /// A click on the map (pass 30): the hex is kept as before. During setup it first ends a swap that waits on a hex (pass 30b); it also fills the Location of the row being picked, at ground level, and
    /// the next row still without a Location is picked next; with no row being picked, a hex that may take the viewer's non-OB "?" is ticked or unticked.
    /// </summary>
    private void PickHex(StudioBoard board, HexFacts? facts)
    {
        highlight = facts is null ? null : GameMaps.LocationOf(board, facts.Index);
        (Picking.Picked, Picking.Serial) = (highlight?.ToString(), Picking.Serial + 1);
        if (highlight is not { } at || state is null || !SetupOpen || handOver is not null)
        {
            return;
        }

        if (swapFrom is not null && SetupMode)
        {
            if (RowsIn(at).Length > 0)
            {
                SwapStacks(board, at.ToString());
            }
            else
            {
                swapNote = "A swap needs another hex that holds counters of your list: click one, or press Esc on the map to cancel.";
            }

            return;
        }

        if (pickingKey is not null && MovePicked(board, at, typed: false))
        {
            return;
        }

        // A hex the list uses selects its stack in the list.
        if (SetupMode && placements.FirstOrDefault(item => OnMap(item) && BoardLocation.TryParse(item.Location, out var there) && (there with { Level = 0 }) == at) is { } used)
        {
            (selectedStack, revealId) = (used.Location, SetupCounters.StackId(used.Location));
        }

        foreach (var side in NonObSides.Where(side => NonObChoices(side).Contains(at)))
        {
            var chosen = $"{side}|{at}";
            Toggle(nonObChosen, chosen, !nonObChosen.Contains(chosen));
        }
    }

    /// <summary>
    /// The stack or the counter being moved goes to a hex (pass 30). From a click it keeps its own level when the hex has that level, else it goes to
    /// the ground, which the page says; a typed Location is taken as typed. A counter placed for the first time hands the picking to the next one not
    /// placed yet, so a group is placed click by click. False when nothing was being moved.
    /// </summary>
    private bool MovePicked(StudioBoard board, BoardLocation at, bool typed)
    {
        if (pickingKey is not { } key)
        {
            return false;
        }

        var whole = key.StartsWith("stack:", StringComparison.Ordinal);
        var moving = placements.Where(item => whole ? OnMap(item) && item.Location == key["stack:".Length..] : item.Key == key && OnMap(item)).ToArray();
        if (moving.Length == 0)
        {
            pickingKey = null;
            return false;
        }

        var levels = LevelsAt(board, at);
        var (lowered, unplaced, last) = (false, false, -1);
        foreach (var row in moving)
        {
            var was = BoardLocation.TryParse(row.Location, out var before) ? before : null;
            var level = typed ? at.Level : was is not null && levels.Contains(was.Level) ? was.Level : 0;
            (lowered, unplaced, last) = (lowered || (!typed && was is not null && was.Level != level), unplaced || was is null, placements.IndexOf(row));
            placements[last] = row with { Location = (at with { Level = level }).ToString() };
            selectedStack = placements[last].Location;
        }

        placeNote = lowered ? $"{PlaceOf(at with { Level = 0 })} has no such level: placed at ground level. Change the level in the list if you mean another." : null;
        pickingKey = !whole && unplaced && last >= 0
            ? placements.Skip(last + 1).Concat(placements.Take(last)).FirstOrDefault(item => OnMap(item) && item.Location.Length == 0 && item.Role != "manned")?.Key : null;
        (shownPlan, revealId) = (null, selectedStack is { } shownStack ? SetupCounters.StackId(shownStack) : null);
        ListChanged();
        return true;
    }

    /// <summary>A Location typed for the stack or the counter being moved: the way to place a counter without the mouse.</summary>
    private void MoveTyped(string text)
    {
        if (MapLayers?.Board is not { } board || !BoardLocation.TryParse(text.Trim(), out var at) || GameMaps.FactsAt(board, at) is null)
        {
            placeNote = $"\"{text.Trim()}\" is not a Location of this map: type it as board, hex, and level, such as bd01:F5:1.";
            return;
        }

        if (MovePicked(board, at, typed: true))
        {
            highlight = at with { Level = 0 };
            ShowActions(scroll: false);
        }
    }

    /// <summary>The sides whose non-OB "?" the viewer may place now (A12.12; ruling R23.6): its own, or both for the adjudicator, once both sides have set up.</summary>
    private IEnumerable<string> NonObSides => state is null || !SetupOpen || history is not { Events.Count: > 0 } || SetupView is { CurrentOrder: not null } ? []
        : state.Sides.Where(side => Viewer.IsAdjudicator || side.Id == viewAs).Select(side => side.Id);

    // The Locations that may take a side's non-OB "?", read once per revision: the fieldset, the map's outlines, and a click all read them.
    private (GameHistory? History, long Revision, Dictionary<string, IReadOnlyList<BoardLocation>> Choices) nonObCache;

    private IReadOnlyList<BoardLocation> NonObChoices(string side)
    {
        if (state is null)
        {
            return [];
        }

        if (nonObCache.Choices is null || !ReferenceEquals(nonObCache.History, history) || nonObCache.Revision != state.Revision)
        {
            nonObCache = (history, state.Revision, new Dictionary<string, IReadOnlyList<BoardLocation>>(StringComparer.Ordinal));
        }

        if (!nonObCache.Choices.TryGetValue(side, out var choices))
        {
            nonObCache.Choices[side] = choices = Live.Planner.NonObConcealment(state, side);
        }

        return choices;
    }

    /// <summary>
    /// The map's marks with the setup's outlines (pass 30): each hex a row of the list names, with how many counters the list puts there, the hex of
    /// the row being picked drawn stronger; and, once both sides have set up, the hexes that may take the viewer's non-OB "?", the ticked ones filled.
    /// They are the viewer's own drafts, so they go with the list at a hand-over.
    /// </summary>
    private string? SetupMarks(StudioBoard board, string? marks)
    {
        if (state is null || !SetupOpen || handOver is not null)
        {
            return marks;
        }

        var extra = new System.Text.StringBuilder();
        if (SetupMode && MaySetUp.Count > 0 && SetupAreaHexes(board) is { Count: > 0 and <= 80 } areaHexes)
        {
            foreach (var at in areaHexes)
            {
                extra.Append(GameMaps.HexMark(board, at, "setup-area", "none", "#3f5a22", 2, true, null));
            }
        }

        foreach (var hex in DraftRows.Where(item => OnMap(item) && BoardLocation.TryParse(item.Location, out _))
            .GroupBy(item => BoardLocation.Parse(item.Location) with { Level = 0 }))
        {
            var picking = hex.Any(item => item.Key == pickingKey);
            extra.Append(GameMaps.HexMark(board, hex.Key, picking ? "setup-draft picking" : "setup-draft", "none", "#a06000", picking ? 6 : 3, false, null));
        }

        // Pass 30b: the plan a response answers, from that plan's public placements as the viewer would see them; never from the game's state.
        if (SetupMode && theirOutline && AnsweredPlan is { } their && PublishedCatalog is { } catalog)
        {
            foreach (var (at, count) in SetupPlanMatch.Footprint(their, catalog))
            {
                extra.Append(GameMaps.HexMark(board, at, "setup-their-plan", "none", "#7a1f6b", 4, true, count.ToString(System.Globalization.CultureInfo.InvariantCulture)));
            }
        }

        foreach (var side in NonObSides)
        {
            foreach (var at in NonObChoices(side))
            {
                var chosen = nonObChosen.Contains($"{side}|{at}");
                extra.Append(GameMaps.HexMark(board, at, chosen ? "setup-non-ob chosen" : "setup-non-ob", chosen ? "#244f77" : "none", "#244f77", 3, true, chosen ? "?" : null));
            }
        }

        return extra.Length == 0 ? marks
            : marks is { Length: > 4 } && marks.EndsWith("</g>", StringComparison.Ordinal) ? $"{marks[..^4]}{extra}</g>" : $"<g id=\"layer-marks\">{extra}</g>";
    }

    /// <summary>Who may hold a row's counter: for a SW the side's units that are not vehicles, for a Gun all of them, for any other unit its vehicles to ride.</summary>
    private IReadOnlyList<string> HolderChoices(Placement placement)
    {
        var equipment = Library.Vocabulary.IsA(placement.Kind, "asl:equipment");
        if (placement.Kind is UnitKinds.Dummy or "asl:sniper" or "asl:vehicle")
        {
            return [];
        }

        bool Fits(string kind) => placement.Kind == "asl:gun" ? !Library.Vocabulary.IsA(kind, "asl:equipment") && kind != UnitKinds.Dummy
            : equipment ? !Library.Vocabulary.IsA(kind, "asl:equipment") && kind is not ("asl:vehicle" or UnitKinds.Dummy or "asl:sniper")
            : kind == "asl:vehicle";
        return [.. placements.Where(item => item.Key != placement.Key && item.Side == placement.Side && Fits(item.Kind)).Select(item => item.Id)
            .Concat(VisibleUnits.Where(unit => unit.Status == InstanceStatus.Active && unit.Side == placement.Side && Fits(unit.Kind)).Select(unit => unit.Id))
            .Distinct(StringComparer.Ordinal)];
    }

    /// <summary>The game's card, or before the game exists the card chosen for it.</summary>
    private ScenarioCard? SetupCard => state?.Scenario is { } playing ? CardRead(playing.Id)?.Card : ChosenCard;

    /// <summary>An OB group of the card by the id a game gives it, with its side.</summary>
    private (ScenarioCardSide Side, ScenarioCardGroup Group)? CardGroup(string? id) => SetupCard is { } card
        ? card.Sides.SelectMany(side => side.Groups.Select((group, index) => (Side: side, Group: group, Id: ScenarioCards.GroupId(side.Side, index))))
            .Where(item => item.Id == id).Select(item => ((ScenarioCardSide, ScenarioCardGroup)?)(item.Side, item.Group)).FirstOrDefault()
        : null;

    private bool GroupEnters(string? id) => CardGroup(id) is { } found && found.Group.Areas.Any(area => area.Kind == "entry");

    /// <summary>
    /// The groups the viewer may set up now (pass 30): its own (any side's for the adjudicator), not out of its sight, in the order setting up now or with
    /// counters still to set up off board.
    /// </summary>
    private IReadOnlySet<string> MaySetUp
    {
        get
        {
            var key = (history, state?.Revision ?? -1, viewAs, handOver, SetupOpen);
            if (maySetUpCache.Set is null || maySetUpCache.Key != key)
            {
                maySetUpCache = (key, ComputeMaySetUp());
            }

            return maySetUpCache.Set!;
        }
    }

    private ((GameHistory? History, long Revision, string View, string? HandOver, bool Open) Key, IReadOnlySet<string>? Set) maySetUpCache;

    private IReadOnlySet<string> ComputeMaySetUp() => state is null || !SetupOpen || history?.Current is null || handOver is not null || SetupView is not { } report
        ? new HashSet<string>()
        : report.Groups.Where(group => (Viewer.IsAdjudicator || group.Side == viewAs) && !Unseen.Contains(group.Id)
            && ((group.SetsUp && !group.Complete && group.Order == report.CurrentOrder) || group.OffBoard.Count > 0)).Select(group => group.Id).ToHashSet(StringComparer.Ordinal);

    /// <summary>
    /// "Set up <group>" (pass 30): one row for each counter the group still owes and the list does not hold yet, with its id, its group, and its
    /// Location when its area is one hex; what enters is set off board. A SW goes to a squad of its own line's area, a Gun to the group's crew or,
    /// off board, in tow of its first vehicle; each is changed in its row. A list filled from a plan is topped up, not replaced: the Balance counter,
    /// for one. The gate checks the setup as it checks any.
    /// </summary>
    private void SetUpGroup(string groupId)
    {
        if (SetupView is not { } report || report.Groups.FirstOrDefault(item => item.Id == groupId) is not { } group || CardGroup(groupId) is not { } found
            || SetupCard is not { } card || PublishedCatalog is not { } catalog || !MaySetUp.Contains(groupId))
        {
            return;
        }

        var held = placements.Where(item => item.Group == groupId && item.Definition is not null).GroupBy(item => item.Definition!, StringComparer.Ordinal)
            .ToDictionary(item => item.Key, item => item.Count(), StringComparer.Ordinal);
        var now = group.SetsUp && !group.Complete && group.Order == report.CurrentOrder;
        var added = new List<(Placement Row, string? Area)>();
        foreach (var (need, offBoard) in (now ? group.Remaining : []).Select(need => (need, false)).Concat(group.OffBoard.Select(need => (need, true))))
        {
            // A limited area owes "counters", not a definition (ruling R19.4): its group's lines are owed off board, and the player moves rows on board.
            if (catalog.Definition(need.Definition) is not { } definition)
            {
                continue;
            }

            var area = found.Group.Areas.FirstOrDefault(item => item.Id == need.Area);
            var board = area?.Board ?? card.Boards[0].Board;
            var facing = definition.Kind is "asl:gun" or "asl:vehicle" ? "east" : null;
            for (var count = 0; count < need.Count; count++)
            {
                // A counter of this definition the list already holds is not added again.
                if (held.GetValueOrDefault(definition.Id) > 0)
                {
                    held[definition.Id]--;
                    continue;
                }

                var id = NewPlacementId(group.Side, definition.Id, added.Select(item => item.Row.Id));
                var at = !offBoard && area is { Kind: "building", Hexes: [var only] } ? $"{board}:{only}:0" : string.Empty;
                var equipment = Library.Vocabulary.IsA(definition.Kind, "asl:equipment");
                added.Add((new Placement(id, definition.Id, definition.Kind, group.Side, at, false, false, null, false, facing, null, groupId, offBoard && !equipment, null,
                    offBoard && !equipment ? need.Area : null) { Auto = true }, need.Area));
            }
        }

        // A SW to a squad, HS, or crew of its own line's area, one each, then round again (A9.1); a Gun to a crew, or off board in tow (C10.1).
        var given = new Dictionary<string, int>(StringComparer.Ordinal);
        var manned = new HashSet<string>(StringComparer.Ordinal);
        for (var index = 0; index < added.Count; index++)
        {
            var (row, area) = added[index];
            if (!Library.Vocabulary.IsA(row.Kind, "asl:equipment"))
            {
                continue;
            }

            if (row.Kind == "asl:gun")
            {
                var towing = group.OffBoard.Any(need => need.Definition == row.Definition);
                var holder = towing ? added.FirstOrDefault(item => item.Row.Kind == "asl:vehicle").Row?.Id
                    : added.FirstOrDefault(item => item.Row.Kind == "asl:crew" && manned.Add(item.Row.Id)).Row?.Id;
                added[index] = (row with { Holder = holder, Role = holder is null ? null : towing ? "towed" : "manned" }, area);
                continue;
            }

            // Squads and half-squads first; a crew takes a SW only when the line's area has no other MMC.
            var squads = added.Where(item => item.Area == area && item.Row.Kind is "asl:squad" or "asl:half-squad").Select(item => item.Row.Id).ToArray();
            squads = squads.Length > 0 ? squads : [.. added.Where(item => item.Area == area && item.Row.Kind == "asl:crew" && !manned.Contains(item.Row.Id)).Select(item => item.Row.Id)];
            if (squads.Length > 0)
            {
                var turn = given.GetValueOrDefault(area ?? string.Empty);
                given[area ?? string.Empty] = turn + 1;
                added[index] = (row with { Holder = squads[turn % squads.Length], Role = "possessed" }, area);
            }
        }

        placements.AddRange(added.Select(item => item.Row));
        placeNote = added.Count == 0 ? $"The list already holds every counter {group.Name} still has to set up." : null;
    }

    /// <summary>"Set up" a group from its button: the list gains what the group owes and lacks, and the Counters tab shows it.</summary>
    /// <summary>How many counters a group still has to set up that the list does not hold yet; its button is offered only while this is more than none.</summary>
    private int GroupLacks(string groupId)
    {
        if (SetupView is not { } report || report.Groups.FirstOrDefault(item => item.Id == groupId) is not { } group || PublishedCatalog is not { } catalog)
        {
            return 0;
        }

        var now = group.SetsUp && !group.Complete && group.Order == report.CurrentOrder;
        return (now ? group.Remaining : []).Concat(group.OffBoard).Where(need => catalog.Definition(need.Definition) is not null)
            .GroupBy(need => need.Definition, StringComparer.Ordinal)
            .Sum(needs => Math.Max(0, needs.Sum(need => need.Count) - placements.Count(row => row.Group == groupId && row.Definition == needs.Key)));
    }

