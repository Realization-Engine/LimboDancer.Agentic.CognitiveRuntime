    /// <summary>Each open vehicle CC Location as the panel reads it (plan C01): the side that attacks next and the units it offers.</summary>
    // Pass 70 (rulings R70.30, R70.31): the units come from the planner's index, Riders with their vehicles, and pass through the side's view.
    private IReadOnlyList<VehicleCloseCombatPanel.CcLocation> VehicleCcRows => state is null ? [] : [.. VehicleCcLocations.Select(location =>
    {
        var (nextSide, _) = Live.Planner.VehicleCloseCombatTurn(state, location);
        var listed = Live.Planner.VehicleCloseCombatUnits(state, location);
        var seen = SeenOnly(listed.Select(item => item.Unit), aboardToo: true).Select(unit => unit.Id).ToHashSet(StringComparer.Ordinal);
        var rides = listed.Where(item => item.Rides is not null && !item.Passenger && seen.Contains(item.Unit.Id)).ToDictionary(item => item.Unit.Id, item => item.Rides!, StringComparer.Ordinal);
        // Pass 70 (ruling R70.34): the Passengers of an unarmored stationary vehicle, which an attack may try to capture (A11.52), each with its vehicle.
        var aboard = listed.Where(item => item.Passenger && seen.Contains(item.Unit.Id)).ToDictionary(item => item.Unit.Id, item => item.Rides!, StringComparer.Ordinal);
        var here = listed.Where(item => seen.Contains(item.Unit.Id)).Select(item => item.Unit).ToArray();
        var entry = state.CloseCombats.FirstOrDefault(item => item.Location == location && !item.Closed);
        var attacked = entry?.Attacking ?? [];
        var infantryAttacked = entry?.InfantryAttacked ?? [];
        static bool Leader(UnitInstance unit) => unit.Kind is "asl:leader" or "asl:hero";
        return new VehicleCloseCombatPanel.CcLocation(location.ToString(), nextSide ?? string.Empty,
            [.. here.Where(unit => unit.Side == nextSide && !LiveFire.IsVehicle(unit) && unit.Kind != UnitKinds.Dummy && !attacked.Contains(unit.Id) && !aboard.ContainsKey(unit.Id)
                && GameState.Condition(unit, Conditions.Broken) != ConditionState.True && GameState.Condition(unit, Conditions.Captured) != ConditionState.True).Select(unit => unit.Id)],
            [.. here.Where(unit => unit.Side == nextSide && Leader(unit) && !rides.ContainsKey(unit.Id) && !aboard.ContainsKey(unit.Id)).Select(unit => unit.Id)],
            // A21.2 (pass 65, the UI review): the planner says, by the plan's own Rules bar, which vehicle a capture attempt may take.
            [.. here.Where(LiveFire.IsVehicle).Select(unit => new VehicleCloseCombatPanel.VehicleChoice(unit.Id, unit.Side, GamePlanner.MayBeCaptureAttempted(unit)))],
            [.. here.Where(unit => !LiveFire.IsVehicle(unit) && unit.Side != nextSide).OrderBy(unit => Leader(unit) ? 0 : 1).Select(unit => unit.Id)])
        {
            Riders = rides,
            Passengers = aboard,
            InfantryAttacked = [.. infantryAttacked],
            VehicleAttackers = here.Where(unit => !LiveFire.IsVehicle(unit)).ToDictionary(unit => unit.Id,
                unit => (IReadOnlyList<string>)[.. here.Where(LiveFire.IsVehicle).Where(vehicle => LiveCloseCombat.VehicleAttackerRefusal(unit, vehicle) is null)
                    .Select(vehicle => vehicle.Id)], StringComparer.Ordinal),
        };
    })];

    /// <summary>
    /// Pass 35: the Locations share one attack draft, so an attack proposed in a Location names only that Location's own units; what was chosen or
    /// checked in another Location stays out of it.
    /// </summary>
    private Task ProposeVehicleCcAt(IReadOnlyList<VehicleCloseCombatPanel.CcLocation> rows, string at, bool byVehicle, bool capture = false)
    {
        if (rows.FirstOrDefault(row => row.Location == at) is not { } row || !row.Vehicles.Any(vehicle => vehicle.Id == vehicleCcVehicle))
        {
            return Task.CompletedTask;
        }

        string[] attackers = byVehicle || !row.Attackers.Contains(vehicleCcAttacker, StringComparer.Ordinal) ? []
            : [vehicleCcAttacker, .. (row.Leaders.Contains(vehicleCcLeader, StringComparer.Ordinal) && vehicleCcLeader != vehicleCcAttacker ? new[] { vehicleCcLeader } : [])];
        if (!byVehicle && attackers.Any(id => row.VehicleAttackers?.GetValueOrDefault(id)?.Contains(vehicleCcVehicle, StringComparer.Ordinal) != true))
        {
            return Task.CompletedTask;
        }
        // Pass 70 (rulings R70.31, R70.34): a vehicle attacks the Infantry on foot; a Rider or a Passenger is attacked by Infantry alone (A11.611, A11.52).
        string[] defenders = byVehicle ? [.. row.Defenders.Where(id => vehicleCcDefenders.Contains(id) && !row.Riders.ContainsKey(id) && !row.Passengers.ContainsKey(id))] : [];
        return attackers.Length == 0 && defenders.Length == 0 ? Task.CompletedTask : ProposeVehicleCc(at, attackers, vehicleCcVehicle, defenders, false, capture);
    }

    /// <summary>
    /// Pass 70 (rulings R70.30, R70.31): the chosen Infantry, with the SMC stacked with it and directing, attack the checked enemy Infantry that no Infantry has
    /// attacked this CCPh, a Rider among either (A11.31, A11.14, A11.141, A11.611). No vehicle is named.
    /// </summary>
    private Task ProposeInfantryCcAt(IReadOnlyList<VehicleCloseCombatPanel.CcLocation> rows, string at, bool capturePassengers = false)
    {
        if (rows.FirstOrDefault(row => row.Location == at) is not { } row || !row.Attackers.Contains(vehicleCcAttacker, StringComparer.Ordinal))
        {
            return Task.CompletedTask;
        }

        var leader = row.Leaders.Contains(vehicleCcLeader, StringComparer.Ordinal) && vehicleCcLeader != vehicleCcAttacker ? vehicleCcLeader : null;
        string[] attackers = [vehicleCcAttacker, .. leader is null ? Array.Empty<string>() : [leader]];
        // Pass 70 (ruling R70.34): the Passengers are attacked only to capture them (A11.52), and the other Infantry by the plain attack.
        string[] defenders = [.. row.Defenders.Where(id => vehicleCcDefenders.Contains(id) && !row.InfantryAttacked.Contains(id, StringComparer.Ordinal)
            && row.Passengers.ContainsKey(id) == capturePassengers)];
        if (defenders.Length == 0)
        {
            return Task.CompletedTask;
        }

        var arguments = new Dictionary<string, object>
        {
            ["gameId"] = gameId,
            ["attemptId"] = Attempt("vehicle-cc"),
            ["expectedRevision"] = (long)history!.Events.Count,
            ["location"] = at,
            ["attackers"] = attackers,
            ["defenders"] = defenders,
        };
        if (capturePassengers)
        {
            arguments["capture"] = true;
        }

        // A11.14, A11.141: a SMC attacking with the MMC is stacked with it, and a leader directs the attack.
        if (leader is not null)
        {
            arguments["stacking"] = new Dictionary<string, string> { [leader] = vehicleCcAttacker };
            if (Live.Planner.UnitOf(state!, leader)?.Kind == "asl:leader")
            {
                arguments["director"] = leader;
            }
        }

        return Propose(GameActions.VehicleCloseCombat, JsonSerializer.SerializeToElement(arguments));
    }

