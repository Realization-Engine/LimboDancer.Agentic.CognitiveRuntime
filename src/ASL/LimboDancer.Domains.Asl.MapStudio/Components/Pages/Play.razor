        {
            ccLocation = string.Empty;
            ClearCloseCombat();
        }

        moveTo = string.Empty;
        moveAssault = false;
        moveDoubleTime = false;
        moveMinimum = false;
        moveBypass = string.Empty;
        vehicleIntended = string.Empty;
        vehicleOverrun = false;
        vehicleAllMp = false;
        vehicleMinimum = false;
        vehicleEsb = string.Empty;
        vehicleLoad.Clear();
        vehicleUnload.Clear();
        hookBoards = false;
        vehicleEntryHex = string.Empty;
        vehicleEntryFacing = string.Empty;
