        gameId, attemptId = Attempt("enter"), expectedRevision = (long)history!.Events.Count, unitId = enterUnit, location = enterLocation.Trim(),
    }));

    /// <summary>The attacker's OVR choice for a pending attempt; an election is refused until step 10.</summary>
    private Task ProposeDeclaration(string unit, string choice) => Propose(GameActions.DeclareOverrun, JsonSerializer.SerializeToElement(new
    {
        gameId, attemptId = Attempt("declare"), expectedRevision = (long)history!.Events.Count, unitId = unit, choice,
    }));

    private async Task Propose(ActionDescriptor action, JsonElement arguments)
    {
        // Plan section 13.4: one request at a time; a second click while the gate works is dropped, not sent twice.
        if (busy)
        {
            return;
        }

        (busy, status) = (true, "Checking the proposal.");
        var asked = AskedBy;
        Proposal proposed;
        try
        {
            arguments = FromView(arguments);
            // Pass 29: the busy state is drawn before the gate is asked, so the pickers show as disabled even when the answer is quick.
            StateHasChanged();
            await DrawBusy();
            var revision = (long)(history?.Events.Count ?? 0);
            proposed = new Proposal(action, arguments, await Run(() => Live.Play.ProposeAsync(action, arguments, Live.Principal)), revision);
        }
        finally
        {
            busy = false;
        }

        // Pass 29: a result that returns for another game or view is dropped, never shown to the view that did not ask.
        if (AskedBy != asked)
        {
            status = string.Empty;
            return;
        }

        pending = proposed;
        status = $"{action.Name}: {(ConsequencesOf(proposed).Count > 0 ? ConsequencesOutcome : OutcomeText(proposed.Result.Outcome, Withheld(proposed)))}";
        ShowProposal();
        Refresh();
    }

    /// <summary>Pass 31 (ruling R31.6): a proposal names the view it comes from, so the planner refuses what that side may not do.</summary>
    private JsonElement FromView(JsonElement arguments)
    {
        var node = System.Text.Json.Nodes.JsonNode.Parse(arguments.GetRawText())!;
        node[GamePlanner.ProposedByArgument] = Viewer.IsAdjudicator ? GamePlanner.AdjudicatorView : viewAs;
        return JsonSerializer.SerializeToElement(node);
    }

    /// <summary>Pass 31 (ruling R31.6): the units the view acts for: its side's, or every unit for the adjudicator.</summary>
    private bool Mine(UnitInstance unit) => Viewer.IsAdjudicator || unit.Side == viewAs;

    /// <summary>Pass 31: whether a weapon is the view's to handle: one its side holds, or one lying unpossessed.</summary>
    private bool Mine(EquipmentInstance weapon) => Viewer.IsAdjudicator || weapon.Holding is not { } holding || state?.Unit(holding.Holder) is not { } holder || holder.Side == viewAs;

    /// <summary>Pass 31 (ruling R31.6): whether the view shown may end the present phase.</summary>
    private bool MayEndPhase => state is not null && (Viewer.IsAdjudicator || GamePlanner.PhaseEndedBy(state, viewAs) == viewAs);

    /// <summary>Pass 31 (ruling R5.8): a choice or a surrender waits for its answer, and nothing else is proposed until it has one.</summary>
    private bool WaitsOnAnswer => state is { } waiting && (waiting.Choice is not null || waiting.PendingSurrenders.Count > 0);

    /// <summary>
    /// Lets the busy state be drawn before the gate is asked (pass 29). A component test that registers <see cref="ImmediateProposals"/> skips the
    /// wait, so the proposal stays on the test's own thread; the Studio never registers it.
    /// </summary>
    private Task DrawBusy() => Services.GetService<ImmediateProposals>() is null ? Yield() : Task.CompletedTask;

    private static async Task Yield() => await Task.Yield();

    /// <summary>Runs a gate call; a failure inside it, such as a reviewed package that no longer verifies, is reported, not thrown.</summary>
    private static async Task<PlayResult> Run(Func<Task<PlayResult>> call)
    {
        try
        {
            return await call();
        }
        catch (InvalidOperationException exception)
        {
            return new PlayResult(PlayOutcome.Failed, new LimboDancer.Abstractions.Runtime.CorrelationId("failed"), ["play.error: " + exception.Message], null);
        }
    }

    private async Task Confirm()
    {
        if (pending is not { } proposal || busy)
        {
            return;
        }

        var created = history is null;
        var placed = PlacesCounters(proposal) && placements.Count > 0
            ? (Sides: string.Join(" and ", placements.Select(row => DisplayText.Side(row.Side)).Distinct(StringComparer.Ordinal)),
                From: ChosenPlan is { } from ? $", from {PlanTitle(from)}" + (PlanChanges.Count > 0 ? $" with {Count(PlanChanges.Count, "change", "changes")}" : string.Empty) : string.Empty)
            : ((string Sides, string From)?)null;

        // Plan section 13.4: after a reconnect, another tab, or another viewer's commit, the game is read again first; a proposal made at another
        // revision is stale and is never confirmed (the gate also refuses it by its expected revision).
        var now = gameId.Length > 0 ? Live.History(gameId) : null;
        if (proposal.Revision is { } proposedAt && (now?.Events.Count ?? 0) != proposedAt)
        {
            pending = proposal with
            {
                Result = proposal.Result with
                {
                    Outcome = PlayOutcome.Stale,
                    Reasons = [$"The game is at revision {now?.Events.Count ?? 0}; this proposal was made at revision {proposedAt}."],
                },
            };
            status = OutcomeText(PlayOutcome.Stale, false);
            Refresh();
            return;
        }

        (busy, status) = (true, "Confirming.");
        var asked = AskedBy;
        PlayResult result;
        try
        {
            StateHasChanged();
            await DrawBusy();
            result = await Run(() => Live.Play.ConfirmAsync(proposal.Action, proposal.Arguments, Live.Principal, proposal.Result.Correlation));
        }
        finally
        {
            busy = false;
        }

        if (AskedBy != asked)
        {
            status = string.Empty;
            Refresh();
            return;
        }

        status = $"{proposal.Action.Name}: {OutcomeText(result.Outcome, false)}";
        pending = proposal with { Result = result };
        if (result.Outcome is PlayOutcome.Committed or PlayOutcome.Replay)
        {
            // A committed action's choices are spent: the next one starts from nothing.
            if (proposal.Action == GameActions.Setup)
            {
                if (PlacesCounters(proposal))
                {
                    ClearPlacements();
                    shownPlan = null;
                }
            }
            else if (proposal.Action == GameActions.Fire)
            {
                ClearFire();
            }
            else if (proposal.Action == GameActions.EndMove)
            {
                moveTo = string.Empty;
                moveAssault = false;
                moveDoubleTime = false;
                moveMinimum = false;
                moveBypass = string.Empty;
            }
            else if (proposal.Action == GameActions.Move)
            {
                // A4.5: Double Time is declared for one step, not kept for the next; so are a Minimum Move and a Bypass.
                moveDoubleTime = false;
                moveMinimum = false;
                moveBypass = string.Empty;
            }
            else if (proposal.Action == GameActions.MoveVehicle)
            {
                // D7.1, B13.41, D2.15, D2.5 (table-player finding, pass 11): an OVR, an ALL entry, a Minimum Move, and ESB are declared for one expenditure.
                vehicleOverrun = false;
                vehicleAllMp = false;
                vehicleMinimum = false;
                vehicleEsb = string.Empty;

                // Rulings R26.1, R26.2: the Passengers chosen and the entry are for one expenditure too.
                vehicleLoad.Clear();
                vehicleUnload.Clear();
                vehicleEntryHex = string.Empty;
                vehicleEntryFacing = string.Empty;
            }
            else if (proposal.Action == GameActions.HookGun)
            {
                hookBoards = false;
            }
            else if (proposal.Action == GameActions.Rally)
            {
                rallyUnit = string.Empty;
                rallyLeader = string.Empty;
            }
            else if (proposal.Action == GameActions.Repair)
            {
                repairWeapon = string.Empty;
            }
            else if (proposal.Action == GameActions.Rout)
            {
                routUnit = string.Empty;
                routRoute = string.Empty;
                routLowCrawl = false;
            }
            else if (proposal.Action == GameActions.Deploy || proposal.Action == GameActions.Recombine)
            {
                deploySquad = deployLeader = string.Empty;
                deployWeapons.Clear();
                recombineOne = recombineTwo = recombineLeader = string.Empty;
            }
            else if (proposal.Action == GameActions.Transfer || proposal.Action == GameActions.Drop || proposal.Action == GameActions.Recover || proposal.Action == GameActions.Dismantle)
            {
                swWeapon = swUnit = string.Empty;
            }
            else if (proposal.Action == GameActions.AdvancePhase)
            {
                retainDm.Clear();
            }
            else if (proposal.Action == GameActions.Advance)
            {
                advanceUnits.Clear();
                advanceTo = string.Empty;
                advanceExit = string.Empty;
            }
            else if (proposal.Action == GameActions.CloseCombat)
            {
                ClearCloseCombatDraft();
            }

            // Table player and UI review, pass 29: Confirm is gone with the commit, so the focus goes to the actions; under 1024px their tab opens.
            // Wider, the panes are side by side and nothing scrolls, so the outcome stays in view.
            ShowActions(scroll: narrow);
        }

        Refresh();

        // UI review, pass 31: the stacking of the Location is read again from the state the round left, not the one it began from.
        if (result.Outcome is PlayOutcome.Committed or PlayOutcome.Replay && proposal.Action == GameActions.CloseCombat)
        {
            DefaultStacking();
        }

        if (result.Outcome is PlayOutcome.Committed or PlayOutcome.Replay && proposal.Action == GameActions.Setup && state is not null)
        {
            // Pass 30: what was set up, and who sets up next, said where the setup bar is.
            if (placed is { } done)
            {
                var onMap = SettingUpSide;
                var next = onMap ?? SetupView?.Groups.FirstOrDefault(group => group.OffBoard.Count > 0)?.Side;
                setupDone = ($"The {done.Sides} setup is in the game{done.From}. "
                    + (next is null ? "Every group has set up. Each side may now place a \"?\" on its stacks out of the enemy's LOS (A12.12), under Counters; the first action of play closes the setup."
                        : onMap is not null ? $"Next: the {DisplayText.Side(next)} side sets up."
                        : $"Next: the {DisplayText.Side(next)} side sets up the counters that enter, off board."), next);
            }

            // Pass 30: a new game's id goes into the address, so a reload opens it again; and when a side sets up next, the game opens behind that
            // side's hand-over (ruling R23.2), as a game opened later does. A card with no OB group has no side setting up, and stays in the view.
            if (created)
            {
                Navigation.NavigateTo(Navigation.GetUriWithQueryParameters(new Dictionary<string, object?> { ["game"] = gameId, ["hex"] = null }), replace: true);
                if (SettingUpSide is { } settingUp)
                {
                    viewAs = settingUp;
                    (handOver, unconfirmed) = (viewAs, true);
                }
            }
        }
    }

    private static string Attempt(string kind) => $"{kind}-{Guid.NewGuid():N}"[..(kind.Length + 13)];

    /// <summary>
    /// Pass 31 (play test P-06, P-12, P-13): the consequences among the reasons the view may read, while the proposal waits for Confirm. They are
    /// taken from the reasons already disclosed to the view, so nothing more is shown than the reasons themselves would show.
    /// </summary>
    private IReadOnlyList<PlanConsequence> ConsequencesOf(Proposal proposal)
    {
        // UI review, pass 31: read once for a proposal's result, not at each use in a render.
        if (!ReferenceEquals(consequencesFor, proposal.Result))
        {
            (consequencesFor, consequences) = (proposal.Result, proposal.Result.Outcome != PlayOutcome.NeedsConfirmation ? []
                : [.. ReviewReasons(proposal).Select(GamePlanner.ConsequenceOf).OfType<PlanConsequence>()]);
        }

        return consequences;
    }

    private PlayResult? consequencesFor;
    private IReadOnlyList<PlanConsequence> consequences = [];

    private const string ConsequencesOutcome = "Every check passed, with consequences: read them first. Confirm to commit.";

    /// <summary>The Confirm button's words for a proposal with consequences: the gravest kind is named.</summary>
    private static string ConfirmLabel(IReadOnlyList<PlanConsequence> consequences)
    {
        var losses = consequences.Count(item => item.Kind == ConsequenceKind.Loss);
        return losses > 0 ? $"Confirm: {losses} {(losses == 1 ? "unit is" : "units are")} lost"
            : consequences.Any(item => item.Kind == ConsequenceKind.End) ? "Confirm and end the game"
            : consequences.Any(item => item.Kind == ConsequenceKind.OwnUnits) ? "Confirm and fire on your own units"
            : consequences.Any(item => item.Kind == ConsequenceKind.Waste) ? "Confirm the shot with no LOS"
            : "Confirm";
    }

    private static string OutcomeText(PlayOutcome outcome, bool withheld) => outcome switch
    {
        PlayOutcome.NeedsConfirmation when withheld => "The entry is declared. Confirm to commit it and resolve what it finds.",
        PlayOutcome.NeedsConfirmation => "Every check passed. Confirm to commit.",
        PlayOutcome.Committed => "Committed through the Execution Gate.",
        PlayOutcome.Replay => "Already committed by this attempt; nothing changed.",
        PlayOutcome.Stale => "Stale: the game moved on since the proposal. Propose again.",
        PlayOutcome.Denied => "Refused by the gate.",
        _ => "Failed.",
    };
    // ---- Pass 28c: the workspace (plan sections 11.1, 13.1, 13.4, 14) ----

    /// <summary>Whether the Studio window is narrow (under 1024px), from the layout; the workspace then shows labelled tabs.</summary>
    [CascadingParameter(Name = "StudioNarrow")]
    public bool StudioNarrow { get; set; }

    private bool narrow => StudioNarrow;

    private string paneTab = "map";

    private BoardWorkspace? workspace;

    // The inspector's open tab: "proposal" while a proposal waits, otherwise what the player chose (pass 29).
    private string inspectorTab = "selection";

    // The hex the address asks for (from the board viewer's "Back to Play"), kept until the hand-over on load is confirmed.
    private LimboDancer.Domains.Asl.Maps.Coordinates.BoardLocation? openingHex;

    /// <summary>The review pane's attributes, as the inspector of the workspace (pass 29).</summary>
    private Dictionary<string, object> ReviewAttributes => new()
    {
        ["id"] = "play-panel-review",
        ["aria-label"] = "Review",
        ["aria-busy"] = busy ? "true" : "false",
        ["tabindex"] = "-1",
        ["hidden"] = narrow && paneTab != "map",
    };

    /// <summary>The map pane's attributes: its tab panel or region, and the map's source.</summary>
    private Dictionary<string, object> MapAttributes(string? source)
    {
        var attributes = Pane("map", "Map");
        attributes["id"] = "play-panel-map";
        attributes["tabindex"] = "-1";
        attributes["data-source"] = source ?? string.Empty;
        return attributes;
    }
    private ElementReference actionsPane;
    private bool focusReview;
    private IJSObjectReference? workspaceScript;
    private bool focusActions;
    private bool focusMap;

    // Whether the pane takes the focus without being scrolled to.
    private bool focusInPlace;

    // Whether the hand-over waiting is the one of a load or a game change, which only a confirmation ends (referee, pass 29).
    private bool unconfirmed;

    // Whether the address still carries the hex of "Back to Play"; it is taken out once read, so a reload or another view does not pick it again.
    private bool dropHexQuery;
    private bool busy;
    private string status = string.Empty;

    private static readonly IReadOnlyList<InspectorTabs.Tab> PaneTabs =
        [new("map", "Map"), new("actions", "Actions"), new("activity", "Activity")];

    /// <summary>A pane's attributes: under 1024px a tab panel, hidden unless its tab is chosen, so it keeps its state; wider, a named region.</summary>
    private Dictionary<string, object> Pane(string tab, string title) => narrow
        ? new() { ["role"] = "tabpanel", ["aria-labelledby"] = InspectorTabs.TabFor("play", tab), ["hidden"] = paneTab != tab }
        : new() { ["aria-label"] = title };

    /// <summary>The context line: the revision, turn, phase, and phasing side, and whether setup is open; null with no game shown.</summary>
    private string? ContextSummary => state is null || history is null ? null
        : (history.Current is not null ? string.Empty : "The game does not replay: ") + $"Turn {state.Turn}{TurnsText}, {DisplayText.Side(state.PhasingSide)} {Games.PhaseLabel(state.Phase)}."
            + (SetupOpen ? " Setup is open." : state.Ended is not null ? " The game has ended; nothing more is played." : string.Empty);

    /// <summary>Pass 31 (play test P-08): the card's count of Game Turns beside the turn, and a word when the turn is the last (A3.9; ruling R20.1).</summary>
    private string TurnsText => state?.Scenario is { } scenario && CardRead(scenario.Id)?.Card?.Turns is { } turns
        ? $" of {turns.Count}" + (state.Ended is null && state.Turn >= turns.Count ? turns.HalfTurn ? " (the last turn, one Player Turn)" : " (the last turn)" : string.Empty)
        : string.Empty;

    /// <summary>Pass 31 (play test P-08; the user, 2026-10-04): the ended game's result in a few words; null while the game is played.</summary>
    private string? ResultTitle => state?.Ended is not { } ended ? null
        : ended.Result is not { } result ? "The game has ended with no result decided."
        : result.Winner is { } winner ? $"{DisplayText.Side(winner)} win." : "A draw.";

    private string? ResultReason => state?.Ended is not { } ended ? null
        : ended.Result is { } result ? Sentence(result.Reason)
        : "This card's Victory Conditions are text only, so the game does not decide the result; read them on the card (A26).";

    /// <summary>Every Victory condition with whether it was met, then the facts the result rests on.</summary>
    private IReadOnlyList<string> ResultWhy => state?.Ended is not { Result: { } result } ? []
        : [.. (VictoryNow?.Conditions ?? []).Select(line => $"{(line.Winner == "draw" ? "A condition for a draw" : $"A condition for a {DisplayText.Side(line.Winner)} win")}, {(line.Holds ? "met" : "not met")}: {line.Text}."),
            .. result.Facts.Select(Sentence)];

    private static string Sentence(string text) => text.Length == 0 ? text : char.ToUpperInvariant(text[0]) + text[1..] + (text.EndsWith('.') ? string.Empty : ".");

    /// <summary>
    /// The side whose answer or turn the game waits for, when it is not the shown view (backlog section 37): a choice's side, a surrender's captors,
    /// the DEFENDER after a step or in the DFPh, otherwise the phasing side. Null for the adjudicator, in setup, after the end, or during a hand-over.
    /// </summary>
    private string? AwaitingView
    {
        get
        {
            if (state is null || history?.Current is null || state.Ended is not null || SetupOpen || Viewer.IsAdjudicator || handOver is not null)
            {
                return null;
            }

            var waiting = Awaiting(state).Side;
            return waiting is { Length: > 0 } && waiting != viewAs && state.Perspectives.Any(perspective => perspective.Name == waiting) ? waiting : null;
        }
    }

    private string AwaitingNote => state is null ? string.Empty : Awaiting(state).Note;

    /// <summary>What the shown view does now, when the game waits on no other view (table player, pass 28c); null otherwise.</summary>
    private string? ActingNote => state is null || history?.Current is null || state.Ended is not null || SetupOpen || Viewer.IsAdjudicator || handOver is not null
        || AwaitingView is not null ? null : $"You act: {Awaiting(state).Note}";

    /// <summary>Where the moving stack is, which the DEFENDER sees as units or a "?" (A8.1); null when no stack moves.</summary>
    private BoardLocation? MovingAt => state?.Movement switch
    {
        { Members: [var first, ..] } => state.Location(first)?.Location,

        // Pass 31 (play test P-01; ruling R25.7): fire that broke, pinned, or eliminated every mover leaves the window open at the stack's Location, so
        // the DEFENDER still fires at it or passes, and the pass ends the move.
        { WindowOpen: true } stopped => stopped.Location,
        _ => null,
    };

    /// <summary>Pass 31 (play test P-01): the moving stack has no member left able to move, and the DEFENDER's window on it is still open.</summary>
    private bool MoveStopped => state?.Movement is { WindowOpen: true, Members.Count: 0 };

    private (string? Side, string Note) Awaiting(GameState shown)
    {
        var defender = shown.Sides.FirstOrDefault(side => side.Id != shown.PhasingSide)?.Id;
        if (shown.Choice is { } choice)
        {
            return (choice.Side, $"The {DisplayText.Side(choice.Side)} side has a choice to make before play goes on.");
        }

        if (shown.PendingSurrenders.FirstOrDefault() is { } surrender
            && surrender.Captors.Select(shown.Unit).OfType<UnitInstance>().Select(unit => unit.Side).FirstOrDefault() is { } captors)
        {
            return (captors, $"The {DisplayText.Side(captors)} side answers a surrender (A20.21).");
        }

        if (shown.Phase == "mph" && shown.Movement is { WindowOpen: true })
        {
            return (defender, "The DEFENDER may fire at the moving stack or pass (A8.1).");
        }

        if (shown.Phase == "dfph")
        {
            return (defender, $"The {DisplayText.Side(defender)} side may fire, then ends the {Games.PhaseLabel(shown.Phase)}.");
        }

        if (shown.Phase is "rph" or "rtph" or "ccph")
        {
            var other = viewAs == shown.PhasingSide ? defender : shown.PhasingSide;
            return (other, $"Both sides act in the {Games.PhaseLabel(shown.Phase)}, the {DisplayText.Side(shown.PhasingSide)} side first.");
        }

        return (shown.PhasingSide, $"The {DisplayText.Side(shown.PhasingSide)} side acts in the {Games.PhaseLabel(shown.Phase)}.");
    }

    private void HandOverToAwaiting()
    {
        if (AwaitingView is { } next)
        {
            // Pass 31: the arriving view opens on the Location the game waits on, which both sides know.
            var at = MovingAt;
            ChangeView(next);
            if (handOver == next)
            {
                openingHex = at;
            }
        }
    }

    // ---- Pass 31: the hand-over screen (ruling R31.7). Everything below is made of what both sides know: it names no unit, and reads only the
    // events no view is kept from. ----

    /// <summary>The revision each view was last shown at in this session; a view not yet shown has none.</summary>
    private readonly Dictionary<string, long> lastShown = new(StringComparer.Ordinal);

    private string? HandOverWhen => handOver is null || state is null || history?.Current is null ? null
        : SetupOpen ? "Setup is open."
        : state.Ended is not null ? $"The game has ended. {ResultTitle} {ResultReason}"
        : $"Turn {state.Turn}{TurnsText}, {DisplayText.Side(state.PhasingSide)} {Games.PhaseLabel(state.Phase)}.";

    /// <summary>Whether the view waiting behind the hand-over is the one the game waits for.</summary>
    private bool HandOverAwaited => handOver is { } next && state is { Ended: null } && !SetupOpen
        && (Awaiting(state).Side == next

            // Table player, pass 31: in the phases where both sides act, either side that arrives has something to do.
            || (state.Phase is "rph" or "rtph" or "ccph" && state.Choice is null && state.PendingSurrenders.Count == 0 && state.Sides.Any(side => side.Id == next)));

    private string? HandOverWhy => handOver is null || state is null || history?.Current is null || state.Ended is not null ? null
        : state.Perspectives.FirstOrDefault(perspective => perspective.Name == handOver) is { IsAdjudicator: true } ? "The adjudicator's view shows the whole game."
        : SetupOpen ? "A side sets up out of the other's sight."
        : !HandOverAwaited ? "The game does not wait on this side now; its view is opened to look."
        : state.Phase == "mph" && state.Movement is { WindowOpen: true } moving
            ? $"A {DisplayText.Side(state.PhasingSide)} stack {(moving.Members.Count == 0 ? "was stopped by fire" : "spent MF")} in {PlaceOf(moving.Location)}. The {DisplayText.Side(handOver)} side, as the DEFENDER, may fire at it or pass (A8.1)."
        : Awaiting(state).Note;

    private IReadOnlyList<string> HandOverTasks
    {
        get
        {
            if (handOver is not { } next || state is null || history?.Current is null || state.Ended is not null || SetupOpen
                || state.Perspectives.FirstOrDefault(perspective => perspective.Name == next) is { IsAdjudicator: true })
            {
                return [];
            }

            if (!HandOverAwaited)
            {
                return ["Look at your view; the game waits on the other side."];
            }

            var phase = Games.PhaseLabel(state.Phase);
            var ends = GamePlanner.PhaseEndedBy(state, next) == next;
            return state.Choice is not null ? ["Answer the choice the game waits on; nothing else is proposed until it is answered."]
                : state.PendingSurrenders.Count > 0 ? ["Take the surrendering unit prisoner, refuse it, or free it (A20.21)."]
                : state.Phase == "mph" && state.Movement is { WindowOpen: true } moving
                    ? [$"Fire at the moving stack in {PlaceOf(moving.Location)} with your units that see it, or pass.", "Hand the screen back once you have passed."]
                : state.Phase switch
                {
                    "rph" => ["Rally your broken units, repair weapons, and transfer or recover SW.", "End the Rally Phase when both sides are done, or hand the screen back."],
                    "rtph" => ["Rout each of your broken units that must rout; a unit that must and does not is eliminated or surrenders.", "End the Rout Phase when both sides are done, or hand the screen back."],
                    "ccph" => ["Declare your Close Combat attacks in each Location, then hand over; a round is resolved once both sides have declared.", "End the Close Combat Phase when every Location is resolved."],
                    "dfph" => ["Fire with your units as Final Fire; a unit marked First Fire may still fire at an ADJACENT enemy, as Area Fire (A8.4).", $"End the {phase}."],
                    "pfph" => ["Fire with the units you will not move this turn.", $"End the {phase}."],
                    "mph" => ["Move your stacks one at a time; after each Location entered the DEFENDER may fire.", $"End the {phase} when no more units move."],
                    "afph" => ["Fire with the units that did not Prep Fire, at half FP; Opportunity Firers fire at full FP (A7.24, A7.25).", $"End the {phase}."],
                    "aph" => ["Advance your units one Location; an advance into an enemy Location brings Close Combat.", $"End the {phase}."],
                    _ => ends ? [$"Act in the {phase}, then end it."] : [$"Act in the {phase}."],
                };
        }
    }

    private string HandOverHappenedTitle => handOver is { } next && lastShown.ContainsKey(next) ? $"What has happened since {ViewLabel(next)} last had the screen" : "The latest that both sides know";

    /// <summary>
    /// What happened, oldest first, since the waiting view was last shown, or the latest when it has not been shown: only events no view is kept
    /// from, in words that name no unit, so both sides read the same lines.
    /// </summary>
    private IReadOnlyList<string> HandOverHappened
    {
        get
        {
            if (handOver is not { } next || state is null || history?.Current is null || SetupOpen)
            {
                return [];
            }

            var since = lastShown.TryGetValue(next, out var shown) ? shown : -1;

            // UI review, pass 31: read once for a history, a waiting view, and a starting revision, not on every render of the screen.
            if (ReferenceEquals(happenedFor.History, history) && happenedFor.Next == next && happenedFor.Since == since)
            {
                return happened;
            }

            happenedFor = (history, next, since);
            return happened = ReadHappened(since);
        }
    }

    private (GameHistory? History, string? Next, long Since) happenedFor;
    private IReadOnlyList<string> happened = [];

    // Pass 31c (design D16): the Locations the lines of what happened name, for the outlines of the hand-over screen's map.
    private IReadOnlyList<BoardLocation> happenedAt = [];

    /// <summary>The board of the game's map, for the hand-over screen's terrain; read without any view's counters.</summary>
    private StudioBoard? HandOverBoard => state is null ? null : MapLayers?.Board;

    /// <summary>What the page knows of a hex beyond its counters, for the Selection tab: Residual FP (A8.2), which is public, and a Melee the view holds a unit of.</summary>
    private IReadOnlyList<string> HexNotes(HexFacts facts)
    {
        if (state is null || MapLayers?.Board is not { } board || !BoardLocation.TryParse(board.LocationOf(facts), out var hex))
        {
            return [];
        }

        bool Here(BoardLocation at) => at.Board == hex.Board && at.Hex == hex.Hex;
        return [.. state.ResidualFire.Where(item => Here(item.Location)).Select(item => $"{item.Fp} Residual FP in {PlaceOf(item.Location)} (A8.2)"),
            .. VisibleUnits.Where(unit => GameState.Condition(unit, Conditions.Melee) == ConditionState.True && state.Location(unit.Id)?.Location is { } at && Here(at))
                .Select(unit => state.Location(unit.Id)!.Location).Distinct().Select(at => $"Melee in {PlaceOf(at)} (A11.15)")];
    }

    private IReadOnlyList<string> ReadHappened(long since)
    {
        {
            var state = this.state!;
            var lines = new List<(string Text, int Count, BoardLocation[] At)>();
            var named = Array.Empty<BoardLocation>();
            void At(params string?[] locations) => named = [.. locations.Select(text => BoardLocation.TryParse(text, out var at) ? at with { Level = 0 } : null).OfType<BoardLocation>()];
            foreach (var item in history!.Events.Where(item => item.Visibility is null && (since < 0 || item.Revision > since)))
            {
                var line = item.Payload switch
                {
                    PhaseChanged phase => $"{DisplayText.Side(phase.PhasingSide)} {Games.PhaseLabel(phase.Phase)}, Turn {phase.Turn}.",
                    MovementStepped step => $"A stack moved into {PlaceOf(step.To)}.",
                    AdvanceMoved advance => $"Units advanced into {PlaceOf(advance.To)}.",
                    RoutStepped rout => $"A broken unit routed to {PlaceOf(rout.To)}.",
                    FireResolved fire when fire.Resolution.Deserialize<FireResolution>(LiveFire.Json) is { Arithmetic: { } arithmetic }
                        => $"Fire from {PublicLocation(fire.FirerLocation)} at {PublicLocation(fire.TargetLocation)}: {arithmetic.Result}.",
                    FireReported report when report.Arithmetic.Deserialize<FireArithmetic>(LiveFire.Json) is { } reported
                        => $"Fire from {PublicLocation(report.FirerLocation)} at {PublicLocation(report.TargetLocation)}: {reported.Result}.",
                    CloseCombatResolved combat => $"A round of Close Combat in {PlaceOf(combat.Location)}.",
                    InstanceEliminated gone when state.Unit(gone.Id) is { } unit && unit.Kind != UnitKinds.Dummy => $"A {DisplayText.Side(unit.Side)} unit was eliminated.",
                    InstanceCaptured taken when state.Unit(taken.Id) is { } prisoner => $"A {DisplayText.Side(prisoner.Side)} unit was captured.",
                    GameEnded => "The game ended.",
                    _ => null,
                };
                if (line is null)
                {
                    continue;
                }

                named = [];
                switch (item.Payload)
                {
                    case MovementStepped moved: At(moved.To.ToString()); break;
                    case AdvanceMoved advanced: At(advanced.To.ToString()); break;
                    case RoutStepped routed: At(routed.To.ToString()); break;
                    case FireResolved fired: At(fired.FirerLocation, fired.TargetLocation); break;
                    case FireReported reportedFire: At(reportedFire.FirerLocation, reportedFire.TargetLocation); break;
                    case CloseCombatResolved fought: At(fought.Location.ToString()); break;
                }

                // Table player, pass 31: the same thing several times in a row is counted, not dropped.
                if (lines.Count > 0 && lines[^1].Text == line)
                {
                    lines[^1] = (line, lines[^1].Count + 1, lines[^1].At);
                }
                else
                {
                    lines.Add((line, 1, named));
                }
            }

            // The map outlines the Locations of the lines shown, and no others.
            happenedAt = [.. lines.TakeLast(since < 0 ? 6 : 30).SelectMany(item => item.At).Distinct()];

            // With nothing to count from, the latest few; otherwise everything since, capped so the screen stays a screen.
            return [.. lines.TakeLast(since < 0 ? 6 : 30).Select(item => item.Count == 1 ? item.Text : $"{item.Text} ({item.Count} times)")];
        }
    }

    private string PublicLocation(string location) => BoardLocation.TryParse(location, out var at) ? PlaceOf(at) : location;

    /// <summary>Each side's CVP and Exit VP, which both sides know (A26.2); Control and the unbroken squad counts may be read differently by each side, so they are left out.</summary>
    private string? HandOverScore => handOver is null || state is null || history?.Current is null || SetupOpen || VictoryNow is not { } standing ? null
        : "Score: " + string.Join("; ", standing.Sides.Select(side => $"{DisplayText.Side(side.Side)} {side.Cvp} CVP, {side.ExitVp} Exit VP")) + ".";

    private void FocusReview() => ShowProposal();

    /// <summary>The actions brought into view with the focus; under 1024px their tab opens (pass 29).</summary>
    private void ShowActions(bool scroll = true)
    {
        (focusActions, focusInPlace) = (true, !scroll);
        if (narrow)
        {
            paneTab = "actions";
        }
    }

    // Pass 31c (design D15): the panel open over the activity strip: "records", "units", "dice", "audit", or none.
    private string? activityTab;

    private IEnumerable<(string Key, string Label, string Panel)> ActivityTabs =>
    [
        ("records", "Records, latest first", "play-history"),
        ("units", "Units", "play-units-panel"),
        .. Scripted is null ? Array.Empty<(string, string, string)>() : [("dice", "Scripted dice", "play-dice-panel")],
        .. Viewer.IsAdjudicator ? [("audit", "Audit", "play-audit-panel")] : Array.Empty<(string, string, string)>(),
    ];

    private void CancelProposal()
    {
        if (!busy)
        {
            (pending, status) = (null, string.Empty);
            ShowActions(scroll: narrow);
        }
    }

    /// <summary>
    /// A hex named off the map (the units table, "Show it on the map") is picked and shown: the map comes into view, under 1024px in its tab, and
    /// the Selection tab opens unless a proposal waits for Confirm (table player, pass 29).
    /// </summary>
    private void LocateHex(BoardLocation at)
    {
        (highlight, focusMap) = (at, true);
        if (narrow)
        {
            paneTab = "map";
        }

        if (!AwaitingConfirm)
        {
            inspectorTab = "selection";
        }
    }

    /// <summary>What a map click picked while Confirm waits and the Proposal tab stays open; the counters are those the view draws.</summary>
    private string? PickedNote => AwaitingConfirm && highlight is { } at && MapLayers is { Board: { } board, Overlay: { } overlay } && GameMaps.FactsAt(board, at) is { } facts
        ? $"Picked: {PlaceOf(at)}, {overlay.At(facts.Index).Count() switch { 0 => "no counters", 1 => "1 counter", var count => $"{count} counters" }}; the Selection tab has its details."
        : null;

    /// <summary>Closes the scenario card and returns the focus to the context's link that opened it (Claude Design's review).</summary>
    private async Task CloseCard()
    {
        try
        {
            workspaceScript ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/playWorkspace.js");
            await workspaceScript.InvokeVoidAsync("closeDetails", "play-card", "play-card-link");
        }
        catch (Exception exception) when (exception is JSDisconnectedException or JSException or TaskCanceledException)
        {
            // The circuit is gone; the card stays as it was.
        }
    }

    /// <summary>Opens the scenario card, which starts closed, and brings it into view (pass 29).</summary>
    private async Task OpenCard()
    {
        try
        {
            workspaceScript ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/playWorkspace.js");
            await workspaceScript.InvokeVoidAsync("openDetails", "play-card");
        }
        catch (Exception exception) when (exception is JSDisconnectedException or JSException or TaskCanceledException)
        {
            // The circuit is gone; the card stays as it was.
        }
    }

    /// <summary>The Proposal tab chosen and brought into view with the focus; under 1024px it is in the Map tab (pass 29).</summary>
    private void ShowProposal()
    {
        (focusReview, inspectorTab) = (true, "proposal");
        if (narrow)
        {
            paneTab = "map";
        }
    }

    /// <summary>The game and the view a gate call is made for; a result returning for others is dropped (pass 29).</summary>
    private string AskedBy => $"{gameId}/{handOver ?? viewAs}";

    /// <summary>Whether a proposal waits for Confirm, so its tab is marked and stays open when the map is clicked (pass 29).</summary>
    private bool AwaitingConfirm => pending?.Result.Outcome == PlayOutcome.NeedsConfirmation;

    private ElementReference reviewFallback;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Plan section 14: a new proposal takes the focus to its review; a confirmed hand-over takes it to the actions (backlog section 37).
        try
        {
            if (firstRender)
            {
                workspaceScript ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/playWorkspace.js");
                await workspaceScript.InvokeVoidAsync("watchContext");
            }

            if (dropHexQuery)
            {
                dropHexQuery = false;
                Navigation.NavigateTo(Navigation.GetUriWithQueryParameter("hex", (string?)null), replace: true);
            }

            if (revealId is { } shownId)
            {
                revealId = null;
                workspaceScript ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/playWorkspace.js");
                await workspaceScript.InvokeVoidAsync("revealId", shownId);
            }

            if (focusReview || focusActions || focusMap)
            {
                var pane = focusReview ? workspace?.Inspector ?? reviewFallback : focusMap ? workspace?.Stage ?? default : actionsPane;
                // Pass 31c (design D15): from 1024px every pane is in view, so the focus moves and nothing scrolls; the narrow layout still scrolls.
                var scroll = narrow && (focusReview || focusMap || !focusInPlace);
                (focusReview, focusActions, focusMap, focusInPlace) = (false, false, false, false);
                workspaceScript ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/playWorkspace.js");
                await workspaceScript.InvokeVoidAsync("reveal", pane, scroll);
            }
        }
        catch (Exception exception) when (exception is JSDisconnectedException or JSException or TaskCanceledException)
        {
            // The element was not rendered (no game shown) or the circuit is gone: focus stays where it was.
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (workspaceScript is not null)
            {
                await workspaceScript.InvokeVoidAsync("unwatchContext");
                await workspaceScript.DisposeAsync();
            }
        }
        catch (Exception exception) when (exception is JSDisconnectedException or JSException or TaskCanceledException)
        {
            // The circuit is gone; the browser already dropped the module.
        }
    }

    // The map's layers, read once per game, revision, view, and the Gun whose Covered Arc is drawn (backlog section 37: the map was drawn on every
    // render). Pass 29: the workspace draws the picked hex and the LOS line itself.
    private (string Game, long Revision, string Viewer, string Gun, GameMapLayers? Layers) mapCache;

    private GameMapLayers? MapLayers
    {
        get
        {
            if (state is null || history?.Current is null)
            {
                return null;
            }

            if (mapCache.Layers is null || mapCache.Game != gameId || mapCache.Revision != state.Revision || mapCache.Viewer != Viewer.Name
                || mapCache.Gun != ordnanceGun)
            {
                mapCache = (gameId, state.Revision, Viewer.Name, ordnanceGun, GameMaps.Layers(gameId, state.Map, Viewer, state.Revision, CoveredArcLayer,
                    state.ResidualFire));
            }

            return mapCache.Layers;
        }
    }

    // Pass 31b (task 31b.2): the records are read by PlayRecords, for the history, the view, and the game's last revision, once for the three; the
    // Replay page reads the same records for a step.
    private PlayRecords? recordsCache;

    // Pass 31c (design D11): the view's words for a text of the game as it stands: a unit's name for its id (a unit the view does not hold
    // reads "a concealed unit"), a counter for its definition, a Location in words. Made once for a history and a view.
    private (GameHistory? History, string Viewer, Func<string, string> Say) wordsCache = (null, string.Empty, static text => text);

    private Func<string, string> Words
    {
        get
        {
            if (history is null)
            {
                return static text => text;
            }

            if (!ReferenceEquals(wordsCache.History, history) || wordsCache.Viewer != Viewer.Name)
            {
                var names = Live.NamesOf(history, Viewer);
                var before = (long)history.Events.Count;
                wordsCache = (history, Viewer.Name, text => names.InText(text, before));
            }

            return wordsCache.Say;
        }
    }

    // Pass 31c (design D13): the field armed to take the next hex clicked on the map, shared with every typed Location of the actions.
    private LocationPicking? picking;

    private LocationPicking Picking => picking ??= new LocationPicking
    {
        Boards = () => state is null ? [] : [.. state.Map.Boards.Select(placed => placed.Board.Value)],
        Levels = location => MapLayers?.Board is { } board && BoardLocation.TryParse(location, out var at) ? LevelsAt(board, at) : [0],
        Arm = (id, label) =>
        {
            (picking!.Armed, picking.ArmedLabel) = (id, label);
            StateHasChanged();
        },
    };

    /// <summary>A Location as the game writes it (pass 31c, design D12): "G4, level 1" on a map of one board.</summary>
    private string PlaceOf(BoardLocation at) => DisplayText.Place(state?.Map.Boards.Count ?? 2, at);

    private string PlaceOf(string at) => DisplayText.Place(state?.Map.Boards.Count ?? 2, at);

    /// <summary>A status or note in the view's words, without the code at its head.</summary>
    private string? Said(string? text) => text is null ? null : DisplayText.Sentence(Words(DisplayText.Reason(text).Text));

    private PlayRecords? Records
    {
        get
        {
            if (history is null)
            {
                return null;
            }

            if (recordsCache is null || !ReferenceEquals(recordsCache.History, history) || recordsCache.Viewer.Name != Viewer.Name || recordsCache.Last != history.Events.Count)
            {
                recordsCache = new PlayRecords(history, Viewer, history.Events.Count, Live.NamesOf(history, Viewer));
            }

            return recordsCache;
        }
    }

    private IReadOnlyList<DiceRollHistory.Row> RollRows => Records?.RollRows ?? [];

    private IReadOnlyList<(string EventId, string Text)> OrdnanceRecords => Records?.Ordnance ?? [];

    private IReadOnlyList<FireView> FireRecords => Records?.Fire ?? [];

    private IReadOnlyList<(string EventId, string Text)> CloseCombatRecords => Records?.CloseCombat ?? [];

    private IReadOnlyList<(string EventId, string Text)> NightRecords => Records?.Night ?? [];

    private IReadOnlyList<(string EventId, string Text)> SniperRecords => Records?.Snipers ?? [];

    private IReadOnlyList<(string EventId, string Kind, string Text)> RallyAndRepairRecords => Records?.RallyAndRepair ?? [];

    /// <summary>The turn and phase an event happened in, such as "Turn 2, Rally Phase"; null for an event the history does not hold.</summary>
    private string? WhenOf(string eventId) => Records?.WhenOf(eventId);

    /// <summary>The latest record the view may read, with its turn and phase, for the activity strip.</summary>
    private string? LatestRecord => Records?.Latest;

    /// <summary>
    /// The Replay page's address for this game in the view shown (pass 31b): at the step that holds an event, or where the Replay page opens. In a
    /// game still played the Replay page asks for the hand-over itself.
    /// </summary>
    private string? ReplayFrom(string? eventId) => gameId.Length == 0 ? null
        : $"games/replay?game={Uri.EscapeDataString(gameId)}&view={Uri.EscapeDataString(Viewer.Name)}" + (eventId is null ? string.Empty : $"&at={Uri.EscapeDataString(eventId)}");

    /// <summary>A proposed attack's fire group in words, as the records say it.</summary>
    private string FireGroupText(FireAttack attack) => PlayRecords.FireGroupText(history?.Events ?? [], attack);

    private static string RangeText(FireAttack attack) => PlayRecords.RangeText(attack);
