    /// <summary>
    /// Pass 25 (UI review; plan section 15.3): a SMOKE squad or place, a DC, or an advance destination the panels no longer offer is dropped, so no select
    /// shows blank while its button proposes a stale value.
    /// </summary>
    private void PruneMoveDrafts()
    {
        if (!SmokeChoices.Any(item => item.Id == smokeBy))
        {
            smokeBy = string.Empty;
        }

        if (!SmokePlaces.Any(item => item.Location == smokeAt))
        {
            smokeAt = string.Empty;
        }

        if (!ChargeChoices.Any(item => item.Id == placeDc))
        {
            placeDc = string.Empty;
        }

        if (!AdvanceDestinations.Contains(advanceTo, StringComparer.Ordinal))
        {
            advanceTo = string.Empty;
        }
    }

    private void ToggleMover(UnitSelectionList.Toggle toggle)
