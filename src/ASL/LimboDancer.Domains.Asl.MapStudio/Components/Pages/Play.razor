    private IEnumerable<UnitInstance> AdvanceCandidates => SeenOnly(state is null ? []
        : state.Units.Where(unit => unit.Status == InstanceStatus.Active && unit.Side == state.PhasingSide && !unit.MovementEnded && (state.Location(unit.Id) is not null || WaitsToEnter(unit))
            && !new[] { Conditions.Broken, Conditions.Pinned, Conditions.Berserk, Conditions.Melee, Conditions.Captured, Conditions.Concealed, Conditions.Hidden, "asl:ti" }.Any(name => GameState.Condition(unit, name) == ConditionState.True)
            && !Mans(unit))
