    private Task ProposeVehicleRequest(VehicleStepChoices.StepRequest request) => request.Kind switch
    {
        "resolve-ovr" => ProposeOverrun(),
        "load" or "unload" => ProposeVehicleLoad(request.Kind),
        _ => ProposeVehicleStep(request.Kind, request.To, request.Facing, request.Edge, request.Reverse, request.Bypass),
    };

