        : attack.Firers?.Where(item => item.Range is not null).ToArray() is { Length: > 0 } ranged
            ? string.Join(", ", ranged.Select(item => $"{item.UnitId} {item.Range!.Value.ToString(CultureInfo.InvariantCulture)}"))
            : "not read";

    /// <summary>
    /// The Rally and Repair attempts the viewer may see, latest first, each with its arithmetic: for a rally the DR, each DRM,
    /// the Final DR against the Morale Level, and the result (A10.6 to A10.64); for a repair the dr against the Repair Number
    /// (A9.72). A rally by a concealed unit that stays concealed is its own side's (ruling R19.8).
    /// </summary>
    private IReadOnlyList<(string EventId, string Kind, string Text)> RallyAndRepairRecords
    {
        get
        {
            if (history is null)
            {
                return [];
            }

            var rolls = history.Events.Select(item => item.Payload).OfType<DiceRolled>().ToDictionary(item => item.Roll, StringComparer.Ordinal);
            var records = new List<(string, string, string)>();
            foreach (var item in history.Events.Where(item => item.IsVisibleTo(Viewer)))
            {
                if (item.Payload is RallyAttempted rally && rally.Resolution.Deserialize<RallyResolution>(LiveFire.Json) is { Arithmetic: { } arithmetic } resolution)
                {
                    records.Add((item.EventId, "rally", RallyText(rally, arithmetic, resolution.Effect)));
                }
                else if (item.Payload is RepairAttempted repair)
                {
                    var dr = rolls.TryGetValue(repair.Roll, out var roll) ? roll.Values[0].ToString(CultureInfo.InvariantCulture) : "?";
                    var result = repair.Result switch
                    {
                        RepairAttempted.Repaired => "repaired",
                        RepairAttempted.Eliminated => "eliminated (a 6)",
                        _ => "still malfunctioned",
                    };
                    records.Add((item.EventId, "repair", $"{repair.Unit} repairs {repair.Equipment}: dr {dr} against R{repair.RepairNumber}: {result}"));
                }
            }

            records.Reverse();
            return records;
        }
    }

    /// <summary>A rally in words, for example "rl rallies r1: DR 5, 1 = 6 - 1 (terrain, A10.61) = Final DR 5 against 7: rallied".</summary>
    private static string RallyText(RallyAttempted rally, RallyArithmetic arithmetic, RallyEffect? effect)
    {
        var who = rally.Leader is { } leader ? $"{leader} rallies {rally.Unit}" : $"{rally.Unit} Self-Rallies";
        var drm = string.Concat(arithmetic.Drm.Select(item => $" {(item.Value < 0 ? "-" : "+")} {Number(Math.Abs(item.Value))} ({item.Name}, {item.Rule})"));
        List<string> results = [arithmetic.Rallied ? "rallied" : "not rallied"];
        if (arithmetic.Fate)
        {
            results.Add("Fate");
        }

        if (effect is { Eliminated: true })
        {
            results.Add("eliminated");
        }
        else if (effect is { } changed && changed.FinalDefinitionId != changed.DefinitionId)
        {
            results.Add($"now {changed.FinalDefinitionId}");
        }

        if (effect is { Wounded: true })
        {
            results.Add("wounded");
        }

        if (arithmetic.HeatOfBattleNotTaken)
        {
            results.Add("Heat of Battle not taken (R0.2)");
        }

        if (arithmetic.LeaderCreationNotTaken)
        {
            results.Add("Leader Creation not taken (R19.4)");
        }

        return $"{who}: DR {string.Join(", ", arithmetic.Dice)} = {arithmetic.OriginalDr}{drm} = Final DR {arithmetic.FinalDr} against {arithmetic.MoraleLevel}: {string.Join(", ", results)}";
    }

    private static string Number(decimal value) => value.ToString("0.##", CultureInfo.InvariantCulture);

    /// <summary>What an attack did to a target unit, in words.</summary>
    private static string EffectText(FireUnitEffect effect)
    {
        List<string> parts = [];
        if (effect.Eliminated)
        {
            parts.Add("eliminated");
        }
        else if (effect.FinalDefinitionId != effect.DefinitionId)
        {
            parts.Add($"now {effect.FinalDefinitionId}");
        }

        foreach (var (applies, name) in new[] { (effect.Broken, "broken"), (effect.Pinned, "pinned"), (effect.Wounded, "wounded"), (effect.Disrupted, "Disrupted"),
            (effect.ConcealmentLost, "concealment lost") })
        {
            if (applies)
            {
                parts.Add(name);
            }
        }

        return parts.Count == 0 ? "unaffected" : string.Join(", ", parts);
    }

    /// <summary>A MC, NTC, LLMC, or LLTC with its arithmetic, for example "NMC 4, 4 = 8 against 7: failed".</summary>
    private static string CheckText(FireCheck check) =>
        $"{check.Kind} {string.Join(", ", check.Dice)}{string.Concat(check.Drm.Select(item => $" {(item.Value < 0 ? "-" : "+")} {Number(Math.Abs(item.Value))} ({item.Name})"))}"
        + $" = {check.FinalDr} against {check.MoraleLevel}: {(check.Passed ? "passed" : "failed")}";

    [SupplyParameterFromQuery(Name = "game")]
    public string? GameQuery { get; set; }

    private IReadOnlyList<UnitDefinition> Definitions =>
        [.. Live.Catalogs.Where(catalog => catalog.Publication == CatalogPublication.Published).SelectMany(catalog => catalog.Definitions)];

    private UnitCatalog? PublishedCatalog => Live.Catalogs.FirstOrDefault(catalog => catalog.Publication == CatalogPublication.Published);

    /// <summary>Setup stays open until the first event that is not the start or a placement.</summary>
    private bool SetupOpen => history is { } shown && shown.Events.All(item => item.Payload is GameStarted or InstanceCreated);

    protected override void OnInitialized()
    {
        placeDefinition = Definitions.FirstOrDefault()?.Id ?? string.Empty;
        gameId = GameQuery ?? string.Empty;
        Refresh();
    }

    private void ChangeGame(ChangeEventArgs args)
    {
        gameId = args.Value as string ?? string.Empty;
        pending = null;
        placements.Clear();
        Refresh();
    }

    private void Refresh()
    {
        history = gameId.Length > 0 ? Live.History(gameId) : null;
        state = history?.Current ?? (history is { States.Count: > 0 } ? history.States[^1] : null);
        if (state?.Movement is { } movement)
        {
            moveUnits.Clear();
            moveUnits.UnionWith(movement.Movers);
        }

        if (state is not null && !state.Units.Any(unit => unit.Id == enterUnit))
        {
            enterUnit = state.Units.FirstOrDefault()?.Id ?? string.Empty;
        }

        if (state is not null && !state.Perspectives.Any(perspective => perspective.Name == viewAs))
        {
            viewAs = state.PhasingSide;
        }
    }

    private void AddPlacement()
    {
        if (placeDefinition.StartsWith(DummyPrefix, StringComparison.Ordinal))
        {
            AddDummy(placeDefinition[DummyPrefix.Length..]);
            return;
        }

        if (Definitions.FirstOrDefault(definition => definition.Id == placeDefinition) is not { } definition)
        {
            return;
        }

        var id = placeId.Trim().Length > 0 ? placeId.Trim() : $"{definition.Id}-{placements.Count + 1}";
        var side = new[] { firstSide, secondSide }.Contains(definition.Nationality) ? definition.Nationality
            : state?.Sides.FirstOrDefault(item => item.Nationality == definition.Nationality)?.Id ?? definition.Nationality;

        // A SW is placed in the possession of a unit (A9.1); anything else at a Location.
        var holder = placeHolder.Trim() is { Length: > 0 } held && Library.Vocabulary.IsA(definition.Kind, "asl:equipment") ? held : null;
        placements.Add(new Placement(id, definition.Id, definition.Kind, side, placeLocation.Trim(), placeConcealed, placeHidden, holder,
            placeBroken && holder is null));
        placeId = string.Empty;
    }

    /// <summary>A Dummy (A12.1): a "?" with no unit beneath it, so it has no definition and is always concealed.</summary>
    private void AddDummy(string side)
    {
        var id = placeId.Trim().Length > 0 ? placeId.Trim() : $"dummy-{side}-{placements.Count + 1}";
        placements.Add(new Placement(id, null, UnitKinds.Dummy, side, placeLocation.Trim(), true, placeHidden, null));
        placeId = string.Empty;
    }

    private async Task ProposeSetup()
    {
        var game = history is null ? newId.Trim() : gameId;
        object[] units = [.. placements.Select(PlacementArguments)];
        var catalog = PublishedCatalog is { } published ? $"{published.Identity.Catalog}@{published.Identity.Version}" : string.Empty;
        var arguments = history is null
            ? JsonSerializer.SerializeToElement(new
            {
                gameId = game, attemptId = Attempt("setup"), expectedRevision = 0L,
                start = Start(catalog),
                placements = units,
            })
            : JsonSerializer.SerializeToElement(new { gameId = game, attemptId = Attempt("setup"), expectedRevision = (long)history.Events.Count, placements = units });
        gameId = game;
        await Propose(GameActions.Setup, arguments);
    }

    /// <summary>
    /// A placement as the setup action reads it: a SW in its holder's possession with its malfunction state (A9.1), a Dummy
    /// with only its concealment (A12.1), and any other unit at its Location with its full set of conditions.
    /// </summary>
    private static Dictionary<string, object?> PlacementArguments(Placement item)
    {
        var placement = new Dictionary<string, object?> { ["id"] = item.Id, ["kind"] = item.Kind, ["side"] = item.Side };
        if (item.Definition is not null)
        {
            placement["definition"] = item.Definition;
        }

        if (item.Holder is { } holder)
        {
            placement["holding"] = new { holder, role = "possessed" };
            placement["conditions"] = new Dictionary<string, bool> { ["asl:malfunctioned"] = false };
            return placement;
        }

        placement["position"] = new { at = item.Location };
        placement["conditions"] = item.Kind == UnitKinds.Dummy
            ? new Dictionary<string, bool> { ["asl:concealed"] = true, ["asl:hidden"] = item.Hidden }
            : new Dictionary<string, bool>
            {
                ["asl:broken"] = item.Broken, ["asl:berserk"] = false, ["asl:captured"] = false, ["asl:melee"] = false, ["asl:ti"] = false,
                ["asl:disrupted"] = false, ["asl:concealed"] = item.Concealed, ["asl:hidden"] = item.Hidden,
            };
        return placement;
    }

    /// <summary>A new game's start: its sides with their ELRs, and the scenario month when one is chosen.</summary>
    private Dictionary<string, object?> Start(string catalog)
    {
        var start = new Dictionary<string, object?>
        {
            ["label"] = newLabel, ["catalog"] = catalog, ["boards"] = SetupBoards(), ["map"] = newMap, ["firstSide"] = firstSide,
            ["sides"] = new[] { Side(firstSide, firstElr), Side(secondSide, secondElr) },
        };
        if (int.TryParse(newMonth, CultureInfo.InvariantCulture, out var month))
        {
            start["scenarioMonth"] = month;
        }

        return start;
    }

    /// <summary>A side of a new game, with its ELR when one is given (A19.1).</summary>
    private static Dictionary<string, object> Side(string id, string elr)
    {
        var side = new Dictionary<string, object> { ["id"] = id, ["nationality"] = id };
        if (int.TryParse(elr, CultureInfo.InvariantCulture, out var value))
        {
            side["elr"] = value;
        }

        return side;
    }

    private Task ProposeAdvance() => Propose(GameActions.AdvancePhase,
        JsonSerializer.SerializeToElement(new { gameId, attemptId = Attempt("advance"), expectedRevision = (long)history!.Events.Count }));

    private Task ProposeEntry() => Propose(GameActions.EnterBuilding, JsonSerializer.SerializeToElement(new
    {
        gameId, attemptId = Attempt("enter"), expectedRevision = (long)history!.Events.Count, unitId = enterUnit, location = enterLocation.Trim(),
    }));

    /// <summary>The attacker's OVR choice for a pending attempt; an election is refused until step 10.</summary>
    private Task ProposeDeclaration(string unit, string choice) => Propose(GameActions.DeclareOverrun, JsonSerializer.SerializeToElement(new
    {
        gameId, attemptId = Attempt("declare"), expectedRevision = (long)history!.Events.Count, unitId = unit, choice,
    }));

    private async Task Propose(ActionDescriptor action, JsonElement arguments)
    {
        pending = new Proposal(action, arguments, await Run(() => Live.Play.ProposeAsync(action, arguments, Live.Principal)));
        Refresh();
    }

    /// <summary>Runs a gate call; a failure inside it, such as a reviewed package that no longer verifies, is reported, not thrown.</summary>
    private static async Task<PlayResult> Run(Func<Task<PlayResult>> call)
    {
        try
        {
            return await call();
        }
        catch (InvalidOperationException exception)
        {
            return new PlayResult(PlayOutcome.Failed, new LimboDancer.Abstractions.Runtime.CorrelationId("failed"), ["play.error: " + exception.Message], null);
        }
    }

    private async Task Confirm()
    {
        if (pending is not { } proposal)
        {
            return;
        }

        var result = await Run(() => Live.Play.ConfirmAsync(proposal.Action, proposal.Arguments, Live.Principal, proposal.Result.Correlation));
        pending = proposal with { Result = result };
        if (result.Outcome is PlayOutcome.Committed or PlayOutcome.Replay)
        {
            // A committed action's choices are spent: the next one starts from nothing.
            if (proposal.Action == GameActions.Setup)
            {
                placements.Clear();
            }
            else if (proposal.Action == GameActions.Fire)
            {
                ClearFire();
            }
            else if (proposal.Action == GameActions.EndMove)
            {
                moveUnits.Clear();
                moveTo = string.Empty;
                moveAssault = false;
            }
            else if (proposal.Action == GameActions.Rally)
            {
                rallyUnit = string.Empty;
                rallyLeader = string.Empty;
            }
            else if (proposal.Action == GameActions.Repair)
            {
                repairWeapon = string.Empty;
            }
        }

        Refresh();
    }

    private static string Attempt(string kind) => $"{kind}-{Guid.NewGuid():N}"[..(kind.Length + 13)];

    private static string OutcomeText(PlayOutcome outcome, bool withheld) => outcome switch
    {
        PlayOutcome.NeedsConfirmation when withheld => "The entry is declared. Confirm to commit it and resolve what it finds.",
        PlayOutcome.NeedsConfirmation => "Every check passed. Confirm to commit.",
        PlayOutcome.Committed => "Committed through the Execution Gate.",
        PlayOutcome.Replay => "Already committed by this attempt; nothing changed.",
        PlayOutcome.Stale => "Stale: the game moved on since the proposal. Propose again.",
        PlayOutcome.Denied => "Refused by the gate.",
        _ => "Failed.",
    };
}
