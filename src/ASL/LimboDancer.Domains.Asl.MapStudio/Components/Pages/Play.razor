    /// <summary>The game and the view a gate call is made for; a result returning for others is dropped (pass 29).</summary>
    private string AskedBy => $"{gameId}/{handOver ?? viewAs}";

    /// <summary>Whether a proposal waits for Confirm, so its tab is marked and stays open when the map is clicked (pass 29).</summary>
    private bool AwaitingConfirm => pending?.Result.Outcome == PlayOutcome.NeedsConfirmation;

    private ElementReference reviewFallback;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Plan section 14: a new proposal takes the focus to its review; a confirmed hand-over takes it to the actions (backlog section 37).
        try
        {
            if (firstRender)
            {
                workspaceScript ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/playWorkspace.js");
                await workspaceScript.InvokeVoidAsync("watchContext");
            }

            if (focusReview || focusActions)
            {
                var pane = focusReview ? workspace?.Inspector ?? reviewFallback : actionsPane;
                (focusReview, focusActions) = (false, false);
                workspaceScript ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/playWorkspace.js");
                await workspaceScript.InvokeVoidAsync("reveal", pane);
            }
        }
        catch (Exception exception) when (exception is JSDisconnectedException or JSException or TaskCanceledException)
        {
            // The element was not rendered (no game shown) or the circuit is gone: focus stays where it was.
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (workspaceScript is not null)
            {
                await workspaceScript.InvokeVoidAsync("unwatchContext");
                await workspaceScript.DisposeAsync();
            }
        }
        catch (Exception exception) when (exception is JSDisconnectedException or JSException or TaskCanceledException)
        {
            // The circuit is gone; the browser already dropped the module.
        }
    }

    // The map's layers, read once per game, revision, view, and the Gun whose Covered Arc is drawn (backlog section 37: the map was drawn on every
    // render). Pass 29: the workspace draws the picked hex and the LOS line itself.
    private (string Game, long Revision, string Viewer, string Gun, GameMapLayers? Layers) mapCache;

    private GameMapLayers? MapLayers
    {
        get
        {
            if (state is null || history?.Current is null)
            {
                return null;
            }

            if (mapCache.Layers is null || mapCache.Game != gameId || mapCache.Revision != state.Revision || mapCache.Viewer != Viewer.Name
                || mapCache.Gun != ordnanceGun)
            {
                mapCache = (gameId, state.Revision, Viewer.Name, ordnanceGun, GameMaps.Layers(gameId, state.Map, Viewer, state.Revision, CoveredArcLayer,
                    state.ResidualFire));
            }

            return mapCache.Layers;
        }
    }

    // Backlog section 43: records grouped by turn and phase, read once per history.
    private (GameHistory? History, IReadOnlyDictionary<string, string>? When) whenCache;

    /// <summary>The turn and phase an event happened in, such as "Turn 2, Rally Phase"; null for an event the history does not hold.</summary>
    private string? WhenOf(string eventId)
    {
        if (history is null)
        {
            return null;
        }

        if (whenCache.When is null || !ReferenceEquals(whenCache.History, history))
        {
            var when = new Dictionary<string, string>(StringComparer.Ordinal);
            foreach (var item in history.Events)
            {
                // The phase the event was proposed in: the state before it, or the start's own state.
                if ((history.At(item.Revision - 1) ?? history.At(item.Revision)) is { } before)
                {
                    when[item.EventId] = $"Turn {before.Turn}, {Games.PhaseLabel(before.Phase)}";
                }
            }

            whenCache = (history, when);
        }

        return whenCache.When!.GetValueOrDefault(eventId);
    }

    /// <summary>The latest record the view may read, with its turn and phase, for the activity strip.</summary>
    private string? LatestRecord
    {
        get
        {
            if (history is null)
            {
                return null;
            }

            var revisions = history.Events.ToDictionary(item => item.EventId, item => item.Revision, StringComparer.Ordinal);
            var all = OrdnanceRecords.Concat(CloseCombatRecords).Concat(NightRecords).Concat(SniperRecords)
                .Concat(RallyAndRepairRecords.Select(item => (item.EventId, item.Text)))
                .Concat(FireRecords.Select(fire => (fire.EventId, $"{fire.Group} fires at {fire.Target}.")));
            var latest = all.Where(item => revisions.ContainsKey(item.EventId)).OrderByDescending(item => revisions[item.EventId]).FirstOrDefault();
            return latest.EventId is null ? null : $"Latest: {WhenOf(latest.EventId)}: {latest.Item2}";
        }
    }
