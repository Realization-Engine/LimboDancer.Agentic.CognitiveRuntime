        ? Live.Catalogs.FirstOrDefault(catalog => $"{catalog.Identity.Catalog}@{catalog.Identity.Version}" == started.Catalog)
        : Live.Catalogs.FirstOrDefault(catalog => catalog.Publication == CatalogPublication.Published);

