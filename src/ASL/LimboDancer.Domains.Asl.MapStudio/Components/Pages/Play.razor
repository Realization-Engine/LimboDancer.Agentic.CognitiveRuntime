    // Whether the address still carries the hex of "Back to Play"; it is taken out once read, so a reload or another view does not pick it again.
    private bool dropHexQuery;
    private bool busy;
    private string status = string.Empty;

    private static readonly IReadOnlyList<InspectorTabs.Tab> PaneTabs =
        [new("map", "Map"), new("actions", "Actions"), new("activity", "Activity")];

    /// <summary>A pane's attributes: under 1024px a tab panel, hidden unless its tab is chosen, so it keeps its state; wider, a named region.</summary>
    private Dictionary<string, object> Pane(string tab, string title) => narrow
        ? new() { ["role"] = "tabpanel", ["aria-labelledby"] = InspectorTabs.TabFor("play", tab), ["hidden"] = paneTab != tab }
        : new() { ["aria-label"] = title };

    /// <summary>The context line: the revision, turn, phase, and phasing side, and whether setup is open; null with no game shown.</summary>
    private string? ContextSummary => state is null || history is null ? null
        : (history.Current is not null ? string.Empty : "The game does not replay: ") + $"Turn {state.Turn}, {DisplayText.Side(state.PhasingSide)} {Games.PhaseLabel(state.Phase)}."
            + (SetupOpen ? " Setup is open." : state.Ended is not null ? " The game has ended; nothing more is played." : string.Empty);

    /// <summary>
    /// The side whose answer or turn the game waits for, when it is not the shown view (backlog section 37): a choice's side, a surrender's captors,
    /// the DEFENDER after a step or in the DFPh, otherwise the phasing side. Null for the adjudicator, in setup, after the end, or during a hand-over.
    /// </summary>
    private string? AwaitingView
    {
        get
        {
            if (state is null || history?.Current is null || state.Ended is not null || SetupOpen || Viewer.IsAdjudicator || handOver is not null)
            {
                return null;
            }

            var waiting = Awaiting(state).Side;
            return waiting is { Length: > 0 } && waiting != viewAs && state.Perspectives.Any(perspective => perspective.Name == waiting) ? waiting : null;
        }
    }

    private string AwaitingNote => state is null ? string.Empty : Awaiting(state).Note;

    /// <summary>What the shown view does now, when the game waits on no other view (table player, pass 28c); null otherwise.</summary>
    private string? ActingNote => state is null || history?.Current is null || state.Ended is not null || SetupOpen || Viewer.IsAdjudicator || handOver is not null
        || AwaitingView is not null ? null : $"You act: {Awaiting(state).Note}";

    /// <summary>Where the moving stack is, which the DEFENDER sees as units or a "?" (A8.1); null when no stack moves.</summary>
    private BoardLocation? MovingAt => state?.Movement is { Members: [var first, ..] } ? state.Location(first)?.Location : null;

    private (string? Side, string Note) Awaiting(GameState shown)
    {
        var defender = shown.Sides.FirstOrDefault(side => side.Id != shown.PhasingSide)?.Id;
        if (shown.Choice is { } choice)
        {
            return (choice.Side, $"The {DisplayText.Side(choice.Side)} side has a choice to make before play goes on.");
        }

        if (shown.PendingSurrenders.FirstOrDefault() is { } surrender
            && surrender.Captors.Select(shown.Unit).OfType<UnitInstance>().Select(unit => unit.Side).FirstOrDefault() is { } captors)
        {
            return (captors, $"The {DisplayText.Side(captors)} side answers a surrender (A20.21).");
        }

        if (shown.Phase == "mph" && shown.Movement is { WindowOpen: true })
        {
            return (defender, "The DEFENDER may fire at the moving stack or pass (A8.1).");
        }

        if (shown.Phase == "dfph")
        {
            return (defender, $"The {DisplayText.Side(defender)} side may fire, then ends the {Games.PhaseLabel(shown.Phase)}.");
        }

        if (shown.Phase is "rph" or "rtph" or "ccph")
        {
            var other = viewAs == shown.PhasingSide ? defender : shown.PhasingSide;
            return (other, $"Both sides act in the {Games.PhaseLabel(shown.Phase)}, the {DisplayText.Side(shown.PhasingSide)} side first.");
        }

        return (shown.PhasingSide, $"The {DisplayText.Side(shown.PhasingSide)} side acts in the {Games.PhaseLabel(shown.Phase)}.");
    }

    private void HandOverToAwaiting()
    {
        if (AwaitingView is { } next)
        {
            ChangeView(next);
        }
    }

    private void FocusReview() => ShowProposal();

    /// <summary>The actions brought into view with the focus; under 1024px their tab opens (pass 29).</summary>
    private void ShowActions(bool scroll = true)
    {
        (focusActions, focusInPlace) = (true, !scroll);
        if (narrow)
        {
            paneTab = "actions";
        }
    }

    private void CancelProposal()
    {
        if (!busy)
        {
            (pending, status) = (null, string.Empty);
            ShowActions(scroll: narrow);
        }
    }

    /// <summary>
    /// A hex named off the map (the units table, "Show it on the map") is picked and shown: the map comes into view, under 1024px in its tab, and
    /// the Selection tab opens unless a proposal waits for Confirm (table player, pass 29).
    /// </summary>
    private void LocateHex(BoardLocation at)
    {
        (highlight, focusMap) = (at, true);
        if (narrow)
        {
            paneTab = "map";
        }

        if (!AwaitingConfirm)
        {
            inspectorTab = "selection";
        }
    }

    /// <summary>What a map click picked while Confirm waits and the Proposal tab stays open; the counters are those the view draws.</summary>
    private string? PickedNote => AwaitingConfirm && highlight is { } at && MapLayers is { Board: { } board, Overlay: { } overlay } && GameMaps.FactsAt(board, at) is { } facts
        ? $"Picked: {DisplayText.Location(at)}, {overlay.At(facts.Index).Count() switch { 0 => "no counters", 1 => "1 counter", var count => $"{count} counters" }}; the Selection tab has its details."
        : null;

    /// <summary>Closes the scenario card and returns the focus to the context's link that opened it (Claude Design's review).</summary>
    private async Task CloseCard()
    {
        try
        {
            workspaceScript ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/playWorkspace.js");
            await workspaceScript.InvokeVoidAsync("closeDetails", "play-card", "play-card-link");
        }
        catch (Exception exception) when (exception is JSDisconnectedException or JSException or TaskCanceledException)
        {
            // The circuit is gone; the card stays as it was.
        }
    }

    /// <summary>Opens the scenario card, which starts closed, and brings it into view (pass 29).</summary>
    private async Task OpenCard()
    {
        try
        {
            workspaceScript ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/playWorkspace.js");
            await workspaceScript.InvokeVoidAsync("openDetails", "play-card");
        }
        catch (Exception exception) when (exception is JSDisconnectedException or JSException or TaskCanceledException)
        {
            // The circuit is gone; the card stays as it was.
        }
    }

    /// <summary>The Proposal tab chosen and brought into view with the focus; under 1024px it is in the Map tab (pass 29).</summary>
    private void ShowProposal()
    {
        (focusReview, inspectorTab) = (true, "proposal");
        if (narrow)
        {
            paneTab = "map";
        }
    }

    /// <summary>The game and the view a gate call is made for; a result returning for others is dropped (pass 29).</summary>
    private string AskedBy => $"{gameId}/{handOver ?? viewAs}";

    /// <summary>Whether a proposal waits for Confirm, so its tab is marked and stays open when the map is clicked (pass 29).</summary>
    private bool AwaitingConfirm => pending?.Result.Outcome == PlayOutcome.NeedsConfirmation;

    private ElementReference reviewFallback;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Plan section 14: a new proposal takes the focus to its review; a confirmed hand-over takes it to the actions (backlog section 37).
        try
        {
            if (firstRender)
            {
                workspaceScript ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/playWorkspace.js");
                await workspaceScript.InvokeVoidAsync("watchContext");
            }

            if (dropHexQuery)
            {
                dropHexQuery = false;
                Navigation.NavigateTo(Navigation.GetUriWithQueryParameter("hex", (string?)null), replace: true);
            }

            if (revealId is { } shownId)
            {
                revealId = null;
                workspaceScript ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/playWorkspace.js");
                await workspaceScript.InvokeVoidAsync("revealId", shownId);
            }

            if (focusReview || focusActions || focusMap)
            {
                var pane = focusReview ? workspace?.Inspector ?? reviewFallback : focusMap ? workspace?.Stage ?? default : actionsPane;
                var scroll = focusReview || focusMap || !focusInPlace;
                (focusReview, focusActions, focusMap, focusInPlace) = (false, false, false, false);
                workspaceScript ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/playWorkspace.js");
                await workspaceScript.InvokeVoidAsync("reveal", pane, scroll);
            }
        }
        catch (Exception exception) when (exception is JSDisconnectedException or JSException or TaskCanceledException)
        {
            // The element was not rendered (no game shown) or the circuit is gone: focus stays where it was.
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (workspaceScript is not null)
            {
                await workspaceScript.InvokeVoidAsync("unwatchContext");
                await workspaceScript.DisposeAsync();
            }
        }
        catch (Exception exception) when (exception is JSDisconnectedException or JSException or TaskCanceledException)
        {
            // The circuit is gone; the browser already dropped the module.
        }
    }

    // The map's layers, read once per game, revision, view, and the Gun whose Covered Arc is drawn (backlog section 37: the map was drawn on every
    // render). Pass 29: the workspace draws the picked hex and the LOS line itself.
    private (string Game, long Revision, string Viewer, string Gun, GameMapLayers? Layers) mapCache;

    private GameMapLayers? MapLayers
    {
        get
        {
            if (state is null || history?.Current is null)
            {
                return null;
            }

            if (mapCache.Layers is null || mapCache.Game != gameId || mapCache.Revision != state.Revision || mapCache.Viewer != Viewer.Name
                || mapCache.Gun != ordnanceGun)
            {
                mapCache = (gameId, state.Revision, Viewer.Name, ordnanceGun, GameMaps.Layers(gameId, state.Map, Viewer, state.Revision, CoveredArcLayer,
                    state.ResidualFire));
            }

            return mapCache.Layers;
        }
    }

    // Backlog section 43: records grouped by turn and phase, read once per history.
    private (GameHistory? History, IReadOnlyDictionary<string, string>? When) whenCache;

    /// <summary>The turn and phase an event happened in, such as "Turn 2, Rally Phase"; null for an event the history does not hold.</summary>
    private string? WhenOf(string eventId)
    {
        if (history is null)
        {
            return null;
        }

        if (whenCache.When is null || !ReferenceEquals(whenCache.History, history))
        {
            var when = new Dictionary<string, string>(StringComparer.Ordinal);
            foreach (var item in history.Events)
            {
                // The phase the event was proposed in: the state before it, or the start's own state.
                if ((history.At(item.Revision - 1) ?? history.At(item.Revision)) is { } before)
                {
                    when[item.EventId] = $"Turn {before.Turn}, {Games.PhaseLabel(before.Phase)}";
                }
            }

            whenCache = (history, when);
        }

        return whenCache.When!.GetValueOrDefault(eventId);
    }

    /// <summary>The latest record the view may read, with its turn and phase, for the activity strip.</summary>
    private string? LatestRecord
    {
        get
        {
            if (history is null)
            {
                return null;
            }

            var revisions = history.Events.ToDictionary(item => item.EventId, item => item.Revision, StringComparer.Ordinal);
            var all = OrdnanceRecords.Concat(CloseCombatRecords).Concat(NightRecords).Concat(SniperRecords)
                .Concat(RallyAndRepairRecords.Select(item => (item.EventId, item.Text)))
                .Concat(FireRecords.Select(fire => (fire.EventId, $"{fire.Group} fires at {fire.Target}.")));
            var latest = all.Where(item => revisions.ContainsKey(item.EventId)).OrderByDescending(item => revisions[item.EventId]).FirstOrDefault();
            return latest.EventId is null ? null : $"Latest: {WhenOf(latest.EventId)}: {latest.Item2}";
        }
    }
}
