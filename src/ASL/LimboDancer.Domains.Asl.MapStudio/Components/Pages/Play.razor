    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Plan section 14: a new proposal takes the focus to its review; a confirmed hand-over takes it to the actions (backlog section 37).
        try
        {
            if (firstRender)
            {
                workspaceScript ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/playWorkspace.js");
                await workspaceScript.InvokeVoidAsync("watchContext");
                await workspaceScript.InvokeVoidAsync("watchWorking");
            }

            if (dropHexQuery)
            {
                dropHexQuery = false;
                Navigation.NavigateTo(Navigation.GetUriWithQueryParameter("hex", (string?)null), replace: true);
            }

            if (revealId is { } shownId)
            {
                revealId = null;
                workspaceScript ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/playWorkspace.js");
                await workspaceScript.InvokeVoidAsync("revealId", shownId);
            }

            if (focusReview || focusActions || focusMap)
            {
                var pane = focusReview ? workspace?.Inspector ?? reviewFallback : focusMap ? workspace?.Stage ?? default : actionsPane;
                // Pass 31c (design D15): from 1024px every pane is in view, so the focus moves and nothing scrolls; the narrow layout still scrolls.
                var scroll = narrow && (focusReview || focusMap || !focusInPlace);
                (focusReview, focusActions, focusMap, focusInPlace) = (false, false, false, false);
                workspaceScript ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/playWorkspace.js");
                await workspaceScript.InvokeVoidAsync("reveal", pane, scroll);
            }
        }
        catch (Exception exception) when (exception is JSDisconnectedException or JSException or TaskCanceledException)
        {
            // The element was not rendered (no game shown) or the circuit is gone: focus stays where it was.
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (followRun is { } following)
        {
            await following.CancelAsync();
        }

        try
        {
            if (workspaceScript is not null)
            {
                await workspaceScript.InvokeVoidAsync("unwatchContext");
                await workspaceScript.InvokeVoidAsync("unwatchWorking");
                await workspaceScript.DisposeAsync();
            }
        }
        catch (Exception exception) when (exception is JSDisconnectedException or JSException or TaskCanceledException)
        {
            // The circuit is gone; the browser already dropped the module.
        }
    }

