    /// </summary>
    private string? HoldSide => state is not { } shown ? null
        : shown.Choice is not null || shown.PendingSurrenders.Count > 0 || shown is { Phase: "mph", Movement.WindowOpen: true } ? Awaiting(shown).Side
        : shown.Phase == "rtph" ? RoutHolderNow
        // A11.11: once the first side has declared its CC attacks, the other side declares before the round is resolved.
        : shown.Phase == "ccph" && CcKeptForGame is { } declared ? shown.Sides.FirstOrDefault(side => side.Id != declared.Side)?.Id
        : null;

    // The side holding the RtPh up, asked of the planner once a state (the Memory and Performance Guidelines): it runs the rout's searches.
    private (GameState? State, string? Holder) routHolderMemo;

