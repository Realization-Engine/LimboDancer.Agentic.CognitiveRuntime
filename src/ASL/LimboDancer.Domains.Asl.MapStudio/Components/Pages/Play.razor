    /// <summary>The Locations that hold active units of the firing side that may fire now.</summary>
    private IEnumerable<string> FireLocations(string side) => state is null ? []
        : state.Units.Where(unit => unit.Status == InstanceStatus.Active && unit.Side == side
            && (Library.Vocabulary.IsA(unit.Kind, "asl:mmc") || unit.Kind == "asl:hero" || GamePlanner.HasMainArmamentMg(unit) || VehicleMgChoices(unit).Count > 0) && MayFire(unit))
            .Select(unit => state.Location(unit.Id)?.Location.ToString())
            .OfType<string>().Distinct(StringComparer.Ordinal).Order(StringComparer.Ordinal);

    /// <summary>
    /// Whether a unit may fire now: not a crew, whose inherent fire the Fire package does not review (ruling R24.8); not berserk, held
    /// in Melee, a prisoner, or a Guard (A15.432, A11.15, A20.5, A20.52); and not spent for this phase (A7.1, A8.4), as the planner and
    /// the Fire package read it.
    /// </summary>
    // Pass 31c (the third play test): a broken unit is not offered as a firer; the Fire package refuses a group that holds one.
    private bool MayFire(UnitInstance unit) => state is not null && !ScenarioA1Definitions.IsCrew(unit.Kind) && GameState.Condition(unit, Conditions.Broken) != ConditionState.True
        && GamePlanner.FireBar(state, unit) is null && !LiveFire.FireSpent(state, unit)
        // D3.5 (pass 50): a tank is a firer while its BMG or CMG may fire; neither needs a CE crew (D1.83). D1.3 (pass 60): so is a vehicle whose MA is a
        // MG, an AAMG only CE.
        && (!LiveFire.IsVehicle(unit) || (GamePlanner.HasMainArmamentMg(unit) && (!GamePlanner.HasVehicleMg(unit) || LiveFire.CrewExposed(unit)))
            || VehicleMgChoices(unit).Any(weapon => weapon.Bar is null));

    // Each unit's Location comes from the planner's index, once per state (ruling R65.25; the boundary review), not a scan of the state per unit. A unit
    // crewing a vehicle from inside is no Mounted Fire firer (D5.42; the UI review): the planner refuses it, so it is not offered.
    private IEnumerable<UnitInstance> FireGroupAt(string side) => state is null || fireFrom.Length == 0 ? []
        : state.Units.Where(unit => unit.Status == InstanceStatus.Active && unit.Side == side && unit.Position is not ContainedPosition { Role: ContainmentRole.Crew })
            .Select(unit => (Unit: unit, At: Live.Planner.LocationOf(state, unit.Id)?.Location.ToString()))
            .Where(item => item.At is { } at && (at == fireFrom || fireAlso.Contains(at)))
            .OrderBy(item => item.At == fireFrom ? 0 : 1 + fireAlso.IndexOf(item.At!)).ThenBy(item => item.Unit.Id, StringComparer.Ordinal).Select(item => item.Unit);

    /// <summary>
