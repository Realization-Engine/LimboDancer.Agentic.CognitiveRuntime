    // Ruling R23.2: the view a hand-over waits to show; null when none waits.
    private string? handOver;

    private IReadOnlyList<PerspectivePicker.Choice> ViewChoices => state is null ? []
        : [.. state.Perspectives.Select(perspective => new PerspectivePicker.Choice(perspective.Name, perspective.IsAdjudicator ? "the adjudicator" : DisplayText.Side(perspective.Name)))];

