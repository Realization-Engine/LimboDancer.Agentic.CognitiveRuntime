            $"The {DisplayText.Side(state.PhasingSide)} stack in {PlaceOf(at.ToString())} has made its step; the {DisplayText.Side(AwaitingView)} side may fire at it "
                + "(Defensive First Fire) or pass before it goes on (A8.1).",
        { Phase: "rtph" } when AwaitingView == state.PhasingSide =>
            $"The {DisplayText.Side(state.PhasingSide)} side routs first: its broken units that must rout go before yours (A10.5). Your routs come once it has made them.",
        { Phase: "rtph" } => $"The {DisplayText.Side(AwaitingView)} side still has broken units that must rout (A10.5); the Rout Phase ends after them.",
        { Phase: "ccph" } when CcKeptForGame is { } declared =>
            $"The {DisplayText.Side(declared.Side)} side has declared its CC attacks in {PlaceOf(declared.Location)}; the {DisplayText.Side(AwaitingView)} side declares its own, "
                + "and then every attack is rolled together, since CC is simultaneous (A11.11).",
        _ => AwaitingNote,
