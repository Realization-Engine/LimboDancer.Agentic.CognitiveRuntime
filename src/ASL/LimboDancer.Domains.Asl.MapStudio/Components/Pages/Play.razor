    private IReadOnlyList<VehicleCloseCombatPanel.CcLocation> VehicleCcRows => state is null ? [] : [.. VehicleCcLocations.Select(location =>
    {
        var (nextSide, _) = Live.Planner.VehicleCloseCombatTurn(state, location);
        var here = SeenOnly(state.At(location).OfType<UnitInstance>().Where(unit => unit.Status == InstanceStatus.Active)).ToArray();
        var attacked = state.CloseCombats.FirstOrDefault(item => item.Location == location && !item.Closed)?.Attacking ?? [];
        return new VehicleCloseCombatPanel.CcLocation(location.ToString(), nextSide ?? string.Empty,
            [.. here.Where(unit => unit.Side == nextSide && !LiveFire.IsVehicle(unit) && unit.Kind != UnitKinds.Dummy && !attacked.Contains(unit.Id)
                && GameState.Condition(unit, Conditions.Broken) != ConditionState.True && GameState.Condition(unit, Conditions.Captured) != ConditionState.True).Select(unit => unit.Id)],
            [.. here.Where(unit => unit.Side == nextSide && unit.Kind is "asl:leader" or "asl:hero").Select(unit => unit.Id)],
            [.. here.Where(LiveFire.IsVehicle).Select(unit => new VehicleCloseCombatPanel.VehicleChoice(unit.Id, unit.Side))],
            [.. here.Where(unit => !LiveFire.IsVehicle(unit) && unit.Side != nextSide).Select(unit => unit.Id)]);
    })];

    private Task ProposeVehicleCc(string location, IReadOnlyList<string> attackers, string? vehicle, IReadOnlyList<string> defenders, bool pass)
    {
        var arguments = new Dictionary<string, object>
        {
            ["gameId"] = gameId,
            ["attemptId"] = Attempt("vehicle-cc"),
            ["expectedRevision"] = (long)history!.Events.Count,
            ["location"] = location,
        };
        if (attackers.Count > 0)
        {
            arguments["attackers"] = attackers;
        }

        if (vehicle is not null)
        {
            arguments["vehicleId"] = vehicle;
        }

        if (defenders.Count > 0)
        {
            arguments["defenders"] = defenders;
        }

        if (pass)
        {
            arguments["pass"] = true;
        }

        return Propose(GameActions.VehicleCloseCombat, JsonSerializer.SerializeToElement(arguments));
    }

