    private Task ProposeMove()
    {
        var arguments = new Dictionary<string, object>
        {
            ["gameId"] = gameId, ["attemptId"] = Attempt("move"), ["expectedRevision"] = (long)history!.Events.Count, ["unitIds"] = moveUnits.Order(StringComparer.Ordinal).ToArray(),
            ["to"] = moveTo.Trim(), ["assault"] = moveAssault, ["doubleTime"] = moveDoubleTime,
        };

        // A15.431 (ruling R15.14): the 1PP SW a berserk unit keeps.
        if (moveKeep.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries) is { Length: > 0 } keep)
        {
            arguments["keep"] = keep;
        }

        // A4.132 (pass 40): the other terrain's cost across a road hexside, in place of the road's.
        if (moveTerrainRate)
        {
            arguments["terrainRate"] = true;
        }

        // A4.63 (pass 40): the Location a Dash is declared to.
        if (moveDash.Trim().Length > 0)
        {
            arguments["dash"] = moveDash.Trim();
        }

        // A4.15 (pass 40): the step is an Infantry OVR.
        if (moveOverrun)
        {
            arguments["overrun"] = true;
        }

        // A4.42 (pass 40): the laden MMC named for the leader's IPC.
        if (moveIpcTo.Length > 0 && moveUnits.Count > 1 && moveUnits.Contains(moveIpcTo))
        {
            arguments["ipcTo"] = moveIpcTo;
        }

        // A17.2 (pass 71, ruling R71.16): the wounded man carried, and his carrier.
        if (moveCarry.Length > 0 && moveCarryBy.Length > 0 && moveUnits.Contains(moveCarry) && moveUnits.Contains(moveCarryBy))
        {
            arguments["carried"] = new[] { new Dictionary<string, string> { ["man"] = moveCarry, ["carrier"] = moveCarryBy } };
        }

        // A4.134, A4.3 (rulings R10.7, R10.9): a Minimum Move, or the hexsides of a Bypass.
        if (moveMinimum)
        {
            arguments["minimumMove"] = true;
        }

        if (moveBypass.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries) is { Length: > 0 } sides)
        {
            arguments["bypass"] = sides.Select(side => side.ToLowerInvariant()).ToArray();
        }

        if (movePush && MovingGun is { } gun)
        {
            arguments["pushGun"] = gun.Id;
        }

        return Propose(GameActions.Move, JsonSerializer.SerializeToElement(arguments));
    }

