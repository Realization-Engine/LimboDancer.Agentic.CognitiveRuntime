    private async Task Propose(ActionDescriptor action, JsonElement arguments)
    {
        // Plan section 13.4: one request at a time; a second click while the gate works is dropped, not sent twice.
        if (busy)
        {
            return;
        }

        (busy, status) = (true, "Checking the proposal.");
        var asked = AskedBy;
        Proposal proposed;
        try
        {
            arguments = FromView(arguments);
            // Pass 29: the busy state is drawn before the gate is asked, so the pickers show as disabled even when the answer is quick.
            StateHasChanged();
            await DrawBusy();
            // A guide route may be prepared from newer host evidence than the page's last render.
            // Confirm the revision actually submitted to the gate, while retaining the usual stale-write check.
            var revision = arguments.TryGetProperty("expectedRevision", out var expected) && expected.TryGetInt64(out var submittedRevision)
                ? submittedRevision : (long)(history?.Events.Count ?? 0);
            proposed = new Proposal(action, arguments, await Run(() => Live.Play.ProposeAsync(action, arguments, Live.PrincipalFor(action, Viewer))), revision);
        }
        finally
        {
            busy = false;
        }

        // Pass 29: a result that returns for another game or view is dropped, never shown to the view that did not ask.
        if (AskedBy != asked)
        {
            status = string.Empty;
            return;
        }

        pending = proposed;

        // The Play streamlining plan, S2 (rulings Q3, Q4): a routine action the gate accepts is confirmed at once; the gate still asks for and
        // records the confirmation, and the review opens only for what is not routine or is refused.
        if (oneClick && Routine(proposed))
        {
            await Confirm();
            return;
        }

        status = $"{action.Name}: {(ConsequencesOf(proposed).Count > 0 ? ConsequencesOutcome : OutcomeText(proposed.Result.Outcome, Withheld(proposed)))}";
        ShowProposal();
        Refresh();
    }

    /// <summary>Routine actions commit on one click unless the host requires every action to be confirmed.</summary>
    private bool oneClick = true;

    /// <summary>
    /// A routine proposal (ruling Q3): a pass, the end of a move, or a Movement step, accepted by the gate and waiting for Confirm, with no
    /// consequence among its reasons, no roll, no fire, and no entry whose outcome the view may not see. The end of a phase is not routine (the
    /// user, 2026-10-21, after a Movement Phase ended by a misclick): it cannot be taken back, so it goes through the review and its Confirm.
    /// </summary>
    private bool Routine(Proposal proposal) =>
        proposal.Result.Outcome == PlayOutcome.NeedsConfirmation
        && (proposal.Action == GameActions.PassFire || proposal.Action == GameActions.EndMove || proposal.Action == GameActions.Move)
        && proposal.Result.Plan is { Roll: null, Fire: null, Disclosure: null }
        && ConsequencesOf(proposal).Count == 0;

    /// <summary>Pass 31 (ruling R31.6): a proposal names the view it comes from, so the planner refuses what that side may not do.</summary>
    private JsonElement FromView(JsonElement arguments)
    {
        var node = System.Text.Json.Nodes.JsonNode.Parse(arguments.GetRawText())!;
        node[GamePlanner.ProposedByArgument] = Viewer.IsAdjudicator ? GamePlanner.AdjudicatorView : viewAs;
        return JsonSerializer.SerializeToElement(node);
    }

    /// <summary>Pass 31 (ruling R31.6): the units the view acts for: its side's, or every unit for the adjudicator.</summary>
    private bool Mine(UnitInstance unit) => Viewer.IsAdjudicator || unit.Side == viewAs;

    /// <summary>Pass 31: whether a weapon is the view's to handle: one its side holds, or one lying unpossessed.</summary>
    private bool Mine(EquipmentInstance weapon) => Viewer.IsAdjudicator || weapon.Holding is not { } holding || state?.Unit(holding.Holder) is not { } holder || holder.Side == viewAs;

    /// <summary>Pass 31 (ruling R31.6): whether the view shown may end the present phase.</summary>
    private bool MayEndPhase => state is not null && (Viewer.IsAdjudicator || GamePlanner.PhaseEndedBy(state, viewAs) == viewAs);

    // The Play streamlining plan, S4: why this view may not end the phase yet, asked of the planner once a state and view (in the RtPh it reads
    // the routs still owed). The adjudicator may end any phase.
    private (GameState? State, string View, string? Bar) phaseEndMemo;

    private string? PhaseEndBarNow
    {
        get
        {
            if (state is null || history is null || Viewer.IsAdjudicator || state.Phase != "rtph")
            {
                return null;
            }

            if (!ReferenceEquals(phaseEndMemo.State, state) || phaseEndMemo.View != viewAs)
            {
                var bar = Live.Planner.PhaseEndBar(state, history.Events, viewAs);
                phaseEndMemo = (state, viewAs, bar is null ? null : PlainReason(bar));
            }

            return phaseEndMemo.Bar;
        }
    }

    /// <summary>Pass 31 (ruling R5.8): a choice or a surrender waits for its answer, and nothing else is proposed until it has one.</summary>
    private bool WaitsOnAnswer => state is { } waiting && ((waiting.Choice is { } choice && ChoiceShown(choice)) || waiting.PendingSurrenders.Count > 0);

    /// <summary>
    /// Pass 70 (A12.14; ruling R70.21): the viewer's option not to force a "?" loss is shown to its own side and the adjudicator only; to the moving side
    /// the step waits as on any DEFENDER's window.
    /// </summary>
    private bool ChoiceShown(PendingChoice choice) => choice.Kind != ChoicePending.ConcealmentLoss || Viewer.IsAdjudicator || viewAs == choice.Side;

    /// <summary>
    /// Lets the busy state be drawn before the gate is asked (pass 29). A component test that registers <see cref="ImmediateProposals"/> skips the
    /// wait, so the proposal stays on the test's own thread; the Studio never registers it.
    /// </summary>
    private Task DrawBusy() => Services.GetService<ImmediateProposals>() is null ? Yield() : Task.CompletedTask;

    private static async Task Yield() => await Task.Yield();

    /// <summary>Runs a gate call; a failure inside it, such as a reviewed package that no longer verifies, is reported, not thrown.</summary>
    private static async Task<PlayResult> Run(Func<Task<PlayResult>> call)
    {
        try
        {
            return await call();
        }
        catch (InvalidOperationException exception)
        {
            return new PlayResult(PlayOutcome.Failed, new LimboDancer.Abstractions.Runtime.CorrelationId("failed"), ["play.error: " + exception.Message], null);
        }
    }

    private async Task Confirm()
    {
        if (pending is not { } proposal || busy)
        {
            return;
        }

        var created = history is null;
        var placed = PlacesCounters(proposal) && placements.Count > 0
            ? (Sides: string.Join(" and ", placements.Select(row => DisplayText.Side(row.Side)).Distinct(StringComparer.Ordinal)),
                From: ChosenPlan is { } from ? $", from {PlanTitle(from)}" + (PlanChanges.Count > 0 ? $" with {Count(PlanChanges.Count, "change", "changes")}" : string.Empty) : string.Empty)
            : ((string Sides, string From)?)null;

        // Plan section 13.4: after a reconnect, another tab, or another viewer's commit, the game is read again first; a proposal made at another
        // revision is stale and is never confirmed (the gate also refuses it by its expected revision).
        var now = gameId.Length > 0 ? Live.History(gameId) : null;
        if (proposal.Revision is { } proposedAt && (now?.Events.Count ?? 0) != proposedAt)
        {
            pending = proposal with
            {
                Result = proposal.Result with
                {
                    Outcome = PlayOutcome.Stale,
                    Reasons = [Viewer.IsAdjudicator || state?.Ended is not null
                        ? $"The game is at revision {now?.Events.Count ?? 0}; this proposal was made at revision {proposedAt}."
                        : "The game has moved on since this proposal was made. Propose again."],
                },
            };
            status = OutcomeText(PlayOutcome.Stale, false);
            Refresh();
            return;
        }

        (busy, status) = (true, "Confirming.");
        var asked = AskedBy;

        // D10.1 (pass 65, the UI review): whether the vehicle an ordnance shot names was a wreck before it, so only such a wreck stays named after it.
        var wreckBefore = ordnanceVehicle.Length > 0 && state?.Unit(ordnanceVehicle) is { Status: InstanceStatus.Wrecked };
        PlayResult result;
        try
        {
            StateHasChanged();
            await DrawBusy();
            result = await Run(() => Live.Play.ConfirmAsync(proposal.Action, proposal.Arguments, Live.PrincipalFor(proposal.Action, Viewer), proposal.Result.Correlation));
        }
        finally
        {
            busy = false;
        }

        if (AskedBy != asked)
        {
            status = string.Empty;
            Refresh();
            return;
        }

        status = $"{proposal.Action.Name}: {OutcomeText(result.Outcome, false)}";
        pending = proposal with { Result = result };
        if (result.Outcome is PlayOutcome.Committed or PlayOutcome.Replay)
        {
            // The Play streamlining plan, S8 (ruling Q15): a step made outside a plan that opened the DEFENDER's window is passed for him when his pass
            // for the phase covers it.
            if (proposal.Action == GameActions.Move || proposal.Action == GameActions.MoveVehicle)
            {
                await Live.Plans.PassDeclared(gameId);
            }

            // A committed action's choices are spent: the next one starts from nothing.
            // D3.12 (review of pass 50): the turret choice is spent with the step that carried it, and kept through a refusal or a cancel.
            if (proposal.Action == GameActions.MoveVehicle)
            {
                vehicleTurret = string.Empty;
            }

            // D2.401 (the UI review of pass 55): the VCA and TCA named for an attempt are spent with it.
            if (proposal.Action == GameActions.MotionAttempt)
            {
                (motionFacing, motionTurret) = (string.Empty, string.Empty);
            }

            if (proposal.Action == GameActions.Setup)
            {
                // Pass 71's fixes (R5's finding 15): the hex chosen for a Sniper counter is spent with its placement, so the next side's list starts empty.
                sniperHex = string.Empty;
                if (PlacesCounters(proposal))
                {
                    ClearPlacements();
                    shownPlan = null;
                }
            }
            else if (proposal.Action == GameActions.Fire)
            {
                ClearFire();
            }
            else if (proposal.Action == GameActions.ThrowDc)
            {
                // The UI review, pass 35: the DC is spent, so its draft goes with it, and the AFV it named (pass 60).
                throwDc = throwDcAt = throwDcVehicle = string.Empty;
            }
            else if (proposal.Action == GameActions.FireOrdnance)
            {
                // The UI review, pass 35: a shot may wreck its target or break its Spotter, and Intensive Fire is declared for one shot. The weapon
                // and the Location stay for a weapon that keeps its ROF.
                ordnanceIntensive = false;
                // D10.1 (pass 65): a wreck stays named until it burns, when it was a wreck before the shot; a vehicle the shot wrecked is not named again.
                if (state?.Unit(ordnanceVehicle) is not { Status: InstanceStatus.Active } && !(wreckBefore && state?.Unit(ordnanceVehicle) is { Status: InstanceStatus.Wrecked } wreck
                    && !Live.Planner.Burns(state, wreck)))
                {
                    ordnanceVehicle = string.Empty;
                }

                // C9.3 (the C9.3 claim, review finding 4): a Spotter the calculator no longer offers is cleared, not judged here.
                if (state?.Unit(ordnanceSpotter)?.Side is not { } spotterSide || OrdnanceSpotters(spotterSide) is not { } offered
                    || offered.All(choice => choice.Id != ordnanceSpotter))
                {
                    ordnanceSpotter = string.Empty;
                }

                if (state?.Unit(ordnanceDirector) is not { Status: InstanceStatus.Active } director || GameState.Condition(director, Conditions.Broken) == ConditionState.True)
                {
                    ordnanceDirector = string.Empty;
                }
            }
            else if (proposal.Action == GameActions.EndMove)
            {
                moveTo = moveExit = moveKeep = string.Empty;
                moveAssault = false;
                moveDoubleTime = false;
                moveMinimum = false;
                moveTerrainRate = false;
                moveDash = string.Empty;
                moveOverrun = false;
                moveIpcTo = moveCarry = moveCarryBy = string.Empty;
                moveBypass = string.Empty;
            }
            else if (proposal.Action == GameActions.Move)
            {
                // A4.5: Double Time is declared for one step, not kept for the next; so are a Minimum Move and a Bypass.
                moveDoubleTime = false;
                moveMinimum = false;
                moveTerrainRate = false;
                moveDash = string.Empty;
                moveOverrun = false;
                moveIpcTo = moveCarry = moveCarryBy = string.Empty;
                moveBypass = string.Empty;
            }
            else if (proposal.Action == GameActions.MoveVehicle)
            {
                // D7.1, B13.41, D2.15, D2.5 (table-player finding, pass 11): an OVR, an ALL entry, a Minimum Move, and ESB are declared for one expenditure.
                vehicleOverrun = false;
                vehicleAllMp = false;
                vehicleMinimum = false;
                vehicleRiders = false;
                vehicleCrewUnload = false;
                vehicleEsb = string.Empty;

                // Rulings R26.1, R26.2: the Passengers chosen and the entry are for one expenditure too.
                vehicleLoad.Clear();
                vehicleUnload.Clear();
                vehicleLeave.Clear();
                vehicleEntryHex = string.Empty;
                vehicleEntryFacing = string.Empty;
            }
            else if (proposal.Action == GameActions.HookGun)
            {
                hookBoards = false;
            }
            else if (proposal.Action == GameActions.VehicleCloseCombat)
            {
                ClearVehicleCc();
            }
            else if (proposal.Action == GameActions.AbandonVehicle)
            {
                // Pass 65 (the UI review): a self-destruction or MG Removal is chosen for one Abandonment, not kept for the next.
                abandonDestroy = string.Empty;
                abandonRemoveMg = false;
            }
            else if (proposal.Action == GameActions.RecrewVehicle || proposal.Action == GameActions.Scrounge)
            {
                // The unit chosen for the vehicle has acted.
                if (proposal.Arguments.TryGetProperty("vehicleId", out var acted) && acted.GetString() is { } actedOn)
                {
                    (proposal.Action == GameActions.Scrounge ? scroungePicks : recrewPicks).Remove(actedOn);
                }
            }
            else if (proposal.Action == GameActions.Rally)
            {
                rallyUnit = string.Empty;
                rallyLeader = string.Empty;
            }
            else if (proposal.Action == GameActions.Repair)
            {
                repairWeapon = string.Empty;
            }
            else if (proposal.Action == GameActions.Rout)
            {
                routUnit = string.Empty;
                routRoute = string.Empty;
                routKeep = string.Empty;
                routLowCrawl = false;
                routLeader = string.Empty;
            }
            else if (proposal.Action == GameActions.VoluntaryBreak)
            {
                voluntaryBreak.Clear();
            }
            else if (proposal.Action == GameActions.RemoveConcealment)
            {
                removeConcealment.Clear();
            }
            else if (proposal.Action == GameActions.Deploy || proposal.Action == GameActions.Recombine)
            {
                deploySquad = deployLeader = deploySpotterHalf = string.Empty;
                deployWeapons.Clear();
                recombineOne = recombineTwo = recombineLeader = string.Empty;
            }
            else if (proposal.Action == GameActions.Transfer || proposal.Action == GameActions.Drop || proposal.Action == GameActions.Recover || proposal.Action == GameActions.Dismantle)
            {
                swWeapon = swUnit = string.Empty;
            }
            else if (proposal.Action == GameActions.AdvancePhase)
            {
                retainDm.Clear();
            }
            else if (proposal.Action == GameActions.Advance)
            {
                advanceUnits.Clear();
                advanceTo = string.Empty;
                advanceExit = string.Empty;
            }
            else if (proposal.Action == GameActions.CloseCombat)
            {
                ClearCloseCombatDraft();
            }

            // Table player and UI review, pass 29: Confirm is gone with the commit, so the focus goes to the actions; under 1024px their tab opens.
            // Wider, the Proposal tab stays open, so the outcome and its rolls stay in view; the Play tab is a click away.
            activityTab = null;
            if (narrow)
            {
                ShowActions();
            }
        }

        Refresh();

        // UI review, pass 31: the stacking of the Location is read again from the state the round left, not the one it began from.
        if (result.Outcome is PlayOutcome.Committed or PlayOutcome.Replay && proposal.Action == GameActions.CloseCombat)
        {
            DefaultStacking();
        }

        if (result.Outcome is PlayOutcome.Committed or PlayOutcome.Replay && proposal.Action == GameActions.Setup && state is not null)
        {
            // Pass 30: what was set up, and who sets up next, said where the setup bar is.
            if (placed is { } done)
            {
                var onMap = SettingUpSide;
                var next = onMap ?? SetupView?.Groups.FirstOrDefault(group => group.OffBoard.Count > 0)?.Side;
                setupDone = ($"The {done.Sides} setup is in the game{done.From}. "
                    + (next is null ? "Every group has set up. Each side may now place a \"?\" on its stacks out of the enemy's LOS (A12.12), under Counters; the first action of play closes the setup."
                        : onMap is not null ? $"Next: the {DisplayText.Side(next)} side sets up."
                        : $"Next: the {DisplayText.Side(next)} side sets up the counters that enter, off board."), next);
            }

            // Pass 30: a new game's id goes into the address, so a reload opens it again; and when a side sets up next, the game opens behind that
            // side's hand-over (ruling R23.2), as a game opened later does. A card with no OB group has no side setting up, and stays in the view.
            if (created)
            {
                Navigation.NavigateTo(Navigation.GetUriWithQueryParameters(new Dictionary<string, object?> { ["game"] = gameId, ["hex"] = null }), replace: true);
                if (SettingUpSide is { } settingUp)
                {
                    viewAs = settingUp;
                    (handOver, unconfirmed) = (viewAs, true);
                }
            }
        }
    }

    private static string Attempt(string kind) => $"{kind}-{Guid.NewGuid():N}"[..(kind.Length + 13)];

    // The Play streamlining plan, S3 and S6: the route the moving side plots on the map, read again only when the state, the stack, or the route
    // changes (the plot and its marks are kept between renders), and the plan that makes it.
    private bool plotOn;
    private readonly List<BoardLocation> plotRoute = [];
    private int plotVersion;
    private MovementPlot? plot;
    private (GameState? State, string Movers, int Version) plotFor;
    private string? plotMarks;
    private string? plotNote;

    /// <summary>The plan being made in this game, or null.</summary>
    // A plan left over from an ended move or phase is let go when read against the game as it stands; never while the page is making a step,
    // when the state it holds is the one from before the step.
    private MovementPlan? PlanNow => gameId.Length == 0 ? null : busy || state is null ? Live.Plans.Of(gameId) : Live.Plans.Of(gameId, state);

    /// <summary>The DEFENDER of the moving side's MPh: the other side.</summary>
    private string DefenderSide => state?.Sides.Select(side => side.Id).FirstOrDefault(id => id != state.PhasingSide) ?? string.Empty;

    /// <summary>Plots the route again when the state, the stack, or the route has changed since the last plot; otherwise keeps it.</summary>
    private void RefreshPlot()
    {
        if (!plotOn || state is null || history is null || moveUnits.Count == 0 || handOver is not null || state.PhasingSide is not { } mover)
        {
            (plot, plotMarks) = (null, null);
            return;
        }

        var movers = moveUnits.Order(StringComparer.Ordinal).ToArray();
        var key = (state, string.Join(",", movers), plotVersion);
        if (plot is not null && ReferenceEquals(plotFor.State, state) && plotFor.Movers == key.Item2 && plotFor.Version == plotVersion)
        {
            return;
        }

        plotFor = key;
        plot = Live.Planner.Plot(new GameScope(LivePlay.Tenant, gameId), history.Events, movers, plotRoute, mover);
        plotMarks = PlotMarks();
    }

    /// <summary>The route and the Locations its end may enter, drawn as marks: the counters are not drawn again for a route.</summary>
    private string? PlotMarks()
    {
        if (plot is null || MapLayers is not { Board: { } board })
        {
            return null;
        }

        var marks = new System.Text.StringBuilder();
        foreach (var step in plot.Route)
        {
            marks.Append(GameMaps.HexMark(board, step.To, "plot-route", "#244f7740", "#244f77", 4, false, $"{Mf(step.HalfMfLeft)} left"));
        }

        foreach (var option in plot.Next)
        {
            if (option.Refusal is null)
            {
                marks.Append(GameMaps.HexMark(board, option.To, "plot-option", "#3f5a2230", "#3f5a22", 2, true, $"{Mf(option.HalfMf)} MF"));
            }
        }

        return marks.ToString();
    }

    /// <summary>Half MF in words, such as "1½"; "?" when not known.</summary>
    private static string Mf(int? halfMf) => halfMf is not { } half ? "?" : $"{half / 2}{(half % 2 == 1 ? "½" : string.Empty)}";

    /// <summary>A refusal in the page's words, without its code and with the units' names for their ids, as the route and rally panels say it.</summary>
    private string PlainReason(string reason) => Said(reason) ?? reason;

    /// <summary>
    /// A berserk unit's charge the model does not decide (ruling R30.5), or one that reaches no Known enemy unit (A15.45, A15.44; pass 72, ruling R72.4), in the
    /// page's words: the unit by its name and hex, every hex in brackets, no code.
    /// </summary>
    private string ChargeUndecidedLine(UnitInstance unit, BoardLocation? target, string undecided)
    {
        var why = Words(DisplayText.Reason(undecided).Text);
        return ScenarioA1ChargeCalculator.NoneReachable(undecided)
            ? $"{WordsAt(unit.Id)} is berserk and stays in place: {why}"
            : $"{WordsAt(unit.Id)} is berserk, but its charge{(target is { } at ? $" at {PlaceOf(at)}" : string.Empty)} is not decided here: {why}";
    }

    // The Play streamlining plan, S4: why the Rally attempt chosen would be refused, asked of the planner once a state, unit, and leader.
    private (GameState? State, string Unit, string Leader, string? Bar) rallyBarMemo;

    private string? RallyBarNow
    {
        get
        {
            if (state is null || history is null || rallyUnit.Length == 0 || !RallyChoices.Any(choice => choice.Id == rallyUnit))
            {
                return null;
            }

            if (!ReferenceEquals(rallyBarMemo.State, state) || rallyBarMemo.Unit != rallyUnit || rallyBarMemo.Leader != rallyLeader)
            {
                var bar = Live.Planner.RallyBar(new GameScope(LivePlay.Tenant, gameId), history.Events, rallyUnit, rallyLeader.Length > 0 ? rallyLeader : null);
                rallyBarMemo = (state, rallyUnit, rallyLeader, bar is null ? null : PlainReason(bar));
            }

            return rallyBarMemo.Bar;
        }
    }

    private IReadOnlyList<string> PlotSteps => plot is null ? [] : [.. plot.Route.Select(step => $"{PlaceOf(step.To.ToString())}: {Mf(step.HalfMf)} MF, {Mf(step.HalfMfLeft)} left")];

    private string? PlotStop => plot?.Stop is not { } stop ? null
        : plot.Route.Count < plotRoute.Count ? $"The route stops before {PlaceOf(plotRoute[plot.Route.Count].ToString())}: {PlainReason(stop)}" : PlainReason(stop);

    private bool PlotCanMove => plot is not null && plotRoute.Count > 0 && plot.Route.Count == plotRoute.Count;

    private void TogglePlot()
    {
        plotOn = !plotOn;
        planNote = null;
        plotRoute.Clear();
        (plotVersion, plotNote) = (plotVersion + 1, null);
        RefreshPlot();
    }

    private void UndoPlot()
    {
        if (plotRoute.Count > 0)
        {
            plotRoute.RemoveAt(plotRoute.Count - 1);
            (plotVersion, plotNote) = (plotVersion + 1, null);
            RefreshPlot();
        }
    }

    private void ClearPlot()
    {
        plotRoute.Clear();
        (plotVersion, plotNote) = (plotVersion + 1, null);
        RefreshPlot();
    }

    /// <summary>A hex clicked while plotting: the Location of it the route's end may enter is added, or the panel says why it may not be.</summary>
    private void AddToRoute(BoardLocation at)
    {
        RefreshPlot();
        if (plot is null)
        {
            return;
        }

        var sameHex = plot.Next.Where(option => option.To.Board == at.Board && option.To.Hex == at.Hex).ToArray();
        if ((sameHex.FirstOrDefault(option => option.Refusal is null && option.To.Level == 0) ?? sameHex.FirstOrDefault(option => option.Refusal is null)) is { } chosen)
        {
            plotRoute.Add(chosen.To);
            (plotVersion, plotNote) = (plotVersion + 1, null);
            RefreshPlot();
            return;
        }

        plotNote = sameHex.Length > 0 ? $"{PlaceOf(at.ToString())}: {PlainReason(sameHex[0].Refusal!)}" : $"{PlaceOf(at.ToString())} is not next to the route's end.";
    }

    /// <summary>The plotted route is made: its first step now, then the DEFENDER decides where he could fire (the plan's S6).</summary>
    private async Task MoveAlongRoute()
    {
        if (busy || !PlotCanMove || state?.PhasingSide is not { } mover)
        {
            return;
        }

        var plan = new MovementPlan(gameId, [.. moveUnits.Order(StringComparer.Ordinal)], [.. plotRoute], moveAssault, moveDoubleTime, mover, DefenderSide, Attempt("plan"));
        await RunPlan(() => Live.Plans.Start(plan));
        (plotOn, plot, plotMarks, plotNote) = (false, null, null, null);
        plotRoute.Clear();
    }

    private Task PlanMoveOn(bool toEnd) => RunPlan(() => Live.Plans.MoveOn(gameId, toEnd));

    private Task PlanContinue() => RunPlan(() => Live.Plans.Continue(gameId));

    private void PlanChange()
    {
        Live.Plans.Drop(gameId);
        plotOn = true;
        plotRoute.Clear();
        (plotVersion, plotNote) = (plotVersion + 1, null);
        RefreshPlot();
    }

    private Task PlanEnd()
    {
        Live.Plans.Drop(gameId);
        return ProposeEndMove();
    }

    /// <summary>Runs a step of the plan with the page busy, then reads the game again and says what happened.</summary>
    private async Task RunPlan(Func<Task<MovementPlanRun>> work)
    {
        if (busy)
        {
            return;
        }

        (busy, status) = (true, "Moving along the route.");
        var fromQueue = Live.Plans.HasQueue(gameId);
        MovementPlanRun run;
        try
        {
            StateHasChanged();
            await DrawBusy();
            run = await work();

            // The Play streamlining plan, S8 (ruling Q13): a route that ends with Movement Plan stacks still to move starts the next at once.
            if (run.Turn == MovementPlanTurn.Done && Live.Plans.HasQueue(gameId) && state?.PhasingSide is { } planMover)
            {
                var queued = await Live.Plans.RunQueue(gameId, planMover, DefenderSide);
                run = queued.Turn == MovementPlanTurn.Done ? queued with { Note = $"{run.Note} {queued.Note}" } : queued;
            }
        }
        finally
        {
            busy = false;
        }

        status = run.Refusal.Count > 0 ? $"{run.Note} {PlainReason(run.Refusal[0])}" : run.Note;
        planQueueNote = fromQueue ? status : planQueueNote;
        planFinished = fromQueue && run.Turn == MovementPlanTurn.Done && !Live.Plans.HasQueue(gameId);

        // A plan that ended or waits for the moving side: its view, when it comes back, is told so in the header.
        planHandedBack = run.Turn != MovementPlanTurn.Defender && state?.PhasingSide is { } moving && viewAs != moving ? (moving, status) : null;
        planNote = run.Turn != MovementPlanTurn.Defender && viewAs == state?.PhasingSide ? status : null;
        Refresh();
    }

    /// <summary>A plan's end, or its pause, to tell the moving side's view when the screen comes back to it; null when there is none.</summary>
    private (string Side, string Note)? planHandedBack;

    /// <summary>How the moving side's last plan ended, shown over the route panel until the next route is plotted.</summary>
    private string? planNote;

    // The Play streamlining plan, S8: the Movement Plan's stacks and routes as the moving side drafts them, for one Movement Phase. The draft is the
    // page's; "Move every planned stack" hands its routes to the plan store's queue, which makes them.
    private sealed class PlanStack(string key, List<string> movers)
    {
        public string Key { get; } = key;

        public List<string> Movers { get; } = movers;

        public List<BoardLocation> Route { get; } = [];
    }

    private readonly List<PlanStack> planStacks = [];
    private (int Turn, string? Phasing) planStacksFor;
    private GameState? planStacksState;
    private int planStackCount;
    private string? planPlotting;
    private string? planQueueNote;
    private bool planFinished;
    private int planVersion;
    private (GameState? State, int Version, string? Marks) plannerMarks;

    /// <summary>Whether the view may draft the Movement Plan now: the moving side's own view (not the adjudicator's), in its MPh, with no hand-over.</summary>
    private bool PlannerOpen => state is { Phase: "mph" } && !Viewer.IsAdjudicator && viewAs == state.PhasingSide && handOver is null;

    /// <summary>
    /// The stacks of the plan, kept in step with the units that may still move (ruling Q14): a unit that has moved leaves its stack, an empty stack
    /// goes, and a unit not yet in one joins a new stack with the others of its Location. Read once a state.
    /// </summary>
    private IReadOnlyList<PlanStack> PlanStacks
    {
        get
        {
            if (!PlannerOpen)
            {
                return [];
            }

            if (planStacksFor != (state!.Turn, state.PhasingSide))
            {
                (planStacksFor, planStacksState, planPlotting, planQueueNote) = ((state.Turn, state.PhasingSide), null, null, null);
                planStacks.Clear();
            }

            if (ReferenceEquals(planStacksState, state))
            {
                return planStacks;
            }

            planStacksState = state;

            // A4.2: while a stack moves, no other may, so the units that may move are only its own; the plan keeps its other stacks as drafted
            // and lets go only of the units whose move has ended.
            if (state.Movement is not null)
            {
                foreach (var stack in planStacks)
                {
                    stack.Movers.RemoveAll(id => state.Unit(id) is not { Status: InstanceStatus.Active, MovementEnded: false });
                }

                planStacks.RemoveAll(stack => stack.Movers.Count == 0);
                return planStacks;
            }

            var candidates = MoveCandidates.Where(unit => state.Location(unit.Id) is not null).ToDictionary(unit => unit.Id, StringComparer.Ordinal);
            foreach (var stack in planStacks)
            {
                stack.Movers.RemoveAll(id => !candidates.ContainsKey(id));
            }

            planStacks.RemoveAll(stack => stack.Movers.Count == 0);
            var placed = planStacks.SelectMany(stack => stack.Movers).ToHashSet(StringComparer.Ordinal);
            foreach (var group in candidates.Values.Where(unit => !placed.Contains(unit.Id)).GroupBy(unit => state.Location(unit.Id)!.Location.ToString())
                .OrderBy(group => group.Key, StringComparer.Ordinal))
            {
                // The user, 2026-10-21: a stack's leader first.
                planStacks.Add(new PlanStack($"stack-{++planStackCount}", [.. group.OrderBy(unit => unit.Kind == "asl:leader" ? 0 : 1).ThenBy(unit => unit.Id, StringComparer.Ordinal)
                    .Select(unit => unit.Id)]));
            }

            return planStacks;
        }
    }

    private IReadOnlyList<MovementPlanPanel.Row> PlannerRows => [.. PlanStacks.Select(stack =>
    {
        var plotting = stack.Key == planPlotting;
        var route = plotting ? plotRoute : stack.Route;
        var left = plotting && plot?.Route is [.., var last] ? $"; {Mf(last.HalfMfLeft)} MF left" : string.Empty;
        var words = route.Count == 0 ? "No route planned: plot one, or it stays where it is." : string.Join(", ", route.Select(at => PlaceOf(at.ToString()))) + left;
        return new MovementPlanPanel.Row(stack.Key, [.. stack.Movers.Select(id => new PlayChoice(id, WordsAt(id)))],
            Moving(stack) ? $"Moving: {words}" : words, route.Count > 0, plotting);
    })];

    private string? PlannerClosed => PlannerOpen ? null
        : state?.Phase != "mph" ? "The Movement Plan is made in your side's Movement Phase."
        : Viewer.IsAdjudicator ? "The Movement Plan is the moving side's: choose its view."
        : handOver is not null ? "Hand the screen over first." : "The Movement Plan is the moving side's.";

    /// <summary>Starts plotting a stack's route on the map, or, with null, keeps the route plotted and stops.</summary>
    private void PlanPlot(string? key)
    {
        if (planPlotting is { } current && PlanStacks.FirstOrDefault(stack => stack.Key == current) is { } plotted)
        {
            plotted.Route.Clear();
            plotted.Route.AddRange(plotRoute.Take(plot?.Route.Count ?? 0));
        }

        (planPlotting, planQueueNote, plotNote) = (null, null, null);
        plotOn = false;
        plotRoute.Clear();
        if (key is not null && PlanStacks.FirstOrDefault(stack => stack.Key == key) is { } chosen)
        {
            planPlotting = key;
            moveUnits.Clear();
            moveUnits.UnionWith(chosen.Movers);
            plotRoute.AddRange(chosen.Route);
            plotOn = true;
        }

        (plotVersion, planVersion) = (plotVersion + 1, planVersion + 1);
        RefreshPlot();
    }

    private void PlanClear(string key)
    {
        if (PlanStacks.FirstOrDefault(stack => stack.Key == key) is { } stack)
        {
            stack.Route.Clear();
            planVersion++;
        }
    }

    private void PlanReorder((string Row, int By) move)
    {
        var index = planStacks.FindIndex(stack => stack.Key == move.Row);
        var to = index + move.By;
        if (index >= 0 && to >= 0 && to < planStacks.Count)
        {
            (planStacks[index], planStacks[to]) = (planStacks[to], planStacks[index]);
        }
    }

    /// <summary>A unit unticked leaves its stack for a stack of its own in the same Location (ruling Q14); the routes are plotted again.</summary>
    private void PlanSplit((string Row, string Unit) split)
    {
        var index = planStacks.FindIndex(stack => stack.Key == split.Row);
        if (index < 0 || planStacks[index].Movers.Count < 2 || !planStacks[index].Movers.Remove(split.Unit))
        {
            return;
        }

        if (planPlotting == split.Row)
        {
            PlanPlot(null);
        }

        planStacks[index].Route.Clear();
        planStacks.Insert(index + 1, new PlanStack($"stack-{++planStackCount}", [split.Unit]));
        planVersion++;
    }

    /// <summary>The planned routes go to the plan store's queue, in the rows' order, and are made (rulings Q12, Q13).</summary>
    private async Task PlanRun()
    {
        PlanPlot(null);
        if (state?.PhasingSide is not { } mover)
        {
            return;
        }

        // The draft keeps its routes: a stack leaves it when its move ends, and a plan that stops leaves the rest of the routes here to make again.
        Live.Plans.SetQueue(gameId, state, [.. PlanStacks.Where(stack => stack.Route.Count > 0 && !Moving(stack)).Select(stack => new QueuedRoute([.. stack.Movers], [.. stack.Route]))]);
        planVersion++;
        await RunPlan(() => Live.Plans.RunQueue(gameId, mover, DefenderSide));
    }

    /// <summary>Whether the stack's units are the stack moving now.</summary>
    private bool Moving(PlanStack stack) => state?.Movement is { } movement && stack.Movers.Any(id => movement.Members.Contains(id, StringComparer.Ordinal));

    /// <summary>The routes of the plan's other stacks, drawn faintly while the Movement Plan is open (the plot draws the one being plotted).</summary>
    // The user, 2026-10-22: the stack the DEFENDER's window waits on, outlined while the moving side waits; one mark, kept for its state.
    private (GameState? State, string? Mark) waitingMark;

    private string? WaitingMark(StudioBoard board)
    {
