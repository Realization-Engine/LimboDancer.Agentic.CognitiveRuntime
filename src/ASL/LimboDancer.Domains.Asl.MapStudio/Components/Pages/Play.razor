    /// <summary>
    /// The units that may board the vehicle (D6.4): of its side, on foot in its Location, not done moving, Good Order and unpinned, while it is stopped, not in
    /// Motion, and has spent no MP this MPh. While an Infantry stack moves, only its members, as the last step of their move once the DEFENDER passes
    /// (pass 65, ruling R65.15).
    /// </summary>
    private IReadOnlyList<string> LoadableUnits(UnitInstance vehicle)
    {
        if (state is null || state.Movement is { Vehicle: true } or { WindowOpen: true } || vehicle.Position is not MapPosition || vehicle.MfSpent != 0 || vehicle.HalfMfSpent
            || GameState.Condition(vehicle, Conditions.Motion) == ConditionState.True
            || (GamePlanner.PassengerCapacity(state, vehicle) is null && GamePlanner.RiderCapacityOf(vehicle) is null)
            || state.Location(vehicle.Id)?.Location is not { } at)
        {
            return [];
        }

        var members = state.Movement?.Members;
        return [.. SeenOnly(state.At(at).OfType<UnitInstance>().Where(unit => unit.Status == InstanceStatus.Active && unit.Side == vehicle.Side && !LiveFire.IsVehicle(unit)
            && unit.Kind != UnitKinds.Dummy && Library.Vocabulary.IsA(unit.Kind, "asl:personnel") && !unit.MovementEnded && (members is null || members.Contains(unit.Id))
            && GameState.Condition(unit, Conditions.Broken) != ConditionState.True && GameState.Condition(unit, Conditions.Pinned) != ConditionState.True))
            .Select(unit => unit.Id).Order(StringComparer.Ordinal)];
    }

    /// <summary>
    /// The chosen vehicle's Rider capacity and what is left of it (D6.2; pass 65, ruling R65.16): "14 PP, 4 left", or "one SMC"; null when it takes no
    /// Riders.
    /// </summary>
    private string? RiderNote(UnitInstance vehicle) =>
        state is null || GamePlanner.RiderCapacityOf(vehicle) is not { } capacity ? null
            : capacity.OneSmc ? "one SMC and the two PP he possesses"
            : $"{capacity.Pp} PP, {Live.Planner.RiderPpLeft(state, vehicle)} left";

    /// <summary>Whether the units board the chosen vehicle as Riders: when asked, and always on one that takes no Passengers (D6.2); the planner asks Rules.</summary>
    private bool BoardsAsRiders(UnitInstance vehicle) => state is not null && GamePlanner.BoardsAsRiders(state, vehicle, vehicleRiders);

    /// <summary>
    /// The SW the chosen vehicle's Passengers hold, which a halftrack or Carrier keeps aboard as they unload (D6.4; pass 65, ruling R65.15), each named by
    /// its hex, itself, and its holder, "[F8]: LMG of 4-6-7 squad G1" (the UI review; the hex UI rule).
    /// </summary>
    private IReadOnlyList<PlayChoice> LeavableWeapons(UnitInstance vehicle)
    {
        if (state is null || UnloadableUnits(vehicle) is not { Count: > 0 } aboard || !GamePlanner.KeepsSwAboard(vehicle))
        {
            return [];
        }

        var where = UnitPlaceOf(vehicle.Id)?.Where;
        // A SW reads "the LMG" in a sentence; in a list it is "LMG".
        static string Bare(string said) => said.StartsWith("the ", StringComparison.Ordinal) ? said[4..] : said;
        return [.. VisibleEquipment.Where(item => item.Status == InstanceStatus.Active && item.Holding is { Role: HoldingRole.Possessed } holding && aboard.Contains(holding.Holder))
            .OrderBy(item => item.Id, StringComparer.Ordinal)
            .Select(item => new PlayChoice(item.Id, (where is null ? string.Empty : $"{where}: ") + $"{Bare(Words(item.Id))} of {Words(item.Holding!.Holder)}"))];
    }

    /// <summary>Whether the chosen vehicle, stopped, is a Carrier whose inherent HS may unload as its Passengers do (D6.83; pass 65, ruling R65.18).</summary>
    private bool CrewUnloads(UnitInstance vehicle) =>
        state is not null && VehicleStopped(vehicle, boggedToo: ScenarioA1VehicleProjection.BoggedMaySpend("unload", false)) && GamePlanner.CrewMayUnload(state, vehicle);

    /// <summary>The Passengers that may unload (D6.5): the vehicle's, while it is on the map and stopped.</summary>
    private IReadOnlyList<string> UnloadableUnits(UnitInstance vehicle) =>
        state is null || !VehicleStopped(vehicle, boggedToo: ScenarioA1VehicleProjection.BoggedMaySpend("unload", false)) ? []
            // Who rides the vehicle comes from the planner's index, once per state (ruling R65.25), not a scan of the state each render.
            : [.. Live.Planner.Riding(state, vehicle.Id).Select(unit => unit.Id).Order(StringComparer.Ordinal)];

    /// <summary>The Guns in a stopped vehicle's hex it may hook up or unhook (C10.11, C10.12).</summary>
    private IReadOnlyList<VehicleTowingActions.TowChoice> TowChoices(UnitInstance vehicle) =>
        state is null || !VehicleStopped(vehicle) || state.Location(vehicle.Id)?.Location is not { } at ? []
            : [.. VisibleEquipment.Where(item => item.Status == InstanceStatus.Active && item.Kind == "asl:gun" && state.Location(item.Id)?.Location == at
                && (item.Holding is { Role: HoldingRole.Manned } || (item.Holding is { Role: HoldingRole.Towed } tow && tow.Holder == vehicle.Id)))
                .Select(item => new VehicleTowingActions.TowChoice(item.Id, item.Holding is { Role: HoldingRole.Towed }))];

    private Task ProposeVehicleRequest(VehicleStepChoices.StepRequest request) => request.Kind switch
    {
        "resolve-ovr" => ProposeOverrun(),
        "load" or "unload" => ProposeVehicleLoad(request.Kind),
        _ => ProposeVehicleStep(request.Kind, request.To, request.Facing, request.Edge, request.Reverse, request.Bypass),
    };

    private void SetVehicleOption((string Option, bool Value) option)
    {
        switch (option.Option)
        {
            case "overrun":
                vehicleOverrun = option.Value;
                break;
            case "allMp":
                vehicleAllMp = option.Value;
                break;
            case "minimum":
                vehicleMinimum = option.Value;
                break;
            case "riders":
                vehicleRiders = option.Value;
                break;
            case "crew":
                vehicleCrewUnload = option.Value;
                break;
        }
    }

    /// <summary>
    /// Infantry boarding the chosen vehicle, or its Passengers disembarking (D6.4, D6.5; ruling R26.2), with the SW they leave aboard a halftrack or Carrier
    /// (pass 65, ruling R65.15).
    /// </summary>
    private Task ProposeVehicleLoad(string kind)
    {
        var vehicle = state?.Unit(vehicleUnit);
        var arguments = new Dictionary<string, object>
        {
            ["gameId"] = gameId,
            ["attemptId"] = Attempt("vehicle"),
            ["expectedRevision"] = (long)history!.Events.Count,
            ["vehicleId"] = vehicleUnit,
            ["kind"] = kind,
            ["units"] = (kind == "load" ? vehicleLoad : vehicleUnload)
                .Intersect(vehicle is not null ? kind == "load" ? LoadableUnits(vehicle) : UnloadableUnits(vehicle) : [], StringComparer.Ordinal)
                .Order(StringComparer.Ordinal).ToArray(),
        };
        if (kind == "unload" && vehicle is not null && vehicleLeave.Intersect(LeavableWeapons(vehicle).Select(weapon => weapon.Id), StringComparer.Ordinal).Order(StringComparer.Ordinal).ToArray() is { Length: > 0 } leave)
        {
            arguments["leave"] = leave;
        }

        // D6.83 (pass 65, ruling R65.18): a Carrier's inherent HS unloads with the step when asked.
        if (kind == "unload" && vehicle is not null && vehicleCrewUnload && CrewUnloads(vehicle))
        {
            arguments["crew"] = true;
        }

        // D6.2 (pass 65, ruling R65.16): a load names Riders when they board as Riders.
        if (kind == "load" && vehicle is not null && BoardsAsRiders(vehicle))
        {
            arguments["riders"] = true;
        }

        return Propose(GameActions.MoveVehicle, JsonSerializer.SerializeToElement(arguments));
    }


    private const string DummyPrefix = "dummy:";

    // A14.2 (backlog pass 15): a side's Sniper counter, placed at setup.
    private const string SniperPrefix = "sniper:";
    private string firstSan = string.Empty;
    private string secondSan = string.Empty;

    /// <summary>A proposal, its result, and the revision it was proposed at (pass 28c: a Confirm at another revision is stale).</summary>
    private sealed record Proposal(ActionDescriptor Action, JsonElement Arguments, PlayResult Result, long? Revision = null);

    private string gameId = string.Empty;
    private string? originGame;
    private IReadOnlyDictionary<string, CampaignCounterOrigin> counterOrigins = new Dictionary<string, CampaignCounterOrigin>();

    private CampaignCounterOrigin? CounterOrigin(string id)
    {
        if (originGame != gameId)
        {
            originGame = gameId;
            counterOrigins = new Dictionary<string, CampaignCounterOrigin>();
            if (gameId.StartsWith("campaign-", StringComparison.Ordinal) && Services.GetService<CampaignImport>() is { } imports)
            {
                try
                {
                    counterOrigins = CampaignCounterOrigin.Read(imports.ReadContext(gameId));
                }
                catch (Exception error) when (error is IOException or UnauthorizedAccessException or InvalidDataException)
                {
                    // Missing provenance must not prevent inspection of the live game.
                }
            }
        }
        return counterOrigins.GetValueOrDefault(id);
    }

    private string? ownershipKey;
    private IReadOnlyDictionary<string, string>? mapOwnership;
    private string? parentBoundaryDrawing;
    private bool showParentBoundaries;

    private IReadOnlyDictionary<string, string>? OwnershipFor(StudioBoard board)
    {
        var key = gameId + "/" + board.Ref.Value + "/" + board.Version;
        if (ownershipKey != key)
        {
            ownershipKey = key;
            mapOwnership = null;
            parentBoundaryDrawing = null;
            if (gameId.StartsWith("campaign-", StringComparison.Ordinal) && Services.GetService<CampaignImport>() is { } imports)
            {
                try { mapOwnership = imports.ReadOwnership(gameId, board.Ref.Value, board.Version); }
                catch (Exception error) when (error is IOException or UnauthorizedAccessException or InvalidDataException)
                {
                    // Optional inspection metadata must not interrupt ordinary play.
                }
            }
        }
        return mapOwnership;
    }

