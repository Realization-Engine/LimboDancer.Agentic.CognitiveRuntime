@page "/games/play"
@using System.Globalization
@using System.Text.Json
@using LimboDancer.Abstractions.Actions
@using LimboDancer.Abstractions.Domain
@using LimboDancer.Domains.Asl.Play
@using LimboDancer.Domains.Asl.Units.Catalog
@using LimboDancer.Domains.Asl.Units.State
@inject LivePlay Live
@inject UnitLibrary Library
@inject NavigationManager Navigation
@inject GameMaps GameMaps
@inject StudioLos Los

<PageTitle>Play - ASL Map Studio</PageTitle>

<h2>Play</h2>
<p class="muted">
    Live games are the Studio's chosen game source (D2). Every change is a registered action through the Execution Gate: the Studio proposes it,
    the gate checks it against the current game, boards, and catalog, and it commits only after you confirm. Nothing here edits a game directly.
</p>

<div class="toolbar">
    <label>
        Game
        <select id="play-game" value="@gameId" @onchange="ChangeGame">
            <option value="">a new game</option>
            @foreach (var scope in Live.Games())
            {
                <option value="@scope.Game">@scope.Game</option>
            }
        </select>
    </label>
    @if (state is not null)
    {
        <label>
            View as
            <select id="play-perspective" value="@viewAs" @onchange="@(args => viewAs = args.Value as string ?? viewAs)">
                @foreach (var perspective in state.Perspectives)
                {
                    <option value="@perspective.Name">@(perspective.IsAdjudicator ? "the adjudicator" : perspective.Name)</option>
                }
            </select>
        </label>
        <a id="play-view" href="@Games.BoardLink(ViewTarget, GameLibrary.LivePrefix + gameId, Perspective.Adjudicator, state.Revision)">View on @ViewTarget</a>
    }
</div>

@if (history is null)
{
    <h3>New game</h3>
    <div class="fields">
        <label for="new-id">Game id</label><input id="new-id" value="@newId" @onchange="@(args => newId = args.Value as string ?? string.Empty)" placeholder="village" />
        <label for="new-label">Label</label><input id="new-label" value="@newLabel" @onchange="@(args => newLabel = args.Value as string ?? string.Empty)" />
        <label for="new-board">Boards</label>
        <span>
            <input id="new-board" value="@newBoard" @onchange="@(args => { newBoard = args.Value as string ?? string.Empty; newMap = null; })" />
            <span class="muted">one board, such as bd01, or placed boards, such as bd02@@0,0/r bd01@@0,1 (column, row, /r when reversed)</span>
        </span>
        <label for="new-map">Or a saved map</label>
        <select id="new-map" value="@(newMap ?? string.Empty)" @onchange="ChooseMap">
            <option value="">none</option>
            @foreach (var map in GameMaps.Saved())
            {
                <option value="@map.Ref.Value">@map.Name</option>
            }
        </select>
        <label for="new-first">First side</label>
        <select id="new-first" value="@firstSide" @onchange="@(args => firstSide = args.Value as string ?? firstSide)">
            @foreach (var side in Library.Vocabulary.Sides)
            {
                <option value="@side.Name">@side.Label</option>
            }
        </select>
        <label for="new-second">Second side</label>
        <select id="new-second" value="@secondSide" @onchange="@(args => secondSide = args.Value as string ?? secondSide)">
            @foreach (var side in Library.Vocabulary.Sides)
            {
                <option value="@side.Name">@side.Label</option>
            }
        </select>
    </div>
}
else if (state is not null)
{
    <p id="play-summary">
        <strong>@(history.Current is not null ? $"Revision {state.Revision}" : "The game does not replay")</strong>:
        turn @state.Turn, @Games.PhaseLabel(state.Phase), @state.PhasingSide phasing.
        @(SetupOpen ? "Setup is open." : "Play has started; setup is closed.")
    </p>
}

@if (history is null || SetupOpen)
{
    <h3>Setup</h3>
    <div class="toolbar">
        <label>
            Unit
            <select id="place-definition" value="@placeDefinition" @onchange="@(args => placeDefinition = args.Value as string ?? string.Empty)">
                @foreach (var definition in Definitions)
                {
                    <option value="@definition.Id">@definition.Id (@definition.Nationality @definition.Kind.Replace("asl:", string.Empty, StringComparison.Ordinal))</option>
                }
            </select>
        </label>
        <label>Id <input id="place-id" value="@placeId" @onchange="@(args => placeId = args.Value as string ?? string.Empty)" size="8" /></label>
        <label>Location <input id="place-location" value="@placeLocation" @onchange="@(args => placeLocation = args.Value as string ?? string.Empty)" size="12" /></label>
        <label><input id="place-concealed" type="checkbox" checked="@placeConcealed" @onchange="@(args => placeConcealed = args.Value is true)" /> concealed</label>
        <label><input id="place-hidden" type="checkbox" checked="@placeHidden" @onchange="@(args => placeHidden = args.Value is true)" /> hidden</label>
        <button id="place-add" @onclick="AddPlacement">Add</button>
    </div>
    @if (placements.Count > 0)
    {
        <ul id="place-list">
            @foreach (var placement in placements)
            {
                <li>@placement.Id: @placement.Definition at @placement.Location@(placement.Concealed ? ", concealed" : "")@(placement.Hidden ? ", hidden" : "") <button class="link" @onclick="() => placements.Remove(placement)">remove</button></li>
            }
        </ul>
    }
    <button id="propose-setup" disabled="@(placements.Count == 0)" @onclick="ProposeSetup">Propose setup</button>
}

@if (state is not null && history?.Current is not null)
{
    <h3>Play</h3>
    <div class="toolbar">
        <button id="propose-advance" @onclick="ProposeAdvance">Propose: advance the phase</button>
    </div>
    <div class="toolbar">
        <label>
            Unit
            <select id="enter-unit" value="@enterUnit" @onchange="@(args => enterUnit = args.Value as string ?? string.Empty)">
                @foreach (var unit in state.Units.Where(unit => unit.Status == InstanceStatus.Active))
                {
                    <option value="@unit.Id">@unit.Id (@unit.Side)</option>
                }
            </select>
        </label>
        <label>Building <input id="enter-location" value="@enterLocation" @onchange="@(args => enterLocation = args.Value as string ?? string.Empty)" size="12" /></label>
        <button id="propose-enter" @onclick="ProposeEntry">Propose: enter a building</button>
    </div>
    <p class="muted">
        The adjudicator decides an entry from the whole game. An entry into a building the moving side cannot see into is only declared when proposed;
        what it finds there is disclosed when it is confirmed.
    </p>
}

@if (pending is { } proposal)
{
    <div id="play-proposal">
        <h3>@proposal.Action.Name</h3>
        <p class="@(proposal.Result.Outcome is PlayOutcome.NeedsConfirmation or PlayOutcome.Committed or PlayOutcome.Replay ? "pass" : "fail")">
            <strong id="play-outcome">@OutcomeText(proposal.Result.Outcome, Withheld(proposal))</strong>
        </p>
        <ul id="play-reasons">
            @foreach (var reason in Reasons(proposal))
            {
                <li>@reason</li>
            }
        </ul>
        @if (proposal.Result.Plan?.Entry is { } review && !Withheld(proposal))
        {
            <table class="library" id="play-facts">
                <thead><tr><th>Reviewed fact (Scenario A1 first case)</th><th>From the game</th></tr></thead>
                <tbody>
                    @foreach (var (name, value) in review.Facts)
                    {
                        <tr data-fact="@name"><td>@name</td><td class="@(value == true ? "pass" : value == false ? "fail" : "muted")">@(value?.ToString().ToLowerInvariant() ?? "unknown")</td></tr>
                    }
                </tbody>
            </table>
            <p id="play-conclusion">
                Conclusion: <strong>@review.Conclusion.Disposition</strong>. @review.Conclusion.Explanation
                <span class="muted">(@review.Conclusion.ExplanationProvenance)</span>
            </p>
        }
        @if (proposal.Result.Outcome == PlayOutcome.NeedsConfirmation)
        {
            <button id="play-confirm" @onclick="Confirm">Confirm</button>
            <button id="play-cancel" class="link" @onclick="() => pending = null">Cancel</button>
        }
    </div>
}

@if (state is not null)
{
    @foreach (var open in state.OpenAttempts)
    {
        <p class="fail" data-open-attempt="@open.EventId">
            The entry attempt of @open.Unit into @open.Target awaits the attacker's Infantry OVR declaration (A12.15, p. 78). The phase cannot advance until it is made.
            <button class="declare-decline" @onclick='@(() => ProposeDeclaration(open.Unit, "decline"))'>Propose: decline the OVR</button>
            <button class="declare-elect" @onclick='@(() => ProposeDeclaration(open.Unit, "elect"))'>Propose: elect the OVR</button>
        </p>
    }

    @if (Rolls.Count > 0)
    {
        <h3>Rolls</h3>
        <ul id="play-rolls">
            @foreach (var (roll, subjects) in Rolls)
            {
                <li data-roll="@roll.Roll">
                    @RollText(roll)@(subjects is null ? "" : $" for {string.Join(", ", subjects)}")
                    <span class="muted">(@roll.Count d@(roll.Sides), drawn by the @roll.Source for @roll.Actor)</span>
                </li>
            }
        </ul>
    }

    <h3>Map</h3>
    @if (Drawing is { } drawing)
    {
        @if (drawing.Svg is { } svg)
        {
            <div id="play-map" class="play-map" data-source="@drawing.Source">@((MarkupString)svg)</div>
        }
        else
        {
            <ul id="play-map-problems">
                @foreach (var problem in drawing.Problems)
                {
                    <li>@problem</li>
                }
            </ul>
        }
    }

    <details id="play-los" open="@(playLos is not null)">
        <summary>LOS</summary>
        <p class="muted">VASL's LOS over the game's map (LOS Designs): terrain only, so every viewer may check it, from a location or from a unit the viewer can see.</p>
        <div class="fields">
            <label for="play-los-unit">From unit</label>
            <select id="play-los-unit" @onchange="ChooseLosUnit">
                <option value="">none</option>
                @foreach (var unit in VisibleUnits.Where(unit => state?.Location(unit.Id) is not null))
                {
                    <option value="@unit.Id">@unit.Id (@state!.Location(unit.Id)!.Location)</option>
                }
            </select>
            <label for="play-los-source">From</label><input id="play-los-source" value="@losSource" @onchange="@(args => losSource = args.Value as string ?? string.Empty)" />
            <label for="play-los-target">To</label><input id="play-los-target" value="@losTarget" @onchange="@(args => losTarget = args.Value as string ?? string.Empty)" />
        </div>
        <button id="play-los-check" @onclick="CheckLos">Check LOS</button>
        <button id="play-los-clear" disabled="@(playLos is null)" @onclick="() => playLos = null">Clear</button>
        @if (playLos is { } check)
        {
            <p id="play-los-result" data-status="@(check.Result?.Status.ToString() ?? "Refused")">@check.Summary</p>
        }
    </details>

    <h3>Units</h3>
    <p class="muted" id="play-units-view">As @(Viewer.IsAdjudicator ? "the adjudicator sees them: every unit" : $"{Viewer.Name} sees them"), at revision @state.Revision.</p>
    <table class="library" id="play-units">
        <thead><tr><th>Id</th><th>Side</th><th>Kind</th><th>Location</th><th>MF spent</th><th>Conditions</th></tr></thead>
        <tbody>
            @foreach (var unit in VisibleUnits)
            {
                <tr data-unit="@unit.Id">
                    <td>@unit.Id</td><td>@unit.Side</td><td>@unit.Kind.Replace("asl:", string.Empty, StringComparison.Ordinal)</td>
                    <td>
                        @if (state.Location(unit.Id)?.Location is { } at)
                        {
                            <button class="play-locate" @onclick="() => highlight = at">@at</button>
                        }
                        else
                        {
                            @unit.Status.ToString().ToLowerInvariant()
                        }
                    </td>
                    <td>@unit.MfSpent@(unit.MovementEnded ? ", movement ended" : "")</td>
                    <td>@string.Join(", ", unit.Conditions.Where(pair => pair.Value == ConditionState.True).Select(pair => pair.Key.Replace("asl:", string.Empty, StringComparison.Ordinal)))</td>
                </tr>
            }
            @foreach (var presence in SealedPresences)
            {
                <tr data-sealed="@presence.PlacementId">
                    <td>?</td><td>@presence.Side</td><td>concealed</td><td>@presence.Location</td><td></td><td></td>
                </tr>
            }
        </tbody>
    </table>
    @if (Viewer.IsAdjudicator)
    {
        <details>
            <summary>Audit (latest)</summary>
            <pre class="json">@string.Join("\n", Live.Audit.Tail(12))</pre>
        </details>
    }
}

@code {
    private sealed record Placement(string Id, string Definition, string Kind, string Side, string Location, bool Concealed, bool Hidden);

    private sealed record Proposal(ActionDescriptor Action, JsonElement Arguments, PlayResult Result);

    private string gameId = string.Empty;
    private GameHistory? history;
    private GameState? state;
    private string newId = "village";
    private string newLabel = "Village";
    private string newBoard = "bd01";
    private string? newMap;
    private LimboDancer.Domains.Asl.Maps.Coordinates.BoardLocation? highlight;
    private string firstSide = "german";
    private string secondSide = "russian";
    private readonly List<Placement> placements = [];
    private string placeDefinition = string.Empty;
    private string placeId = string.Empty;
    private string placeLocation = "bd01:D4:0";
    private bool placeConcealed;
    private bool placeHidden;
    private string enterUnit = string.Empty;
    private string enterLocation = "bd01:E4:0";
    private Proposal? pending;
    private string viewAs = string.Empty;

    /// <summary>The perspective the page shows: a side, or the adjudicator, who sees everything (D3).</summary>
    private Perspective Viewer => state?.Perspectives.FirstOrDefault(perspective => perspective.Name == viewAs) ?? Perspective.Adjudicator;

    private GameView? View => state is not null && history is not null && history.Current is not null ? GameView.Of(history, state.Revision, Viewer) : null;

    /// <summary>The game's map drawn for the viewer at the shown revision (Composed Maps Design, section 8).</summary>
    private GameMapDrawing? Drawing => state is not null && history?.Current is not null
        ? GameMaps.Draw(gameId, state.Map, Viewer, state.Revision, highlight, playLos is { } check ? board => Los.Layer(board, check) : null)
        : null;

    /// <summary>What "View on" opens: the saved map the game copied, or its first board.</summary>
    private string ViewTarget => state is null ? string.Empty
        : state.Map.IsPlaced && state.Map.Reference.StartsWith("map-", StringComparison.Ordinal) ? state.Map.Reference : state.Map.Boards[0].Board.Value;

    /// <summary>
    /// The setup's boards: one reference, or placed boards in the compact form <c>bd02@0,0/r bd01@0,1</c>
    /// (Composed Maps Design, section 6).
    /// </summary>
    private object[] SetupBoards() => [.. newBoard.Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).Select(token =>
    {
        var at = token.IndexOf('@', StringComparison.Ordinal);
        if (at < 0)
        {
            return (object)token;
        }

        var slot = token[(at + 1)..];
        var reversed = slot.EndsWith("/r", StringComparison.Ordinal);
        var parts = (reversed ? slot[..^2] : slot).Split(',');
        return new
        {
            board = token[..at],
            column = parts.Length == 2 && int.TryParse(parts[0], CultureInfo.InvariantCulture, out var column) ? column : -1,
            row = parts.Length == 2 && int.TryParse(parts[1], CultureInfo.InvariantCulture, out var row) ? row : -1,
            reversed,
        };
    })];

    private string losSource = string.Empty;
    private string losTarget = string.Empty;
    private LosCheck? playLos;

    /// <summary>
    /// LOS from a unit (LOS Result Design, section 5): only units the viewer can see are offered, and choosing one fills the
    /// source with its location.
    /// </summary>
    private void ChooseLosUnit(ChangeEventArgs args)
    {
        if (state is not null && args.Value as string is { Length: > 0 } id && VisibleUnits.Any(unit => unit.Id == id) && state.Location(id) is { } at)
        {
            losSource = at.Location.ToString();
        }
    }

    /// <summary>Checks LOS between two locations of the game's map (LOS Design, section 6).</summary>
    private void CheckLos()
    {
        if (state is not null && GameMaps.Board(state.Map).Board is { } board)
        {
            playLos = Los.Check(board, losSource, losTarget);
        }
    }

    private void ChooseMap(ChangeEventArgs args)
    {
        newMap = args.Value as string is { Length: > 0 } chosen ? chosen : null;
        if (GameMaps.Saved().FirstOrDefault(map => map.Ref.Value == newMap) is { } map)
        {
            newBoard = string.Join(' ', map.Placements.Select(placement => $"{placement.Board.Value}@{placement.Column},{placement.Row}{(placement.Reversed ? "/r" : "")}"));
        }
    }

    private IEnumerable<UnitInstance> VisibleUnits => Viewer.IsAdjudicator || View is null ? state?.Units ?? [] : View.Units;

    /// <summary>
    /// The rolls the viewer may see, latest first, with the unit each die belongs to when the viewer may see that too:
    /// the adjudicator, or the side whose units were selected (Random Selection and Declined OVR Design, section 7).
    /// </summary>
    private IReadOnlyList<(DiceRolled Roll, IReadOnlyList<string>? Subjects)> Rolls => history is null
        ? []
        : [.. history.Events.Where(item => item.IsVisibleTo(Viewer)).Select(item => item.Payload).OfType<DiceRolled>().Reverse().Take(6)
            .Select(roll => (roll, history.Events.Where(item => item.IsVisibleTo(Viewer)).Select(item => item.Payload).OfType<RandomSelection>()
                .FirstOrDefault(selection => selection.Roll == roll.Roll)?.Subjects))];

    /// <summary>
    /// A roll with its purpose; an NTC also shows its arithmetic from the task check that used it (Infantry OVR Design,
    /// section 7), for example "OVR NTC: 3, 5 + 3 (TEM) = 11 against morale 7: failed".
    /// </summary>
    private string RollText(DiceRolled roll)
    {
        var check = history?.Events.Select(item => item.Payload).OfType<TaskCheck>().FirstOrDefault(item => item.Roll == roll.Roll);
        if (check is null)
        {
            return $"{roll.Purpose}: {string.Join(", ", roll.Values)}";
        }

        var modifiers = string.Concat(check.Modifiers.Select(item => $" {(item.Value < 0 ? "-" : "+")} {Math.Abs(item.Value)} ({(item.Source == "B23.3" ? "TEM" : item.Source)})"));
        return $"{(check.Purpose == TaskCheck.OvrNtc ? "OVR NTC" : check.Purpose)}: {string.Join(", ", roll.Values)}{modifiers} = {check.FinalDr} "
            + $"against morale {check.MoraleLevel}: {(check.Passed ? "passed" : "failed")}";
    }

    private IEnumerable<SealedPresence> SealedPresences => Viewer.IsAdjudicator || View is null ? [] : View.Sealed;

    /// <summary>
    /// Whether the proposal's outcome is withheld from the current viewer: an entry the moving side cannot see into, viewed
    /// by anyone but the adjudicator (Occupied and Concealed Entry Design, section 7).
    /// </summary>
    private bool Withheld(Proposal proposal) => !Viewer.IsAdjudicator && proposal.Result.Plan?.Disclosure is { Withheld: true };

    private IReadOnlyList<string> Reasons(Proposal proposal) =>
        !Viewer.IsAdjudicator && proposal.Result.Plan is { Disclosure: { } disclosure } plan
            ? disclosure.ReasonsForMover(plan, confirmed: proposal.Result.Outcome != PlayOutcome.NeedsConfirmation)
            : proposal.Result.Reasons;

    [SupplyParameterFromQuery(Name = "game")]
    public string? GameQuery { get; set; }

    private IReadOnlyList<UnitDefinition> Definitions =>
        [.. Live.Catalogs.Where(catalog => catalog.Publication == CatalogPublication.Published).SelectMany(catalog => catalog.Definitions)];

    private UnitCatalog? PublishedCatalog => Live.Catalogs.FirstOrDefault(catalog => catalog.Publication == CatalogPublication.Published);

    /// <summary>Setup stays open until the first event that is not the start or a placement.</summary>
    private bool SetupOpen => history is { } shown && shown.Events.All(item => item.Payload is GameStarted or InstanceCreated);

    protected override void OnInitialized()
    {
        placeDefinition = Definitions.FirstOrDefault()?.Id ?? string.Empty;
        gameId = GameQuery ?? string.Empty;
        Refresh();
    }

    private void ChangeGame(ChangeEventArgs args)
    {
        gameId = args.Value as string ?? string.Empty;
        pending = null;
        placements.Clear();
        Refresh();
    }

    private void Refresh()
    {
        history = gameId.Length > 0 ? Live.History(gameId) : null;
        state = history?.Current ?? (history is { States.Count: > 0 } ? history.States[^1] : null);
        if (state is not null && !state.Units.Any(unit => unit.Id == enterUnit))
        {
            enterUnit = state.Units.FirstOrDefault()?.Id ?? string.Empty;
        }

        if (state is not null && !state.Perspectives.Any(perspective => perspective.Name == viewAs))
        {
            viewAs = state.PhasingSide;
        }
    }

    private void AddPlacement()
    {
        if (Definitions.FirstOrDefault(definition => definition.Id == placeDefinition) is not { } definition)
        {
            return;
        }

        var id = placeId.Trim().Length > 0 ? placeId.Trim() : $"{definition.Id}-{placements.Count + 1}";
        var side = new[] { firstSide, secondSide }.Contains(definition.Nationality) ? definition.Nationality
            : state?.Sides.FirstOrDefault(item => item.Nationality == definition.Nationality)?.Id ?? definition.Nationality;
        placements.Add(new Placement(id, definition.Id, definition.Kind, side, placeLocation.Trim(), placeConcealed, placeHidden));
        placeId = string.Empty;
    }

    private async Task ProposeSetup()
    {
        var game = history is null ? newId.Trim() : gameId;
        object[] units = [.. placements.Select(item => (object)new
        {
            id = item.Id, kind = item.Kind, definition = item.Definition, side = item.Side, position = new { at = item.Location },
            conditions = new Dictionary<string, bool>
            {
                ["asl:broken"] = false, ["asl:berserk"] = false, ["asl:captured"] = false, ["asl:melee"] = false, ["asl:ti"] = false,
                ["asl:disrupted"] = false, ["asl:concealed"] = item.Concealed, ["asl:hidden"] = item.Hidden,
            },
        })];
        var catalog = PublishedCatalog is { } published ? $"{published.Identity.Catalog}@{published.Identity.Version}" : string.Empty;
        var arguments = history is null
            ? JsonSerializer.SerializeToElement(new
            {
                gameId = game, attemptId = Attempt("setup"), expectedRevision = 0L,
                start = new
                {
                    label = newLabel, catalog, boards = SetupBoards(), map = newMap, firstSide,
                    sides = new[] { new { id = firstSide, nationality = firstSide }, new { id = secondSide, nationality = secondSide } },
                },
                placements = units,
            })
            : JsonSerializer.SerializeToElement(new { gameId = game, attemptId = Attempt("setup"), expectedRevision = (long)history.Events.Count, placements = units });
        gameId = game;
        await Propose(GameActions.Setup, arguments);
    }

    private Task ProposeAdvance() => Propose(GameActions.AdvancePhase,
        JsonSerializer.SerializeToElement(new { gameId, attemptId = Attempt("advance"), expectedRevision = (long)history!.Events.Count }));

    private Task ProposeEntry() => Propose(GameActions.EnterBuilding, JsonSerializer.SerializeToElement(new
    {
        gameId, attemptId = Attempt("enter"), expectedRevision = (long)history!.Events.Count, unitId = enterUnit, location = enterLocation.Trim(),
    }));

    /// <summary>The attacker's OVR choice for a pending attempt; an election is refused until step 10.</summary>
    private Task ProposeDeclaration(string unit, string choice) => Propose(GameActions.DeclareOverrun, JsonSerializer.SerializeToElement(new
    {
        gameId, attemptId = Attempt("declare"), expectedRevision = (long)history!.Events.Count, unitId = unit, choice,
    }));

    private async Task Propose(ActionDescriptor action, JsonElement arguments)
    {
        pending = new Proposal(action, arguments, await Run(() => Live.Play.ProposeAsync(action, arguments, Live.Principal)));
        Refresh();
    }

    /// <summary>Runs a gate call; a failure inside it, such as a reviewed package that no longer verifies, is reported, not thrown.</summary>
    private static async Task<PlayResult> Run(Func<Task<PlayResult>> call)
    {
        try
        {
            return await call();
        }
        catch (InvalidOperationException exception)
        {
            return new PlayResult(PlayOutcome.Failed, new LimboDancer.Abstractions.Runtime.CorrelationId("failed"), ["play.error: " + exception.Message], null);
        }
    }

    private async Task Confirm()
    {
        if (pending is not { } proposal)
        {
            return;
        }

        var result = await Run(() => Live.Play.ConfirmAsync(proposal.Action, proposal.Arguments, Live.Principal, proposal.Result.Correlation));
        pending = proposal with { Result = result };
        if (result.Outcome is PlayOutcome.Committed or PlayOutcome.Replay && proposal.Action == GameActions.Setup)
        {
            placements.Clear();
        }

        Refresh();
    }

    private static string Attempt(string kind) => $"{kind}-{Guid.NewGuid():N}"[..(kind.Length + 13)];

    private static string OutcomeText(PlayOutcome outcome, bool withheld) => outcome switch
    {
