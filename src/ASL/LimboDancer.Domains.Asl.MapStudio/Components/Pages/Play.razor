    /// <summary>
    /// The destination a broken unit must reach, or that it has no legal step and so fails to rout or surrenders as the RtPh ends (A10.5, A10.51,
    /// A20.21; table player, pass 13).
    /// </summary>
    private string RoutAdviceText(UnitInstance unit, bool must)
    {
        // Pass 31c (backlog section 48; play test P-19): one sentence that says what the unit may or must do.
        var (targets, canRout) = Live.Planner.RoutAdvice(state!, unit);
        return !canRout
            ? must ? ". It has no legal rout step, so it is eliminated for Failure to Rout, or surrenders, when the RtPh ends (A10.5)." : ". It has no legal rout step, so it stays where it is."
            : targets.Count > 0 ? $". Its route must end in {string.Join(" or ", targets)}."
            : ". No woods or building is within its reach, so any legal route will do.";
    }

