    private (IReadOnlyList<PlayChoice> Guns, IReadOnlyList<PlayChoice> Candidates, bool Replacement, string? Refusal) SpotterDeclarationChoices
    {
        get
        {
            if (state is null)
            {
                return ([], [], false, null);
            }
            if (!ReferenceEquals(spotterDeclarationCache.State, state) || spotterDeclarationCache.Viewer != Viewer.Name
                || spotterDeclarationCache.Gun != spotterDeclarationGun || spotterDeclarationCache.Guns is null)
            {
                var own = ActingUnits.Where(Mine).ToDictionary(unit => unit.Id, StringComparer.Ordinal);
                var assignments = MortarSpotterFacts.ReadAssignments(state);
                var guns = VisibleEquipment.Where(gun => gun.Holding is { } holding && own.ContainsKey(holding.Holder)
                    && Live.Planner.ReadSpotterDesignation(state, gun.Id, holding.Holder, assignments)?.Mortar == true).ToArray();
                var candidates = new List<PlayChoice>();
                var replacement = false;
                string? refusal = null;
                if (guns.FirstOrDefault(gun => gun.Id == spotterDeclarationGun) is { } selected)
                {
                    foreach (var unit in own.Values)
                    {
                        if (Live.Planner.ReadSpotterDesignation(state, selected.Id, unit.Id, assignments) is not { } facts)
                        {
                            continue;
                        }
                        replacement = facts.Timing.HasDesignation == true;
                        string? candidateRefusal;
                        var ready = false;
                        if (replacement)
                        {
                            var replacementFacts = GamePlanner.ReadSpotterReplacement(state, facts);
                            candidateRefusal = ScenarioA1SpotterCalculator.ReplacementRefusal(replacementFacts);
                            var verdict = ScenarioA1SpotterCalculator.Replacement(replacementFacts);
                            ready = candidateRefusal is null && verdict.State == SpotterReplacementState.MayReplace && verdict.EstablishesAssignment;
                            candidateRefusal ??= ready ? null : verdict.Reason;
                        }
                        else
                        {
                            candidateRefusal = ScenarioA1SpotterCalculator.DesignationRefusal(facts);
                            ready = candidateRefusal is null;
                        }
                        if (ready)
                        {
                            candidates.Add(new PlayChoice(unit.Id, unit.Id));
                        }
                        else
                        {
                            if (refusal is null || ScenarioA1SpotterCalculator.CandidateRefusal(facts.Candidate) is null)
                            {
                                refusal = candidateRefusal;
                            }
                        }
                    }
                }
                spotterDeclarationCache = (state, Viewer.Name, spotterDeclarationGun,
                    [.. guns.Select(gun => new PlayChoice(gun.Id, GunLabel(gun)))], candidates, replacement, refusal);
            }
            return (spotterDeclarationCache.Guns!, spotterDeclarationCache.Candidates!, spotterDeclarationCache.Replacement, spotterDeclarationCache.Refusal);
        }
    }

