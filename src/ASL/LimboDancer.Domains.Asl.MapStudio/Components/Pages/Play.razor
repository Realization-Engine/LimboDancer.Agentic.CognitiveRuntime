    /// The phasing side's units that may advance: not broken, pinned, berserk, in Melee, captured, or already advanced (A4.7), and
    /// not a crew manning a Gun, which may not leave it (C10, A21.13; ruling R24.4).
    /// </summary>
    private IEnumerable<UnitInstance> AdvanceCandidates => SeenOnly(state is null ? []
        : state.Units.Where(unit => unit.Status == InstanceStatus.Active && unit.Side == state.PhasingSide && !unit.MovementEnded && (state.Location(unit.Id) is not null || WaitsToEnter(unit))
            && !new[] { Conditions.Broken, Conditions.Pinned, Conditions.Berserk, Conditions.Melee, Conditions.Captured, Conditions.Concealed, Conditions.Hidden, "asl:ti" }.Any(name => GameState.Condition(unit, name) == ConditionState.True)
            && !Mans(unit))
            .OrderBy(unit => unit.Id, StringComparer.Ordinal));

    private bool Mans(UnitInstance unit) => state is not null && state.Equipment.Any(item => item.Status == InstanceStatus.Active
        && item.Holding is { Role: HoldingRole.Manned } holding && holding.Holder == unit.Id);

    /// <summary>The sides that may declare attacks in the chosen Location now, as the planner reads the Ambush and its rounds (A11.3, A11.32).</summary>
    private IReadOnlyList<string> CloseCombatSides => state is not null && BoardLocation.TryParse(ccLocation, out var at)
        ? ccRound == CloseCombatResolved.PrisonersRound
            // A20.55 (ruling R14.6): in the prisoners' round only the prisoners' side attacks.
            ? [.. CloseCombatUnits.Where(unit => GameState.Condition(unit, Conditions.Captured) == ConditionState.True).Select(unit => unit.Side).Distinct(StringComparer.Ordinal)]
            : Live.Planner.DeclaringSides(state, at, ccRound == CloseCombatResolved.AmbusherRound)
        : [];

    /// <summary>A new round choice starts its declarations over: the attacks declared were for the other side.</summary>
    private void ChooseRound(string? round)
    {
        ccRound = round ?? string.Empty;
        ccAttackers.Clear();
        ccDefenders.Clear();
        ccDirector = string.Empty;
        ccAttacks.Clear();
    }

    private Task ProposeAdvanceUnits() => Propose(GameActions.Advance, JsonSerializer.SerializeToElement(new
    {
        gameId, attemptId = Attempt("adv"), expectedRevision = (long)history!.Events.Count, unitIds = advanceUnits.Order(StringComparer.Ordinal).ToArray(), to = advanceTo.Trim(),
    }));

    /// <summary>The Locations holding units of both sides, none of them a prisoner: where CC can occur (A11.1).</summary>
    // Ruling R23.1: a side finds a CC Location by the units it may see and the "?" it knows of, never by a hidden unit.
    private IEnumerable<string> CloseCombatLocations => state is null ? []
        : VisibleUnits.Where(unit => unit.Status == InstanceStatus.Active && GameState.Condition(unit, Conditions.Captured) != ConditionState.True && state.Location(unit.Id) is not null)
            .Select(unit => (Location: state.Location(unit.Id)!.Location.ToString(), unit.Side))
            .Concat(SealedPresences.Where(presence => !presence.Uninspected).Select(presence => (Location: presence.Location.ToString(), presence.Side)))
            .GroupBy(item => item.Location).Where(group => group.Select(item => item.Side).Distinct(StringComparer.Ordinal).Count() > 1)
            .Select(group => group.Key).Order(StringComparer.Ordinal);

    private CloseCombatLocation? CloseCombatEntry => state?.CloseCombats.FirstOrDefault(item => item.Location.ToString() == ccLocation);

    private IEnumerable<UnitInstance> CloseCombatUnits => state is null || ccLocation.Length == 0 ? []
        : VisibleUnits.Where(unit => unit.Status == InstanceStatus.Active && state.Location(unit.Id)?.Location.ToString() == ccLocation)
            .OrderBy(unit => unit.Side, StringComparer.Ordinal).ThenBy(unit => unit.Id, StringComparer.Ordinal);

    /// <summary>A new CC Location starts the declarations over, with each SMC stacked with its side's first MMC (A11.14).</summary>
    private void ChooseCloseCombatLocation(string at)
    {
        ccLocation = at;
        ClearCloseCombat();
        DefaultStacking();
    }

    /// <summary>
    /// The ambusher's withdrawals (plan N06; A11.41), before its round or once the Location's CC is closed, for the ambusher's view and the
    /// adjudicator only; null hides them.
    /// </summary>
    private IReadOnlyList<AmbushWithdrawalActions.Withdrawal>? AmbushWithdrawals => state is not null && CloseCombatEntry is { Ambusher: { } ambushing } withdrawing
        && (withdrawing.Rounds.Count == 0 || withdrawing.Closed) && (Viewer.IsAdjudicator || viewAs == ambushing) && BoardLocation.TryParse(ccLocation, out var ambushAt)
        ? [.. CloseCombatUnits.Where(unit => unit.Side == ambushing && GameState.Condition(unit, Conditions.Captured) != ConditionState.True)
            .SelectMany(unit => Live.Planner.WithdrawalDestinations(state, unit, ambushAt).Select(to => new AmbushWithdrawalActions.Withdrawal(unit.Id, to.ToString())))]
        : null;

    /// <summary>The SMC the view may declare stacking for (plan C04; ruling R23.1), each with the MMC of its side in the Location.</summary>
    private IReadOnlyList<CloseCombatStacking.Smc> StackingChoices => [.. CloseCombatUnits
        .Where(unit => Library.Vocabulary.IsA(unit.Kind, "asl:smc") && (Viewer.IsAdjudicator || viewAs == unit.Side))
        .Select(smc => new CloseCombatStacking.Smc(smc.Id, [.. CloseCombatUnits.Where(unit => unit.Side == smc.Side && Library.Vocabulary.IsA(unit.Kind, "asl:mmc")).Select(unit => unit.Id)]))];

    /// <summary>The units that may withdraw from Melee (plan C05), as a player reads them, with whether each must try.</summary>
    private IReadOnlyList<CloseCombatWithdrawals.Withdrawer> Withdrawers => [.. WithdrawalUnits.Select(item => new CloseCombatWithdrawals.Withdrawer(item.Unit.Id, UnitLabel(item.Unit),
        Live.Planner.MustWithdraw(state!, item.Unit), [.. item.Destinations.Select(to => to.ToString())]))];

    /// <summary>The sides the view may declare attacks for (plan C06; ruling R23.1), each with its units and the other sides' units.</summary>
    private IReadOnlyList<CloseCombatAttackBuilder.DeclaringSide> DeclaringSides => [.. CloseCombatSides.Where(side => Viewer.IsAdjudicator || viewAs == side)
        .Select(side => new CloseCombatAttackBuilder.DeclaringSide(side, side == state!.PhasingSide,
            [.. CloseCombatUnits.Where(unit => unit.Side == side).Select(unit => new CloseCombatAttackBuilder.Participant(unit.Id, UnitLabel(unit), IsBroken(unit)))],
            [.. CloseCombatUnits.Where(unit => unit.Side != side).Select(unit => new CloseCombatAttackBuilder.Participant(unit.Id, UnitLabel(unit), IsBroken(unit)))]))];

    /// <summary>
    /// The units the view may declare an infiltration for (plan N08; A11.22): not berserk or Disrupted, with somewhere to go. Read only while attacks
    /// may be declared; null when the Location cannot be read.
    /// </summary>
    private IReadOnlyList<CloseCombatInfiltrationChoices.Infiltrator>? Infiltrators => state is not null && !AmbushDue && BoardLocation.TryParse(ccLocation, out var at)
        ? [.. CloseCombatUnits.Where(unit => (Viewer.IsAdjudicator || viewAs == unit.Side)
                && GameState.Condition(unit, Conditions.Berserk) != ConditionState.True && GameState.Condition(unit, Conditions.Disrupted) != ConditionState.True)
            .Select(unit => new CloseCombatInfiltrationChoices.Infiltrator(unit.Id, [.. Live.Planner.WithdrawalDestinations(state, unit, at).Select(to => to.ToString())]))
            .Where(item => item.Destinations.Count > 0)]
        : null;

    private void SetStacking(string smc, string? mmc)
    {
        if (string.IsNullOrEmpty(mmc))
        {
            ccStacking.Remove(smc);
        }
        else
        {
            ccStacking[smc] = mmc;
        }
    }

    private void AddAttack()
    {
        string[] yielded = [.. ccYield.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)];
        ccAttacks.Add(new CloseCombatPanel.DeclaredAttack([.. ccAttackers.Order(StringComparer.Ordinal)], [.. ccDefenders.Order(StringComparer.Ordinal)],
            ccDirector.Length > 0 && ccAttackers.Contains(ccDirector) ? ccDirector : null, ccCapture, ccCapture && yielded.Length > 0 ? yielded : null,
            ccCapture && ccGuard.Length > 0 && ccAttackers.Contains(ccGuard) ? ccGuard : null));
        ccAttackers.Clear();
        ccDefenders.Clear();
        ccDirector = string.Empty;
        ccCapture = false;
        ccGuard = string.Empty;
        ccYield = string.Empty;
    }

    private void ClearCloseCombat()
    {
        ccAttackers.Clear();
        ccDefenders.Clear();
        ccDirector = string.Empty;
        ccRound = string.Empty;
        ccStacking.Clear();
        ccWithdrawals.Clear();
        ccAttacks.Clear();
        ccInfiltrations.Clear();
        ccHandToHand = false;
        ccCapture = false;
        ccGuard = string.Empty;
        ccYield = string.Empty;
    }

    private Task ProposeAmbush() => Propose(GameActions.Ambush, JsonSerializer.SerializeToElement(new
    {
        gameId, attemptId = Attempt("amb"), expectedRevision = (long)history!.Events.Count, location = ccLocation,
    }));

    private Task ProposeCloseCombat() => Propose(GameActions.CloseCombat, JsonSerializer.SerializeToElement(new Dictionary<string, object>
    {
        ["gameId"] = gameId,
        ["attemptId"] = Attempt("cc"),
        ["expectedRevision"] = (long)history!.Events.Count,
        ["location"] = ccLocation,
        ["attacks"] = ccAttacks.Select(attack =>
        {
            var declared = new Dictionary<string, object> { ["attackers"] = attack.Attackers, ["defenders"] = attack.Defenders };
            if (attack.Director is { } director)
            {
                declared["director"] = director;
            }

            if (attack.Capture)
            {
                declared["capture"] = true;
            }

            if (attack.Yield.Length > 0)
            {
                declared["yield"] = attack.Yield;
            }

            if (attack.Guard is { } guard)
            {
                declared["guard"] = guard;
            }

            return declared;
        }).ToArray(),
        ["stacking"] = ccStacking,
        ["withdrawals"] = ccWithdrawals,
        ["infiltrations"] = ccInfiltrations,
        ["handToHand"] = ccHandToHand,
        ["round"] = ccRound,
    }));

