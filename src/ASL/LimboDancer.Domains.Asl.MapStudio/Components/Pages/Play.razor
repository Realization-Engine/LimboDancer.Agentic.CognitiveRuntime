    private bool Withheld(Proposal proposal) => !Viewer.IsAdjudicator && proposal.Result.Plan?.Disclosure is { Withheld: true };

    private IReadOnlyList<string> Reasons(Proposal proposal) =>
        proposal.Action == GameActions.PassFire && !Viewer.IsAdjudicator && viewAs != state?.PhasingSide && proposal.Result.Outcome is not (PlayOutcome.Denied or PlayOutcome.Failed)
            ? ["play.pass: the DEFENDER passes on the moving stack; it moves on, or ends its move (A8.1, A8.11)."]
        : !Viewer.IsAdjudicator && proposal.Result.Plan is { Disclosure: { } disclosure } plan
            ? disclosure.ReasonsForMover(plan, confirmed: proposal.Result.Outcome != PlayOutcome.NeedsConfirmation)
            : proposal.Result.Plan?.Fire is { } fire ? fire.ReasonsFor(proposal.Result.Reasons, Viewer) : proposal.Result.Reasons;

