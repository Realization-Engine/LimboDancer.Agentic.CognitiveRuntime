        : [.. state.Units.Where(unit => unit.Status == InstanceStatus.Active && unit.Side == state.PhasingSide && GameState.Condition(unit, Conditions.Melee) != ConditionState.True
                && state.Units.Any(prisoner => prisoner.Status == InstanceStatus.Active && prisoner.Custodian == unit.Id))
            .OrderBy(unit => unit.Id, StringComparer.Ordinal)
            .Select(guard => new PrisonerCustodyActions.Guard(guard.Id, [.. SeenOnly(state.Units.Where(unit => unit.Status == InstanceStatus.Active && unit.Id != guard.Id && unit.Side == guard.Side
                && state.Location(unit.Id)?.Location == state.Location(guard.Id)?.Location && GameState.Condition(unit, Conditions.Captured) != ConditionState.True
                && GameState.Condition(unit, Conditions.Unarmed) != ConditionState.True && (Library.Vocabulary.IsA(unit.Kind, "asl:mmc") || Library.Vocabulary.IsA(unit.Kind, "asl:smc"))))
                .OrderBy(unit => unit.Id, StringComparer.Ordinal).Select(unit => unit.Id)]))];

