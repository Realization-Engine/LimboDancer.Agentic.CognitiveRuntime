    /// <summary>
    /// The chosen Gun's CA drawn as two rays from its hex (C3.2; ruling R8.9): the hexspines 30 degrees either side of its barrel.
    /// </summary>
    private string CoveredArcLayer(StudioBoard board)
    {
        if (state?.Find(ordnanceGun) is not EquipmentInstance { Position: MapPosition { Facing: { } facing } at } || UnitLibrary.TargetFor(board).Locate(at.Location) is not { } hex)
        {
            return string.Empty;
        }

        var center = board.Render.Grid.Geometry.CenterDot(hex);
        var rays = new[] { -30, 30 }.Select(offset =>
        {
            var angle = ((int)facing * 60 + offset) * Math.PI / 180;
            return string.Create(CultureInfo.InvariantCulture,
                $"<line class=\"ca-ray\" x1=\"{center.X:0.##}\" y1=\"{center.Y:0.##}\" x2=\"{center.X + (900 * Math.Cos(angle)):0.##}\" y2=\"{center.Y - (900 * Math.Sin(angle)):0.##}\" stroke=\"#06c\" stroke-width=\"3\" stroke-dasharray=\"10 6\"/>");
        });
        return $"<g id=\"layer-covered-arc\">{string.Concat(rays)}</g>";
    }

