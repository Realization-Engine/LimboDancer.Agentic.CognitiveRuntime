    /// <summary>
    /// Whose Normal Range the inspector's Range tab reads (design section 14, R3): the fire group chosen, when the reading is from one of its
    /// Locations to its target; otherwise the units in the From Location that the view holds by name, with the weapons they possess. A unit
    /// under "?" or hidden is not in the view's units, so it gives no row and the rows never count more than the view knows.
    /// </summary>
    private IReadOnlyList<RangeRow> RangeSubjects(BoardLocation from, BoardLocation to)
    {
        if (state is null)
        {
            return [];
        }

        if (fireFirers.Count > 0 && FireTarget.Trim() == to.ToString() && (fireFrom == from.ToString() || fireAlso.Contains(from.ToString())))
        {
            return FireRangeRows(to);
        }

        var held = VisibleUnits.Where(unit => unit.Status == InstanceStatus.Active && unit.Kind != UnitKinds.Dummy
                && (Viewer.IsAdjudicator ? state.Location(unit.Id)?.Location : View?.Locations.TryGetValue(unit.Id, out var seen) == true ? seen.Location : null) == from)
            .OrderBy(unit => unit.Id, StringComparer.Ordinal).Select(unit => (unit, from)).ToArray();
        return RangeRowsOf(held, [.. VisibleEquipment.Where(item => item.Status == InstanceStatus.Active && item.Holding is { Role: HoldingRole.Possessed })], to, _ => true, fireKinds: false);
    }

