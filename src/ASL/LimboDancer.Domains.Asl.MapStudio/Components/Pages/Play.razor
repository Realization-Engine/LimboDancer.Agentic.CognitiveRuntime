    private IEnumerable<UnitInstance> PanzerfaustFirers(string side) => state is null || state.Side(side)?.Nationality != "german"
        || state.ScenarioYear is not { } year || year < 1943 || (year == 1943 && state.ScenarioMonth < 10) ? []
