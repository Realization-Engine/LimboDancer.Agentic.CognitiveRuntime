    private static string HalfMpText(int halfMp) => halfMp % 2 == 0 ? (halfMp / 2).ToString(CultureInfo.InvariantCulture)
        : halfMp == 1 ? "½" : $"{(halfMp / 2).ToString(CultureInfo.InvariantCulture)}½";

    /// <summary>A vehicle's VCA and, for an AFV, whether its crew is CE (D2.11, D5.3).</summary>
    private static IEnumerable<string> VehicleNotes(UnitInstance unit)
    {
        if (!LiveFire.IsVehicle(unit))
        {
            yield break;
        }

        if (unit.Position is MapPosition { Facing: { } vca })
        {
            yield return $"VCA {UnitFacings.Name(vca)}";
        }

        if (GamePlanner.IsArmoredVehicle(unit) && LiveFire.CrewExposed(unit))
        {
            yield return "CE";
        }

        if (unit.Straddling is { } lane)
        {
            yield return $"in Bypass beside {lane}";
        }

        // D3.41 (pass 55, ruling R55.15): the view's unit carries its Armor Leader for his owner, and for the enemy once a record has used him.
        if (unit.ArmorLeader is { } leader)
        {
            yield return $"with Armor Leader {ScenarioA1ArmorLeaders.Grade(leader.Morale, leader.Leadership)}";
        }
    }

