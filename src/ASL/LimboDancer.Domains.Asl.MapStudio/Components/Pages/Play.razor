                        SelectedWeapons="@fireWeapons" Alone="@fireAlone" Leaders="@([.. FireLeaders(firing).Select(leader => leader.Id)])" Director="@fireDirector"
                        MolAllowed='@state.SpecialRules.Contains("mol:" + firing, StringComparer.Ordinal)' Mol="@fireMol" Targets="@([.. FireTargets(firing)])" Target="@fireTarget"
                        FreeTarget="@fireFreeTarget" SnapShot="@fireSnapShot" Spray="@fireSpray" LaneWeapon="@fireLaneWeapon" LaneTo="@fireLaneTo" Partners="@FirePartners(firing)"
                        Partner="@firePartner" OnFrom="@(at => { fireFrom = at; PruneFire(); })" OnFirer="@(pick => Toggle(fireFirers, pick.Id, pick.On))"
                        OnWeapon="@(pick => Toggle(fireWeapons, pick.Id, pick.On))" OnAlone="@(pick => Toggle(fireAlone, pick.Id, pick.On))" OnDirector="@(id => fireDirector = id)"
                        OnMol="@(id => fireMol = id)" OnTarget="@(at => fireTarget = at)" OnFreeTarget="@(at => fireFreeTarget = at)" OnSnapShot="@(on => fireSnapShot = on)"
                        OnSpray="@(at => fireSpray = at)" OnLaneWeapon="@(id => fireLaneWeapon = id)" OnLaneTo="@(at => fireLaneTo = at)" OnPartner="@(id => firePartner = id)"
                        OnPropose="@ProposeFire" OnClear="@ClearFire" />
                    @if (state.Phase == "pfph" && MopUpChoices(firing) is { Count: > 0 } mopUp)
                    {
                        <MoppingUpAction Buildings="@mopUp" OnPropose="@ProposeMopUp" />
                    }
                    @if (DcHolders(firing).Any())
                    {
                        <ThrowDemolitionChargeAction Charges="@([.. DcHolders(firing).Select(item => new ThrowDemolitionChargeAction.HeldCharge(item.Unit, item.Charge))])" Charge="@throwDc"
                            At="@throwDcAt" OnCharge="@(value => throwDc = value)" OnAt="@(at => throwDcAt = at)" OnPropose="@ProposeThrowDc" />
                    }
                    @if (state.Night && StarshellFirers(firing).Any())
                    {
                        <StarshellActionPanel Firers="@StarshellChoices(firing)" Unit="@starshellUnit" Method="@starshellMethod" At="@starshellAt"
                            OnUnit="@(id => starshellUnit = id)" OnMethod="@(method => starshellMethod = method)" OnAt="@(at => starshellAt = at)" OnPropose="@ProposeStarshell" />
                    }
                    @if (state.Phase == "afph" && state.PlacedCharges.Any(item => item.Operable))
                    {
                        <PlacedChargeDetonationActions Charges="@([.. state.PlacedCharges.Where(item => item.Operable).Select(item => new PlacedChargeDetonationActions.Placed(item.Charge, item.Target.ToString(), item.TargetsConcealed, item.Cx))])"
                            OnDetonate="@ProposeDetonateDc" />
                    }
                    @if ((state.Phase is "pfph" or "afph" or "dfph" || (state.Phase == "mph" && state.Movement is { WindowOpen: true })) && (OrdnanceGuns(firing).Any() || OrdnanceTanks(firing).Any() || PanzerfaustFirers(firing).Any()))
                    {
                        <OrdnanceFirePanel Guns="@OrdnanceChoices(firing)" Gun="@ordnanceGun" Spotters="@OrdnanceSpotters(firing)" Spotter="@ordnanceSpotter"
                            Directors="@OrdnanceDirectors(firing)" Director="@ordnanceDirector" IntensiveAllowed="@OrdnanceIntensiveAllowed" Intensive="@ordnanceIntensive"
                            PanzerfaustUsage="@(PanzerfaustFirers(firing).Any() ? $"PF shots taken {state.PanzerfaustShots.GetValueOrDefault(firing)} of {LiveOrdnance.PanzerfaustAllowance(state, firing)} (C13.31)" : null)"
                            Ready="@(ordnanceGun.Length > 0 && ordnanceTarget.Length > 0)" OnGun="@ChooseOrdnanceGun" OnSpotter="@(id => ordnanceSpotter = id)"
                            OnDirector="@(id => ordnanceDirector = id)" OnIntensive="@(on => ordnanceIntensive = on)" OnPropose="@ProposeOrdnance">
                            <Target>
                                <OrdnanceTargetFields Targets="@([.. FireTargets(firing)])" Vehicles="@OrdnanceVehicleChoices(firing)" Ammunition="@OrdnanceAmmunitionKind"
                                    Fixed="@OrdnanceFixedAmmunition" Ammunitions="@OrdnanceAmmunitions" Target="@ordnanceTarget" Vehicle="@ordnanceVehicle" Chosen="@ordnanceAmmunition"
                                    OnTarget="@(at => { ordnanceTarget = at; ordnanceVehicle = string.Empty; })" OnVehicle="@(id => ordnanceVehicle = id)"
                                    OnAmmunition="@(ammunition => ordnanceAmmunition = ammunition)" />
                            </Target>
                        </OrdnanceFirePanel>
