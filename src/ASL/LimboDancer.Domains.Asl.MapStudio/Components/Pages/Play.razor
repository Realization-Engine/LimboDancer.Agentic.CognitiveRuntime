    private IEnumerable<BoardLocation> VehicleCcLocations => state is null || state.Phase != "ccph" ? []
        : state.Units.Where(unit => unit.Status == InstanceStatus.Active && LiveFire.IsVehicle(unit)).Select(unit => state.Location(unit.Id)?.Location).OfType<BoardLocation>()
