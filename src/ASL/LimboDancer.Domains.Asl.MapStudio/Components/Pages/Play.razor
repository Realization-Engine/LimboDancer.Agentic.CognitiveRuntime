                        <button type="button" id="play-map-zoom-in" class="icon-button" title="Zoom in" @onclick="@(() => workspace!.Zoom(0.8))"><IconLabel Icon="zoom-in" Label="Zoom in" /></button>
                        <button type="button" id="play-map-zoom-out" class="icon-button" title="Zoom out" @onclick="@(() => workspace!.Zoom(1.25))"><IconLabel Icon="zoom-out" Label="Zoom out" /></button>
                        <button type="button" id="play-map-fit" class="icon-button" title="Fit" @onclick="@(() => workspace!.Fit())"><IconLabel Icon="fit" Label="Fit" /></button>
                        <button type="button" id="map-rotate" class="icon-button" title="Rotate map" aria-pressed="@(workspace?.Rotated == true ? "true" : "false")" @onclick="@(() => workspace!.ToggleRotation())"><IconLabel Icon="rotate" Label="Rotate map" /></button>
