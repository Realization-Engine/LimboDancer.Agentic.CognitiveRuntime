    private IReadOnlyList<CloseCombatStacking.Smc> StackingChoices => [.. CloseCombatUnits
        .Where(unit => Library.Vocabulary.IsA(unit.Kind, "asl:smc") && (Viewer.IsAdjudicator || viewAs == unit.Side))
        .Select(smc => new CloseCombatStacking.Smc(smc.Id, [.. CloseCombatUnits.Where(unit => unit.Side == smc.Side && Library.Vocabulary.IsA(unit.Kind, "asl:mmc")).Select(unit => unit.Id)]))];

