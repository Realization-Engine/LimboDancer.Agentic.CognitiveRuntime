    /// <summary>The side whose own fire phase it is, which may massacre (A20.4): the phasing side in the PFPh and AFPh, the other in the DFPh.</summary>
    private string? MassacringSide => state is null ? null
        : state.Phase is "pfph" or "afph" ? state.PhasingSide
        : state.Phase == "dfph" ? state.Sides.FirstOrDefault(side => side.Id != state.PhasingSide)?.Id : null;

    /// <summary>An option of a pending choice in words: take or decline, or the Location that keeps an Acquisition.</summary>
    private static string ChoiceOptionText(PendingChoice choice, string option) => (choice.Kind, option) switch
    {
        // C2.2401 (pass 55): the moving vehicle's MA fires first, or the declared shot resolves.
        (ChoicePending.GunDuel, ChoicePending.Duel) => "fire first (Gun Duel)",
        (ChoicePending.GunDuel, _) => "decline: the declared shot resolves",
        // A12.14 (pass 70, ruling R70.21): force the loss, showing a concealed unit for a moment, or let the stack keep its "?".
        (ChoicePending.ConcealmentLoss, ChoicePending.Take) => "force the loss of its \"?\"",
        (ChoicePending.ConcealmentLoss, _) => "decline: it keeps its \"?\"",
        // A14.4 (pass 71, ruling R71.10): every unit that may take it makes the one combined Sniper Check, or none does.
        (ChoicePending.SniperCheck, ChoicePending.Take) => "take the Sniper Check",
        (ChoicePending.SniperCheck, _) => "decline: no Sniper Check",
        (_, ChoicePending.Take) => "take it",
        (_, ChoicePending.Decline) => "decline it",
        (ChoicePending.Acquisition, _) => $"keep it on {option}",
        (ChoicePending.Paatc, ChoicePending.Reveal) => "reveal them",
        (ChoicePending.Paatc, _) => "take one combined PAATC",
        _ => option,
    };

    /// <summary>Whether the view may answer for a side: that side's view or the adjudicator (ruling R23.1).</summary>
    private bool MayAnswer(string? side) => Viewer.IsAdjudicator || viewAs == side;

    /// <summary>A pending choice's options in words (plan C08), given only to a view that may answer.</summary>
    private IReadOnlyList<PendingChoicePanel.Option> ChoiceOptions(PendingChoice choice) => MayAnswer(choice.Side)
        ? [.. choice.Options.Select(option => new PendingChoicePanel.Option(option,
            choice.Kind == ChoicePending.OverrunEvade ? $"into {PlaceOf(option)}" : choice.Kind == ChoicePending.Sniper ? SniperOptionText(choice, option)
            : choice is { Kind: ChoicePending.SniperCheck } && option == ChoicePending.Take ? SniperCheckTake(choice) : ChoiceOptionText(choice, option)))]
        : [];

    /// <summary>
    /// An answer of the Sniper player in his view's words (A14.2, A14.21; pass 71, ruling R71.12): attack or reposition, a hex or Location in brackets, or a
    /// target named after its hex, "[G4]: 4-6-7 squad"; a concealed stack only as a "?" stack in its hex.
    /// </summary>
    private string SniperOptionText(PendingChoice choice, string option)
    {
        var place = choice.Resume.TryGetProperty("place", out var at) ? PlaceOf(at.GetString() ?? string.Empty) : string.Empty;
        var split = option.IndexOf(':', StringComparison.Ordinal);
        var (role, id) = split > 0 && !BoardLocation.TryParse(option, out _) ? (option[..split], option[(split + 1)..]) : (string.Empty, option);
        return (option, role) switch
        {
            (ScenarioA1Sniper.Attack, _) => "attack: make the Random Location DR (A14.2)",
            (ScenarioA1Sniper.Reposition, _) => "forfeit the attack and reposition the Sniper counter (A14.2)",
            (ScenarioA1Sniper.RandomSelection, _) => "Random Selection among the targets (A14.2)",
            // Pass 71's fixes (R5's finding 2, R4's finding 15): every option hex first, and the vehicle itself told apart from its crew.
            (ScenarioA1Sniper.ConcealedStack, _) => $"{place}: a \"?\" stack",
            (_, ScenarioA1Sniper.ConcealedStack) => $"{place}: tied target {id} beneath the \"?\" (A14.23)",
            (_, ScenarioA1Sniper.SniperTarget) => $"{place}: the {DisplayText.Side(state?.Find(id)?.Side)} Sniper counter",
            (_, ScenarioA1Sniper.CrewTarget) => UnitPlaceOf(id) is { } crewAt ? $"{crewAt.Where}: the Inherent crew of {UnitGrouping.WithoutPlace(Words(id), crewAt.Where)}" : $"the Inherent crew of {Words(id)}",
            (_, ScenarioA1Sniper.VehicleTarget) => $"{UnitAt(id)}, the vehicle itself (A14.33)",
            (_, ScenarioA1Sniper.UnitTarget) => UnitAt(id),
            _ => PlaceOf(option),
        };
    }

    // The Sniper Check its answering side would take, read once a state (the Memory and Performance Guidelines: page projections by state and viewer).
    private (GameState? State, string Key, string Text) sniperCheckOffer;

    /// <summary>
    /// "take the Sniper Check" for the answering side's view, with the units that would take it, hex first, and their DRM with its causes (A14.4; pass 71,
    /// R4's finding 2). The public choice names none of them (ruling R71.18); only a view that may answer is given the options.
    /// </summary>
    private string SniperCheckTake(PendingChoice choice)
    {
        if (state is null)
        {
            return "take the Sniper Check";
        }

        var key = $"{choice.Key}|{Viewer.Name}";
        if (!ReferenceEquals(sniperCheckOffer.State, state) || sniperCheckOffer.Key != key)
        {
            var (units, drm, causes) = Live.Planner.SniperCheckOffer(state, choice);
            var text = units.Count == 0 ? "take the Sniper Check: no unit here may take it, so none is made (A14.4)"
                : $"take the Sniper Check: {UnitAt(units[0])}{string.Concat(units.Skip(1).Select(id => ", " + UnitGrouping.WithoutPlace(Words(id), UnitPlaceOf(id)?.Where)))}, "
                    + (drm == 0 ? "DRM 0" : $"DRM {drm.ToString("+0;-0", System.Globalization.CultureInfo.InvariantCulture)} ({string.Join(", ", causes)})");
            sniperCheckOffer = (state, key, text);
        }

        return sniperCheckOffer.Text;
    }

    /// <summary>
    /// The firing side's units that may offer a Massacre (A20.4): Russian or berserk personnel not in Melee sharing a Location with an enemy
    /// prisoner. The planner decides the rest.
    /// </summary>
    private IEnumerable<(UnitInstance Unit, UnitInstance Prisoner)> Massacres(string side) => state is null ? []
        : from unit in state.Units
          where unit.Status == InstanceStatus.Active && unit.Side == side && Library.Vocabulary.IsA(unit.Kind, "asl:personnel")
              && GameState.Condition(unit, Conditions.Captured) != ConditionState.True && GameState.Condition(unit, Conditions.Melee) != ConditionState.True
              && (GameState.Condition(unit, Conditions.Berserk) == ConditionState.True || (unit.Definition is { } reference && Definitions.FirstOrDefault(definition => definition.Id == reference.Definition)?.Nationality == "russian"))
          let at = state.Location(unit.Id)?.Location
          where at is not null
          from prisoner in state.At(at).OfType<UnitInstance>()
          where prisoner.Status == InstanceStatus.Active && prisoner.Side != side && GameState.Condition(prisoner, Conditions.Captured) == ConditionState.True
          orderby unit.Id, prisoner.Id
          select (unit, prisoner);

