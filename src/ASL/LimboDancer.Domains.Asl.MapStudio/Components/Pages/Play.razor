                        @if (state.Phase != "mph" && state.Find(ordnanceGun) is EquipmentInstance { Kind: "asl:gun" } chosenGun)
                        {
                            <GunArcAction Facing="@ordnanceTurn" OnFacing="@(facing => ordnanceTurn = facing)" OnPropose="@ProposeTurnGun"
                                Arc="@([.. FireTargets(firing).Select(at => new GunArcAction.ArcReading(at, LimboDancer.Domains.Asl.Maps.Coordinates.BoardLocation.TryParse(at, out var reading) ? Live.Planner.GunTargetStatus(state, chosenGun.Id, reading) ?? "not read" : "not read"))])" />
                        }
                    }
                }
                </fieldset>
            }
            </CascadingValue>
            </CascadingValue>
        </section>
            </text>;
        }
        @if (MapLayers is { Board: { } mapBoard } layers)
        {
            <BoardWorkspace @key="@($"{gameId}/{Viewer.Name}")" ViewKey="@($"{gameId}/{Viewer.Name}")" HexNotes="@HexNotes" @ref="workspace" Board="@mapBoard" Units="@MapUnits(layers)" UnitView="@layers.View" Marks="@SetupMarks(mapBoard, layers.Marks)" Vocabulary="@Library.Vocabulary" OnLoaded="@ZoomToSetup"
                            Selected="@(highlight is { } picked ? GameMaps.FactsAt(mapBoard, picked) : null)"
                            SelectedChanged="@(facts => PickHex(mapBoard, facts))"
                            @bind-Panel="inspectorTab" Extras="@([new BoardInspector.ExtraTab(new("proposal", "Proposal", AwaitingConfirm ? 1 : null), proposalBlock)])"
                            HoldPanel="@(AwaitingConfirm || SetupMode)" OnKey="@MapKey" InspectorLabel="Review and inspector" IdPrefix="play-inspector" MapLabel="The game's map" InspectorFirst="@(!narrow)"
                            InspectorClass="play-pane play-review inspector" InspectorAttributes="@ReviewAttributes"
                            StageClass="play-pane play-map-pane play-map" StageAttributes="@MapAttributes(layers.Source)" Between="@between">
                <Toolbar>
                    @if (state!.ResidualFire.Count > 0)
                    {
                        <p id="play-residual">
                            Residual FP this MPh (A8.2):
                            @string.Join("; ", state.ResidualFire.Select(item => $"{item.Fp} in {PlaceOf(item.Location)}"))
                        </p>
                    }
                    <div class="toolbar play-map-tools">
                        <button type="button" id="play-map-zoom-in" aria-label="Zoom in" @onclick="@(() => workspace!.Zoom(0.8))">+</button>
                        <button type="button" id="play-map-zoom-out" aria-label="Zoom out" @onclick="@(() => workspace!.Zoom(1.25))">-</button>
                        <button type="button" id="play-map-fit" @onclick="@(() => workspace!.Fit())">Fit</button>
                        <button type="button" id="map-rotate" aria-pressed="@(workspace?.Rotated == true ? "true" : "false")" @onclick="@(() => workspace!.ToggleRotation())">Rotate map</button>
                        <span class="muted" id="play-map-keys">Drag to pan. With the map focused, + and - zoom and 0 fits. Click a hex or a counter to inspect it.</span>
                    </div>
                    @if (SetupMode && PlansOffered is { Plans.Count: > 0 } switchable)
                    {
                        @* Pass 30: the map shows one source at a time, a setup plan or the list, and never fills the list by showing. *@
                        <div class="toolbar setup-switcher" id="setup-switcher" role="group" aria-label="Shown on the map">
                            <span class="toolbar-note">The map shows:</span>
                            @foreach (var plan in switchable.Plans)
                            {
                                <button type="button" id="@($"map-show-{plan.Id}")" aria-pressed="@(shownPlan == plan.Id ? "true" : "false")" @onclick="@(() => shownPlan = plan.Id)">@plan.Name</button>
                            }
                            <button type="button" id="map-show-list" aria-pressed="@(shownPlan is null ? "true" : "false")" @onclick="@(() => shownPlan = null)">My list</button>
                            <span class="muted">With the map focused, [ and ] step through them.</span>
                        </div>
                    }
                    @if (SetupMode && narrow && (MaySetUp.Count > 0 || placements.Count > 0))
                    {
                        <div class="setup-bar" id="setup-bar-map" role="group" aria-label="Setup">
                            <p class="setup-bar-text"><strong>@SetupBarTitle</strong> <span>@SetupBarProgress</span> <span>@SetupBarSource</span></p>
                            @if (setupAsk is { } asked)
                            {
                                <div class="toolbar">
                                    <span>@asked.Text</span>
                                    <button type="button" id="map-ask-yes" @onclick="@(() => AnswerAsk(true))">@asked.Yes</button>
                                    <button type="button" id="map-ask-no" class="link" @onclick="@(() => AnswerAsk(false))">Keep my list</button>
                                </div>
                            }
                            else
                            {
                                <div class="toolbar">
                                    <button type="button" id="map-propose-setup" disabled="@(placements.Count == 0 || busy)" @onclick="@ProposeSetup">Propose setup</button>
                                    <button type="button" id="map-edit-list" class="link" @onclick="@(() => { setupTab = "counters"; ShowActions(); })">Edit the list (@placements.Count)</button>
                                    @if (shownPlan is { } shownId && PlansOffered?.Plans.FirstOrDefault(plan => plan.Id == shownId) is { } shownOne && shownId != chosenPlan)
                                    {
                                        <button type="button" id="map-use-shown" @onclick="@(() => AskUsePlan(shownId))">Use @shownOne.Name</button>
                                    }
                                </div>
                            }
                        </div>
                    }
                    @if (SetupMode && MaySetUp.Count > 0)
                    {
                        <div class="toolbar" id="setup-map-tools">
                            <button type="button" id="map-zoom-setup" @onclick="@ZoomToSetup">Zoom to the setup area</button>
                            @if (AnsweredPlan is { } theirPlan)
                            {
                                @* Pass 30b: the plan a response answers, drawn under the enemy's stacks from that plan's public placements and never from the game. *@
                                <button type="button" id="map-their-outline" aria-pressed="@(theirOutline ? "true" : "false")" @onclick="@(() => theirOutline = !theirOutline)">Their plan's outline</button>
                                @if (theirOutline)
                                {
                                    <span class="muted" id="setup-their-legend">Dashed purple with a number: where @theirPlan.Name would put their stacks, and how many counters. A stack with no outline, or an outline with no stack, is where their setup differs from that plan.</span>
                                }
                            }
                            <span class="muted" id="setup-draft-note">@(shownPlan is not null ? "The counters of the plan shown are a draft: nothing is in the game yet."
                                : placements.Count > 0 ? "The counters of your list are a draft, drawn paler, with their hexes outlined: nothing is in the game until you propose and confirm." : string.Empty)</span>
                        </div>
                    }
                    @if (SetupMode)
                    {
                        <div id="setup-move-live" aria-live="polite">
                            @if (MoveBanner is { } moving)
                            {
                                <p id="setup-move-banner" class="diagnostic">
                                    @moving
                                    <label>or type its Location <input id="setup-move-location" size="11" placeholder="bd01:F5:1" @onchange="@(args => MoveTyped(args.Value as string ?? string.Empty))" /></label>
                                    <button type="button" class="link" id="setup-move-cancel" @onclick="@(() => pickingKey = null)">Cancel</button>
                                </p>
                            }
                            @if (swapFrom is { } swapping && BoardLocation.TryParse(swapping, out var swapAt))
                            {
                                <p id="setup-swap-banner" class="diagnostic">
                                    Click another hex of your list, on the map or by a stack's name in the list, to swap its counters with those in @PlaceOf(swapAt): all levels of both hexes change places.
                                    A stack of Dummies swapped with a stack under "?" of the same height looks the same to the other side. Esc on the map cancels.
                                    <button type="button" class="link" id="setup-swap-cancel" @onclick="@(() => swapFrom = null)">Cancel</button>
                                </p>
                            }
                            else if (swapNote is not null)
                            {
                                <p id="setup-swap-note" class="diagnostic">@swapNote</p>
                            }
                        </div>
                    }
                </Toolbar>
            </BoardWorkspace>
        }
        else
        {
            <section id="play-panel-review" class="play-pane play-review" aria-label="Review" aria-busy="@(busy ? "true" : "false")" tabindex="-1" @ref="reviewFallback">
                @proposalBlock
            </section>
            @between
            <section id="play-panel-map" class="play-pane play-map-pane" @attributes="@Pane("map", "Map")">
                <ul id="play-map-problems">
                    @foreach (var problem in MapLayers?.Problems ?? [])
                    {
                        <li>@problem</li>
                    }
                </ul>
            </section>
        }
        <section id="play-panel-activity" class="play-pane play-activity" @attributes="@Pane("activity", "Activity")">
            <p id="play-latest">@(LatestRecord ?? "No record yet.")</p>
            @* Pass 31c (designs D15 and D17): the records, the units, the scripted dice, and the audit open over the strip, each with its own
               scroll, and take no height from the map. Every panel stays in the page; only the one chosen shows. *@
            <div class="toolbar play-activity-tabs" role="group" aria-label="More of the game">
                @foreach (var (key, label, panel) in ActivityTabs)
                {
                    <button type="button" class="link" id="@($"play-activity-{key}")" aria-expanded="@(activityTab == key ? "true" : "false")" aria-controls="@panel"
                            @onclick="@(() => activityTab = activityTab == key ? null : key)">@label</button>
                }
            </div>
            <div id="play-history" class="play-activity-panel" role="region" aria-label="Records, latest first" hidden="@(activityTab != "records")">
                <DiceRollHistory Rolls="@RollRows" Scripted="@(Scripted is not null)" />
                @* Pass 31b: each record leads to its step on the Replay page, read in the view shown here. *@
                <ActionRecordList Heading="Ordnance" ListId="play-ordnance" When="@WhenOf" Replay="@ReplayFrom" Records='@Entries(OrdnanceRecords, "ordnance")' />
                <FireHistory Records="@FireRecords" When="@WhenOf" Replay="@ReplayFrom" />
                <ActionRecordList Heading="Close Combat" ListId="play-close-combats" When="@WhenOf" Replay="@ReplayFrom" Records='@Entries(CloseCombatRecords, "cc")' />
                <ActionRecordList Heading="Night and weather" ListId="play-night" When="@WhenOf" Replay="@ReplayFrom" Records='@Entries(NightRecords, "night")' />
                <ActionRecordList Heading="Snipers" ListId="play-snipers" When="@WhenOf" Replay="@ReplayFrom" Records='@Entries(SniperRecords, "sniper")' />
                <ActionRecordList Heading="Rally, Rout, and other actions" ListId="play-rallies" When="@WhenOf" Replay="@ReplayFrom"
                                  Records="@([.. RallyAndRepairRecords.Select(item => new ActionRecordList.Entry(item.EventId, item.Kind, item.Text))])" />
            </div>
            <div id="play-units-panel" class="play-activity-panel" role="region" aria-label="Units" hidden="@(activityTab != "units")">
                <h3>Units</h3>
                @* A side is shown no revision in a game still played (backlog section 49; ruling R31b.1). *@
                <PlayUnitTable ViewNote="@(Viewer.IsAdjudicator ? $"As the adjudicator sees them: every unit, at revision {state.Revision}." : $"As {DisplayText.ViewName(Viewer.Name)} sees them{(state.Ended is not null ? $", at revision {state.Revision}" : string.Empty)}.")"
                               Rows="@UnitRows" Sealed="@([.. SealedPresences])" Locate="@LocateHex" />
            </div>
            @if (Scripted is { } scriptedDice)
            {
                <div id="play-dice-panel" class="play-activity-panel" role="region" aria-label="Scripted dice" hidden="@(activityTab != "dice")">
                    <ScriptedDicePanel Queued="@([.. scriptedDice.Queued])" @bind-Input="scriptedInput" Add="QueueDice" Clear="@(() => scriptedDice.Clear())" Problem="@scriptedProblem" />
                </div>
            }
            @if (Viewer.IsAdjudicator)
            {
                <div id="play-audit-panel" class="play-activity-panel" role="region" aria-label="Audit" hidden="@(activityTab != "audit")">
                    <AdjudicatorAuditPanel Lines="@Live.Audit.Tail(12).ToArray()" />
                </div>
            }
        </section>
    </div>
}

</CascadingValue>
</ChildContent>
</HandOverScreen>

@code {
    private string? scriptedInput;
    private string? scriptedProblem;

    /// <summary>The scripted dice of a UI test run, when this run of the Studio has them.</summary>
    private ScriptedDice? Scripted => Services.GetService<ScriptedDice>();

    private void QueueDice()
    {
        var parts = (scriptedInput ?? "").Split([' ', ',', ';'], StringSplitOptions.RemoveEmptyEntries);
        var values = parts.Select(part => int.TryParse(part, NumberStyles.None, CultureInfo.InvariantCulture, out var value) ? value : 0).ToList();
        scriptedProblem = values.Count > 0 && Scripted!.Enqueue(values) ? null : "Each die is a number from 1 to 6.";
        if (scriptedProblem is null)
        {
            scriptedInput = null;
        }
    }

    /// <summary>
    /// A placement waiting to be proposed. <paramref name="Role"/> says how its holder holds it: a SW possessed, a Gun manned or towed (C10.1), a unit riding
    /// as a Passenger (D6.1); <paramref name="Entry"/> names the entry area of a counter set up off board (ruling R25.4).
    /// </summary>
    private sealed record Placement(string Id, string? Definition, string Kind, string Side, string Location, bool Concealed, bool Hidden, string? Holder,
        bool Broken = false, string? Facing = null, string? BoreSighted = null, string? Group = null, bool OffBoard = false, string? Role = null, string? Entry = null)
    {
        /// <summary>Whether "Set up this group" made the row (pass 30); asking again replaces the group's rows it made.</summary>
        public bool Auto
        {
            get; init;
        }

        /// <summary>The placement's own key, so one of two placements with the same id is removed alone (plan section 15.3).</summary>
        public string Key { get; init; } = Guid.NewGuid().ToString("N");
    }

    private string? scenarioCard;
    private string? scenarioSha;
    private string newBalance = string.Empty;
    private string playerOne = string.Empty;
    private string playerTwo = string.Empty;

    /// <summary>
    /// The setup of a game from a card (pass 19, ruling R19.2): the game's, or before the game exists the chosen card's with nothing yet set up.
    /// </summary>
    private SetupReport? SetupView => state is not null ? ReadsNow.Setup
        : ChosenCard is { Minimal: false } card ? ScenarioSetup.Check(card, [], _ => null, _ => true, ScenarioA1FireReference.HalfSquadOf, card.Date.Month)
        : null;

    /// <summary>The units the view may see, as R12 shows them: their movement and conditions in words (ruling R23.1).</summary>
    private IReadOnlyList<PlayUnitTable.Row> UnitRows => state is null ? [] : [.. VisibleUnits.Select(unit => new PlayUnitTable.Row(unit.Id, unit.Side,
        DisplayText.Kind(unit.Kind),
        unit.Status is InstanceStatus.Active or InstanceStatus.Wrecked ? state.Location(unit.Id)?.Location : null, unit.Status.ToString().ToLowerInvariant(),
        (unit.Status == InstanceStatus.Wrecked ? "wreck" : LiveFire.IsVehicle(unit) ? $"{HalfMpText(GamePlanner.VehicleHalfMp(unit).Spent)} of {HalfMpText(GamePlanner.VehicleHalfMp(unit).Allotment)} MP"
            : unit.MfSpent.ToString(CultureInfo.InvariantCulture)) + (unit.MovementEnded ? ", movement ended" : ""),
        string.Join(", ", unit.Conditions.Where(pair => pair.Value == ConditionState.True).Select(pair => ConditionText(pair.Key)).Concat(Custody(unit)).Concat(VehicleNotes(unit)).Concat(CargoNotes(unit))
            .Concat(state.Encircled(unit) ? ["Encircled (A7.7)"] : [])
            .Concat(unit.Status == InstanceStatus.Wrecked && GamePlanner.IsBurning(state, unit) ? ["burning (Blaze)"] : []))))];

    private string DefinitionLabel(string id) => PublishedCatalog?.Definition(id) is { } definition ? ScenarioCards.Describe(definition) : id;
    private string placeGroup = string.Empty;
    private string? placeNote;
    private readonly Dictionary<(string Name, string? Sha256), ScenarioCardRead?> cardReads = new();

    /// <summary>
    /// A card read once per text (referees, passes 18 and 22): every render reads it from here, and a card changed in the editor meanwhile is read
    /// afresh.
    /// </summary>
    private ScenarioCardRead? CardRead(string name)
    {
        var key = (name, CardSha(name));
        if (!cardReads.TryGetValue(key, out var read))
        {
            cardReads[key] = read = PublishedCatalog is { } catalog ? Live.Cards.Read(name, catalog) : null;
        }

        return read;
    }

    private string? CardSha(string name) => Live.Cards.Sha256(name);

    private (string Id, string? Sha, string StartSha, string Catalog)? provenanceKey;
    private CardProvenance? provenance;

    /// <summary>The game's card provenance (K21), built again only when the card, its hash, or the game changes (UI review, pass 22b).</summary>
    private CardProvenance GameProvenance(ScenarioCard card, string id, string startSha, UnitCatalog catalog)
    {
        var key = (id, CardSha(id), startSha, $"{state!.Catalog.Catalog}@{state.Catalog.Version}");
        if (provenance is null || provenanceKey != key)
        {
            provenance = CardProvenance.Of(card, Live.Cards.IsUser(id), Live.Cards.UserFile(id), key.Item2 ?? startSha, catalog,
                new ScenarioCardReferenceFacts(id, startSha, key.Item4, key.Item2));
            provenanceKey = key;
        }

        return provenance;
    }

    /// <summary>Whether the new game comes from a scenario card, which fills and locks the start fields (ruling R18.1).</summary>
    private bool CardChosen => scenarioCard is not null;

    private ScenarioCard? ChosenCard => scenarioCard is not null ? CardRead(scenarioCard)?.Card : null;

    private string CardTitle(string name) => CardRead(name)?.Card is { } card ? card.Title : name;

    /// <summary>The cards a new game may start from (K02).</summary>
    private IReadOnlyList<CardPicker.Choice> CardChoices => [.. Live.Cards.Names.Select(name => new CardPicker.Choice(name, CardTitle(name), Live.Cards.IsUser(name)))];

    /// <summary>The start the chosen card gives, worded for the summary (K03); null before a card is chosen.</summary>
    private CardStartSummary.StartLines? NewStart => ChosenCard is not { } card ? null : new(
        newBoard,
        // Table player, pass 22b: the Game Turns and who sets up first, which may differ from who moves first.
        $"{card.Turns.Count} Game Turns{(card.Turns.HalfTurn ? ", the last with one Player Turn" : string.Empty)}; {card.Turns.SetsUpFirst} sets up first; "
            + (card.Turns.MovesFirst is { } movesFirst ? $"{movesFirst} moves first" : "a dr decides who moves first"),
        $"{firstSide}: ELR {(firstElr.Length > 0 ? firstElr : card.Minimal ? "none" : "by OB group")}, SAN {firstSan}, FBE {(firstEdge.Length > 0 ? firstEdge : "not named")}; "
            + $"{secondSide}: ELR {(secondElr.Length > 0 ? secondElr : card.Minimal ? "none" : "by OB group")}, SAN {secondSan}, FBE {(secondEdge.Length > 0 ? secondEdge : "not named")}",
        $"{ScenarioCards.PlaceAndDate(card)}; SSRs the game enforces: {(newRules.Length > 0 ? newRules : "none")}{(card.SpecialRules.Count > 0 ? $" (the card prints {card.SpecialRules.Count} SSR{(card.SpecialRules.Count == 1 ? string.Empty : "s")}; the Scenarios page says which are enforced)" : string.Empty)}; Scenario Defender: {(newDefender.Length > 0 ? newDefender : "none")}",
        card.Turns.MovesFirst is null ? $"{card.Turns.MovesFirstNote} The game rolls a dr for each side as it starts; the higher moves first (ruling R20.2)." : null);

    /// <summary>The sides that may take their Balance (K04); none for a minimal card.</summary>
    private IReadOnlyList<string>? BalanceSides => ChosenCard is { Minimal: false } card ? [.. card.Sides.Select(side => side.Side)] : null;

    /// <summary>Each side's Balance as the card prints it (K04), so the choice is not made blind.</summary>
    private IReadOnlyDictionary<string, string>? BalanceTexts => ChosenCard is { Minimal: false } card
        ? card.Sides.ToDictionary(side => side.Side, side => side.Balance, StringComparer.Ordinal) : null;

    /// <summary>The OB groups a placement may name (ruling R18.3): the game's, or the chosen card's before the game starts.</summary>
    private IReadOnlyList<(string Side, ObGroup Group)> GroupChoices => state is not null
        ? [.. state.Sides.SelectMany(side => side.Groups.Select(group => (side.Id, group)))]
        : ChosenCard is { } card
            ? [.. card.Sides.SelectMany(side => side.Groups.Select((group, index) => (side.Side, new ObGroup(ScenarioCards.GroupId(side.Side, index), group.Name, group.Elr))))]
            : [];

    /// <summary>Fills the start fields from a card (backlog pass 18, ruling R18.1), or frees them when no card is chosen.</summary>
    private void ChooseCard(string? chosen)
    {
        scenarioCard = chosen is { Length: > 0 } ? chosen : null;
        placeEntry = string.Empty;
        // Referee, pass 18: the card's hash as the page read it, so a card changed before the setup is refused (ruling R18.1).
        scenarioSha = scenarioCard is null ? null : CardSha(scenarioCard);
        var choices = GroupChoices.Select(choice => choice.Group.Id).ToHashSet(StringComparer.Ordinal);
        for (var index = 0; index < placements.Count; index++)
        {
            if (placements[index].Group is { } stale && !choices.Contains(stale))
            {
                placements[index] = placements[index] with { Group = null, Entry = null };
            }
        }

        if (ChosenCard is not { } card)
        {
            return;
        }

        newLabel = card.Title;
        newBoard = string.Join(' ', card.Boards.Select(board => card.Boards.Count == 1 && !board.Reversed
            ? board.Board : $"{board.Board}@{board.Column},{board.Row}{(board.Reversed ? "/r" : string.Empty)}"));
        // Pass 20 (ruling R20.2): a die-roll card is rolled as the game starts; the fields list the side that sets up first.
        FillFromCard(card, card.Turns.MovesFirst ?? card.Turns.SetsUpFirst);
        newBalance = string.Empty;

        newDefender = card.ScenarioDefender ?? string.Empty;
        newRules = string.Join(' ', card.Tokens);
    }

    /// <summary>The sides' fields from a card, looked up by side (referee, pass 18): the first side as given, the other second.</summary>
    private void FillFromCard(ScenarioCard card, string first)
    {
        firstSide = first;
        secondSide = card.Sides.First(side => side.Side != first).Side;
        ScenarioCardSide Of(string id) => card.Sides.First(side => side.Side == id);
        string Elr(string id) => Of(id).Groups.Select(group => group.Elr).Distinct().ToArray() is [var only]
            ? only.ToString(CultureInfo.InvariantCulture) : Of(id).Elr?.ToString(CultureInfo.InvariantCulture) ?? string.Empty;
        (firstElr, secondElr) = (Elr(firstSide), Elr(secondSide));
        (firstSan, secondSan) = (Of(firstSide).San.ToString(CultureInfo.InvariantCulture), Of(secondSide).San.ToString(CultureInfo.InvariantCulture));
        (firstEdge, secondEdge) = (Of(firstSide).FriendlyEdge.Edge, Of(secondSide).FriendlyEdge.Edge);
    }

    private string placeFacing = "east";
    private string placeEntry = string.Empty;
    private bool hookBoards;
    private string vehicleEntryHex = string.Empty;
    private string vehicleEntryFacing = string.Empty;
    private readonly HashSet<string> vehicleLoad = new(StringComparer.Ordinal);
    private readonly HashSet<string> vehicleUnload = new(StringComparer.Ordinal);

    /// <summary>The setup placement being drafted (plan P08), as the form shows it.</summary>
    private SetupPlacementEditor.SetupDraft PlaceDraft => new(placeDefinition, placeId, placeGroup, placeLocation, placeHolder, placeFacing, placeBore, placeConcealed,
        placeHidden, placeBroken, placeOffBoard, placeEntry);

    /// <summary>A change to the drafted placement; the entry area is cleared when the group changes or the counter no longer waits off board.</summary>
    private void ApplyPlaceDraft(SetupPlacementEditor.SetupDraft draft)
    {
        placeEntry = draft.Group != placeGroup || !draft.OffBoard ? string.Empty : draft.Entry;
        (placeDefinition, placeId, placeGroup, placeLocation, placeHolder, placeFacing, placeBore) =
            (draft.Definition, draft.Id, draft.Group, draft.Location, draft.Holder, draft.Facing, draft.Bore);
        (placeConcealed, placeHidden, placeBroken, placeOffBoard) = (draft.Concealed, draft.Hidden, draft.Broken, draft.OffBoard);
    }

    /// <summary>The counters the setup form offers: the catalog's, then a Dummy and the Sniper counter per side.</summary>
    private IReadOnlyList<SetupPlacementEditor.Choice> DefinitionChoices =>
    [
        .. Definitions.Select(definition => new SetupPlacementEditor.Choice(definition.Id,
            $"{definition.Id} ({definition.Nationality} {DisplayText.Kind(definition.Kind)})")),
        .. new[] { firstSide, secondSide }.Distinct(StringComparer.Ordinal).SelectMany(side => new[]
        {
            new SetupPlacementEditor.Choice(DummyPrefix + side, $"a Dummy ({side})"),
            new SetupPlacementEditor.Choice(SniperPrefix + side, $"the Sniper counter ({side})"),
        }),
    ];

    private IReadOnlyList<SetupPlacementEditor.Choice> GroupChoiceList =>
        [.. GroupChoices.Select(choice => new SetupPlacementEditor.Choice(choice.Group.Id,
            $"{choice.Side}: {choice.Group.Name}{(choice.Group.Elr is { } elr ? $", ELR {elr}" : string.Empty)}"))];

    /// <summary>The entry areas of the chosen OB group (A2.5; ruling R25.4), from the game's card or the card chosen for a new game.</summary>
    private IReadOnlyList<SetupPlacementEditor.Choice> EntryChoices
    {
        get
        {
            var card = ChosenCard ?? (state?.Scenario is { } playing ? CardRead(playing.Id)?.Card : null);
            if (card is null || placeGroup.Length == 0)
            {
                return [];
            }

            return [.. card.Sides.SelectMany(side => side.Groups.Select((group, index) => (Id: ScenarioCards.GroupId(side.Side, index), Group: group)))
                .Where(item => item.Id == placeGroup).SelectMany(item => item.Group.Areas.Where(area => area.Kind == "entry"))
                .Select(area => new SetupPlacementEditor.Choice(area.Id, $"{area.Id}: the {area.Edge} edge, Turn {area.Turn}"))];
        }
    }

    /// <summary>
    /// The placements waiting, as the list reads them (plan P09). Pass 30: a row offers what may be changed in it: a Location for a counter on the map, a
    /// holder for a SW, a Gun, or a unit that may ride, a facing for a Gun or a vehicle on the map, "?" for a unit on the map, and off board for a counter
    /// of a group that enters.
    /// </summary>
    private IReadOnlyList<SetupPlacementList.Item> PlacementItems => [.. placements.Select(placement =>
    {
        var equipment = Library.Vocabulary.IsA(placement.Kind, "asl:equipment");
        var onMap = OnMap(placement);
        var holders = HolderChoices(placement);
        return new SetupPlacementList.Item(placement.Key,
            $"{placement.Id}: {placement.Definition ?? "a Dummy"}{(placement.Group is { } inGroup ? $" ({inGroup})" : string.Empty)}"
            + (placement.OffBoard ? $", off board, to enter{(placement.Entry is { } entry ? $" by {entry}" : string.Empty)}" : string.Empty)
            + (placement.Hidden ? ", hidden" : string.Empty) + (placement.Broken ? ", broken" : string.Empty)
            + (placement.BoreSighted is { } sighted ? $", Bore Sighted on {sighted}" : string.Empty))
        {
            Label = placement.Id,
            Location = onMap ? placement.Location : null,
            Holders = equipment || holders.Count > 0 || placement.Holder is not null ? holders : null,
            Holder = placement.Holder,
            HolderLabel = placement.Kind == "asl:gun" ? "manned or towed by" : equipment ? "held by" : "aboard",
            NoHolder = equipment ? "choose" : "on foot",
            Facing = onMap && placement.Kind is "asl:gun" or "asl:vehicle" ? placement.Facing ?? "east" : null,
            Concealed = onMap && !equipment && placement.Kind is not (UnitKinds.Dummy or "asl:sniper") ? placement.Concealed : null,
            OffBoard = placement.Holder is null && !equipment && placement.Kind != "asl:sniper" && placement.Kind != UnitKinds.Dummy && GroupEnters(placement.Group) ? placement.OffBoard : null,
            Picking = placement.Key == pickingKey,
        };
    })];

    /// <summary>Whether a row has a Location of its own on the map: not off board, not held, towed, or riding; a manned Gun stands at its own.</summary>
    private bool OnMap(Placement placement) => !placement.OffBoard && placement.Role is null or "manned"
        && !(Library.Vocabulary.IsA(placement.Kind, "asl:equipment") && placement.Kind != "asl:gun");

    // Pass 30: the row whose Location the next click on the map fills; null when none is being picked.
    private string? pickingKey;

    // Pass 30: the plan the list was filled from; null when none. It is the page's own, like the list, and goes with it.
    private string? chosenPlan;

    // The card's setup plans, read once per game and card text until the game is read again.
    private (string? Game, string? Card, string? Sha256, SetupPlansRead? Read) planCache;

    /// <summary>
    /// The setup plans offered now (passes 30 and 30b; ruling R23.3): only in the view of the side whose groups are setting up, never the other side's
    /// or the adjudicator's, while the groups a plan places are setting up. Null when none is offered; a setups file that cannot be read gives its
    /// reasons.
    /// </summary>
    private (IReadOnlyList<SetupPlan> Plans, IReadOnlyList<string> Problems)? PlansOffered
    {
        get
        {
            var key = (history, state?.Revision ?? -1, viewAs, handOver, SetupOpen);
            if (!offeredCache.Read || offeredCache.Key != key)
            {
                offeredCache = (key, true, ComputePlansOffered());
            }

            return offeredCache.Plans;
        }
    }

    private ((GameHistory? History, long Revision, string View, string? HandOver, bool Open) Key, bool Read, (IReadOnlyList<SetupPlan> Plans, IReadOnlyList<string> Problems)? Plans) offeredCache;

    private (IReadOnlyList<SetupPlan> Plans, IReadOnlyList<string> Problems)? ComputePlansOffered()
    {
        {
            if (state is not { Scenario: { } playing } || !SetupOpen || history?.Current is null || handOver is not null || Viewer.IsAdjudicator
                || SetupCard is not { Minimal: false } || SetupView is not { } report || PublishedCatalog is not { } catalog)
            {
                return null;
            }

            // A group that only enters sets up off board, whatever the order setting up on the map (Armor Test's column).
            var settingUp = report.Groups.Where(group => group.Side == viewAs
                    && ((group.SetsUp && !group.Complete && group.Order == report.CurrentOrder) || (!group.SetsUp && group.OffBoard.Count > 0)))
                .Select(group => group.Id).ToHashSet(StringComparer.Ordinal);
            if (settingUp.Count == 0)
            {
                return null;
            }

            if (planCache.Game != gameId || planCache.Card != playing.Id || planCache.Sha256 != CardSha(playing.Id))
            {
                planCache = (gameId, playing.Id, CardSha(playing.Id), Live.Cards.Plans(playing.Id, catalog));
            }

            if (planCache.Read is not { } read)
            {
                return null;
            }

            var plans = read.Plans.Where(plan => plan.Side == viewAs && plan.Placements.All(item => item.Group is { } group && settingUp.Contains(group))).ToArray();
            return plans.Length == 0 && read.Diagnostics.Count == 0 ? null : (plans, read.Diagnostics);
        }
    }

    // Pass 30b: whether the map draws the footprint of the plan a response answers.
    private bool theirOutline = true;

    // Pass 30b: the hex of the list whose counters the next hex chosen changes places with, as its ground-level Location; null when none is.
    private string? swapFrom;

    // Pass 30b: what the last swap did, or why it was not done; said where the move banner is, and in the list.
    private string? swapNote;

    // Pass 30b: the plan groups the page has opened. A group once opened is never closed by the page, so a render does not close it under the
    // player, who may still close it by hand.
    private readonly HashSet<string> groupsOpened = new(StringComparer.Ordinal);

    /// <summary>
    /// What the page reads of the plans offered, once for each state of the game and view (pass 30b): the other side's plans with how closely each
    /// matches the stacks in the viewer's own view and the viewer's answers to it, the plans for any setup, the hexes where the other side is
    /// seen, and what each offered plan says of an earlier version and of being public.
    /// </summary>
    private sealed record PlanReading(IReadOnlyList<(SetupPlan Plan, SetupPlanScore Score, IReadOnlyList<SetupPlan> Answers)> Theirs, IReadOnlyList<SetupPlan> Any,
        int HexesSeen, IReadOnlyDictionary<string, string> Earlier, IReadOnlyDictionary<string, string> Notes);

    private ((GameHistory? History, long Revision, string View, string? HandOver, bool Open) Key, bool Read, PlanReading? Reading) readingCache;

    private PlanReading? Reading
    {
        get
        {
            var key = (history, state?.Revision ?? -1, viewAs, handOver, SetupOpen);
            if (!readingCache.Read || readingCache.Key != key)
            {
                readingCache = (key, true, ComputeReading());
            }

            return readingCache.Reading;
        }
    }

    /// <summary>
    /// The reading of the plans offered (pass 30b; rulings R23.1, R23.3). It uses the viewer's own view and the card's public plans, never the game's
    /// state. The other side's plans are compared only once that side's setup is in sight.
    /// </summary>
    private PlanReading? ComputeReading()
    {
        if (PlansOffered is not { Plans.Count: > 0 } offered || SetupCard is not { } card || planCache.Read is not { } read || PublishedCatalog is not { } catalog)
        {
            return null;
        }

        var earlier = offered.Plans
            .Select(plan => (plan.Id, Answered: plan.Answers is { } answers && read.Plans.FirstOrDefault(other => other.Id == answers.Plan) is { } answered
                && ScenarioSetupPlans.PlacementsSha256(answered) != answers.PlacementsSha256 ? answered.Name : null))
            .Where(item => item.Answered is not null).ToDictionary(item => item.Id, item => item.Answered!, StringComparer.Ordinal);
        var notes = offered.Plans.Select(plan => (plan.Id, Note: PlanPublicNote(plan, review: false))).Where(item => item.Note is not null)
            .ToDictionary(item => item.Id, item => item.Note!, StringComparer.Ordinal);
        if (View is not { } view || SetupView is not { } report)
        {
            return new PlanReading([], [], 0, earlier, notes);
        }

        var order = offered.Plans.Select(plan => ScenarioSetupPlans.OrderOf(card, plan)).FirstOrDefault(found => found is not null);
        var theirs = read.Plans.Where(plan => plan.Side != viewAs && ScenarioSetupPlans.OrderOf(card, plan) is { } before && before < order
            && plan.Placements.All(item => report.Groups.Any(group => group.Id == item.Group && (!group.SetsUp || group.Complete) && !Unseen.Contains(group.Id))))
            .Select(plan => (Plan: plan, Score: SetupPlanMatch.Score(view, plan, catalog),
                Answers: (IReadOnlyList<SetupPlan>)[.. offered.Plans.Where(answer => answer.Answers?.Plan == plan.Id)]))
            .OrderByDescending(item => item.Score.Share).ToArray();
        if (theirs.Length == 0)
        {
            return new PlanReading([], [], 0, earlier, notes);
        }

        // A plan that answers nothing is for any setup; so is one whose answered plan is not among those compared, so that no plan goes unlisted.
        SetupPlan[] any = [.. offered.Plans.Where(plan => plan.Answers is null || theirs.All(item => item.Plan.Id != plan.Answers.Plan))];
        return new PlanReading(theirs, any, SetupPlanMatch.Seen(view, theirs[0].Plan.Side).Count, earlier, notes);
    }

    // The share of the hexes that must agree for a plan to count as followed; under it the plan for any setup comes first.
    private const double CloseShare = 0.6;

    // The key of the group of plans for any setup; a plan's id never starts with an underscore.
    private const string AnyGroup = "_any";

    /// <summary>
    /// The viewer's plans in groups (pass 30b; rulings R23.1, R23.3), for a side that sets up after the other: one group for each of the other side's
    /// plans, in the order of how closely that plan matches the stacks in the viewer's own view, and the plans for any setup. Every plan is always
    /// listed, whatever the other side did; only the order and which group stands open come from the view. A single closest plan with an answer
    /// opens first; when the other side's plans tie, when none is followed closely, or when the closest has no answer, the plans for any setup do.
    /// Empty for the side that sets up first, and until the other side's setup is in sight.
    /// </summary>
    private IReadOnlyList<SetupPlanPicker.Group> PlanGroups
    {
        get
        {
            if (Reading is not { Theirs.Count: > 0 } reading)
            {
                return [];
            }

            var theirs = reading.Theirs;
            var close = theirs[0].Score.Share >= CloseShare;
            var alone = theirs.Count == 1 || theirs[1].Score.Share < theirs[0].Score.Share;
            var lead = close && alone && theirs[0].Answers.Count > 0;
            var picked = shownPlan ?? chosenPlan;
            bool Open(string key, bool first, IReadOnlyList<SetupPlan> plans)
            {
                if (first || plans.Any(plan => plan.Id == picked))
                {
                    groupsOpened.Add(key);
                }

                return groupsOpened.Contains(key);
            }

            var any = new SetupPlanPicker.Group(AnyGroup, "For any setup", null, false, Open(AnyGroup, !lead, reading.Any), null, reading.Any);
            SetupPlanPicker.Group[] groups = [.. theirs.Select((item, index) => new SetupPlanPicker.Group(item.Plan.Id, $"If they set up like {item.Plan.Name}",
                $"{item.Score.Matching} of {Count(item.Score.Hexes, "hex", "hexes")} match", close && alone && index == 0, Open(item.Plan.Id, lead && index == 0, item.Answers),
                item.Plan, item.Answers))];
            return reading.Any.Count == 0 ? groups : lead ? [.. groups, any] : [any, .. groups];
        }
    }

    /// <summary>What the comparison says in words: the other side's plans tie, none is followed closely, or the closest differs in some hexes.</summary>
    private string? MatchNote
    {
        get
        {
            if (Reading is not { Theirs.Count: > 0 } reading)
            {
                return null;
            }

            var (best, last) = (reading.Theirs[0], reading.Theirs[^1]);
            return reading.Theirs.Count > 1 && best.Score.Matching == last.Score.Matching && best.Score.Hexes == last.Score.Hexes
                    ? "Their plans look the same from here, so the stacks do not say which was used."
                : best.Score.Share < CloseShare ? "Their setup does not follow any of their plans closely."
                : best.Score.Matching < best.Score.Hexes && (reading.Theirs.Count == 1 || reading.Theirs[1].Score.Share < best.Score.Share)
                    ? $"{Count(best.Score.Hexes - best.Score.Matching, "hex differs", "hexes differ")} from {best.Plan.Name}: check its outline on the map before you use an answer to it."
                : null;
        }
    }

    /// <summary>What the bar says of the other side's setup, for a side that sets up after it: in how many hexes its stacks are seen, and what the comparison says.</summary>
    private string? SeenNote => Reading is { Theirs.Count: > 0 } reading
        ? $"The {DisplayText.Side(reading.Theirs[0].Plan.Side)} side has set up: you see its stacks in {Count(reading.HexesSeen, "hex", "hexes")}."
            + (MatchNote is { } note ? " " + note : string.Empty)
        : null;

    /// <summary>The plan of the other side that the plan shown on the map, or else the plan in the list, answers; null when it answers none.</summary>
    private SetupPlan? AnsweredPlan => (shownPlan ?? chosenPlan) is { } id && PlansOffered?.Plans.FirstOrDefault(plan => plan.Id == id)?.Answers is { } answers
        ? Reading?.Theirs.Where(item => item.Plan.Id == answers.Plan).Select(item => item.Plan).FirstOrDefault() : null;

    /// <summary>A plan's name with the plan it answers, as the bar, the review, and the notice say it.</summary>
    private string PlanTitle(SetupPlan plan) => plan.Answers is { } answers && planCache.Read?.Plans.FirstOrDefault(other => other.Id == answers.Plan) is { } answered
        ? $"{plan.Name} (answers {answered.Name})" : plan.Name;

    /// <summary>
    /// What a plan tells the other side when it is set up unchanged (pass 30b): the plans are public, so a side that recognises one knows where its
    /// hidden counters are, which of its hexes hold only Dummies, what is under its "?", and who holds its SW. Computed from the plan's own
    /// placements, in the view of the side that may use it.
    /// </summary>
    private (IReadOnlyList<string> Told, bool DummyHexes) PlanGivesAway(SetupPlan plan)
    {
        var told = new List<string>();

        // A hex is named with its board on a map of several boards, where two boards have a hex of the same name.
        var boards = SetupCard?.Boards.Count ?? 1;
        BoardLocation? HexOf(string? at) => BoardLocation.TryParse(at, out var parsed) ? parsed with { Level = 0 } : null;
        string Name(BoardLocation hex) => boards > 1 ? PlaceOf(hex) : hex.Hex.ToString();
        BoardLocation? Where(SetupPlanPlacement item) => HexOf(item.At ?? plan.Placements.FirstOrDefault(other => other.Id == item.Holder)?.At);
        var hidden = plan.Placements.Where(item => item.Hidden && !item.OffBoard && item.Definition is not null && Where(item) is not null).ToArray();
        if (hidden.Length > 0)
        {
            // A definition with no printed label, such as a Gun, is named by its kind.
            string Named(string definition) => DefinitionLabel(definition) is var label && label != definition ? label
                : PublishedCatalog?.Definition(definition) is { } found ? found.Kind == "asl:gun" ? "Gun" : DisplayText.Kind(found.Kind) : definition;
            told.Add("where its hidden counters are (" + string.Join(", ", hidden.Select(item => $"{Named(item.Definition!)} in {Name(Where(item)!)}")) + ")");
        }

        var standing = plan.Placements.Where(item => item.Holder is null && !item.OffBoard && HexOf(item.At) is not null).ToArray();
        var dummyOnly = standing.GroupBy(item => HexOf(item.At)!).Where(hex => hex.All(item => item.Dummy)).Select(hex => Name(hex.Key)).Order(StringComparer.Ordinal).ToArray();
        if (dummyOnly.Length > 0)
        {
            told.Add("which hexes hold only Dummies (" + string.Join(", ", dummyOnly) + ")");
        }

        if (standing.Any(item => item.Concealed && !item.Dummy))
        {
            told.Add("what is under each \"?\"");
        }

        var held = plan.Placements.Count(item => item.Holder is not null && !item.OffBoard && item.Definition is { } named && PublishedCatalog?.Definition(named) is { } definition
            && Library.Vocabulary.IsA(definition.Kind, "asl:equipment") && definition.Kind != "asl:gun"
            && plan.Placements.FirstOrDefault(other => other.Id == item.Holder) is { OffBoard: false });
        if (held > 0)
        {
            told.Add(held == 1 ? "which unit holds its SW" : $"which unit holds each of its {held} SW");
        }

        return (told, dummyOnly.Length > 0);
    }

    /// <summary>
    /// The card's other plans for the same side and setup order that look to the other side exactly as this one does (pass 30b): the same "?" and the
    /// same top counters in the same Locations. Such plans cannot be told apart by the stacks.
    /// </summary>
    private (IReadOnlyList<string> Twins, int Others) PlanTwins(SetupPlan plan)
    {
        if (SetupCard is not { } card || planCache.Read is not { } read || PublishedCatalog is not { } catalog)
        {
            return ([], 0);
        }

        var order = ScenarioSetupPlans.OrderOf(card, plan);
        var others = read.Plans.Where(other => other.Id != plan.Id && other.Side == plan.Side && ScenarioSetupPlans.OrderOf(card, other) == order).ToArray();
        var look = SetupPlanMatch.Look(plan, catalog);
        return ([.. others.Where(other => SetupPlanMatch.Look(other, catalog) == look).Select(other => other.Name)], others.Length);
    }

    /// <summary>
    /// What the side that may use a plan is told of its being public (pass 30b): what an unchanged setup gives away to a side that recognises it, or,
    /// when every other plan of the card looks the same to the other side, that the stacks do not say which of them was used, though the other side
    /// still knows what they all share. A plan with hexes of Dummies only is told how the non-OB "?" may show them (A12.12; ruling R23.6). Null when
    /// the plan has nothing to give away.
    /// </summary>
    private string? PlanPublicNote(SetupPlan plan, bool review)
    {
        var (told, dummyHexes) = PlanGivesAway(plan);
        if (told.Count == 0)
        {
            return null;
        }

        var (twins, others) = PlanTwins(plan);
        var secrets = string.Join("; ", told);
        var dummies = dummyHexes
            ? " Before play, an enemy stack that only your Dummies see may take a \"?\" (A12.12), and being offered it tells the other side that those are Dummies."
            : string.Empty;
        if (twins.Count > 0 && twins.Count == others)
        {
            return $"Setup plans are public. {plan.Name} shows the other side the same stacks as {string.Join(" and ", twins)}, so an unchanged setup does not say which of them was used. "
                + $"The other side still knows it is one of these, and whatever all of them share; move or swap stacks to hide more.{dummies}";
        }

        var partly = twins.Count > 0 ? $" It looks the same as {string.Join(" and ", twins)}, and can be told from the card's other plans." : string.Empty;
        return (review
            ? $"Setup plans are public: if the other side recognises {plan.Name}, it knows {secrets}.{partly} Move or swap those stacks first to keep that secret."
            : $"Set up unchanged, this plan can be recognised by the other side, which then knows {secrets}.{partly} To keep that secret, move or swap those stacks before you propose.")
            + dummies;
    }

    /// <summary>A Location's hex as the swap names it: its ground-level Location.</summary>
    private static string? SwapHex(string location) => BoardLocation.TryParse(location, out var at) ? (at with { Level = 0 }).ToString() : null;

    /// <summary>The counters of the list that stand in a hex, at any level.</summary>
    private Placement[] RowsIn(BoardLocation hex) =>
        [.. placements.Where(item => OnMap(item) && BoardLocation.TryParse(item.Location, out var there) && (there with { Level = 0 }) == hex)];

    /// <summary>
    /// "Swap" (pass 30b): the counters of two hexes of the list change places, all levels of each hex together, each counter keeping its level when
    /// the other hex has it. A stack of Dummies swapped with a concealed stack of the same height leaves what the other side sees as it was and
    /// changes what is under it. It is the player's act: the page swaps nothing by itself.
    /// </summary>
    private void SwapStacks(StudioBoard board, string to)
    {
        var from = swapFrom;
        swapFrom = null;
        if (!BoardLocation.TryParse(from, out var first) || !BoardLocation.TryParse(to, out var second))
        {
            return;
        }

        var (hexA, hexB) = (first with { Level = 0 }, second with { Level = 0 });
        if (hexA == hexB)
        {
            swapNote = $"That is the same hex, {PlaceOf(hexA)}, so nothing was swapped.";
            return;
        }

        if (RowsIn(hexA).Length == 0 || RowsIn(hexB).Length == 0)
        {
            swapNote = "One of the two hexes no longer holds a counter of your list, so nothing was swapped.";
            return;
        }

        var (levelsA, levelsB, lowered) = (LevelsAt(board, hexA), LevelsAt(board, hexB), false);
        for (var index = 0; index < placements.Count; index++)
        {
            if (!OnMap(placements[index]) || !BoardLocation.TryParse(placements[index].Location, out var at))
            {
                continue;
            }

            var hex = at with { Level = 0 };
            if (hex == hexA || hex == hexB)
            {
                var (target, levels) = hex == hexA ? (hexB, levelsB) : (hexA, levelsA);
                lowered |= !levels.Contains(at.Level);
                placements[index] = placements[index] with { Location = (target with { Level = levels.Contains(at.Level) ? at.Level : 0 }).ToString() };
            }
        }

        (selectedStack, highlight, shownPlan) = (null, hexB, null);
        ListChanged();
        swapNote = $"Swapped the counters in {PlaceOf(hexA)} and {PlaceOf(hexB)}."
            + (lowered ? " A counter whose level the other hex lacks went to ground level; change its level in the list if you mean another." : string.Empty);
    }

    /// <summary>A setup plan's placements as rows of the list, each keyed by its id; the holder says how a counter is held.</summary>
    private List<Placement> PlanRows(SetupPlan plan)
    {
        var rows = new List<Placement>();
        if (PublishedCatalog is not { } catalog)
        {
            return rows;
        }

        foreach (var item in plan.Placements)
        {
            if (item.Dummy)
            {
                rows.Add(new Placement(item.Id, null, UnitKinds.Dummy, plan.Side, item.At ?? string.Empty, true, false, null, Group: item.Group) { Key = item.Id });
                continue;
            }

            if (catalog.Definition(item.Definition ?? string.Empty) is not { } definition)
            {
                continue;
            }

            // A Gun is in tow of a vehicle or manned by its crew, a SW possessed, a unit riding a vehicle a Passenger.
            var equipment = Library.Vocabulary.IsA(definition.Kind, "asl:equipment");
            var byVehicle = item.Holder is { } named && plan.Placements.FirstOrDefault(other => other.Id == named) is { Definition: { } holding }
                && catalog.Definition(holding)?.Kind == "asl:vehicle";
            var role = item.Holder is null ? null : definition.Kind == "asl:gun" ? byVehicle ? "towed" : "manned" : equipment ? "possessed" : "passenger";
            rows.Add(new Placement(item.Id, definition.Id, definition.Kind, plan.Side, item.At ?? string.Empty, item.Concealed, item.Hidden, item.Holder, false,
                definition.Kind is "asl:gun" or "asl:vehicle" ? item.Facing ?? "east" : null, item.BoreSighted, item.Group, item.OffBoard && item.Holder is null, role,
                item.OffBoard ? item.Entry : null) { Key = item.Id });
        }

        return rows;
    }

    /// <summary>
    /// "Use this plan" (pass 30): the list becomes the plan's placements, each a row to adjust like any other. Nothing of the plan reaches the game
    /// but the placements proposed, which the gate checks as it checks any setup.
    /// </summary>
    private void UsePlan(string id)
    {
        if (PlansOffered?.Plans.FirstOrDefault(plan => plan.Id == id) is not { } plan)
        {
            return;
        }

        ClearPlacements();
        placements.AddRange(PlanRows(plan));
        (chosenPlan, shownPlan, setupTab, placeNote, setupDone) = (plan.Id, null, "counters", null, null);
        ListChanged();

        // Under 1024px the plan just chosen is looked at on the map, where the setup's bar is too; wider, the list takes the focus.
        if (narrow)
        {
            (paneTab, focusMap) = ("map", true);
        }
        else
        {
            ShowActions(scroll: false);
        }
    }

    // Pass 30: the plan the map shows in place of the list; null when the map shows the list. Showing never changes the list.
    private string? shownPlan;

    // Pass 30: the setup mode's open tab; null until the viewer chooses one, when the Plans tab opens if plans are offered and the list is empty.
    private string? setupTab;

    // Pass 30: the stack of the list chosen in the list or on the map; the Counters tab marks it.
    private string? selectedStack;

    // Pass 30: the element of the list to bring into view after the next render.
    private string? revealId;

    // Pass 30: a question the setup bar waits on before a list with changes is replaced or cleared.
    private (string Kind, string Text, string Yes)? setupAsk;

    // Pass 30: what the last setup committed, said where the bar is until the view changes.
    private (string Text, string? Next)? setupDone;

    // Pass 30: what a setup proposal places, written when it is proposed: the review reads it.
    private (string Text, IReadOnlyList<string> Changes, int Counters)? setupReview;

    /// <summary>Whether the actions pane is in its setup mode: a game from a card with an OB, in setup, in a confirmed view.</summary>
    private bool SetupMode => state is not null && SetupOpen && history?.Current is not null && handOver is null && SetupView is not null;

    /// <summary>Whether a card's setup still owes counters, on board or off; until then the gate refuses every other action (ruling R19.2).</summary>
    private bool SetupIncomplete => SetupView is { } report && (report.CurrentOrder is not null || report.Groups.Any(group => group.OffBoard.Count > 0));

