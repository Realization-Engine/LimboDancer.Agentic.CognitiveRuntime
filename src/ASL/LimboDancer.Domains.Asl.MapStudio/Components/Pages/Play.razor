    /// <summary>A unit as a player reads it: its id, its definition, and its state in CC.</summary>
    // Pass 31c (the second play test): the unit's name already says its printed values, so the label adds only its conditions.
    private static string UnitLabel(UnitInstance unit) => unit.Id + (new[] { Conditions.Broken, Conditions.Pinned, Conditions.Berserk, Conditions.Melee, Conditions.Concealed, Conditions.Captured, Conditions.Unarmed, "asl:ti" }
        .Where(name => GameState.Condition(unit, name) == ConditionState.True).Select(name => name.Replace("asl:", "", StringComparison.Ordinal)).ToArray() is { Length: > 0 } held
            ? $" ({string.Join(", ", held)})" : string.Empty);

    /// <summary>A condition as the Units table names it: the flipped STUN counter is "Stun +1" (D5.34).</summary>
    private static string ConditionText(string condition) => condition == Conditions.StunRecovery ? "Stun +1"
        : condition == Conditions.InexperiencedCrew ? "Inexperienced Crew (D3.45)" : condition.Replace("asl:", string.Empty, StringComparison.Ordinal);

    /// <summary>
    /// A personnel counter's printed values, as players name it: a MMC or hero by FP, range, and morale ("4-6-7"), a leader by morale and
    /// leadership ("8-1", "7-0", "9+1"). Null when the catalog does not print them.
    /// </summary>
    private string? PrintedValues(UnitInstance unit)
    {
        if (unit.Definition is not { } reference || Definitions.FirstOrDefault(definition => definition.Id == reference.Definition) is not { } definition)
        {
            return null;
        }

        int? Value(string name) => definition.Printed("front", name)?.Value?.Number;
        if (Library.Vocabulary.IsA(unit.Kind, "asl:leader"))
        {
            return Value("asl:morale") is { } morale && Value("asl:leadership") is { } leadership
                ? $"{morale}{(leadership > 0 ? "+" : "-")}{Math.Abs(leadership)}"
                : null;
        }

        return Value("asl:firepower") is { } firepower && Value("asl:range") is { } range && Value("asl:morale") is { } level ? $"{firepower}-{range}-{level}" : null;
    }

    /// <summary>
    /// The units held in Melee in the CC Location that may withdraw (A11.2: not pinned, berserk, Disrupted, or a prisoner), with their destinations: no
    /// Location of a Known enemy unit, as the planner reads it from what the side may know (pass 70, ruling R70.26), after the SW ticked to drop. A unit
    /// above its IPC is listed with no destination until enough SW are ticked, so that its drop boxes show (fix round C: the proposal reads the SW ticked).
    /// </summary>
    private IEnumerable<(UnitInstance Unit, IReadOnlyList<BoardLocation> Destinations)> WithdrawalUnits => state is null || ccLocation.Length == 0
        || !BoardLocation.TryParse(ccLocation, out var at) || CloseCombatEntry is not null
        ? []
        : CloseCombatUnits.Where(unit => GameState.Condition(unit, Conditions.Melee) == ConditionState.True
                && !new[] { Conditions.Pinned, Conditions.Berserk, Conditions.Disrupted, Conditions.Captured }.Any(name => GameState.Condition(unit, name) == ConditionState.True))
            .Select(unit => (unit, Live.Planner.WithdrawalDestinations(state, unit, at, DropsTicked(unit)))).Where(item => item.Item2.Count > 0 || MayWithdrawByDropping(item.unit, at));

    /// <summary>
    /// The SW of a unit ticked to drop, none when none is: what the proposal sends (A11.21; ruling R70.26), so that a unit above its IPC is offered no
    /// destination it would be refused (fix round C).
    /// </summary>
    private IReadOnlyCollection<string> DropsTicked(UnitInstance unit) =>
        state is null ? [] : [.. GamePlanner.PossessedSw(state, unit).Where(ccDrops.Contains)];

    /// <summary>
    /// Whether a unit above its IPC with too few SW ticked could withdraw or infiltrate from a Location once it drops enough (A11.21; ruling R70.26): the
    /// planner reads no drops named as dropping all it possesses. Read only for a unit that has SW to drop.
    /// </summary>
    private bool MayWithdrawByDropping(UnitInstance unit, BoardLocation at) =>
        DropChoices(unit).Count > 0 && Live.Planner.WithdrawalDestinations(state!, unit, at).Count > 0;

    /// <summary>
    /// The SW a unit above its IPC may drop to withdraw or infiltrate (A11.21; pass 70, ruling R70.26), each named with its hex first; none for a unit
    /// within its IPC.
    /// </summary>
    private IReadOnlyList<PlayChoice> DropChoices(UnitInstance unit) => state is null || !Live.Planner.Laden(state, unit, []) ? []
        : [.. GamePlanner.PossessedSw(state, unit).Select(id => new PlayChoice(id, $"{PlaceOf(ccLocation)}: {id}"))];

    /// <summary>The leaders who may direct the attack being declared: attackers, Good Order, not pinned or berserk (A11.141, A7.831).</summary>
    private IEnumerable<UnitInstance> CloseCombatDirectors => CloseCombatUnits.Where(unit => unit.Kind == "asl:leader" && ccAttackers.Contains(unit.Id)
        && GameState.Condition(unit, Conditions.Broken) != ConditionState.True && GameState.Condition(unit, Conditions.Pinned) != ConditionState.True
        && GameState.Condition(unit, Conditions.Berserk) != ConditionState.True);

    /// <summary>Choosing an attacker preselects the best leader to direct the attack, when none is chosen (A11.141).</summary>
    private void ToggleAttacker(string id, bool on)
    {
        Toggle(ccAttackers, id, on);

        // Table player, pass 31 (A11.14): a SMC stacked with an MMC attacks with it or not at all, so it is ticked and unticked with its MMC.
        foreach (var smc in ccStacking.Where(pair => pair.Value == id).Select(pair => pair.Key).ToArray())
        {
            if (CloseCombatUnits.FirstOrDefault(unit => unit.Id == smc) is { } stacked && !Prisoner(stacked) && !Declared(stacked, attacking: true) && !IsBroken(stacked))
            {
                Toggle(ccAttackers, smc, on);
            }
        }

        if (!CloseCombatDirectors.Any(unit => unit.Id == ccDirector))
        {
            ccDirector = string.Empty;
        }

        if (ccDirector.Length == 0 && ccAttackers.Count > 1 && CloseCombatDirectors
            .OrderBy(unit => unit.Definition is { } definition && CloseCombatDefinitions.TryGetValue(definition.Definition, out var fire) ? fire.Leadership ?? 0 : 0)
            .FirstOrDefault() is { } best)
        {
            ccDirector = best.Id;
        }
    }

    private static readonly Lazy<IReadOnlyDictionary<string, FireDefinition>> CcDefinitions = new(() => new ScenarioA1CloseCombatPackage().Reference.Definitions);

    private static IReadOnlyDictionary<string, FireDefinition> CloseCombatDefinitions => CcDefinitions.Value;

    /// <summary>Each SMC defaults to the first MMC of its side in the Location, which the player may change (A11.14).</summary>
    private void DefaultStacking()
    {
        // Pass 31 (play test P-04, P-25): a prisoner is no combatant, so it neither stacks nor is stacked with.
        foreach (var smc in CloseCombatUnits.Where(unit => Library.Vocabulary.IsA(unit.Kind, "asl:smc") && !Prisoner(unit)))
        {
            if (CloseCombatUnits.FirstOrDefault(unit => unit.Side == smc.Side && Library.Vocabulary.IsA(unit.Kind, "asl:mmc") && !Prisoner(unit)) is { } mmc)
            {
                ccStacking[smc.Id] = mmc.Id;
            }
        }
    }

