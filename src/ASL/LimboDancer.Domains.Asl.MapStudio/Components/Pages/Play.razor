        if (weather.Length > 0)
        {
            parts.Add("weather: " + string.Join(", ", weather) + " (E3)");
        }

        if (state.Precipitation is { } falling)
        {
            parts.Add(falling.Replace('-', ' ') + " is falling, causing Mist (E3.51, E3.71)");
