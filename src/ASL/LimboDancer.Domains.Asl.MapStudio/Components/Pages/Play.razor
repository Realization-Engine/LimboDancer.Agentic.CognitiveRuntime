    /// <summary>A Location as the game writes it (pass 31c, design D12): "G4, level 1" on a map of one board.</summary>
    private string PlaceOf(BoardLocation at) => DisplayText.Place(MapBoards, at);

    // The user, 2026-10-21: the lists that offer units group them by hex, leaders first. One delegate for the page's life (a fixed cascade, so
    // no list renders again for it); it reads the state at each call, a lookup of the unit and its Location.
    private Func<string, UnitPlace?>? placeOfUnitField;

    private Func<string, UnitPlace?> PlaceOfUnitNow => placeOfUnitField ??= UnitPlaceOf;

    /// <summary>A unit offered as a choice, named after its Location ("[AA6]: 5-2-7 squad R13"; the user, 2026-10-21); its name alone off the map.</summary>
    // Pass 71's fixes (Round D): the other side's unit, named by its hex, is not given that hex twice ("[L4]: 4-4-7 squad", not "... in [L4]").
    private string UnitAt(string id) => UnitPlaceOf(id) is { } place ? $"{place.Where}: {UnitGrouping.WithoutPlace(Words(id), place.Where)}" : Words(id);

    // The Memory and Performance Guidelines (page projections by state and viewer): each id's place is read once a state and view, not at each
    // render of each list that offers it.
    private (GameState? State, string View, Dictionary<string, UnitPlace?> Places) unitPlaces = (null, string.Empty, new(StringComparer.Ordinal));

    private UnitPlace? UnitPlaceOf(string id)
    {
        if (state is null)
        {
            return null;
        }

        if (!ReferenceEquals(unitPlaces.State, state) || unitPlaces.View != Viewer.Name)
        {
            unitPlaces = (state, Viewer.Name, new(StringComparer.Ordinal));
        }

        if (!unitPlaces.Places.TryGetValue(id, out var place))
        {
            place = ReadUnitPlace(state, id);
            unitPlaces.Places[id] = place;
        }

        return place;
    }

    private UnitPlace? ReadUnitPlace(GameState current, string id)
    {
        // A unit or a weapon: each stands in a Location (a weapon held, in its holder's). An id that joins a unit and its weapon ("g1|pf", a
        // tank's "t1|ma" or "t1:bmg") stands where the unit does.
        if ((current.Location(id)?.Location ?? (id.IndexOfAny(['|', ':']) is > 0 and var cut ? current.Location(id[..cut])?.Location : null)) is not { } at)
        {
            return null;
        }

        var hex = at.Hex.ToString();
        var letters = hex.TakeWhile(char.IsLetter).Count();
        _ = int.TryParse(hex.AsSpan(letters), out var row);
        // A leader is put first only where the view may know it is one: a concealed enemy leader stays where any "?" would.
        var leader = current.Unit(id) is { } unit && UnitGrouping.KnownLeader(unit.Kind == "asl:leader", Viewer.IsAdjudicator, unit.Side == viewAs,
            GameState.Condition(unit, Conditions.Concealed) == ConditionState.True || GameState.Condition(unit, Conditions.Hidden) == ConditionState.True);
        // Map order: the board, then the column (A before Z before AA), then the row.
        return new UnitPlace(PlaceOf(at with { Level = 0 }), PlaceOf(at), (0, $"{at.Board}|{letters:D2}|{hex[..letters]}", row), leader);
    }

    private string PlaceOf(string at) => DisplayText.Place(MapBoards, at);

    /// <summary>A status or note in the view's words, without the code at its head.</summary>
    private string? Said(string? text) => text is null ? null : DisplayText.Sentence(Words(DisplayText.Reason(text).Text));

    private PlayRecords? Records
    {
        get
        {
            if (history is null)
            {
                return null;
            }

            if (recordsCache is null || !ReferenceEquals(recordsCache.History, history) || recordsCache.Viewer.Name != Viewer.Name || recordsCache.Last != history.Events.Count)
            {
                recordsCache = new PlayRecords(history, Viewer, history.Events.Count, Live.NamesOf(history, Viewer));
            }

            return recordsCache;
        }
    }

    private IReadOnlyList<RollRow> RollRows => Records?.RollRows ?? [];

    private IReadOnlyList<(string EventId, string Text)> OrdnanceRecords => Records?.Ordnance ?? [];

    private IReadOnlyList<FireView> FireRecords => Records?.Fire ?? [];

    private IReadOnlyList<(string EventId, string Text)> CloseCombatRecords => Records?.CloseCombat ?? [];

    private IReadOnlyList<(string EventId, string Text)> NightRecords => Records?.Night ?? [];

    private IReadOnlyList<(string EventId, string Text)> SniperRecords => Records?.Snipers ?? [];

    private IReadOnlyList<(string EventId, string Kind, string Text)> RallyAndRepairRecords => Records?.RallyAndRepair ?? [];

    /// <summary>The turn and phase an event happened in, such as "Turn 2, Rally Phase"; null for an event the history does not hold.</summary>
    private string? WhenOf(string eventId) => Records?.WhenOf(eventId);

    /// <summary>The latest record the view may read, with its turn and phase, for the activity strip.</summary>
    private string? LatestRecord => Records?.Latest;

    // The user, 2026-10-21: whether the Latest panel shows only one line per item; kept across records for the page's life.
    private bool latestCollapsed;

    /// <summary>
    /// The Replay page's address for this game in the view shown (pass 31b): at the step that holds an event, or where the Replay page opens. In a
    /// game still played the Replay page asks for the hand-over itself.
    /// </summary>
    private string? ReplayFrom(string? eventId) => gameId.Length == 0 ? null
        : $"games/replay?game={Uri.EscapeDataString(gameId)}&view={Uri.EscapeDataString(Viewer.Name)}" + (eventId is null ? string.Empty : $"&at={Uri.EscapeDataString(eventId)}");

    /// <summary>A proposed attack's fire group in words, as the records say it.</summary>
    private string FireGroupText(FireAttack attack) => PlayRecords.FireGroupText(history?.Events ?? [], attack);

    private static string RangeText(FireAttack attack) => PlayRecords.RangeText(attack);
}
