@page "/author/{BoardName}"
@using System.Globalization
@using LimboDancer.Domains.Asl.MapStudio.Components.Layout
@inject AuthoredBoardService Authored
@inject IJSRuntime JS

<PageTitle>Edit @(session?.Name ?? BoardName) - ASL Map Studio</PageTitle>

<NavigationLock ConfirmExternalNavigation="@Unsaved" OnBeforeInternalNavigation="ConfirmLeave" />

@if (loadError is not null)
{
    <p class="fail">@loadError</p>
}
else if (session is null)
{
    <p class="muted">Opening @BoardName...</p>
}

<div class="editor" hidden="@(session is null)">
    @if (session is not null)
    {
        @if (session.IsDraft)
        {
            <SourceDraftNotice Id="author-draft-notice">
                This board derives from VASL data. It is saved as a draft under the cache and may not be committed to the
                boards folder until the source-derived content is replaced (ASL-MAP-073, ASL-MAP-074).
            </SourceDraftNotice>
        }
        <BoardEditorHeader Name="@session.Name" Board="@session.Board" Status="@session.Current.Status" Version="@session.Current.Version" IsDraft="@session.IsDraft"
                           Dirty="@Unsaved" UndoDescription="@session.UndoDescription" RedoDescription="@session.RedoDescription"
                           OnRename="@Rename" OnUndo="@Undo" OnRedo="@Redo" OnSave="@Save" Message="@status" MessageIsError="@statusIsError">
            <BoardViewPicker Views="@EditorViews" Value="@view" ValueChanged="@ChangeView" />
            <label><input id="editor-snap" type="checkbox" checked="@snap" @onchange="@(args => snap = args.Value is true)" /> snap</label>
            <a href="@($"boards/{session.Board.Value}")">Open in viewer</a>
        </BoardEditorHeader>
    }
    <div class="editor-body">
        <div class="editor-tools">
            <ToolPalette Tool="@tool" ToolChanged="ChangeTool" />
            @if (session is not null)
            {
                <EditorToolOptions Tool="@tool" Terrains="@(ToolKind is { } kind ? CodesFor(kind).ToArray() : Array.Empty<TerrainType>())" Code="@(ToolKind is { } codeKind ? ToolCode(codeKind) : (byte)0)"
                                   CodeChanged="@(code => { if (ToolKind is { } chosen) { toolCodes[chosen] = code; } })" @bind-Options="options" />
            }
        </div>
        <div class="stage">
            <BoardViewport @ref="viewport" OnReady="@(() => viewportPending = session is not null)" OnClick="@OnBoardClick" OnGesture="@OnBoardGesture"
                           OnDrag="@OnBoardDrag" OnKey="@OnBoardKey" />
            <p class="muted hint">Drag to pan, wheel or + and - to zoom, 0 to fit. Ctrl+Z undoes, Ctrl+Y redoes, Delete removes the selection, Escape cancels.</p>
        </div>
        <aside class="inspector">
            @if (session is not null)
            {
                <InspectorTabs Tabs="@InspectorTabList" @bind-Selected="panel" Label="Editor inspector" IdPrefix="editor">
                    @switch (panel)
                    {
                        case "Properties":
                            <FeatureProperties Feature="SelectedFeature" Catalog="session.Catalog" BaseCode="session.Model.BaseCode"
                                               OnChange="ReplaceSelected" OnDelete="DeleteFeature" />
                            break;
                        case "Layers":
                            <LayerList Model="session.Model" Catalog="session.Catalog" SelectedId="@selectedId" OnSelect="SelectFeature" />
                            break;
                        case "Validation":
                            <ValidationPanel Report="session.Current.Validation" OnSelect="ShowFinding" />
                            break;
                        default:
                            @if (inspected is { } hex)
                            {
                                <HexInspector Board="session.Board" Facts="session.Current.Facts[hex]" Grid="session.Current.Render.Grid" Catalog="session.Catalog"
                                              Model="session.Model" Validation="session.Current.Validation" OnCopy="CopyLocation" OnSelectFeature="SelectFeature" />
                            }
                            else
                            {
                                <p class="muted">With the Select tool, click a hex to inspect it.</p>
                            }

                            break;
                    }
                </InspectorTabs>
            }
        </aside>
    </div>
</div>

@code {
    private static readonly string[] RefreshedLayers = ["exact-terrain", "exact-elevation", "hexfacts", "styled-marks", "legend"];
    private static readonly IReadOnlyList<BoardView> EditorViews = [BoardView.Styled, BoardView.Exact, BoardView.HexFacts];
    private BoardViewport? viewport;
    private AuthoringSession? session;
    private string? loadError;
    private string? status;
    private bool statusIsError;
    private BoardView view = BoardView.Styled;
    private string tool = EditorTool.Select;
    private string panel = "Properties";
    private string? selectedId;
    private HexIndex? inspected;
    private bool snap = true;
    private string savedName = string.Empty;
    private EditorToolOptions.ToolOptions options = EditorToolOptions.ToolOptions.Default;
    private readonly Dictionary<TerrainKind, byte> toolCodes = [];
    private bool viewportPending;

    [Parameter]
    public string BoardName { get; set; } = string.Empty;

    private Feature? SelectedFeature => session?.Model.Features.FirstOrDefault(feature => feature.Id == selectedId);

    // Unsaved: an edit since the last save, or a new name (table player, pass 22d: a rename alone can now be saved).
    private bool Unsaved => session is not null && (session.Dirty || session.Name != savedName);

    private IReadOnlyList<InspectorTabs.Tab> InspectorTabList =>
    [
        new("Properties", "Properties"),
        new("Layers", "Layers"),
        new("Validation", "Validation", session?.Current.Validation is { } report ? report.Summary.Errors + report.Summary.Warnings : null),
        new("Hex", "Hex"),
    ];

    private TerrainKind? ToolKind => tool switch
    {
        EditorTool.Area => TerrainKind.Area,
        EditorTool.Linear => TerrainKind.Linear,
        EditorTool.Building => TerrainKind.Building,
        EditorTool.Hexside => TerrainKind.Hexside,
        _ => null,
    };

    protected override async Task OnParametersSetAsync()
    {
        session = null;
        loadError = null;
        (selectedId, inspected, status, statusIsError) = (null, null, null, false);
        if (!BoardRef.TryParse(BoardName, out var board) || board.Kind != BoardRefKind.Authored)
        {
            loadError = $"{BoardName} is not an authored board reference (ab-...).";
            return;
        }

        if (Authored.Catalog is not { } catalog)
        {
            loadError = "Authoring needs the terrain catalog from a configured VASL checkout. See Settings.";
            return;
        }

        var (package, draft, diagnostics) = Authored.LoadPackage(board);
        if (package is null)
        {
            loadError = $"{board} could not be opened: " + string.Join("; ", diagnostics.Select(d => d.Code + " " + d.Message));
            return;
        }

        session = await Task.Run(() => new AuthoringSession(Authored, catalog.Catalog, package, draft));
        savedName = session.Name;
        viewportPending = true;
    }

    // The board loads into the viewport once both exist.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (viewportPending && session is not null && viewport is { IsReady: true })
        {
            viewportPending = false;
            await LoadView();
            await viewport.SetTool(EditorTool.Get(tool).Gesture);
        }
    }

    // Plan section 12.3: leaving the editor with unsaved changes asks first.
    private async Task ConfirmLeave(LocationChangingContext context)
    {
        if (!Unsaved)
        {
            return;
        }

        bool leave;
        try
        {
            leave = await JS.InvokeAsync<bool>("confirm", context.CancellationToken, "This board has unsaved changes. Leave without saving them?");
        }
        catch (Exception exception) when (exception is JSException or TaskCanceledException or JSDisconnectedException)
        {
            leave = false;
        }

        if (!leave && !context.CancellationToken.IsCancellationRequested)
        {
            context.PreventNavigation();
        }
    }

    private string BaseUrl => $"render/{session!.Board.Value}/{session.Current.Version}/{BoardRenderer.ViewName(view)}";

    private async Task LoadView()
    {
        if (viewport is not { IsReady: true } || session is null)
        {
            return;
        }

        var layers = BoardRenderer.Layers(view);
        await viewport.Load(BaseUrl, "", BoardRenderer.ViewBox(session.Current.Render, view), layers, [.. layers.Where(layer => layer != "defs")]);
        await Highlight();
    }

    private async Task ChangeView(BoardView next)
    {
        view = next;
        await LoadView();
    }

    private async Task ChangeTool(string next)
    {
        tool = next;
        if (viewport is not null)
        {
            await viewport.SetTool(EditorTool.Get(tool).Gesture);
        }
    }

    private IEnumerable<TerrainType> CodesFor(TerrainKind kind) =>
        session!.Catalog.Types.Where(type => TerrainKinds.KindOf(type) == kind && type.Code != session.Model.BaseCode).OrderBy(type => type.Name, StringComparer.Ordinal);

    private byte ToolCode(TerrainKind kind)
    {
        if (!toolCodes.TryGetValue(kind, out var code))
        {
            var preferred = kind switch
            {
                TerrainKind.Area => "Woods",
                TerrainKind.Linear => "Paved Road",
                TerrainKind.Building => "Stone Building",
                TerrainKind.Hexside => "Wall",
                _ => null,
            };
            code = preferred is not null && session!.Catalog.TryGet(preferred, out var type) ? type.Code : CodesFor(kind).First().Code;
            toolCodes[kind] = code;
        }

        return code;
    }

    private void Rename(string name)
    {
        if (session is not null && name != session.Name)
        {
            session.Name = name;
            status = name == savedName ? "The saved name again." : "Renamed; save to keep it.";
            statusIsError = false;
        }
    }

    private async Task Execute(AuthoringCommand command)
    {
        if (session is null)
        {
            return;
        }

        var outcome = await Task.Run(() => session.Execute(command));
        await Applied(outcome, command.Description);
    }

    private async Task Undo()
    {
        if (session is not null && await Task.Run(session.Undo) is { } outcome)
        {
            await Applied(outcome, "undo");
        }
    }

    private async Task Redo()
    {
        if (session is not null && await Task.Run(session.Redo) is { } outcome)
        {
            await Applied(outcome, "redo");
        }
    }

    // The edit cycle (section 6.3): patch the Styled features that changed, then refresh the layers a patch does not
    // cover, by the new version's URLs.
    private async Task Applied(EditOutcome outcome, string description)
    {
        if (!outcome.Succeeded)
        {
            status = outcome.Error;
            statusIsError = true;
            StateHasChanged();
            return;
        }

        status = string.Create(CultureInfo.InvariantCulture, $"{description}: rebuilt in {outcome.Milliseconds:F0} ms");
        statusIsError = false;
        if (selectedId is not null && session!.Model.Features.All(feature => feature.Id != selectedId))
        {
            selectedId = null;
        }

        if (viewport is not null && session is not null)
        {
            if (view == BoardView.Styled)
            {
                var upserts = outcome.Upserted.Select(feature => BoardRenderer.RenderFeature(session.Current.Render, feature.Id)).OfType<FeatureFragment>()
                    .Select(fragment => new { layer = fragment.Layer, id = fragment.Id, svg = fragment.Svg, before = fragment.BeforeId }).ToArray();
                var removals = outcome.Removed.Select(removed => new { layer = removed.Layer, id = removed.Id }).ToArray();
                await viewport.ApplyPatch(new { upserts, removals });
            }

            var layers = BoardRenderer.Layers(view).Where(layer => view != BoardView.Styled || RefreshedLayers.Contains(layer)).Where(layer => layer != "defs").ToArray();
            await viewport.ReloadLayers(BaseUrl, "", layers);
            await Highlight();
        }

        StateHasChanged();
    }

    private async Task Save()
    {
        if (session is null)
        {
            return;
        }

        await Task.Run(session.Save);
        savedName = session.Name;
        status = session.IsDraft ? "Draft saved under the cache." : "Saved to the boards folder.";
        statusIsError = false;
    }

    private async Task OnBoardClick(double x, double y)
    {
        if (session is null)
        {
            return;
        }

        var model = session.Model;
        var geometry = model.Geometry;
        var point = EditorGestures.ToFixed(x, y);
        switch (tool)
        {
            case EditorTool.Select:
                selectedId = AuthoringGeometry.FeatureAt(model, point)?.Id;
                inspected = geometry.HexAt(x, y);
                // Working down the Validation list keeps it open (table player, pass 22d).
                if (panel != "Validation")
                {
                    panel = selectedId is not null ? "Properties" : "Hex";
                }

                await Highlight();
                break;
            case EditorTool.Building when geometry.HexAt(x, y) is { } hex:
                await Execute(new AddFeature(new BuildingFeature(FeatureIds.NewUlid(), 0, [Footprint(geometry, hex)], ToolCode(TerrainKind.Building),
                    options.JoinBuilding && SelectedFeature is BuildingFeature selectedBuilding ? selectedBuilding.BuildingId : "B" + FeatureIds.NewUlid()[^6..])));
                break;
            case EditorTool.Hexside when AuthoringGeometry.NearestHexside(geometry, point) is { } side:
                await Execute(EditorGestures.AddHexside(model, ToolCode(TerrainKind.Hexside), side));
                break;
            case EditorTool.Stairway when geometry.HexAt(x, y) is { } stairHex:
                await Execute(new SetStairway(stairHex, !model.Annotations.Stairways.Contains(stairHex)));
                break;
            case EditorTool.Annotation when AuthoringGeometry.NearestHexside(geometry, point) is { } markSide:
                var marks = options.Mark switch
                {
                    HexsideMark.Slope => model.Annotations.Hexsides.Slopes,
                    HexsideMark.RailroadEmbankment => model.Annotations.Hexsides.RailroadEmbankments,
                    _ => model.Annotations.Hexsides.PartialOrchards,
                };
                var on = !(marks.TryGetValue(geometry.NameOf(markSide.Hex), out var sides) && sides.Contains(markSide.Side));
                await Execute(new SetHexsideMark(options.Mark, markSide, on));
                break;
        }

        StateHasChanged();
    }

    private FeatureShape Footprint(BoardGeometry geometry, HexIndex hex) => options.BuildingMode switch
    {
        ['s', 'p', 'a', 'n', '-', var axis] => BuildingKit.Span(geometry, hex, axis - '0'),
        ['f', 'l', 'u', 's', 'h', '-', var side] => BuildingKit.Flush(geometry, hex, (HexsideDirection)(side - '0')),
        _ => BuildingKit.Centered(geometry, hex),
    };

    private async Task OnBoardGesture(double[][] points)
    {
        if (session is null)
        {
            return;
        }

        var model = session.Model;
        var snapped = EditorGestures.Snap(model, points.Select(point => (point[0], point[1])), snap);
        switch (tool)
        {
            case EditorTool.Area when snapped.Count >= 3:
                await Execute(new AddFeature(new AreaTerrainFeature(FeatureIds.NewUlid(), 0, new FeatureShape([snapped]), ToolCode(TerrainKind.Area))));
                break;
            case EditorTool.Elevation when snapped.Count >= 3:
                await Execute(new AddFeature(new ElevationRegion(FeatureIds.NewUlid(), 0, new FeatureShape([snapped]), options.Level)));
                break;
            case EditorTool.Linear when snapped.Count >= 2:
                await Execute(new AddFeature(new LinearTerrainFeature(FeatureIds.NewUlid(), 0, ToolCode(TerrainKind.Linear),
                    EditorGestures.Centerline(snapped, options.Curved), FixedPoint.FromPixels(options.LinearWidth), null)));
                break;
            default:
                status = "Not enough points for that tool.";
                statusIsError = true;
                break;
        }

        StateHasChanged();
    }

    private async Task OnBoardDrag(double x0, double y0, double x1, double y1)
    {
        if (session is not null && tool == EditorTool.Move && SelectedFeature is { } feature and not HexsideTerrainFeature)
        {
            var dx = (int)Math.Round(x1 - x0);
            var dy = (int)Math.Round(y1 - y0);
            if (dx != 0 || dy != 0)
            {
                await Execute(new ReplaceFeature(EditorGestures.Translate(feature, dx, dy, session.Model.Geometry)));
                StateHasChanged();
            }
        }
    }

    private async Task OnBoardKey(string key)
    {
        switch (key)
        {
            case "Undo":
                await Undo();
                break;
            case "Redo":
                await Redo();
                break;
            case "Delete" when selectedId is not null:
                await DeleteFeature(selectedId);
                break;
            case "Escape":
                selectedId = null;
                await Highlight();
                break;
        }

        StateHasChanged();
    }

    private Task ReplaceSelected(Feature feature) => Execute(new ReplaceFeature(feature));

    private Task DeleteFeature(string id) => Execute(new RemoveFeature(id));

    private async Task SelectFeature(string id)
    {
        selectedId = id;
        panel = "Properties";
        await Highlight();
    }

    private async Task ShowFinding(ValidationFinding finding)
    {
        if (finding.FeatureId is not null)
        {
            selectedId = finding.FeatureId;
        }

        if (finding.Hex is { } hex && session is not null && viewport is not null)
        {
            inspected = hex;
            var center = session.Model.Geometry.CenterDot(hex);
            await viewport.FocusPoint(center.X, center.Y);
        }

        await Highlight();
    }

    private async Task CopyLocation(string location)
    {
        if (viewport is not null)
        {
            await viewport.CopyText(location);
        }
    }

    // Outlines the selected feature's painted area, or the inspected hex.
    private async Task Highlight()
    {
        if (viewport is null || session is null)
        {
            return;
        }

        string? points = null;
        if (SelectedFeature is { } feature && AuthoringGeometry.Bounds(session.Model.Geometry, feature) is { } box)
        {
            points = string.Create(CultureInfo.InvariantCulture, $"{box.MinX},{box.MinY} {box.MaxX},{box.MinY} {box.MaxX},{box.MaxY} {box.MinX},{box.MaxY}");
        }
        else if (inspected is { } hex)
        {
            points = string.Join(" ", session.Model.Geometry.Vertices(hex).Select(vertex => string.Create(CultureInfo.InvariantCulture, $"{vertex.X},{vertex.Y}")));
        }

        await viewport.Highlight(points);
    }
}
