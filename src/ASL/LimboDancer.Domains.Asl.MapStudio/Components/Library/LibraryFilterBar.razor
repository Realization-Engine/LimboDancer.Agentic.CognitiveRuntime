@* Plan section 12.1: search and filters above the results, with the result count and Clear; the page keeps the filter for the session. *@
<div class="library-filters" role="search" aria-label="Board library">
    <label>
        Search
        <input id="library-search" type="search" value="@Value.Search" placeholder="name or reference" @oninput="@(args => Change(Value with { Search = args.Value as string ?? string.Empty }))" />
    </label>
    <label>
        Show
        <select id="library-type" value="@Value.Type" @onchange="@(args => Change(Value with { Type = args.Value as string ?? Filter.AllTypes }))">
            <option value="@Filter.AllTypes">everything</option>
            <option value="authored">authored boards</option>
            <option value="maps">maps</option>
            <option value="vasl">VASL boards</option>
        </select>
    </label>
    <label>
        VASL status
        <select id="library-status" value="@Value.Status" disabled="@(!Value.Shows("vasl"))" @onchange="@(args => Change(Value with { Status = args.Value as string ?? Filter.AnyStatus }))">
            <option value="@Filter.AnyStatus">any</option>
            <option value="verified">verified</option>
            <option value="ingested">not verified</option>
            <option value="failed">failed</option>
            <option value="notchecked">not checked</option>
        </select>
    </label>
    <label class="toggle">
        <input id="library-out-of-scope" type="checkbox" checked="@Value.OutOfScope" disabled="@(!Value.Shows("vasl"))" @onchange="@(args => Change(Value with { OutOfScope = args.Value is true }))" />
        Out-of-scope boards (@OutOfScopeCount)
    </label>
    @if (TerrainIds is null)
    {
        <span id="library-terrain-none" class="muted">Has terrain: no MapHexIndex yet. <a href="fidelity">Run the fidelity batch</a> to write one.</span>
    }
    else
    {
        @* The Studio's dropdown of checkboxes (pass 31c), as Play's unit lists use it: its closed line names what is chosen, its list opens below it. *@
        <UnitSelectionList Rows="@TerrainRows" Selected="@ChosenTerrain" CssClass="library-terrain" Legend="Has terrain"
                           OnToggle="@(toggle => Change(toggle.On ? Value.WithTerrain(toggle.Id) : Value.WithoutTerrain(toggle.Id)))" />
        @* The chosen terrain, each a chip that removes itself on a click (the user, 2026-10-28). *@
        @foreach (var id in Value.TerrainIds)
        {
            <button class="terrain-chip" data-terrain="@id" title="Stop asking for @id" @onclick="@(() => Change(Value.WithoutTerrain(id)))">@id ×</button>
        }
    }
    <span id="library-count" role="status">@Shown of @Total shown</span>
    @if (!Value.IsDefault)
    {
        <button id="library-clear" class="link" @onclick="@(() => Change(Filter.Default))">Clear filters</button>
    }
</div>

@code {
    /// <summary>
    /// The library's search and filters: text, the kind of entry, the VASL status, whether out-of-scope boards show, and the MapHexIndex features a board
    /// must hold (the MapHexIndex Design, ruling RMH.5), kept as one string of ids joined by "|" so the record compares by value.
    /// </summary>
    public sealed record Filter(string Search, string Type, string Status, bool OutOfScope, string Terrain = "")
    {
        private const char Separator = '|';

        /// <summary>The features asked for, in the order chosen.</summary>
        public IReadOnlyList<string> TerrainIds => Terrain.Length == 0 ? [] : Terrain.Split(Separator);

        public Filter WithTerrain(string id) => TerrainIds.Contains(id, StringComparer.Ordinal) ? this
            : this with { Terrain = string.Join(Separator, TerrainIds.Append(id)) };

        public Filter WithoutTerrain(string id) => this with { Terrain = string.Join(Separator, TerrainIds.Where(asked => asked != id)) };

        public const string AllTypes = "all";

        public const string AnyStatus = "any";

        public static Filter Default { get; } = new(string.Empty, AllTypes, AnyStatus, false);

        public bool IsDefault => this == Default;

        /// <summary>Whether a name or reference matches the search, ignoring case.</summary>
        public bool Matches(params string[] texts) =>
            Search.Trim().Length == 0 || texts.Any(text => text.Contains(Search.Trim(), StringComparison.OrdinalIgnoreCase));

        // A VASL status or a terrain narrows the list to VASL boards, since only they have one (table player, pass 22c; ruling RMH.5).
        public bool Shows(string type) => (Type == AllTypes || Type == type) && ((Status == AnyStatus && Terrain.Length == 0) || type == "vasl");
    }

    /// <summary>The newest MapHexIndex's feature ids, or null when no index has been saved.</summary>
    [Parameter]
    public IReadOnlyList<string>? TerrainIds { get; set; }

    // The dropdown's rows, built once per index rather than on each render.
    private (IReadOnlyList<string>? Ids, IReadOnlyList<UnitSelectionList.Row> Rows) terrainRows = (null, []);

    private IReadOnlyList<UnitSelectionList.Row> TerrainRows
    {
        get
        {
            if (!ReferenceEquals(terrainRows.Ids, TerrainIds))
            {
                terrainRows = (TerrainIds, TerrainIds is null ? [] : [.. TerrainIds.Select(id => new UnitSelectionList.Row(id, id))]);
            }

            return terrainRows.Rows;
        }
    }

    // The ticked terrain, rebuilt only when the filter's terrain changes.
    private (string Key, HashSet<string> Set) chosenTerrain = (string.Empty, []);

    private HashSet<string> ChosenTerrain
    {
        get
        {
            if (chosenTerrain.Key != Value.Terrain)
            {
                chosenTerrain = (Value.Terrain, [.. Value.TerrainIds]);
            }

            return chosenTerrain.Set;
        }
    }

    [Parameter, EditorRequired]
    public Filter Value { get; set; } = Filter.Default;

    [Parameter]
    public EventCallback<Filter> ValueChanged { get; set; }

    [Parameter]
    public int Shown { get; set; }

    [Parameter]
    public int Total { get; set; }

    [Parameter]
    public int OutOfScopeCount { get; set; }

    private Task Change(Filter filter) => ValueChanged.InvokeAsync(filter);
}
