<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <ProjectReference Include="..\LimboDancer.Domains.Asl.Maps\LimboDancer.Domains.Asl.Maps.csproj" />
    <!-- Pass 32 (the plan's section 19, decision 7): the projector calls the Rules calculators the planner calls. Rules references Abstractions only. -->
    <ProjectReference Include="..\LimboDancer.Domains.Asl.Rules\LimboDancer.Domains.Asl.Rules.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- WithCulture="false": names such as catalog.units.json would otherwise be read as resources for a culture "units" on Linux. -->
    <EmbeddedResource Include="..\units\vocabulary\*.vocab.json" LogicalName="Vocabulary.%(Filename)%(Extension)" Link="Vocabulary\%(Filename)%(Extension)" WithCulture="false" />
    <EmbeddedResource Include="..\units\examples\*.units.json" LogicalName="Examples.%(Filename)%(Extension)" Link="Examples\%(Filename)%(Extension)" WithCulture="false" />
    <EmbeddedResource Include="..\units\catalog\*.catalog.json" LogicalName="Catalogs.%(Filename)%(Extension)" Link="Catalogs\%(Filename)%(Extension)" WithCulture="false" />
    <EmbeddedResource Include="..\units\games\*.game.json" LogicalName="Games.%(Filename)%(Extension)" Link="Games\%(Filename)%(Extension)" WithCulture="false" />
  </ItemGroup>
</Project>
