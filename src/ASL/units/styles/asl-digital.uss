/* asl-digital: ASL Personnel and support weapons in a digital form (Unit Display Design, section 4).
   Original LimboDancer style sheet. Every fact a printed counter conveys stays readable; the look is our own.
   Lengths: face-size is a fraction of the hex height; every other length is a fraction of the face size. */

@palette limbodancer;

@tokens {
  paper: #ffffff;
  alert: #c0392b;
  warning: #e0a800;
  conceal: #2c3e50;
  smoke: #6b7785;
}

/* Base style for every unit, including kinds that extend no ASL kind. */
unit {
  face-size: 0.55;
  shape: square;
  corner-radius: 0.1;
  fill: side(fill);
  stroke: side(ink);
  stroke-width: 0.035;
  color: side(ink);
  badge-fill: side(ink);
  badge-color: token(paper);
  face-template: "glyph";
}
unit::slot(glyph) { content: glyph(size-figures); }

/* A concealed placeholder (section 7.3): the viewer knows only side and location. */
unit:concealed { face-template: "q"; stroke-style: dashed; stroke-width: 0.06; }
unit:concealed::slot(q) { content: "?"; font-weight: bold; font-size: 0.62; }

/* Personnel, front face. */
asl|personnel {
  face-template: "glyph ident class"
                 "fp    range morale";
}
asl|personnel::slot(glyph)  { content: glyph(size-figures); }
asl|personnel::slot(ident)  { content: attr(identity); font-size: 0.2; }
asl|personnel::slot(class)  { content: attr(class); font-size: 0.22; font-weight: bold; }
asl|personnel::slot(fp)     { content: attr(firepower); font-size: 0.34; font-weight: bold; }
asl|personnel::slot(range)  { content: attr(range); font-size: 0.34; }
asl|personnel::slot(morale) { content: attr(morale); font-size: 0.34; }
asl|personnel[class-variant=circle]::slot(class) { mark: circle; }
asl|personnel[class-variant=square]::slot(class) { mark: box; }
asl|personnel.asl\:assault-fire::slot(fp)      { mark: underline; }
asl|personnel.asl\:spraying-fire::slot(range)  { mark: underline; }
asl|personnel.asl\:elr-5::slot(morale)         { mark: underline; }
asl|personnel[smoke-exponent] { badge: "S" attr(smoke-exponent) bottom-left; }
asl|personnel.asl\:sapper { badge: "SAP" bottom-right; }
asl|personnel.asl\:assault-engineer { badge: "AE" bottom-right; }

/* Personnel, broken face: prone figures, muted fill, the Broken Morale Level large, boxed when it can self-rally. */
asl|personnel:face(broken) {
  fill: side(fill-muted);
  face-template: "glyph   glyph   ident"
                 "bmorale bmorale bmorale";
}
asl|personnel:face(broken)::slot(glyph)   { content: glyph(size-figures, prone); }
asl|personnel:face(broken)::slot(bmorale) { content: attr(broken-morale); font-size: 0.34; font-weight: bold; }
asl|personnel:face(broken)::slot(ident)   { content: attr(identity, front); }
asl|personnel:face(broken).asl\:self-rally::slot(bmorale) { mark: box; }

/* Leaders: the leadership DRM as a circled value, morale below. */
asl|leader {
  face-template: "glyph drm"
                 "ident morale";
}
asl|leader::slot(drm)    { content: attr(leadership); font-size: 0.3; font-weight: bold; mark: circle; }
asl|leader::slot(morale) { content: attr(morale); font-size: 0.34; font-weight: bold; }

/* Heroes: the wounded face. */
asl|hero:face(wounded) { stroke: token(alert); }

/* Support weapons. */
asl|sw {
  face-template: "glyph label label"
                 "fp    dash  range"
                 "bd    .     pp";
}
asl|sw::slot(glyph) { content: glyph(mg); }
asl|sw::slot(fp)    { content: attr(firepower); font-size: 0.3; font-weight: bold; }
asl|sw::slot(dash)  { content: "-"; font-size: 0.3; }
asl|sw::slot(range) { content: attr(range); font-size: 0.3; }
asl|sw::slot(bd)    { content: "B" attr(breakdown); font-size: 0.18; }
asl|sw.asl\:breakdown-removes::slot(bd) { content: "X" attr(breakdown); }
asl|sw::slot(pp)    { content: attr(portage) "PP"; font-size: 0.18; }
asl|sw::slot(label) { font-size: 0.2; font-weight: bold; }
asl|sw[rate-of-fire] { badge: "ROF" attr(rate-of-fire) top-right; }

asl|mg::slot(label) { content: attr(size, front); }
asl|ft::slot(glyph) { content: glyph(ft); }
asl|ft::slot(label) { content: "FT"; }
asl|dc {
  face-template: "glyph label"
                 "fp    fp"
                 "bd    pp";
}
asl|dc::slot(glyph) { content: glyph(dc); }
asl|dc::slot(label) { content: "DC"; }
asl|latw::slot(glyph) { content: glyph(latw); }
asl|latw::slot(label) { content: attr(latw-type, front); }
asl|light-mortar::slot(glyph) { content: glyph(mortar); }
asl|light-mortar::slot(label) { content: "MTR"; }

/* Radios: the value in force. With no scenario date yet, the first value of a series; the series is in the detail panel. */
asl|radio {
  face-template: "glyph   label"
                 "contact contact"
                 "bd      pp";
}
asl|radio::slot(glyph)   { content: glyph(radio); }
asl|radio::slot(label)   { content: "RADIO"; font-size: 0.18; }
asl|radio.asl\:field-phone::slot(label) { content: "PHONE"; }
asl|radio::slot(contact) { content: attr(contact, first); font-size: 0.34; font-weight: bold; }
asl|radio:face(reverse) {
  face-template: "label"
                 "dates";
}
asl|radio:face(reverse)::slot(dates) { content: attr(contact-dates); font-size: 0.16; }

/* The malfunctioned face: a warning stripe and the Repair Number. */
asl|sw:face(malfunctioned) {
  fill: side(fill-muted);
  pattern: stripes token(warning);
  face-template: "glyph  label"
                 "repair repair";
}
asl|sw:face(malfunctioned)::slot(repair) { content: "R" attr(repair); font-size: 0.3; font-weight: bold; }

/* Ordnance values of Guns, light mortars, and LATW (C2.21 to C2.26). */
asl|gun::slot(cal), asl|sw[caliber]::slot(cal) { content: attr(caliber) attr(caliber-suffix, optional); font-weight: bold; }
asl|gun.asl\:no-ap::slot(cal), asl|sw.asl\:no-ap::slot(cal) { mark: overline; }
asl|gun.asl\:no-he::slot(cal), asl|sw.asl\:no-he::slot(cal) { mark: underline; }
asl|gun[range-maximum]::slot(range), asl|sw[range-maximum]::slot(range) { content: "[" attr(range-maximum) "]"; }
asl|gun[range-minimum][range-maximum]::slot(range), asl|sw[range-minimum][range-maximum]::slot(range) { content: "[" attr(range-minimum) "-" attr(range-maximum) "]"; }
asl|gun::slot(ammo), asl|sw::slot(ammo) { content: attr(special-ammo); }
asl|gun::slot(type) { content: attr(gun-type, front); font-weight: bold; }
asl|gun::slot(mnum) { content: "M" attr(manhandling); }
asl|gun[target-size=small]::slot(mnum) { fill: #ffffff; badge-shape: circle; color: #111111; }
asl|gun[target-size=large]::slot(mnum) { color: token(alert); font-weight: bold; }
asl|gun::slot(bd) { content: "B" attr(breakdown); }
asl|gun::slot(glyph) { content: glyph(gun); }
asl|gun[gun-type=mtr]::slot(glyph) { content: glyph(mortar); }
asl|gun[gun-type=aa]::slot(glyph) { content: glyph(aa-gun); }
asl|gun[gun-type=rcl]::slot(glyph) { content: glyph(rcl); }
asl|gun:face(limbered)::slot(glyph) { content: glyph(limbered-gun); }
asl|gun:face(malfunctioned)::slot(repair) { content: "R" attr(repair); font-weight: bold; }
asl|gun:face(malfunctioned)::slot(removal) { content: "X" attr(removal); font-weight: bold; }

/* Guns (C2.2 to C2.3): upright faces, a direction arrow at the faced hexspine, and the Covered Arc at the near tier (C3.2). */
asl|gun {
  face-template: "glyph glyph type"
                 "cal   cal   mnum"
                 "ammo  range bd";
  direction-mark: arrow;
  covered-arc: wedge;
}
asl|gun::slot(type)  { font-size: 0.2; }
asl|gun::slot(cal)   { font-size: 0.3; }
asl|gun::slot(mnum)  { font-size: 0.17; }
asl|gun::slot(ammo)  { font-size: 0.13; }
asl|gun::slot(range) { font-size: 0.14; }
asl|gun::slot(bd)    { font-size: 0.14; }
asl|gun[rate-of-fire] { badge: "ROF" attr(rate-of-fire) top-right; }
asl|gun[ife] { badge: "IFE" attr(ife) bottom-left; }
asl|gun.asl\:mount-360 { badge: "360" top-left; }
asl|gun.asl\:qsu  { badge: "QSU" bottom-right; }
asl|gun.asl\:nm   { badge: "NM" bottom-right; }
asl|gun.asl\:rfnm { badge: "RFNM" bottom-right; }
asl|gun:face(limbered) {
  fill: side(fill-muted);
  face-template: "glyph glyph type"
                 "cal   cal   mnum";
  covered-arc: none;
}
asl|gun:face(malfunctioned) {
  fill: side(fill-muted);
  pattern: stripes token(warning);
  face-template: "repair glyph   type"
                 "repair removal removal";
  covered-arc: none;
}
asl|gun:face(malfunctioned)::slot(repair), asl|gun:face(malfunctioned)::slot(removal) { font-size: 0.24; }

/* Light mortars and LATW with their ordnance values. */
asl|light-mortar, asl|latw {
  face-template: "glyph label"
                 "cal   range"
                 "bd    pp";
}
asl|light-mortar::slot(cal), asl|latw::slot(cal) { font-size: 0.22; }
asl|light-mortar::slot(range), asl|latw::slot(range) { font-size: 0.14; }

/* Vehicles (D1.1 to D1.9, pp. 193 to 195): the ID letter upper left, the MP over its movement type symbol upper right,
   front and side/rear AF beneath it, and the armament along the bottom. */
asl|vehicle::slot(glyph) { content: glyph(tank); }
asl|vehicle[movement-type=half-tracked]::slot(glyph) { content: glyph(halftrack); }
asl|vehicle[movement-type=armored-car]::slot(glyph) { content: glyph(armored-car); }
asl|vehicle[movement-type=truck]::slot(glyph) { content: glyph(truck); }
asl|vehicle[movement-type=motorcycle]::slot(glyph) { content: glyph(motorcycle); }
asl|vehicle:face(wreck)::slot(glyph) { content: glyph(wreck); }
asl|vehicle.asl\:open-topped::slot(glyph) { fill: #ffffff; badge-shape: circle; }
asl|vehicle[ma-type=t]::slot(glyph)   { outline: circle; }
asl|vehicle[ma-type=st]::slot(glyph)  { outline: square; }
asl|vehicle[ma-type=rst]::slot(glyph) { outline: thick-square; }
asl|vehicle[ma-type="1mt"]::slot(glyph) { outline: cornerless-square; }
asl|vehicle::slot(id) { content: attr(identity); font-weight: bold; }
asl|vehicle[ground-pressure=low]::slot(id)  { mark: box; }
asl|vehicle[ground-pressure=high]::slot(id) { mark: circle; }
asl|vehicle::slot(mp) { content: attr(movement-points); font-weight: bold; color: #111111; fill: #ffffff; badge-shape: oval; }
asl|vehicle[movement-type=armored-car]::slot(mp) { badge-shape: circle; }
asl|vehicle[movement-type=half-tracked]::slot(mp) { badge-shape: circle-oval; }
asl|vehicle[movement-type=truck]::slot(mp)       { badge-shape: figure-eight; }
asl|vehicle[movement-type=motorcycle]::slot(mp)  { fill: none; }
asl|vehicle[movement-type=motorcycle] { fill: #ffffff; }
asl|vehicle[amphibious-mp]::slot(mp) { superscript: attr(amphibious-mp); }
asl|vehicle.asl\:mechanically-unreliable::slot(mp) { color: token(alert); }
asl|vehicle::slot(afront) { content: attr(af-front); font-weight: bold; }
asl|vehicle::slot(aside)  { content: attr(af-side); font-weight: bold; }
asl|vehicle.asl\:unarmored::slot(afront), asl|vehicle.asl\:unarmored::slot(aside) { content: "H"; }
asl|vehicle.asl\:partially-armored::slot(aside) { content: attr(af-side) "H"; }
asl|vehicle.asl\:partially-armored.asl\:rear-turret-unarmored::slot(aside) { content: attr(af-side) "TH"; }
asl|vehicle[turret-af-front=superior]::slot(afront) { mark: box; }
asl|vehicle[turret-af-front=inferior]::slot(afront) { mark: circle; }
asl|vehicle[turret-af-side=superior]::slot(aside)   { mark: box; }
asl|vehicle[turret-af-side=inferior]::slot(aside)   { mark: circle; }
asl|vehicle[target-size=large]::slot(afront), asl|vehicle[target-size=very-large]::slot(afront), asl|vehicle[target-size=very-large]::slot(aside) { color: token(alert); }
asl|vehicle[target-size=small]::slot(afront), asl|vehicle[target-size=very-small]::slot(afront), asl|vehicle[target-size=very-small]::slot(aside) {
  fill: #ffffff; badge-shape: circle; color: #111111;
}
asl|vehicle::slot(ma) { content: attr(caliber) attr(caliber-suffix, optional); font-weight: bold; }
asl|vehicle[ma-weapon]::slot(ma) { content: attr(ma-weapon); font-size: 0.14; }
asl|vehicle.asl\:no-ap::slot(ma) { mark: overline; }
asl|vehicle.asl\:no-he::slot(ma) { mark: underline; }
asl|vehicle::slot(sa)   { content: attr(sa-mount) attr(sa-caliber); }
asl|vehicle::slot(rof)  { content: attr(rate-of-fire); mark: box; }
asl|vehicle::slot(bd)   { content: "B" attr(breakdown); }
asl|vehicle::slot(ammo) { content: attr(special-ammo); }
asl|vehicle::slot(tow)  { content: "T" attr(towing); }
asl|vehicle::slot(pp)   { content: attr(passenger-capacity) "PP"; }
asl|vehicle[bmg]::slot(mg), asl|vehicle[cmg]::slot(mg) { content: attr(bmg, dash) "/" attr(cmg, dash); }
asl|vehicle[aamg]::slot(mg) { content: attr(bmg, dash) "/" attr(cmg, dash) "/" attr(aamg); }
asl|vehicle[hull-rear-mg]::slot(mg) { superscript: "R" attr(hull-rear-mg); }
asl|vehicle[turret-rear-mg]::slot(mg) { superscript: "R" attr(turret-rear-mg); }
asl|vehicle.asl\:fixed-bmg::slot(mg) { mark: circle; }
asl|vehicle::slot(ft) { content: attr(vehicle-ft-mount) attr(vehicle-ft-firepower) " X" attr(vehicle-ft-removal); color: token(alert); font-weight: bold; }
asl|vehicle.asl\:vehicle-ft-range-2::slot(ft) { mark: underline; }
asl|vehicle:face(wreck) { fill: #eeeeee; direction-mark: none; turret-mark: none; covered-arc: none; turret-arc: none; }
asl|vehicle:face(wreck)::slot(cs) { content: "CS" attr(crew-survival); font-weight: bold; }

asl|vehicle {
  face-template: "id    glyph glyph  mp"
                 "ma    ma    afront aside"
                 "sa    rof   bd     ammo"
                 "mg    mg    pp     tow";
  direction-mark: arrow;
  covered-arc: wedge;
  turret-mark: arrow;
  turret-arc: wedge;
}
asl|vehicle::slot(mp) { font-size: 0.2; }
asl|vehicle::slot(afront), asl|vehicle::slot(aside) { font-size: 0.17; }
asl|vehicle::slot(id) { font-size: 0.15; }
asl|vehicle::slot(ma) { font-size: 0.2; }
asl|vehicle::slot(sa), asl|vehicle::slot(rof), asl|vehicle::slot(bd), asl|vehicle::slot(ammo), asl|vehicle::slot(mg), asl|vehicle::slot(pp),
asl|vehicle::slot(tow) { font-size: 0.11; }
asl|vehicle[vehicle-ft-firepower] { badge: attr(vehicle-ft-mount) "FT" attr(vehicle-ft-firepower) " X" attr(vehicle-ft-removal) bottom-left; }
asl|vehicle.asl\:vehicle-ft-range-2 { badge: "FT R2" bottom-right; }
asl|vehicle:face(wreck) {
  face-template: "id    glyph glyph cs"
                 "glyph glyph glyph glyph"
                 "ammo  ammo  ammo  ammo";
  covered-arc: none;
  turret-arc: none;
}
asl|vehicle:face(wreck)::slot(cs) { font-size: 0.16; }
asl|unit:asl\:bu     { badge: "BU" top-left; }
asl|unit:asl\:ce     { badge: "CE" top-left; }
asl|unit:asl\:motion { badge: "MOT" top-right; }

/* Entities that are not units (ASL-UNIT-026): a Sniper, Fortifications, and informational markers. No asl|unit rule
   applies to them. Snipers and Fortifications take their side's colors; markers are neutral. */
asl|entity::slot(glyph) { content: glyph(crosshair); }
asl|foxhole::slot(glyph) { content: glyph(foxhole); }
asl|trench::slot(glyph) { content: glyph(trench); }
asl|wire::slot(glyph) { content: glyph(wire); }
asl|minefield::slot(glyph) { content: glyph(mines); }
asl|roadblock::slot(glyph) { content: glyph(roadblock); rotate: hexside; }
asl|pillbox::slot(glyph) { content: glyph(pillbox); }
asl|fortified-location::slot(glyph) { content: glyph(fortified); }
asl|smoke::slot(glyph) { content: glyph(smoke); }
asl|residual::slot(glyph) { content: glyph(residual); }
asl|fire::slot(glyph) { content: glyph(fire); }
asl|rubble::slot(glyph) { content: glyph(rubble); }
asl|entity { face-template: "glyph" "label"; }
asl|entity::slot(label) { font-weight: bold; }
asl|sniper::slot(label) { content: "SNIPER"; }
asl|sniper:face(pinned) { fill: #ffffff; stroke: token(alert); color: token(alert); }
asl|foxhole::slot(label) { content: attr(capacity) "S"; }
asl|trench::slot(label) { content: "TRENCH"; }
asl|trench.asl\:anti-tank-ditch::slot(label) { content: "A-T DITCH"; }
asl|wire::slot(label) { content: "WIRE"; }
asl|minefield { face-template: "glyph glyph" "ap at" "label label"; }
asl|minefield::slot(ap) { content: attr(ap-strength); font-weight: bold; }
asl|minefield::slot(at) { content: attr(at-strength) "AT"; font-weight: bold; }
asl|minefield::slot(label) { content: "MINES"; }
asl|minefield.asl\:known-minefield::slot(label) { content: "KNOWN"; }
asl|minefield.asl\:dummy-minefield::slot(label) { content: "DUMMY"; }
asl|roadblock::slot(label) { content: "ROADBLOCK"; }
asl|pillbox { face-template: "glyph glyph glyph" "cap ca nca"; }
asl|pillbox::slot(cap) { content: attr(capacity); font-weight: bold; }
asl|pillbox::slot(ca)  { content: attr(ca-defense); font-weight: bold; }
asl|pillbox::slot(nca) { content: attr(nca-defense); font-weight: bold; }
asl|fortified-location::slot(label) { content: "FORTIFIED"; }
asl|marker { stroke: #333333; color: #111111; }
asl|smoke { fill: #cfd4d8; face-template: "glyph hind" "label label"; }
asl|smoke::slot(hind) { content: attr(hindrance); font-weight: bold; }
asl|smoke::slot(label) { content: "SMOKE"; }
asl|smoke.asl\:white-phosphorus { fill: #f7f7f2; }
asl|smoke.asl\:white-phosphorus::slot(label) { content: "WP"; }
asl|smoke:face(dispersed)::slot(label) { content: "DISPERSED"; }
asl|residual { fill: #fff1a8; face-template: "value"; }
asl|residual::slot(value) { content: attr(residual-fp); font-weight: bold; }
asl|fire { fill: #f28c28; }
asl|fire::slot(label) { content: "BLAZE"; }
asl|fire.asl\:wreck-blaze::slot(label) { content: "WRECK BLAZE"; }
asl|fire:face(flame) { fill: #ffd47a; face-template: "glyph glyph" "clear hamper" "label label"; }
asl|fire:face(flame)::slot(label)  { content: "FLAME"; }
asl|fire:face(flame)::slot(clear)  { content: "C" attr(clearance-number); font-weight: bold; }
asl|fire:face(flame)::slot(hamper) { content: "H" attr(hamper-number); font-weight: bold; }
asl|rubble { fill: #9a9a96; }
asl|rubble[construction=wooden] { fill: #9b6b3f; }
asl|rubble::slot(label) { content: "RUBBLE"; }

asl|entity::slot(label) { font-size: 0.16; }
asl|minefield::slot(ap), asl|minefield::slot(at) { font-size: 0.24; }
asl|minefield::slot(label), asl|trench::slot(label), asl|fortified-location::slot(label), asl|roadblock::slot(label) { font-size: 0.13; }
asl|sniper[san] { badge: "SAN" attr(san) top-right; }
asl|roadblock { direction-mark: arrow; }
asl|pillbox { direction-mark: arrow; covered-arc: wedge; }
asl|pillbox::slot(cap), asl|pillbox::slot(ca), asl|pillbox::slot(nca) { font-size: 0.24; }
asl|smoke::slot(hind) { font-size: 0.28; }
asl|smoke:face(dispersed) { stroke-style: dashed; }
asl|residual::slot(value) { font-size: 0.5; }
asl|fire:face(flame)::slot(clear), asl|fire:face(flame)::slot(hamper) { font-size: 0.2; }

/* States drawn on the unit (ASL-UNIT-077). */
asl|unit:asl\:pinned    { badge: "PIN" top-right; }
asl|unit:asl\:cx        { badge: "CX" top-right; }
asl|unit:asl\:dm        { badge: "DM" top-right; }
asl|unit:asl\:ti        { badge: "TI" top-right; }
asl|unit:asl\:disrupted { badge: "DIS" top-left; }
asl|unit:asl\:wounded   { badge: "WND" top-left; }
asl|unit:asl\:berserk   { stroke: token(alert); stroke-width: 0.09; badge: "BSK" top-left; }
asl|unit:asl\:fanatic   { stroke: token(warning); stroke-width: 0.09; badge: "FAN" top-left; }
asl|unit:asl\:concealed { stroke: token(conceal); stroke-style: dashed; stroke-width: 0.07; badge: "?" top-left; }
/* Hidden Initial Placement (A12.3): only its owner is ever sent the unit, so only the owner sees this mark. */
asl|unit:asl\:hidden    { stroke: token(conceal); stroke-style: dashed; stroke-width: 0.07; badge: "HIP" top-left; }

/* Mid tier: the Strength Factor or leader values, class, and state badges. */
@detail mid {
  unit:concealed { face-template: "q"; }
  asl|personnel { face-template: "glyph . class" "fp range morale"; }
  asl|personnel:face(broken) { face-template: "glyph" "bmorale"; }
  asl|leader { face-template: "drm" "morale"; }
  asl|sw { face-template: "label label label" "fp dash range"; }
  asl|dc { face-template: "label" "fp"; }
  asl|latw, asl|light-mortar { face-template: "glyph" "label"; }
  asl|radio { face-template: "label" "contact"; }
  asl|radio:face(reverse) { face-template: "label"; }
  asl|sw:face(malfunctioned) { face-template: "label" "repair"; }
  asl|gun { face-template: "glyph type" "cal cal"; covered-arc: none; }
  asl|pillbox { covered-arc: none; }
  asl|gun:face(limbered) { face-template: "glyph type"; }
  asl|gun:face(malfunctioned) { face-template: "repair removal"; }
  asl|vehicle { face-template: "glyph mp" "ma afront"; covered-arc: none; turret-arc: none; }
  asl|vehicle:face(wreck) { face-template: "glyph cs"; }
  unit::slot(fp), unit::slot(range), unit::slot(morale), unit::slot(bmorale), unit::slot(drm), unit::slot(cal), unit::slot(ma) { mark: none; }
  asl|leader::slot(drm) { mark: circle; }
  asl|personnel:face(broken).asl\:self-rally::slot(bmorale) { mark: box; }
}

/* Far tier: a side-colored shape and the size glyph. */
@detail far {
  unit { face-template: "glyph"; badges: none; }
  unit::slot(glyph) { content: glyph(size-figures); }
  unit:concealed { face-template: "q"; }
  asl|personnel:face(broken)::slot(glyph) { content: glyph(size-figures, prone); }
  asl|mg::slot(glyph) { content: glyph(mg); }
  asl|ft::slot(glyph) { content: glyph(ft); }
  asl|dc::slot(glyph) { content: glyph(dc); }
  asl|latw::slot(glyph) { content: glyph(latw); }
  asl|light-mortar::slot(glyph) { content: glyph(mortar); }
  asl|radio::slot(glyph) { content: glyph(radio); }
  asl|gun { covered-arc: none; }
  asl|gun::slot(glyph) { content: glyph(gun); }
  asl|gun[gun-type=mtr]::slot(glyph) { content: glyph(mortar); }
  asl|gun[gun-type=aa]::slot(glyph) { content: glyph(aa-gun); }
  asl|gun[gun-type=rcl]::slot(glyph) { content: glyph(rcl); }
  asl|gun:face(limbered)::slot(glyph) { content: glyph(limbered-gun); }
  asl|vehicle { covered-arc: none; turret-arc: none; }
  asl|vehicle::slot(glyph) { content: glyph(tank); }
  asl|vehicle[movement-type=half-tracked]::slot(glyph) { content: glyph(halftrack); }
  asl|vehicle[movement-type=armored-car]::slot(glyph) { content: glyph(armored-car); }
  asl|vehicle[movement-type=truck]::slot(glyph) { content: glyph(truck); }
  asl|vehicle[movement-type=motorcycle]::slot(glyph) { content: glyph(motorcycle); }
  asl|vehicle:face(wreck)::slot(glyph) { content: glyph(wreck); }
  asl|entity { face-template: "glyph"; }
  asl|entity::slot(glyph) { content: glyph(crosshair); }
  asl|foxhole::slot(glyph) { content: glyph(foxhole); }
  asl|trench::slot(glyph) { content: glyph(trench); }
  asl|wire::slot(glyph) { content: glyph(wire); }
  asl|minefield::slot(glyph) { content: glyph(mines); }
  asl|roadblock::slot(glyph) { content: glyph(roadblock); rotate: hexside; }
  asl|pillbox::slot(glyph) { content: glyph(pillbox); }
  asl|fortified-location::slot(glyph) { content: glyph(fortified); }
  asl|smoke::slot(glyph) { content: glyph(smoke); }
  asl|residual::slot(glyph) { content: glyph(residual); }
  asl|fire::slot(glyph) { content: glyph(fire); }
  asl|rubble::slot(glyph) { content: glyph(rubble); }
  asl|pillbox { covered-arc: none; }
  unit::attached(asl|equipment) { display: none; }
}
