<Project Sdk="Microsoft.NET.Sdk">
  <!-- The SVG writer benchmark of the SVG memory analysis (src/ASL/docs/Designs/ASL Map Studio SVG Memory Analysis.md, section 5.1).
       Build it with its own output path, so a running Studio's binaries are never touched:
       dotnet build -c Release -p:BaseOutputPath=<scratch>/svg-bench-out/ -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
    <AnalysisLevel>none</AnalysisLevel>
    <AslRoot>$(MSBuildThisFileDirectory)..\..\..\..\src\ASL\</AslRoot>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(AslRoot)LimboDancer.Domains.Asl.Maps.Vasl\LimboDancer.Domains.Asl.Maps.Vasl.csproj" />
    <ProjectReference Include="$(AslRoot)LimboDancer.Domains.Asl.Maps.Rendering\LimboDancer.Domains.Asl.Maps.Rendering.csproj" />
    <ProjectReference Include="$(AslRoot)LimboDancer.Domains.Asl.Units.Rendering\LimboDancer.Domains.Asl.Units.Rendering.csproj" />
  </ItemGroup>
</Project>
