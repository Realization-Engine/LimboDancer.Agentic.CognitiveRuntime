<Project Sdk="Microsoft.NET.Sdk">
  <!-- The LOS survey of a scenario's setup areas (2026-10-19, the Tractor Works' 295th plans). Build it outside the repository:
       dotnet build code-builders/boards/los-survey/los-survey.csproj "-p:OutDir=<working folder>/los-survey/out/" -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RestoreLockedMode>false</RestoreLockedMode>
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <AnalysisLevel>none</AnalysisLevel>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\src\ASL\LimboDancer.Domains.Asl.MapStudio\LimboDancer.Domains.Asl.MapStudio.csproj" />
  </ItemGroup>
</Project>
