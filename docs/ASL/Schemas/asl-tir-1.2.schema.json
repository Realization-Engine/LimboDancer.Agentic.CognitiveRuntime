{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:limbodancer:asl:tir:schema:1.2.0",
  "title": "LimboDancer ASL Transformation Intermediate Representation",
  "description": "Canonical structural authoring representation for ASL-OT-02. Semantic artifact kinds are reserved but are not emitted by the ASL-OT-02 structural writer.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaId",
    "schemaVersion",
    "packageCandidate",
    "sourceRegistry",
    "extractor",
    "canonicalization",
    "createdAt",
    "createdAtSource",
    "artifacts",
    "diagnostics",
    "documentSha256"
  ],
  "properties": {
    "schemaId": {
      "const": "urn:limbodancer:asl:tir:schema:1.2.0"
    },
    "schemaVersion": {
      "const": "1.2.0"
    },
    "packageCandidate": {
      "$ref": "#/$defs/packageCandidate"
    },
    "sourceRegistry": {
      "$ref": "#/$defs/sourceRegistry"
    },
    "extractor": {
      "$ref": "#/$defs/extractor"
    },
    "canonicalization": {
      "$ref": "#/$defs/canonicalization"
    },
    "createdAt": {
      "$ref": "#/$defs/utcTimestamp"
    },
    "createdAtSource": {
      "type": "string",
      "minLength": 1
    },
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/diagnostic"
      }
    },
    "documentSha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "artifactId": {
      "type": "string",
      "pattern": "^asl-tir:sha256:[0-9a-f]{64}$"
    },
    "utcTimestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "nullableString": {
      "type": ["string", "null"]
    },
    "packageCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domainId", "packageId", "version"],
      "properties": {
        "domainId": {
          "type": "string",
          "minLength": 1
        },
        "packageId": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "sourceRegistry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["registryId", "sha256", "sourceCommit"],
      "properties": {
        "registryId": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "sourceCommit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "extractor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "configurationSha256"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "configurationSha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "canonicalization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {
          "const": "asl-tir-canonical-json"
        },
        "version": {
          "const": "1.0.0"
        }
      }
    },
    "sourceFragmentReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fragmentId",
        "sourceId",
        "sourceSha256",
        "contentSha256",
        "startLine",
        "endLine"
      ],
      "properties": {
        "fragmentId": {
          "type": "string",
          "pattern": "^asl-fragment:sha256:[0-9a-f]{64}$"
        },
        "sourceId": {
          "type": "string",
          "minLength": 1
        },
        "sourceSha256": {
          "$ref": "#/$defs/sha256"
        },
        "contentSha256": {
          "$ref": "#/$defs/sha256"
        },
        "startLine": {
          "type": "integer",
          "minimum": 1
        },
        "endLine": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "target"],
      "properties": {
        "kind": {
          "enum": ["source", "artifact", "figure", "table", "footnote"]
        },
        "target": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "createdBy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "configurationSha256", "sourceRevision"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "configurationSha256": {
          "$ref": "#/$defs/sha256"
        },
        "sourceRevision": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifactId",
        "artifactKind",
        "packageCandidate",
        "publishedId",
        "normalizedPublishedId",
        "semanticId",
        "sourceFragments",
        "dependencies",
        "origin",
        "formalizationStatus",
        "reviewStatus",
        "confidence",
        "confidenceBasis",
        "createdBy",
        "createdAt",
        "reviewRecordRefs",
        "payload"
      ],
      "properties": {
        "artifactId": {
          "$ref": "#/$defs/artifactId"
        },
        "artifactKind": {
          "enum": [
            "sourceFragment",
            "section",
            "rule",
            "definition",
            "condition",
            "effect",
            "exception",
            "crossReference",
            "example",
            "table",
            "phaseRestriction",
            "term",
            "entityType",
            "property",
            "relation",
            "enumeration",
            "validationShape",
            "calculationRequirement"
          ]
        },
        "packageCandidate": {
          "$ref": "#/$defs/packageCandidate"
        },
        "publishedId": {
          "$ref": "#/$defs/nullableString"
        },
        "normalizedPublishedId": {
          "$ref": "#/$defs/nullableString"
        },
        "semanticId": {
          "type": "null"
        },
        "sourceFragments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/sourceFragmentReference"
          }
        },
        "dependencies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/dependency"
          }
        },
        "origin": {
          "const": "extracted"
        },
        "formalizationStatus": {
          "const": "unmodeled"
        },
        "reviewStatus": {
          "const": "captured"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "confidenceBasis": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "createdBy": {
          "$ref": "#/$defs/createdBy"
        },
        "createdAt": {
          "$ref": "#/$defs/utcTimestamp"
        },
        "reviewRecordRefs": {
          "type": "array",
          "maxItems": 0
        },
        "payload": {
          "type": "object"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "artifactKind": {
                "const": "sourceFragment"
              }
            }
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "#/$defs/sourceFragmentPayload"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "artifactKind": {
                "const": "section"
              }
            }
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "#/$defs/sectionPayload"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "artifactKind": {
                "const": "rule"
              }
            }
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "#/$defs/rulePayload"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "artifactKind": {
                "const": "crossReference"
              }
            }
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "#/$defs/crossReferencePayload"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "artifactKind": {
                "const": "example"
              }
            }
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "#/$defs/examplePayload"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "artifactKind": {
                "const": "table"
              }
            }
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "#/$defs/tablePayload"
              }
            }
          }
        }
      ]
    },
    "sourceLocator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "startLine",
        "endLine",
        "startPage",
        "endPage",
        "headingPath",
        "publishedElementId",
        "normalizedElementId"
      ],
      "properties": {
        "startLine": {
          "type": "integer",
          "minimum": 1
        },
        "endLine": {
          "type": "integer",
          "minimum": 1
        },
        "startPage": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "endPage": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "headingPath": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "publishedElementId": {
          "$ref": "#/$defs/nullableString"
        },
        "normalizedElementId": {
          "$ref": "#/$defs/nullableString"
        }
      }
    },
    "sourceFragmentPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fragmentKind",
        "sourcePath",
        "locator",
        "hasFootnoteMarkers",
        "verificationStatus"
      ],
      "properties": {
        "fragmentKind": {
          "enum": [
            "heading",
            "ruleText",
            "ruleContinuation",
            "figureReference",
            "structuredText",
            "paragraph"
          ]
        },
        "sourcePath": {
          "type": "string",
          "minLength": 1
        },
        "locator": {
          "$ref": "#/$defs/sourceLocator"
        },
        "hasFootnoteMarkers": {
          "type": "boolean"
        },
        "verificationStatus": {
          "enum": ["unverified", "verified"]
        }
      }
    },
    "rulePayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "directParentArtifactId",
        "hierarchyStatus",
        "hierarchyBasis",
        "siblingOrder"
      ],
      "properties": {
        "directParentArtifactId": {
          "oneOf": [
            {
              "$ref": "#/$defs/artifactId"
            },
            {
              "type": "null"
            }
          ]
        },
        "hierarchyStatus": {
          "enum": ["root", "supported", "candidate", "missing", "ambiguous"]
        },
        "hierarchyBasis": {
          "type": "array",
          "items": {
            "enum": [
              "publishedIdentifier",
              "chapterContext",
              "headingPath",
              "sourceOrder"
            ]
          }
        },
        "siblingOrder": {
          "type": ["integer", "null"],
          "minimum": 0
        }
      }
    },
    "sectionPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "boundaryKind",
        "sourceHeadingLevel",
        "directParentArtifactId",
        "hierarchyStatus",
        "hierarchyBasis",
        "siblingOrder"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "boundaryKind": {
          "enum": [
            "markdownHeading",
            "boldDeclaration",
            "structuredTextDeclaration"
          ]
        },
        "sourceHeadingLevel": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 6
        },
        "directParentArtifactId": {
          "type": "null"
        },
        "hierarchyStatus": {
          "const": "root"
        },
        "hierarchyBasis": {
          "type": "array",
          "items": {
            "enum": [
              "publishedIdentifier",
              "chapterContext",
              "headingPath",
              "sourceOrder"
            ]
          }
        },
        "siblingOrder": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "crossReferencePayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "referenceText",
        "containingFragmentId",
        "normalizedTargetCandidate",
        "resolutionStatus",
        "resolvedTargetArtifactId"
      ],
      "properties": {
        "referenceText": {
          "type": "string",
          "minLength": 1
        },
        "containingFragmentId": {
          "type": "string",
          "minLength": 1
        },
        "normalizedTargetCandidate": {
          "$ref": "#/$defs/nullableString"
        },
        "resolutionStatus": {
          "enum": ["resolved", "ambiguous", "missing", "unresolved"]
        },
        "resolvedTargetArtifactId": {
          "oneOf": [
            {
              "$ref": "#/$defs/artifactId"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "examplePayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["illustratesArtifactIds"],
      "properties": {
        "illustratesArtifactIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/artifactId"
          }
        }
      }
    },
    "tablePayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["noteFragmentIds", "structureVerified"],
      "properties": {
        "noteFragmentIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "structureVerified": {
          "const": false
        }
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "severity", "artifactId", "message"],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "enum": ["information", "warning", "error"]
        },
        "artifactId": {
          "oneOf": [
            {
              "$ref": "#/$defs/artifactId"
            },
            {
              "type": "null"
            }
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
